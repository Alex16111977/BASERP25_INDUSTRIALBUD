
//	ЭлементыДеревоЗначений	- ДеревоЗначений 	- дерево значений на форме, с отбираемыми элементами, для операций.
//	Действие				- СписокЗначений	- состоящий из имен команд, которые определяют запуск операции над объектом.

//	(!) Разделение, объектов для операции, по типам документов.
//	Пример! При переносе раздела с вложенными позициями, в ту же локальную смету, необходимо обработать только раздел.
//			Т.к. позиции остаются принадлежать, той же локальной смете и тому же родителю.
//	Пример! При перерасчете документа, необходимо получить все "ЛокальнаяСмета".
//	Пример! Часто необходимо получить, отмеченные элементы, только с типом значения "ДокументСсылка.СМ_ПозицияЛокальнойСметы".

//	Параметры.
//	ПринадлежатОднойСводнойСмете, ПринадлежатОднойОбъектнойСмете, ПринадлежатОднойЛокальнойСмете, ПринадлежатОдномуРазделу
//	* Пример! После выборки отмеченных элементов, проверяем массив с "ЛокальныеСметы" и если он состоит из одной локальной сметы, значит отмеченные принадлежат одной локальной смете.

//	Действие.
//	Команда, добавлена на форме, имя, которой состоит из параметров:
//		1. "ТипОбластиОбработки"
//		2. "ТипОбрабатываемогоДокумента"
//		3. "ИндексГруппы"
//		4. "ПорядковыйНомер"
//		5. "НаименованиеОперации"
//	Имя команды раскладываем в массив, таким образом получаем параметры.
//	* Процедура команды, работает по принципу:
//			1. Проверили возможность выполнения данной команды (проверка соблюдения условий).
//			   (!) при проверке, получаем "ОбъектыДляОперации".
//			2. Выполняем обработку команды, в конструкции "Если", в случае успешного завершения, можем выполнить дополнительные действия.
//			3. Сообщаем о завершение операции, над выбранными объектами.

#Область СобытияФормы

//	При создании формы на сервере заполняем поле Действие возможными командами.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	// Заполнить параметры обработки.
	УстановитьПараметрыНаСервере(Параметры.ТекущийДокумент);
	
	// (!) ДЛЯ ПРОГРАММИСТА (что бы во время разработки, были видны элементы, а во время запуска - не видны).
	Элементы.ГруппаЛегендаДеревоЗначений.Видимость			= Ложь;
	Элементы.ГруппаРесурсыИнформационноеСообщение.Видимость	= Ложь;
	
	//
	СписокЗапрещенныхДействийСПривязаннымиПозициями = "РАСЦЕНКИ_Копировать,РАСЦЕНКИ_ПереместитьВРаздел";
	
КонецПроцедуры //Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПоУмолчаниюДействие = ?(ЗначениеЗаполнено(Параметры.ПоУмолчаниюДействие), Параметры.ПоУмолчаниюДействие, "Перенести");
	//	ПоУмолчаниюДействие
	ДокументПриИзмененииНаКлиенте(Параметры.ТекущийДокумент, ПоУмолчаниюДействие);
	
	//	Документ
	Если ЗначениеЗаполнено(Параметры.ТекущийДокумент) Тогда
		
		//
		Если ТипЗнч(Параметры.ТекущийДокумент) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
			ПоказатьПредупреждение(, НСтр("ru='В стадии разработки!';"));
			Отказ	= Истина;
			Возврат;
		КонецЕсли;
	
		//
		// Если ТипЗнч(Параметры.ТекущийДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета")
		//	И Параметры.ЕстьАктыВыполненныхРабот Тогда
		//	ПоказатьПредупреждение(, НСтр("ru='Обработка запрещена! По локальной смете, имеются акты выполненных работ.';"));
		//	Отказ	= Истина;
		//	Возврат;
		// КонецЕсли;
	
		//	Выполнить событие, после изменения выбранного документа.
		ДокументОбработкаВыбора(Элементы.Документ, Параметры.ТекущийДокумент, Ложь,ПоУмолчаниюДействие);
	
	КонецЕсли;
	
	//	ТекущийЭлемент
	Если ЗначениеЗаполнено(Параметры.ТекущийДокумент)
		И ЗначениеЗаполнено(Параметры.ТекущийЭлемент) Тогда
		
		//	развернуть ветки дерева значений
		СтрокаДерева = Новый Структура("ТекущийЭлемент, ОткрытыеЭлементы",Параметры.ТекущийЭлемент,Новый Структура("СписокРазвернутых", Новый СписокЗначений));
		СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.ЭлементыДеревоЗначений, ЭлементыДеревоЗначений.ПолучитьЭлементы(), ЭлементыДеревоЗначений, СтрокаДерева);
		
		//	отметить текущий элемент
		Элементы.ЭлементыДеревоЗначений.ТекущиеДанные.Пометка = Истина;
		
		//	отметить вложенные элементы
		УстановитьСнятьПометкаРебенокНаКлиенте(Элементы.ЭлементыДеревоЗначений.ТекущиеДанные.ПолучитьЭлементы(), Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если Источник = "AddIn.Base" Тогда
		Если Событие = "SelectRasc"+ИдФормы Тогда
			
			//
			КомандаРесурсыЗаменитьПлюсМинусИзВБНаКлиенте(Данные);
			
			//
			ИдФормы = ИдФормы + 1;

		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	//	Применить отбор.
	Если ИмяСобытия = "ОбновлениеНастроекОтбора" Тогда
		
		КомандаИмя			= ПолучитьКомандаИмяНаКлиенте(Действие);
		ПараметрыКоманды	= ПолучитьПараметрыКомандыНаКлиенте(Команды[КомандаИмя]);
	
		//	отмечаем элементы, по отбору
		УстановитьСнятьПометкаОтборНаКлиенте(ЭлементыДеревоЗначений.ПолучитьЭлементы(), Источник, Параметр);
		
		ОтобратьОтмеченныеЭлементыНаКлиенте();
		//	заполняем табличные части
		ЗаполнитьТабличныеЧастиНаКлиенте(ПараметрыКоманды);
		
	КонецЕсли;
	
	//	Применить настройки.
	Если ИмяСобытия = "НастройкиСохранение" Тогда
		
		Для Каждого КлючИЗначение Из Параметр Цикл
			Если Параметры.Свойство(КлючИЗначение.Ключ) Тогда
				Параметры[КлючИЗначение.Ключ]	 = КлючИЗначение.Значение;
			КонецЕсли;
		КонецЦикла;
		
		Если Параметр.Свойство("АвтоматическиОбновлятьТабличнуюЧасть") Тогда
			Если Параметр.АвтоматическиОбновлятьТабличнуюЧасть Тогда
				
				ЗаполнитьТабличныеЧастиНаКлиенте();
				
				ОтобразитьИнформационноеСообщениеНаКлиенте(Ложь);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

&НаКлиенте
Процедура ПриЗакрытии()
	
	СписокДействий = Новый Массив;
	// Судариков: без этого не работает.
	СписокДействий.Добавить("ПеренумероватьДерево");
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("СписокДействий"	, СписокДействий);
	СтруктураПараметров.Вставить("НовыйОбъект"		, Неопределено);
	СтруктураПараметров.Вставить("Смета"			, ЭтаФорма.Документ);
	
	Оповестить("ОбновитьДеревоСметы", СтруктураПараметров); 
	
КонецПроцедуры //Процедура ПриЗакрытии()

#КонецОбласти //#Область СобытияФормы

#Область СобытияЭлементовФормы

// При выборе Акта, Сметы обновляем дерево.

&НаКлиенте
Процедура ДокументОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка, ПоУмолчаниюДействие = "")
	
	ТекстПредупреждения	= НСтр("ru = 'Ошибка! Проверка условия доступности обработки выбора.'");
	
	Если НЕ СМ_ДоступнаОбработкаДокументаНаСервере(ВыбранноеЗначение, ТекстПредупреждения) тогда
		ПоказатьПредупреждение(, ТекстПредупреждения);
		СтандартнаяОбработка	= Ложь;
		Возврат;
	КонецЕсли;
	
	//	Обновить параметры расчета.
	Если НЕ ТипЗнч(ВыбранноеЗначение) = Тип("Тип")
		И ЗначениеЗаполнено(ВыбранноеЗначение) тогда	
		
		//	Установить параметры обработки.
		УстановитьПараметрыНаСервере(ВыбранноеЗначение);
		
		//	Скрыть/отобразить элементы формы.
		ДокументПриИзмененииНаКлиенте(ВыбранноеЗначение,ПоУмолчаниюДействие);
		
		//	Заполнить дерево значений.
		ДеревоЗначенийОбновитьНаКлиенте(Новый Структура("Документ", ВыбранноеЗначение));
		
		//	Создать сводные таблицы значений, по табличным частям документов.
		СоздатьЗаполнитьТаблицыЗначенийНаСервере(ВыбранноеЗначение);
		
		//	Добавить строки в отобранные "Ресурсы", "Поправки", "Начисления", "Индексы", "Свойства".
		ЗаполнитьТабличныеЧастиНаКлиенте(ВыбранноеЗначение);
		
		//	Установить тип выбранного документа.
		Элементы.Документ.Заголовок	= ПолучитьЭлементыДокументЗаголовок(ВыбранноеЗначение);
		
		//	Установить выбранное значение, на случай, если выполняем процедуру не как событие.
		Если НЕ СтандартнаяОбработка Тогда
			Документ	= ВыбранноеЗначение;	
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //Процедура ДокументОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

&НаКлиенте
Процедура ДокументОчистка(Элемент, СтандартнаяОбработка)
	
	КомандаИмя				= ПолучитьКомандаИмяНаКлиенте(Действие);
	Если ПустаяСтрока(КомандаИмя) Тогда
		Возврат;
	КонецЕсли;
	ПараметрыКоманды		= ПолучитьПараметрыКомандыНаКлиенте(Команды[КомандаИмя]);
	
	//	очистить дерево значений
	ЭлементыДеревоЗначений.ПолучитьЭлементы().Очистить();
	
	//	очистить табличные части
	ТабличнаяЧастьРесурсы.Очистить();
	ТабличнаяЧастьПоправки.Очистить();
	ТабличнаяЧастьНачисления.Очистить();
	ТабличнаяЧастьИндексы.Очистить();
	
	//	вывести/скрыть сообщение о пустой табличной части
	РесурсыОтобразитьПустуюТаблицуНаКлиенте();	
	ПоправкиОтобразитьПустуюТаблицуНаКлиенте(ПараметрыКоманды);
	НачисленияОтобразитьПустуюТаблицуНаКлиенте();
	ИндексыОтобразитьПустуюТаблицуНаКлиенте();
	СвойстваОтобразитьПустуюТаблицуНаКлиенте();
	
	//	очистить параметры
	
КонецПроцедуры //Процедура ДокументОчистка(Элемент, СтандартнаяОбработка)


&НаКлиенте
Процедура ДействиеПриИзменении(Элемент)
	КомандаИмя	= ПолучитьКомандаИмяНаКлиенте(Действие);	
	ПараметрыКоманды	= ПолучитьПараметрыКомандыНаКлиенте(Новый Структура("Имя", КомандаИмя));
	//	Видимость/доступность элементов на форме
	УстановитьВидимостьДоступностьЭлементовНаКлиенте(ПараметрыКоманды);
	
	ОтобратьОтмеченныеЭлементыНаКлиенте();
КонецПроцедуры //Процедура ДействиеПриИзменении(Элемент)

&НаКлиенте
Процедура СОбнулениемПриИзменении(Элемент)
	
	//
	Для Каждого Строка Из ТабличнаяЧастьРесурсы Цикл
		
		//
		Строка.Модифицированность	= 	СОбнулением
										ИЛИ НЕ (Строка.ЦенаБазисная = Строка.СтараяЦенаБазисная)
										ИЛИ НЕ (Строка.ЦенаБазиснаяЗМ = Строка.СтараяЦенаБазиснаяЗМ)
										ИЛИ НЕ (Строка.ЦенаТекущая = Строка.СтараяЦенаТекущая)
										ИЛИ НЕ (Строка.ЦенаТекущаяЗМ = Строка.СтараяЦенаТекущаяЗМ);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбластьОбработкиПриИзменении(Элемент)
	
	//
	ОтобразитьИнформационноеСообщениеНаКлиенте(Ложь);
	
	//	Отображение элементов на форме, в зависимости от выбранной области обработки.
	ДокументПриИзмененииНаКлиенте(Документ);
	
	//	Заполнить табличную часть.
	ЗаполнитьТабличныеЧастиНаКлиенте();
	
КонецПроцедуры //Процедура  ОбластьОбработкиПриИзменении(Элемент)

//	ДЕРЕВО ЗНАЧЕНИЙ

#Область ДеревоЗначений

&НаКлиенте
Процедура ЭлементыДеревоЗначенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка	= Ложь;
		
	ПараметрыОткрытия		= Новый Структура();
	ТекущийДокумент			= Элементы.ЭлементыДеревоЗначений.ТекущиеДанные.Элемент;

	Если ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") тогда
		
		// Если Элементы.ЭлементыДеревоЗначений.ТекущиеДанные.СтатусРедактирования = 2 Тогда
		//	Возврат;
		// КонецЕсли;
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") тогда
			
			ДокументФорма		= "Документ.СМ_ПозицияЛокальнойСметы.ФормаОбъекта";
			ПараметрыОткрытия	= Новый Структура("Ключ, ПозицияАкта, Акт", ТекущийДокумент, Истина, Документ);
			ПараметрыОткрытия.Вставить("ЕстьАкт",Истина);
			ПараметрыОткрытия.Вставить("СтатусРедактирования",Элементы.ЭлементыДеревоЗначений.ТекущиеДанные.СтатусРедактирования);
			
		Иначе
			
			ДокументФорма		= "Документ.СМ_ПозицияЛокальнойСметы.ФормаОбъекта";
			ПараметрыОткрытия	= Новый Структура("Ключ", ТекущийДокумент);
			ПараметрыОткрытия.Вставить("ЕстьАкт",Элементы.ЭлементыДеревоЗначений.ТекущиеДанные.СтатусРедактирования>0);
			ПараметрыОткрытия.Вставить("СтатусРедактирования",Элементы.ЭлементыДеревоЗначений.ТекущиеДанные.СтатусРедактирования);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") тогда
		
		ДокументФорма		= "Документ.СМ_РазделЛокальнойСметы.ФормаОбъекта";
		ПараметрыОткрытия	= Новый Структура("Ключ", ТекущийДокумент);
		
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") тогда
		
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") тогда
		
			ДокументФорма		= "Документ.СМ_АктВыполненныхРабот.ФормаОбъекта";
			ПараметрыОткрытия	= Новый Структура("Ключ", Документ);
			
		Иначе
		
			ДокументФорма		= "Документ.СМ_ЛокальнаяСмета.ФормаОбъекта";
			ПараметрыОткрытия	= Новый Структура("Ключ", ТекущийДокумент);
		
		КонецЕсли;
	
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") тогда
		
		ДокументФорма		= "Документ.СМ_ОбъектнаяСмета.ФормаОбъекта";
		ПараметрыОткрытия	= Новый Структура("Ключ", ТекущийДокумент);
		
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_СводнаяСмета") тогда
		
		ДокументФорма		= "Документ.СМ_СводнаяСмета.ФормаОбъекта";
		ПараметрыОткрытия	= Новый Структура("Ключ", ТекущийДокумент);
		
	КонецЕсли;	
	
	//
	Если ПараметрыОткрытия.Количество() тогда
		ОткрытьФорму(ДокументФорма, ПараметрыОткрытия, ЭтаФорма,,,,, РежимОткрытияОкнаФормы.Независимый);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Ошибка открытия, формы документа!'"));	
	КонецЕсли;
	
КонецПроцедуры //Процедура ЭлементыДеревоЗначенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

&НаКлиенте
Процедура ЭлементыДеревоЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	//
	тест = "тест";
	
	Отказ	= Истина;
	
КонецПроцедуры //Процедура ЭлементыДеревоЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

&НаКлиенте
Процедура ЭлементыДеревоЗначенийПередУдалением(Элемент, Отказ)
	
	//	проверка
	Если НЕ СМ_ДоступнаОбработкаОбъектнаяСметаНаКлиенте(Новый Структура("Имя", "Удаление"), Элемент.ВыделенныеСтроки) тогда
		Возврат;
	КонецЕсли;
	
	//
	Если КомандаУдалитьНаСервере(Параметры["Операция"]) Тогда
		
		//	обновить дерево значений
		ДеревоЗначенийОбновитьНаКлиенте();

	КонецЕсли;
	
КонецПроцедуры //Процедура ЭлементыДеревоЗначенийПередУдалением(Элемент, Отказ)

&НаКлиенте
Процедура ЭлементыДеревоЗначенийНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	//
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Выполнение	= Ложь;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭлементыДеревоЗначенийПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	//
	СтандартнаяОбработка	= Ложь;
	
	//
	СтрокаДереваПриемник	= ЭлементыДеревоЗначений.НайтиПоИдентификатору(Строка);
			
	//
	Если ПараметрыПеретаскивания["Действие"] = ДействиеПеретаскивания.Перемещение Тогда
		
		//	проверка
		Если НЕ СМ_ДоступнаОбработкаНаКлиенте(Новый Структура("Имя", "Перетаскивание"),, ПараметрыПеретаскивания.Значение) тогда
			Возврат;
		КонецЕсли;

		ПараметрыКоманды	= Новый Структура();
		ПараметрыКоманды.Вставить("ТекущаяСмета"		, Документ);
		ПараметрыКоманды.Вставить("КомандаИмя"			, "Перетаскивание");
		
		//	выполнить команду "перенести"
		КомандаРасценкиПеренестиОповещениеНаКлиенте(СтрокаДереваПриемник.Элемент, ПараметрыКоманды);

	ИначеЕсли ПараметрыПеретаскивания["Действие"] = ДействиеПеретаскивания.Копирование Тогда
	
	КонецЕсли;
	
КонецПроцедуры //Процедура ЭлементыДеревоЗначенийПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)

&НаКлиенте
Процедура ЭлементыДеревоЗначенийПометкаПриИзменении(Элемент)
	
	//
	ТекущиеДанные		= Элементы.ЭлементыДеревоЗначений.ТекущиеДанные;
	КомандаИмя			= ПолучитьКомандаИмяНаКлиенте(Действие);
	ПараметрыКоманды	= ПолучитьПараметрыКомандыНаКлиенте(Команды[КомандаИмя]);
	
	//	Создаем симуляцию обычного флажка (три состояния - нужны, для отображения выделения не полной ветки дерева).
	ТекущиеДанные.Пометка	= ?(ТекущиеДанные.Пометка = 2, 0, ?(ТекущиеДанные.Пометка = 0, 1, ТекущиеДанные.Пометка));
	
	//	Отмечаем вложенные элементы и добавляем их в отбор строк, для табличных частей.
	УстановитьСнятьПометкаНаКлиенте(ТекущиеДанные, ТекущиеДанные.Пометка);
	
	//	Формируем списки обрабатываемых элементов, в некоторых случаях необходимо дополнительно обрабатывать не отмеченные элементы.
	ОтобратьОтмеченныеЭлементыНаКлиенте();
	
	//	Заполнить табличные части (сводные).
	ОтобразитьТабличныеЧастиНаКлиенте();
	
КонецПроцедуры //Процедура ЭлементыДеревоЗначенийПометкаПриИзменении(Элемент)

#КонецОбласти //#Область ДеревоЗначений/#Область СобытияЭлементовФормы

