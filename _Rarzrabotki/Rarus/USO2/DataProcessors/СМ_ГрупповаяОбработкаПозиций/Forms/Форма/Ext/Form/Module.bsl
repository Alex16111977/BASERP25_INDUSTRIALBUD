&НаКлиенте
Функция ОбъединитьПараметрыНаКлиенте(Результат, ПараметрыОповещения)
	
	//	скопировать
	ФиксированнаяСтруктура	= Новый ФиксированнаяСтруктура(Результат);
	Структура				= Новый Структура(ФиксированнаяСтруктура);
	
	//
	Если ТипЗнч(Структура.Ресурс) = Тип("Строка") Тогда
		Структура.Вставить("НаименованиеРесурса"	, ?(ТипЗнч(ПараметрыОповещения.Ресурс) = Тип("Строка"), ПараметрыОповещения.Ресурс, ПараметрыОповещения.Ресурс.ДлинноеНаименование));
		Структура.Вставить("КодРесурса"				, ПараметрыОповещения.ШифрРасценки);
		Структура.Вставить("ЕдиницаИзмеренияРесурса", ПараметрыОповещения.ЕдиницаИзмерения);
		Структура.Вставить("ВидРесурса"				, СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ПараметрыОповещения.Определитель, "ВидРасценки"));
	КонецЕсли;
	
	//
	Если ТипЗнч(ПараметрыОповещения) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из ПараметрыОповещения Цикл
			Если НЕ Структура.Свойство(КлючИЗначение.Ключ) Тогда
				Структура.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	//
	Возврат Структура;
	
КонецФункции //Функция ОбъединитьПараметрыНаКлиенте(Результат, ПараметрыОповещения)


//	ЗаменитьРесурсПлюсМинус
//
&НаСервере
Функция ОпределитьКоэффициентКНорме(СтараяЕдиницаИзмерения, НоваяЕдиницаИзмерения)
	Коэффициент = 1;
	БазоваяСтарая = СтараяЕдиницаИзмерения.БазоваяЕдиница;
	БазоваяНовая = НоваяЕдиницаИзмерения.БазоваяЕдиница;
	Если БазоваяНовая <> Неопределено Тогда
		Если БазоваяНовая = СтараяЕдиницаИзмерения Тогда
			Если НоваяЕдиницаИзмерения.КоэффициентПеревода <> 0 Тогда
				Коэффициент = 1 / НоваяЕдиницаИзмерения.КоэффициентПеревода; 
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	Если БазоваяСтарая <> Неопределено Тогда
		Если БазоваяСтарая = НоваяЕдиницаИзмерения Тогда
			Если СтараяЕдиницаИзмерения.КоэффициентПеревода <> 0 Тогда
				Коэффициент =  СтараяЕдиницаИзмерения.КоэффициентПеревода; 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Коэффициент;
КонецФункции

//	используется в процедуре "ВнешнееСобытие"
//
&НаСервере
Функция ПривестиСтруктуруНаКлиенте(Данные)
	
	ТаблицаРесурса = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьТекущиеЦеныВТаблицу(Данные);
	
	Если ТаблицаРесурса.Количество() Тогда
		СтрРесурс = ТаблицаРесурса[0];
		Ресурс = НайтиРесурсПоШифру(СтрРесурс.ШифрРасценки);
		Если Ресурс = Неопределено Тогда
			Возврат Неопределено;
		Иначе
			Структура = Новый Структура();
			Структура.Вставить("Ресурс"						, Ресурс);
			Структура.Вставить("Норма"						, СтрЗаменить(СтрРесурс.ОбъемРабот,",","."));
			Структура.Вставить("ТекущаяЦена"				, СтрЗаменить(СтрРесурс.ТекущаяЦена,",","."));
			Структура.Вставить("ТекущаяЗарплатаМашинистов"	, СтрЗаменить(СтрРесурс.ТекущаяЗарплатаМашинистов,",","."));
			Возврат Структура;
		КонецЕсли;
	КонецЕсли;
		
КонецФункции

// Поиск в справочнике ресурсов.
//
&НаСервере
Функция НайтиРесурсПоШифру(Шифр)
	Ресурс = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		               |	СправочникСмета.Ссылка КАК Ресурс
	    	           |ИЗ
	        	       |	Справочник.СМ_Ресурсы КАК СправочникСмета
	            	   |ГДЕ
		               |	СправочникСмета.Код = &Шифр";
	Запрос.УстановитьПараметр("Шифр",Шифр);
	РесурсыДанные = Запрос.Выполнить().Выбрать();
	Если РесурсыДанные.Следующий() Тогда
		Ресурс = РесурсыДанные.Ресурс;
	КонецЕсли; 
	Возврат Ресурс;
КонецФункции


