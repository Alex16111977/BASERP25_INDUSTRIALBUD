&НаКлиенте
Процедура КомандаРесурсыЗаменитьПлюсМинусИзВБНаКлиенте(Данные) Экспорт
	
	ОбрабатываемаяЛокальнаяСмета	= ПолучитьОбрабатываемуюЛокальнуюСметуНаКлиенте();
	ОбрабатываемыеРесурсы			= ПолучитьОбрабатываемыеРесурсыНаКлиенте();	
	ПараметрыРасчета				= СМ_ПолучитьПараметрыРасчетаНаКлиенте(ОбрабатываемаяЛокальнаяСмета);
	ЗаменяемыйРесурс				= Элементы.тзРесурсы.ТекущиеДанные.Ресурс;
	РасходПоНормеСтарый				= Элементы.тзРесурсы.ТекущиеДанные.РасходПоНорме;
	Результат						= ПривестиСтруктуруНаКлиенте(Данные);
	
	//
	Если Результат = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Данный ресурс не найден в БД.'"));
		Возврат;
	КонецЕсли;
	
	//
	ТекущаяКоманда		= ПолучитьТекущуюКомандуНаКлиенте();
	ПараметрыОповещения	= РесурсыЗаменитьПолучитьПараметрыОповещенияНаКлиенте(ТекущаяКоманда, ОбрабатываемыеРесурсы, ОбрабатываемаяЛокальнаяСмета, "", Истина);
	ПараметрыОткрытия	= РесурсыЗаменитьПолучитьПараметрыВводаРасходаНаКлиенте(Результат.Ресурс, ПараметрыОповещения);
	ОписаниеОповещения	= Новый ОписаниеОповещения("КомандаРесурсыЗаменитьПлюсМинусВводЗначенияОповещениеНаКлиенте", ЭтотОбъект, ПараметрыОповещения);
	
	ОткрытьФорму(	"ОбщаяФорма.СМ_ВводРасходаРесурса",
					ПараметрыОткрытия,
					,
					,
					,
					,
					ОписаниеОповещения,
					РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры //Процедура КомандаРесурсыЗаменитьПлюсМинусИзВБНаКлиенте(Данные) Экспорт


