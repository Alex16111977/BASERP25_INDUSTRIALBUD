	//Элементы.тзИндексыКоэффСтоимЭксплМашин.Видимость 			= Параметры.ЭтоИндексыПоЭлементам;
	//Элементы.тзИндексыКоэффСтоимЗарплатеМашин.Видимость 		= Параметры.ЭтоИндексыПоЭлементам;
	//Элементы.тзИндексыКоэффСтоимМатериалов.Видимость 			= Параметры.ЭтоИндексыПоЭлементам;
	//Элементы.тзИндексыКоэффОборуд.Видимость 					= Параметры.ЭтоИндексыПоЭлементам;
	
