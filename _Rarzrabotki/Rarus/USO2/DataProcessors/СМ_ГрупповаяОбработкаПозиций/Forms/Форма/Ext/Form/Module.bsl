// Расчет Нормы расхода с поправками. 
// 
Функция РассчитатьКоличество(ТекСтрока,ЭлПозиция)
	
	Позиция = ЭлПозиция.ПолучитьОбъект();
	Если ТекСтрока.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный ИЛИ ТекСтрока.ТипМатериала = Перечисления.СМ_ТипыМатериалов.ПоПроекту ИЛИ ТекСтрока.Удален Тогда
		Возврат(ТекСтрока.НормаРасхода);
	КонецЕсли;
	
	//Если Позиция.ИдСметы.МетодикаТСН Тогда
	Если Позиция.ИдСметы.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		// Применим ЗУ.
		ПрименитьЗУНормамМат = Позиция.ИдСметы.ПрименитьЗУНормамМат;
		ПрименитьЗУНормамМаш = Позиция.ИдСметы.ПрименитьЗУНормамМаш;
		ПрименитьЗУТрудРабочих =  Позиция.ИдСметы.ПрименитьЗУТрудРабочих;
		ПрименитьЗУТрудМашинистов = Позиция.ИдСметы.ПрименитьЗУТрудМашинистов;
		ТипСтроительстваРемонт = (Позиция.ИдСметы.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт);
	Иначе
		ПрименитьЗУНормамМат = Ложь;
		ПрименитьЗУНормамМаш = Ложь;
		ПрименитьЗУТрудРабочих =  Ложь;
		ПрименитьЗУТрудМашинистов = Ложь;
		ТипСтроительстваРемонт = Ложь;
	КонецЕсли;			

	Количество = ТекСтрока.НормаРасхода * ?(ЗначениеЗаполнено(ТекСтрока.КоэффициентКРасходуРесурсов),ТекСтрока.КоэффициентКРасходуРесурсов,1);
	
	СписокПоз = Новый СписокЗначений();
	СписокПоз.Добавить(Позиция.Ссылка);
	ТаблПоправок = СМ_СметаРасчетСервер.ПолучитьПоправки( СписокПоз,Ложь);
	
	Для каждого СтрокаТаблПоправок Из ТаблПоправок Цикл
		Если ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда	
			Количество = Количество * СтрокаТаблПоправок.КоэффициентКТрудозатратамРабочих;	
		ИначеЕсли ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда	
			Количество = Количество * СтрокаТаблПоправок.КоэффициентКТрудозатратамМашинистов;	
		ИначеЕсли ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда	
			Количество = Количество * СтрокаТаблПоправок.КоэффициентКСтоимостиМатериалов;	
		ИначеЕсли ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда	
			Количество = Количество * СтрокаТаблПоправок.КоэффициентКЭксплуатацииМашин;	
		КонецЕсли;
	КонецЦикла;
	Если ТипСтроительстваРемонт Тогда
		ЗимнееУдорож = ?(Позиция.ЗимнееУдорожРемонт = 0,1,Позиция.ЗимнееУдорожРемонт);
		ЗимнееУдорожМатериал = ?(Позиция.ЗимнееУдорожМатериалРемонт = 0,1,Позиция.ЗимнееУдорожМатериалРемонт);
	Иначе
		ЗимнееУдорож = ?(Позиция.ЗимнееУдорож = 0,1,Позиция.ЗимнееУдорож);
		ЗимнееУдорожМатериал = ?(Позиция.ЗимнееУдорожМатериал = 0,1,Позиция.ЗимнееУдорожМатериал);
	КонецЕсли;
	Если ПрименитьЗУТрудРабочих И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
		Количество = Количество * ЗимнееУдорож;
	КонецЕсли;
	
	Если ПрименитьЗУТрудМашинистов И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
		Количество = Количество * ЗимнееУдорож;
	КонецЕсли;
	
	Если ПрименитьЗУНормамМаш И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
		Количество = Количество * ЗимнееУдорож;
	КонецЕсли;
	
	Если ПрименитьЗУНормамМат И ТекСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
		Количество = Количество * ЗимнееУдорожМатериал;
	КонецЕсли;
	Возврат(Количество);	
КонецФункции

#КонецОбласти //#Область ДеревоЗначенийСформировать

#Область Запрос

//	(!) Обязательные поля запроса
//
//	Элемент
//		- ссылка, на документ ("СМ_ОбъектнаяСмета", "СМ_ЛокальнаяСмета", "СМ_РазделЛокальнойСметы", "СМ_ПозицияЛокальнойСметы").
//	ЭлементРодитель
//		- ссылка, на родительский документ, для построения дерева значений.
//	ЭтоКорневойЭлемент
//		- определяем корневой элемент дерева значений, для отображения в условном оформлении.
//	Доступность
//		- определяем доступность обработки строки (например, нельзя редактировать локальные сметы, по которым есть акты выполненных работ).
//	СодержитРесурсы, СодержитПоправки, СодержитНачисления, СодержитИндексы.
//		- для выделения строк, которые содержат табличную часть, влияющую на отображения строк в текущей области обработки.
//	Связанная, СвязаннаяКартинка, СвязаннаяВладелец.
//		- отображение и отметка связанных позиций.
//	ПринадлежитСводнойСмете, ПринадлежитОбъектнойСмете, ПринадлежитЛокальнойСмете, ПринадлежитРазделу.
//		- проверка условий, выбранные позиции принадлежат одной смете или нет.
//

//	Функция возвращает запрос на формирование дерева смет.
//
// Параметры:
//     ТекущийАкт - ДокументСсылка.СМ_АктВыполненныхРабот - если формируется дерево акта,
//                  то ссылка на акт передается в данном параметре.
//
// Возвращаемое значение:
//     Строка с текстом запроса на формирование таблицы для дерева разделов и позиций.
//
Функция ПолучитьТекстЗапросаНаДеревоСмет(ТекущийДокумент = Неопределено, ЭтоФормированиеСметыНаОстатки = Ложь)
	
	Если ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") тогда
		Возврат ПолучитьТекстЗапросаНаДеревоСметАктВыполненныхРабот();
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") тогда
		Возврат ПолучитьТекстЗапросаНаДеревоСметЛокальнаяСмета();
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") тогда
		Возврат ПолучитьТекстЗапросаНаДеревоСметОбъектнаяСмета();
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_СводнаяСмета") тогда
		Возврат ПолучитьТекстЗапросаНаДеревоСметСводнаяСмета();	
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции //Функция ПолучитьТекстЗапросаНаДеревоСмет()

//	Функция возвращает запрос на формирование дерева смет.
//
// Параметры:
//
// Возвращаемое значение:
//     Строка с текстом запроса на формирование таблицы для дерева разделов и позиций.
//
Функция ПолучитьТекстЗапросаНаДеревоСметАктВыполненныхРабот()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_АктВыполненныхРабот.Ссылка,
	               |	СМ_АктВыполненныхРабот.ЛокальнаяСмета
	               |ПОМЕСТИТЬ ВТ_АктВыполненныхРабот
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
	               |ГДЕ
	               |	СМ_АктВыполненныхРабот.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СМ_АктВыполненныхРаботПозиции.Позиция,
	               |	СУММА(СМ_АктВыполненныхРаботПозиции.ФактОбъем) КАК Всего
	               |ПОМЕСТИТЬ ВТ_ПозицииАктов
	               |ИЗ
	               |	ВТ_АктВыполненныхРабот КАК ВТ_АктВыполненныхРабот
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	               |		ПО ВТ_АктВыполненныхРабот.ЛокальнаяСмета = СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета
	               |ГДЕ
	               |	СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен = ИСТИНА
	               |	И СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета = &ЛокальнаяСмета
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_АктВыполненныхРаботПозиции.Позиция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_АктВыполненныхРаботПозиции.Ссылка,
	               |	СМ_АктВыполненныхРаботПозиции.Позиция,
	               |	СМ_АктВыполненныхРаботПозиции.ФактОбъем
	               |ПОМЕСТИТЬ ВТ_АктВыполненныхРаботПозиции
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	               |ГДЕ
	               |	СМ_АктВыполненныхРаботПозиции.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_ЛокальнаяСмета.Ссылка КАК Ссылка,
	               |	СМ_ЛокальнаяСмета.Наименование КАК Наименование,
	               |	СМ_ЛокальнаяСмета.ИД КАК ИД,
	               |	СМ_ЛокальнаяСмета.ИДРодителя КАК ИДРодителя,
	               |	ИСТИНА КАК Доступность,
	               |	НЕОПРЕДЕЛЕНО КАК ЭлементРодитель,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СМ_ЛокальнаяСмета.ИДРодителя) = ТИП(Документ.СМ_СводнаяСмета)
	               |			ТОГДА СМ_ЛокальнаяСмета.ИДРодителя
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	               |	КОНЕЦ КАК ПринадлежитСводнойСмете,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СМ_ЛокальнаяСмета.ИДРодителя) = ТИП(Документ.СМ_ОбъектнаяСмета)
	               |			ТОГДА СМ_ЛокальнаяСмета.ИДРодителя
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка)
	               |	КОНЕЦ КАК ПринадлежитОбъектнойСмете,
	               |	СМ_ЛокальнаяСмета.Ссылка КАК ПринадлежитЛокальнойСмете,
	               |	ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка) КАК ПринадлежитРазделу,
	               |	ЛОЖЬ КАК Связанная,
	               |	NULL КАК СвязаннаяКартинка,
	               |	ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка) КАК СвязаннаяВладелец,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер КАК НомерПорядковый
	               |ПОМЕСТИТЬ ВТ_ЛокальнаяСмета
	               |ИЗ
	               |	ВТ_АктВыполненныхРабот КАК ВТ_АктВыполненныхРабот
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |			ПО СМ_ЛокальнаяСмета.Ссылка = СМ_НумерацияПозицийЛокальныхСмет.Смета
	               |				И (СМ_НумерацияПозицийЛокальныхСмет.Раздел = ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка))
	               |				И (СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка))
	               |		ПО ВТ_АктВыполненныхРабот.ЛокальнаяСмета = СМ_ЛокальнаяСмета.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_РазделЛокальнойСметы.Ссылка,
	               |	СМ_РазделЛокальнойСметы.НаименованиеДляПечати,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер КАК НомерПорядковый,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_РазделЛокальнойСметы.ИД,
	               |	СМ_РазделЛокальнойСметы.ИДРодителя,
	               |	СМ_РазделЛокальнойСметы.ИДСметы,
	               |	СМ_РазделЛокальнойСметы.Расчет,
	               |	СМ_РазделЛокальнойСметы.Номер,
	               |	ИСТИНА КАК Доступность,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СМ_РазделЛокальнойСметы.ИДРодителя) = ТИП(Документ.СМ_СводнаяСмета)
	               |			ТОГДА СМ_РазделЛокальнойСметы.ИДРодителя
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СМ_СводнаяСмета.ПустаяСсылка)
	               |	КОНЕЦ КАК ПринадлежитСводнойСмете,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СМ_РазделЛокальнойСметы.ИДРодителя) = ТИП(Документ.СМ_ОбъектнаяСмета)
	               |			ТОГДА СМ_РазделЛокальнойСметы.ИДРодителя
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка)
	               |	КОНЕЦ КАК ПринадлежитОбъектнойСмете,
	               |	СМ_РазделЛокальнойСметы.ИДСметы КАК ПринадлежитЛокальнойСмете,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СМ_РазделЛокальнойСметы.ИДРодителя) = ТИП(Документ.СМ_РазделЛокальнойСметы)
	               |			ТОГДА СМ_РазделЛокальнойСметы.ИДРодителя
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка)
	               |	КОНЕЦ КАК ПринадлежитРазделу,
	               |	ЛОЖЬ КАК Связанная,
	               |	NULL КАК СвязаннаяКартинка,
	               |	ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка) КАК СвязаннаяВладелец
	               |ПОМЕСТИТЬ ВТ_РазделЛокальнойСметы
	               |ИЗ
	               |	ВТ_ЛокальнаяСмета КАК ВТ_ЛокальнаяСмета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |			ПО СМ_РазделЛокальнойСметы.ИДСметы = СМ_НумерацияПозицийЛокальныхСмет.Смета
	               |				И СМ_РазделЛокальнойСметы.Ссылка = СМ_НумерацияПозицийЛокальныхСмет.Раздел
	               |				И (СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка))
	               |		ПО ВТ_ЛокальнаяСмета.Ссылка = СМ_РазделЛокальнойСметы.ИДСметы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_ПозицияЛокальнойСметы.Ссылка КАК Ссылка,
	               |	СМ_ПозицияЛокальнойСметы.Наименование КАК Наименование,
	               |	СМ_ПозицияЛокальнойСметы.Расчет КАК Расчет,
	               |	СМ_ПозицияЛокальнойСметы.ИД КАК ИД,
	               |	СМ_ПозицияЛокальнойСметы.ИДРодителя КАК ИДРодителя,
