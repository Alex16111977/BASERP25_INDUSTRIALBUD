&НаКлиенте
Процедура РЕСУРСЫ_АКТ_Заменить(Команда, ВыполнитьКоманду = Ложь)
	
	//	устанавливаем и проверяем возможность установки, "действие" - реквизит на форме
	Если НЕ ВыполнитьКоманду Тогда
		ДоступнаСменаКомандыВопросНаКлиенте(Команда);
		Возврат;
	КонецЕсли;
	
	//
	Если НЕ СМ_ДоступнаОбработкаАктВыполненныхРаботНаКлиенте(Команда) Тогда
		Возврат;
	КонецЕсли;
	
	//	переменные процедуры
	ОбрабатываемаяЛокальнаяСмета	= ПолучитьОбрабатываемуюЛокальнуюСметуНаКлиенте();
	ОбрабатываемыеРесурсы			= ПолучитьОбрабатываемыеРесурсыНаКлиенте();	
	ПараметрыОповещения 			= РесурсыЗаменитьПолучитьПараметрыОповещенияНаКлиенте(Команда, ОбрабатываемыеРесурсы, ОбрабатываемаяЛокальнаяСмета, "Ресурсы");
	ПараметрыОткрытия				= РесурсыЗаменитьПолучитьПараметрыПоискаНаКлиенте(ОбрабатываемыеРесурсы, ОбрабатываемаяЛокальнаяСмета);
	ОписаниеОповещения				= Новый ОписаниеОповещения("КомандаРесурсыЗаменитьОповещениеНаКлиенте", ЭтотОбъект, ПараметрыОповещения);

	//
	ОткрытьФорму(	"Справочник.СМ_Ресурсы.Форма.ФормаВыбора",
					ПараметрыОткрытия,,,,,
					ОписаниеОповещения,
					РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры //Процедура РЕСУРСЫ_АКТ_Заменить(Команда, ВыполнитьКоманду = Ложь)

