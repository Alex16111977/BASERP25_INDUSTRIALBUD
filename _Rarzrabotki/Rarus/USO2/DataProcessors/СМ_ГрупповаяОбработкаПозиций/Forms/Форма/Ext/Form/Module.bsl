#Область ПараметрыКоманды

&НаКлиенте
Функция ПолучитьПараметрыКомандыНаКлиенте(Команда, Свойство = Неопределено)
	
	//
	Массив	= СтрРазделить(Команда.Имя, "_");

	//
	Если НЕ Массив.Количество() = 5 Тогда
		Возврат Неопределено;
	Иначе
		
		//
		Операция	= Новый Структура();
		Операция.Вставить("Копировать"		, Булево(СтрНайти(Массив[4], "Копировать")));
		Операция.Вставить("Перенести"		, Булево(СтрНайти(Массив[4], "Перенести")));
		Операция.Вставить("Редактировать"	, Булево(СтрНайти(Массив[4], "Редактировать")));
		Операция.Вставить("Заменить"		, Булево(СтрНайти(Массив[4], "Заменить")));
		Операция.Вставить("Удалить"			, Булево(СтрНайти(Массив[4], "Удалить")));
		Операция.Вставить("Добавить"		, Булево(СтрНайти(Массив[4], "Добавить")));
		Операция.Вставить("ВБ"				, Булево(СтрНайти(Массив[4], "ВБ")));
		Операция.Вставить("НРиСП"			, Булево(СтрНайти(Массив[4], "НРиСП")));
		
		//
		Структура	= Новый Структура();
		Структура.Вставить("Команда"	, Команда.Имя);
		Структура.Вставить("Действие"	, Массив[4]);
		Структура.Вставить("Тип"		, Массив[0]);
		Структура.Вставить("Операция"	, Операция);
		
		//
		Если Свойство = Неопределено Тогда
			Возврат Структура;
		Иначе
			Возврат Структура[Свойство];	
		КонецЕсли;
		
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Функция ПолучитьСвойствоКомандыДействиеНаКлиенте(КомандаИмя, Свойство)
	
