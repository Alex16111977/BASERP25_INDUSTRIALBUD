		Возврат;
	КонецЕсли;
	
	//	проверяем возможность выполнения команды
	Если НЕ СМ_ДоступнаОбработкаОбъектнаяСметаНаКлиенте(Команда) тогда
		Возврат;
	КонецЕсли;
	
	//	переменные процедуры
	ОбрабатываемаяЛокальнаяСмета	= ПолучитьОбрабатываемуюЛокальнуюСметуНаКлиенте();
	ОбрабатываемыеРесурсы			= ПолучитьОбрабатываемыеРесурсыНаКлиенте();	
	ПараметрыОткрытия				= РесурсыЗаменитьПолучитьПараметрыПоискаНаКлиенте(ОбрабатываемыеРесурсы, ОбрабатываемаяЛокальнаяСмета);
	ПараметрыОповещения 			= РесурсыЗаменитьПолучитьПараметрыОповещенияНаКлиенте(Команда, ОбрабатываемыеРесурсы, ОбрабатываемаяЛокальнаяСмета);
	ОписаниеОповещения				= Новый ОписаниеОповещения("КомандаРесурсыЗаменитьПлюсМинусОповещениеНаКлиенте", ЭтотОбъект, ПараметрыОповещения);
	
	//
	ОткрытьФорму(	"Справочник.СМ_Ресурсы.Форма.ФормаВыбора",
					ПараметрыОткрытия,
					,
					,
					,
					,
					ОписаниеОповещения,
					РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры //Процедура РЕСУРСЫ_ОС_ЗаменитьПлюсМинус(Команда)

