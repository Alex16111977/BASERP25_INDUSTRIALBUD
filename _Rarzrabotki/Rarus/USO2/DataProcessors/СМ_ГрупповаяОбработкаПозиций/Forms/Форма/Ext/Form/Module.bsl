	               |						КОГДА ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней.Владелец ЕСТЬ NULL 
	               |							ТОГДА 0
	               |						ИНАЧЕ 1
	               |					КОНЕЦ
	               |			КОНЕЦ
	               |	КОНЕЦ,
	               |	ВТ_ПозицияЛокальнойСметы.ИДПозицииВладельца,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.РесурсыКоличество > 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.ПоправкиКоличество > 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.НачисленияКоличество > 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.ИндексыКоличество > 0
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.ОбъемВсего = 0
	               |			ТОГДА 0
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.ОбъемВсего < ВТ_ПозицияЛокальнойСметы.ОбъемРабот
	               |			ТОГДА ВЫБОР
	               |					КОГДА &РазрешитьРедактирование
	               |						ТОГДА 1
	               |					ИНАЧЕ 2
	               |				КОНЕЦ
	               |		КОГДА ВТ_ПозицияЛокальнойСметы.ОбъемВсего >= ВТ_ПозицияЛокальнойСметы.ОбъемРабот
	               |			ТОГДА 2
	               |		ИНАЧЕ 0
	               |	КОНЕЦ,
	               |	ВТ_ПозицияЛокальнойСметы.ОбъемВсего
	               |ИЗ
	               |	ВТ_ПозицияЛокальнойСметы КАК ВТ_ПозицияЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета КАК Рег
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = Рег.Позиция
	               |			И ВТ_ПозицияЛокальнойСметы.ИДРодителя = Рег.Раздел
	               |			И ВТ_ПозицияЛокальнойСметы.ИДСметы = Рег.Смета
	               |			И (ВТ_ПозицияЛокальнойСметы.ИДСметы.МетодРасчета <> ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_БазиснаяЕдиничнаяСтоимостьПозицииСНачислениямиПоправкамиИЧП КАК РегРес
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = РегРес.Позиция
	               |			И ВТ_ПозицияЛокальнойСметы.ИДРодителя = РегРес.Раздел
	               |			И ВТ_ПозицияЛокальнойСметы.ИДСметы = РегРес.Смета
	               |			И (ВТ_ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПозицияЛокальнойСметыСвязанныеПозицииКоличество КАК ВТ_ПозицияЛокальнойСметыСвязанныеПозицииКоличество
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = ВТ_ПозицияЛокальнойСметыСвязанныеПозицииКоличество.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней КАК ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней.Ссылка
	               |			И ВТ_ПозицияЛокальнойСметы.ИДПозицииВладельца = ВТ_ПозицияЛокальнойСметыСвязанныеПозицииСсылкаПоследней.Владелец
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество КАК ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество
	               |		ПО ВТ_ПозицияЛокальнойСметы.Ссылка = ВТ_ПозицияЛокальнойСметыТабличныеЧастиКоличество.Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерВДереве,
	               |	НомерПорядковый";
		
	Возврат ТекстЗапроса;
	
КонецФункции

//	Функция возвращает запрос на формирование дерева смет.
//
// Параметры:
//
// Возвращаемое значение:
//     Строка с текстом запроса на формирование таблицы для дерева разделов и позиций.
//
Функция ПолучитьТекстЗапросаНаДеревоСметОбъектнаяСмета()
	                                                                                                              
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_АктВыполненныхРабот.Ссылка,
	               |	СМ_АктВыполненныхРабот.ЛокальнаяСмета
	               |ПОМЕСТИТЬ ВТ_АктВыполненныхРабот
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
	               |ГДЕ
	               |	НЕ СМ_АктВыполненныхРабот.ПометкаУдаления
	               |	И СМ_АктВыполненныхРабот.ЛокальнаяСмета.ИДРодителя = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СМ_АктВыполненныхРаботПозиции.Позиция,
	               |	СУММА(СМ_АктВыполненныхРаботПозиции.ФактОбъем) КАК Всего
	               |ПОМЕСТИТЬ ВТ_ПозицииАктов
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот.Позиции КАК СМ_АктВыполненныхРаботПозиции
	               |ГДЕ
	               |	СМ_АктВыполненныхРаботПозиции.Ссылка.ЛокальнаяСмета.ИДРодителя = &Ссылка
	               |	И СМ_АктВыполненныхРаботПозиции.Ссылка.Проведен
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_АктВыполненныхРаботПозиции.Позиция
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_ОбъектнаяСмета.Ссылка,
	               |	СМ_ОбъектнаяСмета.Наименование,
	               |	СМ_ОбъектнаяСмета.ИД,
	               |	СМ_ОбъектнаяСмета.ИДРодителя,
	               |	ИСТИНА КАК ЭтоКорневойЭлемент,
	               |	СМ_ОбъектнаяСмета.НомерСметы КАК НомерДокумента,
	               |	0 КАК НомерПорядковый,
	               |	0 КАК НомерВПределахСметы,
	               |	0 КАК НомерВДереве,
	               |	ЛОЖЬ КАК ОтмеченаВДереве,
	               |	4 КАК ТипСтроки
	               |ПОМЕСТИТЬ ВТ_ОбъектнаяСмета
	               |ИЗ
	               |	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета
	               |ГДЕ
	               |	СМ_ОбъектнаяСмета.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета.Ссылка КАК Ссылка,
	               |	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета.Наименование КАК Наименование,
	               |	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета.ИД КАК ИД,
	               |	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета.ИДРодителя КАК ИДРодителя,
	               |	СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета.НомерСметы КАК НомерСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве КАК НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы КАК НомерВПределахСметы,
	               |	СМ_ОбъектнаяСметаЛокальныеСметы.НомерСтроки КАК ПорНомер
	               |ПОМЕСТИТЬ ВТ_ЛокальнаяСмета
	               |ИЗ
	               |	ВТ_ОбъектнаяСмета КАК ВТ_ОбъектнаяСмета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |			ПО СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка = СМ_НумерацияПозицийЛокальныхСмет.Смета
	               |				И (СМ_НумерацияПозицийЛокальныхСмет.Раздел = ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка))
	               |				И (СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка))
	               |		ПО ВТ_ОбъектнаяСмета.Ссылка = СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТ_ЛокальнаяСмета.Ссылка,
	               |	ВТ_ЛокальнаяСмета.Наименование,
	               |	ВТ_ЛокальнаяСмета.ИД,
	               |	ВТ_ЛокальнаяСмета.ИДРодителя,
	               |	СУММА(ВЫБОР
	               |			КОГДА ВТ_АктВыполненныхРабот.Ссылка ЕСТЬ NULL 
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ) КАК КоличествоАктов,
	               |	ВТ_ЛокальнаяСмета.ПорНомер КАК НомерПорядковый,
	               |	ВТ_ЛокальнаяСмета.НомерВДереве,
	               |	ВТ_ЛокальнаяСмета.НомерВПределахСметы,
	               |	ВТ_ЛокальнаяСмета.НомерСметы КАК НомерДокумента
	               |ПОМЕСТИТЬ ВТ_ЛокальнаяСметаКоличествоАктов
	               |ИЗ
	               |	ВТ_ЛокальнаяСмета КАК ВТ_ЛокальнаяСмета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_АктВыполненныхРабот КАК ВТ_АктВыполненныхРабот
	               |		ПО ВТ_ЛокальнаяСмета.Ссылка = ВТ_АктВыполненныхРабот.ЛокальнаяСмета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |		ПО ВТ_ЛокальнаяСмета.Ссылка = СМ_НумерацияПозицийЛокальныхСмет.Смета
	               |			И (НЕ СМ_НумерацияПозицийЛокальныхСмет.Раздел = ЗНАЧЕНИЕ(Документ.СМ_РазделЛокальнойСметы.ПустаяСсылка))
	               |			И (НЕ СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ЛокальнаяСмета.ИДРодителя,
	               |	ВТ_ЛокальнаяСмета.Наименование,
	               |	ВТ_ЛокальнаяСмета.Ссылка,
	               |	ВТ_ЛокальнаяСмета.ИД,
	               |	ВТ_ЛокальнаяСмета.НомерСметы,
	               |	ВТ_ЛокальнаяСмета.ПорНомер,
	               |	ВТ_ЛокальнаяСмета.НомерВДереве,
	               |	ВТ_ЛокальнаяСмета.НомерВПределахСметы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_РазделЛокальнойСметы.Ссылка,
	               |	СМ_РазделЛокальнойСметы.НаименованиеДляПечати,
	               |	СМ_РазделЛокальнойСметы.Номер КАК НомерДокумента,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер КАК НомерПорядковый,
	               |	СМ_РазделЛокальнойСметы.ИД,
	               |	СМ_РазделЛокальнойСметы.ИДРодителя,
	               |	СМ_РазделЛокальнойСметы.ИДСметы,
	               |	СМ_РазделЛокальнойСметы.Расчет,
	               |	ВЫБОР
	               |		КОГДА ВТ_ЛокальнаяСметаКоличествоАктов.КоличествоАктов > 0
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК Доступность,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СМ_РазделЛокальнойСметы.ИДСметы.ИДРодителя) = ТИП(Документ.СМ_СводнаяСмета)
	               |			ТОГДА СМ_РазделЛокальнойСметы.ИДСметы.ИДРодителя
	               |		ИНАЧЕ СМ_РазделЛокальнойСметы.ИДСметы.ИДРодителя.ИДРодителя
	               |	КОНЕЦ КАК СводнаяСмета,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СМ_РазделЛокальнойСметы.ИДСметы.ИДРодителя) = ТИП(Документ.СМ_ОбъектнаяСмета)
	               |			ТОГДА СМ_РазделЛокальнойСметы.ИДСметы.ИДРодителя
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка)
	               |	КОНЕЦ КАК ОбъектнаяСмета,
	               |	2 КАК ТипСтроки
	               |ПОМЕСТИТЬ ВТ_РазделЛокальнойСметы
	               |ИЗ
	               |	ВТ_ЛокальнаяСметаКоличествоАктов КАК ВТ_ЛокальнаяСметаКоличествоАктов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	               |			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |			ПО СМ_РазделЛокальнойСметы.Ссылка = СМ_НумерацияПозицийЛокальныхСмет.Раздел
	               |				И (СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка))
	               |				И СМ_РазделЛокальнойСметы.ИДСметы = СМ_НумерацияПозицийЛокальныхСмет.Смета
	               |		ПО ВТ_ЛокальнаяСметаКоличествоАктов.Ссылка = СМ_РазделЛокальнойСметы.ИДСметы
	               |ГДЕ
	               |	НЕ СМ_РазделЛокальнойСметы.Ссылка ЕСТЬ NULL 
	               |	И СМ_РазделЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПозицияЛокальнойСметы.Ссылка,
	               |	ПозицияЛокальнойСметы.Наименование,
	               |	ПозицияЛокальнойСметы.Расчет,
	               |	ПозицияЛокальнойСметы.ИД,
	               |	ПозицияЛокальнойСметы.ИДРодителя,
	               |	ПозицияЛокальнойСметы.ИДСметы,
	               |	ПозицияЛокальнойСметы.ИДПозицииВладельца,
	               |	ПозицияЛокальнойСметы.Номер,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер,
	               |	ПозицияЛокальнойСметы.ОбъемРабот,
	               |	ПозицияЛокальнойСметы.ШифрРасценки,
	               |	ПозицияЛокальнойСметы.Измеритель,
	               |	ПозицияЛокальнойСметы.Определитель,
	               |	ПозицияЛокальнойСметы.НеПрименятьИндексы,
	               |	ПозицияЛокальнойСметы.ТекущаяЦена,
	               |	ПозицияЛокальнойСметы.ТекущаяЗарплатаМашинистов,
	               |	ВЫБОР
	               |		КОГДА ПозицияЛокальнойСметы.НеПрименятьИндексы
	               |			ТОГДА ПозицияЛокальнойСметы.ТекущаяЦена
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ПозицияЛокальнойСметы.Определитель.ВидРасценки = ЗНАЧЕНИЕ(Перечисление.СМ_ВидыРасценки.Оборудование)
	               |					ТОГДА ВЫБОР
	               |							КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	               |								ТОГДА РесурснаяСтоимостьПозиции.ТекСтоимОборуд
	               |							ИНАЧЕ ПозицияЛокальнойСметы.Оборудование
	               |						КОНЕЦ
	               |				ИНАЧЕ ВЫБОР
	               |						КОГДА ПозицияЛокальнойСметы.ИДСметы.МетодРасчета = ЗНАЧЕНИЕ(Перечисление.СМ_МетодыРасчетаЛС.Ресурсный)
	               |							ТОГДА РесурснаяСтоимостьПозиции.ТекСтоимПрямЗатраты
