#Область ТабличнаяЧастьИндексы

// Проверяем отмеченные позиции на возможность выполнения операций, если что то не подходит, возвращаем ложь.
//
&НаКлиенте
Функция СМ_ДоступнаОбработкаИндексыНаКлиенте(Команда, Операция, ТекстПредупреждения = "")
	
	ДоступнаОбработкаКоманды	= Истина;
	ОбрабатываемыеПозиции		= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//
	Если Операция["Редактировать"] Тогда
		
		//	Нет отмеченных
		НайденныеИндексы = ТабличнаяЧастьИндексы.НайтиСтроки(Новый Структура("Пометка", Истина));
		Если НЕ НайденныеИндексы.Количество() Тогда
			ТекстПредупреждения			= НСтр("ru='Нет отмеченных индексов'");
			Возврат Ложь;
		КонецЕсли;          
		
		//	Нет изменений
		НайденныеИндексы = ТабличнаяЧастьИндексы.НайтиСтроки(Новый Структура("Модифицированность", Истина));
		Если НЕ НайденныеИндексы.Количество() Тогда
			ТекстПредупреждения			= НСтр("ru='Нет изменений в значениях и формулах'");
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	// Для уровня индексов "Раздел".
	// Проверка чтобы был отмечен раздел по выбранным позициям.
	Для Каждого ОтмеченнаяПозиция Из ОбрабатываемыеПозиции Цикл
		
		НаименованиеПозиции	= ЭлементыДеревоЗначений.НайтиПоИдентификатору(ОтмеченнаяПозиция["Идентификатор"]).Наименование; //
		
		НайденныеРазделы = ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("СсылкаНаОбъект", ОтмеченнаяПозиция.Родитель));
		Если НЕ НайденныеРазделы.Количество() Тогда
			ТекстПредупреждения			= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Уровень применения индексов не позволяет изменять индексы по выбранным позициям: ""%1"".'"), НаименованиеПозиции);	
			ДоступнаОбработкаКоманды	= Ложь;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДоступнаОбработкаКоманды;
	
КонецФункции //Функция СМ_ДоступнаОбработкаИндексыНаКлиенте(Команда, Операция, ТекстПредупреждения = "")

