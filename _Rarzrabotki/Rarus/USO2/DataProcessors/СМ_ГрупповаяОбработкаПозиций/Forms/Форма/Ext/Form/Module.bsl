&НаСервере
Функция КомандаРесурсыСтатусРесурса(СтатусРесурса)
	
	МассивПозиции	= Новый Массив();
	МассивРесурсы	= Новый Массив();
	
	//	Получить обрабатываемые ресурсы и позиции.
	ПолучитьОбрабатываемыеПозицииРесурсыНаСервереПоФлагам(МассивПозиции, МассивРесурсы);
	
	
	Для Каждого СсылкаНаОбъект Из МассивПозиции Цикл
		
		ДокументОбъект	= СсылкаНаОбъект.ПолучитьОбъект();
		
		Для Каждого Строка Из ДокументОбъект.РесурсыПозицииЛокальнойСметы Цикл
			
			Если НЕ МассивРесурсы.Найти(Строка.Ресурс) = Неопределено Тогда
				Строка.СтатусРесурса	= СтатусРесурса;	
			КонецЕсли;	
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СсылкаНаОбъект.ИДПозицииВладельца) Тогда
			ДокументОбъект.СтатусРесурса	= СтатусРесурса;
		ИначеЕсли НЕ МассивРесурсы.Найти(СсылкаНаОбъект.Наименование) = Неопределено Тогда
			ДокументОбъект.СтатусРесурса	= СтатусРесурса;
		КонецЕсли;
		
		ДокументОбъект.Записать();		

		
	КонецЦикла;
	
	
	Возврат Истина;
	
КонецФункции 

&НаСервере
Функция КомандаРесурсыСтатусРесурсаАкт(СтатусРесурса)
	
	МассивПозиции	= Новый Массив();
	МассивРесурсы	= Новый Массив();
	
	//	Получить обрабатываемые ресурсы и позиции.
	ПолучитьОбрабатываемыеПозицииРесурсыНаСервереПоФлагам(МассивПозиции, МассивРесурсы);
	
	ДокументАкт = Документ.ПолучитьОбъект();
	
	Для Каждого СсылкаНаОбъект Из МассивПозиции Цикл
		
		Для Каждого Строка Из ДокументАкт.РесурсыПозицийАкта Цикл
			
			Если НЕ МассивРесурсы.Найти(Строка.Ресурс) = Неопределено 
				И Строка.Позиция = СсылкаНаОбъект  Тогда
				Строка.СтатусРесурсаАкт	= СтатусРесурса;	
			КонецЕсли;	
			
		КонецЦикла;
		
		ДокументОбъект	= СсылкаНаОбъект.ПолучитьОбъект();
		Если ЗначениеЗаполнено(СсылкаНаОбъект.ИДПозицииВладельца) Тогда
			ДокументОбъект.СтатусРесурсаАкт	= СтатусРесурса;
		ИначеЕсли НЕ МассивРесурсы.Найти(СсылкаНаОбъект.Наименование) = Неопределено Тогда
			ДокументОбъект.СтатусРесурсаАкт	= СтатусРесурса;
		КонецЕсли;
		ДокументОбъект.Записать();		

		
	КонецЦикла;
	
	ДокументАкт.Записать();
	
	Возврат Истина;
	
КонецФункции 

&НаСервере
Процедура РесурсыУдалитьСтрокиНаСервере(Идентификаторы)
		
	//	Удалить из табличной части, на форме.
	Для Каждого Идентификатор Из Идентификаторы Цикл
		
		//        
		Строка	= ТабличнаяЧастьРесурсы.НайтиПоИдентификатору(Идентификатор);
		
		//
		ТабличнаяЧастьРесурсы.Удалить(Строка);
		
	КонецЦикла;
	
	//
	Элементы.тзРесурсы.Обновить();
	
КонецПроцедуры //Процедура РесурсыУдалитьСтрокиНаСервере(Идентификаторы)

&НаСервере
Процедура ПолучитьОбрабатываемыеПозицииРесурсыНаСервереПоФлагам(МассивПозиции, МассивРесурсы)
	
	//	Получить обрабатываемые ресурсы и позиции.
	Для Каждого Идентификатор Из ТабличнаяЧастьРесурсы Цикл
		Если Идентификатор.Пометка Тогда
			//	добавить ресурс
			Если ЗначениеЗаполнено(Идентификатор.Ресурс) Тогда
				МассивРесурсы.Добавить(Идентификатор.Ресурс);
			Иначе
				МассивРесурсы.Добавить(Идентификатор.НаименованиеРесурса);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//
	ТаблицаЗначений	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	МассивПозиции	= ТаблицаЗначений.ВыгрузитьКолонку("СсылкаНаОбъект");
	
КонецПроцедуры //Процедура ПолучитьОбрабатываемыеПозицииРесурсыНаСервере(Идентификаторы, МассивПозиции, МассивРесурсы)

&НаСервере
Процедура ПолучитьОбрабатываемыеПозицииРесурсыНаСервере(Идентификаторы, МассивПозиции, МассивРесурсы)
	
	//	Получить обрабатываемые ресурсы и позиции.
	Для Каждого Идентификатор Из Идентификаторы Цикл
	
		//        
		Строка	= ТабличнаяЧастьРесурсы.НайтиПоИдентификатору(Идентификатор);
		
		//	добавить ресурс
		МассивРесурсы.Добавить(Строка.Ресурс);
		
	КонецЦикла;
	
	//
	ТаблицаЗначений	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	МассивПозиции	= ТаблицаЗначений.ВыгрузитьКолонку("СсылкаНаОбъект");
	
КонецПроцедуры //Процедура ПолучитьОбрабатываемыеПозицииРесурсыНаСервере(Идентификаторы, МассивПозиции, МассивРесурсы)

#КонецОбласти //#Область Удалить

