//  Изменение процентования расценок.
&НаСервере
Функция КомандаПроцентоватьНаСервере(Процент)
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	ДокументОбъект 			= Документ.ПолучитьОбъект();
		
	//
	НачатьТранзакцию();
	
	Для каждого Строка Из ОбрабатываемыеПозиции Цикл
		
		Если Строка.СтатусРедактирования = 1 Тогда
			Продолжить;
		КонецЕсли;

		Объем = (Строка["СсылкаНаОбъект"].ОбъемРабот/100) * Процент;
		
		СМ_СметаВызовСервера.ИзменитьФактОбъемПозицииАкта(ДокументОбъект, Строка["СсылкаНаОбъект"], Объем,,,Истина);
	
	КонецЦикла;
	
	ДокументОбъект.Записать();
	
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	Возврат Истина;

КонецФункции //Функция КомандаПроцентоватьНаСервере(Процент)

