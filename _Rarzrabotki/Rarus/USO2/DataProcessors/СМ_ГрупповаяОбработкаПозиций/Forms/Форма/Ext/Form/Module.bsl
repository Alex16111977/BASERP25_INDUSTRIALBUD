#КонецОбласти //#Область Отображение

//	Заполнение параметров формы.
#Область Параметры

&НаСервере
Процедура УстановитьПараметрыНаСервере(ВыбранноеЗначение = Неопределено)
	
	//
	Параметры["СодержитБазисноИндексныйУровеньРасценка"]	= СодержитБазисноИндексныйУровеньРасценка(ВыбранноеЗначение);
	Параметры["СодержитБазисноИндексныйУровеньРаздел"]		= СодержитБазисноИндексныйУровеньРаздел(ВыбранноеЗначение);
	Параметры["СодержитИндексыПоЭлементам"]					= СодержитИндексыПоЭлементам(ВыбранноеЗначение);
	Параметры["СодержитФайлСборникаТекущихЦен"]				= СодержитФайлСборникаТекущихЦен(ВыбранноеЗначение);

	Параметры["ЭтоОбработкаАктаВыполненныхРабот"]			= ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот");
	Параметры["ЭтоОбработкаСводнойСметы"]					= ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_СводнаяСмета");
	Параметры["ЭтоОбработкаОбъектнойСметы"]					= ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета");
	Параметры["ЭтоОбработкаЛокальнойСметы"]					= ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета");
	
	//
	Если НЕ ЗначениеЗаполнено(Параметры["ПоУмолчаниюОбластьОбработки"]) Тогда
		//Параметры["ПоУмолчаниюОбластьОбработки"]			= "РАСЦЕНКИ";	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Параметры["ПоУмолчаниюДействие"]) Тогда
		//Параметры["ПоУмолчаниюДействие"]					= "Перенести";	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Параметры["ПоУмолчаниюОтбор"]) Тогда
	КонецЕсли;
	
	//	Текущий документ, определит внешний вид обработки по умолчанию.
	Если ЗначениеЗаполнено(Параметры["ТекущийДокумент"]) Тогда
		//Параметры["ТекущийДокумент"] = Документы.СМ_ЛокальнаяСмета.ПустаяСсылка();
		Документ = Параметры.ТекущийДокумент; 
		Если Параметры.ЭтоОбработкаЛокальнойСметы Тогда
			Стройка = Документ.Стройка;
		КонецЕсли;
	КонецЕсли;
	
	//
	Параметры.АвтоматическиОбновлятьТабличнуюЧасть			= Истина;
	
	//	Ограничить доступ к обработке, если выбрана "Локальная мета" и по ней есть акты выполненных работ.
	Параметры.ЕстьАктыВыполненныхРабот						= СМ_УчетВыполненныхРаботСервер.СуществуютАктыПоСмете(Параметры.ТекущийДокумент);
	
КонецПроцедуры //Процедура УстановитьПараметрыНаСервере(ВыбранноеЗначение = Неопределено)

&НаКлиенте
Процедура УстановитьПараметрыОбрабатываемыеЭлементыНаКлиенте(ПараметрыОбработки = Неопределено)
	
	//	Необходимо определить поведение алгоритмов.
	УстановитьПараметрыПринадлежитНаКлиенте(ПараметрыОбработки);
		
	//	Необходимо запретить переносить позиции (без родителей), в сметы.
	Параметры["ЕстьПозицииБезБыбранногоРаздела"]	= ЕстьПозицииБезБыбранногоРазделаНаКлиенте();
	
	//	Нужно, для проверки доступности обработки команды.
	УстановитьПараметрыОперацияНаКлиенте();	
	
КонецПроцедуры //Процедура УстановитьПараметрыОбрабатываемыеЭлементыНаКлиенте(ПараметрыОбработки = Неопределено)


&НаКлиенте
Процедура УстановитьПараметрыОперацияНаКлиенте()
	
	//
	ОбрабатываемыеОбъектныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ОбъектнаяСмета")), Истина));
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета")), Истина));
	ОбрабатываемыеРазделы			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина));
	ОбрабатываемыеПозиции			= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
		
	//	нужно, для проверки доступности обработки команды
	Если ОбрабатываемыеОбъектныеСметы.Количество() Тогда
		Параметры["Операция"]	= "ОбработкаОбъектнойСметы";	//	для документов с типом "Сводная смета"
	ИначеЕсли ОбрабатываемыеЛокальныеСметы.Количество() Тогда
		Параметры["Операция"]	= "ОбработкаЛокальнойСметы"; 	//	для документов с типом "Сводная смета", "Объектная смета"
	ИначеЕсли ОбрабатываемыеРазделы.Количество() Тогда
		Параметры["Операция"]	= "ОбработкаРаздела"; 			//	для документов с типом "Локальная смета"
	ИначеЕсли ОбрабатываемыеПозиции.Количество() Тогда
		Параметры["Операция"]	= "ОбработкаПозиции";			//	для документов с типом "Локальная смета"
	КонецЕсли;

КонецПроцедуры //Процедура УстановитьПараметрыОперацияНаКлиенте()

&НаКлиенте
Процедура УстановитьПараметрыПринадлежитНаКлиенте(ПараметрыОбработки)
	
	//
	Параметры["ПринадлежатОднойОбъектнойСмете"]	= ПараметрыОбработки["ВладельцыОбъектныеСметы"].Количество()=1;
	Параметры["ПринадлежатОднойЛокальнойСмете"]	= ПараметрыОбработки["ВладельцыЛокальныеСметы"].Количество()=1;
	Параметры["ПринадлежатОдномуРазделу"]		= ПараметрыОбработки["ВладельцыРазделы"].Количество()=1;

КонецПроцедуры //Процедура УстановитьПараметрыПринадлежитНаКлиенте(ПараметрыОбработки)

&НаКлиенте
Функция ЕстьПозицииБезБыбранногоРазделаНаКлиенте()
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//
	Для Каждого ОбрабатываемаяПозиция Из ОбрабатываемыеПозиции Цикл
		
		//	Массив
		ПозицияВложена			= Ложь;
		ОбрабатываемыеРазделы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина));
		
		//	Если выбран раздел, для обрабатываемой позиции.
		Для Каждого ОбрабатываемыйРаздел Из ОбрабатываемыеРазделы Цикл
			Если ОбрабатываемыйРаздел["СсылкаНаОбъект"] = ОбрабатываемаяПозиция["Родитель"] Тогда
				ПозицияВложена	= Истина;
				Прервать;	
			КонецЕсли;
		КонецЦикла;
		
		//
		Если НЕ ПозицияВложена Тогда
			Возврат Истина;
			Прервать;	
		КонецЕсли;
		
	КонецЦикла;
	
	//
	Возврат Ложь;
	
КонецФункции //Функция ЕстьПозицииБезБыбранногоРазделаНаКлиенте()


&НаСервере
Процедура СформироватьПараметрыОбновленияНаСервере(ПараметрыОбновления)
	
	Если ПараметрыОбновления = Неопределено Тогда
		ПараметрыОбновления = Новый Структура;
	КонецЕсли;
	
	ПараметрыОбновления.Вставить("ОтображатьПрефиксы"	, ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОтображатьПрефиксы",Ложь));
	ПараметрыОбновления.Вставить("Вид"					, "ГрупповаяОбработкаПозиций");
		
КонецПроцедуры //Процедура СформироватьПараметрыОбновленияНаСервере(ПараметрыОбновления)

&НаКлиенте
Функция СформироватьПараметрыОбработкиНаКлиенте(ПараметрыОбработки = Неопределено)
	
	//
	Если ПараметрыОбработки = Неопределено Тогда
		ПараметрыОбработки	= Новый Структура;	
	КонецЕсли;
	
	//	ВладельцыСводныеСметы
	Если НЕ ПараметрыОбработки.Свойство("ВладельцыСводныеСметы") Тогда
		ПараметрыОбработки.Вставить("ВладельцыСводныеСметы", Новый Массив);
	КонецЕсли;
	
	//	ВладельцыСводныеСметы
	Если НЕ ПараметрыОбработки.Свойство("ВладельцыОбъектныеСметы") Тогда
		ПараметрыОбработки.Вставить("ВладельцыОбъектныеСметы", Новый Массив);
	КонецЕсли;
	
	//	ВладельцыСводныеСметы
	Если НЕ ПараметрыОбработки.Свойство("ВладельцыЛокальныеСметы") Тогда
		ПараметрыОбработки.Вставить("ВладельцыЛокальныеСметы", Новый Массив);
	КонецЕсли;
	
	//	ВладельцыСводныеСметы
	Если НЕ ПараметрыОбработки.Свойство("ВладельцыРазделы") Тогда
		ПараметрыОбработки.Вставить("ВладельцыРазделы", Новый Массив);
	КонецЕсли;
	
	//
	Возврат ПараметрыОбработки;
	
КонецФункции //Функция СформироватьПараметрыОбработкиНаКлиенте(ПараметрыОбработки = Неопределено)

//
//
//	Параметры:
//
//	СсылкаНаОбъект	- ДокументСсылка.СМ_РазделЛокальнойСметы, ДокументСсылка.СМ_ПозицияЛокальнойСметы	- 
//	Родитель		- 
//	ЛокальнаяСмета	-
//	Операция		-
//	Разделы			-
//
&НаСервере
Функция ПолучитьПараметрыСменыРодителяНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование = Ложь)
	
	//
	Структура		= Новый Структура("ЛокальнаяСмета, Родитель, Владелец");
	
	//	1. Определим, какой локальной смете, принадлежит документ (копируемый, перемещаемый).
	ЛокальнаяСмета	= ПолучитьПараметрыСменыРодителяЛокальнаяСметаНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование);
	
	//	2. Определим родителя раздела/позиции.
	Родитель		= ПолучитьПараметрыСменыРодителяРодительНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование);	
	
	//	3. Определи владельца, привязанной позиции.
	Владелец		= ПолучитьПараметрыСменыРодителяВладелецНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование);
	
	Структура.Вставить("ЛокальнаяСмета"	, ЛокальнаяСмета);
	Структура.Вставить("Родитель"		, Родитель);
	Структура.Вставить("Владелец"		, Владелец);

	//
	Возврат Структура;
	
КонецФункции //Функция ПолучитьПараметрыСменыРодителяНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование = Ложь)

//
//
//	Параметры:
//
//	СсылкаНаОбъект	- ДокументСсылка.СМ_РазделЛокальнойСметы, ДокументСсылка.СМ_ПозицияЛокальнойСметы	- 
//	Родитель		- 
//	ЛокальнаяСмета	-
//	Операция		-
//	Разделы			-
//
&НаСервере
Функция ПолучитьПараметрыСменыРодителяЛокальнаяСметаНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование = Ложь)
	
	//
	Если ЭтоКопирование Тогда
		
		//
		Структура	= Неопределено;
		
		//
		Если ОбрабатываемРодительскийЭлементНаСервере(СсылкаНаОбъект, Структура) Тогда
			
			//	1. если переносим элемент корня
			
			Если ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				//	1. локальная смета приемника
				Возврат ЭлементПриемник.ИДСметы;
			ИначеЕсли ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				//	2. сама локальная смета
				Возврат ЭлементПриемник;
			Иначе
				Возврат Неопределено;
			КонецЕсли;
			
		Иначе
			
			//	2. если переносим вложенный элемент	
			
			Если ТипЗнч(Структура["СтрокаДерева"]["СсылкаНаОбъект"]) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				Возврат Структура["СтрокаДерева"]["Копия"];
			Иначе
				Возврат Структура["СтрокаДерева"]["Копия"].ИДСметы;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Если ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			//	1. локальная смета приемника
			Возврат ЭлементПриемник.ИДСметы;
		ИначеЕсли ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			//	2. сама локальная смета
			Возврат ЭлементПриемник;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции //Функция ПолучитьПараметрыСменыРодителяЛокальнаяСметаНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование = Ложь)

//
//
//	Параметры:
//
//	СсылкаНаОбъект	- ДокументСсылка.СМ_РазделЛокальнойСметы, ДокументСсылка.СМ_ПозицияЛокальнойСметы	- 
//	Родитель		- 
//	ЛокальнаяСмета	-
//	Операция		-
//	Разделы			-
//
&НаСервере
Функция ПолучитьПараметрыСменыРодителяРодительНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование = Ложь)
	
	//	Заполняем структуру, в следующей функции.
	Структура	= Новый Структура();
	ЭтоВложение	= НЕ ОбрабатываемРодительскийЭлементНаСервере(СсылкаНаОбъект, Структура);
	
	//
	Если ЭтоВложение Тогда
		
		Если ЭтоКопирование Тогда
			
			Если Структура["СтрокаДерева"] = Неопределено Тогда
				Возврат ЭлементПриемник;	
			Иначе
				Возврат Структура["СтрокаДерева"]["Копия"];	
			КонецЕсли;
			
		Иначе
			Возврат СсылкаНаОбъект.ИДРодителя;
		КонецЕсли;
			
	Иначе
		
		Возврат ЭлементПриемник;
	
	КонецЕсли;

КонецФункции //Функция ПолучитьПараметрыСменыРодителяРодительНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование = Ложь)

//
//
//	Параметры:
//
//	СсылкаНаОбъект	- ДокументСсылка.СМ_РазделЛокальнойСметы, ДокументСсылка.СМ_ПозицияЛокальнойСметы	- 
//	Родитель		- 
//	ЛокальнаяСмета	-
//	Операция		-
//	Разделы			-
//
&НаСервере
Функция ПолучитьПараметрыСменыРодителяВладелецНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование = Ложь)
	
	//	Привязанными, могут быть только позиции.
	Если НЕ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Возврат Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка();	
	КонецЕсли;
	
	//
	ТаблицаЗначенийОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	СтрокаПозиция		= ТаблицаЗначенийОбрабатываемыеПозиции.Найти(СсылкаНаОбъект.ИДПозицииВладельца, "СсылкаНаОбъект");
	КопируемВладельца	= НЕ (СтрокаПозиция = Неопределено);
		
	//
	Если КопируемВладельца Тогда
		
		Возврат СтрокаПозиция["Копия"];
			
	Иначе
		
		Возврат Документы.СМ_ПозицияЛокальнойСметы.ПустаяСсылка();
	
	КонецЕсли;

КонецФункции //Функция ПолучитьПараметрыСменыРодителяВладелецНаСервере(СсылкаНаОбъект, ЭлементПриемник, ЭтоКопирование = Ложь)

//
&НаСервере
Функция ОбрабатываемРодительскийЭлементНаСервере(СсылкаНаОбъект, Структура = Неопределено)
	
	//	(!) проверим, если переносим родительский элемент, значит у данного элемента родитель - не изменится.
	
	//
	ТаблицаЗначений	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("УчастиеПометка", Истина));
	
	//
	СтрокаДерева	= ТаблицаЗначений.Найти(СсылкаНаОбъект.ИДРодителя, "СсылкаНаОбъект");
	
	//
	Структура	= Новый Структура("СтрокаДерева");
	Структура.Вставить("СтрокаДерева", СтрокаДерева);
		
	//
	Возврат (СтрокаДерева = Неопределено);
	
КонецФункции //Функция ОбрабатываемРодительскийЭлементНаСервере(СсылкаНаОбъект, Структура = Неопределено)

#КонецОбласти //#Область Параметры

// Предупреждающие надписи, проверка соблюдения условий.
#Область ОповещениеПользователя

// Предупреждение, дальнейшие действия не возможны
&НаСервере
Функция СМ_ДоступнаОбработкаДокументаНаСервере(ВыбранноеЗначение, ТекстПредупреждения)
	
	Если ВыбранноеЗначение = Тип("ДокументСсылка.СМ_СводнаяСмета") тогда
		
		ТекстПредупреждения		= НСтр("ru = 'Обработка данного типа документа - в разработке!'");
		
		Возврат ЛОЖЬ;
		
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот")
		И ТипЗнч(ВыбранноеЗначение) = Тип("СтрокаГруппировкиДинамическогоСписка") тогда
		
		ТекстПредупреждения		= НСтр("ru = 'Необходимо выбрать акт выполненных работ!'");
		
		Возврат ЛОЖЬ;
		
	КонецЕсли;
	
	// Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета")
	//	И СМ_УчетВыполненныхРаботСервер.СуществуютАктыПоСмете(ВыбранноеЗначение) тогда
	//	
	//	ТекстПредупреждения		= НСтр("ru = 'По локальной смете, уже имеются акты выполненных работ! Действие недоступно.'");
	//	
	//	Возврат ЛОЖЬ;
	//	
	// КонецЕсли;
	
	Возврат ИСТИНА;
	
КонецФункции //Функция СМ_ДоступнаОбработкаДокументаНаСервере(ВыбранноеЗначение, ТекстПредупреждения)

&НаКлиенте
Функция СМ_ДоступнаОбработкаНаКлиенте(Команда, Тип = "", Идентификаторы = Неопределено)

	//
	ДоступнаОбработкаКоманды	= Истина;
	ТекстПредупреждения			= НСтр("ru='Обработка команды, не возможна!';");
	
	//	заполнить таблицы, отмеченными элементами и заполнить параметры формы
	ОтобратьОтмеченныеЭлементыНаКлиенте(Идентификаторы);
	
	//	проверка, есть ли данные для обработки
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		ДоступнаОбработкаКоманды		= Ложь;
	КонецЕсли;
	
	//	проверка, есть ли отмеченные элементы
	Если НетОтмеченныхЭлементовНаКлиенте() Тогда
		ДоступнаОбработкаКоманды		= Ложь;
		ТекстПредупреждения				= НСтр("ru='Нет отмеченных элементов!';");
	КонецЕсли;	
	
	//	попытка перенести позицию, в корень локальной сметы
	Если (Параметры["Операция"] = "ОбработкаРаздела" ИЛИ Параметры["Операция"] = "ОбработкаПозиции")
		И НЕ Параметры["ПринадлежатОднойЛокальнойСмете"] Тогда
		ДоступнаОбработкаКоманды		= Ложь;
		ТекстПредупреждения				= НСтр("ru='Для данной операции, необходимо сделать выбор, из одной локальной сметы!';");
	КонецЕсли;
	
	//
	Если ДоступнаОбработкаКоманды Тогда
		Возврат Истина;
	Иначе
		ПоказатьПредупреждение(Новый ОписаниеОповещения("НеДоступнаОбработкаКомандыНаКлиенте", ЭтаФорма), ТекстПредупреждения,, "Обработка команды """ + Команда.Имя + """");
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции //Функция СМ_ДоступнаОбработкаНаКлиенте(Команда, Тип = "", Идентификаторы = Неопределено)

&НаКлиенте
Функция СМ_ДоступнаОбработкаАктВыполненныхРаботНаКлиенте(Команда, Идентификаторы = Неопределено, ПараметрыРасчета = Неопределено)
	
	//
	ДоступнаОбработкаКоманды	= Истина;
	ТекстПредупреждения			= НСтр("ru='Обработка команды, не возможна!';");
	//	имя команды, разобранное в структуру 
	ПараметрыКоманды				= ПолучитьПараметрыКомандыНаКлиенте(Команда);
	
	//	заполнить таблицы, отмеченными элементами и заполнить параметры формы
	ОтобратьОтмеченныеЭлементыНаКлиенте(Идентификаторы);
	
	//	параметры расчета
	ОбрабатываемаяЛокальнаяСмета	= ПолучитьОбрабатываемуюЛокальнуюСметуНаКлиенте();
	ПараметрыРасчета				= СМ_ПолучитьПараметрыРасчетаНаКлиенте(ОбрабатываемаяЛокальнаяСмета);
	
	//
	Если НЕ Параметры.ЭтоОбработкаАктаВыполненныхРабот Тогда
		ДоступнаОбработкаКоманды		= Ложь;
	КонецЕсли;
	
	//
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		ДоступнаОбработкаКоманды		= Ложь;
	КонецЕсли;
	
	//	проверка, есть ли отмеченные элементы
	Если НетОтмеченныхЭлементовНаКлиенте() Тогда
		ДоступнаОбработкаКоманды		= Ложь;
		ТекстПредупреждения				= НСтр("ru='Нет отмеченных элементов!';");
	КонецЕсли;	
	
	//
	Если ПараметрыКоманды["Тип"] = "РЕСУРСЫ" Тогда
		Если НЕ СМ_ДоступнаОбработкаРесурсыНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения, ПараметрыРасчета) Тогда
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	ИначеЕсли ПараметрыКоманды["Тип"] = "ИНДЕКСЫ" Тогда
		Если НЕ СМ_ДоступнаОбработкаИндексыНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения) Тогда	
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//
	Если ДоступнаОбработкаКоманды Тогда
		Возврат Истина;
	Иначе
		ПоказатьПредупреждение(Новый ОписаниеОповещения("НеДоступнаОбработкаКомандыНаКлиенте", ЭтаФорма), ТекстПредупреждения);
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции //Функция СМ_ДоступнаОбработкаАктВыполненныхРаботНаКлиенте(Команда, Тип = "")

&НаКлиенте
Функция СМ_ДоступнаОбработкаОбъектнаяСметаНаКлиенте(Команда, Идентификаторы = Неопределено, ПараметрыРасчета = Неопределено)

	//
	ДоступнаОбработкаКоманды		= Истина;
	ТекстПредупреждения				= НСтр("ru='Обработка команды, не возможна!';");
	КомандаЗаголовок				= ПолучитьСвойствоКомандыДействиеНаКлиенте(Команда.Имя, "Заголовок");
	//	имя команды, разобранное в структуру 
	ПараметрыКоманды				= ПолучитьПараметрыКомандыНаКлиенте(Команда);
	
	//	заполнить таблицы, отмеченными элементами и заполнить параметры формы
	ОтобратьОтмеченныеЭлементыНаКлиенте(Идентификаторы,ПараметрыКоманды);
	
	//	параметры расчета
	ОбрабатываемаяЛокальнаяСмета	= ПолучитьОбрабатываемуюЛокальнуюСметуНаКлиенте();
	ПараметрыРасчета				= СМ_ПолучитьПараметрыРасчетаНаКлиенте(ОбрабатываемаяЛокальнаяСмета);
	
	//	(!) ДЛЯ ПРОГРАММИСТА, проверим, что правильно используем функцию
	Если НЕ Параметры.ЭтоОбработкаОбъектнойСметы Тогда
		ДоступнаОбработкаКоманды		= Ложь;
	КонецЕсли;
	
	//	проверка, есть ли данные для обработки
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		ДоступнаОбработкаКоманды		= Ложь;
	КонецЕсли;
	
	//	проверка, есть ли отмеченные элементы
	Если НетОтмеченныхЭлементовНаКлиенте() Тогда
		ДоступнаОбработкаКоманды		= Ложь;
		ТекстПредупреждения				= НСтр("ru='Нет отмеченных элементов!';");
	КонецЕсли;	
	
	//	попытка перенести позицию, в корень локальной сметы
	Если ПараметрыКоманды["Операция"]["Перенести"]
		ИЛИ ПараметрыКоманды["Операция"]["Копировать"] Тогда
		Если (Параметры["Операция"] = "ОбработкаРаздела" ИЛИ Параметры["Операция"] = "ОбработкаПозиции")
			И НЕ Параметры["ПринадлежатОднойЛокальнойСмете"] Тогда
			ДоступнаОбработкаКоманды	= Ложь;
			ТекстПредупреждения			= НСтр("ru='Для данной операции, необходимо сделать выбор, из одной локальной сметы!';");
		КонецЕсли;
	КонецЕсли;
	
	//	проверка, для табличных частей
	Если ПараметрыКоманды["Тип"] = "РЕСУРСЫ" Тогда
		Если НЕ СМ_ДоступнаОбработкаРесурсыНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения, ПараметрыРасчета) Тогда
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	ИначеЕсли ПараметрыКоманды["Тип"] = "ПОПРАВКИ" Тогда
		Если НЕ СМ_ДоступнаОбработкаПоправкиНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения) Тогда
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	ИначеЕсли ПараметрыКоманды["Тип"] = "НАЧИСЛЕНИЯ" Тогда
		Если НЕ СМ_ДоступнаОбработкаНачисленияНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения) Тогда
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	ИначеЕсли ПараметрыКоманды["Тип"] = "ИНДЕКСЫ" Тогда
		Если НЕ СМ_ДоступнаОбработкаИндексыНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения) Тогда	
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	КонецЕсли;
	
	//	попытка перенести позицию, в корень локальной сметы
	
	//
	Если ДоступнаОбработкаКоманды Тогда
		Возврат Истина;
	Иначе
		ПоказатьПредупреждение(Новый ОписаниеОповещения("НеДоступнаОбработкаКомандыНаКлиенте", ЭтаФорма), ТекстПредупреждения,, "Обработка команды """ + КомандаЗаголовок + """");
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции //Функция СМ_ДоступнаОбработкаОбъектнаяСметаНаКлиенте(Команда, Тип = "", Идентификаторы = Неопределено)

&НаКлиенте
Функция СМ_ДоступнаОбработкаЛокальнаяСметаНаКлиенте(Команда, Идентификаторы = Неопределено, ПараметрыРасчета = Неопределено)
	
	//
	ДоступнаОбработкаКоманды		= Истина;
	ТекстПредупреждения				= НСтр("ru='Обработка команды, не возможна!';");
	КомандаЗаголовок				= ПолучитьСвойствоКомандыДействиеНаКлиенте(Команда.Имя, "Заголовок");
	//	имя команды, разобранное в структуру 
	ПараметрыКоманды				= ПолучитьПараметрыКомандыНаКлиенте(Команда);
	
	//	Заполнить таблицы, отмеченными элементами и заполнить параметры формы.
	ОтобратьОтмеченныеЭлементыНаКлиенте(,ПараметрыКоманды);
	
	//	параметры расчета
	ОбрабатываемаяЛокальнаяСмета	= ПолучитьОбрабатываемуюЛокальнуюСметуНаКлиенте();
	ПараметрыРасчета				= СМ_ПолучитьПараметрыРасчетаНаКлиенте(ОбрабатываемаяЛокальнаяСмета);
	
	//
	Если НЕ Параметры.ЭтоОбработкаЛокальнойСметы Тогда
		ДоступнаОбработкаКоманды		= Ложь;
	КонецЕсли;
	
	//
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		ДоступнаОбработкаКоманды		= Ложь;
	КонецЕсли;
	
	//
	Если НетОтмеченныхЭлементовНаКлиенте() Тогда
		ДоступнаОбработкаКоманды		= Ложь;
		ТекстПредупреждения				= НСтр("ru='Нет отмеченных элементов!';");
	КонецЕсли;
	
	//	Индивидуальная проверка.
	Если ПараметрыКоманды["Тип"] = "РЕСУРСЫ" Тогда
		Если НЕ СМ_ДоступнаОбработкаРесурсыНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения, ПараметрыРасчета) Тогда
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	ИначеЕсли ПараметрыКоманды["Тип"] = "ПОПРАВКИ" Тогда
		Если НЕ СМ_ДоступнаОбработкаПоправкиНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения) Тогда
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	ИначеЕсли ПараметрыКоманды["Тип"] = "НАЧИСЛЕНИЯ" Тогда
		Если НЕ СМ_ДоступнаОбработкаНачисленияНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения) Тогда
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	ИначеЕсли ПараметрыКоманды["Тип"] = "ИНДЕКСЫ" Тогда
		Если НЕ СМ_ДоступнаОбработкаИндексыНаКлиенте(Команда, ПараметрыКоманды["Операция"], ТекстПредупреждения) Тогда	
			ДоступнаОбработкаКоманды	= Ложь;
		КонецЕсли;
	КонецЕсли;
	
	
	//
	Если ДоступнаОбработкаКоманды Тогда
		Возврат Истина;
	Иначе
		
		ПоказатьПредупреждение(Новый ОписаниеОповещения("НеДоступнаОбработкаКомандыНаКлиенте", ЭтаФорма), ТекстПредупреждения,, "Обработка команды """ + КомандаЗаголовок + """");
		Возврат Ложь;
			
	КонецЕсли;	
	
КонецФункции //Функция СМ_ДоступнаОбработкаЛокальнаяСметаНаКлиенте(Команда, Тип = "", Операция = "")

#Область Расценки

Функция СМ_ДоступнаОбработкаПеренестиКопироватьНаКлиенте(ЭлементПриемник, ТекстПредупреждения = "")

	//
	ДоступнаОбработкаКоманды	= Истина;
	
	//
	Если ЭлементПриемник = Неопределено Тогда
		//	отмена действия
	ИначеЕсли ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		
		ДоступнаОбработкаКоманды	= Ложь;
		ТекстПредупреждения			= НСтр("ru='Позиция, не может быть родителем!';");
		
	ИначеЕсли (Параметры["Операция"] = "ОбработкаРаздела" ИЛИ Параметры["Операция"] = "ОбработкаПозиции") Тогда
		
		Если ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета")
			И Параметры["ЕстьПозицииБезБыбранногоРаздела"] Тогда
		
			ДоступнаОбработкаКоманды	= Ложь;
			ТекстПредупреждения			= НСтр("ru='Есть отмеченные позиции, которые нельзя переносить в локальную смету!';");
			
		ИначеЕсли ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			
			ДоступнаОбработкаКоманды	= Ложь;
			ТекстПредупреждения			= НСтр("ru='Разделы/позиции, нельзя переносить в объектную смету!';");
			
		ИначеЕсли ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда	
			
			ДоступнаОбработкаКоманды	= Ложь;
			ТекстПредупреждения			= НСтр("ru='Разделы/позиции, нельзя переносить в сводную смету!';");
	
		КонецЕсли;
		
	ИначеЕсли Параметры["Операция"] = "ОбработкаЛокальнойСметы"
		И ТипЗнч(ЭлементПриемник) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		
		ДоступнаОбработкаКоманды	= Ложь;
		ТекстПредупреждения			= НСтр("ru='Локальную смету, нельзя переносить в другую локальную смету!';");
		
	КонецЕсли;
	
	//
	Возврат ДоступнаОбработкаКоманды;
	
КонецФункции //Функция СМ_ДоступнаОбработкаПеренестиКопироватьНаКлиенте(ТекстПредупреждения = "")

#КонецОбласти //#Область Расценки/#Область ОповещениеПользователя

