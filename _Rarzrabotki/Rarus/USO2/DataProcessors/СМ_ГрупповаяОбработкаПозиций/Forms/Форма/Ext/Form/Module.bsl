	Возврат Истина;
			
КонецФункции 

&НаСервере
Функция КомандаРесурсыНеИзменятьЦены(НеИзменятьЦены = Истина)
	
	//
	МассивПозиции	= Новый Массив();
	МассивРесурсы	= Новый Массив();
	
	//	Получить обрабатываемые ресурсы и позиции.
	ПолучитьОбрабатываемыеПозицииРесурсыНаСервереПоФлагам(МассивПозиции, МассивРесурсы);
	
	
	Для Каждого СсылкаНаОбъект Из МассивПозиции Цикл
		
		ДокументОбъект	= СсылкаНаОбъект.ПолучитьОбъект();
		
		Для Каждого Строка Из ДокументОбъект.РесурсыПозицииЛокальнойСметы Цикл
			
			Если НЕ МассивРесурсы.Найти(Строка.Ресурс) = Неопределено Тогда
				Строка.НеИзменятьЦены	= НеИзменятьЦены;	
			КонецЕсли;	
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СсылкаНаОбъект.ИДПозицииВладельца) Тогда
			ДокументОбъект.НеИзменятьЦены	= НеИзменятьЦены;
		ИначеЕсли НЕ МассивРесурсы.Найти(СокрЛП(СсылкаНаОбъект.Наименование)) = Неопределено Тогда
			ДокументОбъект.НеИзменятьЦены	= НеИзменятьЦены;
		КонецЕсли;

		ДокументОбъект.Записать();		

		
	КонецЦикла;
	
	
	Возврат Истина;
	
КонецФункции 

