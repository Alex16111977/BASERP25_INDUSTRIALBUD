&НаСервере
Функция НаборДополнительныхРеквизитовИСведенийНаСервере()
	
	Если Элементы.СтраницыСвойстваТипы.ТекущаяСтраница = Элементы.СтраницаСводнаяСмета Тогда
		Возврат Неопределено;
	ИначеЕсли Элементы.СтраницыСвойстваТипы.ТекущаяСтраница = Элементы.СтраницаОбъектнаяСмета Тогда
		Возврат Неопределено;
	ИначеЕсли Элементы.СтраницыСвойстваТипы.ТекущаяСтраница = Элементы.СтраницаЛокальнаяСмета Тогда
		Возврат Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_ЛокальнаяСмета;
	ИначеЕсли Элементы.СтраницыСвойстваТипы.ТекущаяСтраница = Элементы.СтраницаРаздел Тогда
		Возврат Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_РазделЛокальнойСметы;
	ИначеЕсли Элементы.СтраницыСвойстваТипы.ТекущаяСтраница = Элементы.СтраницаПозиция Тогда
		Возврат Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_ПозицияЛокальнойСметы;
	КонецЕсли;
	
КонецФункции //Функция НаборДополнительныхРеквизитовИСведенийНаСервере()

&НаСервере
Функция ПолучитьТаблицуСвойствНаСервере(СписокОбъектов)
	
	НаборыСвойств	= Новый СписокЗначений;
	НаборыСвойств.Добавить(Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_ЛокальнаяСмета);
	НаборыСвойств.Добавить(Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_РазделЛокальнойСметы);
	НаборыСвойств.Добавить(Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_ПозицияЛокальнойСметы);
	
	Запрос	= Новый Запрос("ВЫБРАТЬ
	      	               |	ВЗ_ДополнительныеРеквизиты.Свойство,
	      	               |	ВЗ_ДополнительныеРеквизиты.ТекстоваяСтрока,
	      	               |	ПРЕДСТАВЛЕНИЕ(НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство) КАК Заголовок,
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.ТипЗначения КАК ТипЗначения,
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.ЗаполнятьОбязательно КАК ЗаполнятьОбязательно,
	      	               |	ВЗ_ДополнительныеРеквизиты.Значение,
	      	               |	ВЗ_ДополнительныеРеквизиты.Ссылка КАК Позиция
	      	               |ИЗ
	      	               |	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты
	      	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	      	               |			СМ_ЛокальнаяСметаДополнительныеРеквизиты.Свойство КАК Свойство,
	      	               |			СМ_ЛокальнаяСметаДополнительныеРеквизиты.Значение КАК Значение,
	      	               |			ВЫРАЗИТЬ(СМ_ЛокальнаяСметаДополнительныеРеквизиты.ТекстоваяСтрока КАК СТРОКА(150)) КАК ТекстоваяСтрока,
	      	               |			ЗНАЧЕНИЕ(Справочник.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_ЛокальнаяСмета) КАК Набор,
	      	               |			СМ_ЛокальнаяСметаДополнительныеРеквизиты.Ссылка КАК Ссылка
	      	               |		ИЗ
	      	               |			Документ.СМ_ЛокальнаяСмета.ДополнительныеРеквизиты КАК СМ_ЛокальнаяСметаДополнительныеРеквизиты
	      	               |		ГДЕ
	      	               |			СМ_ЛокальнаяСметаДополнительныеРеквизиты.Ссылка В(&СписокОбъектов)
	      	               |		
	      	               |		ОБЪЕДИНИТЬ ВСЕ
	      	               |		
	      	               |		ВЫБРАТЬ
	      	               |			СМ_РазделЛокальнойСметыДополнительныеРеквизиты.Свойство,
	      	               |			СМ_РазделЛокальнойСметыДополнительныеРеквизиты.Значение,
	      	               |			ВЫРАЗИТЬ(СМ_РазделЛокальнойСметыДополнительныеРеквизиты.ТекстоваяСтрока КАК СТРОКА(150)),
	      	               |			ЗНАЧЕНИЕ(Справочник.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_РазделЛокальнойСметы),
	      	               |			СМ_РазделЛокальнойСметыДополнительныеРеквизиты.Ссылка
	      	               |		ИЗ
	      	               |			Документ.СМ_РазделЛокальнойСметы.ДополнительныеРеквизиты КАК СМ_РазделЛокальнойСметыДополнительныеРеквизиты
	      	               |		ГДЕ
	      	               |			СМ_РазделЛокальнойСметыДополнительныеРеквизиты.Ссылка В(&СписокОбъектов)
	      	               |		
	      	               |		ОБЪЕДИНИТЬ ВСЕ
	      	               |		
	      	               |		ВЫБРАТЬ
	      	               |			СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты.Свойство,
	      	               |			СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты.Значение,
	      	               |			ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты.ТекстоваяСтрока КАК СТРОКА(150)),
	      	               |			ЗНАЧЕНИЕ(Справочник.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_ПозицияЛокальнойСметы),
	      	               |			СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты.Ссылка
	      	               |		ИЗ
	      	               |			Документ.СМ_ПозицияЛокальнойСметы.ДополнительныеРеквизиты КАК СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты
	      	               |		ГДЕ
	      	               |			СМ_ПозицияЛокальнойСметыДополнительныеРеквизиты.Ссылка В(&СписокОбъектов)) КАК ВЗ_ДополнительныеРеквизиты
	      	               |		ПО НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство = ВЗ_ДополнительныеРеквизиты.Свойство
	      	               |			И НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка = ВЗ_ДополнительныеРеквизиты.Набор
	      	               |ГДЕ
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка В(&НаборыСвойств)
	      	               |	И НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.ПометкаУдаления = ЛОЖЬ");
	Запрос.УстановитьПараметр("СписокОбъектов"	, СписокОбъектов);
	Запрос.УстановитьПараметр("НаборыСвойств"	, НаборыСвойств);
	
	Результат	= Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции //Функция ПолучитьТаблицуСвойствНаСервере()

&НаСервере
Функция ПолучитьТаблицуДополнительныхРеквизитовНаСервере()
	
	НаборыСвойств	= Новый СписокЗначений;
	НаборыСвойств.Добавить(Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_ЛокальнаяСмета);
	НаборыСвойств.Добавить(Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_РазделЛокальнойСметы);
	НаборыСвойств.Добавить(Справочники.НаборыДополнительныхРеквизитовИСведений.Документ_СМ_ПозицияЛокальнойСметы);
	
	Запрос	= Новый Запрос("ВЫБРАТЬ
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.ТипЗначения КАК ТипЗначения,
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.ЗаполнятьОбязательно КАК ЗаполнятьОбязательно,
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство,
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Свойство.Заголовок КАК Заголовок,
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка КАК Набор,
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка.Наименование,
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка.ИмяПредопределенныхДанных
	      	               |ИЗ
	      	               |	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты
	      	               |ГДЕ
	      	               |	НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.Ссылка В(&НаборыСвойств)
	      	               |	И НаборыДополнительныхРеквизитовИСведенийДополнительныеРеквизиты.ПометкаУдаления = ЛОЖЬ");
	Запрос.УстановитьПараметр("НаборыСвойств"	, НаборыСвойств);
	
	Результат	= Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции //Функция ПолучитьТаблицуСвойствНаСервере()

