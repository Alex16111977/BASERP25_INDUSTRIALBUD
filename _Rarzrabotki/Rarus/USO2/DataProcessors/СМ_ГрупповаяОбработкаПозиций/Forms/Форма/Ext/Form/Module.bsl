//
//	Параметры:
//	Результат			- СправочникСсылка.СМ_Ресурсы - выбранный ресурс, на замену.
//	ПараметрыОповещения	- Структура	- 	
//
&НаКлиенте
Процедура КомандаРесурсыЗаменитьВводЗначенияОповещениеНаКлиенте(ПараметрыЗамены, ПараметрыОповещения) Экспорт
	
	//
	Если Не ЗначениеЗаполнено(ПараметрыЗамены) Тогда
		Возврат;
	КонецЕсли;
	
	//	Выполнить действие.
	Если КомандаРесурсыЗаменитьНаСервере(ОбъединитьПараметрыНаКлиенте(ПараметрыЗамены, ПараметрыОповещения)) Тогда
		
		//	Заполнить дерево значений.
		ДеревоЗначенийОбновитьНаКлиенте(Новый Структура("Документ", Документ));
		
		//	Заполнить сводные таблицы значений, по табличным частям документов.
		ЗаполнитьТаблицыЗначенийНаСервере();
		
		//	Добавить строки в отобранные "Ресурсы", "Поправки", "Начисления", "Индексы", "Свойства".
		ЗаполнитьТабличныеЧастиНаКлиенте();
		
		//	Сообщить пользователю.
		СообщитьПользователюУспешноеВыполнениеКомандыНаСервере(ПараметрыОповещения.КомандаИмя);
		
	КонецЕсли;	
	
