&НаСервере
Процедура СообщитьПользователюУспешноеВыполнениеКомандыНаСервере(КомандаИмя, ТекстСообщенияПользователю = "")
	
	//
	Если НЕ Команды.Найти(КомандаИмя) = Неопределено Тогда
		НаименованиеКоманды	= Команды[КомандаИмя].Заголовок
	Иначе
		НаименованиеКоманды	= КомандаИмя;	
	КонецЕсли;
	
	//
	Если НЕ ЗначениеЗаполнено(ТекстСообщенияПользователю) Тогда
		ТекстСообщенияПользователю	= НСтр("ru='[" + Формат(ТекущаяДата(), "DT") + "] Обработка действия """ + НаименованиеКоманды + """ - выполнена!'");	
	КонецЕсли;
	
	//
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияПользователю);
	
	ТабличнаяЧастьРесурсы.Очистить();
КонецПроцедуры //Процедура СообщитьПользователюУспешноеВыполнениеКомандыНаСервере(КомандаИмя, ТекстСообщенияПользователю = "")

