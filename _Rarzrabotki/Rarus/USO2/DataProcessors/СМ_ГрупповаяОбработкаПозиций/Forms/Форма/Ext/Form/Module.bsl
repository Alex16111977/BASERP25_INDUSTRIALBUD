&НаСервере
Функция КомандаПоправкиРедактироватьНаСервере()
	
	//
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета")), Истина));
	
	//
	НачатьТранзакцию();
	
	//
	Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
		
		//
		ТаблицаЗначенийОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка, ЛокальнаяСмета", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина, Строка["СсылкаНаОбъект"]));
		ОтобранныеПозиции						= ТаблицаЗначенийОбрабатываемыеПозиции.ВыгрузитьКолонку("СсылкаНаОбъект");
		
		//	(!) Когда нажимаем "СОбнулением", во всех строках проставляется значение "Модифицированность".
		ТаблицаЗначенийПоправки					= ТабличнаяЧастьПоправки.Выгрузить(Новый Структура("Пометка, Модифицированность", Истина, Истина));
		
		//	Записываем в документы.
		СМ_СметаВызовСервера.ОбновитьПоправкиСметы(ТаблицаЗначенийПоправки,, ОтобранныеПозиции, СОбнулением); 
	
	КонецЦикла;
	
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	//
	Возврат Истина;
	
КонецФункции //Функция КомандаПоправкиРедактироватьНаСервере()

// Воноков 
&НаСервере
Функция КомандаПоправкиДобавитьНаСервере()
	
	//
	ТаблицаЗначений	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	СписокПозиций	= ТаблицаЗначений.ВыгрузитьКолонку("СсылкаНаОбъект");
	Результат		= Истина;
	
	//	Обрабатываемые поправки.
	ТаблицаРедактированияПоправок = ТабличнаяЧастьПоправки.Выгрузить(Новый Структура("ЭтоНоваяСтрока", Истина));

	//	Транзакция
	НачатьТранзакцию();
	
	//	Записываем в документы.
	Результат = СМ_СметаВызовСервера.ДобавитьПоправкиСметы(ТаблицаРедактированияПоправок,, СписокПозиций); 
	
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	Возврат Результат;
	
КонецФункции //Функция КомандаПоправкиДобавитьНаСервере()

// Удаление Поправок. 
&НаСервере
Функция КомандаПоправкиУдалитьНаСервере()
	
	//
	Результат						= Истина;
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета")), Истина));
		
	НачатьТранзакцию();

	//
	Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
		
		ТаблицаЗначенийПозиции	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка, ЛокальнаяСмета", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина, Строка["СсылкаНаОбъект"]));
		ОтборПозиций			= ТаблицаЗначенийПозиции.ВыгрузитьКолонку("СсылкаНаОбъект");
	
		ТаблицаЗначенийПоправки = ТабличнаяЧастьПоправки.Выгрузить(Новый Структура("Пометка", Истина));	
	
		//	Запись в документы.
		Результат = СМ_СметаВызовСервера.УдалитьПоправкиСметы(ТаблицаЗначенийПоправки, Строка["СсылкаНаОбъект"], ОтборПозиций); 
	
	КонецЦикла;
	
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	//	Удалить строки из табличной части, которые были удалены из позиций.
	НайденныеСтроки	= ТабличнаяЧастьПоправки.НайтиСтроки(Новый Структура("Пометка", Истина));
	Для Каждого Строка Из НайденныеСтроки Цикл
		ТабличнаяЧастьПоправки.Удалить(Строка);
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();
	
	Возврат Результат;
	
КонецФункции //Функция КомандаПоправкиУдалитьНаСервере()

#КонецОбласти //#Область ПОПРАВКИ/#Область ВспомогательныеФункции/#Область КомандыФормы

#Область НАЧИСЛЕНИЯ

&НаСервере
Функция КомандаНачисленияРедактироватьНаСервере(ВернутьСтандартные = Ложь)
	
	НачатьТранзакцию();
	
	//
	ТаблицаЗначений	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	ОтборПозиций	= ТаблицаЗначений.ВыгрузитьКолонку("СсылкаНаОбъект");
	
	ТаблицаРедактированияНачислений = ТабличнаяЧастьНачисления.Выгрузить();
	ИменаКолонокМассив = Новый Массив();
	ИменаКолонокМассив.Добавить("Значение");
	ИменаКолонокМассив.Добавить("Формула");
	
	// 1. Оставим только измененные значения
	Если ТаблицаРедактированияНачислений.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Нет изменений в значениях и формулах'"));
		Возврат Ложь;
	КонецЕсли;          
	
	// 2. Записываем в документы
	Результат = СМ_СметаВызовСервера.ОбновитьНачисленияСметы(ТаблицаРедактированияНачислений, Документ, ОтборПозиций, ВернутьСтандартные); 
	
	// 3. Пересчитываем
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	//
	Возврат Результат;
	
КонецФункции //Функция КомандаНачисленияРедактироватьНаСервере(ВернутьСтандартные = Ложь)

#КонецОбласти //#Область НАЧИСЛЕНИЯ/#Область ВспомогательныеФункции/#Область КомандыФормы

