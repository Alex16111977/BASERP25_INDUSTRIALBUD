#Область РедактироватьЦены

&НаСервере
Функция КомандаРесурсыРедактироватьЦеныНаСервере()
		
	//
	ТаблицаЗначенийОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	ОтобранныеПозиции						= ТаблицаЗначенийОбрабатываемыеПозиции.ВыгрузитьКолонку("СсылкаНаОбъект");
	
	// !!! Важно !!!
	// Когда нажимаем "СОбнулением", во всех строках проставляется значение "Модифицированность".
	ТаблицаЗначенийРесурсы 					= ТабличнаяЧастьРесурсы.Выгрузить(Новый Структура("Модифицированность", Истина));
	
	НачатьТранзакцию(); // СУДАРИКОВ - блокировки
	
	// Установка управляемой блокировки позиций ЛС по ИДсметы
	Если ОтобранныеПозиции.Количество() > 0 Тогда 
		Блокировка 					= Новый БлокировкаДанных;
		ЭлементБлокировки 			= Блокировка.Добавить();
		ЭлементБлокировки.Область 	= "Документ.СМ_ПозицияЛокальнойСметы";
		ЭлементБлокировки.Режим 	= РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("ИДСметы", ОтобранныеПозиции[0].ИДСметы); 
		Блокировка.Заблокировать();	
	КонецЕсли;
	
	//	Записываем в документы.
	СМ_СметаВызовСервера.ОбновитьЦеныРесурсыСметы(ТаблицаЗначенийРесурсы,, ОтобранныеПозиции, СОбнулением); 

	ЗафиксироватьТранзакцию();  // СУДАРИКОВ - блокировки
	
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
		
	//	Обновить таблицу значений, на форме.	
	Для Каждого Строка Из ТабличнаяЧастьРесурсы Цикл
		
		//	снять модифицированность, т.к. ресурсы изменены.
		Строка.Модифицированность	= Ложь;
		Строка.ЦенаБазиснаяСтарая	= Строка.ЦенаБазисная;
		Строка.ЦенаТекущаяСтарая	= Строка.ЦенаТекущая;
		Строка.ЦенаЗМБазиснаяСтарая	= Строка.ЦенаЗМБазисная;
		Строка.ЦенаТекущаяЗМСтарая	= Строка.ЦенаТекущаяЗМ;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции //Функция КомандаРесурсыРедактироватьЦеныНаСервере()

&НаСервере
Функция КомандаРесурсыРедактироватьЦеныАктНаСервере()
	
	//
	ТаблицаЗначений	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	ОтборПозиций	= ТаблицаЗначений.ВыгрузитьКолонку("СсылкаНаОбъект");
	
	ТаблицаРедактированияЦен = ТабличнаяЧастьРесурсы.Выгрузить();
	ИменаКолонокМассив = Новый Массив();
	ИменаКолонокМассив.Добавить("ЦенаБазисная");
	ИменаКолонокМассив.Добавить("ЦенаТекущая");
	ИменаКолонокМассив.Добавить("ЦенаЗМБазисная");
	ИменаКолонокМассив.Добавить("ЦенаТекущаяЗМ");
	
	//// 1. Оставим только измененные значения.
	//ОставитьТолькоИзмененныеЗначенияВТаблице(ТаблицаРедактированияЦен, ИменаКолонокМассив, СОбнулением);
	
	Если ТаблицаРедактированияЦен.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Нет изменений в ценах'"));
		Возврат Ложь;
	КонецЕсли;
	
	// 2. Записываем в документы.
	Возврат СМ_СметаВызовСервера.ОбновитьЦеныРесурсовАкта(Документ, ТаблицаРедактированияЦен, ОтборПозиций, СОбнулением); 
			
КонецФункции

#КонецОбласти //#Область РедактироватьЦены

#Область Удалить

&НаСервере
Функция КомандаРесурсыУдалитьАктВыполненныхРаботНаСервере()
	
	//
	Идентификаторы	= Элементы.тзРесурсы.ВыделенныеСтроки;
	МассивПозиции	= Новый Массив();
	МассивРесурсы	= Новый Массив();
	
	//	Получить обрабатываемые ресурсы и позиции.
	ПолучитьОбрабатываемыеПозицииРесурсыНаСервере(Идентификаторы, МассивПозиции, МассивРесурсы);
	
	//	Установить признак удаленного, в документе.
	ДокументОбъект	= Документ.ПолучитьОбъект();
		
	Для Каждого Строка Из ДокументОбъект.РесурсыПозицийАкта Цикл
		
		Если НЕ МассивРесурсы.Найти(Строка.Ресурс) = Неопределено Тогда
			Строка.Удален	= Истина;	
		КонецЕсли;	
		
	КонецЦикла;
	
	ДокументОбъект.Записать();		
		
	//	Удалить из табличной части, на форме.
	РесурсыУдалитьСтрокиНаСервере(Идентификаторы);
	
	//
	Возврат Истина;
			
КонецФункции //Функция КомандаРесурсыУдалитьНаСервере()

