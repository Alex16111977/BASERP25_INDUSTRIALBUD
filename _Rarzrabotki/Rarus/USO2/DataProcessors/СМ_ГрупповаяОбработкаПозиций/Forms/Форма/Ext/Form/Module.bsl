// Выполняем непосредственно включение/исключение из расчета.
//
&НаСервере
Функция УстановитьРасчетНаСервере(ЗначениеРасчета)
	
	//
	ОбрабатываемыеРазделы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина));
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//
	НачатьТранзакцию();
	
	//
	Для Каждого Строка Из ОбрабатываемыеРазделы Цикл
		
		//
		ОбъектПозиции = Строка["СсылкаНаОбъект"].ПолучитьОбъект();
		ОбъектПозиции.Расчет = ЗначениеРасчета;
		ОбъектПозиции.Записать();
			
	КонецЦикла;
	
	//
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		Если Строка.СтатусРедактирования = 1 Тогда
			Продолжить;
		КонецЕсли;

		//
		ОбъектПозиции = Строка["СсылкаНаОбъект"].ПолучитьОбъект();
		ОбъектПозиции.Расчет = ЗначениеРасчета;
		ОбъектПозиции.Записать();
			
	КонецЦикла;
	
	ЗафиксироватьТранзакцию();// СУДАРИКОВ - блокировки

	// Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	// ЗафиксироватьТранзакцию(); // СУДАРИКОВ - блокировки.
	
	Возврат Истина;
	
КонецФункции //Функция УстановитьРасчетНаСервере(ЗначениеРасчета)

