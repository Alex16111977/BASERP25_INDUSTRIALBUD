	//
	СодержитИндексыПоЭлементам	= ЛОЖЬ;
	СписокЛокальныеСметы		= ПолучитьЛокальныеСметыНаСервере(ВыбранноеЗначение);
	
	//	
	Для каждого Строка из СписокЛокальныеСметы цикл
		Попытка
			Если Строка.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат тогда
				СодержитИндексыПоЭлементам	= Истина;
				Прервать;
			КонецЕсли;
		Исключение
			СодержитИндексыПоЭлементам	= ЛОЖЬ;
		КонецПопытки;
	КонецЦикла;
	
	//
	Возврат СодержитИндексыПоЭлементам;
	
