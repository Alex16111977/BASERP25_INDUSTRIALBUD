//
&НаКлиенте
Процедура НеДоступнаОбработкаКомандыНаКлиенте(ПараметрыОповещения) Экспорт
	
	Текст = "Заглушка для оповещения";
	
КонецПроцедуры

#Область ДоступнаСменаКоманды

&НаКлиенте
Процедура ДоступнаСменаКомандыВопросНаКлиенте(Команда = Неопределено, ТекстВопроса = "")
	
	//
	Если НЕ ЗначениеЗаполнено(ТекстВопроса) Тогда
		ТекстВопроса	= НСтр("ru='Сменить действие?'");
	КонецЕсли;
	
	//	имя команды, разобранное в структуру 
	ПараметрыКоманды	= ПолучитьПараметрыКомандыНаКлиенте(Команда);
	
	ПараметрыОповещения	= Новый Структура();
	ПараметрыОповещения.Вставить("Команда"	, Команда);
	ПараметрыОповещения.Вставить("Тип"		, ПараметрыКоманды["Тип"]);
	ПараметрыОповещения.Вставить("Операция"	, ПараметрыКоманды["Операция"]);
	
	ВопросКнопки		= Новый СписокЗначений;
	ВопросКнопки.Добавить(КодВозвратаДиалога.Отмена	, "Отмена");
	ВопросКнопки.Добавить(КодВозвратаДиалога.ОК		, "Продолжить");
	
	//
	Если ПараметрыКоманды["Тип"] = "РАСЦЕНКИ" Тогда
		ДоступнаСменаКоманды	= СМ_ДоступнаСменаКомандыРасценкиНаКлиенте(ПараметрыКоманды, ТекстВопроса);
	ИначеЕсли ПараметрыКоманды["Тип"] = "РЕСУРСЫ" Тогда
		ДоступнаСменаКоманды	= СМ_ДоступнаСменаКомандыРесурсыНаКлиенте(ПараметрыКоманды, ТекстВопроса);
	ИначеЕсли ПараметрыКоманды["Тип"] = "ПОПРАВКИ" Тогда
		ДоступнаСменаКоманды	= СМ_ДоступнаСменаКомандыПоправкиНаКлиенте(ПараметрыКоманды, ТекстВопроса);
	ИначеЕсли ПараметрыКоманды["Тип"] = "НАЧИСЛЕНИЯ" Тогда
		ДоступнаСменаКоманды	= СМ_ДоступнаСменаКомандыНачисленияНаКлиенте(ПараметрыКоманды, ТекстВопроса);
	ИначеЕсли ПараметрыКоманды["Тип"] = "ИНДЕКСЫ" Тогда
		ДоступнаСменаКоманды	= СМ_ДоступнаСменаКомандыИндексыНаКлиенте(ПараметрыКоманды, ТекстВопроса);
	Иначе
		ДоступнаСменаКоманды	= Ложь;
	КонецЕсли;
	
	//
	Если ДоступнаСменаКоманды Тогда
		ДоступнаСменаКомандыНаКлиенте(КодВозвратаДиалога.ОК, ПараметрыОповещения);
	Иначе
		ПоказатьВопрос(Новый ОписаниеОповещения("ДоступнаСменаКомандыНаКлиенте", ЭтаФорма, ПараметрыОповещения), ТекстВопроса, ВопросКнопки);
	КонецЕсли;
	
КонецПроцедуры //Процедура ДоступнаСменаКомандыВопросНаКлиенте(Команда = Неопределено, ТекстВопроса = "")

//
//
&НаКлиенте
Процедура ДоступнаСменаКомандыНаКлиенте(КодВозврата, ПараметрыОповещения) Экспорт
	
	Если НЕ КодВозврата = КодВозвратаДиалога.ОК Тогда
		Возврат;		
	КонецЕсли;
		
	//	установить значение
	Если ПараметрыОповещения["Команда"] = Неопределено Тогда
		ПараметрыКоманды	= ПараметрыОповещения;	
	Иначе
		ПараметрыКоманды	= ПолучитьПараметрыКомандыНаКлиенте(ПараметрыОповещения["Команда"]);
	КонецЕсли;
	
	//	установить значение
	Действие				= ПараметрыКоманды["Действие"];
	
	//	изменить форму
	Если ПараметрыОповещения.Тип = "РЕСУРСЫ" Тогда
		УстановитьВидимостьДоступностьЭлементовРесурсыНаКлиенте(ПараметрыКоманды);
	ИначеЕсли ПараметрыОповещения.Тип = "ПОПРАВКИ" Тогда
		
		УстановитьВидимостьДоступностьЭлементовПоправкиНаКлиенте(ПараметрыКоманды);
		
		ОбработатьСменуКомандыПоправкиНаКлиенте(ПараметрыКоманды);
		
		ПоправкиОтобразитьПустуюТаблицуНаКлиенте(ПараметрыКоманды);
		
	ИначеЕсли ПараметрыОповещения.Тип = "НАЧИСЛЕНИЯ" Тогда
		УстановитьВидимостьДоступностьЭлементовНачисленияНаКлиенте(ПараметрыКоманды);
	ИначеЕсли ПараметрыОповещения.Тип = "ИНДЕКСЫ" Тогда
		УстановитьВидимостьДоступностьЭлементовИндексыНаКлиенте(ПараметрыКоманды);
	КонецЕсли;
		
КонецПроцедуры //Процедура ДоступнаСменаКомандыНаКлиенте(КодВозврата, ПараметрыОповещения) Экспорт

&НаКлиенте
Процедура ОбработатьСменуКомандыПоправкиНаКлиенте(ПараметрыКоманды)
	
	Если ПараметрыКоманды["Операция"]["Добавить"] Тогда
		ТабличнаяЧастьПоправки.Очистить();
	КонецЕсли;
	
	Если НЕ ПараметрыКоманды["Операция"]["Добавить"] Тогда
		СменаКомандыПоправкиЗаполнитьТабличнаяЧастьНаКлиенте();		
	КонецЕсли;
	
КонецПроцедуры //Процедура ОбработатьСменуКомандыПоправкиНаКлиенте(ПараметрыКоманды)

&НаКлиенте
Процедура СменаКомандыПоправкиЗаполнитьТабличнаяЧастьНаКлиенте()
	
	//
