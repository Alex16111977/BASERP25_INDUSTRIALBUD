	НачатьТранзакцию();
	
	//
	Если ПараметрыОповещения["ТипОбъекта"] = "АктВыполненныхРабот" тогда
		
		КомандаУстановитьОбъемАктВыполненныхРаботНаСервере(Ссылка, Объем);		
		
