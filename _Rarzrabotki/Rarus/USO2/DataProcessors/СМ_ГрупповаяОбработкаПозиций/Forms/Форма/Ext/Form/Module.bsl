КонецФункции //Функция ЭлементыДеревоЗначенийНайтиНаСервере(ЭлементПриемник, СтрокаДерева = Неопределено)


&НаСервере
Функция ОбрабатываемыеЭлементыМаксимальноПоУровнюОтмеченныйНаСервере()
	
	//	рекурсия
	ПараметрыОбработки	= Новый Структура("Функция, Прервать, Пометка", "ОбрабатываемыеЭлементыСравнитьНаСервере", Ложь, Истина);
	Возврат	ЭлементыДеревоЗначенийРекурсияНаСервере(ЭлементыДеревоЗначений, ПараметрыОбработки);	
	
КонецФункции //Функция ОбрабатываемыеЭлементыМаксимальноПоУровнюОтмеченныйНаСервере()

&НаСервере
Функция ОбрабатываемыеЭлементыСравнитьНаСервере(СтрокаДерева, ПараметрыОбработки)
	
	//
	Если СтрокаДерева["Пометка"] = ПараметрыОбработки["Пометка"] Тогда
		ПараметрыОбработки["Прервать"]	= Истина;	
	КонецЕсли;
	
	Возврат СтрокаДерева;
	
КонецФункции //Функция ОбрабатываемыеЭлементыСравнитьНаСервере(СтрокаДерева, ПараметрыОбработки)

//	Функции универсальные, для перебора дерева значений.

&НаСервере
Функция ЭлементыДеревоЗначенийРекурсияНаСервере(СтрокаДерева, ПараметрыОбработки = Неопределено, ВозвращаемоеЗначение = Неопределено)
	
	Если ПараметрыОбработки = Неопределено Тогда
		ПараметрыОбработки	= Новый Структура("Функция, Прервать", "тест", Ложь);
	ИначеЕсли ТипЗнч(ПараметрыОбработки) = Тип("Структура") Тогда
		
		// Функция
		Если НЕ ПараметрыОбработки.Свойство("Функция") Тогда
			ПараметрыОбработки.Вставить("Функция", "тест");
		КонецЕсли;
		
		// Прервать
		Если НЕ ПараметрыОбработки.Свойство("Прервать") Тогда
			ПараметрыОбработки.Вставить("Прервать", Ложь);
		КонецЕсли;
		
	Иначе
	    Сообщение 		= Новый СообщениеПользователю();
	    Сообщение.Текст = НСтр("ru = 'Параметры рекурсии, могут быть только структурой!'");
	    Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаДерева1 Из СтрокаДерева.ПолучитьЭлементы() Цикл
		
		Если ПараметрыОбработки["Прервать"] Тогда
			Прервать;	
		КонецЕсли;
		
		Выполнить("ВозвращаемоеЗначение	= " + ПараметрыОбработки["Функция"] + "(СтрокаДерева1, ПараметрыОбработки)");
		
		// рекурсия
		ЭлементыДеревоЗначенийРекурсияНаСервере(СтрокаДерева1, ПараметрыОбработки, ВозвращаемоеЗначение);	
		
	КонецЦикла;	
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции //Функция ЭлементыДеревоЗначенийРекурсияНаСервере(СтрокаДерева, ПараметрыОбработки = Неопределено, ВозвращаемоеЗначение = Неопределено)

&НаСервере
Функция ЭлементыДеревоЗначенийПоднятьсяНаСервере(СтрокаДерева, ПараметрыОбработки = Неопределено)
	
	ВозвращаемоеЗначение	= Неопределено;
	СтрокаДереваРодитель	= СтрокаДерева;
	
	Если ПараметрыОбработки = Неопределено Тогда
		ПараметрыОбработки	= Новый Структура("Функция", "тест");
	ИначеЕсли ТипЗнч(ПараметрыОбработки) = Тип("Структура") Тогда
		
		// Функция
		Если НЕ ПараметрыОбработки.Свойство("Функция") Тогда
			ПараметрыОбработки.Вставить("Функция", "тест");
		КонецЕсли;
		
	Иначе
	    Сообщение 		= Новый СообщениеПользователю();
	    Сообщение.Текст = НСтр("ru = 'Параметры выполнения, могут быть только структурой!'");
	    Сообщение.Сообщить();
		Возврат Ложь;
	КонецЕсли;
	
	Пока НЕ СтрокаДереваРодитель = Неопределено Цикл
		
		Выполнить("ВозвращаемоеЗначение	= " + ПараметрыОбработки["Функция"] + "(СтрокаДереваРодитель, ПараметрыОбработки)");
		
		СтрокаДереваРодитель	= СтрокаДереваРодитель.ПолучитьРодителя();
		
	КонецЦикла;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции //Функция ЭлементыДеревоЗначенийПоднятьсяНаСервере(СтрокаДерева, ПараметрыОбработки = Неопределено)

&НаСервере
Функция тест(СтрокаДерева1, ПараметрыОбработки)
	
    Сообщение 		= Новый СообщениеПользователю();
    Сообщение.Текст = НСтр("ru = 'Тест'");
    Сообщение.Сообщить();
	
	Возврат "тест";
	
КонецФункции //Функция тест(СтрокаДерева1, ПараметрыРекурсии)

#КонецОбласти //#Область ОбрабатываемыеЭлементы/#Область ПолучитьЗначение

//	Отображение формы (видимость элементов, списки выбора), в зависимости от выбранных значений.
#Область Отображение

&НаКлиенте
Процедура ДокументПриИзмененииНаКлиенте(ТекущийДокумент = Неопределено, ДействиеПоУмолчанию = "")
	
	//
	СформироватьОбластьОбработкиНаКлиенте();
	
	//	Отображение табличных частей ("РАСЦЕНКИ" - не отображать табличные части).
	ОбработатьПереключениеОбластиОбработкиНаКлиенте();
	
	//
	СформироватьКомандыДействиеНаКлиенте(ТекущийДокумент, ДействиеПоУмолчанию);	
	
	//	
	КомандаИмя			= ПолучитьКомандаИмяНаКлиенте(Действие);
	ПараметрыКоманды	= ПолучитьПараметрыКомандыНаКлиенте(Новый Структура("Имя", КомандаИмя));
	
	//	Видимость/доступность элементов на форме
	УстановитьВидимостьДоступностьЭлементовНаКлиенте(ПараметрыКоманды);
		
КонецПроцедуры //Процедура ДокументПриИзмененииНаКлиенте(ТекущийДокумент = Неопределено, ДействиеПоУмолчанию = "")	

&НаКлиенте
Процедура СформироватьОбластьОбработкиНаКлиенте()
	
	//	РАСЦЕНКИ, РЕСУРСЫ
	Элементы.ОбластьОбработки.СписокВыбора.Очистить();
	Элементы.ОбластьОбработки.СписокВыбора.Добавить("РАСЦЕНКИ", "Расценки");
	Элементы.ОбластьОбработки.СписокВыбора.Добавить("РЕСУРСЫ", "Ресурсы");
	
	//	ПОПРАВКИ, НАЧИСЛЕНИЯ
	Если НЕ Параметры.ЭтоОбработкаАктаВыполненныхРабот Тогда
		Элементы.ОбластьОбработки.СписокВыбора.Добавить("ПОПРАВКИ", "Поправки");
		Элементы.ОбластьОбработки.СписокВыбора.Добавить("НАЧИСЛЕНИЯ", "Начисления");
	КонецЕсли;
	
	//	ИНДЕКСЫ
	Если Параметры.СодержитБазисноИндексныйУровеньРасценка
		ИЛИ Параметры.СодержитБазисноИндексныйУровеньРаздел Тогда
		Элементы.ОбластьОбработки.СписокВыбора.Добавить("ИНДЕКСЫ", "Индексы");
	КонецЕсли;
	
	//	СВОЙСТВА
	Элементы.ОбластьОбработки.СписокВыбора.Добавить("СВОЙСТВА", "Свойства");
	
	//	Установить значение.
	Если Элементы.ОбластьОбработки.СписокВыбора.НайтиПоЗначению(ОбластьОбработки) = Неопределено Тогда
		ОбластьОбработки = "РАСЦЕНКИ";
	КонецЕсли;

КонецПроцедуры //Процедура СформироватьОбластьОбработкиНаКлиенте()

&НаКлиенте
Процедура ОбработатьПереключениеОбластиОбработкиНаКлиенте()
	
	//	Отображение табличных частей ("РАСЦЕНКИ" - не отображать табличные части).
	Элементы.СтраницыТабличныеЧасти.Видимость				= (НЕ ОбластьОбработки = "РАСЦЕНКИ");
	Если НЕ ОбластьОбработки = "РАСЦЕНКИ" тогда
		Элементы.СтраницыТабличныеЧасти.ТекущаяСтраница		= Элементы["Страница" + ОбластьОбработки];
	КонецЕсли;
	
КонецПроцедуры //Процедура ОбработатьПереключениеОбластиОбработкиНаКлиенте()	

&НаКлиенте
Процедура СформироватьКомандыДействиеНаКлиенте(ТекущийДокумент = Неопределено, ДействиеПоУмолчанию = "")
	
	//	Элементы.Действие.СписокВыбора.Добавить() - установить список команд
	УстановитьСписокКоманд(ТекущийДокумент, ДействиеПоУмолчанию, СметнаяКомпонента = Неопределено);
	
	//
	УстановитьСписокКомандПодменюНаСервере(ТекущийДокумент, ОбластьОбработки);
	
	//	Выберем первый элемент. 
	Если ЗначениеЗаполнено(ДействиеПоУмолчанию) тогда
		
		//	установить значение
		Действие 	= ДействиеПоУмолчанию;
		
	Иначе
		
		Если НЕ ЗначениеЗаполнено(Действие) тогда
			
			Если Элементы.Действие.СписокВыбора.Количество() тогда
				Действие = Элементы.Действие.СписокВыбора[0].Значение;
			КонецЕсли;
			
			Элементы.Действие.Доступность = ЗначениеЗаполнено(Действие);
		
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //Процедура СформироватьКомандыДействиеНаКлиенте(ТекущийДокумент = Неопределено, ДействиеПоУмолчанию = "")

//	ДЕЙСТВИЕ (список команд, в зависимости от выбранной области обработки).

&НаСервере
Процедура УстановитьСписокКоманд(ТекущийДокумент, ДействиеПоУмолчанию = "", СметнаяКомпонентаНеопределена = Ложь)
	
	//
	Действие	= "";
	
	Элементы.Действие.СписокВыбора.Очистить();    	
	
	Для каждого Команда Из Команды Цикл
			
		Если Команда.Имя = "ВыполнитьКоманду" Тогда
			Продолжить;
		КонецЕсли;	
		
		Если СметнаяКомпонентаНеопределена Тогда 
			Если Команда.Имя = "РАСЦЕНКИ_ЛС_ОбновитьПоНормативнойБазе" 
				ИЛИ Команда.Имя = "РЕСУРСЫ_ЛС_ЗаменитьРесурсПлюсМинусИзВБ" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Найти(Команда.Имя, ОбластьОбработки) Тогда 
			Если (ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") И Найти(Команда.Имя, "_АКТ")) ИЛИ
				(ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") И Найти(Команда.Имя, "_ЛС")) ИЛИ
				(ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") И Найти(Команда.Имя, "_ОС")) ИЛИ
				(ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_СводнаяСмета") И Найти(Команда.Имя, "_СС")) Тогда
				
				//
				ПараметрыКоманды	= СтрРазделить(Команда.Имя, "_");
				Значение			= ПараметрыКоманды[ПараметрыКоманды.Количество()-1];
				
				//
				Элементы.Действие.СписокВыбора.Добавить(Значение, Команда.Заголовок);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьСписокКомандПодменюНаСервере(ТекущийДокумент, ОбластьОбработки)
	
	Если ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") тогда
		ТипДокумента	= "АКТ";	
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_СводнаяСмета") тогда
		ТипДокумента	= "СМ";	
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") тогда
		ТипДокумента	= "ОС";	
	ИначеЕсли ТипЗнч(ТекущийДокумент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") тогда
		ТипДокумента	= "ЛС";	
	Иначе
		ТипДокумента	= "";	
	КонецЕсли;
		
	//	удалить созданные кнопки формы
	Для Каждого ОписаниеКоманды Из ДействиеКоманды Цикл
		
		//	удалить элемент
		Если НЕ Элементы.Найти(ОписаниеКоманды.Элемент) = Неопределено Тогда
			Элементы.Удалить(Элементы[ОписаниеКоманды.Элемент]);
		КонецЕсли;
		
		//	удалить группу
		Если НЕ Элементы.Найти(ОписаниеКоманды.Группа) = Неопределено Тогда
			Элементы.Удалить(Элементы[ОписаниеКоманды.Группа]);
		КонецЕсли;
		
	КонецЦикла;
	
	//	очистить таблицу
	ДействиеКоманды.Очистить();
	
	//	получить команды
	Для Каждого Команда Из Команды Цикл
		
		ПараметрыКоманды	= СтрРазделить(Команда.Имя, "_", Истина);
		
		//
		Если НЕ ПараметрыКоманды.Количество() = 5 Тогда
			Продолжить;
		КонецЕсли;
		
		//
		Если НЕ ПараметрыКоманды[0] = ОбластьОбработки
			ИЛИ НЕ ПараметрыКоманды[1] = ТипДокумента тогда
			Продолжить;
		КонецЕсли;
		
		//
		ГруппаКнопокИмя	= ПараметрыКоманды[0] + "_" + ПараметрыКоманды[1] + "_" + "Группа" + "_" + ПараметрыКоманды[2];
		КнопкаИмя		= ПараметрыКоманды[0] + "_" + ПараметрыКоманды[1] + "_" + ПараметрыКоманды[4];
		
		//
		ОписаниеКоманды	= ДействиеКоманды.Добавить();
		ОписаниеКоманды.Индекс			= Число(ПараметрыКоманды[3]);
		ОписаниеКоманды.ИндексГруппа	= Число(ПараметрыКоманды[2]);
		ОписаниеКоманды.Группа			= ГруппаКнопокИмя;
		ОписаниеКоманды.Элемент			= КнопкаИмя;
		ОписаниеКоманды.Команда			= Команда.Имя;
		ОписаниеКоманды.Заголовок		= Команда.Заголовок;
		ОписаниеКоманды.Действие		= ПараметрыКоманды[ПараметрыКоманды.Количество()-1];
		
	КонецЦикла;
	
	//	сортировать
	ДействиеКоманды.Сортировать("ИндексГруппа Возр, Индекс Возр");
		
	//	создать элементы формы
	Для Каждого ОписаниеКоманды Из ДействиеКоманды Цикл
		
		//	создать группу кнопок ПодчиненныеЭлементы
		Если Элементы.Найти(ОписаниеКоманды.Группа) = Неопределено Тогда
			ПодменюГруппаКнопок	= Элементы.Вставить(ОписаниеКоманды.Группа, Тип("ГруппаФормы"), Элементы.ГруппаКомандыДействиеПодменю);
			ПодменюГруппаКнопок.Вид	= ВидГруппыФормы.ГруппаКнопок;
		Иначе
			ПодменюГруппаКнопок	= Элементы.Найти(ОписаниеКоманды.Группа);
		КонецЕсли;
		
		//	создать кнопку
		ПодменюКнопка		= Элементы.Добавить(ОписаниеКоманды.Элемент, Тип("КнопкаФормы"), ПодменюГруппаКнопок);
		ПодменюКнопка.ИмяКоманды	= ОписаниеКоманды.Команда;
		ПодменюКнопка.Заголовок		= Команды[ОписаниеКоманды.Команда].Заголовок;
		
	КонецЦикла;
	
КонецПроцедуры //Процедура УстановитьСписокКомандПодменюНаСервере(ОбластьОбработки)


&НаКлиенте
Процедура УстановитьВидимостьДоступностьЭлементовНаКлиенте(ПараметрыКоманды)
	
	Если ПараметрыКоманды = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	//	флажок, возле кнопки "Выполнить"
	Элементы.СОбнулением.Доступность 	= ПараметрыКоманды["Операция"]["Редактировать"];
		
	//	РЕСУРСЫ
	УстановитьВидимостьДоступностьЭлементовРесурсыНаКлиенте(ПараметрыКоманды);
	
	//	ПОПРАВКИ
	УстановитьВидимостьДоступностьЭлементовПоправкиНаКлиенте(ПараметрыКоманды);
	
	//	НАЧИСЛЕНИЯ
	УстановитьВидимостьДоступностьЭлементовНачисленияНаКлиенте(ПараметрыКоманды);
		
	//	ИНДЕКСЫ
	УстановитьВидимостьДоступностьЭлементовИндексыНаКлиенте(ПараметрыКоманды);
	
КонецПроцедуры //Процедура УстановитьВидимостьДоступностьЭлементовНаКлиенте(Действие)

&НаКлиенте
Процедура УстановитьВидимостьДоступностьЭлементовРесурсыНаКлиенте(ПараметрыКоманды)
	
	// Флажок, возле кнопки "Выполнить"
	Элементы.СОбнулением.Доступность 				= ПараметрыКоманды["Операция"]["Редактировать"];
	
	// Доступность колонок
	Элементы.тзРесурсыЦенаБазисная.ТолькоПросмотр	= НЕ ПараметрыКоманды["Операция"]["Редактировать"];
	Элементы.тзРесурсыЦенаЗМБазисная.ТолькоПросмотр	= НЕ ПараметрыКоманды["Операция"]["Редактировать"];
	Элементы.тзРесурсыЦенаТекущая.ТолькоПросмотр	= НЕ ПараметрыКоманды["Операция"]["Редактировать"];
	Элементы.тзРесурсыЦенаТекущаяЗМ.ТолькоПросмотр	= НЕ ПараметрыКоманды["Операция"]["Редактировать"];
	// Видимость колонки "пометка", т.к. при некоторых действиях работаем с выделенными строками, а не с отмеченными.
	Элементы.тзРесурсыПометка.Видимость 			= ПараметрыКоманды["Операция"]["Редактировать"];
	Элементы.ГруппаРесурсыФлажки.Видимость			= ПараметрыКоманды["Операция"]["Редактировать"];
	// Видимость колонки, для документа "Акт выполненных работ".
	Элементы.тзРесурсыРасходПоФакту.Видимость 		= ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот");
		
КонецПроцедуры //Процедура УстановитьВидимостьДоступностьЭлементовРесурсыНаКлиенте(Действие)

&НаКлиенте
Процедура УстановитьВидимостьДоступностьЭлементовПоправкиНаКлиенте(ПараметрыКоманды)
	
	//	флажок, возле кнопки "Выполнить"
	Элементы.СОбнулением.Доступность 					= ПараметрыКоманды["Операция"]["Редактировать"];
	
	//	доступность колонок
	Элементы.тзПоправкиДобавЗМ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиДобавОЗ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиДобавПЗ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиДобавСМ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиДобавТМ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиДобавТР.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиДобавЭМ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиКоэффЗМ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиКоэффОЗ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиКоэффПЗ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиКоэффСМ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиКоэффТМ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиКоэффТР.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиКоэффЭМ.ТолькоПросмотр 			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиПрименить.ТолькоПросмотр			= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиВариантРасчета.ТолькоПросмотр	= НЕ ПараметрыКоманды["Операция"]["Редактировать"] И НЕ ПараметрыКоманды["Операция"]["Добавить"];

	//	доступность кнопок "Добавить"
	Элементы.ГруппаПоправкиДобавить.Доступность			= ПараметрыКоманды["Операция"]["Добавить"];
	
	//	запрет изменения состава строк
	Элементы.тзПоправки.ИзменятьСоставСтрок				= ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправки.АвтоВводНовойСтроки				= ПараметрыКоманды["Операция"]["Добавить"];
	
	Элементы.тзПоправкиУсловияПрименения.ТолькоПросмотр	= НЕ ПараметрыКоманды["Операция"]["Добавить"];
	Элементы.тзПоправкиОбоснование.ТолькоПросмотр		= НЕ ПараметрыКоманды["Операция"]["Добавить"];
//	Элементы.тзПоправкиВариантРасчета.ТолькоПросмотр	= НЕ ПараметрыКоманды["Операция"]["Добавить"];

КонецПроцедуры //Процедура УстановитьВидимостьДоступностьЭлементовПоправкиНаКлиенте(ПараметрыКоманды)

