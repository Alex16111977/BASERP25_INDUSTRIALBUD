#Область Редактировать

&НаСервере
Функция КомандаИндексыРедактироватьНаСервере(ВернутьСтандартные = Ложь)
	
	//
	Результат						= Истина;
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))));
	
	НачатьТранзакцию();
	
	//
	Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
		
		//	Только, те позиции, которые принадлежат обрабатываемой локальной смете.
		ТаблицаЗначенийОбрабатываемыеРазделы	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка, ЛокальнаяСмета", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина, Строка["СсылкаНаОбъект"]));
		ТаблицаЗначенийОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка, ЛокальнаяСмета", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина, Строка["СсылкаНаОбъект"]));
		ОтборРазделов							= ТаблицаЗначенийОбрабатываемыеРазделы.ВыгрузитьКолонку("СсылкаНаОбъект");
		ОтборПозиций							= ТаблицаЗначенийОбрабатываемыеПозиции.ВыгрузитьКолонку("СсылкаНаОбъект");
		
		//	Только, те которые были зменены и отмечены.
		ТаблицаЗначенийИндексы					= ТабличнаяЧастьИндексы.Выгрузить(Новый Структура("Пометка, Модифицированность", Истина, Истина));
		
		//	Записываем в документы (позиции).
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			Результат = СМ_СметаВызовСервера.ОбновитьИндексыАкта(ТаблицаЗначенийИндексы, Документ, ОтборПозиций, СОбнулением); 
		Иначе
			Результат = СМ_СметаВызовСервера.ОбновитьИндексыСметы(ТаблицаЗначенийИндексы, Строка["СсылкаНаОбъект"], ОтборПозиций, СОбнулением); 
		КонецЕсли;
	
		//	Записываем в документы (разделы).
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			Результат = СМ_СметаВызовСервера.ОбновитьИндексыАкта(ТаблицаЗначенийИндексы, Документ, ОтборРазделов, СОбнулением); 
		Иначе
			Результат = СМ_СметаВызовСервера.ОбновитьИндексыСметы(ТаблицаЗначенийИндексы, Строка["СсылкаНаОбъект"], ОтборРазделов, СОбнулением); 
		КонецЕсли;
	
	КонецЦикла;

	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	//
	Возврат Истина;

КонецФункции

#КонецОбласти //#Область Редактировать/#Область ИНДЕКСЫ/#Область ВспомогательныеФункции/#Область КомандыФормы

#Область Очистить

&НаСервере
Функция КомандаИндексыОчиститьНаСервере(ВернутьСтандартные = Ложь)
	
	//
	ОбрабатываемыеЛокальныеСметы	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип", Строка(Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))));
	
	НачатьТранзакцию();
	
	//
	Для Каждого Строка Из ОбрабатываемыеЛокальныеСметы Цикл
		
		//	Только, те позиции, которые принадлежат обрабатываемой локальной смете.
		ТаблицаЗначенийОбрабатываемыеРазделы	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка, ЛокальнаяСмета", Строка(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы")), Истина, Строка["СсылкаНаОбъект"]));
		ТаблицаЗначенийОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип, УчастиеПометка, ЛокальнаяСмета", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина, Строка["СсылкаНаОбъект"]));
		ОтборРазделов							= ТаблицаЗначенийОбрабатываемыеРазделы.ВыгрузитьКолонку("СсылкаНаОбъект");
		ОтборПозиций							= ТаблицаЗначенийОбрабатываемыеПозиции.ВыгрузитьКолонку("СсылкаНаОбъект");
		
		//	Только, те которые были зменены и отмечены.
		ТаблицаЗначенийИндексы				= ТабличнаяЧастьИндексы.Выгрузить(Новый Структура("Пометка", Истина));
		ТаблицаЗначенийИндексы.ЗаполнитьЗначения(0, "КоэффОснЗарплаты, КоэффСтоимЭксплМашин, КоэффСтоимЗарплатеМашин, КоэффСтоимМатериалов, КоэффОборуд, КоэффПолнСтоимРабот");
		
		//	Записываем в документы (позиции).
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			Результат = СМ_СметаВызовСервера.ОбновитьИндексыАкта(ТаблицаЗначенийИндексы, Документ, ОтборПозиций, Истина, Истина); 
		Иначе
			Результат = СМ_СметаВызовСервера.ОбновитьИндексыСметы(ТаблицаЗначенийИндексы, Строка["СсылкаНаОбъект"], ОтборПозиций, Истина, Истина); 
		КонецЕсли;
	
		//	Записываем в документы (разделы).
		Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			Результат = СМ_СметаВызовСервера.ОбновитьИндексыАкта(ТаблицаЗначенийИндексы, Документ, ОтборРазделов, Истина, Истина); 
		Иначе
			Результат = СМ_СметаВызовСервера.ОбновитьИндексыСметы(ТаблицаЗначенийИндексы, Строка["СсылкаНаОбъект"], ОтборРазделов, Истина, Истина); 
		КонецЕсли;
	
	КонецЦикла;

	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	//
	Возврат Истина;
	
КонецФункции //Функция КомандаИндексыОчиститьНаСервере()

#КонецОбласти //#Область Очистить/#Область ИНДЕКСЫ/#Область ВспомогательныеФункции

