&НаСервере
Функция СоздатьТаблицуНаСервере(НаименованиеТаблицы = "", Колонки = Неопределено)
	
	//
	Реквизиты	= ПолучитьРеквизиты();
	
	//
	ДобавляемыеРеквизиты		= Новый Массив;
	УдаляемыеРеквизиты			= Новый Массив;
	ПолноеНаименованиеТаблицы	= ПолноеНаименованиеНаСервере("ВТ_", НаименованиеТаблицы);
	РеквизитТаблица				= Новый РеквизитФормы(ПолноеНаименованиеТаблицы, Новый ОписаниеТипов("ТаблицаЗначений"), "",  НаименованиеТаблицы, Ложь);
	
	//	Удалить реквизит формы, если уже создавали таблицу. Методов поиска и проверки, на уже созданный реквизит формы не нашел.
	Для Каждого РеквизитФормы Из Реквизиты Цикл
		Если РеквизитФормы.Имя = ПолноеНаименованиеТаблицы Тогда
			УдаляемыеРеквизиты.Добавить(ПолноеНаименованиеТаблицы);
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	//
	ДобавляемыеРеквизиты.Добавить(РеквизитТаблица);
	
	//	Создать реквизиты, для временной таблицы значений.
	Для Каждого Колонка Из Колонки Цикл
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, ПолноеНаименованиеТаблицы,  Колонка.Заголовок, Ложь));
	КонецЦикла;
	
	//
	ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
	
	//
	Возврат ПолноеНаименованиеТаблицы;

КонецФункции //Функция СоздатьТаблицуНаСервере(НаименованиеТаблицы = "", Колонки = Неопределено)

