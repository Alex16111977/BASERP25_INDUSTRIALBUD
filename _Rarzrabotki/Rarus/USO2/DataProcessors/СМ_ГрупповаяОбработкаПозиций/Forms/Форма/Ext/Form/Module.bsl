&НаСервереБезКонтекста
Функция ПолучитьТекстЗапросаСледующийИндексЛокальнаяСметаНаСервереБезКонтекста(Исключить = Истина)
	
	Возврат "ВЫБРАТЬ ПЕРВЫЕ 1
	        |	СМ_ЛокальнаяСмета.Ссылка,
	        |	СМ_ЛокальнаяСмета.Наименование
	        |ИЗ
	        |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	        |ГДЕ
	        |	СМ_ЛокальнаяСмета.ИДРодителя = &Родитель
	        |	И СМ_ЛокальнаяСмета.Наименование ПОДОБНО ""%"" + &ЧастьСтрокиВключить + ""%""
	        |	И НЕ СМ_ЛокальнаяСмета.Наименование ПОДОБНО ""%"" + &ЧастьСтрокиИсключить
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	СМ_ЛокальнаяСмета.Номер УБЫВ";
	
КонецФункции //Функция ПолучитьТекстЗапросаСледующийИндексЛокальнаяСметаНаСервереБезКонтекста()

&НаСервереБезКонтекста
Функция ПолучитьТекстЗапросаСледующийИндексРазделНаСервереБезКонтекста(Исключить = Истина)
	
	Возврат "ВЫБРАТЬ ПЕРВЫЕ 1
	        |	СМ_РазделЛокальнойСметы.Ссылка,
	        |	ВЫРАЗИТЬ(СМ_РазделЛокальнойСметы.НаименованиеДляПечати КАК СТРОКА(1024)) КАК Наименование
	        |ИЗ
	        |	Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	        |ГДЕ
	        |	СМ_РазделЛокальнойСметы.ИДСметы = &ЛокальнаяСмета
	        |	И СМ_РазделЛокальнойСметы.ИДРодителя = &Родитель
	        |	И СМ_РазделЛокальнойСметы.НаименованиеДляПечати ПОДОБНО ""%"" + &ЧастьСтрокиВключить + ""%""
	        |	И НЕ СМ_РазделЛокальнойСметы.НаименованиеДляПечати ПОДОБНО ""%"" + &ЧастьСтрокиИсключить
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	СМ_РазделЛокальнойСметы.Номер УБЫВ";
	
КонецФункции //Функция ПолучитьТекстЗапросаСледующийИндексРазделНаСервереБезКонтекста()

&НаСервереБезКонтекста
Функция ПолучитьТекстЗапросаСледующийИндексПозицияНаСервереБезКонтекста(Исключить = Истина)
	
	Возврат "ВЫБРАТЬ ПЕРВЫЕ 1
	        |	СМ_ПозицияЛокальнойСметы.Ссылка,
	        |	ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметы.Наименование КАК СТРОКА(1024)) КАК Наименование
	        |ИЗ
	        |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	        |ГДЕ
	        |	СМ_ПозицияЛокальнойСметы.ИДСметы = &ЛокальнаяСмета
	        |	И СМ_ПозицияЛокальнойСметы.ИДРодителя = &Родитель
	        |	И СМ_ПозицияЛокальнойСметы.Наименование ПОДОБНО ""%"" + &ЧастьСтрокиВключить + ""%""
	        |	" + ?(Исключить, "И НЕ СМ_ПозицияЛокальнойСметы.Наименование ПОДОБНО ""%"" + &ЧастьСтрокиИсключить", "") + "
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	Наименование УБЫВ";
	
КонецФункции //Функция ПолучитьТекстЗапросаСледующийИндексПозицияНаСервереБезКонтекста()

&НаСервереБезКонтекста
Функция СледующийИндексНаСервереБезКонтекста(Значение, БезЧисла = "")
	
	//
	ЧислоНайдено	= Ложь;
	Текст			= Значение;
	ЧислоТекст		= "";
	Цифра			= Прав(Текст, 1);
	
	Пока НЕ ЧислоНайдено Цикл
		
		//
		Попытка
			Число			= Число(Цифра);
			ЧислоТекст		= Цифра + ЧислоТекст;
			Текст			= Лев(Текст, СтрДлина(Текст)-1);
			Цифра			= Прав(Текст, 1);
		Исключение
			ЧислоНайдено	= Истина;
		КонецПопытки;
		
	КонецЦикла;
	
	//
	БезЧисла	= Сред(Значение, 1, СтрДлина(Значение) - СтрДлина(ЧислоТекст));
	
	//
	Если ЗначениеЗаполнено(ЧислоТекст) Тогда
		Число	= Число(ЧислоТекст) + 1;
	Иначе
		Число	= 1;
	КонецЕсли;
	
	//
	Возврат Число;
	
КонецФункции //Функция СледующийИндексНаСервереБезКонтекста(Значение, БезЧисла = "")

