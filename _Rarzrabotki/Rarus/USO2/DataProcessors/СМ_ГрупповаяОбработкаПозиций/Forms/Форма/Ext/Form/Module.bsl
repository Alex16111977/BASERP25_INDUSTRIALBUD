#Область УстановитьНормативыНРиСП

// Срабатывает после выбора нормативов НР и СП, запускаем запись выбранного в документы.
//
&НаКлиенте
Процедура КомандаУстановитьНормативыНРиСПОповещениеНаКлиенте(Результат, ПараметрыОповещения) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;                                 
	КонецЕсли;
	
	//
	Если КомандаУстановитьНормативыНРиСПНаСервере(Результат) Тогда
	
		//	снять пометки с элементов
		УстановитьСнятьПометкаРебенокНаКлиенте(ЭлементыДеревоЗначений.ПолучитьЭлементы(), Ложь);
		
		//	сообщить пользователю
		СообщитьПользователюУспешноеВыполнениеКомандыНаСервере(ПараметрыОповещения.КомандаИмя);
		
	КонецЕсли;
	
КонецПроцедуры //Процедура КомандаУстановитьНормативыНРиСПОповещениеНаКлиенте()

// Непосредственно замена нормативов НР и СП в позициях.
//
&НаСервере
Функция КомандаУстановитьНормативыНРиСПНаСервере(Результат)
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//
	НачатьТранзакцию();
	
	//	цикл
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		Если Строка.СтатусРедактирования = 1 Тогда
			Продолжить;
		КонецЕсли;
		ОбъектПозиции = Строка["СсылкаНаОбъект"].ПолучитьОбъект();  
		Если Результат.Вид = "Текущие" Тогда
			ОбъектПозиции.НакладныеРасходыТекущие	= Результат.НР;
			ОбъектПозиции.СметнаяПрибыльТекущие		= Результат.СП;
		Иначе
			ОбъектПозиции.НакладныеРасходыБазисные	= Результат.НР;
			ОбъектПозиции.СметнаяПрибыльБазисные	= Результат.СП;
		КонецЕсли;
		ОбъектПозиции.Записать();
		
	КонецЦикла;	
	
	//	Перерасчет документов.
	ДокументПерерасчетНаСервере(Документ);
	
	ЗафиксироватьТранзакцию();
	
	//
	Возврат Истина;
	
КонецФункции //Функция КомандаУстановитьНормативыНРиСПНаСервере(ОбъектыДляОперации, Результат)	


&НаКлиенте
Процедура ОтобратьОбрабатываемыеЭлементыНаКлиенте(Команда)
	
	ПараметрыКоманды = ПолучитьПараметрыКомандыНаКлиенте(Команда);
	
	Если ПараметрыКоманды["Операция"]["НРиСП"] Тогда
		СписокВыбора = ПолучитьСписокВыбораНРиСПНаСервере();
	Иначе
		СписокВыбора = Новый СписокЗначений;	
	КонецЕсли;
	
	ПараметрыОповещения	= Новый Структура();
	ПараметрыОповещения.Вставить("ПараметрыКоманды", ПараметрыКоманды);
		
	ПараметрыОткрытия	= Новый Структура();
	ПараметрыОткрытия.Вставить("СписокВыбора", СписокВыбора);
	
	Если СписокВыбора.Количество() <= 1 Тогда
	 	МассивВыбора = Новый Массив;
		Для Каждого ТекЭлемент Из СписокВыбора Цикл
			МассивВыбора.Добавить(ТекЭлемент.Значение);	
		КонецЦикла;
		ОтобраныОбрабатываемыеЭлементыНаКлиенте(МассивВыбора, ПараметрыОповещения);
	Иначе
		ОписаниеОповещения	= Новый ОписаниеОповещения("ОтобраныОбрабатываемыеЭлементыНаКлиенте", ЭтотОбъект, ПараметрыОповещения);
		ОткрытьФорму("ОбщаяФорма.СМ_ВыборИзСписка", ПараметрыОткрытия, ЭтотОбъект,,,,ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры //Процедура ОтобратьОбрабатываемыеЭлементыНаКлиенте(ПараметрыКоманды)

&НаСервере
Функция ПолучитьСписокВыбораНРиСПНаСервере()
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	СписокВыбора			= Новый СписокЗначений;
		
	//
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		
		// ********************************************
		// ++ AVV Обработка позиций ЛС с пустым видом работ

		//	Исключить повторы.
		Если НЕ СписокВыбора.НайтиПоЗначению(Строка["СсылкаНаОбъект"].ВидРабот) = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		
		//	Исключить не заполненные значения.
		Если НЕ ЗначениеЗаполнено(Строка["СсылкаНаОбъект"].ВидРабот) Тогда
			СписокВыбора.Добавить("", "Не заполнены");
		Иначе
			СписокВыбора.Добавить(Строка["СсылкаНаОбъект"].ВидРабот, Строка(Строка["СсылкаНаОбъект"].ВидРабот));
		КонецЕсли;
		// -- AVV
	    // ********************************************
		
	КонецЦикла;
	
	//
	Возврат СписокВыбора;
		
КонецФункции //Функция ПолучитьСписокВыбораНРиСПНаСервере()

&НаКлиенте
Процедура ОтобраныОбрабатываемыеЭлементыНаКлиенте(МассивВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если МассивВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры["ПараметрыКоманды"]["Операция"]["НРиСП"] Тогда
		ОтобратьОбрабатываемыеПозицииНРИСПНаСервере(МассивВыбора, ДополнительныеПараметры["ПараметрыКоманды"]);
	Иначе
	КонецЕсли;
	
	// Выполнить процедуру команды и вернуть выполнена/не выполнена.
	ВыполнитьКоманду = ВыполнитьКомандуНаКлиенте(ДополнительныеПараметры["ПараметрыКоманды"]["Действие"]);
	Если ВыполнитьКоманду Тогда
		// сообщить пользователю
		СообщитьПользователюУспешноеВыполнениеКомандыНаСервере(ДополнительныеПараметры["ПараметрыКоманды"]["Команда"]);
	КонецЕсли;
	
КонецПроцедуры //Процедура ОтобраныОбрабатываемыеЭлементыНаКлиенте(ПараметрыКоманды)

&НаКлиенте
Функция ВыполнитьКомандуНаКлиенте(ДействиеКоманды)
	
	Если ДействиеКоманды = "УстановитьНормативыНРиСП" Тогда
		Возврат ОбновитьНРиСПНаСервере();
	Иначе
		Возврат Ложь;	
	КонецЕсли;
	
КонецФункции //Функция ВыполнитьКомандуНаКлиенте(ДействиеКоманды)

&НаСервере
Процедура ОтобратьОбрабатываемыеПозицииНРИСПНаСервере(МассивВыбора, ПараметрыКоманды)
	
	//
	ОбрабатываемыеПозиции	= ОбрабатываемыеЭлементы.НайтиСтроки(Новый Структура("Тип, УчастиеПометка", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")), Истина));
	
	//
	Для Каждого Строка Из ОбрабатываемыеПозиции Цикл
		Если МассивВыбора.Найти(Строка["СсылкаНаОбъект"].ВидРабот) = Неопределено Тогда
			ОбрабатываемыеЭлементы.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры //Процедура ОтобратьОбрабатываемыеПозицииНРИСПНаСервере(МассивВыбора, ПараметрыКоманды)

#КонецОбласти //#Область УстановитьНормативыНРиСП

