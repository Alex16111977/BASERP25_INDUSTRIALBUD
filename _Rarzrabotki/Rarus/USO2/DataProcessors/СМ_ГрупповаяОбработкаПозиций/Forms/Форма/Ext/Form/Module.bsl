&НаКлиенте
Процедура РЕСУРСЫ_ЛС_ЗаменитьПлюсМинусИзВБ(Команда, ВыполнитьКоманду = Ложь, Идентификаторы = Неопределено)
	
	//	устанавливаем и проверяем возможность установки, "действие" - реквизит на форме
	Если НЕ ВыполнитьКоманду Тогда
		ДоступнаСменаКомандыВопросНаКлиенте(Команда);
		Возврат;
	КонецЕсли;
	
	//
	ПараметрыРасчета	= Новый Структура();
	
	//	Общая проверка.
	Если НЕ СМ_ДоступнаОбработкаЛокальнаяСметаНаКлиенте(Команда, Идентификаторы, ПараметрыРасчета) Тогда
		Возврат;
	КонецЕсли;
	
	//
	ИдФормы
		= СметнаяКомпонента.ПоказатьОкноТекущихЦен(	СокрЛП(ПараметрыРасчета.ФайлСборникаТекущихЦен),
													Строка(СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(ПараметрыРасчета.Район, "Код")),
													,
													,
													Истина,
													Ложь);	
	
КонецПроцедуры //Процедура РЕСУРСЫ_ЛС_ЗаменитьПлюсМинусИзВБ(Команда)

