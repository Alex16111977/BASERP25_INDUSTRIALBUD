&НаСервере
Функция ПроверитьУсловияОтбора(СсылкаНаОбъект, ПараметрыОтбора, Шифр, СтатусРедактирования = 0)
	
	//	"По умолчанию" - проходит отбор
	ОтборОпределитель				= Истина;
	ОтборВидРасценки				= Истина;
	ОтборТипНормативныхСборников	= Истина;
	ОтборНомерСборника				= Истина;
	ОтборОбработкаДемонтажа			= Истина;
	
	//	Определитель
	Если ПараметрыОтбора.Свойство("Определитель") Тогда
		ОтборОпределитель
			= СравнитьЗначениеНаСервере(СсылкаНаОбъект.Определитель, ПараметрыОтбора["Определитель"]["ВидСравнения"], ПараметрыОтбора["Определитель"]["Значение"]);
	КонецЕсли;
		
	//	Вид расценки
	Если ПараметрыОтбора.Свойство("ВидРасценки") Тогда
		ОтборВидРасценки
			= СравнитьЗначениеНаСервере(СсылкаНаОбъект.Определитель.ВидРасценки, ПараметрыОтбора["ВидРасценки"]["ВидСравнения"], ПараметрыОтбора["ВидРасценки"]["Значение"]);
	КонецЕсли;

	//	Тип нормативного сборника
	Если ПараметрыОтбора.Свойство("ТипНормативныхСборников") Тогда
		ОтборТипНормативныхСборников
			= СравнитьЗначениеНаСервере(СсылкаНаОбъект.ТипНормативныхСборников, ПараметрыОтбора["ТипНормативныхСборников"]["ВидСравнения"], ПараметрыОтбора["ТипНормативныхСборников"]["Значение"]);
	КонецЕсли;
	
	//	Номер сборника
	Если ПараметрыОтбора.Свойство("НомерСборника") Тогда
		НомерСборникаРасценки	= СМ_СметаВызовСервера.ОпределитьНомерСборника(СсылкаНаОбъект.ТипНормативныхСборников, Шифр);
		ОтборНомерСборника
			= СравнитьЗначениеНаСервере(НомерСборникаРасценки, ПараметрыОтбора["НомерСборника"]["ВидСравнения"], ПараметрыОтбора["НомерСборника"]["Значение"]);
	КонецЕсли;
	
	//	Демонтаж
	Если ПараметрыОтбора.Свойство("ОбработкаДемонтажа") Тогда
		ОтборОбработкаДемонтажа
			= СравнитьЗначениеНаСервере(СсылкаНаОбъект.Демонтаж, ПараметрыОтбора["ОбработкаДемонтажа"]["ВидСравнения"], ПараметрыОтбора["ОбработкаДемонтажа"]["Значение"]);
	КонецЕсли;
	
	// СтатусРедактирования
	Если ПараметрыОтбора.Свойство("СтатусРедактирования") Тогда
		ОтборОбработкаДемонтажа
		= СравнитьЗначениеНаСервере(СтатусРедактирования, ПараметрыОтбора["СтатусРедактирования"]["ВидСравнения"], ПараметрыОтбора["СтатусРедактирования"]["Значение"]);
	КонецЕсли;

	Возврат ОтборОпределитель
			И ОтборВидРасценки
			И ОтборТипНормативныхСборников
			И ОтборНомерСборника
			И ОтборОбработкаДемонтажа;	

КонецФункции //Функция ПроверитьУсловияОтбора(СтруктураПараметров, ТекЭлемент, ТекШифр)

&НаСервере
Функция СравнитьЗначениеНаСервере(ЗначениеЛевое, ВидСравнения, ЗначениеПравое)
	
	//
	Если ВРег(ВидСравнения) = ВРег("Равно") Тогда
		Возврат ЗначениеЛевое = ЗначениеПравое;	
	ИначеЕсли ВРег(ВидСравнения) = ВРег("НеРавно") Тогда
		Возврат НЕ ЗначениеЛевое = ЗначениеПравое;	
	ИначеЕсли ВРег(ВидСравнения) = ВРег("Заполнено") Тогда
		Возврат ЗначениеЗаполнено(ЗначениеЛевое);	
	ИначеЕсли ВРег(ВидСравнения) = ВРег("НеЗаполнено") Тогда
		Возврат НЕ ЗначениеЗаполнено(ЗначениеЛевое);	
	Иначе
		Возврат Ложь;	
	КонецЕсли;
		
КонецФункции //Функция СравнитьЗначениеНаСервере(ЗначениеЛевое, ВидСравнения, ЗначениеПравое)

#КонецОбласти //#Область ВспомогательныеФункции/#Область ДеревоЗначений

#КонецОбласти //#Область ЭлементыДеревоЗначений

//	Заполнение табличных частей.
#Область ТаблицыЗначений

#Область СоздатьЗаполнить

&НаСервере
Процедура СоздатьЗаполнитьТаблицыЗначенийНаСервере(ВыбранноеЗначение)
	
	//	РЕСУРСЫ
	СоздатьЗаполнитьТаблицаЗначенийРесурсыНаСервере(ВыбранноеЗначение);
	
	//	ПОПРАВКИ
	СоздатьЗаполнитьТаблицаЗначенийПоправкиНаСервере(ВыбранноеЗначение);
	
	//	НАЧИСЛЕНИЯ
	СоздатьЗаполнитьТаблицаЗначенийНачисленияНаСервере(ВыбранноеЗначение);
	
	//	ИНДЕКСЫ
	СоздатьЗаполнитьТаблицаЗначенийИндексыНаСервере(ВыбранноеЗначение);
	
	//	СВОЙСТВА
	СоздатьЗаполнитьТаблицаЗначенийСвойстваНаСервере(ВыбранноеЗначение);
	
КонецПроцедуры //Процедура СоздатьЗаполнитьТаблицыЗначенийНаСервере(ВыбранноеЗначение)

&НаСервере
Процедура СоздатьЗаполнитьТаблицаЗначенийРесурсыНаСервере(ВыбранноеЗначение, НаименованиеТаблицы = "Ресурсы")
	
	//
	ТаблицаЗначений		= ОбрабатываемыеЭлементы.Выгрузить(Новый Структура("Тип", Строка(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"))));
	СписокПозиций		= Новый СписокЗначений;
	СписокПозиций.ЗагрузитьЗначения(ТаблицаЗначений.ВыгрузитьКолонку("СсылкаНаОбъект"));
	
	//	Получить общую табличную часть.	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Таблица 	= СМ_СметаРасчетСервер.ПолучитьТаблицуСтоимостиРесурсовАкта(ВыбранноеЗначение, Ложь, СписокПозиций,, Истина, Истина);
	Иначе
		Таблица 	= СМ_СметаРасчетСервер.ПолучитьТаблицуСтоимостиРесурсовСметы(СписокПозиций, Ложь, Ложь, Истина,, Истина);
	КонецЕсли;
	
	//	Создать реквизиты формы.
	ПолноеНаименованиеТаблицы	= СоздатьТаблицуНаСервере(НаименованиеТаблицы, Таблица.Колонки);
	
	//	Заполнить временную таблицу значений.
	ЭтаФорма[ПолноеНаименованиеТаблицы].Загрузить(Таблица);
	
КонецПроцедуры //Процедура СоздатьЗаполнитьТаблицаЗначенийРесурсыНаСервере(ВыбранноеЗначение, НаименованиеТаблицы = "Ресурсы")

