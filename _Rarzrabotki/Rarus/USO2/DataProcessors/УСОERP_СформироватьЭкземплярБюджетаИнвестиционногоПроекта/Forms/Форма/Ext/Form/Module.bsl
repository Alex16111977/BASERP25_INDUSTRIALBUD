
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТипБюджета = "БДДС";
	Элементы.ИсходныеДанныеПорядокОплаты.Видимость=Истина;
	Элементы.ИсходныеДанныеПорядокДоходовРасходов.Видимость=Ложь;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ТипБюджетаПриИзменении(Элемент)
	
	Если ТипБюджета="БДДС" тогда
		Элементы.ИсходныеДанныеПорядокОплаты.Видимость=Истина;
		Элементы.ИсходныеДанныеПорядокДоходовРасходов.Видимость=Ложь;
	ИначеЕсли ТипБюджета="БДР" тогда
		Элементы.ИсходныеДанныеПорядокОплаты.Видимость=Ложь;
		Элементы.ИсходныеДанныеПорядокДоходовРасходов.Видимость=Истина;
	Иначе
		Элементы.ИсходныеДанныеПорядокОплаты.Видимость=Ложь;
		Элементы.ИсходныеДанныеПорядокДоходовРасходов.Видимость=Ложь;
	КонецЕсли;
	
	Объект.ИсходныеДанные.Очистить();
	Объект.ВидБюджета = ПредопределенноеЗначение("Справочник.ВидыБюджетов.ПустаяСсылка");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИнтервал(Команда)
	
	ОбщегоНазначенияУТКлиент.РедактироватьПериод(
		Объект, 
		Новый Структура("ДатаНачала, ДатаОкончания", "НачалоПериода", "ОкончаниеПериода"));
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеТабличнойЧасти

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ПроверитьЗаполнение() тогда	
		Возврат;
	КонецЕсли;
	
	Если Объект.НачалоПериода>Объект.ОкончаниеПериода тогда 
		сообщить("Неправильно задан период: начало периода должно быть меньше или равно окончанию");
	КонецЕсли;	
	
	Если ТипБюджета="БДДС" тогда
		ПолучитьДанныеДвиженияДС()
	ИначеЕсли ТипБюджета="БДР" тогда
		ПолучитьДанныеДоходовРасходов()
	Иначе
		Сообщить("Не выбран тип бюджета");
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеДвиженияДС()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент КАК Контрагент,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Договор КАК Договор,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ВидРабот КАК ВидРабот,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Работа,
		|	СУММА(УСОERP_ГрафикДвиженийПоДоговоруОбороты.ФинансированиеПланПриход) КАК Сумма,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Период КАК Период,
		|	ВЫБОР
		|		КОГДА УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.АвансДоОбеспечения)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.АвансДоПодтверждения)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.ПредоплатаДоПоступления)
		|			ТОГДА УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБДДСАвансовогоПлатежа
		|		КОГДА УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.КредитПослеОтгрузки)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.КредитПослеПоступления)
		|			ТОГДА УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБДДСОсновногоПлатежа
		|		КОГДА УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание)
		|			ТОГДА УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБДДСГарантийногоУдержания
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)
		|	КОНЕЦ КАК СтатьяБюджетов
		|ПОМЕСТИТЬ ПредварительныеДанные
		|ИЗ
		|	РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , ) КАК УСОERP_ГрафикДвиженийПоДоговоруОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СоответствиеОбъектовСтроительстваПроектам КАК УСОERP_СоответствиеОбъектовСтроительстваПроектам
		|		ПО УСОERP_ГрафикДвиженийПоДоговоруОбороты.ОбъектСтроительства = УСОERP_СоответствиеОбъектовСтроительстваПроектам.ОбъектСтроительства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ДополнительныеПараметрыПоДоговору.СрезПоследних(&КонецПериода, ) КАК УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних
		|		ПО УСОERP_ГрафикДвиженийПоДоговоруОбороты.Договор = УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Договор
		|			И УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент = УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Контрагент
		|			И УСОERP_ГрафикДвиженийПоДоговоруОбороты.ОбъектСтроительства = УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.ОбъектСтроительства
		|ГДЕ
		|	УСОERP_СоответствиеОбъектовСтроительстваПроектам.Проект = &Проект
		|	И УСОERP_ГрафикДвиженийПоДоговоруОбороты.Организация = &Организация
		|	И УСОERP_ГрафикДвиженийПоДоговоруОбороты.ФинансированиеПланПриход <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Договор,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ВидРабот,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Работа,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Период,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты,
		|	ВЫБОР
		|		КОГДА УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.АвансДоОбеспечения)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.АвансДоПодтверждения)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.ПредоплатаДоПоступления)
		|			ТОГДА УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБДДСАвансовогоПлатежа
		|		КОГДА УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.КредитПослеОтгрузки)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.КредитПослеПоступления)
		|			ТОГДА УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБДДСОсновногоПлатежа
		|		КОГДА УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание)
		|				ИЛИ УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание)
		|			ТОГДА УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБДДСГарантийногоУдержания
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПредварительныеДанные.Контрагент КАК Контрагент,
		|	ПредварительныеДанные.Договор КАК Договор,
		|	ПредварительныеДанные.ВидРабот КАК ВидРабот,
		|	ПредварительныеДанные.Работа,
		|	ПредварительныеДанные.Сумма,
		|	ПредварительныеДанные.ПорядокОплаты,
		|	ПредварительныеДанные.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ПредварительныеДанные.СтатьяБюджетов.ПометкаУдаления
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)
		|		ИНАЧЕ ПредварительныеДанные.СтатьяБюджетов
		|	КОНЕЦ КАК СтатьяБюджетов
		|ИЗ
		|	ПредварительныеДанные КАК ПредварительныеДанные
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	Контрагент,
		|	Договор,
		|	ВидРабот";
		
	Запрос.УстановитьПараметр("Проект",Объект.Проект);	
	Запрос.УстановитьПараметр("Организация",Объект.Организация);	
	Запрос.УстановитьПараметр("НачалоПериода",Объект.НачалоПериода);	
	Запрос.УстановитьПараметр("КонецПериода",Объект.ОкончаниеПериода);	
	
	ДанныеПлатежейИПоступлений = Запрос.Выполнить().Выгрузить();
	
	Объект.ИсходныеДанные.Загрузить(ДанныеПлатежейИПоступлений);
	
КонецПроцедуры // ПолучитьДанныеплатежейИПоступлений()

&НаСервере
Процедура ПолучитьДанныеДоходовРасходов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент КАК Контрагент,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Договор КАК Договор,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ВидРабот КАК ВидРабот,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Работа,
		|	СУММА(УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокДоходовРасходовПланПриход) КАК Сумма,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокДоходовРасходов,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Период КАК Период,
		|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБюджетаБДР КАК СтатьяБюджетов
		|ПОМЕСТИТЬ ПредварительныеДанные
		|ИЗ
		|	РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , ) КАК УСОERP_ГрафикДвиженийПоДоговоруОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_СоответствиеОбъектовСтроительстваПроектам КАК УСОERP_СоответствиеОбъектовСтроительстваПроектам
		|		ПО УСОERP_ГрафикДвиженийПоДоговоруОбороты.ОбъектСтроительства = УСОERP_СоответствиеОбъектовСтроительстваПроектам.ОбъектСтроительства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УСОERP_ДополнительныеПараметрыПоДоговору.СрезПоследних(&КонецПериода, ) КАК УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних
		|		ПО УСОERP_ГрафикДвиженийПоДоговоруОбороты.Договор = УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Договор
		|			И УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент = УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Контрагент
		|			И УСОERP_ГрафикДвиженийПоДоговоруОбороты.ОбъектСтроительства = УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.ОбъектСтроительства
		|ГДЕ
		|	УСОERP_СоответствиеОбъектовСтроительстваПроектам.Проект = &Проект
		|	И УСОERP_ГрафикДвиженийПоДоговоруОбороты.Организация = &Организация
		|	И УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокДоходовРасходовПланПриход <> 0
		|
		|СГРУППИРОВАТЬ ПО
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Контрагент,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Договор,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ВидРабот,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Работа,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.Период,
		|	УСОERP_ГрафикДвиженийПоДоговоруОбороты.ПорядокДоходовРасходов,
		|	УСОERP_ДополнительныеПараметрыПоДоговоруСрезПоследних.Регистратор.СтатьяБюджетаБДР
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПредварительныеДанные.Контрагент КАК Контрагент,
		|	ПредварительныеДанные.Договор КАК Договор,
		|	ПредварительныеДанные.ВидРабот КАК ВидРабот,
		|	ПредварительныеДанные.Работа,
		|	ПредварительныеДанные.Сумма,
		|	ПредварительныеДанные.ПорядокДоходовРасходов,
		|	ПредварительныеДанные.Период КАК Период,
		|	ВЫБОР
		|		КОГДА ПредварительныеДанные.СтатьяБюджетов.ПометкаУдаления
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СтатьиБюджетов.ПустаяСсылка)
		|		ИНАЧЕ ПредварительныеДанные.СтатьяБюджетов
		|	КОНЕЦ КАК СтатьяБюджетов
		|ИЗ
		|	ПредварительныеДанные КАК ПредварительныеДанные
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период,
		|	Контрагент,
		|	Договор,
		|	ВидРабот";
		
	Запрос.УстановитьПараметр("Проект",Объект.Проект);	
	Запрос.УстановитьПараметр("Организация",Объект.Организация);	
	Запрос.УстановитьПараметр("НачалоПериода",Объект.НачалоПериода);	
	Запрос.УстановитьПараметр("КонецПериода",Объект.ОкончаниеПериода);	
	
	ДанныеПлатежейИПоступлений = Запрос.Выполнить().Выгрузить();
	
	Объект.ИсходныеДанные.Загрузить(ДанныеПлатежейИПоступлений);
	
КонецПроцедуры // ПолучитьДанныеплатежейИПоступлений()

#КонецОбласти

#Область ФормированиеЭкземпляраБюджета

&НаКлиенте
Процедура СформироватьЭкземплярБюджета(Команда)
		
	Если Не ПроверитьЗаполнение() тогда	
		Возврат;
	КонецЕсли;	
	
	Если Объект.НачалоПериода>Объект.ОкончаниеПериода тогда 
		сообщить("Неправильно задан период: начало периода должно быть меньше или равно окончанию");
	КонецЕсли;	
	
	Если Объект.ИсходныеДанные.Количество() = 0 тогда
		Сообщить("Не заполнена таблица данных для формирования экземпляра бюджета");
		Возврат;
	Иначе
		Для каждого строка из объект.ИсходныеДанные цикл
			Если НЕ ЗначениеЗаполнено(Строка.СтатьяБюджетов) тогда
				Сообщить("В строке №"+Строка.НомерСтроки+" не указана статья бюджета");
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;	
	
	ФормаНовогоДокумента = ПолучитьФорму("Документ.ЭкземплярБюджета.Форма.ФормаДокумента"); 
	ДанныеФормы = ФормаНовогоДокумента.Объект; 
	
	ЗаполнитьШапкуДокументаЭкземплярБюджетаСервер(ДанныеФормы);
	КопироватьДанныеФормы(ДанныеФормы, ФормаНовогоДокумента.Объект);
	
	ФормаНовогоДокумента.ПриИзмененииВидаБюджетаСервер();
	ФормаНовогоДокумента.ПриИзмененииСценарияСервер();
	ФормаНовогоДокумента.ПриИзмененииПериодаСервер();
	ФормаНовогоДокумента.ОрганизацияПриИзмененииНаСервере();
	ФормаНовогоДокумента.СформироватьОтчетСервер(Истина);

	ЗаполнитьТабличнуюЧастьЭкземплярБюджетаСервер(ДанныеФормы);
	КопироватьДанныеФормы(ДанныеФормы, ФормаНовогоДокумента.Объект);
	
	ФормаНовогоДокумента.СформироватьОтчетСервер(Истина,Истина);
	ФормаНовогоДокумента.Открыть();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьШапкуДокументаЭкземплярБюджетаСервер(ДанныеФормы)
	
	ДокЭкзеплярБюджета = ДанныеФормыВЗначение(ДанныеФормы, Тип("ДокументОбъект.ЭкземплярБюджета")); 
	
	ДокЭкзеплярБюджета.Статус 					= Перечисления.СтатусыПланов.ВПодготовке;
	ДокЭкзеплярБюджета.МодельБюджетирования		= Объект.ВидБюджета.Владелец;
	ДокЭкзеплярБюджета.Дата 					= ТекущаяДата();
	ДокЭкзеплярБюджета.Ответственный			= ПараметрыСеанса.ТекущийПользователь;
	ДокЭкзеплярБюджета.Организация 				= Объект.Организация;
	ДокЭкзеплярБюджета.Сценарий 				= Объект.Сценарий;	
	ДокЭкзеплярБюджета.ВидБюджета 				= Объект.ВидБюджета;
	ДокЭкзеплярБюджета.НачалоПериода			= Объект.НачалоПериода;
	ДокЭкзеплярБюджета.ОкончаниеПериода			= Объект.ОкончаниеПериода;
	ДокЭкзеплярБюджета.Организация 				= Объект.Организация;
	
	ЗначениеВДанныеФормы(ДокЭкзеплярБюджета, ДанныеФормы);	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьАналитикуШапки(ВидАналитики,СтрокаИсточник)
	
	Если НЕ ЗначениеЗаполнено(ВидАналитики) тогда
		Возврат ПланыВидовХарактеристик.АналитикиСтатейБюджетов.ПустаяСсылка();	
	ИначеЕсли ВидАналитики = ПланыВидовХарактеристик.АналитикиСтатейБюджетов.Проекты тогда
		Возврат СтрокаИсточник.Проект;
	Иначе
		Возврат Новый(ВидАналитики.ТипЗначения.Типы()[0]);
	КонецЕсли;
		
КонецФункции

&НаСервере
Функция ПолучитьАналитикуТабличнойЧасти(ВидАналитики,СтрокаИсточник)
	
	Если НЕ ЗначениеЗаполнено(ВидАналитики) тогда
		Возврат ПланыВидовХарактеристик.АналитикиСтатейБюджетов.ПустаяСсылка();	
	ИначеЕсли ВидАналитики.ТипЗначения.СодержитТип(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")) тогда
		Если НЕ ЗначениеЗаполнено(СтрокаИсточник.Работа) И ВидАналитики.ТипЗначения.СодержитТип(Тип("СправочникСсылка.УСОERP_ВидыРабот")) Тогда
			Возврат СтрокаИсточник.ВидРабот;
		Иначе	 
			Возврат СтрокаИсточник.Работа;
		КонецЕсли;
	ИначеЕсли ВидАналитики.ТипЗначения.СодержитТип(Тип("СправочникСсылка.УСОERP_ВидыРабот")) тогда		
		Возврат СтрокаИсточник.ВидРабот;
	ИначеЕсли ВидАналитики = ПланыВидовХарактеристик.АналитикиСтатейБюджетов.Контрагенты тогда
		Возврат СтрокаИсточник.Контрагент;
	ИначеЕсли ВидАналитики = ПланыВидовХарактеристик.АналитикиСтатейБюджетов.Договоры тогда
		Возврат СтрокаИсточник.Договор;	
	Иначе
		Возврат Новый(ВидАналитики.ТипЗначения.Типы()[0]);
	КонецЕсли;
		
КонецФункции

&НаСервере
Процедура ДополнитьСтруктуруПоискаСтатьи(Аналитика,ВидАналитики,СтруктураПоиска,СворачиваемыеАналитики)
		
	Если НЕ ЗначениеЗаполнено(ВидАналитики) тогда
		//Возврат ПланыВидовХарактеристик.АналитикиСтатейБюджетов.ПустаяСсылка();	
	ИначеЕсли ВидАналитики.ТипЗначения.СодержитТип(Тип("СправочникСсылка.УСОERP_ВидыРабот")) тогда
		Если ТипЗнч(Аналитика) = Тип("СправочникСсылка.УСОERP_ВидыРабот") Тогда
			СтруктураПоиска.Вставить("ВидРабот",Аналитика);
			СворачиваемыеАналитики = СворачиваемыеАналитики+",ВидРабот";
		ИначеЕсли ВидАналитики.ТипЗначения.СодержитТип(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")) 
			И ТипЗнч(Аналитика) = Тип("СправочникСсылка.УСОERP_СтроительныеРаботы") Тогда
			СтруктураПоиска.Вставить("Работа",Аналитика);
			СворачиваемыеАналитики = СворачиваемыеАналитики+",Работа";
		КонецЕсли;
	ИначеЕсли ВидАналитики.ТипЗначения.СодержитТип(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")) тогда
		СтруктураПоиска.Вставить("Работа",Аналитика);
		СворачиваемыеАналитики = СворачиваемыеАналитики+",Работа";	
	ИначеЕсли ВидАналитики = ПланыВидовХарактеристик.АналитикиСтатейБюджетов.Контрагенты тогда
		СтруктураПоиска.Вставить("Контрагент",Аналитика);	
		СворачиваемыеАналитики = СворачиваемыеАналитики+",Контрагент";		
	ИначеЕсли ВидАналитики = ПланыВидовХарактеристик.АналитикиСтатейБюджетов.Договоры тогда
		СтруктураПоиска.Вставить("Договор",Аналитика);
		СворачиваемыеАналитики = СворачиваемыеАналитики+",Договор";		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьИсходныеДанныеПоПериодуВидаБюджета()
	
	ТаблицаСтатей = Объект.ИсходныеДанные.Выгрузить();
	
	Для каждого Строка из ТаблицаСтатей цикл
		Если НЕ ЗначениеЗаполнено(Строка.СтатьяБюджетов) тогда
			ТаблицаСтатей.Удалить(строка);
		КонецЕсли;
		
		//Строка.Период = БюджетированиеКлиентСервер.ДатаНачалаПериода(Строка.Период, Объект.ВидБюджета.Периодичность);
        Строка.Период = БюджетированиеКлиентСервер.ДатаНачалаПериода(Строка.Период, Перечисления.Периодичность.Месяц);
		
	КонецЦикла;	

	Возврат ТаблицаСтатей;
	
КонецФункции 

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьЭкземплярБюджетаСервер(ДанныеФормы)
		
	ДокЭкзеплярБюджета = ДанныеФормыВЗначение(ДанныеФормы, Тип("ДокументОбъект.ЭкземплярБюджета")); 

	//Заполним аналитики шаки
	Для каждого строка из Объект.ВидБюджета.АналитикиШапки цикл
		ДокЭкзеплярБюджета["Аналитика"+строка.НомерСтроки] = ПолучитьАналитикуШапки(строка.ВидАналитики,Объект)
	КонецЦикла;
	
	ТаблицаИсходныеДанные = ПолучитьИсходныеДанныеПоПериодуВидаБюджета();
	
	//Заполним табличные части
	ТаблицаСтатей = ТаблицаИсходныеДанные.Скопировать( ,"СтатьяБюджетов,Контрагент,Договор,ВидРабот,Работа");
	ТаблицаСтатей.Свернуть("СтатьяБюджетов,Контрагент,Договор,ВидРабот,Работа");
	
	Для каждого строка из ТаблицаСтатей цикл
		
		НоваяСтатьяБюджетов = ДокЭкзеплярБюджета.АналитикаСтатейБюджетов.Добавить();	
		НоваяСтатьяБюджетов.СтатьяБюджетов = строка.СтатьяБюджетов;
		НоваяСтатьяБюджетов.Валюта = Объект.Сценарий.Валюта;
		
		НоваяСтатьяБюджетов.Аналитика1 = ПолучитьАналитикуТабличнойЧасти(Строка.СтатьяБюджетов.ВидАналитики1,Строка);
		НоваяСтатьяБюджетов.Аналитика2 = ПолучитьАналитикуТабличнойЧасти(Строка.СтатьяБюджетов.ВидАналитики2,Строка);
		НоваяСтатьяБюджетов.Аналитика3 = ПолучитьАналитикуТабличнойЧасти(Строка.СтатьяБюджетов.ВидАналитики3,Строка);
		НоваяСтатьяБюджетов.Аналитика4 = ПолучитьАналитикуТабличнойЧасти(Строка.СтатьяБюджетов.ВидАналитики4,Строка);
		НоваяСтатьяБюджетов.Аналитика5 = ПолучитьАналитикуТабличнойЧасти(Строка.СтатьяБюджетов.ВидАналитики5,Строка);
		НоваяСтатьяБюджетов.Аналитика6 = ПолучитьАналитикуТабличнойЧасти(Строка.СтатьяБюджетов.ВидАналитики6,Строка);
		
	КонецЦикла;
	
	ДокЭкзеплярБюджета.АналитикаСтатейБюджетов.Свернуть("СтатьяБюджетов,Валюта,Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,Аналитика6");
	
	Для каждого СтрокаСтатьиБюджета из ДокЭкзеплярБюджета.АналитикаСтатейБюджетов цикл
		
		//Установим Идентификатор строки
		ИДСтроки = Новый УникальныйИдентификатор;
		СтрокаСтатьиБюджета.ИдентификаторСтроки = ИДСтроки;		
		
		ТаблицаОборотыПоСтатьямБюджетов = ТаблицаИсходныеДанные.Скопировать( ,"Период,СтатьяБюджетов,Контрагент,Договор,ВидРабот,Работа,Сумма");

		СворачиваемыеАналитики = "Период,СтатьяБюджетов"; 
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("СтатьяБюджетов",СтрокаСтатьиБюджета.СтатьяБюджетов);
		
		ДополнитьСтруктуруПоискаСтатьи(СтрокаСтатьиБюджета.Аналитика1,СтрокаСтатьиБюджета.СтатьяБюджетов.ВидАналитики1,СтруктураПоиска,СворачиваемыеАналитики);
		ДополнитьСтруктуруПоискаСтатьи(СтрокаСтатьиБюджета.Аналитика2,СтрокаСтатьиБюджета.СтатьяБюджетов.ВидАналитики2,СтруктураПоиска,СворачиваемыеАналитики);
		ДополнитьСтруктуруПоискаСтатьи(СтрокаСтатьиБюджета.Аналитика3,СтрокаСтатьиБюджета.СтатьяБюджетов.ВидАналитики3,СтруктураПоиска,СворачиваемыеАналитики);
		ДополнитьСтруктуруПоискаСтатьи(СтрокаСтатьиБюджета.Аналитика4,СтрокаСтатьиБюджета.СтатьяБюджетов.ВидАналитики4,СтруктураПоиска,СворачиваемыеАналитики);
		ДополнитьСтруктуруПоискаСтатьи(СтрокаСтатьиБюджета.Аналитика5,СтрокаСтатьиБюджета.СтатьяБюджетов.ВидАналитики5,СтруктураПоиска,СворачиваемыеАналитики);
		ДополнитьСтруктуруПоискаСтатьи(СтрокаСтатьиБюджета.Аналитика6,СтрокаСтатьиБюджета.СтатьяБюджетов.ВидАналитики6,СтруктураПоиска,СворачиваемыеАналитики);
		
		ТаблицаОборотыПоСтатьямБюджетов.Свернуть(СворачиваемыеАналитики,"Сумма");
		СтрокиПоСтатьеБюджета = ТаблицаОборотыПоСтатьямБюджетов.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого СтрокаСтатейБюджетов из СтрокиПоСтатьеБюджета Цикл 
			НовыйОборотПоСтатьямБюджетов = ДокЭкзеплярБюджета.ОборотыПоСтатьямБюджетов.Добавить();
			НовыйОборотПоСтатьямБюджетов.ИдентификаторСтроки 	= ИДСтроки;			
			НовыйОборотПоСтатьямБюджетов.ПериодПланирования 	= СтрокаСтатейБюджетов.Период;
			НовыйОборотПоСтатьямБюджетов.Сумма 					= СтрокаСтатейБюджетов.Сумма;
			НовыйОборотПоСтатьямБюджетов.Количество				= 0;
			НовыйОборотПоСтатьямБюджетов.СуммаВВалюте 			= СтрокаСтатейБюджетов.Сумма;
			НовыйОборотПоСтатьямБюджетов.НомерПоПорядку			= НовыйОборотПоСтатьямБюджетов.НомерСтроки;
		КонецЦикла;	
		
	КонецЦикла;
	
	ЗначениеВДанныеФормы(ДокЭкзеплярБюджета, ДанныеФормы);
	
КонецПроцедуры

#КонецОбласти