Функция ПолучитьПодчиненныеДокументы(ТекДокумент)
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СМ_АктВыполненныхРабот.ЛокальнаяСмета,
	               |	СУММА(1) КАК КоличествоАктов
	               |ПОМЕСТИТЬ АктыСметы
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
	               |ГДЕ
	               |	СМ_АктВыполненныхРабот.ПометкаУдаления = ЛОЖЬ
	               |	И СМ_АктВыполненныхРабот.Стройка = &ОбъектСтроительства
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_АктВыполненныхРабот.ЛокальнаяСмета
	               |;
	               |
	               |// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
	               |ВЫБРАТЬ
	               |	АктыСметы.ЛокальнаяСмета,
	               |	ВЫБОР
	               |		КОГДА АктыСметы.КоличествоАктов > 1
	               |			ТОГДА 2
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК КартинкаАкт
	               |ПОМЕСТИТЬ СметыКартинкиАкты
	               |ИЗ
	               |	АктыСметы КАК АктыСметы
	               |;
	               |
	               |// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
	               |ВЫБРАТЬ
	               |	СМ_ОбъектнаяСмета.Ссылка КАК Смета,
	               |	СМ_ОбъектнаяСмета.Ссылка КАК Ссылка,
	               |	СМ_ОбъектнаяСмета.ИДРодителя КАК Родитель,
	               |	СМ_ОбъектнаяСмета.Стройка,
	               |	СМ_ОбъектнаяСмета.НомерСметы,
	               |	СМ_ОбъектнаяСмета.Наименование,
	               |	СМ_ОбъектнаяСмета.ПометкаУдаления,
	               |	2 КАК Сортировка,
	               |	0 КАК КартинкаАкты,
	               |	ИтогПоОС.СуммаБазис,
	               |	ИтогПоОС.СуммаТек
	               |ИЗ
	               |	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СМ_ИтогиПоГлавам.Смета КАК Смета,
	               |			СУММА(СМ_ИтогиПоГлавам.ПрямЗатраты) КАК СуммаБазис,
	               |			СУММА(СМ_ИтогиПоГлавам.ТекПрямЗатраты) КАК СуммаТек
	               |		ИЗ
	               |			РегистрСведений.СМ_ИтогиПоГлавамОС КАК СМ_ИтогиПоГлавам
	               |		ГДЕ
	               |			СМ_ИтогиПоГлавам.Итог = &ИтогПоСмете
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СМ_ИтогиПоГлавам.Смета) КАК ИтогПоОС
	               |		ПО СМ_ОбъектнаяСмета.Ссылка = ИтогПоОС.Смета
	               |ГДЕ
	               |	СМ_ОбъектнаяСмета.ИДРодителя = &ТекДокумент
	               |	И СМ_ОбъектнаяСмета.Стройка = &ОбъектСтроительства
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СМ_ЛокальнаяСмета.Ссылка,
	               |	СМ_ЛокальнаяСмета.Ссылка,
	               |	СМ_ЛокальнаяСмета.ИДРодителя,
	               |	СМ_ЛокальнаяСмета.Стройка,
	               |	СМ_ЛокальнаяСмета.НомерСметы,
	               |	СМ_ЛокальнаяСмета.Наименование,
	               |	СМ_ЛокальнаяСмета.ПометкаУдаления,
	               |	3,
	               |	ЕСТЬNULL(СметыКартинкиАкты.КартинкаАкт, 0),
	               |	ИтогПоЛС.СуммаБазис,
	               |	ИтогПоЛС.СуммаТек
	               |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СМ_ИтогиПоГлавам.Смета КАК Смета,
	               |			СУММА(СМ_ИтогиПоГлавам.ПрямЗатраты) КАК СуммаБазис,
	               |			СУММА(СМ_ИтогиПоГлавам.ТекПрямЗатраты) КАК СуммаТек
	               |		ИЗ
	               |			РегистрСведений.СМ_ИтогиПоГлавам КАК СМ_ИтогиПоГлавам
	               |		ГДЕ
	               |			СМ_ИтогиПоГлавам.Итог = &ИтогПоСмете
	               |		
