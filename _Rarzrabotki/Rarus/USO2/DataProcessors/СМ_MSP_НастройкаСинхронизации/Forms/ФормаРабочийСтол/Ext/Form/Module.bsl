&НаСервере
Процедура ОбновитьПодчиненныеНаСервере(ТекЭлемент)

	Если ТипЗнч(ТекЭлемент) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
		Возврат;	
	КонецЕсли;
	
	ТабРезультат = ПолучитьПодчиненныеДокументы(ТекЭлемент);
	ТабРезультат.Сортировать("Сортировка Возр, Родитель Убыв, Смета Возр");
		
	ДеревоЗначений = РеквизитФормыВЗначение("СписокСметы", Тип("ДеревоЗначений"));
	НайденнаяСтрока = ДеревоЗначений.Строки.Найти(ТекЭлемент,"Смета",Истина);	
	// ДокторСофт
	Если НайденнаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// ДокторСофт
	НайденнаяСтрока.Строки.Очистить();
	Для Каждого ТекСтрока Из ТабРезультат Цикл
		НайденнаяСтрока2 = ДеревоЗначений.Строки.Найти(ТекСтрока.Родитель,"Смета",Истина);	
		Если НайденнаяСтрока <> Неопределено Тогда
			СтрокаДерева = НайденнаяСтрока2.Строки.Добавить();	
		Иначе
			СтрокаДерева = НайденнаяСтрока.Строки.Добавить();	
		КонецЕсли;			
		ЗаполнитьЗначенияСвойств(СтрокаДерева,ТекСтрока);
		СтрокаДерева.Картинка 		 = ПолучитьКартинкуСтроки(СтрокаДерева.Ссылка, СтрокаДерева.ПометкаУдаления);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначений,"СписокСметы");
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСмету()
	
	ТекДанные = Элементы.СписокСметы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
	
		ЛимЗатрата = Неопределено;
		Если ТипЗнч(ТекДанные.Ссылка) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			ЛимЗатрата = ТекДанные.Ссылка;
			Если ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда 	
				ТекИмяФормы = "Документ.СМ_ЛокальнаяСмета.Форма.ФормаДокументаУпр";
			ИначеЕсли ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда 	
				ТекИмяФормы = "Документ.СМ_ОбъектнаяСмета.Форма.ФормаДокументаУпр";
			ИначеЕсли ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда 	
				ТекИмяФормы = "Документ.СМ_СводнаяСмета.Форма.ФормаДокументаУпр";
			Иначе
				Возврат;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ТекДанные.Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда 	
			ТекИмяФормы = "Документ.СМ_ЛокальнаяСмета.Форма.ФормаДокументаУпр";
		ИначеЕсли ТипЗнч(ТекДанные.Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда 	
			ТекИмяФормы = "Документ.СМ_ОбъектнаяСмета.Форма.ФормаДокументаУпр";
		ИначеЕсли ТипЗнч(ТекДанные.Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда 	
			ТекИмяФормы = "Документ.СМ_СводнаяСмета.Форма.ФормаДокументаУпр";
		Иначе 
			Возврат;
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Ссылка",ТекДанные.Смета);
		СтруктураПараметров.Вставить("Ключ",ТекДанные.Смета);
		Если Не ЛимЗатрата = Неопределено Тогда
			СтруктураПараметров.Вставить("ЛимЗатрата",ЛимЗатрата);
		КонецЕсли;
		ОткрытьФорму(ТекИмяФормы,СтруктураПараметров);
		
	КонецЕсли;	
	
КонецПроцедуры

