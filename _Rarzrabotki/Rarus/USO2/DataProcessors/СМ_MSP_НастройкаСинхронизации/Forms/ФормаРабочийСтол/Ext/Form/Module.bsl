
#Область ОписаниеПеременных

&НаКлиенте
Перем ТекущийДокумент, ТекущаяСтройка;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	//ОбщегоНазначения.ПриСозданииНаСервере(этаФорма, Отказ, СтандартнаяОбработка);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Отказ = СМ_ЗащитаКлиент.ЗапускОбъекта();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьДеревоСмет" Тогда
		//  Сохранение текущей строки дерева
		СтрокаДерева 	= Неопределено;
		ТекДанные 		= Элементы.СписокСметы.ТекущиеДанные;
		СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, ТекДанные, Элементы.СписокСметы, СписокСметы.ПолучитьЭлементы(),"Смета");
		
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("Смета") Тогда
				ТекСмета = Параметр.Смета;
				Если ЗначениеЗаполнено(ТекСмета) Тогда
					СтрокаДерева.ТекущийЭлемент = ТекСмета;
				КонецЕсли;
				ОбновитьПодчиненныеНаСервере(ТекСмета);
				Если Параметр.Свойство("Стройка") Тогда
					ТекСтройка =  Параметр.Стройка;
					Если Элементы.РежимОтображенияДерева.Пометка Тогда
						Элементы.СписокОбъектыСтроительства.ТекущаяСтрока = Параметр.Стройка;
						ОбновитьДеревоСметСервер(Параметр.Стройка);
					Иначе
						ОбновитьДеревоСметСервер();
					КонецЕсли;
				Иначе
					ОбновитьДеревоСметСервер();
				КонецЕсли;
			ИначеЕсли Параметр.Свойство("Стройка") Тогда
				ТекСтройка =  Параметр.Стройка;
				Если Элементы.РежимОтображенияДерева.Пометка Тогда
					ОбновитьДеревоСметСервер(Параметр.Стройка);
				Иначе
					ОбновитьДеревоСметСервер();
				КонецЕсли;
			Иначе
				ОбновитьДеревоСметСервер();
			КонецЕсли;
		Иначе
			Если Элементы.РежимОтображенияДерева.Пометка Тогда
				ОбновитьДеревоСметСервер(Элементы.СписокОбъектыСтроительства.ТекущаяСтрока);
			Иначе
				ОбновитьДеревоСметСервер();
			КонецЕсли;
		КонецЕсли;
		
		//  Восстановление текущей строки дерева
		Если СтрокаДерева <> Неопределено Тогда
			СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.СписокСметы, СписокСметы.ПолучитьЭлементы(), СписокСметы, СтрокаДерева, "Смета");
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбъектыСтроительства

&НаКлиенте
Процедура СписокОбъектыСтроительстваПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПредыдущаяСтройка = ТекущаяСтройка;
		ТекущаяСтройка = ТекДанные.Ссылка;
		Если ТекущаяСтройка <> ПредыдущаяСтройка Тогда
			ТекОбъект2 = ТекДанные.Ссылка;       	
			Если Не Необновлять Тогда
				ОбновитьДеревоСметСервер(ТекОбъект2);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокСметы

&НаКлиенте
Процедура СписокСметыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьСмету();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДерево(Команда)
	
	ТекДанные = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ОбновитьДеревоСметСервер();
	Иначе
		ОбновитьДеревоСметСервер(ТекДанные.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РежимОтображенияДерева(Команда)
	
	Элементы.РежимОтображенияДерева.Пометка = Не Элементы.РежимОтображенияДерева.Пометка;
	Если Элементы.РежимОтображенияДерева.Пометка Тогда
		Элементы.СписокОбъектыСтроительства.Видимость = Истина;
		ТекДанные = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			ОбновитьДеревоСметСервер(ТекущаяСтройка);
		Иначе
			ОбновитьДеревоСметСервер(ТекДанные.Ссылка);
		КонецЕсли;
	Иначе
		Элементы.СписокОбъектыСтроительства.Видимость = Ложь;
		ОбновитьДеревоСметСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСметы(Команда)
	
	ТекДанные = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выделите объект строительства");
	ИначеЕсли ЭтоГруппа(ТекДанные.Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Выгрузка не производится для группы объектов");
	иначе
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("ОбъектСтроительства",ТекДанные.Ссылка);
		ОткрытьФорму("Обработка.СМ_MSP_НастройкаСинхронизации.Форма.ФормаВыгрузки",СтруктураПараметров);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьДеревоСметСервер(ТекОбъект = Неопределено)
	
	ТабРезультат = ПолучитьДеревоСмет(ТекОбъект);
	ТабРезультат.Сортировать("Сортировка Возр, Родитель Убыв, Смета Возр");
		
	ДеревоЗначений = РеквизитФормыВЗначение("СписокСметы", Тип("ДеревоЗначений"));
	ДеревоЗначений.Строки.Очистить();
	
	Для Каждого ТекСтрока Из ТабРезультат Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Родитель) Тогда
			НайденнаяСтрока = ДеревоЗначений.Строки.Найти(ТекСтрока.Родитель,"Смета",Истина);	
			Если НайденнаяСтрока <> Неопределено Тогда
				СтрокаДерева = НайденнаяСтрока.Строки.Добавить();	
			Иначе
				СтрокаДерева = ДеревоЗначений.Строки.Добавить();	
			КонецЕсли;			
		Иначе
			СтрокаДерева = ДеревоЗначений.Строки.Добавить();	
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(СтрокаДерева,ТекСтрока);
		
		СтрокаДерева.Картинка 		 = ПолучитьКартинкуСтроки(СтрокаДерева.Ссылка, СтрокаДерева.ПометкаУдаления);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначений,"СписокСметы");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКартинкуСтроки(ТекЭлемент, ПометкаУдаления)
	
	// 0. Лим затрата
	// 1. СС
	// 2. ОС
	// 3. ЛС (ресурсный метод)
	// 4. ЛС (базисно инд метод)
	// 5. ЛС просто	
	
	// С пометкой удаления
	// 6. Лим затрата
	// 7. СС
	// 8. ОС
	// 9. ЛС (ресурсный метод)
	// 10. ЛС (базисно инд метод)
	// 11. ЛС просто	
	
	//	КОРРЕКТИРОВКА
	//	18. ЛС (ресурсный метод).
	//	19. ЛС (базисно инд метод).
	//	20. ЛС просто.
	//	21. ПОМЕТКА УДАЛЕНИЯ ЛС (ресурсный метод).
	//	22. ПОМЕТКА УДАЛЕНИЯ ЛС (базисно инд метод).
	//	23. ПОМЕТКА УДАЛЕНИЯ ЛС просто.
	//	24. ПРОВЕДЕН ЛС (ресурсный метод).
	//	25. ПРОВЕДЕН ЛС (базисно инд метод).
	//	26. ПРОВЕДЕН ЛС просто.
	
	Если ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Если ТекЭлемент.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			Если ЗначениеЗаполнено(ТекЭлемент.КорректируетСмету) тогда
				ТекКартинка = ?(ПометкаУдаления,21,?(ТекЭлемент.Проведен,24,18));
				Возврат ТекКартинка;
			Иначе
				ТекКартинка = ?(ПометкаУдаления,9,?(ТекЭлемент.Проведен,15,3));
				Возврат ТекКартинка;	
			КонецЕсли;
		ИначеЕсли ТекЭлемент.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
			Если ЗначениеЗаполнено(ТекЭлемент.КорректируетСмету) тогда
				ТекКартинка = ?(ПометкаУдаления,22,?(ТекЭлемент.Проведен,25,19));
				Возврат ТекКартинка;
			Иначе
				ТекКартинка = ?(ПометкаУдаления,10,?(ТекЭлемент.Проведен,16,4));
				Возврат ТекКартинка;
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(ТекЭлемент.КорректируетСмету) тогда
				ТекКартинка = ?(ПометкаУдаления,23,?(ТекЭлемент.Проведен,26,20));
				Возврат ТекКартинка;
			Иначе
				ТекКартинка = ?(ПометкаУдаления,11,?(ТекЭлемент.Проведен,17,5));
				Возврат ТекКартинка;
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		ТекКартинка = ?(ПометкаУдаления,8,?(ТекЭлемент.Проведен,14,2));
		Возврат ТекКартинка;
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ТекКартинка = ?(ПометкаУдаления,7,?(ТекЭлемент.Проведен,13,1));
		Возврат ТекКартинка;
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
		ТекКартинка = ?(ПометкаУдаления,6,0);
		Возврат ТекКартинка;
	Иначе
		Возврат	5;
	КонецЕсли;	
		
КонецФункции

&НаСервере
Функция ПолучитьДеревоСмет(ТекОбъект3)
	
	Запрос = Новый Запрос;

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_АктВыполненныхРабот.ЛокальнаяСмета,
	               |	СУММА(1) КАК КоличествоАктов
	               |ПОМЕСТИТЬ АктыСметы
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот ГДЕ	СМ_АктВыполненныхРабот.ПометкаУдаления = ЛОЖЬ  ";
				    Если ЗначениеЗаполнено(ТекОбъект3) Тогда
						ТекстЗапроса = ТекстЗапроса + " И СМ_АктВыполненныхРабот.Стройка В Иерархии (&ОбъектСтроительства)";			
					КонецЕсли;
	               ТекстЗапроса = ТекстЗапроса + "
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_АктВыполненныхРабот.ЛокальнаяСмета
	               |;
	               |
	               |// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	АктыСметы.ЛокальнаяСмета,
	               |	ВЫБОР
	               |		КОГДА АктыСметы.КоличествоАктов > 1
	               |			ТОГДА 2
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК КартинкаАкт
	               |ПОМЕСТИТЬ СметыКартинкиАкты
	               |ИЗ
	               |	АктыСметы КАК АктыСметы
	               |;
	               |
	               |// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СМ_СводнаяСмета.Ссылка КАК Смета,
	               |	СМ_СводнаяСмета.Ссылка КАК Ссылка,
	               |	"""" КАК Родитель,
	               |	СМ_СводнаяСмета.Стройка,
	               |	СМ_СводнаяСмета.НомерСметы,
	               |	СМ_СводнаяСмета.Наименование,
	               |	СМ_СводнаяСмета.ПометкаУдаления,
	               |	ИтогПоСС.СуммаБазис,
	               |	ИтогПоСС.СуммаТек,
				   |	1 КАК Сортировка,
				   |	0 КАК КартинкаАкты,
				   |	СМ_СводнаяСмета.Автор,
				   |	СМ_СводнаяСмета.Заказчик,
				   |	СМ_СводнаяСмета.Инвестор,
				   |	СМ_СводнаяСмета.Подрядчик,
				   |	НЕОПРЕДЕЛЕНО КАК Район,
				   |	ЛОЖЬ КАК Методика1984,
				   |	ЛОЖЬ КАК МетодикаТСН
				   |ИЗ
	               |	Документ.СМ_СводнаяСмета КАК СМ_СводнаяСмета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СМ_ИтогиПоГлавамСС.Смета КАК Смета,
	               |			СУММА(СМ_ИтогиПоГлавамСС.ПрямЗатраты) КАК СуммаБазис,
	               |			СУММА(СМ_ИтогиПоГлавамСС.ТекПрямЗатраты) КАК СуммаТек
	               |		ИЗ
	               |			РегистрСведений.СМ_ИтогиПоГлавамСС КАК СМ_ИтогиПоГлавамСС
	               |		ГДЕ
	               |			СМ_ИтогиПоГлавамСС.Итог = &ИтогПоСмете
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СМ_ИтогиПоГлавамСС.Смета) КАК ИтогПоСС
	               |		ПО СМ_СводнаяСмета.Ссылка = ИтогПоСС.Смета";

	Если ЗначениеЗаполнено(ТекОбъект3) Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ СМ_СводнаяСмета.Стройка В Иерархии (&ОбъектСтроительства)";			
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ОбъектнаяСмета.Ссылка КАК Смета,
	|	СМ_ОбъектнаяСмета.Ссылка КАК Ссылка,
	|	СМ_ОбъектнаяСмета.ИДРодителя КАК Родитель,
	|	СМ_ОбъектнаяСмета.Стройка,
	|	СМ_ОбъектнаяСмета.НомерСметы,
	|	СМ_ОбъектнаяСмета.Наименование,
	|	СМ_ОбъектнаяСмета.ПометкаУдаления,
	| 	ИтогПоОС.СуммаБазис,
	| 	ИтогПоОС.СуммаТек,
	|	2 КАК Сортировка,
	|	0,
	|	СМ_ОбъектнаяСмета.Автор,
	|	СМ_ОбъектнаяСмета.Заказчик,
	|	СМ_ОбъектнаяСмета.Инвестор,
	|	СМ_ОбъектнаяСмета.Подрядчик,
	|	НЕОПРЕДЕЛЕНО,
	|	ЛОЖЬ,
	|	ЛОЖЬ
	|ИЗ
	|	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета 
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|
	|	(ВЫБРАТЬ 
	|		СМ_ИтогиПоГлавам.Смета КАК Смета,
	|		Сумма(СМ_ИтогиПоГлавам.ПрямЗатраты) КАК СуммаБазис,
	|		Сумма(СМ_ИтогиПоГлавам.ТекПрямЗатраты) КАК СуммаТек
	|	ИЗ
	|		РегистрСведений.СМ_ИтогиПоГлавамОС КАК СМ_ИтогиПоГлавам
	|	ГДЕ
	|		СМ_ИтогиПоГлавам.Итог = &ИтогПоСмете
	|	СГРУППИРОВАТЬ ПО 
	|		СМ_ИтогиПоГлавам.Смета) КАК ИтогПоОС	
	|	ПО СМ_ОбъектнаяСмета.Ссылка = ИтогПоОС.Смета";
	
	Если ЗначениеЗаполнено(ТекОбъект3) Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ	СМ_ОбъектнаяСмета.Стройка  В Иерархии (&ОбъектСтроительства) ИЛИ СМ_ОбъектнаяСмета.ИДРодителя.Стройка В Иерархии (&ОбъектСтроительства)";			
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|	
	|ВЫБРАТЬ
	|	СМ_ЛокальнаяСмета.Ссылка КАК Смета,
	|	СМ_ЛокальнаяСмета.Ссылка КАК Ссылка,	
