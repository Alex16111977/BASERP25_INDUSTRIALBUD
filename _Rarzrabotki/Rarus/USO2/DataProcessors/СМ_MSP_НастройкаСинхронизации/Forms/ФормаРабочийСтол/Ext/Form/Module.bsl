	КонецЕсли;
	Запрос.УстановитьПараметр("ИтогПоСмете",ИтогПоСмете);
	Запрос.УстановитьПараметр("ОбъектСтроительства",ТекОбъект3);
	Запрос.УстановитьПараметр("ПустаяЛЗ",Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка());

	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
