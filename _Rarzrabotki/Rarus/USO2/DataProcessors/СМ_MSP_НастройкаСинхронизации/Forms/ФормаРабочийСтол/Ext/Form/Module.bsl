	               |			И СМ_СводнаяСметаЛимитированныеЗатраты.ЛимитированнаяЗатрата.Ссылка = ЛимЗатратыСС.Итог
	               |ГДЕ
	               |	СМ_СводнаяСметаЛимитированныеЗатраты.Ссылка.Стройка = &ОбъектСтроительства
	               |	И СМ_СводнаяСметаЛимитированныеЗатраты.Ссылка = &ТекДокумент";
				   
	Запрос.Текст = ТекстЗапроса;
	ИтогПоСмете = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ИтогСметыДляДерева");
	Если Не ИтогПоСмете = Неопределено
		И ИтогПоСмете.Пустая() Тогда
		ИтогПоСмете = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4");
	КонецЕсли;
	Запрос.УстановитьПараметр("ТекДокумент",ТекДокумент);
	Запрос.УстановитьПараметр("ИтогПоСмете",ИтогПоСмете);
	Запрос.УстановитьПараметр("ОбъектСтроительства",ТекДокумент.Стройка);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
