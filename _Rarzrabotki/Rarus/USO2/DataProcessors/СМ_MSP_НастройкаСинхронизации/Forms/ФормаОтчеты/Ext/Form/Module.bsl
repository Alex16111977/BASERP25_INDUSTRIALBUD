
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВТДеревоПроекта=ДанныеФормыВЗначение(Параметры.ЗадачиПроекта, Тип("ДеревоЗначений"));
	ВТДеревоСмет=ДанныеФормыВЗначение(Параметры.ДеревоСмет, Тип("ДеревоЗначений"));

	
	ТаблицаСметы = Новый ТаблицаЗначений;
	СоздатьТаблицу(ТаблицаСметы,ВТДеревоСмет);
	
	ТаблицаСметыНеСопоставленых=ТаблицаСметы.Скопировать();
	
	Строки=ВТДеревоСмет.Строки.НайтиСтроки(Новый Структура("ВидОбъекта","Позиция"),Истина);
	Для Каждого Эл Из Строки Цикл
		Если Эл.НомерВПроекте<=0 Тогда
			НоваяСтрока = ТаблицаСметыНеСопоставленых.Добавить();
		Иначе
			НоваяСтрока = ТаблицаСметы.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока ,Эл);
	КонецЦикла;	
	
	ТекстКолонкиСметы="";
	Для Каждого Колонка ИЗ ТаблицаСметы.Колонки Цикл
		Если Найти(Колонка.Имя,"Колонка")>0 Тогда
		ТекстКолонкиСметы=ТекстКолонкиСметы+", "+Колонка.Имя;
		КонецЕсли;
	КонецЦикла;	
	
	
	ТаблицаПроекта=Новый ТаблицаЗначений;
	
	СоздатьТаблицу(ТаблицаПроекта,ВТДеревоПроекта);
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	ТаблицаПроекта.Колонки.Добавить("Задача",Новый ОписаниеТипов(МассивТипов, , ));

	
	Строки=ВТДеревоПроекта.Строки.НайтиСтроки(Новый Структура("MSP_ВидОбъекта","Ресурс"),Истина);
	Для Каждого Эл Из Строки Цикл
		НоваяСтрока = ТаблицаПроекта.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока ,Эл);
		Если Эл.Родитель<>Неопределено Тогда
			НоваяСтрока.Задача=Эл.Родитель.MSP_НаименованиеОбъекта;
		КонецЕсли;	
	КонецЦикла;
	
	
	ТекстКолонкиПроекта="";
	Для Каждого Колонка ИЗ ТаблицаПроекта.Колонки Цикл
		Если Найти(Колонка.Имя,"Колонка")>0 Тогда
		ТекстКолонкиПроекта=ТекстКолонкиПроекта+", "+Колонка.Имя;
		КонецЕсли;
	КонецЦикла;		
	
	
	
    
	
	
	СхемаКомпоновкиДанных=РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОтчетНеСопоставленные");

	НастройкиСКД  = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;

	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ВТ",ТаблицаСметыНеСопоставленых);
	
	
	

	ДанныеРасшифровкиТД1 = Новый ДанныеРасшифровкиКомпоновкиДанных;
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиСКД, ДанныеРасшифровкиТД1);
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,ВнешниеНаборыДанных ,ДанныеРасшифровкиТД1);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТД1);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);  

	ДанныеРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиТД1,ЭтаФорма.УникальныйИдентификатор);
	Схема = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных,ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьТаблицу(ТЗ,Источник)
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("ДокументСсылка.СМ_ЛокальнаяСмета"));
	МассивТипов.Добавить(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы"));
	МассивТипов.Добавить(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"));
	МассивТипов.Добавить(Тип("Строка"));
	
	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов, , );
	
	Для Каждого Колонка Из Источник.Колонки Цикл
		ТЗ.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
