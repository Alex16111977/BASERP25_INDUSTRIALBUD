
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ОбъектСтроительства") Тогда
		ОбъектСтроительства=Параметры.ОбъектСтроительства;
		ПутьКФайлуПроекта=ОбъектСтроительства.ПутьПроектMSP;
	КонецЕсли;	
	Если Параметры.Свойство("Сметы") Тогда
		Сметы.ЗагрузитьЗначения(Параметры.Сметы.ВыгрузитьЗначения());
	КонецЕсли;	
	Если Сметы.Количество()=0 Тогда
		Элементы.Сметы.Доступность=Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПутьКФайлуПроектаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Диалог 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ФильтрДляДиалога 	= "MPP (*.mpp)|*.mpp";
	ФильтрДляДиалога 	= ФильтрДляДиалога + "|Все файлы (*.*)|*.*";
	Диалог.Фильтр 		= ФильтрДляДиалога;
	
	// Синхронный вызов
	//Если Диалог.Выбрать() Тогда
	//	ПутьКФайлуПроекта=Диалог.ПолноеИмяФайла;
	//КонецЕсли;
	
	// Замена на асинхронный вызов
	ОповещениеВыбора = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект);
	Диалог.Показать(ОповещениеВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайла(ВыбранныеФайлы,ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ВыбранныеФайлы Цикл
			ПутьКФайлуПроекта = ТекЭлемент;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отмена(Команда)
	
	ЭтаФорма.Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗагрузку(Команда)
	
	СохранитьПуть();
	ЭтаФорма.Закрыть(Новый Структура("Действие,Путь,Сметы","Продолжить",ПутьКФайлуПроекта,Сметы.ВыгрузитьЗначения()));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьПуть()
	
	Об=ОБъектСтроительства.ПолучитьОбъект();
	Об.ПутьПроектMSP=ПутьКФайлуПроекта;
	Об.Записать();
	
КонецПроцедуры

#КонецОбласти

