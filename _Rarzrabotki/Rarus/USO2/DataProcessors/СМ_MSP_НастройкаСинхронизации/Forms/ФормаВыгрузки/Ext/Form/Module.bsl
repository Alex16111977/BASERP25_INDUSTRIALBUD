
#Область ОписаниеПеременных

&НаКлиенте
Перем ФормаИндикатор;

&НаКлиенте
Перем ПараметрыОбработчика;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Отбор=Новый Структура;
	Отбор.Вставить("ТолькоНеСопоставленныеВПроекте",Ложь);
	Отбор.Вставить("ТолькоНеСопоставленныеВСмете",Ложь);
	Отбор.Вставить("ПоказыватьВСмете",-1);
	Отбор.Вставить("ПоказыватьВПроекте",-1);

	Набор=Справочники.НаборыДополнительныхРеквизитовИСведений["Документ_СМ_ПозицияЛокальнойСметы"];
	Ном=1;
	Для Каждого Рекв Из Набор.ДополнительныеРеквизиты Цикл
		ИмяКолонки="Колонка"+СтрЗаменить(Ном,Символы.НПП,"");
		ЗаголовокКолонки=Рекв.Свойство.Заголовок;
		Стр=СоответствиеКолонокДопРеквизитов.Добавить();
		Стр.ИмяКолонки=ИмяКолонки;
		Стр.Заголовок=ЗаголовокКолонки;
		Стр.Свойство=Рекв.Свойство;
		Стр.ЮИД=Рекв.Свойство.УникальныйИдентификатор();
		Ном=Ном+1;
	КонецЦикла;

	ЗаполнитьНастройки();
	
	Если Параметры.Свойство("Смета") Тогда 
		Смета.Добавить(Параметры.Смета); 
		ОбъектСтроительства=Параметры.Смета.Стройка;
	ИначеЕсли Параметры.Свойство("ОбъектСтроительства") Тогда	
		ОбъектСтроительства=Параметры.ОбъектСтроительства;
		Запрос 			= Новый Запрос;
		Запрос.Текст 	= "
		|ВЫБРАТЬ
		|	СМ_ЛокальнаяСмета.Ссылка
		|ИЗ
		|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
		|ГДЕ
		|	СМ_ЛокальнаяСмета.Стройка = &Стройка И
		|	( СМ_ЛокальнаяСмета.Статус В(&Статус) ИЛИ &БезСтатусов) И НЕ
		|	СМ_ЛокальнаяСмета.ПометкаУдаления";
		 Запрос.УстановитьПараметр("Стройка",ОбъектСтроительства);
		 Запрос.УстановитьПараметр("БезСтатусов",Не ПолучитьФункциональнуюОпцию("СМ_ИспользоватьСтатусыДокументов"));
		 Запрос.УстановитьПараметр("Статус",ОБъект.РазрешенныеСтатусы.Выгрузить(,"Статус"));
		 Рез=запрос.Выполнить().Выгрузить();
		 Смета.ЗагрузитьЗначения(Рез.ВыгрузитьКолонку("Ссылка"));
	КонецЕсли;
	
	Если Объект.СинхронизироватьПоДополнительнымРеквизитам Тогда
		НовыеКолонки = Новый Массив; 
		НовыеКолонкиСоответствия=новый Массив;
		НовыеКолонкиДерева = Новый Массив; 

		Для Каждого Рекв Из СоответствиеКолонокДопРеквизитов Цикл
			
			Если Рекв.Используется Тогда
				НовыеКолонки.Добавить(Новый РеквизитФормы(Рекв.ИмяКолонки,Новый ОписаниеТипов("Строка"),"ЗадачиПроекта",Рекв.Заголовок)); 
				НовыеКолонкиДерева.Добавить(Новый РеквизитФормы("Д"+Рекв.ИмяКолонки,Новый ОписаниеТипов("Строка"),"ДеревоСмет",Рекв.Заголовок)); 
				НовыеКолонкиСоответствия.Добавить(Новый РеквизитФормы("П"+Рекв.ИмяКолонки,Новый ОписаниеТипов("Строка"),"ТаблицаСопоставлений",Рекв.Заголовок)); 
				НовыеКолонкиСоответствия.Добавить(Новый РеквизитФормы("С"+Рекв.ИмяКолонки,Новый ОписаниеТипов("Строка"),"ТаблицаСопоставлений",Рекв.Заголовок)); 
			Конецесли;
		КонецЦикла;
		
		ИзменитьРеквизиты(НовыеКолонки);
		ИзменитьРеквизиты(НовыеКолонкиДерева);
		ИзменитьРеквизиты(НовыеКолонкиСоответствия);
		
		Для каждого Колонка Из НовыеКолонки Цикл 
			НовыйЭлемент = Элементы.Добавить("ЗадачиПроекта"+Колонка.Имя,Тип("ПолеФормы"),Элементы.ЗадачиПроекта); 
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			НовыйЭлемент.ПутьКДанным = "ЗадачиПроекта."+Колонка.Имя; 
			НовыйЭлемент.ТолькоПросмотр = Истина; 
		КонецЦикла; 
		
		Для каждого Колонка Из НовыеКолонкиДерева Цикл 
			НовыйЭлемент = Элементы.Добавить("ДеревоСмет"+Колонка.Имя,Тип("ПолеФормы"),Элементы.ДеревоСмет); 
			НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода; 
			НовыйЭлемент.ПутьКДанным = "ДеревоСмет."+Колонка.Имя; 
			НовыйЭлемент.ТолькоПросмотр = Истина; 
		КонецЦикла; 
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОткрытьФорму("Обработка.СМ_MSP_НастройкаСинхронизации.Форма.ФормаВводПутиКФайлу",Новый Структура("ОбъектСтроительства,Сметы",ОБъектСтроительства,Смета),,,ВариантОткрытияОкна.ОтдельноеОкно,,Новый ОписаниеОповещения("ПослеВыбораФайлаПроекта", ЭтотОбъект, ),РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПутьКРезервномуФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Диалог 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ФильтрДляДиалога 	= "MS Project|*.mpp";
	ФильтрДляДиалога 	= ФильтрДляДиалога + "|Все файлы (*.*)|*.*";
	Диалог.Фильтр 		= ФильтрДляДиалога;
	
	// Синхронный вызов
	//Если Диалог.Выбрать() Тогда
	//	ПутьКРезервномуФайлу = Диалог.ПолноеИмяФайла;
	//КонецЕсли;
	
	// Замена на асинхронный вызов
	ОповещениеВыбора = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект);
	Диалог.Показать(ОповещениеВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайла(ВыбранныеФайлы,ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ВыбранныеФайлы Цикл
			ПутьКРезервномуФайлу = ТекЭлемент;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗадачиПроекта

&НаКлиенте
Процедура ЗадачиПроектаДействиеПриИзменении(Элемент)
	
	Если Элементы.ЗадачиПроекта.ТекущаяСтрока<>Неопределено  Тогда
		МассивПроект=Новый Массив;
		Для Каждого Эл Из   Элементы.ЗадачиПроекта.ВыделенныеСтроки Цикл
			МассивПроект.Добавить(Эл);
		КонецЦикла;
		ИзменитьОбъемНаСервере(МассивПроект);
	Конецесли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоСмет

&НаКлиенте
Процедура ДеревоСметВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Элементы.ДеревоСмет.ТекущиеДанные<>Неопределено Тогда
		СтандартнаяОбработка=Ложь;
		ТекСтр=Элементы.ДеревоСмет.ТекущиеДанные.Ссылка;
		Если ТипЗнч(ТекСтр)=Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда 
			ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаДокументаУпр",Новый Структура("Ключ",ТекСтр));
		ИначеЕсли ТипЗнч(ТекСтр)=Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда 
			ОткрытьФорму("Документ.СМ_ПозицияЛокальнойСметы.Форма.ФормаДокументаУпр",Новый Структура("Ключ",ТекСтр));
		ИначеЕсли ТипЗнч(ТекСтр)=Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда 
			ОткрытьФорму("Документ.СМ_РазделЛокальнойСметы.Форма.ФормаДокументаУпр",Новый Структура("Ключ",ТекСтр));
		КонецЕсли;
	КонецЕсли;
  
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСметПриАктивизацииЯчейки(Элемент)
	
	Если Элемент.ТекущийЭлемент.Имя ="ДеревоСметКомментарий" Тогда
		Если Элементы.ДеревоСмет.ТекущиеДанные<>Неопределено Тогда
			Если Элементы.ДеревоСмет.ТекущиеДанные.КомментСсылка="Открыть" Тогда
				ОткрытьФорму("Обработка.СМ_MSP_НастройкаСинхронизации.Форма.ФормаКомментарий",Новый Структура("Комментарий",ПолучитьТекстКомментария(Элементы.ДеревоСмет.ТекущаяСтрока)),ЭтаФорма,,ВариантОткрытияокна.ОтдельноеОкно,,,РежимОткрытияОкнаФормы.Независимый);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыгрузитьвMSP(Команда)
	
	ДвоичныеДанныеФайла=Неопределено;
	МассивЗначений=Новый Массив;
	Позиции=Новый Массив;
	
	Если НЕ ВыгрузитьВMSPНаСервере(ДвоичныеДанныеФайла,МассивЗначений,Позиции) Тогда
		Если СМ_MSP_Клиент.ЗаписатьФайлОбъекта(ОбъектСтроительства,МассивЗначений) Тогда
			ЗаписатьСтатусыПозицийНаСервере(Позиции);
			Попытка
			СформироватьОтчет(МассивЗначений).Показать();
		Исключение
			КонецПопытки;

		КонецЕсли;
	КонецЕсли;
	
	Если ДвоичныеДанныеФайла<>Неопределено Тогда
		ДвоичныеДанныеФайла.Записать(ПутьКРезервномуФайлу);
	Конецесли;	
	
КонецПроцедуры

&НаКлиенте
