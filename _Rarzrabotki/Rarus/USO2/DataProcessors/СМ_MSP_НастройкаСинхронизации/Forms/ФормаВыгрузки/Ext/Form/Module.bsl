КонецПроцедуры

&НаСервере
Функция ВыгрузитьВMSPНаСервере(ДвоичныеДанныеФайла,МассивЗначений,Позиции)
	
	ВТДеревоПроекта = РеквизитФормыВЗначение("ЗадачиПроекта");
	ВТДеревоСмет = РеквизитФормыВЗначение("ДеревоСмет");
	
	ТЗ=Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("GUID");
	ТЗ.Колонки.Добавить("Объем");
	ТЗ.Колонки.Добавить("Единица");
	ТЗ.Колонки.Добавить("Выгружено");		
	
	СтрокиПроекта=ВТДеревоПроекта.Строки.НайтиСтроки(Новый Структура("Действие","Замещать"),Истина);
	Для Каждого Эл Из  СтрокиПроекта Цикл
		Стр=ТЗ.Добавить();
		Стр.GUID=Эл.MSP_GUID;
		Стр.Объем=Эл.ОбъемДляВыгрузки;
		Стр.Единица=Эл.ЕдиницаСметы;
		
		Строки=ВТДеревоСмет.Строки.НайтиСтроки(Новый Структура("НомерВПроекте",Эл.НомерДляСопоставления),Истина);
		Для Каждого Пос Из Строки Цикл
			Позиции.Добавить(Пос.Ссылка);
		КонецЦикла;
		
	КонецЦикла;
	
	СтрокиПроекта=ВТДеревоПроекта.Строки.НайтиСтроки(Новый Структура("Действие","Добавлять"),Истина);
	Для Каждого Эл Из  СтрокиПроекта Цикл
		Стр=ТЗ.Добавить();
		Стр.GUID=Эл.MSP_GUID;
		Стр.Объем=Эл.ОбъемДляВыгрузки;
		Стр.Единица=Эл.ЕдиницаСметы;
		
		Строки=ВТДеревоСмет.Строки.НайтиСтроки(Новый Структура("НомерВПроекте",Эл.НомерДляСопоставления),Истина);
		Для Каждого Пос Из Строки Цикл
			Позиции.Добавить(Пос.Ссылка);
		КонецЦикла;

	КонецЦикла;
	
	Если Не Объект.ОбработкаMSPНаКлиенте Тогда
	Если СделатьРезервнуюКопиюПередВыгрузкой Тогда
		ДвоичныеДанныеФайла=Новый ДвоичныеДанные(Смета.Стройка.ПутьПроектMSP);
	КонецЕсли;
	Если СМ_MSP_ВызовСервера.ЗаписатьФайлОбъекта(Смета.Стройка,ТЗ) Тогда
		 ЗаписатьСтатусыПозицийНаСервере(Позиции);
	 КонецЕсли;
	 Возврат Истина;
 Иначе
	 МассивЗначений=ТабЗначВМассив(ТЗ);
	 Возврат Ложь;
 КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаписатьСтатусыПозицийНаСервере(Позиции)
		Для Каждого Пос Из Позиции Цикл
			Запись=РегистрыСведений.СМ_MSP_СтатусыВыгрузкиДокументов.СоздатьМенеджерЗаписи();
			Запись.Документ=Пос;
			Запись.Статус=Перечисления.СМ_MSP_СтатусыВыгрузкиДокументов.Выгружен;
			Запись.Записать();
		КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТабЗначВМассив(ТаблицаЗначений)
	
	НашМассив = Новый Массив;
    Для Каждого СтрокаТаблицы из ТаблицаЗначений Цикл
        НашаСтруктура = Новый Структура;
        Счетчик = 0;
        Для Каждого СтрокаСтруктуры из СтрокаТаблицы Цикл
            Если НЕ ТипЗнч(СтрокаСтруктуры) = Тип(ТаблицаЗначений) тогда
                НашаСтруктура.Вставить(ТаблицаЗначений.Колонки[Счетчик].Имя,СтрокаТаблицы[Счетчик]);
            Иначе
                НашаСтруктура.Вставить(ТаблицаЗначений.Колонки[Счетчик].Имя,ТабЗначВМассив(СтрокаСтруктуры));
            КонецЕсли;
            Счетчик = Счетчик + 1;
        КонецЦикла;
        НашМассив.Добавить(НашаСтруктура);
    КонецЦикла;
    Возврат(НашМассив);
	
КонецФункции

&НаСервере
Процедура ИзменитьОбъемНаСервере(СтрокиПроекта)
	
	Для Каждого ТекПроект Из  СтрокиПроекта Цикл
		Проект=ЗадачиПроекта.НайтиПоИдентификатору(ТекПроект);
		РасчитатьОбъем(Проект);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура РасчитатьОбъем(Проект)
	
	Если Проект.Действие="Не изменять" Тогда
		Проект.ОбъемДляВыгрузки=Проект.MSP_Объем;
	ИначеЕсли Проект.Действие="Добавлять" Тогда
		Проект.ОбъемДляВыгрузки=Проект.MSP_Объем+Проект.ОбъемСметы;
	Иначе
		Проект.ОбъемДляВыгрузки=Проект.ОбъемСметы;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДействиеНаСервере(Действие,НовоеДействие)
	
	ТЗ = ДанныеФормыВЗначение(ЗадачиПроекта, Тип("ДеревоЗначений"));
	СтрокиПроекта=ТЗ.Строки.НайтиСтроки(Новый Структура("Действие",Действие),Истина);
	Для Каждого СтрокаПроекта Из СтрокиПроекта Цикл
		СтрокаПроекта.Действие=НовоеДействие;
		РасчитатьОбъем(СтрокаПроекта);
	КонецЦикла;
	ЗначениеВДанныеФормы(ТЗ, ЗадачиПроекта);
	
КонецПроцедуры

