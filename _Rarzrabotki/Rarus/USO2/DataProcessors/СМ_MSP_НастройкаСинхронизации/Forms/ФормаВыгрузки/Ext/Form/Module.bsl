&НаСервере
Функция УстановитьЭлементОформления(НазваниеПараметра, ЗначениеПараметра, Таблица)
	ЭлементУсловногоОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементУсловногоОформления.Оформление.УстановитьЗначениеПараметра(НазваниеПараметра, ЗначениеПараметра);
	Для Каждого Колонка ИЗ Элементы[Таблица].ПодчиненныеЭлементы Цикл
		Если ТипЗнч(Колонка)=Тип("ГруппаФормы") Тогда
			Для Каждого КолонкаВл ИЗ Колонка.ПодчиненныеЭлементы Цикл
				ОформляемоеПоле      = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(КолонкаВл.Имя);
			КонецЦикла;
		Иначе
			ОформляемоеПоле      = ЭлементУсловногоОформления.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЭлементУсловногоОформления;
КонецФункции

&НаСервере
Процедура ЗаполнитьСерверВФоне(МассивЗначений,ФоновоеЗадание)
	
	ВРДерево = РеквизитФормыВЗначение("ДеревоСмет"); 
	ТЗ = ДанныеФормыВЗначение(ЗадачиПроекта, Тип("ДеревоЗначений"));



	Данные=новый Структура;
	Данные.Вставить("ВРДерево",ВРДерево);
	Данные.Вставить("ТЗ",ТЗ);
	Данные.Вставить("ТЗСопоставлений",ДанныеФормыВЗначение(ТаблицаСопоставлений, Тип("ТаблицаЗначений")));
	Данные.Вставить("СоответствиеКолонокДопРеквизитов",ДанныеФормыВЗначение(СоответствиеКолонокДопРеквизитов, Тип("ТаблицаЗначений")));
	Данные.Вставить("МассивЗначений",МассивЗначений);
	Данные.Вставить("СинхронизироватьПоДополнительнымРеквизитам",Объект.СинхронизироватьПоДополнительнымРеквизитам);
	Данные.Вставить("ОбСтроительства",ОбъектСтроительства.Наименование);
	Данные.Вставить("Смета",Смета);
	Данные.Вставить("НаименованиеПроекта",НаименованиеПроекта);
	Данные.Вставить("Настройки",Объект.Настройки);

	
	//Адрес="";
	//Обработки.СМ_MSP_НастройкаСинхронизации.ЗаполнитьСерверВФоне(Данные,Адрес);	
	РезультатФоновогоЗадания = ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
	"Обработки.СМ_MSP_НастройкаСинхронизации.ЗаполнитьСерверВФоне",
	Данные, 
	НСтр("ru = 'Синхронизация с MSP'"));
	
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		ФоновоеЗаданиеАдресХранилища = РезультатФоновогоЗадания.АдресХранилища;
		ЗаверешениеФоновогоЗадания();
	    
	Иначе
		ФоновоеЗадание = Истина;
		ФоновоеЗаданиеИдентификатор  = РезультатФоновогоЗадания.ИдентификаторЗадания;
		ФоновоеЗаданиеАдресХранилища = РезультатФоновогоЗадания.АдресХранилища;
	КонецЕсли;
 
КонецПроцедуры

&НаСервере
Процедура ЗаверешениеФоновогоЗадания()
		Данные = ПолучитьИзВременногоХранилища(ФоновоеЗаданиеАдресХранилища);
		ЗначениеВРеквизитФормы(Данные.ВРДерево, "ДеревоСмет");
