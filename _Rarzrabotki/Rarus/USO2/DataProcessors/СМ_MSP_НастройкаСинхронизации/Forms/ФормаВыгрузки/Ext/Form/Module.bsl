&НаСервере
Процедура СоздатьТаблицу(ТЗ,Источник)
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("ДокументСсылка.СМ_ЛокальнаяСмета"));
	МассивТипов.Добавить(Тип("ДокументСсылка.СМ_РазделЛокальнойСметы"));
	МассивТипов.Добавить(Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы"));
	МассивТипов.Добавить(Тип("Строка"));
	
	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов, , );
	
	Для Каждого Колонка Из Источник.Колонки Цикл
		ТЗ.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстКомментария(Ид)
	СтрокаСметы=ДеревоСмет.НайтиПоИдентификатору(Ид);	
	Текст="";
	
	ТЗСопоставлений=ДанныеФормыВЗначение(ТаблицаСопоставлений, Тип("ТаблицаЗначений"));
	
	
	СтрокиСоответствия=ТЗСопоставлений.НайтиСтроки(Новый Структура("КодРаботы",СтрокаСметы.Шифр));
	
	Если СтрокиСоответствия.Количество()=0 Тогда
		
		Текст="Для кода позиции "+СтрокаСметы.Шифр+" не задано соответствие";
	Иначе
		ТипНСНеЗадан=Истина;
		Текст3="";
		ТИпНС=Строка(СтрокаСметы.ТипНормативногоСборника);
		Для Каждого Эл Из  СтрокиСоответствия Цикл
			Если  Эл.ТипНормативногоСборника=ТИпНС Тогда
				ТипНСНеЗадан=Ложь;
			Иначе
				Текст3=Текст3+Эл.ТипНормативногоСборника+Символы.ПС;
			Конецесли;	 
		КонецЦикла;
		Если ТипНСНеЗадан Тогда
			Текст=Текст+"Тип нормативного сборника: " +ТИпНС+Символы.ПС;
			Текст=Текст+"Есть соответствие шифра только для:"+ Текст3;	
			
		КонецЕсли;
		
		
		Если Объект.СинхронизироватьПоДополнительнымРеквизитам Тогда
			Для Каждого Кол Из СоответствиеКолонокДопРеквизитов Цикл
				если Кол.Используется Тогда
					РеквНеЗадан=Истина;
					Текст2="";
					Для Каждого Эл Из  СтрокиСоответствия Цикл
						Если  Эл["П"+Кол.ИмяКолонки]=СтрокаСметы["Д"+Кол.ИмяКолонки] Тогда
							РеквНеЗадан=Ложь;
						Иначе
							Текст2=Текст2+Эл["П"+Кол.ИмяКолонки];
							Текст2=Текст2+Символы.ПС;
						Конецесли;	 
					КонецЦикла;
					
					Если РеквНеЗадан Тогда
						Текст=Текст+"Значение "+Кол.Заголовок+": " +СтрокаСметы["Д"+Кол.ИмяКолонки]+Символы.ПС;
						Текст=Текст+"Есть соответствие шифра только для:"+ Текст2+Символы.ПС;	
						
					КонецЕсли;
					
				Конецесли;
			КонецЦикла;
		Конецесли;
	Конецесли;
	Возврат Текст;	
КонецФункции

