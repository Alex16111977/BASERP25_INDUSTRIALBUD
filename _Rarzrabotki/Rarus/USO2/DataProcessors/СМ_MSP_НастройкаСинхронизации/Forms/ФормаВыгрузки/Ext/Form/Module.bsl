	ОткрытьФорму("Обработка.СМ_MSP_НастройкаСинхронизации.Форма.ФормаОтчеты",ПараметрыФормы,ЭтаФорма);
	
	//Для Каждого Эл Из СформироватьОтчет() Цикл
	//	Эл.ТД.Показать(Эл.Заголовок);
	//КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НеСопоставленныеВПроекте(Команда)
	Отбор.ТолькоНеСопоставленныеВПроекте=Истина;
	УстановитьУсловноеОформление();
КонецПроцедуры

&НаКлиенте
Процедура НеСопоставленныеВСмете(Команда)
	Отбор.ТолькоНеСопоставленныеВСмете=Истина;
	УстановитьУсловноеОформление();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеСметы(Команда)
	
	ФоновоеЗадание = Ложь;
	Если НЕ ФормаИндикатор.Открыта() Тогда
		ФормаИндикатор=ОткрытьФорму("Обработка.СМ_MSP_НастройкаСинхронизации.Форма.ФормаИндикатор",Новый Структура("Текст","Загрузка данных проекта из MS Project"),ЭтаФорма,,ВариантОткрытияокна.ОтдельноеОкно,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;	
	
	ФормаИндикатор.Элементы.Прогресс.МаксимальноеЗначение=100;
	ФормаИндикатор.Прогресс=5;
	ФормаИндикатор.Элементы.Текст.Заголовок="Обновление данных сопоставления";
	ФормаИндикатор.ОбновитьОтображениеДанных();
	ЗаполнитьСерверВФоне(Неопределено,ФоновоеЗадание);
	Если ФоновоеЗадание Тогда
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеЗагрузка", 1, Истина);
		ПараметрыОбработчика.МаксимальныйИнтервал = 5;
	Иначе
		ФормаИндикатор.Закрыть();
	КонецЕсли;

	//ЗаполнитьСервер(Неопределено,Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПоискВПроекте(Команда)
	
	Отбор.ТолькоНеСопоставленныеВПроекте=Ложь;
	Отбор.ПоказыватьВПроекте=-1;
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПоискВСмете(Команда)
	
	Отбор.ТолькоНеСопоставленныеВСмете=Ложь;
	Отбор.ПоказыватьВСмете=-1;
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВПроекте(Команда)
	
	Если Элементы.ДеревоСмет.ТекущаяСтрока<>Неопределено Тогда
		Отбор.ПоказыватьВПроекте=Элементы.ДеревоСмет.ТекущиеДанные.НомерВПроекте;
	КонецЕсли;
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВСмете(Команда)
	
	Если Элементы.ЗадачиПроекта.ТекущаяСтрока<>Неопределено Тогда
		Отбор.ПоказыватьВСмете=Элементы.ЗадачиПроекта.ТекущиеДанные.НомерДляСопоставления;
	КонецЕсли;
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьMSP(Команда)
	
	ЭлементыДерева = ЗадачиПроекта.ПолучитьЭлементы();
    Для каждого ЭлементДерева Из ЭлементыДерева Цикл
        Элементы.ЗадачиПроекта.Развернуть(ЭлементДерева.ПолучитьИдентификатор(),Истина);
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьНС(Команда)
	
	ЭлементыДерева = ДеревоСмет.ПолучитьЭлементы();
    Для каждого ЭлементДерева Из ЭлементыДерева Цикл
        Элементы.ДеревоСмет.Развернуть(ЭлементДерева.ПолучитьИдентификатор(),Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьMSP(Команда)
	
	ЭлементыДерева = ЗадачиПроекта.ПолучитьЭлементы();
    Для каждого ЭлементДерева Из ЭлементыДерева Цикл
        Элементы.ЗадачиПроекта.Свернуть(ЭлементДерева.ПолучитьИдентификатор());
    КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СвернутьНС(Команда)
	
	ЭлементыДерева = ДеревоСмет.ПолучитьЭлементы();
    Для каждого ЭлементДерева Из ЭлементыДерева Цикл
        Элементы.ДеревоСмет.Свернуть(ЭлементДерева.ПолучитьИдентификатор());
