			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(Колонка.Имя);
		КонецЦикла;
		ЭлементУсловия                = ЭлементУсловногоОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ЗадачиПроекта.НомерДляСопоставления");				 
		ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеВСписке;
		ЭлементУсловия.ПравоеЗначение = СписокСсылок;
		ЭлементУсловия.Использование  = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

