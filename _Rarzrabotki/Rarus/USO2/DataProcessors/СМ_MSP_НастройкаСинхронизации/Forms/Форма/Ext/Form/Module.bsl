&НаСервере
Процедура ЗаполнитьТаблицуПоДереву(ВТДерево, ВТТаблица, ТабРодитель,ЭтоПроект=Истина,НаименованиеРодителя="")
	Для Каждого Стр Из ВТДерево.Строки Цикл
		Если Стр.ВСоответствии Тогда
			НоваяСтрока = ВТТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока ,Стр);
			НоваяСтрока.Родитель=ТабРодитель;
			НоваяСтрока.НаименованиеРодителя=НаименованиеРодителя;
		КонецЕсли;
		Если Стр.Строки.Количество()>0 Тогда
			Если ЭтоПроект тогда
				ЗаполнитьТаблицуПоДереву(Стр, ВТТаблица, Стр.MSP_НаименованиеОбъекта,ЭтоПроект,Стр.MSP_НаименованиеОбъекта);
			Иначе
				ЗаполнитьТаблицуПоДереву(Стр, ВТТаблица, Стр.Ссылка,ЭтоПроект,Стр.Наименование);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСоответствие(Команда)
	СохранитьСоответствиеНаСервере();
	ТребуетсяСохранение=Ложь;
КонецПроцедуры

&НаСервере
Процедура ПроверитьУзлы(НеВыводитьСтроку,ТЗ,МасСтр,НаименованиеПоля)
	Для Каждого Эл Из МасСтр Цикл
		Если ТЗ.НайтиСтроки(Новый Структура(НаименованиеПоля,Эл.НомерДляСопоставления)).Количество()=0 Тогда
			НеВыводитьСтроку=Ложь;
			Возврат;
		Конецесли;
		ПроверитьУзлы(НеВыводитьСтроку,ТЗ,Эл.Строки,НаименованиеПоля);
		Если НеВыводитьСтроку=Ложь Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура НайтиВДереве(Дерево,СписокДляВывода,СтрокаПоиска,Колонки)
	Для Каждого Эл Из Дерево.Строки Цикл
		Для Каждого Кол Из Колонки Цикл
			Если  Кол.Имя="Ссылка" Тогда Продолжить; Конецесли;
			Если Найти(НРег(Строка(Эл[Кол.Имя])),СтрокаПоиска)>0 Тогда
				СписокДляВывода.Добавить(Эл.НомерДляСопоставления);
				РодительЭл=Эл.Родитель;
				Пока ЗначениеЗаполнено(РодительЭл) Цикл
					СписокДляВывода.Добавить(РодительЭл.НомерДляСопоставления);
					РодительЭл=РодительЭл.Родитель;
				КонецЦикла;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		НайтиВДереве(Эл,СписокДляВывода,СтрокаПоиска,Колонки);
		
	КонецЦикла;
КонецПроцедуры

