	Если Элементы.ДеревоНС.ТекущиеДанные<>Неопределено Тогда
		СтандартнаяОбработка=Ложь;
		ТекСтр=Элементы.ДеревоНС.ТекущиеДанные.Ссылка;
		Если ТипЗнч(ТекСтр)=Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда 
			ОткрытьФорму("Справочник.СМ_НормативныеСборники.Форма.ФормаЭлементаУправляемая",Новый Структура("Ключ",ТекСтр));
		КонецЕсли;
	КонецЕсли;

