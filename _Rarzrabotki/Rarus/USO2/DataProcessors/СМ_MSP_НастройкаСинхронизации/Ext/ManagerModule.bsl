
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Процедура заполняет таблицу соответствия проектов/задач/ресурсов сметным данным.
//
// Параметры:
//		Данные 			- Структура - структура переданных данных.
// 		АдресХранилища 	- Строка - Адрес во временном хранилище. 
//
Процедура ЗаполнитьСерверВФоне(Данные, АдресХранилища) Экспорт
	
	ВРДерево = Данные.ВРДерево; 
	ТЗ = Данные.ТЗ;
	ТЗСопоставлений=Данные.ТЗСопоставлений;
	МассивЗначений=Данные.МассивЗначений;
	СинхронизироватьПоДополнительнымРеквизитам=Данные.СинхронизироватьПоДополнительнымРеквизитам;
	ОбСтроительства=Данные.ОбСтроительства;
	СоответствиеКолонокДопРеквизитов=Данные.СоответствиеКолонокДопРеквизитов;
	НаименованиеПроекта=Данные.НаименованиеПроекта;
	
	ДлительныеОперации.СообщитьПрогресс(20);
	ЗаполнитьТаблицыПоДаннымНастройки(ТЗСопоставлений,Данные.Настройки,СоответствиеКолонокДопРеквизитов);
	
	ДлительныеОперации.СообщитьПрогресс(25);
	СформироватьДеревоСметСервер(ВРДерево,Данные.Смета,СинхронизироватьПоДополнительнымРеквизитам,СоответствиеКолонокДопРеквизитов);
	
	Если МассивЗначений<>Неопределено Тогда
		Для Каждого Эл Из МассивЗначений Цикл
			Если Эл.НомерРодителя=0 Тогда
				СтрокаТЗ=ТЗ.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЗ,Эл);
			Иначе
				СтрокиДерева=ТЗ.Строки.НайтиСтроки(Новый Структура("НомерДляСопоставления",Эл.НомерРодителя),Истина);
				Если СтрокиДерева.Количество()>0 Тогда
					СтрокаТЗ=СтрокиДерева[0].Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТЗ,Эл);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	ДлительныеОперации.СообщитьПрогресс(40);
	
	СтрокиПроекта=ТЗ.Строки.НайтиСтроки(Новый Структура("MSP_ВидОбъекта","Ресурс"),Истина);
	СтруктураПоиска=Новый Структура;
	СтруктураПоиска.Вставить("Ресурс","");
	СтруктураПоиска.Вставить("Задача","");
	СтруктураПоиска.Вставить("Проект",НаименованиеПроекта);
	СтруктураПоиска.Вставить("ОбъектСтроительства",ОбСтроительства);
	СтруктураПоискаПоСоответствию=новый Структура;
	//СтруктураПоискаПоСоответствию.Вставить("Наименование","");
	СтруктураПоискаПоСоответствию.Вставить("Шифр","");
	Если СинхронизироватьПоДополнительнымРеквизитам ТОгда
		Для Каждого Кол Из СоответствиеКолонокДопРеквизитов Цикл
			Если Кол.Используется Тогда
				СтруктураПоиска.Вставить("П"+Кол.ИмяКолонки,"");
				СтруктураПоискаПоСоответствию.Вставить("Д"+Кол.ИмяКолонки,"");
			Конецесли;
		КонецЦикла;
	Конецесли;	
	
	СтруктураПоискаПоСоответствию.Вставить("ВСоответствии",Ложь);
	
	ВРСоотв=ТЗСопоставлений.Скопировать();
	СтрокиСоответствия=Новый Массив;
	Прогресс=40; СчетчикПрогресса=0;
	КоэфСтрок=50/СтрокиПроекта.Количество();
	Для Каждого Эл Из  СтрокиПроекта Цикл
		СчетчикПрогресса=СчетчикПрогресса+1;
		ДлительныеОперации.СообщитьПрогресс(40+СчетчикПрогресса*КоэфСтрок);	
		Для НомерПрохода=1 По 3 Цикл
			Прогресс=Прогресс+10;
			
			Если НомерПрохода =2 Тогда
				СтруктураПоиска.Вставить("Проект","");
				СтруктураПоиска.Вставить("ОбъектСтроительства","");
				Для Каждого ЭлДляУдаления Из  СтрокиСоответствия Цикл
					ВРСоотв.Удалить(ЭлДляУдаления);
				КонецЦикла;
				
			ИначеЕсли НомерПрохода =3 Тогда
				СтруктураПоиска.Удалить("Проект");
				СтруктураПоиска.Удалить("ОбъектСтроительства");
				Для Каждого ЭлДляУдаления Из  СтрокиСоответствия Цикл
					ВРСоотв.Удалить(ЭлДляУдаления);
				КонецЦикла;
				
			КонецЕсли;
			
			СтруктураПоиска.Ресурс=Эл.MSP_НаименованиеОбъекта;
			СтруктураПоиска.Задача=Эл.Родитель.MSP_НаименованиеОбъекта;
			Если СинхронизироватьПоДополнительнымРеквизитам Тогда
				Для Каждого Кол Из СоответствиеКолонокДопРеквизитов Цикл
					если Кол.Используется Тогда
						СтруктураПоиска["П"+Кол.ИмяКолонки]=Эл[Кол.ИмяКолонки];
						СтруктураПоискаПоСоответствию["Д"+Кол.ИмяКолонки]=Эл[Кол.ИмяКолонки];
					Конецесли;
				КонецЦикла;
			Конецесли;
			
			СтрокиСоответствия=ВРСоотв.НайтиСтроки(СтруктураПоиска);
			Для Каждого ЭлСоотв Из  СтрокиСоответствия Цикл
				
				//СтруктураПоискаПоСоответствию.Наименование=ЭлСоотв.Работа;
				СтруктураПоискаПоСоответствию.Шифр=ЭлСоотв.КодРаботы;
				СтрокиСметы=ВРДерево.Строки.НайтиСтроки(СтруктураПоискаПоСоответствию,Истина);
				Для Каждого СтрокаСметы Из СтрокиСметы Цикл
					Если  Строка(СтрокаСметы.ТипНормативногоСборника)=СокрЛП(ЭлСоотв.ТипНормативногоСборника) Тогда
						СтрокаСметы.ВСоответствии=Истина;
						Эл.ВСоответствии=Истина;
						СтрокаСметы.НомерВПроекте=Эл.НомерДляСопоставления;
						Эл.ОбъемДляВыгрузки=Эл.ОбъемДляВыгрузки+СтрокаСметы.Объем;
						Эл.ОбъемСметы=Эл.ОбъемДляВыгрузки;
						Эл.Действие="Замещать";
						Эл.ЕдиницаСметы=СтрокаСметы.ЕдиницаИзмеренияРесурса+".";
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	СтрокиСметы=ВРДерево.Строки.НайтиСтроки(Новый Структура("ВСоответствии",Ложь),Истина);
	Для Каждого СтрокаСметы Из СтрокиСметы Цикл
		СтрокаСметы.ПоказыватьВНесопоставленных=Истина;
		РодительСтроки=СтрокаСметы.Родитель;
		Пока РодительСтроки<>Неопределено Цикл
			РодительСтроки.ПоказыватьВНесопоставленных=Истина;	
			РодительСтроки=РодительСтроки.Родитель;
		КонецЦикла;	
		Если Не СтрокаСметы.ЕстьВложенныеЗадачи Тогда
			СтрокаСметы.КомментСсылка="Открыть";
		КонецЕсли;	
	КонецЦикла;
	
	СтрокиПроекта=ТЗ.Строки.НайтиСтроки(Новый Структура("Действие",""),Истина);
	Для Каждого СтрокаПроекта Из СтрокиПроекта Цикл
		СтрокаПроекта.Действие="Не изменять";
		Если  СтрокаПроекта.MSP_ВидОбъекта="Ресурс" Тогда
			СтрокаПроекта.ПоказыватьВНесопоставленных=Истина;
			РодительСтроки=СтрокаПроекта.Родитель;
			Пока РодительСтроки<>Неопределено Цикл
				РодительСтроки.ПоказыватьВНесопоставленных=Истина;	
				РодительСтроки=РодительСтроки.Родитель;
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;
	
	Структура = Новый Структура("ВРДерево,ТЗ,ТЗСопоставлений",ВРДерево,ТЗ,ТЗСопоставлений);
	АдресХранилища = ПоместитьВоВременноеХранилище(Структура, АдресХранилища);
	
КонецПроцедуры

// Процедура заполняет таблицу соответствия проектов/задач/ресурсов сметным данным.
//
// Параметры:
//		Данные 			- Структура - структура переданных данных.
// 		АдресХранилища 	- Строка - Адрес во временном хранилище. 
//
Процедура ЗаполнитьСерверВФонеСопоставление(Данные, АдресХранилища) Экспорт

	ВРДерево = Данные.ВРДерево; 
	ТЗ = Данные.ТЗ;
	ТЗСоотв=Данные.ТЗСоотв;
	ТЗСопоставлений=Данные.ТЗСопоставлений;
	МассивЗначения=Данные.МассивЗначений;
	ОбСтроительства=Данные.ОбСтроительства;
	СинхронизироватьПоДополнительнымРеквизитам=Данные.СинхронизироватьПоДополнительнымРеквизитам;
	СоответствиеКолонокДопРеквизитов=Данные.СоответствиеКолонокДопРеквизитов;	
	НаименованиеПроекта=Данные.НаименованиеПроекта;
	
	СформироватьДеревоСметСерверСопоставление(ВРДерево);
	ТЗ.Строки.Очистить();	
	ДлительныеОперации.СообщитьПрогресс(10);
	Если  МассивЗначения<>Неопределено Тогда
		Для Каждого Эл Из МассивЗначения Цикл
			Если Эл.НомерРодителя=0 Тогда
				СтрокаТЗ=ТЗ.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаТЗ,Эл);
			Иначе
				СтрокиДерева=ТЗ.Строки.НайтиСтроки(Новый Структура("НомерДляСопоставления",Эл.НомерРодителя),Истина);
				Если СтрокиДерева.Количество()>0 Тогда
					СтрокаТЗ=СтрокиДерева[0].Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаТЗ,Эл);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	ДлительныеОперации.СообщитьПрогресс(20);
	СтрокиПроекта=ТЗ.Строки.НайтиСтроки(Новый Структура("MSP_ВидОбъекта","Ресурс"),Истина);
	СтруктураПоиска=Новый Структура;
	СтруктураПоиска.Вставить("Ресурс","");
	СтруктураПоиска.Вставить("Задача","");
	СтруктураПоиска.Вставить("Проект",НаименованиеПроекта);
	СтруктураПоиска.Вставить("ОбъектСтроительства",ОбСтроительства);
	Если СинхронизироватьПоДополнительнымРеквизитам ТОгда
		Для Каждого Кол Из СоответствиеКолонокДопРеквизитов Цикл
			Если Кол.Используется тогда
			СтруктураПоиска.Вставить("П"+Кол.ИмяКолонки,"");
			Конецесли;
		КонецЦикла;
	Конецесли;	
	
	СтруктураПоискаПоСоответствию=новый Структура;
	СтруктураПоискаПоСоответствию.Вставить("Наименование","");
	СтруктураПоискаПоСоответствию.Вставить("Шифр","");
	СтруктураПоискаПоСоответствию.Вставить("ВСоответствии",Ложь);
	
	ВРСоотв=ТЗСопоставлений.Скопировать();
	СтрокиСоответствия=Новый Массив;
	СчетчикПрогресса=0;
	КоэфСтрок=80/СтрокиПроекта.Количество();
	
	Для Каждого Эл Из  СтрокиПроекта Цикл
		СчетчикПрогресса=СчетчикПрогресса+1;
		ДлительныеОперации.СообщитьПрогресс(20+СчетчикПрогресса*КоэфСтрок);	
		
		Для НомерПрохода=1 По 3 Цикл
			Если НомерПрохода =2 Тогда
				СтруктураПоиска.Вставить("Проект","");
				СтруктураПоиска.Вставить("ОбъектСтроительства","");
				Для Каждого ЭлДляУдаления Из  СтрокиСоответствия Цикл
					ВРСоотв.Удалить(ЭлДляУдаления);
				КонецЦикла;
				
			ИначеЕсли НомерПрохода =3 Тогда
				СтруктураПоиска.Удалить("Проект");
				СтруктураПоиска.Удалить("ОбъектСтроительства");
				Для Каждого ЭлДляУдаления Из  СтрокиСоответствия Цикл
					ВРСоотв.Удалить(ЭлДляУдаления);
				КонецЦикла;
				
			КонецЕсли;
			
			СтруктураПоиска.Ресурс=Эл.MSP_НаименованиеОбъекта;
			СтруктураПоиска.Задача=Эл.Родитель.MSP_НаименованиеОбъекта;
			Если СинхронизироватьПоДополнительнымРеквизитам Тогда
				Для Каждого Кол Из СоответствиеКолонокДопРеквизитов Цикл
					Если Кол.Используется тогда
					СтруктураПоиска["П"+Кол.ИмяКолонки]=Эл[Кол.ИмяКолонки];
					КонецЕсли;
				КонецЦикла;
			Конецесли;
			
			СтрокиСоответствия=ВРСоотв.НайтиСтроки(СтруктураПоиска);
			
			Для Каждого ЭлСоотв Из  СтрокиСоответствия Цикл
				
				СтруктураПоискаПоСоответствию.Наименование=ЭлСоотв.Работа;
				СтруктураПоискаПоСоответствию.Шифр=ЭлСоотв.КодРаботы;
				
				
				СтрокиСметы=ВРДерево.Строки.НайтиСтроки(СтруктураПоискаПоСоответствию,Истина);
				Для Каждого СтрокаСметы Из СтрокиСметы Цикл
					Если  Строка(СтрокаСметы.ТипНормативногоСборника)=СокрЛП(ЭлСоотв.ТипНормативногоСборника) Тогда
						СтрокаСметы.ВСоответствии=Истина;
						Эл.ВСоответствии=Истина;
						СтрСоотв=ТЗСоотв.Добавить();
						СтрСоотв.НомерВПроекте=Эл.НомерДляСопоставления;
						СтрСоотв.НомерВНС=СтрокаСметы.НомерДляСопоставления;
						СтрСоотв.НомерСтрокиСопоставления=ЭлСоотв.Номер;
					КонецЕсли;
				КонецЦикла;
				
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
	Структура = Новый Структура("ВРДерево,ТЗ,ТЗСопоставлений,ТЗСоотв",ВРДерево,ТЗ,ТЗСопоставлений,ТЗСоотв);
	АдресХранилища = ПоместитьВоВременноеХранилище(Структура, АдресХранилища);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьДеревоСметСервер(ВРДерево,Смета,СинхронизироватьПоДополнительнымРеквизитам = Истина,СоответствиеКолонокДопРеквизитов)
	
	Т1=""; Т2="";
	Запрос=Новый Запрос;
	Если   СинхронизироватьПоДополнительнымРеквизитам Тогда
		Набор=Справочники.НаборыДополнительныхРеквизитовИСведений["Документ_СМ_ПозицияЛокальнойСметы"];
		Ном=1;
		
		Для Каждого Рекв Из Набор.ДополнительныеРеквизиты Цикл
			ИмяКолонки="Колонка"+СтрЗаменить(Ном,Символы.НПП,"");
			Т1=Т1+",Т"+ИмяКолонки+".Значение КАК Д"+ИмяКолонки;
			Т2=Т2+" ЛЕВОЕ СОЕДИНЕНИЕ ВТДоп КАК Т"+ИмяКолонки+" ПО 
			|ВТ.Ссылка=Т"+ИмяКолонки+".Ссылка  И Т"+ИмяКолонки+".Свойство=&Д"+ИмяКолонки;
			Запрос.УстановитьПараметр("Д"+ИмяКолонки,Рекв.Свойство);
			Ном=Ном+1;
		КонецЦикла;
	КонецЕсли;
	
	Запрос.Текст="ВЫБРАТЬ
	|	СМ_ЛокальнаяСмета.Ссылка
	|ПОМЕСТИТЬ ЛокальныеСметы
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|ГДЕ
	|	СМ_ЛокальнаяСмета.Ссылка В (&Смета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СМ_РазделЛокальнойСметы.Ссылка
	|ПОМЕСТИТЬ Разделы
	|ИЗ
	|	Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЛокальныеСметы КАК ЛокальныеСметы
	|		ПО СМ_РазделЛокальнойСметы.ИДСметы = ЛокальныеСметы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СМ_ПозицияЛокальнойСметы.Ссылка,
	|	СМ_ПозицияЛокальнойСметы.ИДРодителя,
	|	СМ_ПозицияЛокальнойСметы.ИДСметы,
	|	СМ_ПозицияЛокальнойСметы.ЕдиницаИзмерения,
	|	СМ_ПозицияЛокальнойСметы.ОбъемРабот,
	|	СМ_ПозицияЛокальнойСметы.ШифрРасценки КАК Шифр,
	|	СМ_ПозицияЛокальнойСметы.ТипНормативныхСборников,СМ_ПозицияЛокальнойСметы.ПорНомер,
	|	ЕСТЬNULL(СМ_MSP_СтатусыВыгрузкиДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СМ_MSP_СтатусыВыгрузкиДокументов.НеВыгружен)) КАК Статус
	|ПОМЕСТИТЬ ВТПозиции
	|ИЗ
