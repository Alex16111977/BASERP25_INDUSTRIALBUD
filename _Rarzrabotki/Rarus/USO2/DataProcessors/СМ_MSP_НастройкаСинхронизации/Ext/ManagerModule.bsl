	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЛокальныеСметы КАК ЛокальныеСметы
	|		ПО СМ_ЛокальнаяСметаДополнительныеРеквизиты.Ссылка = ЛокальныеСметы.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СМ_РазделЛокальнойСметы.Ссылка,
	|	СМ_РазделЛокальнойСметы.ИДРодителя,
	|	ВЫРАЗИТЬ(СМ_РазделЛокальнойСметы.Ссылка.НаименованиеДляПечати КАК СТРОКА(500)) КАК Наименование,
	|	""Раздел"" КАК ВидОбъекта,
	|	НЕОПРЕДЕЛЕНО КАК ЕдиницаИзмеренияРесурса,
	|	0 КАК Объем,
	|	"""" КАК Шифр,
	|	ЗНАЧЕНИЕ(Перечисление.СМ_ТипыНормативныхСборников.ПустаяСсылка) КАК ТипНормативногоСборника,
	|	ЗНАЧЕНИЕ(Перечисление.СМ_MSP_СтатусыВыгрузкиДокументов.ПустаяСсылка) КАК Статус,
	|СМ_РазделЛокальнойСметы.ПорНомер
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Разделы КАК Разделы
	|		ПО Разделы.Ссылка = Разделы.Ссылка
	| 
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТПозиции.Ссылка,
	|	ВТПозиции.ИДРодителя,
	|	ВЫРАЗИТЬ(ВТПозиции.Ссылка.Наименование КАК СТРОКА(500)),
	|	""Позиция"",
	|	ВТПозиции.ЕдиницаИзмерения,
	|	ВТПозиции.ОбъемРабот,
	|	ВТПозиции.Шифр,
	|	ВТПозиции.ТипНормативныхСборников,
	|	ВТПозиции.Статус,ПорНомер
	|ИЗ
	|	ВТПозиции КАК ВТПозиции
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЛокальныеСметы.Ссылка,
	|	НЕОПРЕДЕЛЕНО,
	|	ВЫРАЗИТЬ(ЛокальныеСметы.Ссылка.Наименование КАК СТРОКА(500)),
	|	""Смета"",
	|	"""",
	|	0,
	|	"""",
	|	ЗНАЧЕНИЕ(Перечисление.СМ_ТипыНормативныхСборников.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.СМ_MSP_СтатусыВыгрузкиДокументов.ПустаяСсылка),0
	|ИЗ
	|	ЛокальныеСметы КАК ЛокальныеСметы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Ссылка,
	|	ВТ.ИДРодителя,
	|	ВТ.Наименование,
	|	ВТ.ВидОбъекта,
	|	ВТ.ТипНормативногоСборника,
	|	ВТ.Шифр,
	|	ВТ.ЕдиницаИзмеренияРесурса,
	|	ВТ.Статус,
	|	ВТ.Объем "+Т1+"
	|ИЗ
	|	ВТ КАК ВТ " +Т2 +" УПОРЯДОЧИТЬ По ПорНомер";
	Запрос.УстановитьПараметр("Смета",Смета);
	Результат=Запрос.Выполнить().Выгрузить();	
	
	
	
	ВРДерево.Строки.Очистить();
	Номер=1;
	ЗаполнитьДерево(ВРДерево,Результат,Неопределено,Номер,СинхронизироватьПоДополнительнымРеквизитам,СоответствиеКолонокДопРеквизитов);	
	
	
	
КонецПроцедуры

Процедура ЗаполнитьДерево(ВДерево, ВТаблица, ТабРодитель = Неопределено,Номер,СинхронизироватьПоДополнительнымРеквизитам,СоответствиеКолонокДопРеквизитов)
	Строки = ВТаблица.НайтиСтроки(Новый Структура("ИДРодителя", ТабРодитель));
	Для Каждого Стр Из Строки Цикл
		НоваяСтрока = ВДерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		
		Если СинхронизироватьПоДополнительнымРеквизитам ТОгда
			Для Каждого Кол Из СоответствиеКолонокДопРеквизитов Цикл
				Если Кол.Используется Тогда
					Если  НоваяСтрока["Д"+Кол.ИмяКолонки]="" Тогда
						Если  ВДерево<>Неопределено И ТипЗнч(ВДерево)<>Тип("ДеревоЗначений") Тогда
							НоваяСтрока["Д"+Кол.ИмяКолонки]=ВДерево["Д"+Кол.ИмяКолонки];
						КонецЕсли;
					КонецЕсли;
				Конецесли;
			КонецЦикла;
		КонецЕсли;	
		
		НоваяСтрока.НомерДляСопоставления=Номер;
		Если ТипЗнч(ВДерево)<>Тип("ДеревоЗначений") Тогда 
			
			ВДерево.ЕстьВложенныеЗадачи=Истина;
		КонецЕсли;
		
		Номер=Номер+1;                          
		ЗаполнитьДерево(НоваяСтрока, ВТаблица, Стр.Ссылка,Номер,СинхронизироватьПоДополнительнымРеквизитам,СоответствиеКолонокДопРеквизитов);
	КонецЦикла;
КонецПроцедуры

Функция ЗаполнитьТаблицыПоДаннымНастройки(ТаблицаСопоставлений,Настройки,СоответствиеКолонокДопРеквизитов)
	
	Область=Настройки.НайтиТекст("Проект");
	Если Область=Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяЯчейки     = Область.Имя;
	ДлинаИмени     = СтрДлина(ИмяЯчейки);
	ПозицияС     = Найти(ИмяЯчейки,"C");
	СтрокаЗаголовка     = Сред(ИмяЯчейки, 2, ПозицияС-2);
	ПерваяКолонка     = Сред(ИмяЯчейки, ПозицияС+1, ДлинаИмени-ПозицияС);
	
	Область=Настройки.НайтиТекст("Тип нормативного сборника");
	Если Область<>Неопределено Тогда
		ИмяЯчейки     = Область.Имя;
		ДлинаИмени     = СтрДлина(ИмяЯчейки);
		ПозицияС     = Найти(ИмяЯчейки,"C");
		ПоследняяКолонка     =Сред(ИмяЯчейки, ПозицияС+1, ДлинаИмени-ПозицияС);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Настройки.Область(СтрокаЗаголовка, ПерваяКолонка, Настройки.ВысотаТаблицы, ПоследняяКолонка));
	Построитель.Выполнить();
	ТЗ = Построитель.Результат.Выгрузить();	
	ТаблицаСопоставлений.Очистить();
	Для Каждого Колонка Из ТЗ.Колонки Цикл
		Если Колонка.Имя="НаименованиеРаботы" Тогда Колонка.Имя="Работа"; 
		ИначеЕсли Колонка.Имя="НаименованиеРесурса" Тогда Колонка.Имя="РесурсСметы";
		ИначеЕсли Колонка.Имя="НазваниеЗадачи" Тогда Колонка.Имя="Задача";
		ИначеЕсли Колонка.Имя="РесурсПроекта" Тогда Колонка.Имя="Ресурс";	
		ИначеЕсли Колонка.Имя="ПлановыйОбъём_Всего" Тогда Колонка.Имя="ОбъемСметы";	
		ИначеЕсли Колонка.Имя="Трудозатраты" Тогда Колонка.Имя="ОбъемПроекта";
		Иначе 
			ТЗС=ТаблицаСопоставлений;
			Если ТЗС.Колонки.Найти(Колонка.Имя)=Неопределено Тогда
				ИмяДляПоиска=Колонка.Имя;
				Преф="П";
				СтрМас=СоответствиеКолонокДопРеквизитов.НайтиСтроки(Новый Структура("Заголовок",ИмяДляПоиска));
				Если СтрМас.Количество()>0 Тогда
					Колонка.Имя=Преф+СтрМас[0].ИмяКолонки;
				Конецесли;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Эл Из ТЗ Цикл
		Стр=ТаблицаСопоставлений.Добавить();
		ЗаполнитьЗначенияСвойств(Стр,Эл);
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Процедура СформироватьДеревоСметСерверСопоставление(ВРДерево)
	
	Запрос=новый Запрос("ВЫБРАТЬ
	|	СМ_НормативныеСборники.Ссылка,
	|	СМ_НормативныеСборники.Наименование,
	|	СМ_НормативныеСборники.КодНормативнойРасценки КАК Шифр,
	|	СМ_НормативныеСборники.ТипНормативногоСборника,
	|	СМ_НормативныеСборники.Родитель КАК ИДРодителя,
	|	СМ_НормативныеСборники.ЕдиницаИзмерения КАК ЕдиницаИзмеренияРесурса,
	|	0 КАК Объем,
	|	""Задача"" КАК ВидОбъекта
	|ИЗ
	|	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
	|ГДЕ
	|	НЕ СМ_НормативныеСборники.ПометкаУдаления
	|");
	
	
	Результат=Запрос.Выполнить().Выгрузить();	
	
	ВРДерево.Строки.Очистить();
	Номер=1;
	ЗаполнитьДеревоСопоставление(ВРДерево,Результат,Справочники.СМ_НормативныеСборники.ПустаяСсылка(),Номер);	
	
	
	
КонецПроцедуры

Процедура ЗаполнитьДеревоСопоставление(ВДерево, ВТаблица, ТабРодитель = Неопределено,Номер)
	Строки = ВТаблица.НайтиСтроки(Новый Структура("ИДРодителя", ТабРодитель));
	Для Каждого Стр Из Строки Цикл
		НоваяСтрока = ВДерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		НоваяСтрока.НомерДляСопоставления=Номер;
		Если ТипЗнч(ВДерево)<>Тип("ДеревоЗначений") И Стр.ВидОбъекта="Задача" Тогда
			ВДерево.ЕстьВложенныеЗадачи=Истина;
		КонецЕсли;
		Номер=Номер+1;                          
		ЗаполнитьДеревоСопоставление(НоваяСтрока, ВТаблица, Стр.Ссылка,Номер);
	КонецЦикла;
КонецПроцедуры

