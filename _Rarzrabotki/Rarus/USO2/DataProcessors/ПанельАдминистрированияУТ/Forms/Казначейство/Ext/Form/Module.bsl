&НаСервере
Процедура ПроверитьВозможностьВключенияНовойАрхитектурыВзаиморасчетов(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Расчеты.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	|	Расчеты.АналитикаУчетаПоПартнерам.Организация КАК Организация,
	|	Расчеты.АналитикаУчетаПоПартнерам.Контрагент КАК Контрагент,
	|	Расчеты.ЗаказКлиента КАК ОбъектРасчетов,
	|	Расчеты.Валюта КАК Валюта,
	|	Расчеты.ПредоплатаОстаток КАК ПредоплатаОстаток,
	|	Расчеты.ДолгОстаток КАК ДолгОстаток
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоДокументам.Остатки КАК Расчеты
	|ГДЕ
	|	Расчеты.ПредоплатаОстаток <> 0
	|	И Расчеты.ДолгОстаток<> 0
	|;
	|ВЫБРАТЬ
	|	Расчеты.АналитикаУчетаПоПартнерам КАК АналитикаУчетаПоПартнерам,
	|	Расчеты.АналитикаУчетаПоПартнерам.Организация КАК Организация,
	|	Расчеты.АналитикаУчетаПоПартнерам.Контрагент КАК Контрагент,
	|	Расчеты.ЗаказПоставщику КАК ОбъектРасчетов,
	|	Расчеты.Валюта КАК Валюта,
	|	Расчеты.ПредоплатаОстаток КАК ПредоплатаОстаток,
	|	Расчеты.ДолгОстаток КАК ДолгОстаток
	|ИЗ
	|	РегистрНакопления.РасчетыСПоставщикамиПоДокументам.Остатки КАК Расчеты
	|ГДЕ
	|	Расчеты.ПредоплатаОстаток <> 0
	|	И Расчеты.ДолгОстаток <> 0";
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	РасчетыСКлиентами = МассивРезультатов[0].Выгрузить();
	РасчетыСПоставщиками = МассивРезультатов[1].Выгрузить();
	
	Если РасчетыСКлиентами.Количество() > 0 ИЛИ РасчетыСПоставщиками.Количество() > 0 Тогда
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСписокВыбораВариантаИспользованияЛимитов()
	СписокВыбора = Элементы.ВариантИспользованияЛимитов.СписокВыбора;
	
	ЗначениеВыбора = "";
	Если СписокВыбора.НайтиПоЗначению(ЗначениеВыбора) = Неопределено Тогда
		ПредставлениеЗначения = НСтр("ru = 'Не используются';
									|en = 'Not used'");
		СписокВыбора.Добавить(ЗначениеВыбора, ПредставлениеЗначения);
	КонецЕсли;
	
	ЗначениеВыбора = "ДокументЛимитов";
	Если СписокВыбора.НайтиПоЗначению(ЗначениеВыбора) = Неопределено Тогда
		ПредставлениеЗначения = НСтр("ru = 'По документам лимитов расхода ДС';
									|en = 'By documents of cash expense limits'");
		СписокВыбора.Добавить(ЗначениеВыбора, ПредставлениеЗначения);
	КонецЕсли;
	
	//++ НЕ УТ
	ИспользоватьБюджетирование = ПолучитьФункциональнуюОпцию("ИспользоватьБюджетирование");
	ЗначениеВыбора = "ЛимитыБюджетирования";
	ПредставлениеЗначения = НСтр("ru = 'По данным бюджетирования';
								|en = 'By budgeting data'");
	ЭлементСписка = СписокВыбора.НайтиПоЗначению(ЗначениеВыбора);
	Если ИспользоватьБюджетирование И ЭлементСписка = Неопределено Тогда
		СписокВыбора.Добавить(ЗначениеВыбора, ПредставлениеЗначения);
	ИначеЕсли НЕ ИспользоватьБюджетирование И НЕ ЭлементСписка = Неопределено Тогда
		СписокВыбора.Удалить(ЭлементСписка);
	КонецЕсли;
	//-- НЕ УТ
	
КонецПроцедуры

&НаСервере
Процедура ДополнитьТекстРасширеннойПодсказкиВариантаИспользованияЛимитов()
	
	Если ВариантИспользованияЛимитов = "" Тогда
		ТекстЗаголовка = НСтр("ru = 'Лимиты расхода денежных средств не используются.';
								|en = 'Cash expense limits are not used.'");
	ИначеЕсли ВариантИспользованияЛимитов = "ДокументЛимитов" Тогда
		ТекстЗаголовка = НСтр("ru = 'Лимиты задаются документом ""Лимиты расхода денежных средств"".';
								|en = 'Limits are specified by the ""Cash expense limits"" document.'");
	//++ НЕ УТ
	ИначеЕсли ВариантИспользованияЛимитов = "ЛимитыБюджетирования" Тогда
		ТекстЗаголовка = НСтр("ru = 'При превышении лимита или если заявка не изменяет ни одну из статей бюджетов запрещается проведение 
			|заявок на расход денежных средств в любых статусах. Лимиты задаются документом ""Экземпляр бюджетов"" по статьям,
			|указанным в правилах лимитов в модели бюджетирования.';
			|en = 'When excessing the limit or if the request does not change any of the budget items, it is prohibited to post 
			|cash expense requests with any statuses. Limits are specified by the ""Budget entry document"" document by the items
			|specified in the limit rules in the budgeting model.'");
	//-- НЕ УТ
	КонецЕсли;
	
	Элементы.ВариантИспользованияЛимитовПодсказка.Заголовок = ТекстЗаголовка;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеВыбораВариантИспользованияЛимитов(НаборКонстант)
	
	Значение = "";
	Если НаборКонстант.ИспользоватьЛимитыРасходаДенежныхСредств Тогда
		Значение = "ДокументЛимитов";
	//++ НЕ УТ
	ИначеЕсли НаборКонстант.ИспользоватьЛимитыРасходаДенежныхСредствБюджетирования Тогда
		Значение = "ЛимитыБюджетирования";
	//-- НЕ УТ
	КонецЕсли;
	
	Возврат Значение;
КонецФункции

