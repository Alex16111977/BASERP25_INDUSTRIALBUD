&НаСервере
Процедура ЗаполнитьСоставПланаСервер(флОчищать)
	Если флОчищать Тогда
		Объект.СоставПлана.Очистить();
	КонецЕсли;
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
	
	//установка параметров
	СхемаКомпоновкиДанных.Параметры.Организация.Значение = Организация;
	СхемаКомпоновкиДанных.Параметры.ДатаНач.Значение = НачалоДня(НачалоПериода);
	СхемаКомпоновкиДанных.Параметры.ДатаКон.Значение = КонецДня(КонецПериода);
	Если ВариантЗаполнения = 1 Тогда //источник данных - план ТС
		СхемаКомпоновкиДанных.Параметры.Сценарий.Значение = Сценарий;
	Иначе
		СхемаКомпоновкиДанных.Параметры.Детализация.Значение = Сценарий.ДетализацияПланирования;
		Если Сценарий.Раздел = Перечисления.уатРазделыПланирования.ПредоставленныеУслуги Тогда
			СхемаКомпоновкиДанных.Параметры.ПланированиеПоГруппамУслуг.Значение = Сценарий.ПланированиеПоГруппамУслуг;
			СхемаКомпоновкиДанных.Параметры.Валюта.Значение = Сценарий.Валюта;
		Иначе
			СхемаКомпоновкиДанных.Параметры.Подразделение.Значение = Подразделение;
		КонецЕсли;
	КонецЕсли;
	
	//компоновка - получение данных
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	НастройкиКомпоновки = КомпоновщикОтбор.ПолучитьНастройки();
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, НастройкиКомпоновки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	тблЗапросДанные = Новый ТаблицаЗначений;
	ПроцессорВывода.УстановитьОбъект(тблЗапросДанные);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если ВариантЗаполнения = 1 Тогда //план
		Если УчитыватьНДС Тогда
			тблЗапросДанные.Свернуть("ДетализацияПланирования, Контрагент, Договор, Маршрут, ОбъектСтроительства, ВидПеревозки, Номенклатура, ПараметрВыработки", "Количество, Сумма, СуммаНДС");
		Иначе
			тблЗапросДанные.Свернуть("ДетализацияПланирования, Контрагент, Договор, Маршрут, ОбъектСтроительства, ВидПеревозки, Номенклатура, ПараметрВыработки", "Количество, Сумма");
		КонецЕсли;
	ИначеЕсли Сценарий.Раздел = Перечисления.уатРазделыПланирования.ПредоставленныеУслуги Тогда //услуги
		Если УчитыватьНДС Тогда
			тблЗапросДанные.Свернуть("ДетализацияПланирования, Контрагент, Договор, Маршрут, ОбъектСтроительства, ВидПеревозки, Номенклатура, ПараметрВыработки, СтавкаНДС", "Количество, Сумма, СуммаНДС");
		Иначе
			тблЗапросДанные.Свернуть("ДетализацияПланирования, Контрагент, Договор, Маршрут, ОбъектСтроительства, ВидПеревозки, Номенклатура, ПараметрВыработки", "Количество, Сумма");
		КонецЕсли;
	Иначе //выработка
		тблЗапросДанные.Свернуть("ДетализацияПланирования, Контрагент, Маршрут, ОбъектСтроительства, ВидПеревозки, ПараметрВыработки", "Количество");
	КонецЕсли;
		
	Для Каждого ТекСтрока Из тблЗапросДанные Цикл
		НоваяСтрока = Объект.СоставПлана.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		Если ТекСтрока.ПараметрВыработки.Временный Тогда
			НоваяСтрока.Количество = НоваяСтрока.Количество / 3600;
		КонецЕсли;
		Если НоваяСтрока.Количество > 0 Тогда
			НоваяСтрока.Цена = НоваяСтрока.Сумма / НоваяСтрока.Количество;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДоступность()
	РазделСценария = уатОбщегоНазначенияТиповые.ПолучитьЗначениеРеквизита(Сценарий, "Раздел");
	флПланированиеУслуг = (РазделСценария = ПредопределенноеЗначение("Перечисление.уатРазделыПланирования.ПредоставленныеУслуги"));
	флПланированиеВыработки = (РазделСценария = ПредопределенноеЗначение("Перечисление.уатРазделыПланирования.ВыработкаТСпоПЛ"));
		
	Элементы.СоставПланаНоменклатура.Видимость = флПланированиеУслуг;
	Элементы.СоставПланаЦена.Видимость = флПланированиеУслуг;
	Элементы.СоставПланаСумма.Видимость = флПланированиеУслуг;
	Элементы.СоставПланаСтавкаНДС.Видимость = флПланированиеУслуг И УчитыватьНДС;
	Элементы.СоставПланаСуммаНДС.Видимость = флПланированиеУслуг И УчитыватьНДС;
	Элементы.СоставПланаВсего.Видимость = флПланированиеУслуг И УчитыватьНДС;
	
	Элементы.Подразделение.Видимость = НЕ флПланированиеУслуг;
	
	Элементы.ГруппаСоставПлана.Заголовок = ?(флПланированиеУслуг, "Услуги", "Выработка");
	Элементы.ГруппаИзменитьЦены.Видимость = флПланированиеУслуг;
	
	Если ВариантЗаполнения = 1 Тогда
		НадписьИсточникДанных = "Регистр накопления ""План работы ТС""";
	ИначеЕсли флПланированиеУслуг Тогда
		НадписьИсточникДанных = "Регистр накопления ""Выработка трансп. работы по стоимости""";
	Иначе
		НадписьИсточникДанных = "Регистр накопления ""Выработка ТС""";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПараметрВыработкиВременный()
	Для Каждого ТекСтрокаТЧ Из Объект.СоставПлана Цикл
		ТекСтрокаТЧ.ПараметрВыработкиВременный = уатОбщегоНазначенияТиповые.ПолучитьЗначениеРеквизита(ТекСтрокаТЧ.ПараметрВыработки, "Временный");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВсегоВТЧ()
	Для Каждого СтрокаТабличнойЧасти Из Объект.СоставПлана Цикл
		СтрокаТабличнойЧасти.Всего = СтрокаТабличнойЧасти.Сумма + ?(СуммаВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ФорматироватьКолонкуДетализации()
	ДетПланир = уатОбщегоНазначенияТиповые.ПолучитьЗначениеРеквизита(Сценарий, "ДетализацияПланирования");
	
	Если ДетПланир = ПредопределенноеЗначение("Перечисление.уатДетализацияПланирования.МодельТС") Тогда
		Элементы.СоставПланаДетализацияПланирования.Заголовок = НСтр("en='Vehicle model';ru='Модель ТС'");
		Элементы.СоставПланаДетализацияПланирования.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.уатМоделиТС");
	ИначеЕсли ДетПланир = ПредопределенноеЗначение("Перечисление.уатДетализацияПланирования.ТипТС") Тогда
		Элементы.СоставПланаДетализацияПланирования.Заголовок = НСтр("en='Vehicle type';ru='Тип ТС'");
		Элементы.СоставПланаДетализацияПланирования.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ТипыТранспортныхСредств");
	ИначеЕсли ДетПланир = ПредопределенноеЗначение("Перечисление.уатДетализацияПланирования.ТС") Тогда
		Элементы.СоставПланаДетализацияПланирования.Заголовок = НСтр("en='Vehicle';ru='ТС'");
		Элементы.СоставПланаДетализацияПланирования.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ТранспортныеСредства");
	Иначе
		Элементы.СоставПланаДетализацияПланирования.Заголовок = НСтр("en='Detail';ru='Детализация'");
		Элементы.СоставПланаДетализацияПланирования.ОграничениеТипа = Новый ОписаниеТипов("Неопределено");
	КонецЕсли;
КонецПроцедуры

// Процедура рассчитывает сумму в строке табличной части.
//
&НаКлиенте
Процедура РассчитатьСуммуВСтрокеТабличнойЧасти(СтрокаТабличнойЧасти = Неопределено)
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаТабличнойЧасти.ПараметрВыработкиВременный Тогда
		Колич = Цел(СтрокаТабличнойЧасти.Количество) + (СтрокаТабличнойЧасти.Количество - Цел(СтрокаТабличнойЧасти.Количество))/60*100;
	Иначе
		Колич = СтрокаТабличнойЧасти.Количество;
	КонецЕсли;
	СтрокаТабличнойЧасти.Сумма = Колич * СтрокаТабличнойЧасти.Цена;
	
	РассчитатьСуммуНДС(СтрокаТабличнойЧасти);
	
КонецПроцедуры // РассчитатьСуммуВСтрокеТабличнойЧасти()

// Рассчитывается сумма НДС в строке табличной части.
//
&НаКлиенте
Процедура РассчитатьСуммуНДС(СтрокаТабличнойЧасти)
	
	СтавкаНДС = уатОбщегоНазначенияПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТабличнойЧасти.СтавкаНДС);
	
	СтрокаТабличнойЧасти.СуммаНДС = ?(СуммаВключаетНДС, 
	СтрокаТабличнойЧасти.Сумма - (СтрокаТабличнойЧасти.Сумма) / ((СтавкаНДС + 100) / 100),
	СтрокаТабличнойЧасти.Сумма * СтавкаНДС / 100);
	
КонецПроцедуры // РассчитатьСуммуНДС()

&НаСервере
Процедура СкорректироватьПериодЗаполнения()
	уатОбщегоНазначенияТиповые.уатВыровнятьПериод(НачалоПериода, КонецПериода, Сценарий.Периодичность);
КонецПроцедуры

&НаСервере
Процедура ИнициализацияКомпоновщика()
	Если ВариантЗаполнения = 1 Тогда
		СхемаКомпоновкиДанных = РеквизитФормыВЗначение("Объект").ПолучитьМакет("КомпоновкаДанныхПлан");
		СхемаКомпоновкиДанныхОтбор = РеквизитФормыВЗначение("Объект").ПолучитьМакет("КомпоновкаДанныхОтборПлан");
	ИначеЕсли Сценарий.Раздел = Перечисления.уатРазделыПланирования.ПредоставленныеУслуги Тогда
		СхемаКомпоновкиДанных = РеквизитФормыВЗначение("Объект").ПолучитьМакет("КомпоновкаДанныхУслуги");
		СхемаКомпоновкиДанныхОтбор = РеквизитФормыВЗначение("Объект").ПолучитьМакет("КомпоновкаДанныхОтборУслуги");
	Иначе
		СхемаКомпоновкиДанных = РеквизитФормыВЗначение("Объект").ПолучитьМакет("КомпоновкаДанныхВыработка");
		СхемаКомпоновкиДанныхОтбор = РеквизитФормыВЗначение("Объект").ПолучитьМакет("КомпоновкаДанныхОтборВыработка");
	КонецЕсли;
	
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	АдресСхемыКомпоновкиДанныхОтбор = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанныхОтбор, УникальныйИдентификатор);
	
	КомпоновщикОтбор.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанныхОтбор));
	КомпоновщикОтбор.ЗагрузитьНастройки(СхемаКомпоновкиДанныхОтбор.НастройкиПоУмолчанию);
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиВДокументИЗакрыть()
	мсвСтрок = Новый Массив;
	Для Каждого ТекСтрока Из Объект.СоставПлана Цикл
		СтруктураСтроки = СтруктураСтрокиСостава();
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, ТекСтрока);
		мсвСтрок.Добавить(СтруктураСтроки);
	КонецЦикла;
	
	ПеренестиВДокумент = Истина;
	Закрыть(мсвСтрок);
КонецПроцедуры

#КонецОбласти
