		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	уатВыработкаТСОбороты.ВидПеревозки КАК ВидПеревозки,
	уатВыработкаТСОбороты.Колонна КАК Колонна,
	уатВыработкаТСОбороты.Контрагент КАК Контрагент,
	уатВыработкаТСОбороты.Маршрут КАК Маршрут,
	уатВыработкаТСОбороты.ОбъектСтроительства КАК ОбъектСтроительства,
	уатВыработкаТСОбороты.ПараметрВыработки КАК ПараметрВыработки,
	уатВыработкаТСОбороты.ТС КАК ТС,
	уатВыработкаТСОбороты.ТС.Тип КАК ТипТС,
	уатВыработкаТСОбороты.ТС.уатМодель КАК МодельТС,
	ВЫБОР
		КОГДА &amp;Детализация = ЗНАЧЕНИЕ(Перечисление.уатДетализацияПланирования.ТипТС)
			ТОГДА уатВыработкаТСОбороты.ТС.Тип
		КОГДА &amp;Детализация = ЗНАЧЕНИЕ(Перечисление.уатДетализацияПланирования.МодельТС)
			ТОГДА уатВыработкаТСОбороты.ТС.уатМодель
		ИНАЧЕ уатВыработкаТСОбороты.ТС
	КОНЕЦ КАК ДетализацияПланирования,
	уатВыработкаТСОбороты.КоличествоОборот КАК Количество
ИЗ
	РегистрНакопления.уатВыработкаТС.Обороты(
			&amp;ДатаНач,
			&amp;ДатаКон,
			,
			Организация = &amp;Организация
				И ПараметрВыработки.ИспользоватьПриПланировании
				И (&amp;Подразделение = ЗНАЧЕНИЕ(Справочник.ПодразделенияОрганизаций.ПустаяСсылка)
					ИЛИ Подразделение = &amp;Подразделение)) КАК уатВыработкаТСОбороты

УПОРЯДОЧИТЬ ПО
	ДетализацияПланирования</query>
