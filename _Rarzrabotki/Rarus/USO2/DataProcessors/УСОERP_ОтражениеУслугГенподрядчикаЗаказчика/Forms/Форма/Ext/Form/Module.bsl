
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Дата") Тогда
		Объект.Дата = Параметры.Дата;
		ПараметрДата = Параметры.Дата;
	КонецЕсли;	
	Если Параметры.Свойство("Соглашение") Тогда
		ПараметрСоглашение = Параметры.Соглашение;
	КонецЕсли;	
	Если Параметры.Свойство("Договор") Тогда
		ПараметрДоговор = Параметры.Договор;
	КонецЕсли;	
	Если Параметры.Свойство("Организация") Тогда
		ПараметрОрганизация = Параметры.Организация;
	КонецЕсли;	
	Если Параметры.Свойство("Контрагент") Тогда
		ПараметрКонтрагент = Параметры.Контрагент;
	КонецЕсли;
	Если Параметры.Свойство("Команда") Тогда
		ПараметрКоманда = СокрЛП(Параметры.Команда);
		Если ПараметрКоманда = "ЗаполнитьУслугиЗаказчика" Тогда
			ЭтаФорма.элементы.СтоимостьПринятыхРабот.Заголовок = "Стоимость реализованных работ";
			ЭтаФорма.Элементы.СтоимостьУслугГенподрядчика.Заголовок = "Стоимость услуг заказчика;";
		КонецЕсли;	
	КонецЕсли;
	Объект.СтавкаНДС = Перечисления.СтавкиНДС.НДС18;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьЗаМесяцНаСервере()
	
	Запрос = Новый Запрос;
	Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(УСОERP_ВыполнениеРаботСубподрядчиком.СуммаСНДС) КАК СуммаСНДС
	|ИЗ
	|	РегистрНакопления.УСОERP_ВыполнениеРаботСубподрядчиком КАК УСОERP_ВыполнениеРаботСубподрядчиком
	|ГДЕ
	|	УСОERP_ВыполнениеРаботСубподрядчиком.ВидДвижения = &ВидДвижения
	|	И УСОERP_ВыполнениеРаботСубподрядчиком.Организация = &Организация
	|	И УСОERP_ВыполнениеРаботСубподрядчиком.Контрагент = &Контрагент
	|	И УСОERP_ВыполнениеРаботСубподрядчиком.ОбъектСтроительства = &ОбъектСтроительства";
	Текст = Текст + "
	|	И УСОERP_ВыполнениеРаботСубподрядчиком.Период МЕЖДУ &НачалоПериода И &КонецПериода";
	
	ДатаЗапроса = Объект.Дата;
		
	Запрос.Текст =  Текст;
	
	Запрос.УстановитьПараметр("НачалоПериода",			ДатаЗапроса);
	Запрос.УстановитьПараметр("КонецПериода", 			ДатаЗапроса + 2592000);
	Запрос.УстановитьПараметр("Контрагент", 			ПараметрКонтрагент);
	Запрос.УстановитьПараметр("ОбъектСтроительства", 	Объект.ОбъектСтроительства);
	Запрос.УстановитьПараметр("Организация", 			ПараметрОрганизация);
	Запрос.УстановитьПараметр("ВидДвижения", 			ВидДвиженияНакопления.Расход);
	
	Если ПараметрКоманда = "ЗаполнитьУслугиЗаказчика" Тогда
		Запрос.Текст	= СтрЗаменить(Запрос.Текст, "УСОERP_ВыполнениеРаботСубподрядчиком", "УСОERP_ВыполнениеРаботЗаказчика");
	КонецЕсли;	

	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.СуммаСНДС;
	КонецЕсли;
	
	Возврат 0;   
КонецФункции

&НаКлиенте
Процедура ЗаполнитьЗаМесяц(Команда)
	флагЗаполнитьЗаМесяц = Истина;
	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		Сообщить(НСтр("ru='Не заполнено поле «Дата».'"));
		флагЗаполнитьЗаМесяц = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ОбъектСтроительства) Тогда
		
		Сообщить(НСтр("ru='Не заполнено поле «Объект строительства».'"));
		флагЗаполнитьЗаМесяц = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ПроцентУслуг) Тогда
		Сообщить(НСтр("ru='Не заполнено поле «% Услуг».'"));
		флагЗаполнитьЗаМесяц = Ложь;
	КонецЕсли;
	
	Если флагЗаполнитьЗаМесяц Тогда
		
		Объект.СтоимостьПринятыхРабот 		= ЗаполнитьЗаМесяцНаСервере();
		Объект.СтоимостьУслугГенподрядчика	= (Объект.СтоимостьПринятыхРабот * Объект.ПроцентУслуг)/100;
		
		Объект.СуммаНДС	= ЦенообразованиеКлиентСервер.РассчитатьСуммуНДС(Объект.СтоимостьУслугГенподрядчика, Объект.СтавкаНДС, Истина);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбъектСтроительстваПриИзменении(Элемент)
	СтруктураПраметров = ОбъектСтроительстваПриИзмененииНаСервере(Объект.ОбъектСтроительства);
	Объект.НоменклатураУслуги	= СтруктураПраметров.Номенклатура;
	//Объект.СтавкаНДС	= СтруктураПраметров.СтавкаНДС; 
КонецПроцедуры

&НаСервере
Функция ОбъектСтроительстваПриИзмененииНаСервере(ОбъектСтроительства)
	Номенклатура	= ?(ЗначениеЗаполнено(ОбъектСтроительства), ?(ПараметрКоманда = "ЗаполнитьУслугиЗаказчика", ОбъектСтроительства.НоменклатураЗаказчика ,ОбъектСтроительства.НоменклатураГенподрядчика), Справочники.Номенклатура.ПустаяСсылка());
	
	СтавкаНДС	= Номенклатура.СтавкаНДС;
    СтруктураПраметров = Новый Структура;
	СтруктураПраметров.Вставить("Номенклатура", Номенклатура);
	СтруктураПраметров.Вставить("СтавкаНДС", СтавкаНДС);
	Возврат СтруктураПраметров;
КонецФункции

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	ПередаваемыеЗначения = ЗаполнитьПередаваемыеЗначения();
	ЭтаФорма.Закрыть(ПередаваемыеЗначения);
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПередаваемыеЗначения()
	 ПередаваемыеЗначения = Новый Структура;
	 ПередаваемыеЗначения.Вставить("Номенклатура", Объект.НоменклатураУслуги);
	 ПередаваемыеЗначения.Вставить("СуммаНДС",  Объект.СуммаНДС);
	 ПередаваемыеЗначения.Вставить("СуммаСНДС", Объект.СтоимостьУслугГенподрядчика - Объект.СуммаНДС);
	 ПередаваемыеЗначения.Вставить("СтавкаНДС", Объект.СтавкаНДС);
	 Возврат ПередаваемыеЗначения;
 КонецФункции	

