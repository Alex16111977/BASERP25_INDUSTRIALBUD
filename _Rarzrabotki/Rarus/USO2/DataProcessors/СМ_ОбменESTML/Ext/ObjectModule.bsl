Функция НайтиАкты(Смета) 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_АктВыполненныхРабот.Ссылка
	               |ИЗ
	               |	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
	               |ГДЕ
	               |	СМ_АктВыполненныхРабот.Проведен = ИСТИНА
	               |	И СМ_АктВыполненныхРабот.ЛокальнаяСмета = &Смета
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_АктВыполненныхРабот.НомерАкта";
	Запрос.УстановитьПараметр("Смета",Смета);
	
	Возврат Запрос.Выполнить().Выбрать();
КонецФункции

Функция ПолучитьДанныеРесурса(Ресурс,Расценка)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_СтоимостьРесурсовПозиции.СтоимостьТекущая КАК Цена,
	               |	СМ_СтоимостьРесурсовПозиции.Количество,
	               |	СМ_СтоимостьРесурсовПозиции.СтоимостьБазисная КАК ЦенаБаз
	               |ИЗ
	               |	РегистрСведений.СМ_СтоимостьРесурсовПозиции КАК СМ_СтоимостьРесурсовПозиции
	               |ГДЕ
	               |	СМ_СтоимостьРесурсовПозиции.Позиция = &Расценка
	               |	И СМ_СтоимостьРесурсовПозиции.Ресурс = &Ресурс";
	Запрос.УстановитьПараметр("Расценка",Расценка);
	Запрос.УстановитьПараметр("Ресурс",Ресурс.Ресурс);
	ТЗ = Запрос.Выполнить().Выгрузить();
	Возврат ?(ТЗ.Количество()=0,0,ТЗ[0]);	
КонецФункции	

Функция ПолучитьИтогНачисления(ЛимитированнаяЗатрата,АктСмета)
