#КонецОбласти

#Область Загрузка
// // // // /Загрузка// // // // // // // /

// Процедура загружает Локальную смету из указанного файла.
// ПАРАМЕТРЫ:
// // Путь - путь к файлу сметы.
Процедура ПрочитатьНаСервере(Путь) Экспорт
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xsd");
	Макет = ПолучитьМакет("Схема");
	Макет.Записать(ИмяФайла);
	
	ИмяФайла1 = ПолучитьИмяВременногоФайла("xsd");
	Макет = ПолучитьМакет("СхемаНастройка");
	Макет.Записать(ИмяФайла1);

	Схемы = Новый Массив;
	Схемы.Добавить(ИмяФайла);
	Схемы.Добавить(ИмяФайла1);

	ЕстьАкт = Ложь;

	Фабрика = СоздатьФабрикуXDTO(Схемы);

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",Путь)); 
	Запись.Следующий();
	ДвоичныеДанные = Запись.Файл.Получить();
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
	
	ФайлОбъектXDTO = Фабрика.ПрочитатьXML(ЧтениеXML);
	
	НоваяСмета 				= Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
	НоваяСмета.НомерСметы 	= ФайлОбъектXDTO.ЛокальнаяСмета.Номер;
	НоваяСмета.Дата			= ПреобразоватьФорматДаты(ФайлОбъектXDTO.ЛокальнаяСмета.Дата);
	//НоваяСмета.Дата 		= Дата(Сред(ФайлОбъектXDTO.ЛокальнаяСмета.Дата,7),Сред(ФайлОбъектXDTO.ЛокальнаяСмета.Дата,4,2),Лев(ФайлОбъектXDTO.ЛокальнаяСмета.Дата,2));
	
	Если Не ФайлОбъектXDTO.ЛокальнаяСмета.свойства().получить("Заказчик") = Неопределено Тогда
		Если Не ФайлОбъектXDTO.ЛокальнаяСмета.Заказчик.свойства().получить("Наименование")  = Неопределено Тогда
			НоваяСмета.Заказчик = Справочники.Контрагенты.НайтиПоНаименованию(ФайлОбъектXDTO.ЛокальнаяСмета.Заказчик.Наименование,Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ФайлОбъектXDTO.ЛокальнаяСмета.свойства().получить("Подрядчик") = Неопределено Тогда
		Если Не ФайлОбъектXDTO.ЛокальнаяСмета.Подрядчик.свойства().получить("Наименование")  = Неопределено Тогда
			НоваяСмета.Подрядчик = Справочники.Контрагенты.НайтиПоНаименованию(ФайлОбъектXDTO.ЛокальнаяСмета.Подрядчик.Наименование,Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ФайлОбъектXDTO.ЛокальнаяСмета.свойства().получить("ПроектнаяОрганизация") = Неопределено Тогда
		Если Не ФайлОбъектXDTO.ЛокальнаяСмета.ПроектнаяОрганизация.свойства().получить("Наименование")  = Неопределено Тогда
			НоваяСмета.Организация = Справочники.Организации.НайтиПоНаименованию(ФайлОбъектXDTO.ЛокальнаяСмета.ПроектнаяОрганизация.Наименование,Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ФайлОбъектXDTO.ЛокальнаяСмета.свойства().получить("Инвестор") = Неопределено Тогда
		Если Не ФайлОбъектXDTO.ЛокальнаяСмета.Инвестор.свойства().получить("ФИО")  = Неопределено Тогда
			НоваяСмета.Инвестор = Справочники.Контрагенты.НайтиПоНаименованию(ФайлОбъектXDTO.ЛокальнаяСмета.Инвестор.ФИО,Истина);
		КонецЕсли;
	КонецЕсли;
	
	НоваяСмета.Стройка = Справочники.СМ_ОбъектыСтроительства.НайтиПоНаименованию(ФайлОбъектXDTO.ЛокальнаяСмета.Объект.Наименование,Истина);
	НоваяСмета.Наименование = ФайлОбъектXDTO.ЛокальнаяСмета.Объект.Наименование;
	НоваяСмета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
	НоваяСмета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка;
	НоваяСмета.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат;
	НоваяСмета.Записать();
	
	Если Не ФайлОбъектXDTO.ЛокальнаяСмета.свойства().получить("Раздел") = Неопределено Тогда
		Если ТипЗнч(ФайлОбъектXDTO.ЛокальнаяСмета.Раздел) = Тип("СписокXDTO") Тогда
			Для каждого СтрРаздел Из ФайлОбъектXDTO.ЛокальнаяСмета.Раздел Цикл
				СоздатьРаздел(СтрРаздел,НоваяСмета);
			КонецЦикла;
		Иначе
			СоздатьРаздел(ФайлОбъектXDTO.ЛокальнаяСмета.Раздел,НоваяСмета);
		КонецЕсли;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("СМ_ИспользованиеУчетаВыполненныхРабот") Тогда
		Если Не ФайлОбъектXDTO.ЛокальнаяСмета.свойства().получить("Акт") = Неопределено Тогда
			Если ТипЗнч(ФайлОбъектXDTO.ЛокальнаяСмета.Акт) = Тип("СписокXDTO") Тогда
				Для каждого СтрАкт Из ФайлОбъектXDTO.ЛокальнаяСмета.Акт Цикл
					СоздатьАкт(СтрАкт,НоваяСмета);
					ЕстьАкт = Истина;
				КонецЦикла;
			Иначе
				СоздатьАкт(ФайлОбъектXDTO.ЛокальнаяСмета.Акт,НоваяСмета);
				ЕстьАкт = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не ФайлОбъектXDTO.ЛокальнаяСмета.свойства().получить("Начисление") = Неопределено Тогда
		Если ТипЗнч(ФайлОбъектXDTO.ЛокальнаяСмета.Начисление) = Тип("СписокXDTO") Тогда
			Для каждого СтрНачисление Из ФайлОбъектXDTO.ЛокальнаяСмета.Начисление Цикл
				НовоеНачисление = НоваяСмета.ЛимитированныеЗатраты.Добавить();
				НовоеНачисление.ЛимитированнаяЗатрата = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоНаименованию(СтрНачисление.Наименование,Истина);
				НовоеНачисление.ЗначениеЛимЗатраты = СтрНачисление.Значение;
			КонецЦикла;
		Иначе
			НовоеНачисление = НоваяСмета.ЛимитированныеЗатраты.Добавить();
			НовоеНачисление.ЛимитированнаяЗатрата = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоНаименованию(ФайлОбъектXDTO.ЛокальнаяСмета.Начисление.Наименование,Истина);
			НовоеНачисление.ЗначениеЛимЗатраты = ФайлОбъектXDTO.ЛокальнаяСмета.Начисление.Значение;
		КонецЕсли;
	КонецЕсли;

	Если СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьСтатусыДокументов") И ЕстьАкт Тогда
		НоваяСмета.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Согласован;
	КонецЕсли;
	
	НоваяСмета.Записать();
	
	//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ - %1'"), Строка(НоваяСмета)));    
	
	// Запись сообщений в журнал регистрации
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен в формате ESTML'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ - %1'"), Строка(НоваяСмета)));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);

КонецПроцедуры

Функция ПреобразоватьФорматДаты(ТекДата)
	
	// формат даты: 2015-02-06T15:42:00
    ПозицияТ = СтрНайти(ТекДата,"T");
	Если ПозицияТ > 0 Тогда
		ТекДата 	= Сред(ТекДата,1,ПозицияТ-1);
		НоваяДата 	= Дата(Сред(ТекДата,1,4),Сред(ТекДата,6,2),Сред(ТекДата,9));
	// формат даты: 15.04.2013
	Иначе	
		НоваяДата = Дата(Сред(ТекДата,7),Сред(ТекДата,4,2),Лев(ТекДата,2));
	КонецЕсли;
	
	Возврат НоваяДата;
	
КонецФункции

Процедура СоздатьАкт(Акт,Смета)
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	
	НовыйАкт 		= Документы.СМ_АктВыполненныхРабот.СоздатьДокумент();
	НовыйАкт.Дата 	= XMLЗначение(Тип("Дата"), Акт.Дата);
	НовыйАкт.Организация = Смета.Организация;
	НовыйАкт.ЛокальнаяСмета = Смета.Ссылка;
	Если Не Акт.свойства().получить("Заказчик") = Неопределено Тогда
		НовыйАкт.Заказчик = Справочники.Контрагенты.НайтиПоНаименованию(Акт.Заказчик.Наименование,Истина);
	КонецЕсли;
	Если Не Акт.свойства().получить("Подрядчик") = Неопределено Тогда
		НовыйАкт.Подрядчик = Справочники.Контрагенты.НайтиПоНаименованию(Акт.Подрядчик.Наименование,Истина);
	КонецЕсли;
	Если Не Акт.свойства().получить("Инвестор") = Неопределено Тогда
		НовыйАкт.Инвестор = Справочники.Контрагенты.НайтиПоНаименованию(Акт.Инвестор.Наименование,Истина);
	КонецЕсли;
	НовыйАкт.Стройка = Справочники.СМ_ОбъектыСтроительства.НайтиПоНаименованию(Акт.Объект.Наименование,Истина);
	НовыйАкт.Записать();
	Если Не Акт.свойства().получить("Раздел") = Неопределено Тогда
		СоздРаздел = Неопределено;
		Если ТипЗнч(Акт.Раздел) = Тип("СписокXDTO") Тогда
			Для каждого СтрРаздел Из Акт.Раздел Цикл
				СоздРаздел = НайтиРаздел(СтрРаздел,Смета,НовыйАкт);
				Если СоздРаздел = Неопределено Тогда
					//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден раздел %1'"), СтрРаздел.Наименование));
					СтруктураСообщения 	= Новый Структура;
					СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен в формате ESTML'"));
					СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
					СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден раздел %1'"), СтрРаздел.Наименование));
					СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
					СообщенияДляЖурнала.Добавить(СтруктураСообщения);
					Продолжить;
				КонецЕсли;
				НовРаздел = НовыйАкт.Разделы.Добавить();
				НовРаздел.Раздел = СоздРаздел.Ссылка;
			КонецЦикла;
		Иначе
			СоздРаздел = НайтиРаздел(Акт.Раздел,Смета,НовыйАкт); 
			Если СоздРаздел = Неопределено Тогда
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден раздел %1'"), Акт.Раздел.Наименование));
				СтруктураСообщения 	= Новый Структура;
				СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен в формате ESTML'"));
				СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
				СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден раздел %1'"), Акт.Раздел.Наименование));
				СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			Иначе
				НовРаздел 			= НовыйАкт.Разделы.Добавить();
				НовРаздел.Раздел 	= СоздРаздел.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Запись сообщений в журнал регистрации
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	Если Не Акт.свойства().получить("Начисление") = Неопределено Тогда
		Если ТипЗнч(Акт.Начисление) = Тип("СписокXDTO") Тогда
			Для каждого СтрНачисление Из Акт.Начисление Цикл
				НовыйАкт = НовыйАкт.ЛимитированныеЗатраты.Добавить();
				НовыйАкт.ЛимитированнаяЗатрата = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоНаименованию(СтрНачисление.Наименование,Истина);
				НовыйАкт.ЗначениеЛимЗатраты = СтрНачисление.Значение;
			КонецЦикла;
		Иначе
			НовыйАкт = НовыйАкт.ЛимитированныеЗатраты.Добавить();
			НовыйАкт.ЛимитированнаяЗатрата = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоНаименованию(Акт.Начисление.Наименование,Истина);
			НовыйАкт.ЗначениеЛимЗатраты = Акт.Начисление.Значение;
		КонецЕсли;
	КонецЕсли;

	НовыйАкт.Записать();
	
КонецПроцедуры

Функция НайтиРаздел(СтрРаздел,Смета,НовыйАкт)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_РазделЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	               |ГДЕ
	               |	СМ_РазделЛокальнойСметы.ИДСметы = &Смета
	               |	И СМ_РазделЛокальнойСметы.НаименованиеДляПечати ПОДОБНО &Наименование";
	Запрос.УстановитьПараметр("Смета",Смета.Ссылка);
	Запрос.УстановитьПараметр("Наименование",СтрРаздел.Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Раздел = Выборка.Ссылка;
	Иначе
		Возврат Неопределено; 
	КонецЕсли;
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	
	Если ТипЗнч(СтрРаздел.Расценка) = Тип("СписокXDTO") Тогда
		Для каждого СтрРасценка Из СтрРаздел.Расценка Цикл
			Позиция = НайтиПозицию(СтрРасценка,Раздел,Смета);
			Если Позиция = Неопределено Тогда
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найдена позиция %1'"), СтрРасценка.Шифр));
				СтруктураСообщения 	= Новый Структура;
				СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен в формате ESTML'"));
				СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
				СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найдена позиция %1'"), СтрРасценка.Шифр));
				СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
				Продолжить;
			КонецЕсли;
			НовПозиция = НовыйАкт.Позиции.Добавить();
			НовПозиция.Позиция = Позиция.ссылка;
			НовПозиция.ФактОбъем = СтрРасценка.Количество;
		КонецЦикла;
	Иначе
		Позиция = НайтиПозицию(СтрРаздел.Расценка,Раздел,Смета);
		Если Позиция = Неопределено Тогда
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найдена позиция %1'"), СтрРаздел.Расценка.Шифр));
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен в формате ESTML'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найдена позиция %1'"), СтрРаздел.Расценка.Шифр));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	        СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		Иначе
			НовПозиция = НовыйАкт.Позиции.Добавить();
			НовПозиция.Позиция = Позиция.ссылка;
			НовПозиция.ФактОбъем = СтрРаздел.Расценка.Количество;
		КонецЕсли;
	КонецЕсли;
	
	// Запись сообщений в журнал регистрации
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	Возврат Раздел; 
	
КонецФункции

Функция НайтиПозицию(СтрРасценка,Раздел,Смета)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ПозицияЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	               |ГДЕ
	               |	СМ_ПозицияЛокальнойСметы.ИДСметы = &Смета
	               |	И СМ_ПозицияЛокальнойСметы.ИДРодителя = &Раздел
	               |	И СМ_ПозицияЛокальнойСметы.ШифрРасценки = &Шифр
	               |	И СМ_ПозицияЛокальнойСметы.Наименование ПОДОБНО &Наименование";
	Запрос.УстановитьПараметр("Смета",Смета.Ссылка);
	Запрос.УстановитьПараметр("Наименование",СтрРасценка.Наименование);
	Запрос.УстановитьПараметр("Раздел",Раздел.Ссылка);
	Запрос.УстановитьПараметр("Шифр",СтрРасценка.Шифр);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено; 
	КонецЕсли;
КонецФункции

Процедура СоздатьРаздел(Раздел,СметаАкт)
	НовыйРаздел = Документы.СМ_РазделЛокальнойСметы.СоздатьДокумент();
	НовыйРаздел.Расчет = Истина;
	НовыйРаздел.Дата = СметаАкт.Дата;
	НовыйРаздел.ИДРодителя = СметаАкт.Ссылка;
	НовыйРаздел.ИДСметы = СметаАкт.Ссылка;
	НовыйРаздел.НаименованиеДляПечати = Раздел.Наименование;
	НовыйРаздел.Записать();
	Если Раздел.Свойства().Получить("Расценка") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Раздел.Расценка) = Тип("СписокXDTO") Тогда
		Для каждого СтрРасценка Из Раздел.Расценка Цикл
			СоздатьПозицию(СтрРасценка,НовыйРаздел,СметаАкт);
		КонецЦикла;
	Иначе
		СоздатьПозицию(Раздел.Расценка,НовыйРаздел,СметаАкт);
	КонецЕсли;
КонецПроцедуры

Процедура СоздатьПозицию(Расценка,Раздел,СметаАкт)
	
	НовыйПозиция = Документы.СМ_ПозицияЛокальнойСметы.СоздатьДокумент(); 
	НовыйПозиция.Расчет = Истина;
	НовыйПозиция.Дата = СметаАкт.Дата;
	НовыйПозиция.ИДРодителя = Раздел.Ссылка;
	НовыйПозиция.ИДСметы = Раздел.ИДСметы;
	НовыйПозиция.ШифрРасценки = Расценка.Шифр;
	НовыйПозиция.Наименование = Расценка.Наименование;
	НовыйПозиция.ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(Расценка.ЕдИзм,Истина);
	НовыйПозиция.ОбъемРабот = Расценка.Количество;
	НовыйПозиция.Определитель = Справочники.СМ_Определители.НайтиПоНаименованию("Общестроительные работы",Истина);
	
	НовыйПозиция.ОснЗарплата = Расценка.ЗП;
	НовыйПозиция.ЭксплМашин = Расценка.ЭМ;
	НовыйПозиция.ТекущаяЗарплатаМашинистов = Расценка.ЗПМ;
	НовыйПозиция.СтоимМатериалов = Расценка.МР;
	НовыйПозиция.ЗатратыТрудаРабочих = Расценка.ЗТР;
	НовыйПозиция.ЗатратыТрудаМашинистов = Расценка.ЗТМ;
	НовыйПозиция.ПрямЗатраты = Расценка.Всего;
	НовыйПозиция.Оборудование = Расценка.Оборудование;
	НовыйПозиция.НакладныеРасходыТекущие = Расценка.НР;
	НовыйПозиция.СметнаяПрибыльТекущие = Расценка.СП;
	
	НовыйПозиция.СпособСоздания  	= Перечисления.СМ_ИсточникиДобавленияПозиций.Загружена;
	НовыйПозиция.ИсточникСоздания   = "ГосСтройСмета#ESTML";
	
	Если Не Расценка.свойства().получить("Поправка") = Неопределено Тогда
		Если ТипЗнч(Расценка.Поправка) = Тип("СписокXDTO") Тогда
			Для каждого СтрПоправка Из Расценка.Поправка Цикл
				НовПоправка 					= НовыйПозиция.ПоправкиПозиции.Добавить();
				НовПоправка.Обоснование 		= ?(ТипЗнч(СтрПоправка.Шифр) = Тип("ОбъектXDTO"),"",СтрПоправка.Шифр);
				НовПоправка.УсловияПрименения 	= ?(ТипЗнч(СтрПоправка.Наименование) = Тип("ОбъектXDTO"),"",СтрПоправка.Наименование);
				НовПоправка.КоэффОЗ 			= СтрПоправка.пЗП;
