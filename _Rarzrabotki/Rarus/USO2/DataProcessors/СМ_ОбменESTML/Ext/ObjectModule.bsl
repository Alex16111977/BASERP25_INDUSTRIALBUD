
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Выгрузка

// // // // // // Выгрузка// // // // // // // /

// Процедура выгружает Локальные сметы в каталог, каждой смете соответствует свой файл. 
// ПАРАМЕТРЫ:
// // МассивСмет - массив ссылок для выборки смет
// // Путь - каталог для сохранения файлов.
Процедура ВыгрузитьНаСервере(Путь,МассивСмет,АдресФайлаВоВременномХранилище = "",ИмяВременногоФайла = "",ЭтоВеб = Ложь)  Экспорт
	estml = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "estml"));
	ТипЛС = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "ЛокальнаяСмета");
	
	АдресФайлаВоВременномХранилище = Новый Соответствие;		
	
	Для Каждого СтрокаЛС Из МассивСмет Цикл
		// Выгружаем через XDTO  
		ЗаписьXML  = Новый ЗаписьXML;
		Номер = Строка(СтрокаЛС.НомерСметы);
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(Номер,"_");
		Если ЭтоВеб Тогда
			ЗаписьXML.ОткрытьФайл(Путь+"\smeta_"+ИмяФайла+".estml", "UTF-8");
		Иначе
			ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла,"UTF-8");  		
		КонецЕсли;
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЛССтрокаXDTO = ФабрикаXDTO.Создать(ТипЛС);
		ЛССтрокаXDTO.Номер = ЗаполнитьЗначениеСтрокТипа(СтрокаЛС.НомерСметы);
		ЛССтрокаXDTO.Дата = ЗаполнитьЗначениеСтрокТипа(Формат(СтрокаЛС.Дата,"ДФ=dd.MM.yyyy"));
		Составил = СтрокаЛС.Подписи.Найти("Составил","Статус");
		Если Не Составил=Неопределено Тогда
			ЛССтрокаXDTO.Составил = ЗаполнитьЗначениеСтрокТипа(Составил.ФИО);
		КонецЕсли;
		Проверил = СтрокаЛС.Подписи.Найти("Проверил","Статус");
		Если Не Проверил=Неопределено Тогда
			ЛССтрокаXDTO.Проверил = ЗаполнитьЗначениеСтрокТипа(Проверил.ФИО);
		КонецЕсли;
		ЛССтрокаXDTO.Объект = ЗаполнитьЗначениеОбъект(СтрокаЛС);
		Если ЗначениеЗаполнено(СтрокаЛС.Заказчик) Тогда
			ЛССтрокаXDTO.Заказчик = ЗаполнитьЗначениеОрганизации(СтрокаЛС.Заказчик);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаЛС.Подрядчик) Тогда
			ЛССтрокаXDTO.Подрядчик = ЗаполнитьЗначениеОрганизации(СтрокаЛС.Подрядчик);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаЛС.Организация) Тогда
			ЛССтрокаXDTO.ПроектнаяОрганизация = ЗаполнитьЗначениеОрганизации(СтрокаЛС.Организация);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаЛС.Инвестор) Тогда
			ЛССтрокаXDTO.Инвестор = ЗаполнитьЗначениеОрганизации(СтрокаЛС.Инвестор);
		КонецЕсли;
		
		Затраты = ПолучитьИтогиЗатрат(СтрокаЛС,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиПоСмете.ВсегоПоСмете)");
		НР = ПолучитьИтогиЗатрат(СтрокаЛС,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиПоСмете.НаклРасх)");
		СП = ПолучитьИтогиЗатрат(СтрокаЛС,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиПоСмете.СметПрибыль)");
		
		ЛССтрокаXDTO.ЗП = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗП));
		ЛССтрокаXDTO.ЭМ = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЭМ));
		ЛССтрокаXDTO.ЗПМ = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗПМ));
		ЛССтрокаXDTO.МР = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.МР));
		ЛССтрокаXDTO.ЗТР = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗТР));
		ЛССтрокаXDTO.ЗТМ = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗТМ));
		ЛССтрокаXDTO.Мусор = ЗаполнитьЗначениеЧислоТипа(0);
		ЛССтрокаXDTO.НР = ЗаполнитьЗначениеЧислоТипа(?(НР=0,0,НР.ПЗ));
		ЛССтрокаXDTO.СП = ЗаполнитьЗначениеЧислоТипа(?(НР=0,0,СП.ПЗ));
		ЛССтрокаXDTO.Итого = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ПЗ));
		ЛССтрокаXDTO.Неуч = ЗаполнитьЗначениеЧислоТипа(0);
		СНБ = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду(СтрокаЛС.КодРегионаФайлаИндексовПересчета);
		Если Не СНБ.Пустая() Тогда
			ЛССтрокаXDTO.Индексы = ЗаполнитьЗначениеИндексов(СНБ,СтрокаЛС);
		КонецЕсли;
		ЛССтрокаXDTO.Строительство = ПолучитьИтогиВидыРабот(СтрокаЛС,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.СтроитРаб)");
		ЛССтрокаXDTO.Монтаж = ПолучитьИтогиВидыРабот(СтрокаЛС,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб)");
		ЛССтрокаXDTO.Оборудование = ПолучитьИтогиВидыРабот(СтрокаЛС,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.Оборуд)");
		ЛССтрокаXDTO.Прочее = ПолучитьИтогиВидыРабот(СтрокаЛС,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ПрочРаб)");
		ЛССтрокаXDTO.Возврат = ЗаполнитьЗначениеЧислоТипа(0);
		
		Итого = ЛССтрокаXDTO.Строительство.__content+ЛССтрокаXDTO.Монтаж.__content+ЛССтрокаXDTO.Оборудование.__content+ЛССтрокаXDTO.Прочее.__content;
		ЛССтрокаXDTO.ИтогоНачислений = ЗаполнитьЗначениеЧислоТипа(Итого);
		
		Если ПолучитьФункциональнуюОпцию("СМ_ИспользованиеУчетаВыполненныхРабот") Тогда
			ВыборкаАктов = НайтиАкты(СтрокаЛС);
			Пока ВыборкаАктов.Следующий() Цикл
				АктXDTO = ЗаполнитьЗначениеАкт(ВыборкаАктов.Ссылка); 
				ЛССтрокаXDTO.Акт.Добавить(АктXDTO);
			КонецЦикла;
		КонецЕсли;
		
		ВыборкаРазделов = НайтиРазделы(СтрокаЛС);
		Пока ВыборкаРазделов.Следующий() Цикл
			РазделXDTO = ЗаполнитьЗначениеРаздел(ВыборкаРазделов,СтрокаЛС); 
			ЛССтрокаXDTO.Раздел.Добавить(РазделXDTO);
		КонецЦикла;

		Для каждого Начисление Из СтрокаЛС.ЛимитированныеЗатраты Цикл
			НачислениеXDTO = ЗаполнитьЗначениеНачисление(Начисление,СтрокаЛС); 
			ЛССтрокаXDTO.Начисление.Добавить(НачислениеXDTO);
		КонецЦикла;

		
		estml.ЛокальнаяСмета = ЛССтрокаXDTO;
		ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, estml);
		ЗаписьXML.Закрыть();
		Если Не ЭтоВеб Тогда
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
			АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
			АдресФайлаВоВременномХранилище.Вставить("\smeta_"+ИмяФайла+".estml",АдресФайла);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЗаполнитьЗначениеАкт(Акт) 
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "Акт");
	АктXDTO = ФабрикаXDTO.Создать(Тип);
	АктXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(Акт.ЛокальнаяСмета.Наименование);
	АктXDTO.Дата = ЗаполнитьЗначениеСтрокТипа(Акт.Дата);
	Составил = Акт.Подписи.Найти("Составил","Статус");
	Если Не Составил=Неопределено Тогда
		АктXDTO.Составил = ЗаполнитьЗначениеСтрокТипа(Составил.ФИО);
	КонецЕсли;
	Проверил = Акт.Подписи.Найти("Проверил","Статус");
	Если Не Проверил=Неопределено Тогда
		АктXDTO.Проверил = ЗаполнитьЗначениеСтрокТипа(Проверил.ФИО);
	КонецЕсли;
	АктXDTO.Объект = ЗаполнитьЗначениеОбъект(Акт);
	АктXDTO.Заказчик = ЗаполнитьЗначениеОрганизации(Акт.Заказчик);
	АктXDTO.Подрядчик = ЗаполнитьЗначениеОрганизации(Акт.Подрядчик);
	АктXDTO.Инвестор = ЗаполнитьЗначениеОрганизации(Акт.Инвестор);

	Затраты = ПолучитьИтогиЗатрат(Акт,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиПоСмете.ВсегоПоСмете)");
	НР = ПолучитьИтогиЗатрат(Акт,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиПоСмете.НаклРасх)");
	СП = ПолучитьИтогиЗатрат(Акт,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиПоСмете.СметПрибыль)");
	
	АктXDTO.ЗП = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗП));
	АктXDTO.ЭМ = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЭМ));
	АктXDTO.ЗПМ = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗПМ));
	АктXDTO.МР = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.МР));
	АктXDTO.ЗТР = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗТР));
	АктXDTO.ЗТМ = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗТМ));
	АктXDTO.Мусор = ЗаполнитьЗначениеЧислоТипа(0);
	АктXDTO.НР = ЗаполнитьЗначениеЧислоТипа(?(НР=0,0,НР.ПЗ));
	АктXDTO.СП = ЗаполнитьЗначениеЧислоТипа(?(НР=0,0,СП.ПЗ));
	АктXDTO.Итого = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ПЗ));
	АктXDTO.Неуч = ЗаполнитьЗначениеЧислоТипа(0);
	
	АктXDTO.Строительство = ПолучитьИтогиВидыРабот(Акт,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.СтроитРаб)");
	АктXDTO.Монтаж = ПолучитьИтогиВидыРабот(Акт,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.МонтажнРаб)");
	АктXDTO.Оборудование = ПолучитьИтогиВидыРабот(Акт,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.Оборуд)");
	АктXDTO.Прочее = ПолучитьИтогиВидыРабот(Акт,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиСметыПоВидамРабот.ПрочРаб)");
	АктXDTO.Возврат = ЗаполнитьЗначениеЧислоТипа(0);
	
	Итого = АктXDTO.Строительство.__content+АктXDTO.Монтаж.__content+АктXDTO.Оборудование.__content+АктXDTO.Прочее.__content;
	АктXDTO.ИтогоНачислений = ЗаполнитьЗначениеЧислоТипа(Итого);

	Для каждого Раздел Из Акт.Разделы Цикл
		РазделXDTO = ЗаполнитьЗначениеРаздел(Раздел,Акт); 
		АктXDTO.Раздел.Добавить(РазделXDTO);
	КонецЦикла;
	
	Для каждого Начисление Из Акт.ЛимитированныеЗатраты Цикл
		НачислениеXDTO = ЗаполнитьЗначениеНачисление(Начисление,Акт); 
		АктXDTO.Начисление.Добавить(НачислениеXDTO);
	КонецЦикла;

	
	Возврат АктXDTO;	
КонецФункции

Функция ЗаполнитьЗначениеНачисление(Начисление,АктСмета) 
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "СметаНачисление");
	НачислениеXDTO = ФабрикаXDTO.Создать(Тип);
	НачислениеXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(Начисление.ЛимитированнаяЗатрата.Наименование);
	Если  Начисление.ЛимитированнаяЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент Тогда
		Ставка = (Начисление.ЗначениеЛимЗатраты/100)+1;
	ИначеЕсли Начисление.ЛимитированнаяЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Коэффициент Тогда
		Ставка = Начисление.ЗначениеЛимЗатраты+1;
	ИначеЕсли Начисление.ЛимитированнаяЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Индекс Тогда
		Ставка = Начисление.ЗначениеЛимЗатраты;
	Иначе
		Ставка = 1;
	КонецЕсли;
	НачислениеXDTO.Ставка = ЗаполнитьЗначениеЧислоТипа(Ставка);
	НачислениеXDTO.Значение = ЗаполнитьЗначениеЧислоТипа(Начисление.ЗначениеЛимЗатраты);
	Итог = ПолучитьИтогНачисления(Начисление.ЛимитированнаяЗатрата,АктСмета);
	НачислениеXDTO.Итог = ЗаполнитьЗначениеЧислоТипа(Итог);
	Возврат НачислениеXDTO;	
КонецФункции

Функция ЗаполнитьЗначениеРаздел(СтрокаРаздел,АктСмета)
	
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "Раздел");
	РазделXDTO = ФабрикаXDTO.Создать(Тип);
	РазделXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(СтрокаРаздел.Раздел.НаименованиеДляПечати);
	Затраты = ПолучитьИтогиЗатратРаздела(СтрокаРаздел.Раздел,АктСмета,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиПоРазделу.ВсегоПоРазделу)");
	НР = ПолучитьИтогиЗатратРаздела(СтрокаРаздел.Раздел,АктСмета,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиПоРазделу.НаклРасх)");
	СП = ПолучитьИтогиЗатратРаздела(СтрокаРаздел.Раздел,АктСмета,"ЗНАЧЕНИЕ(Справочник.СМ_ИтогиПоРазделу.СметПрибыль)");
	
	РазделXDTO.ЗП = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗП));
	РазделXDTO.ЭМ = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЭМ));
	РазделXDTO.ЗПМ = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗПМ));
	РазделXDTO.МР = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.МР));
	РазделXDTO.ЗТР = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗТР));
	РазделXDTO.ЗТМ = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ЗТМ));
	РазделXDTO.Мусор = ЗаполнитьЗначениеЧислоТипа(0);
	РазделXDTO.НР = ЗаполнитьЗначениеЧислоТипа(?(НР=0,0,НР.ПЗ));
	РазделXDTO.СП = ЗаполнитьЗначениеЧислоТипа(?(НР=0,0,СП.ПЗ));
	РазделXDTO.Итого = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ПЗ));
	РазделXDTO.Неуч = ЗаполнитьЗначениеЧислоТипа(0);
	
	РазделXDTO.ИтогоНачислений = ЗаполнитьЗначениеЧислоТипа(?(Затраты=0,0,Затраты.ПЗ));
	
    ВыборкаРасценок =  НайтиРасценки(СтрокаРаздел.Раздел);
	Пока ВыборкаРасценок.Следующий() Цикл
		Если ТипЗнч(АктСмета) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
			СтрРасценки = АктСмета.Позиции.Найти(ВыборкаРасценок.Ссылка,"Позиция");
			Если СтрРасценки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		РасценкаXDTO = ЗаполнитьЗначениеРасценка(ВыборкаРасценок.Ссылка,АктСмета); 
		РазделXDTO.Расценка.Добавить(РасценкаXDTO);
	КонецЦикла;
	

	Возврат РазделXDTO;
КонецФункции

Функция ЗаполнитьЗначениеРасценка(Расценка,АктСмета)
	
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "Расценка");
	РасценкаXDTO = ФабрикаXDTO.Создать(Тип);
	РасценкаXDTO.Шифр = ЗаполнитьЗначениеСтрокТипа(Расценка.ШифрРасценки);
	РасценкаXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(Расценка.Наименование);
	Если ТипЗнч(АктСмета) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		СтрРасценки = АктСмета.Позиции.Найти(Расценка,"Позиция");
		Объем = СтрРасценки.ФактОбъем;
	Иначе
		Объем = Расценка.ОбъемРабот;
	КонецЕсли;
	РасценкаXDTO.Количество = ЗаполнитьЗначениеЧислоТипа(Объем);
	РасценкаXDTO.ЕдИзм = ЗаполнитьЗначениеСтрокТипа(Расценка.ЕдиницаИзмерения.Наименование);
	Если Расценка.ИДСметы.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
		Затраты = ПолучитьИтогиЗатратПозиции(Расценка);
		ЗП = ?(Затраты=0,0,Затраты.ЗП);
		ЭМ = ?(Затраты=0,0,Затраты.ЭМ);
		ЗПМ = ?(Затраты=0,0,Затраты.ЗПМ);
		МР = ?(Затраты=0,0,Затраты.МР);
		ЗТР = ?(Затраты=0,0,Затраты.ЗТР);
		ЗТМ = ?(Затраты=0,0,Затраты.ЗТМ);
		ПЗ = ?(Затраты=0,0,Затраты.ПЗ);
		Оборудование = ?(Затраты=0,0,Затраты.Оборудование);
	Иначе
		ЗП = Расценка.ОснЗарплата;
		ЭМ = Расценка.ЭксплМашин;
		ЗПМ = Расценка.ТекущаяЗарплатаМашинистов;
		МР = Расценка.СтоимМатериалов;
		ЗТР = Расценка.ЗатратыТрудаРабочих;
		ЗТМ = Расценка.ЗатратыТрудаМашинистов;
		ПЗ = Расценка.ПрямЗатраты;
		Оборудование = Расценка.Оборудование;
	КонецЕсли;
	
	НРСП = ПолучитьИтогиЗатратПозицииНРиСП(Расценка);
	
	НРПЗ = Расценка.НакладныеРасходыТекущие;
	СППЗ = Расценка.СметнаяПрибыльТекущие;

	
	РасценкаXDTO.ЗП = ЗаполнитьЗначениеЧислоТипа(ЗП);
	РасценкаXDTO.ЭМ = ЗаполнитьЗначениеЧислоТипа(ЭМ);
	РасценкаXDTO.ЗПМ = ЗаполнитьЗначениеЧислоТипа(ЗПМ);
	РасценкаXDTO.МР = ЗаполнитьЗначениеЧислоТипа(МР);
	РасценкаXDTO.ЗТР = ЗаполнитьЗначениеЧислоТипа(ЗТР);
	РасценкаXDTO.ЗТМ = ЗаполнитьЗначениеЧислоТипа(ЗТМ);
	РасценкаXDTO.Мусор = ЗаполнитьЗначениеЧислоТипа(0);
	РасценкаXDTO.НР = ЗаполнитьЗначениеЧислоТипа(НРПЗ);
	РасценкаXDTO.СП = ЗаполнитьЗначениеЧислоТипа(СППЗ);
	РасценкаXDTO.Всего = ЗаполнитьЗначениеЧислоТипа(ПЗ);
	РасценкаXDTO.Неуч = ЗаполнитьЗначениеЧислоТипа(0);
	
	РасценкаXDTO.ВсегоПлюс = ЗаполнитьЗначениеЧислоТипа(ПЗ);
	РасценкаXDTO.Оборудование = ЗаполнитьЗначениеЧислоТипа(Оборудование);
	РасценкаXDTO.кЗИМ = ЗаполнитьЗначениеЧислоТипа(Расценка.ЗимнееУдорож);
	
	пЗП = 1;
	пЭМ = 1;
	пЗПМ = 1;
	пЗТР = 1;
	пЗТМ = 1;
	пМР = 1;

	Для каждого Поправка Из Расценка.ПоправкиПозиции Цикл
		Если Не Поправка.Применить Тогда
			Продолжить;
		КонецЕсли;
		пЗП = пЗП * ?(Поправка.КоэффПЗ=0,?(Поправка.КоэффОЗ=0,1,Поправка.КоэффОЗ),Поправка.КоэффПЗ); 
		пЭМ = пЭМ * ?(Поправка.КоэффПЗ=0,?(Поправка.КоэффЭМ=0,1,Поправка.КоэффЭМ),Поправка.КоэффПЗ); 
		пЗПМ = пЗПМ * ?(Поправка.КоэффПЗ=0,?(Поправка.КоэффЗМ=0,1,Поправка.КоэффЗМ),Поправка.КоэффПЗ); 
		пЗТР = пЗТР * ?(Поправка.КоэффПЗ=0,?(Поправка.КоэффТР=0,1,Поправка.КоэффТР),Поправка.КоэффПЗ); 
		пЗТМ = пЗТМ * ?(Поправка.КоэффПЗ=0,?(Поправка.КоэффТМ=0,1,Поправка.КоэффТМ),Поправка.КоэффПЗ); 
		пМР = пМР * ?(Поправка.КоэффПЗ=0,?(Поправка.КоэффСМ=0,1,Поправка.КоэффСМ),Поправка.КоэффПЗ); 
	КонецЦикла;
	                                                     	
	РасценкаXDTO.пЗП = ЗаполнитьЗначениеЧислоТипа(пЗП);
	РасценкаXDTO.пЭМ = ЗаполнитьЗначениеЧислоТипа(пЭМ);
	РасценкаXDTO.пЗПМ = ЗаполнитьЗначениеЧислоТипа(пЗПМ);
	РасценкаXDTO.пЗТР = ЗаполнитьЗначениеЧислоТипа(пЗТР);
	РасценкаXDTO.пЗТМ = ЗаполнитьЗначениеЧислоТипа(пЗТМ);
	РасценкаXDTO.пМР = ЗаполнитьЗначениеЧислоТипа(пМР);
	РасценкаXDTO.пМусор = ЗаполнитьЗначениеЧислоТипа(0);
	
	
	
	Если Расценка.ИДСметы.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
		И Расценка.ИДСметы.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
		Затраты = СтоимостьПозицииСКоэффициентамиПересчета(Расценка);
	Иначе
		Затраты = СтоимостьПозицииСНачислениямиПоправкамиИЧП(Расценка);
	КонецЕсли;
	иЗП = ?(Затраты=0,0,Затраты.ЗП)*Объем;
	иЭМ = ?(Затраты=0,0,Затраты.ЭМ)*Объем;
	иЗПМ = ?(Затраты=0,0,Затраты.ЗПМ)*Объем;
	иМР = ?(Затраты=0,0,Затраты.МР)*Объем;
	иЗТР = ?(Затраты=0,0,Затраты.ЗТР)*Объем;
	иЗТМ = ?(Затраты=0,0,Затраты.ЗТМ)*Объем;
	ПЗ = ?(Затраты=0,0,Затраты.ПЗ);
	Оборудование = ?(Затраты=0,0,Затраты.Оборудование*Объем);
	
	иНРСП = ПолучитьИтогиЗатратПозицииНРиСПИтог(Расценка);
	
	иНР = ?(иНРСП = 0,0,иНРСП.НР)*Объем;
	иСП = ?(иНРСП = 0,0,иНРСП.СП)*Объем;
	
	РасценкаXDTO.иЗП = ЗаполнитьЗначениеЧислоТипа(иЗП);
	РасценкаXDTO.иЭМ = ЗаполнитьЗначениеЧислоТипа(иЭМ);
	РасценкаXDTO.иЗПМ = ЗаполнитьЗначениеЧислоТипа(иЗПМ);
	РасценкаXDTO.иЗТР = ЗаполнитьЗначениеЧислоТипа(иЗТР);
	РасценкаXDTO.иЗТМ = ЗаполнитьЗначениеЧислоТипа(иЗТМ);
	РасценкаXDTO.иМР = ЗаполнитьЗначениеЧислоТипа(иМР);
	РасценкаXDTO.иНР = ЗаполнитьЗначениеЧислоТипа(иНР);
	РасценкаXDTO.иСП = ЗаполнитьЗначениеЧислоТипа(иСП);
	
	РасценкаXDTO.иМусор = ЗаполнитьЗначениеЧислоТипа(0);
	РасценкаXDTO.иЗИМ = ЗаполнитьЗначениеЧислоТипа(0);
	РасценкаXDTO.иОборудование = ЗаполнитьЗначениеЧислоТипа(Оборудование);
	
	Для каждого Поправка Из Расценка.ПоправкиПозиции Цикл
		ПоправкаXDTO = ЗаполнитьЗначениеПоправка(Поправка,Расценка); 
		РасценкаXDTO.Поправка.Добавить(ПоправкаXDTO);
	КонецЦикла;

	Если  Расценка.КоэффициентыПересчета.Количество()>0 Тогда
		Индекс = Расценка.КоэффициентыПересчета[0];
		ИндексXDTO = ЗаполнитьЗначениеИндексы(Индекс,Расценка); 
		РасценкаXDTO.Индекс = ИндексXDTO;
	КонецЕсли;
	
	Для каждого Ресурс Из Расценка.РесурсыПозицииЛокальнойСметы Цикл
		РесурсXDTO = ЗаполнитьЗначениеРесурс(Ресурс,Расценка,Объем); 
		РасценкаXDTO.Ресурс.Добавить(РесурсXDTO);
	КонецЦикла;

	Для каждого Работа Из Расценка.СоставРабот Цикл
		РаботаXDTO = ЗаполнитьЗначениеРабота(Работа); 
		РасценкаXDTO.Работа.Добавить(РаботаXDTO);
	КонецЦикла;

	
	Возврат РасценкаXDTO;
КонецФункции

Функция ЗаполнитьЗначениеРабота(Значение) 
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "Работа");
	ОбъектXDTO = ФабрикаXDTO.Создать(Тип);
	ОбъектXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(Значение.НаименованиеРаботы);
	Возврат ОбъектXDTO;	
КонецФункции

Функция ЗаполнитьЗначениеРесурс(Ресурс,Расценка,Объем) 
	
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "Ресурс");
	РесурсXDTO = ФабрикаXDTO.Создать(Тип);
	РесурсXDTO.Шифр = ЗаполнитьЗначениеСтрокТипа(Ресурс.СметныйКодРесурса);
	РесурсXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(Ресурс.Ресурс.ДлинноеНаименование);
	РесурсXDTO.ЕдИзм = ЗаполнитьЗначениеСтрокТипа(Ресурс.Ресурс.ЕдиницаИзмерения.Наименование);
	
	ДанныеРесурса = ПолучитьДанныеРесурса(Ресурс,Расценка);
	
	РесурсXDTO.Количество = ЗаполнитьЗначениеЧислоТипа(?(ДанныеРесурса=0,0,ДанныеРесурса.Количество));
	РесурсXDTO.Расход = ЗаполнитьЗначениеЧислоТипа(Ресурс.НормаРасхода);
	РесурсXDTO.Возврат = ЗаполнитьЗначениеЧислоТипа(0);
	
	Если Расценка.ИДСметы.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
		Цена = Ресурс.БазиснаяЦена;
	Иначе
		Цена = Ресурс.ТекущаяЦена;
	КонецЕсли;

	РесурсXDTO.Цена = ЗаполнитьЗначениеЧислоТипа(Цена);
	
	кРЕС = 0;
	РесурсXDTO.пРЕС = ЗаполнитьЗначениеЧислоТипа(Ресурс.КоэффициентКРасходуРесурсов);
	РесурсXDTO.кРЕС = ЗаполнитьЗначениеЧислоТипа(кРЕС);
	РесурсXDTO.иРЕС = ЗаполнитьЗначениеЧислоТипа(?(ДанныеРесурса=0,0,ДанныеРесурса.Цена));
	РесурсXDTO.иЗИМр = ЗаполнитьЗначениеЧислоТипа(1);
	РесурсXDTO.кЗИМр = ЗаполнитьЗначениеЧислоТипа(1);
	Возврат РесурсXDTO;	
	
КонецФункции

Функция ЗаполнитьЗначениеИндексы(Индекс,Расценка) 
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "Коэффициент");
	ИндексXDTO = ФабрикаXDTO.Создать(Тип);
	ИндексXDTO.Шифр = ЗаполнитьЗначениеСтрокТипа(Расценка.ШифрРасценки);
	ИндексXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(Расценка.Наименование);
	ИндексXDTO.кЗП = ЗаполнитьЗначениеЧислоТипа(Индекс.КоэффОснЗарплаты);
	ИндексXDTO.кЭМ = ЗаполнитьЗначениеЧислоТипа(Индекс.КоэффСтоимЭксплМашин);
	ИндексXDTO.кЗПМ = ЗаполнитьЗначениеЧислоТипа(Индекс.КоэффСтоимЗарплатеМашин);
	ИндексXDTO.кЗТР = ЗаполнитьЗначениеЧислоТипа(1);
	ИндексXDTO.кЗТМ = ЗаполнитьЗначениеЧислоТипа(1);
	ИндексXDTO.кМР = ЗаполнитьЗначениеЧислоТипа(Индекс.КоэффСтоимМатериалов);
	ИндексXDTO.кМусор = ЗаполнитьЗначениеЧислоТипа(0);

	Возврат ИндексXDTO;	
КонецФункции

Функция ЗаполнитьЗначениеПоправка(Поправка,Расценка) 
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "Поправка");
	ПоправкаXDTO = ФабрикаXDTO.Создать(Тип);
	ПоправкаXDTO.Шифр = ЗаполнитьЗначениеСтрокТипа(Поправка.Обоснование);
	ПоправкаXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(Поправка.УсловияПрименения);
	ПоправкаXDTO.пЗП = ЗаполнитьЗначениеЧислоТипа(Поправка.КоэффОЗ);
	ПоправкаXDTO.пЭМ = ЗаполнитьЗначениеЧислоТипа(Поправка.КоэффЭМ);
	ПоправкаXDTO.пЗПМ = ЗаполнитьЗначениеЧислоТипа(Поправка.КоэффЗМ);
	ПоправкаXDTO.пЗТР = ЗаполнитьЗначениеЧислоТипа(Поправка.КоэффТР);
	ПоправкаXDTO.пЗТМ = ЗаполнитьЗначениеЧислоТипа(Поправка.КоэффТМ);
	ПоправкаXDTO.пМР = ЗаполнитьЗначениеЧислоТипа(Поправка.КоэффСМ);
	ПоправкаXDTO.пМусор = ЗаполнитьЗначениеЧислоТипа(0);

	Возврат ПоправкаXDTO;	
КонецФункции

Функция ЗаполнитьЗначениеЧислоТипа(Значение) 
