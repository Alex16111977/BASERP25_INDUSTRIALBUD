КонецФункции

Функция ЗаполнитьЗначениеОбъект(Значение)
	
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "Объект");
	ОбъектXDTO = ФабрикаXDTO.Создать(Тип);
	ОбъектXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(Значение.Стройка.Наименование);
	ОбъектXDTO.Код = ЗаполнитьЗначениеСтрокТипа(Значение.Стройка.Наименование);
