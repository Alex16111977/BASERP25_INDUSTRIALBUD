КонецФункции

Функция ЗаполнитьЗначениеОрганизации(Значение)
	
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "Организация");
	ОбъектXDTO = ФабрикаXDTO.Создать(Тип);
	ОбъектXDTO.ФИО = ЗаполнитьЗначениеСтрокТипа(Значение.Наименование);
	ОбъектXDTO.Наименование = ЗаполнитьЗначениеСтрокТипа(Значение.Наименование);
	Возврат ОбъектXDTO;	
	
КонецФункции

Функция ЗаполнитьЗначениеИндексов(Значение,Смета)  
	Тип = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "СНБ");
	ОбъектXDTO = ФабрикаXDTO.Создать(Тип);
	ОбъектXDTO.Тип = ЗаполнитьЗначениеСтрокТипа(Значение.УровеньБазы);
	ОбъектXDTO.Год = ЗаполнитьЗначениеЦелогоТипа(Год(Смета.ДатаВыпускаИндексов));
	ОбъектXDTO.Месяц = ЗаполнитьЗначениеЦелогоТипа(Месяц(Смета.ДатаВыпускаИндексов));
	ОбъектXDTO.Область = ЗаполнитьЗначениеСтрокТипа(Значение.КодРегиона);
	ОбъектXDTO.Версия = ЗаполнитьЗначениеЦелогоТипа(Значение.Версия);
	Возврат ОбъектXDTO;	
КонецФункции

Функция НайтиРазделы(Смета) 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_РазделЛокальнойСметы.Ссылка КАК Раздел
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	               |ГДЕ
	               |	СМ_РазделЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
	               |	И СМ_РазделЛокальнойСметы.ИДСметы = &Смета
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_РазделЛокальнойСметы.Номер";
	Запрос.УстановитьПараметр("Смета",Смета);
	
	Возврат Запрос.Выполнить().Выбрать();
КонецФункции

Функция НайтиРасценки(Раздел) 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ПозицияЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	               |ГДЕ
	               |	СМ_ПозицияЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
	               |	И СМ_ПозицияЛокальнойСметы.ИДРодителя = &Раздел
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_ПозицияЛокальнойСметы.Номер";
	Запрос.УстановитьПараметр("Раздел",Раздел);
	
	Возврат Запрос.Выполнить().Выбрать();
