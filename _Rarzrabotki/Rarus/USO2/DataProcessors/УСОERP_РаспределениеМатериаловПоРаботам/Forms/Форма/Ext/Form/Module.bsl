
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьПривилегированныйРежим(Истина);	
	Период.Вариант = ВариантСтандартногоПериода.Вчера;
	ДатаПотребности = КонецМесяца(ТекущаяДата());
	//ТолькоНераспределенные = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СкладПриИзменении(Элемент)
	
	Если Склад<> ТекущийСклад Тогда	
	ЗаполнитьТаблицуДокументов();
	ТекущийСклад = Склад;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПотребностиПриИзменении(Элемент)
ЗаполнитьТаблицуДокументов();	
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)  

ЗаполнитьТаблицуДокументов();

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоДанныхНаСервере()
	
	Дерево = РеквизитФормыВЗначение("ДеревоДанных");
	Дерево.Строки.Очистить();
	
	Если НЕ ЗначениеЗаполнено(Склад.УСОERP_ОбъектСтроительства) ИЛИ 
		Склад.УСОERP_ОбъектСтроительства.УСОERP_ВестиРаспределениеМатериаловПоРаботам = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ТабДок = РеквизитФормыВЗначение("ТаблицаДокументов");
	
	МассивДокументов = ТабДок.Скопировать(Новый Структура("Отбор",Истина)).ВыгрузитьКолонку("Документ");
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивДокументов",МассивДокументов);
	Запрос.УстановитьПараметр("ОбъектСтроительства",Склад.УСОERP_ОбъектСтроительства);
	Запрос.УстановитьПараметр("ДатаПотребности",КонецДня(ДатаПотребности));
	Запрос.УстановитьПараметр("Склад",Склад);
	Запрос.УстановитьПараметр("ТолькоНераспределенные",ТолькоНераспределенные);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслугТовары.Характеристика,
	|	ПоступлениеТоваровУслугТовары.Номенклатура,
	|	СУММА(ПоступлениеТоваровУслугТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ ВрТабМожноРаспределить
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|ГДЕ
	|	ПоступлениеТоваровУслугТовары.Ссылка В(&МассивДокументов)
	|	И ПоступлениеТоваровУслугТовары.Назначение.Заказ.ДокументОснование.ОбъектСтроительства = &ОбъектСтроительства
	|	И ПоступлениеТоваровУслугТовары.Назначение.Заказ.Склад = &Склад
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеТоваровУслугТовары.Характеристика,
	|	ПоступлениеТоваровУслугТовары.Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПриходныйОрдерНаТоварыТовары.Характеристика,
	|	ПриходныйОрдерНаТоварыТовары.Номенклатура,
	|	СУММА(ПриходныйОрдерНаТоварыТовары.Количество)
	|ИЗ
	|	Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерНаТоварыТовары
	|ГДЕ
	|	ПриходныйОрдерНаТоварыТовары.Ссылка В(&МассивДокументов)
	|	И ПриходныйОрдерНаТоварыТовары.Назначение.Заказ.ДокументОснование.ОбъектСтроительства = &ОбъектСтроительства
	|	И ПриходныйОрдерНаТоварыТовары.Назначение.Заказ.ДокументОснование.Склад = &Склад
	|
	|СГРУППИРОВАТЬ ПО
	|	ПриходныйОрдерНаТоварыТовары.Характеристика,
	|	ПриходныйОрдерНаТоварыТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Работа,
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Номенклатура,
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Характеристика,
	|	СУММА(УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Количество) КАК КоличествоПотребность,
	|	0 КАК КоличествоОборот,
	|	0 КАК КоличествоПотребностьОбщая
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	РегистрСведений.УСОERP_ПланыПотребностейВМатериалах.СрезПоследних(
	|			,
	|			Склад = &Склад
	|				И ДатаПлана <= &ДатаПотребности) КАК УСОERP_ПланыПотребностейВМатериалахСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Работа,
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Номенклатура,
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Характеристика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботамОбороты.СтроительнаяРабота,
	|	УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботамОбороты.Номенклатура,
	|	УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботамОбороты.Характеристика,
	|	0,
	|	СУММА(УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботамОбороты.КоличествоОборот),
	|	0
	|ИЗ
	|	РегистрНакопления.УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботам.Обороты(
	|			,
	|			,
	|			Авто,
	|			ОбъектСтроительства = &ОбъектСтроительства
	|				И Факт = ИСТИНА
	|				И Склад = &Склад) КАК УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботамОбороты
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ТолькоНераспределенные
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ НЕ УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботамОбороты.Регистратор В (&МассивДокументов)
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботамОбороты.СтроительнаяРабота,
	|	УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботамОбороты.Номенклатура,
	|	УСОERP_ЗакупленныеМатериалыПоОбъектамСтроительстваПоРаботамОбороты.Характеристика
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Работа,
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Номенклатура,
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Характеристика,
	|	0,
	|	0,
	|	УСОERP_ПланыПотребностейВМатериалахСрезПоследних.Количество
	|ИЗ
	|	РегистрСведений.УСОERP_ПланыПотребностейВМатериалах.СрезПоследних(, Склад = &Склад) КАК УСОERP_ПланыПотребностейВМатериалахСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Работа,
	|	ВрТаб.Номенклатура,
	|	ВрТаб.Характеристика,
	|	СУММА(ВрТаб.КоличествоПотребность) КАК КоличествоПотребность,
	|	СУММА(ВрТаб.КоличествоОборот) КАК КоличествоВНаличии,
	|	МАКСИМУМ(ЕСТЬNULL(ВложенныйЗапрос.КоличествоМожноРаспределить, 0)) КАК КоличествоМожноРаспределить,
	|	СУММА(ВрТаб.КоличествоПотребностьОбщая) КАК КоличествоПотребностьОбщая,
	|	ВрТаб.Работа.КодСДР КАК КодСДР
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВрТабМожноРаспределить.Характеристика КАК Характеристика,
	|			ВрТабМожноРаспределить.Номенклатура КАК Номенклатура,
	|			СУММА(ВрТабМожноРаспределить.Количество) КАК КоличествоМожноРаспределить
	|		ИЗ
	|			ВрТабМожноРаспределить КАК ВрТабМожноРаспределить
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВрТабМожноРаспределить.Характеристика,
	|			ВрТабМожноРаспределить.Номенклатура) КАК ВложенныйЗапрос
	|		ПО ВрТаб.Номенклатура = ВложенныйЗапрос.Номенклатура
	|			И ВрТаб.Характеристика = ВложенныйЗапрос.Характеристика
	|
	|СГРУППИРОВАТЬ ПО
	|	ВрТаб.Работа,
	|	ВрТаб.Номенклатура,
	|	ВрТаб.Характеристика";
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.НазначениеЗаказ КАК Заказ
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПоступлениеТоваровУслугТовары.Назначение.Заказ КАК НазначениеЗаказ
	|	ИЗ
	|		Документ.ПриобретениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|	ГДЕ
	|		ПоступлениеТоваровУслугТовары.Ссылка В(&МассивДокументов)
	|		И ПоступлениеТоваровУслугТовары.Назначение.Заказ.ДокументОснование ССЫЛКА Документ.УСОERP_ПланПотребностейВМатериалах
	|		И ПоступлениеТоваровУслугТовары.Назначение.Заказ.ДокументОснование.Склад = &Склад
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПриходныйОрдерНаТоварыТовары.Назначение.Заказ
	|	ИЗ
	|		Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерНаТоварыТовары
	|	ГДЕ
	|		ПриходныйОрдерНаТоварыТовары.Ссылка В(&МассивДокументов)
	|		И ПриходныйОрдерНаТоварыТовары.Назначение.Заказ.ДокументОснование.Склад = &Склад
	|		И ПриходныйОрдерНаТоварыТовары.Назначение.Заказ.ДокументОснование ССЫЛКА Документ.УСОERP_ПланПотребностейВМатериалах) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.НазначениеЗаказ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.СтроительнаяРабота,
	|	ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Номенклатура КАК Номенклатура,
	|	ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Характеристика КАК Характеристика
	|ПОМЕСТИТЬ ВрТаб_Работы
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказМатериаловВПроизводство.УСОERP_РаспределениеМатериаловПоРаботам КАК ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам
	|		ПО ВрТаб.Заказ = ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.СтроительнаяРабота,
	|	ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.Номенклатура,
	|	ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.Характеристика
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказНаВнутреннееПотребление.УСОERP_РаспределениеМатериаловПоРаботам КАК ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам
	|		ПО ВрТаб.Заказ = ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.СтроительнаяРабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб_Работы.СтроительнаяРабота КАК Работа,
	|	ВрТаб_Работы.Номенклатура,
	|	ВрТаб_Работы.Характеристика
	|ИЗ
	|	ВрТаб_Работы КАК ВрТаб_Работы
	|
	|СГРУППИРОВАТЬ ПО
	|	ВрТаб_Работы.Характеристика,
	|	ВрТаб_Работы.СтроительнаяРабота,
	|	ВрТаб_Работы.Номенклатура";
	
	ТаблицаНаличияРабот = Запрос.Выполнить().Выгрузить();
	
	ТабНоменклатуры = ТЗ.Скопировать();
	ТабНоменклатуры.Свернуть("Номенклатура,Характеристика,КоличествоМожноРаспределить","КоличествоПотребностьОбщая,КоличествоПотребность,КоличествоВНаличии");
	
	СтруктураОтбора = Новый Структура("Номенклатура,Характеристика");
	СтруктураОтбораРаботы = Новый Структура("Номенклатура,Характеристика,Работа");
	
	Для Каждого СтрокаНоменклатуры ИЗ ТабНоменклатуры Цикл
		
		Если СтрокаНоменклатуры.КоличествоМожноРаспределить = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		
		ЗаполнитьЗначенияСвойств(СтруктураОтбора,СтрокаНоменклатуры);
		
		СтрокаДерева = Дерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева,СтрокаНоменклатуры);
		СтрокаДерева.НоменклатураРабота = СтрокаНоменклатуры.Номенклатура;
		
		
		ТабРабот = ТЗ.Скопировать(СтруктураОтбора);
		ТабРабот.Сортировать("КодСДР");
		
		Для Каждого СтрокаРабот ИЗ ТабРабот Цикл
			
			ПодСтрока = СтрокаДерева.Строки.Добавить();
			ПодСтрока.НоменклатураРабота = СтрокаРабот.Работа;
			ПодСтрока.Характеристика = СтрокаРабот.Работа.КодСДР;
			ПодСтрока.КоличествоПотребность = СтрокаРабот.КоличествоПотребность;
			ПодСтрока.КоличествоПотребностьОбщая = СтрокаРабот.КоличествоПотребностьОбщая;
			ПодСтрока.КоличествоВНаличии = СтрокаРабот.КоличествоВНаличии; 
			ЗаполнитьЗначенияСвойств(СтруктураОтбораРаботы,СтрокаРабот);
			ПодСтрока.ЕстьВЗаказе = ТаблицаНаличияРабот.НайтиСтроки(СтруктураОтбораРаботы).Количество();
			ПодСтрока.КоличествоПотребностьМинусВНаличии = ПодСтрока.КоличествоПотребность-ПодСтрока.КоличествоВНаличии;
			ПодСтрока.УровеньСтроки = 1;
			
		КонецЦикла;	
		
		Если ТабРабот.Количество() = 1 Тогда
			
			ПодСтрока.КоличествоРаспределить = СтрокаДерева.КоличествоМожноРаспределить;
			СтрокаДерева.КоличествоРаспределить = СтрокаДерева.КоличествоМожноРаспределить;
			СтрокаДерева.Распределено = Истина;
			
		ИначеЕсли СтрокаДерева.КоличествоМожноРаспределить = ТабРабот.Итог("КоличествоПотребность") - ТабРабот.Итог("КоличествоВНаличии") Тогда
			
			СтрокаДерева.КоличествоРаспределить = СтрокаДерева.КоличествоМожноРаспределить;
			СтрокаДерева.Распределено = Истина;
			
			Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
				ПодСтрока.КоличествоРаспределить = ПодСтрока.КоличествоПотребность-ПодСтрока.КоличествоВНаличии;
			КонецЦикла; 			
				
		КонецЕсли;		
		
	КонецЦикла;
	
   ЗначениеВРеквизитФормы(Дерево,"ДеревоДанных");
   
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДокументов()
	
	ДеревоДанных.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад",Склад);
	Запрос.УстановитьПараметр("ДатаНачала",Период.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",Период.ДатаОкончания);
	Запрос.УстановитьПараметр("ТолькоНераспределенные",ТолькоНераспределенные);
			
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Ссылка КАК Ссылка,
