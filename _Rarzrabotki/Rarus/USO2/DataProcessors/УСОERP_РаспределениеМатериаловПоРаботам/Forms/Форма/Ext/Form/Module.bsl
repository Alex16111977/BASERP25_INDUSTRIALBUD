&НаСервере
Процедура КомандаРаспределитьНаСервере()
	
	Дерево = РеквизитФормыВЗначение("ДеревоДанных");
	
	СтруктураЕстьВЗаказе = Новый Структура("ЕстьВЗаказе",Истина);
	СтруктураНетВЗаказе = Новый Структура("ЕстьВЗаказе",Ложь);
	СтруктураНетПотребности = Новый Структура("КоличествоПотребность",0);
	СтруктураПотребностьЗакрыта = Новый Структура("КоличествоПотребностьМинусВНаличии",0);
	
	Для Каждого СтрокаДерева ИЗ Дерево.Строки Цикл
		
		Если СтрокаДерева.КоличествоМожноРаспределить > СтрокаДерева.КоличествоПотребностьОбщая-СтрокаДерева.КоличествоВНаличии Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДерева.Строки.Количество() = 1 Тогда
			
			ПодСтрока = СтрокаДерева.Строки.Получить(0);
			ПодСтрока.КоличествоРаспределить = СтрокаДерева.КоличествоМожноРаспределить;
			СтрокаДерева.Распределено = Истина;
			СтрокаДерева.КоличествоРаспределить = ПодСтрока.КоличествоРаспределить;
			Продолжить;
			
		КонецЕсли;		
		
		НадоРаспределить = СтрокаДерева.КоличествоМожноРаспределить;
		
		//сначала закрываем потребности, если есть.
		
		СтрокиЕстьВЗаказе = СтрокаДерева.Строки.НайтиСтроки(СтруктураЕстьВЗаказе);
		СтрокиНетПотребности = СтрокаДерева.Строки.НайтиСтроки(СтруктураНетПотребности);
		СтрокиПотребностьЗакрыта = СтрокаДерева.Строки.НайтиСтроки(СтруктураПотребностьЗакрыта);
		
		НадоРаспределитьПоСтрокам = 0;
		
		СтрокиДляПервогоРаспределения = Новый Массив;
		
		Для Каждого СтрокаЕстьВЗаказе ИЗ СтрокиЕстьВЗаказе Цикл
			
			Если СтрокиНетПотребности.Найти(СтрокаЕстьВЗаказе) <> Неопределено Тогда
				СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии = СтрокаЕстьВЗаказе.КоличествоПотребностьОбщая-СтрокаЕстьВЗаказе.КоличествоВНаличии;
				Продолжить;
			КонецЕсли;
			
			Если СтрокиПотребностьЗакрыта.Найти(СтрокаЕстьВЗаказе) <> Неопределено Тогда
				СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии = СтрокаЕстьВЗаказе.КоличествоПотребностьОбщая-СтрокаЕстьВЗаказе.КоличествоВНаличии;
				Продолжить;
			КонецЕсли; 	
			
			СтрокиДляПервогоРаспределения.Добавить(СтрокаЕстьВЗаказе);
			
			НадоРаспределитьПоСтрокам = НадоРаспределитьПоСтрокам+СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии;
			
		КонецЦикла;		
		
		Если НадоРаспределитьПоСтрокам < НадоРаспределить Тогда
			
			Коэффициент = 1;
			
		Иначе
			
			Коэффициент = НадоРаспределить/НадоРаспределитьПоСТрокам;
			
		КонецЕсли;
		
		Для Каждого СтрокаЕстьВЗаказе ИЗ СтрокиДляПервогоРаспределения Цикл
			
			СтрокаЕстьВЗаказе.КоличествоРаспределить = СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии*Коэффициент;
			НадоРаспределить = НадоРаспределить-СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии*Коэффициент;
			СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии = СтрокаЕстьВЗаказе.КоличествоПотребностьОбщая-СТрокаЕстьВЗаказе.КоличествоВНаличии-СтрокаЕстьВЗаказе.КоличествоРаспределить;
			
		КонецЦикла;
		
		НадоРаспределить = СтрокаДерева.КоличествоМожноРаспределить;
		КоличествоРаспределить = 0;
		
		Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
			
			НадоРаспределить = НадоРаспределить - ПодСтрока.КоличествоРаспределить;
			КоличествоРаспределить = КоличествоРаспределить+ПодСтрока.КоличествоРаспределить;
			
		КонецЦикла;
		
		Если НадоРаспределить = 0 Тогда
			
			СтрокаДерева.КоличествоРаспределить = КоличествоРаспределить;
			
			Продолжить;
		КонецЕсли; 		
				
		//остаток делим между строками, которые есть в заказе, но без потребности
		СтрокиПотребностьЗакрыта = СтрокаДерева.Строки.НайтиСтроки(СтруктураПотребностьЗакрыта);
		
		НадоРаспределитьПоСтрокам = 0;
		
		СтрокиДляПервогоРаспределения.Очистить();
		
		Для Каждого СтрокаЕстьВЗаказе ИЗ СтрокиЕстьВЗаказе Цикл
			
			Если СтрокиПотребностьЗакрыта.Найти(СтрокаЕстьВЗаказе) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НадоРаспределитьПоСтрокам = НадоРаспределитьПоСтрокам+СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии;
			СтрокиДляПервогоРаспределения.Добавить(СтрокаЕстьВЗаказе);
			
		КонецЦикла; 		
		
		Если НадоРаспределитьПоСтрокам < НадоРаспределить Тогда
			
			Коэффициент = 1;
			
		Иначе
			
			Коэффициент = НадоРаспределить/НадоРаспределитьПоСТрокам;			
			
		КонецЕсли; 		
		
		Для Каждого СтрокаЕстьВЗаказе ИЗ СтрокиДляПервогоРаспределения Цикл
			
			СтрокаЕстьВЗаказе.КоличествоРаспределить = СтрокаЕстьВЗаказе.КоличествоРаспределить+СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии*Коэффициент;
			НадоРаспределить = НадоРаспределить-СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии*Коэффициент;
			
			СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии = СтрокаЕстьВЗаказе.КоличествоПотребностьОбщая-СтрокаЕстьВЗаказе.КоличествоВНаличии-СтрокаЕстьВЗаказе.КоличествоРаспределить;			
			
		КонецЦикла;  
		
		НадоРаспределить = СтрокаДерева.КоличествоМожноРаспределить;
		КоличествоРаспределить = 0;
		
		Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
			
			НадоРаспределить = НадоРаспределить - ПодСтрока.КоличествоРаспределить;
			КоличествоРаспределить = КоличествоРаспределить+ПодСтрока.КоличествоРаспределить;
			
		КонецЦикла;
		
		Если НадоРаспределить = 0 Тогда
			
			СтрокаДерева.КоличествоРаспределить = КоличествоРаспределить;  			
			Продолжить;
			
		КонецЕсли;
		
		//остаток делим на все, что осталось, а осталось только то, что в заказы не входит.. Кажется			
		//То же самое 		
		//сначала закрываем потребности, если есть.
		
		СтрокиЕстьВЗаказе = СтрокаДерева.Строки.НайтиСтроки(СтруктураНетВЗаказе);
		СтрокиНетПотребности = СтрокаДерева.Строки.НайтиСтроки(СтруктураНетПотребности);
		СтрокиПотребностьЗакрыта = СтрокаДерева.Строки.НайтиСтроки(СтруктураПотребностьЗакрыта);
		
		НадоРаспределитьПоСтрокам = 0;
		
		СтрокиДляПервогоРаспределения = Новый Массив;
		
		Для Каждого СтрокаЕстьВЗаказе ИЗ СтрокиЕстьВЗаказе Цикл
			
			Если СтрокиНетПотребности.Найти(СтрокаЕстьВЗаказе) <> Неопределено Тогда
				
				СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии = СтрокаЕстьВЗаказе.КоличествоПотребностьОбщая-СтрокаЕстьВЗаказе.КоличествоВНаличии;
				Продолжить;
				
			КонецЕсли;
			
			Если СтрокиПотребностьЗакрыта.Найти(СтрокаЕстьВЗаказе) <> Неопределено Тогда
				
				СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии = СтрокаЕстьВЗаказе.КоличествоПотребностьОбщая-СтрокаЕстьВЗаказе.КоличествоВНаличии;
				Продолжить;
				
			КонецЕсли; 	
			
			СтрокиДляПервогоРаспределения.Добавить(СтрокаЕстьВЗаказе);
			
			НадоРаспределитьПоСтрокам = НадоРаспределитьПоСтрокам+СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии;
			
		КонецЦикла;	
		
		Если НадоРаспределитьПоСтрокам Тогда
		
		Если НадоРаспределитьПоСтрокам < НадоРаспределить Тогда
			
			Коэффициент = 1;
			
		Иначе
			
			Коэффициент = НадоРаспределить/НадоРаспределитьПоСТрокам;
			
		КонецЕсли;
		
		Для Каждого СтрокаЕстьВЗаказе ИЗ СтрокиДляПервогоРаспределения Цикл
			
			СтрокаЕстьВЗаказе.КоличествоРаспределить = СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии*Коэффициент;
			НадоРаспределить = НадоРаспределить-СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии*Коэффициент;
			СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии = СтрокаЕстьВЗаказе.КоличествоПотребностьОбщая-СТрокаЕстьВЗаказе.КоличествоВНаличии-СтрокаЕстьВЗаказе.КоличествоРаспределить;
			
		КонецЦикла;
		
		КонецЕсли;
		
		НадоРаспределить = СтрокаДерева.КоличествоМожноРаспределить;
		КоличествоРаспределить = 0;
		
		Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
			
			НадоРаспределить = НадоРаспределить - ПодСтрока.КоличествоРаспределить;
			КоличествоРаспределить = КоличествоРаспределить+ПодСтрока.КоличествоРаспределить;
			
		КонецЦикла;
		
		//Если НадоРаспределить <= 0 Тогда
			
		Если НадоРаспределить = 0 Тогда
			
			СтрокаДерева.КоличествоРаспределить = КоличествоРаспределить+(0+НадоРаспределить);
					
			Продолжить;
			
		КонецЕсли; 
		
		//остаток делим между строками, которые есть в заказе, но без потребности
		СтрокиПотребностьЗакрыта = СтрокаДерева.Строки.НайтиСтроки(СтруктураПотребностьЗакрыта);
		
		НадоРаспределитьПоСтрокам = 0;
		
		СтрокиДляПервогоРаспределения.Очистить();
		
		Для Каждого СтрокаЕстьВЗаказе ИЗ СтрокиЕстьВЗаказе Цикл
			
			Если СтрокиПотребностьЗакрыта.Найти(СтрокаЕстьВЗаказе) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НадоРаспределитьПоСтрокам = НадоРаспределитьПоСтрокам+СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии;
			СтрокиДляПервогоРаспределения.Добавить(СтрокаЕстьВЗаказе);
			
		КонецЦикла; 		
		
		Если НадоРаспределитьПоСтрокам < НадоРаспределить Тогда
			
			Коэффициент = 1;
			
		Иначе
			
			Коэффициент = НадоРаспределить/НадоРаспределитьПоСТрокам;			
			
		КонецЕсли; 		
		
		Для Каждого СтрокаЕстьВЗаказе ИЗ СтрокиДляПервогоРаспределения Цикл
			
			СтрокаЕстьВЗаказе.КоличествоРаспределить = СтрокаЕстьВЗаказе.КоличествоРаспределить+СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии*Коэффициент;
			НадоРаспределить = НадоРаспределить-СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии*Коэффициент;
			
			СтрокаЕстьВЗаказе.КоличествоПотребностьМинусВНаличии = СтрокаЕстьВЗаказе.КоличествоПотребностьОбщая-СтрокаЕстьВЗаказе.КоличествоВНаличии-СтрокаЕстьВЗаказе.КоличествоРаспределить;			
			
		КонецЦикла; 
		
		НадоРаспределить = СтрокаДерева.КоличествоМожноРаспределить;
		КоличествоРаспределить = 0;
		
		Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
			
			НадоРаспределить = НадоРаспределить - ПодСтрока.КоличествоРаспределить;
			КоличествоРаспределить = КоличествоРаспределить+ПодСтрока.КоличествоРаспределить;
			
		КонецЦикла;
		
		СтрокаДерева.КоличествоРаспределить = 0;
		
		Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
			
			СтрокаДерева.КоличествоРаспределить = СтрокаДерева.КоличествоРаспределить+ПодСтрока.КоличествоРаспределить;
			
		КонецЦикла;
		
		Разница = СтрокаДерева.КоличествоМожноРаспределить - СтрокаДерева.КоличествоРаспределить;
		
		Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
			
			Если ПодСтрока.КоличествоРаспределить+Разница >= 0 Тогда
				
				ПодСтрока.КоличествоРаспределить = ПодСтрока.КоличествоРаспределить+Разница;
				СтрокаДерева.КоличествоРаспределить = СтрокаДерева.КоличествоРаспределить+Разница;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;   
		
	КонецЦикла;
	
	Для Каждого СтрокаДерева ИЗ Дерево.Строки Цикл
		
		СтрокаДерева.Распределено = СтрокаДерева.КоличествоМожноРаспределить = СтрокаДерева.КоличествоРаспределить;
		
	КонецЦикла;  	
	
	ЗначениеВРеквизитФормы(Дерево,"ДеревоДанных");
	
КонецПроцедуры

Процедура РазвернутьРаботыПоДатам()
	
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаРаспределить(Команда)
	ЗаполнитьДеревоДанныхНаСервере(); 
	КомандаРаспределитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДанныхКоличествоРаспределитьПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ДеревоДанных.ТекущиеДанные;
	ТекСтрока.КоличествоРаспределить = Мин(ТекСтрока.КоличествоПотребностьОбщая-ТекСтрока.КоличествоВНаличии,ТекСтрока.КоличествоРаспределить);
	
	Ид = Элементы.ДеревоДанных.ТекущиеДанные.ПолучитьИдентификатор();
	ПересчитатьСуммуВСтрокеДерева(Ид);
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуВСтрокеДерева(Ид)
	
	СтрокаДерева = ДеревоДанных.НайтиПоИдентификатору(Ид);
	
	Родитель = СтрокаДерева.ПолучитьРодителя();
	
	Родитель.КоличествоРаспределить = 0;
	
	Для Каждого ПодСтрока ИЗ Родитель.ПолучитьЭлементы() Цикл
		
		Родитель.КоличествоРаспределить = Родитель.КоличествоРаспределить+ПодСтрока.КоличествоРаспределить; 	
		
	КонецЦикла;
	
	Если Родитель.КоличествоРаспределить > Родитель.КоличествоМожноРаспределить Тогда		
		
		СтрокаДерева.КоличествоРаспределить = СтрокаДерева.КоличествоРаспределить- (Родитель.КоличествоРаспределить - Родитель.КоличествоМожноРаспределить);
		
		Родитель.КоличествоРаспределить = Родитель.КоличествоМожноРаспределить;  
		
	КонецЕсли;
	
	Родитель.Распределено = Родитель.КоличествоРаспределить=Родитель.КоличествоМожноРаспределить;  	
	
КонецПроцедуры

&НаСервере
Процедура КомандаПеренестиВДокументыНаСервере()
	
	Дерево = РеквизитФормыВЗначение("ДеревоДанных");
	Строки = Дерево.Строки.НайтиСтроки(Новый Структура("Распределено",Ложь));
	ТабДокументов = РеквизитФормыВЗначение("ТаблицаДокументов");
	
	Если Строки.Количество() Тогда
		
		Сообщить("Не все материалы распределены!");
		Возврат;
		
	КонецЕсли;
	
	ОбъектСтроительства = Склад.УСОERP_ОбъектСтроительства;
	
	ТаблицаНоменклатурыРабот = Новый ТаблицаЗначений;
	ТаблицаНоменклатурыРабот.Колонки.Добавить("Номенклатура",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНоменклатурыРабот.Колонки.Добавить("Характеристика",Новый ОписаниеТипов("СправочникСсылка.ХарактеристикиНоменклатуры"));
	ТаблицаНоменклатурыРабот.Колонки.Добавить("Работа",Новый ОписаниеТипов("СправочникСсылка.УСОERP_СтроительныеРаботы"));
	ТаблицаНоменклатурыРабот.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	ТаблицаНоменклатурыРабот.Колонки.Добавить("КоличествоНоменклатуры",Новый ОписаниеТипов("Число"));
	
	Для Каждого СтрокаДерева ИЗ Дерево.Строки Цикл  	
		
		Для Каждого ПодСтрока ИЗ СтрокаДерева.Строки Цикл
			
			Если НЕ ПодСтрока.КоличествоРаспределить Тогда
				Продолжить;
			КонецЕсли;
			
			Нстр = ТаблицаНоменклатурыРабот.Добавить();
			Нстр.Номенклатура = СтрокаДерева.НоменклатураРабота;
			Нстр.Характеристика = СтрокаДерева.Характеристика;
			Нстр.Работа = ПодСтрока.НоменклатураРабота;
			Нстр.Количество = ПодСтрока.КоличествоРаспределить;
			Нстр.КоличествоНоменклатуры = СтрокаДерева.КоличествоРаспределить;
			
		КонецЦикла;		
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Склад",Склад);
	Запрос.УстановитьПараметр("ТабНом",ТаблицаНоменклатурыРабот);
	МассивДокументов = ТабДокументов.Скопировать(Новый Структура("Отбор",Истина)).ВыгрузитьКолонку("Документ");
	Запрос.УстановитьПараметр("МассивДокументов",МассивДокументов);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВрТаб.Номенклатура КАК Номенклатура,
	|	ВрТаб.Характеристика КАК Характеристика,
	|	ВрТаб.Работа КАК Работа,
	|	ВрТаб.Количество КАК Количество,
	|	ВрТаб.КоличествоНоменклатуры КАК КоличествоНоменклатуры
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТабНом КАК ВрТаб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаТоваров.ДокументПоступления КАК ДокументПоступления,
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.Характеристика КАК Характеристика,
	|	ВложенныйЗапрос.СтроительнаяРабота КАК СтроительнаяРабота,
	|	ТаблицаТоваров.Количество КАК Количество,
	|	СУММА(ВложенныйЗапрос.Количество) КАК КоличествоПлан
	|ПОМЕСТИТЬ ТабПоДокументам
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПоступлениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|		ПоступлениеТоваровУслугТовары.Характеристика КАК Характеристика,
	|		СУММА(ПоступлениеТоваровУслугТовары.Количество) КАК Количество,
	|		ПоступлениеТоваровУслугТовары.Назначение.Заказ КАК НазначениеЗаказ,
	|		ПоступлениеТоваровУслугТовары.Ссылка КАК ДокументПоступления
	|	ИЗ
	|		Документ.ПриобретениеТоваровУслуг.Товары КАК ПоступлениеТоваровУслугТовары
	|	ГДЕ
	|		ПоступлениеТоваровУслугТовары.Ссылка В(&МассивДокументов)
	|		И ПоступлениеТоваровУслугТовары.Назначение.Заказ.ДокументОснование ССЫЛКА Документ.УСОERP_ПланПотребностейВМатериалах
	|		И ПоступлениеТоваровУслугТовары.Назначение.Заказ.ДокументОснование.Склад = &Склад
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ПоступлениеТоваровУслугТовары.Номенклатура,
	|		ПоступлениеТоваровУслугТовары.Характеристика,
	|		ПоступлениеТоваровУслугТовары.Назначение.Заказ,
	|		ПоступлениеТоваровУслугТовары.Ссылка
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПриходныйОрдерНаТоварыТовары.Номенклатура,
	|		ПриходныйОрдерНаТоварыТовары.Характеристика,
	|		ПриходныйОрдерНаТоварыТовары.Количество,
	|		ПриходныйОрдерНаТоварыТовары.Назначение.Заказ,
	|		ПриходныйОрдерНаТоварыТовары.Ссылка
	|	ИЗ
	|		Документ.ПриходныйОрдерНаТовары.Товары КАК ПриходныйОрдерНаТоварыТовары
	|	ГДЕ
	|		ПриходныйОрдерНаТоварыТовары.Ссылка В(&МассивДокументов)
	|		И ПриходныйОрдерНаТоварыТовары.Назначение.Заказ.ДокументОснование ССЫЛКА Документ.УСОERP_ПланПотребностейВМатериалах
	|		И ПриходныйОрдерНаТоварыТовары.Назначение.Заказ.ДокументОснование.Склад = &Склад) КАК ТаблицаТоваров
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Ссылка КАК Ссылка,
	|			ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Номенклатура КАК Номенклатура,
	|			ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Характеристика КАК Характеристика,
	|			СУММА(ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Количество) КАК Количество,
	|			ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.СтроительнаяРабота КАК СтроительнаяРабота
	|		ИЗ
	|			Документ.ЗаказМатериаловВПроизводство.УСОERP_РаспределениеМатериаловПоРаботам КАК ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам
	|		ГДЕ
	|			ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Ссылка.Проведен
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Ссылка,
	|			ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Номенклатура,
	|			ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.Характеристика,
	|			ЗаказМатериаловВПроизводствоУСОERP_РаспределениеМатериаловПоРаботам.СтроительнаяРабота
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.Ссылка,
	|			ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.Номенклатура,
	|			ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.Характеристика,
	|			ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.Количество,
	|			ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.СтроительнаяРабота
	|		ИЗ
	|			Документ.ЗаказНаВнутреннееПотребление.УСОERP_РаспределениеМатериаловПоРаботам КАК ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам
	|		ГДЕ
	|			ЗаказНаВнутреннееПотреблениеУСОERP_РаспределениеМатериаловПоРаботам.Ссылка.Проведен) КАК ВложенныйЗапрос
	|		ПО ТаблицаТоваров.Номенклатура = ВложенныйЗапрос.Номенклатура
	|			И ТаблицаТоваров.Характеристика = ВложенныйЗапрос.Характеристика
	|			И ТаблицаТоваров.НазначениеЗаказ = ВложенныйЗапрос.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаТоваров.Номенклатура,
	|	ТаблицаТоваров.Характеристика,
	|	ВложенныйЗапрос.СтроительнаяРабота,
	|	ТаблицаТоваров.Количество,
	|	ТаблицаТоваров.ДокументПоступления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Номенклатура КАК Номенклатура,
	|	ВрТаб.Характеристика КАК Характеристика,
	|	ВрТаб.Работа КАК Работа,
	|	ВрТаб.Количество КАК Количество,
	|	ТабПоДокументам.ДокументПоступления КАК ДокументПоступления,
	|	ТабПоДокументам.Количество КАК КоличествоПоступления,
	|	ТабПоДокументам.КоличествоПлан КАК КоличествоПлан,
	|	ВрТаб.КоличествоНоменклатуры КАК КоличествоНоменклатуры
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабПоДокументам КАК ТабПоДокументам
	|		ПО ВрТаб.Номенклатура = ТабПоДокументам.Номенклатура
	|			И ВрТаб.Характеристика = ТабПоДокументам.Характеристика
	|			И ВрТаб.Работа = ТабПоДокументам.СтроительнаяРабота
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабПоДокументам.ДокументПоступления КАК ДокументПоступления,
	|	ТабПоДокументам.Номенклатура КАК Номенклатура,
	|	ТабПоДокументам.Характеристика КАК Характеристика,
	|	СУММА(ТабПоДокументам.Количество) КАК КоличествоПоступления
	|ИЗ
	|	ТабПоДокументам КАК ТабПоДокументам
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабПоДокументам.ДокументПоступления,
	|	ТабПоДокументам.Номенклатура,
	|	ТабПоДокументам.Характеристика";
	
	ПакетЗапросов = Запрос.ВыполнитьПакет();
	
	ТаблицаПоступлений = ПакетЗапросов[3].Выгрузить();
	
	
	ТЗ = ПакетЗапросов[2].Выгрузить();
	
	СтруктураОтбора = Новый Структура("ДокументПоступления",null);
	
	ТаблицаНоменклатурыБезЗАказов = ТЗ.Скопировать(СтруктураОтбора);
	
	СтрокиБезНоменклатуры = ТЗ.НайтиСтроки(СтруктураОтбора);
	
	Для Каждого НайденнаяСтрока ИЗ СтрокиБезНоменклатуры Цикл
		
		ТЗ.Удалить(НайденнаяСтрока);
		
	КонецЦикла;
	
	СтруктураОтбора = Новый Структура("Номенклатура,Характеристика");
	
	Для Каждого СтрокаТаблицы ИЗ ТаблицаНоменклатурыБезЗАказов Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураОтбора,СтрокаТаблицы);
				
		ТаблицаОтбора = ТаблицаПоступлений.Скопировать(СтруктураОтбора);
		ТаблицаОтбора.Свернуть("ДокументПоступления,КоличествоПоступления");
		
		Для Каждого НайденнаяСтрока ИЗ ТаблицаОтбора Цикл
			
			Нстр = ТЗ.Добавить();
			
			ЗаполнитьЗначенияСвойств(Нстр,СтрокаТаблицы);
			Нстр.ДокументПоступления = НайденнаяСтрока.ДокументПоступления;
			Нстр.КоличествоПоступления = НайденнаяСтрока.КоличествоПоступления;

			
			ТабТоваров = Нстр.ДокументПоступления.Товары.Выгрузить().Скопировать(СтруктураОтбора);
			Нстр.КоличествоПоступления = Мин(ТабТоваров.Итог("Количество"),НайденнаяСтрока.КоличествоПоступления);			
			
		КонецЦикла;  	
		
	КонецЦикла;
	
	ТабДокументов = ТаблицаПоступлений.Скопировать();
	ТабДокументов.Свернуть("ДокументПоступления");
	
	МассивДокументовДляПроведения = Новый Массив;
	
	СтруктураОтбора = Новый Структура("ДокументПоступления");
	
	Для Каждого СтрокаДокументов ИЗ ТабДокументов Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураОтбора,СтрокаДокументов);
		
		ДокументОбъект = СтрокаДокументов.ДокументПоступления.ПолучитьОбъект();
		ДокументОбъект.УСОERP_РаспределениеМатериаловПоРаботам.Очистить();
		
		Строки = ТЗ.НайтиСтроки(СтруктураОтбора);
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл
			
			Нстр = ДокументОбъект.УСОERP_РаспределениеМатериаловПоРаботам.Добавить();
			Нстр.ОбъектСтроительства = ОбъектСтроительства;
			Нстр.СтроительнаяРабота = НайденнаяСтрока.Работа;
			Нстр.ДатаПоступления = ДокументОбъект.Дата;
			Нстр.Номенклатура = НайденнаяСтрока.Номенклатура;
			Нстр.Характеристика = НайденнаяСтрока.Характеристика;
			Нстр.Количество = НайденнаяСтрока.Количество*НайденнаяСтрока.КоличествоПоступления/НайденнаяСтрока.КоличествоНоменклатуры;
			
		КонецЦикла;
		
		//Заполняем разницы при округлении
		ТабТекущегоДокумента = ДокументОбъект.УСОERP_РаспределениеМатериаловПоРаботам.Выгрузить();
		ТабТекущегоДокумента.Свернуть("Номенклатура,Характеристика","Количество");
		
		СтруктураОтбораПоДокументу = Новый Структура("ДокументПоступления,Номенклатура,Характеристика",СтрокаДокументов.ДокументПоступления);
		СтруктураОтбораПоНоменклатуре  = Новый Структура("Номенклатура,Характеристика");
				
		Для Каждого СтрокаТД ИЗ ТабТекущегоДокумента Цикл
			
			ЗаполнитьЗначенияСвойств(СтруктураОтбораПоДокументу,СтрокаТД);
			ЗаполнитьЗначенияСвойств(СтруктураОтбораПоНоменклатуре,СтрокаТД);
			
			СтрокаДокумента = ТЗ.НайтиСтроки(СтруктураОтбораПоДокументу).Получить(0);
			
			Если СтрокаТД.Количество <> СтрокаДокумента.КоличествоПоступления Тогда
				
				СтрокаДляИзменения =  ДокументОбъект.УСОERP_РаспределениеМатериаловПоРаботам.НайтиСтроки(СтруктураОтбораПоНоменклатуре).Получить(0);
				
				СтрокаДляИзменения.Количество = СтрокаДляИзменения.Количество-(СтрокаТД.Количество-СтрокаДОкумента.КоличествоПоступления);
				
			КонецЕсли; 			
			
		КонецЦикла;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.Записать(); 
		МассивДокументовДляПроведения.Добавить(ДокументОбъект.Ссылка);
		
	КонецЦикла;
	
	Для Каждого ЭлементМассива ИЗ   МассивДокументовДляПроведения Цикл
		
		Попытка
			ЭлементМассива.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Сообщить("Не удалось провести документ "+ЭлементМассива+" ("+ОписаниеОшибки()+")");
		КонецПопытки;		
		
	КонецЦикла;	
	
	ЗаполнитьТаблицуДокументов();
	ЗаполнитьДеревоДанныхНаСервере(); 
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПеренестиВДокументы(Команда)
	
	КомандаПеренестиВДокументыНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьТаблицуДокументов(Команда)
	
	ЗаполнитьТаблицуДокументов();
	ЗаполнитьДеревоДанныхНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.ТаблицаДокументов.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено Тогда
		ПоказатьЗначение(,ТекСтрока.Документ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовОтборПриИзменении(Элемент)
	ДеревоДанных.ПолучитьЭлементы().Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(Период) Тогда
		
		Период.Вариант = ВариантСтандартногоПериода.Вчера;
		ДатаПотребности = КонецМесяца(ТекущаяДата());
		ТолькоНераспределенные = Истина;
		
	КонецЕсли;
	
	ЗаполнитьТаблицуДокументов();
	ЗаполнитьДеревоДанныхНаСервере();
	
КонецПроцедуры



