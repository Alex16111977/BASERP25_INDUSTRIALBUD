	|	ГДЕ
	|		ПТУ_Работы.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|		И ПТУ_Работы.Ссылка.Склад = &Склад
	|		И ПТУ_Работы.Ссылка.Проведен
	|		И (ПТУ_Работы.Ссылка.Склад.ИспользоватьОрдернуюСхемуПриПоступлении = ЛОЖЬ
	|				ИЛИ ПТУ_Работы.Ссылка.Склад.ИспользоватьОрдернуюСхемуПриПоступлении = ИСТИНА
	|					И ПТУ_Работы.Ссылка.Склад.ДатаНачалаОрдернойСхемыПриПоступлении > ПТУ_Работы.Ссылка.Дата)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПОТ_Товары.Ссылка,
	|		ПОТ_Товары.Номенклатура,
	|		ПОТ_Товары.Характеристика,
	|		ПОТ_Товары.Количество,
	|		0
	|	ИЗ
	|		Документ.ПриходныйОрдерНаТовары.Товары КАК ПОТ_Товары
	|	ГДЕ
	|		ПОТ_Товары.Ссылка.Проведен
	|		И ПОТ_Товары.Ссылка.Склад = &Склад
	|		И ПОТ_Товары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПриходныхОрдеров.Принят)
	|		И ПОТ_Товары.Назначение.Заказ.ДокументОснование ССЫЛКА Документ.УСОERP_ПланПотребностейВМатериалах
	|		И ПОТ_Товары.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|		И (ПОТ_Товары.Назначение.Заказ ССЫЛКА Документ.ЗаказМатериаловВПроизводство
	|				ИЛИ ПОТ_Товары.Назначение.Заказ ССЫЛКА Документ.ЗаказНаВнутреннееПотребление)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПОТ_Работы.Ссылка,
	|		ПОТ_Работы.Номенклатура,
	|		ПОТ_Работы.Характеристика,
	|		0,
	|		ПОТ_Работы.Количество
	|	ИЗ
	|		Документ.ПриходныйОрдерНаТовары.УСОERP_РаспределениеМатериаловПоРаботам КАК ПОТ_Работы
	|	ГДЕ
	|		ПОТ_Работы.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|		И ПОТ_Работы.Ссылка.Склад = &Склад
	|		И ПОТ_Работы.Ссылка.Проведен
	|		И ПОТ_Работы.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПриходныхОрдеров.Принят)) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Ссылка,
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.Характеристика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Ссылка КАК Документ,
	|	ИСТИНА КАК Отбор,
	|	МИНИМУМ(ВрТаб.Распределено) КАК Распределен,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ВрТаб.КоличествоРаспределено > 0
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК БылоРаспределение
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ТолькоНераспределенные
	|				ТОГДА ВрТаб.Распределено = ЛОЖЬ
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВрТаб.Ссылка"; 	
	
	ТабДокументов = Запрос.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(ТабДокументов,"ТаблицаДокументов"); 	
	
КонецПроцедуры

