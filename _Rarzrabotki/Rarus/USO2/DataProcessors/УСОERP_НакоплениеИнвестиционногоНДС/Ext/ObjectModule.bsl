#Область ПеренесеноИзМодуляМенеджера
#Область ЭкспортныеПроцедурыФункции

// Функция получает данные и возвращает таблицу значений для заполнения сведений по объектам строительства.
//
Функция ПолучитьДанныеЗаполненияПоОбъектамСтроительства(СтруктураПараметров) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода"				  , СтруктураПараметров.НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода"			  , СтруктураПараметров.ОкончаниеПериода);
	Запрос.УстановитьПараметр("Организация"					  , СтруктураПараметров.Организация);
	Запрос.УстановитьПараметр("НакоплениеНДСПоРаботамУслугам" , СтруктураПараметров.НакоплениеНДСПоРаботамУслугам); 
	Запрос.УстановитьПараметр("НакоплениеНДСПоМатериалам"	  , СтруктураПараметров.НакоплениеНДСПоМатериалам);
					   
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	&Организация КАК Организация,
	               |	НакоплениеНДСПоРаботамУслугам.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	НакоплениеНДСПоРаботамУслугам.СуммаНДС КАК СуммаУслуг
	               |ПОМЕСТИТЬ ВТНакоплениеНДСПоРаботамУслугам
	               |ИЗ
	               |	&НакоплениеНДСПоРаботамУслугам КАК НакоплениеНДСПоРаботамУслугам
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Организация,
	               |	ОбъектСтроительства
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	&Организация КАК Организация,
	               |	НакоплениеНДСПоМатериалам.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	НакоплениеНДСПоМатериалам.СуммаНДС КАК СуммаТМЦ
	               |ПОМЕСТИТЬ ВТНакоплениеНДСПоМатериалам
	               |ИЗ
	               |	&НакоплениеНДСПоМатериалам КАК НакоплениеНДСПоМатериалам
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Организация,
	               |	ОбъектСтроительства
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТНакоплениеНДСПоРаботамУслугам.Организация КАК Организация,
	               |	ВТНакоплениеНДСПоРаботамУслугам.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	ВТНакоплениеНДСПоРаботамУслугам.СуммаУслуг КАК СуммаУслуг,
	               |	0 КАК СуммаТМЦ
	               |ПОМЕСТИТЬ ВТНакоплениеНДСПоРаботамУслугамМатериалам
	               |ИЗ
	               |	ВТНакоплениеНДСПоРаботамУслугам КАК ВТНакоплениеНДСПоРаботамУслугам
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВТНакоплениеНДСПоМатериалам.Организация,
	               |	ВТНакоплениеНДСПоМатериалам.ОбъектСтроительства,
	               |	0,
	               |	ВТНакоплениеНДСПоМатериалам.СуммаТМЦ
	               |ИЗ
	               |	ВТНакоплениеНДСПоМатериалам КАК ВТНакоплениеНДСПоМатериалам
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТНакоплениеНДСПоРаботамУслугамМатериалам.Организация КАК Организация,
	               |	ВТНакоплениеНДСПоРаботамУслугамМатериалам.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	СУММА(ВТНакоплениеНДСПоРаботамУслугамМатериалам.СуммаУслуг) КАК СуммаУслуг,
	               |	СУММА(ВТНакоплениеНДСПоРаботамУслугамМатериалам.СуммаТМЦ) КАК СуммаТМЦ
	               |ПОМЕСТИТЬ ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам
	               |ИЗ
	               |	ВТНакоплениеНДСПоРаботамУслугамМатериалам КАК ВТНакоплениеНДСПоРаботамУслугамМатериалам
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТНакоплениеНДСПоРаботамУслугамМатериалам.ОбъектСтроительства,
	               |	ВТНакоплениеНДСПоРаботамУслугамМатериалам.Организация
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Организация,
	               |	ОбъектСтроительства
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	НакоплениеНДСПоРаботамУслугам.Ссылка КАК Документ,
	               |	ИнвестиционныйНДС.Организация КАК Организация,
	               |	НакоплениеНДСПоРаботамУслугам.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	НакоплениеНДСПоРаботамУслугам.СуммаНДС КАК СуммаУслугДокумента,
	               |	0 КАК СуммаТМЦДокумента
	               |ПОМЕСТИТЬ ВТДокументыИнвестиционныйНДС
	               |ИЗ
	               |	Документ.УСОERP_ИнвестиционныйНДС.НДСПоСМР КАК НакоплениеНДСПоРаботамУслугам
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ИнвестиционныйНДС КАК ИнвестиционныйНДС
	               |		ПО НакоплениеНДСПоРаботамУслугам.Ссылка = ИнвестиционныйНДС.Ссылка
	               |ГДЕ
	               |	ИнвестиционныйНДС.Проведен
	               |	И ИнвестиционныйНДС.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |	И ИнвестиционныйНДС.Организация = &Организация
	               |	И НакоплениеНДСПоРаботамУслугам.ОбъектСтроительства В
	               |			(ВЫБРАТЬ
	               |				ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам.ОбъектСтроительства
	               |			ИЗ
	               |				ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам КАК ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НакоплениеНДСПоМатериалам.Ссылка,
	               |	ИнвестиционныйНДС.Организация,
	               |	НакоплениеНДСПоМатериалам.ОбъектСтроительства,
	               |	0,
	               |	НакоплениеНДСПоМатериалам.СуммаНДС
	               |ИЗ
	               |	Документ.УСОERP_ИнвестиционныйНДС.НДСПоТМЦ КАК НакоплениеНДСПоМатериалам
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ИнвестиционныйНДС КАК ИнвестиционныйНДС
	               |		ПО НакоплениеНДСПоМатериалам.Ссылка = ИнвестиционныйНДС.Ссылка
	               |ГДЕ
	               |	ИнвестиционныйНДС.Проведен
	               |	И ИнвестиционныйНДС.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |	И ИнвестиционныйНДС.Организация = &Организация
	               |	И НакоплениеНДСПоМатериалам.ОбъектСтроительства В
	               |			(ВЫБРАТЬ
	               |				ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам.ОбъектСтроительства
	               |			ИЗ
	               |				ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам КАК ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТДокументыИнвестиционныйНДС.Документ КАК Документ,
	               |	ВТДокументыИнвестиционныйНДС.Организация КАК Организация,
	               |	ВТДокументыИнвестиционныйНДС.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	СУММА(ВТДокументыИнвестиционныйНДС.СуммаУслугДокумента) КАК СуммаУслугДокумента,
	               |	СУММА(ВТДокументыИнвестиционныйНДС.СуммаТМЦДокумента) КАК СуммаТМЦДокумента
	               |ПОМЕСТИТЬ ВТДокументыИнвестиционныйНДССвернутые
	               |ИЗ
	               |	ВТДокументыИнвестиционныйНДС КАК ВТДокументыИнвестиционныйНДС
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТДокументыИнвестиционныйНДС.Организация,
	               |	ВТДокументыИнвестиционныйНДС.ОбъектСтроительства,
	               |	ВТДокументыИнвестиционныйНДС.Документ
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Организация,
	               |	ОбъектСтроительства
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам.ОбъектСтроительства КАК ОбъектСтроительства,
	               |	ЕСТЬNULL(ВТДокументыИнвестиционныйНДССвернутые.Документ, ЗНАЧЕНИЕ(Документ.УСОERP_ИнвестиционныйНДС.ПустаяСсылка)) КАК Документ,
	               |	ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам.СуммаУслуг КАК СуммаУслуг,
	               |	ЕСТЬNULL(ВТДокументыИнвестиционныйНДССвернутые.СуммаУслугДокумента, 0) КАК СуммаУслугДокумента,
	               |	ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам.СуммаТМЦ КАК СуммаТМЦ,
	               |	ЕСТЬNULL(ВТДокументыИнвестиционныйНДССвернутые.СуммаТМЦДокумента, 0) КАК СуммаТМЦДокумента
	               |ИЗ
	               |	ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам КАК ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТДокументыИнвестиционныйНДССвернутые КАК ВТДокументыИнвестиционныйНДССвернутые
	               |		ПО ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам.Организация = ВТДокументыИнвестиционныйНДССвернутые.Организация
	               |			И ВТНакоплениеНДССвернутаяПоРаботамУслугамМатериалам.ОбъектСтроительства = ВТДокументыИнвестиционныйНДССвернутые.ОбъектСтроительства";
	
	Возврат Запрос.Выполнить().Выгрузить();
				   	
КонецФункции // ПолучитьДанныеЗаполненияПоОбъектамСтроительства()

// Процедура получает/создает документ "Инвестиционный НДС" и заполняет его текущими данными обработки.
//
Процедура СоздатьДокументИнвестиционныйНДСПоОбъектуСтроительства(Объект, СтрокаТаблицы) Экспорт
	
	ИнвестиционныйНДС = ПолучитьСоздатьДокументИнвестиционныйНДС(СтрокаТаблицы);
	ЗаполнитьЗначенияСвойств(ИнвестиционныйНДС, Объект, "Организация, СчетСписанияНДС, Комментарий, Ответственный");
	
	ИнвестиционныйНДС.Дата				  = ?(ЗначениеЗаполнено(ИнвестиционныйНДС.Дата), ИнвестиционныйНДС.Дата, КонецМесяца(Объект.ОтчетныйПериод));
	ИнвестиционныйНДС.ОбъектСтроительства = СтрокаТаблицы.ОбъектСтроительства;
	ИнвестиционныйНДС.СпособСтроительства = ПолучитьСпособСтроительстваПоОбъектуСтроительства(СтрокаТаблицы);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НачалоПериода"	   , НачалоМесяца(ИнвестиционныйНДС.Дата));
	СтруктураПараметров.Вставить("ОкончаниеПериода"	   , КонецМесяца(ИнвестиционныйНДС.Дата));
	СтруктураПараметров.Вставить("Организация"		   , ИнвестиционныйНДС.Организация);
	СтруктураПараметров.Вставить("ОбъектСтроительства" , ИнвестиционныйНДС.ОбъектСтроительства);
	
	ИнвестиционныйНДС.НДСПоСМР.Загрузить(УСОERP_ДолевоеСтроительствоСервер.ПолучитьДанныеНакопленияНДСПоРаботамУслугам(СтруктураПараметров));
	ИнвестиционныйНДС.НДСПоТМЦ.Загрузить(УСОERP_ДолевоеСтроительствоСервер.ПолучитьДанныеНакопленияНДСПоМатериалам(СтруктураПараметров));
	
	СтруктураПараметров.Вставить("ДатаДокумента"				 , ИнвестиционныйНДС.Дата);
	СтруктураПараметров.Вставить("НакоплениеНДСПоРаботамУслугам" , ИнвестиционныйНДС.НДСПоСМР.Выгрузить()); 
	СтруктураПараметров.Вставить("НакоплениеНДСПоМатериалам"	 , ИнвестиционныйНДС.НДСПоТМЦ.Выгрузить()); 
	
	ИнвестиционныйНДС.ВключениеВСтоимость.Загрузить(УСОERP_ДолевоеСтроительствоСервер.ПолучитьДанныеВключениеНДСВСтоимостьОбъекта(СтруктураПараметров));
	
	Попытка
		ИнвестиционныйНДС.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не удалось провести документ по объекту строительсва """ +
				Строка(СтрокаТаблицы.ОбъектСтроительства) + """ по причине: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ИнвестиционныйНДС.Ссылка) Тогда
		ОбновитьЗначенияРеквизитовСтрокиТаблицы(ИнвестиционныйНДС, СтрокаТаблицы);
	КонецЕсли;
		
КонецПроцедуры // СоздатьДокументИнвестиционныйНДСПоОбъектуСтроительства()

#КонецОбласти

#Область ВспомогательныеФункции

// Функция получает или создает документ "Инвестиционный НДС" и возвращает его объект. 
//
Функция ПолучитьСоздатьДокументИнвестиционныйНДС(СтрокаТаблицы)

	Если ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
		Возврат СтрокаТаблицы.Документ.ПолучитьОбъект();
	КонецЕсли;
	
	Возврат Документы.УСОERP_ИнвестиционныйНДС.СоздатьДокумент();

КонецФункции // ПолучитьСоздатьДокументИнвестиционныйНДС()

