// Процедура обновляет реквизиты строки табл. части "Объекты строительства" данными с документа "Инвестиционный НДС".
//
Процедура ОбновитьЗначенияРеквизитовСтрокиТаблицы(ИнвестиционныйНДС, СтрокаТаблицы)

	СтрокаТаблицы.Документ = ИнвестиционныйНДС.Ссылка;
	
	СтрокаТаблицы.СуммаУслугДокумента = ИнвестиционныйНДС.НДСПоСМР.Итог("СуммаНДС");
	СтрокаТаблицы.СуммаТМЦДокумента	  = ИнвестиционныйНДС.НДСПоТМЦ.Итог("СуммаНДС");
	
КонецПроцедуры // ОбновитьЗначенияРеквизитовСтрокиТаблицы()

#КонецОбласти

#КонецОбласти
