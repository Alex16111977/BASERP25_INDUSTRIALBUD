		ЕстьОшибкиЛок = Истина;
	КонецЕсли;
	СтрокаПозицииСНБ.Наименование = ЗначениеСНБ;
	
	ЗначениеСНБ = Ресурс.ЕдиницаИзмерения; 
	Если Объект.ЕдиницаИзмерения <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
	КонецЕсли;
	СтрокаПозицииСНБ.Единица = ЗначениеСНБ;
	
	ЗначениеСНБ = Ресурс.МассаБрутто; 
	Если Объект.МассаБрутто <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
		СтрокаПозицииСНБ.МассаБ = Объект.МассаБрутто;
		СтрокаПозицииСНБ.МассаБ_СНБ = ЗначениеСНБ;
	КонецЕсли;
	
	ЗначениеСНБ = Ресурс.МассаНетто; 
	Если Объект.МассаНетто <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
		СтрокаПозицииСНБ.МассаН = Объект.МассаНетто;
		СтрокаПозицииСНБ.МассаН_СНБ = ЗначениеСНБ;
	КонецЕсли;
	
	Если ЕстьОшибкиЛок Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура СверитьРеквизитПозицииЛСИзНорм(Норма, Объект, ИмяРеквизита,ЭтоЧисло,ЕстьОшибки,СтрокаПозицииСНБ,ИмяКолонки,ИмяРеквизитаНорм)
	
	ЗначениеСНБ = ?(Норма = Неопределено,0,Норма[ИмяРеквизитаНорм]);
	СтрокаПозицииСНБ[ИмяКолонки] = ЗначениеСНБ;
	Если Объект[ИмяРеквизита] <> ЗначениеСНБ Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуруПараметровРасчетаЛС(Смета) 

	Структура = Новый Структура();
	Структура.Вставить("НомерСметы", Смета.НомерСметы);
	Структура.Вставить("Наименование", Смета.Наименование);
	Структура.Вставить("МетодРасчета", Смета.МетодРасчета);
	Структура.Вставить("Уровень", Смета.Уровень);
	Структура.Вставить("ТипРайона", Смета.ТипРайона);
	Структура.Вставить("КодРайона", Объект.РайонСтроительства.Код);
	Структура.Вставить("Район", Смета.Район);
	Структура.Вставить("ВариантРасчетаЗМ", Смета.ВариантРасчетаЗМ);
	Структура.Вставить("ТипСтроительства", Смета.ТипСтроительства);
	Структура.Вставить("ПрименятьКоэффициентыНРСП", Смета.ПрименятьКоэффициентыНРСП);
	Структура.Вставить("УпрощеннаяСН", Смета.УпрощеннаяСН);
	Структура.Вставить("РеконструкцияАЭС", Смета.РеконструкцияАЭС);
	Структура.Вставить("СметаНаРемонт", Смета.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт);
	Структура.Вставить("ВариантРасчетаЗМ", Смета.ВариантРасчетаЗМ);
	Структура.Вставить("ВариантПересчетаЭММ", Смета.ВариантПересчетаЭММ);

	Структура.Вставить("ЭтоБазисноИндексныйУровеньРасценка", (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка));
	Структура.Вставить("ЭтоБазисноИндексныйУровеньРаздел", (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел));
	Структура.Вставить("ЭтоБазисноИндексныйУровеньСмета", (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный И Смета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета));
	Структура.Вставить("ЭтоРесурсныйМетод", (Смета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный));
	
	Структура.Вставить("ЭтоИндексыПоЭлементам", (Смета.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат));
	
	Структура.Вставить("АвтозагрузкаИндексов", Смета.АвтозагрузкаИндексов);
	Структура.Вставить("АвтозагрузкаЦен", Смета.АвтозагрузкаЦен);
	Структура.Вставить("ДатаТекущихЦен", Смета.ДатаТекущихЦен);
	Структура.Вставить("ДатаВыпускаИндексов", Смета.ДатаВыпускаИндексов);
	Структура.Вставить("ФайлСборникаКоэффициентов", Смета.ФайлСборникаКоэффициентов);
	Структура.Вставить("ФайлСборникаТекущихЦен", Смета.ФайлСборникаТекущихЦен);
	Структура.Вставить("РегионДляВыбораЦен", Смета.РегионДляВыбораЦен);
	Структура.Вставить("КодРегионаФайлаТекущихЦен", Смета.КодРегионаФайлаТекущихЦен);
	
	//Структура.Вставить("МетодикаТСН", Смета.МетодикаТСН);
	Если Смета.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква Тогда
		Структура.Вставить("МетодикаТСН", Истина);	
	Иначе	
		Структура.Вставить("МетодикаТСН", Ложь);	
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

// Возвращает структуру с данными для обновления нормативных данных.
// Параметры:
//   ОбъектПозиции - ДокументОбъект.СМ_ПозицияЛокальнойСметы, ДокументСсылка.СМ_ПозицияЛокальнойСметы.
//   СтруктураПараметровРасчетаЛС - Структура - содержит данных о смете. 
//		Заполняется при вызове ПолучитьСтруктуруПараметровРасчетаЛС.
// Возвращаемое значение:
//   Структура - содержит поля:
//		* КодБазы 		- Строка
//		* КодЗоны 		- Строка
//		* ТипСборника 	- Перечисление.СМ_ТипыНормативныхСборников
//		* НомерСборника - Строка
//		* ШифрРасценки 	- Строка
Функция ПолучитьПараметрыДляОбновления(ОбъектПозиции, СтруктураПараметровРасчетаЛС) 
	
	Если Не СтруктураПараметровРасчетаЛС = Неопределено Тогда
		Если СтруктураПараметровРасчетаЛС.Свойство("МетодикаКазахстана") Тогда
			МетодикаКазахстана = СтруктураПараметровРасчетаЛС.МетодикаКазахстана;
		КонецЕсли;
	КонецЕсли;

	ПараметрыДляОбновления = Новый Структура();
	ПараметрыДляОбновления.Вставить("КодБазы", Объект.СНБ.Код);
	ПараметрыДляОбновления.Вставить("КодЗоны", СтруктураПараметровРасчетаЛС.КодРайона);
	ПараметрыДляОбновления.Вставить("ТипСборника", СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(ОбъектПозиции.ТипНормативныхСборников));
	ПараметрыДляОбновления.Вставить("НомерСборника", СМ_СметаВызовСервера.ОпределитьНомерСборника(ПараметрыДляОбновления.ТипСборника, ОбъектПозиции.ШифрРасценки,,МетодикаКазахстана));
	ПараметрыДляОбновления.Вставить("ШифрРасценки",Строка(ОбъектПозиции.ШифрРасценки));
	
	Возврат ПараметрыДляОбновления;
	
КонецФункции 

