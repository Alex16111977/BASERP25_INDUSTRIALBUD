
#Область ОбработчикиСобытий

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не СметнаяКомпонента = Неопределено Тогда
		КлючВарианта = "ГосРасценки";
	Иначе
		КлючВарианта = "Собственные";
		Элементы.КлючТекущегоВарианта.Видимость =Ложь;
	КонецЕсли;

	Если Не ГлобальнаяСтрокаДереваСмет = Неопределено Тогда
		СтрСметы = Объект.Сметы.Добавить();
		СтрСметы.Смета = ГлобальнаяСтрокаДереваСмет.Ссылка;
		ЗаполнитьРеквизитыИзСметы(ГлобальнаяСтрокаДереваСмет.Ссылка);
	КонецЕсли;
	ВидимостьДоступностьЭлементовНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьДоступностьЭлементовНаФорме()
	Элементы.СНБ.Доступность = Объект.ЭкспертизаСНБ;
	Элементы.ИндексыСНБ.Доступность = Объект.ЭкспертизаИндексов;
	Элементы.ДатаВыпускаИндексов.Доступность = Объект.ЭкспертизаИндексов;
	Элементы.СборникЦен.Доступность = Объект.ЭкспертизаЦен;
	Элементы.ДатаТекущихЦен.Доступность = Объект.ЭкспертизаЦен;
	Элементы.СверятьРаботы.Доступность = Объект.ЭкспертизаСНБ;
	Элементы.СверятьРесурсы.Доступность = Объект.ЭкспертизаСНБ;
	Элементы.ДляПечати.Доступность = Объект.ЭкспертизаСНБ;
	Элементы.ЭкспертизаНРСП.Доступность = Объект.ЭкспертизаСНБ;

	Если КлючВарианта = "ГосРасценки" Тогда
		Элементы.СборникЦен.Видимость = Истина;
		Элементы.Группа2.Видимость = Истина;
		Элементы.Группа4.Видимость = Истина;
		Элементы.ЭкспертизаНРСП.Видимость = Истина;
	Иначе
		Элементы.СборникЦен.Видимость = Ложь;
		Элементы.Группа2.Видимость = Ложь;
		Элементы.Группа4.Видимость = Ложь;
		Элементы.ЭкспертизаНРСП.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЭкспертизаСНБПриИзменении(Элемент)
	ВидимостьДоступностьЭлементовНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура ЭкспертизаИндексовПриИзменении(Элемент)
	ВидимостьДоступностьЭлементовНаФорме();
КонецПроцедуры

&НаКлиенте
Процедура ЭкспертизаЦенПриИзменении(Элемент)
	ВидимостьДоступностьЭлементовНаФорме();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СверитьПозиции(Команда)
	Если Объект.ЭкспертизаСНБ Тогда
		ТабДок = Новый ТабличныйДокумент;
		Макет =  ВернутьМакет();
		ОбластьСтроки = Неопределено;
		Если Объект.Сметы.Количество()=1 Тогда
			ВывестиОбластьНачала(ТабДок,Макет,ОбластьСтроки,Объект.Сметы[0].Смета);
		Иначе
			ВывестиОбластьНачала(ТабДок,Макет,ОбластьСтроки);
		КонецЕсли;
		Для каждого СтрСмета Из Объект.Сметы Цикл
			// Если Объект.Сметы.Количество()>1 Тогда
			//	ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СтрСмета.Смета);
			// КонецЕсли;
			Если ТипЗнч(СтрСмета.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				МассивПозиций = ВернутьМассив(СтрСмета.Смета);
				СверитьПозицииСметы(МассивПозиций,ТабДок,Макет,ОбластьСтроки,СтрСмета.Смета);
				Если Объект.Сметы.Количество()>1 Тогда
					ВывестиРазделительСтраниц(ТабДок);
				КонецЕсли;
			ИначеЕсли ТипЗнч(СтрСмета.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
				МассивСмет = ПолучитьСметы(СтрСмета.Смета);
				Для каждого ЛС Из МассивСмет Цикл
					// ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,ЛС);
					МассивПозиций =  ВернутьМассив(ЛС);
					СверитьПозицииСметы(МассивПозиций,ТабДок,Макет,ОбластьСтроки,ЛС);
				КонецЦикла;	
			ИначеЕсли ТипЗнч(СтрСмета.Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
				МассивСмет = ПолучитьСметы(СтрСмета.Смета);
				Для каждого СС Из МассивСмет Цикл
					Если ТипЗнч(СС) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
						// ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СС);
						МассивПозиций = ВернутьМассив(СС);
						СверитьПозицииСметы(МассивПозиций,ТабДок,Макет,ОбластьСтроки,СС);
					ИначеЕсли ТипЗнч(СС) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
						// ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СС);
						МассивСметСС = ПолучитьСметы(СС);
						Для каждого ЛС Из МассивСметСС Цикл
							// ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,ЛС);
							МассивПозиций = ВернутьМассив(ЛС);
							СверитьПозицииСметы(МассивПозиций,ТабДок,Макет,ОбластьСтроки,ЛС,СС);
						КонецЦикла;	
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		ТабДок.АвтоМасштаб = Истина;
		ТабДок.ОриентацияСтраницы 	= ОриентацияСтраницы.Ландшафт;
		ТабДок.ПовторятьПриПечатиСтроки = ТабДок.Области.КолонкиПовтора;
		ТабДок.ОтображатьЗаголовки = Ложь;
		ТабДок.ОтображатьСетку = Ложь;
		ТабДок.Защита = Истина;
		ТабДок.Показать(НСтр("ru='Протокол экспертизы по нормативной базе'"));
	КонецЕсли;
	Если Объект.ЭкспертизаЦен Тогда
		ТабДокЦ = Новый ТабличныйДокумент;

		МакетТекущихЦен = ВернутьМакетТекущихЦен();
		ОбластьСтрокиТЦ = Неопределено;
		Если Объект.Сметы.Количество()=1 Тогда
			ВывестиОбластьНачалаТекЦен(ТабДокЦ,МакетТекущихЦен,ОбластьСтрокиТЦ,Объект.Сметы[0].Смета);
		Иначе
			ВывестиОбластьНачалаТекЦен(ТабДокЦ,МакетТекущихЦен,ОбластьСтрокиТЦ);
		КонецЕсли;
		Для каждого СтрСмета Из Объект.Сметы Цикл
			Если Объект.Сметы.Количество()>1 Тогда
				ВывестиОбластьСметы(ТабДокЦ,МакетТекущихЦен,ОбластьСтрокиТЦ.ОбластьСметы,СтрСмета.Смета);
			КонецЕсли;
			СписокПозиций = ВыбратьПозицииСметы(СтрСмета.Смета);
			
			ЕстьОшибки = Ложь;
			Если КлючВарианта = "ГосРасценки" Тогда // по ВНБ.
				ДанныеЦен = Неопределено;
				СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
				ДанныеЦен = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(СтрСмета.Смета, , СтруктураДанных);
				СверитьТекущиеЦеныВПозиции(СтрСмета.Смета, ДанныеЦен,ЕстьОшибки,СписокПозиций,ТабДокЦ,МакетТекущихЦен,ОбластьСтрокиТЦ);
			Иначе
				Если Не ТипЗнч(СтрСмета.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
					Район = Объект.РайонСтроительства;
				Иначе
					Район = СМ_СметаВызовСервера.ПолучитьЗначениеРеквизита(СтрСмета.Смета, "Район");
				КонецЕсли;
				СверитьТекущиеЦеныВПозицииНорма(Район,ЕстьОшибки,СписокПозиций,ТабДокЦ,МакетТекущихЦен,ОбластьСтрокиТЦ);
			КонецЕсли;
			Если Объект.Сметы.Количество()>1 Тогда
				ВывестиРазделительСтраниц(ТабДокЦ);
	        КонецЕсли;
	
		КонецЦикла;	
		ТабДокЦ.ПовторятьПриПечатиСтроки = ТабДокЦ.Области.КолонкиПовтора;
		ТабДокЦ.ОриентацияСтраницы 	= ОриентацияСтраницы.Портрет;

		ТабДокЦ.АвтоМасштаб = Истина;
		ТабДокЦ.ОтображатьЗаголовки = Ложь;
		ТабДокЦ.ОтображатьСетку = Ложь;
		ТабДокЦ.Защита = Истина;
		ТабДокЦ.Показать(НСтр("ru='Протокол расхождения текущих цен'"));
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СверитьПозицииСметы(МассивПозиций,ТабДок,Макет,ОбластьСтроки,СметаЛС,СметаРодитель = Неопределено)
	СтруктураПараметровРасчетаЛС = ПолучитьСтруктуруПараметровРасчетаЛС(СметаЛС);
	Раздел = Неопределено;
	ШапкаВыведена = Ложь;
	Если КлючВарианта = "ГосРасценки" Тогда // по ВНБ.
		Для каждого ОбъектПозиции Из МассивПозиций Цикл
			Если ТипЗнч(ОбъектПозиции) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				СтруктураКодНомерШифр = ПолучитьПараметрыДляОбновления(ОбъектПозиции,СтруктураПараметровРасчетаЛС);
				Если Строка(СтруктураКодНомерШифр.КодБазы) = "" Тогда
					Продолжить;
				КонецЕсли;	
				
				Попытка
					Данные = СметнаяКомпонента.ОбновитьПоБазе(СтруктураКодНомерШифр.ШифрРасценки,Строка(СтруктураПараметровРасчетаЛС.КодРайона),Строка(СтруктураКодНомерШифр.КодБазы),СтруктураКодНомерШифр.ТипСборника,Строка(СтруктураКодНомерШифр.НомерСборника));
				Исключение
					Событие = НСтр("ru = 'Исключение Экспертиза'");
					СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
				КонецПопытки;
				
				Если Данные = "" ИЛИ Данные = Неопределено Тогда
				ИначеЕсли НРег(Данные) = "<collection />" ИЛИ НРег(Данные) = "<collection></collection>" Тогда
					// Нет позиции в Базе
					
					Если Не ШапкаВыведена Тогда
						ШапкаВыведена = Истина;
						Если Не СметаРодитель = Неопределено Тогда
							ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СметаРодитель);
						КонецЕсли;
						ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СметаЛС);
					КонецЕсли;
					
					ВывестиОбластьПозицииНетВБазе(ТабДок,Макет,ОбластьСтроки,ОбъектПозиции,Раздел);
				Иначе
					ЕстьОшибки = Ложь;
					ДанныеИнд = Неопределено;
					Если ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦен) Тогда
						// Обновляем индексы.
						СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", Объект.ФайлСборникаТекущихЦен, Объект.КодРегионаФайлаТекущихЦен);
						ДанныеЦен = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(ОбъектПозиции, , СтруктураДанных);
					КонецЕсли;
					Если УсловиеИндексов(ОбъектПозиции) Тогда
						Если ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентов) Тогда
							// Обновляем индексы.
							СтруктураДанных = Новый Структура("СборникКоэффициентов", Объект.ФайлСборникаКоэффициентов);
							Если Объект.ПрименятьИндексыКоВсемБазам Тогда
								СтруктураДанных.Вставить("КодРегиональнойБазы", Объект.КодРегионаФайлаИндексовПересчета);
							КонецЕсли;
							ДанныеИнд = ПолучитьДанныеОбИндексахПересчета(ОбъектПозиции, , СтруктураДанных);
						КонецЕсли;
					КонецЕсли;
					
					СверитьДанныеВПозицииЛС(Данные,ДанныеЦен,ДанныеИнд, ОбъектПозиции, СтруктураПараметровРасчетаЛС,ТабДок,Макет,ОбластьСтроки,ЕстьОшибки,Раздел,ШапкаВыведена,СметаЛС,СметаРодитель,СМ_ВерсияКомпоненты);
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	Иначе // по нормам базы.
		Для каждого ОбъектПозиции Из МассивПозиций Цикл
			Если ТипЗнч(ОбъектПозиции) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				Данные = НайтиВНормативнойБазе(ОбъектПозиции);
				Если Данные = Неопределено Тогда
					// Нет позиции в Базе
					
					Если Не ШапкаВыведена Тогда
						ШапкаВыведена = Истина;
						Если Не СметаРодитель = Неопределено Тогда
							ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СметаРодитель);
						КонецЕсли;
						ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СметаЛС);
					КонецЕсли;

					ВывестиОбластьПозицииНетВБазе(ТабДок,Макет,ОбластьСтроки,ОбъектПозиции,Раздел);
				Иначе
					ЕстьОшибки = Ложь;
					СверитьДанныеВПозицииЛСНормы(Данные,ОбъектПозиции, СтруктураПараметровРасчетаЛС,ТабДок,Макет,ОбластьСтроки,ЕстьОшибки,Раздел,ШапкаВыведена,СметаЛС,СметаРодитель);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

// Возвращает сводную строку с данными об индексах к позициям.
//
// Параметры:
//   МассивПозицийИлиПозицияИлиДокумент - ДокуменСсылка.СМ_ПозицияЛокальнойСметы, Массив - 
//	 									  Ссылка на позицию или массив ссылок для выборки индексов.
//    									  Можно передать смету - тогда все позиции сметы.
//    									  Можно передать акт - тогда все позиции акта.
//   СтруктураПараметровРасчетаЛС 		- Структура - содержит данные о смете,
//										  получены методом ПолучитьСтруктуруПараметровРасчетаЛС().
//   СтруктураНовыхДанных 				- Структура - может содержать свойства: 
//		* КодРайона				- Строка - код района.
//		* СборникКоэффициентов  - Строка - идентификатор другого сборника.
//		* КодРегиональнойБазы   - Строка - код для обновления индексов по другой базе.
//
//  Возвращаемое значение:
//   	Строка - содержит XML с индексами из ВНБ.
//
&НаКлиенте
Функция ПолучитьДанныеОбИндексахПересчета(ОбъектПозиции, СтруктураПараметровРасчетаЛС = Неопределено, СтруктураНовыхДанных = Неопределено) 
	Если СметнаяКомпонента = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	МассивДляИндексов = ПолучитьТаблицуПозицийДляИндексовПересчета(ОбъектПозиции, СтруктураПараметровРасчетаЛС, СтруктураНовыхДанных);
	
	Данные = "<body>";
	Для Каждого ЗаписьОбновления Из МассивДляИндексов Цикл
		Данные = Данные + СметнаяКомпонента.ПолучитьКоэффициенты(ЗаписьОбновления.ШифрыРасценки, ЗаписьОбновления.КодРайона, ЗаписьОбновления.КодРегиональнойБазы, ЗаписьОбновления.СборникКоэффициентов, ЗаписьОбновления.ТипНормативногоСборника);
	КонецЦикла;
	Данные = Данные+"</body>";
	
	Возврат Данные;
КонецФункции

&НаСервере
Функция НайтиВНормативнойБазе(Позиция)
	Эталон = Неопределено;
	Если Позиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Работа Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	СМ_НормативныеСборники.Ссылка
		|ИЗ
		|	Справочник.СМ_НормативныеСборники КАК СМ_НормативныеСборники
		|ГДЕ
		|	СМ_НормативныеСборники.КодНормативнойРасценки = &КодНормативнойРасценки
		|	И ВЫБОР
		|			КОГДА &ИспользоватьСтатусы
		|				ТОГДА СМ_НормативныеСборники.Статус = ЗНАЧЕНИЕ(Перечисление.СМ_СтатусыФормированияНормативов.Утвержден)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";

		// |	И СМ_НормативныеСборники.ТипНормативногоСборника = &ТипНормативногоСборника";
		Запрос.УстановитьПараметр("КодНормативнойРасценки",СокрЛП(Позиция.ШифрРасценки));
		Запрос.УстановитьПараметр("ИспользоватьСтатусы",ПолучитьФункциональнуюОпцию("СМ_ИспользоватьСтатусыНормативов"));
		// Запрос.УстановитьПараметр("ТипНормативногоСборника",Позиция.ТипНормативныхСборников);
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	СМ_Ресурсы.Ссылка
		|ИЗ
		|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
		|ГДЕ
		|	НЕ СМ_Ресурсы.ЭтоГруппа
		|	И СМ_Ресурсы.Код = &Код";
		Запрос.УстановитьПараметр("Код",СокрЛП(Позиция.ШифрРасценки));
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Эталон = Выборка.Ссылка; 
	КонецЕсли;
	Возврат Эталон;
КонецФункции

&НаСервере
Функция ПолучитьТаблицуПозицийДляИндексовПересчета(Позиция, СтруктураПараметровРасчетаЛС = Неопределено, СтруктураНовыхДанных = Неопределено) 
	Массив = Новый Массив;
	
	Если СтруктураНовыхДанных = Неопределено Тогда
		СтруктураНовыхДанных = Новый Структура();
	КонецЕсли;
	
	
	Если (СтруктураПараметровРасчетаЛС = Неопределено) Тогда
		СтруктураПараметровРасчетаЛС = ПолучитьСтруктуруПараметровРасчетаЛС(Позиция.ИдСметы);
	КонецЕсли;
	
	ТаблицаСведений = Новый ТаблицаЗначений();
	ТаблицаСведений.Колонки.Добавить("ШифрыРасценки");
	ТаблицаСведений.Колонки.Добавить("КодРайона");
	ТаблицаСведений.Колонки.Добавить("КодРегиональнойБазы");
	ТаблицаСведений.Колонки.Добавить("СборникКоэффициентов");
	ТаблицаСведений.Колонки.Добавить("ТипНормативногоСборника");
	
	ТипНормативногоСборника = СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(Позиция.ТипНормативныхСборников);
	Если (ТипНормативногоСборника = Неопределено) Тогда
		ТипНормативногоСборника = "CN";
	КонецЕсли;
	
	КодРегиональнойБазы = Объект.КодРегионаФайлаИндексовПересчета;
	Если КодРегиональнойБазы = "" Тогда
		КодРегиональнойБазы = Справочники.СМ_СметноНормативныеБазы.ПолучитьПоУмолчанию().Код;
	КонецЕсли;
	КодРайона = "";
	Если Не СтруктураНовыхДанных.Свойство("КодРайона", КодРайона) Тогда
		КодРайона = СтруктураПараметровРасчетаЛС.КодРайона;
	КонецЕсли;
	СборникКоэффициентов = "";
	Если Не СтруктураНовыхДанных.Свойство("СборникКоэффициентов", СборникКоэффициентов) Тогда
		СборникКоэффициентов = Объект.ФайлСборникаКоэффициентов;
	КонецЕсли;
	ШифрыРасценки = Позиция.ШифрРасценки;
	Отбор = Новый Структура("КодРайона, СборникКоэффициентов, КодРегиональнойБазы, ТипНормативногоСборника", КодРайона, СборникКоэффициентов, КодРегиональнойБазы, ТипНормативногоСборника);
	МассивСтрокТаблицы = ТаблицаСведений.НайтиСтроки(Отбор);
	Если МассивСтрокТаблицы.Количество() = 0 Тогда
		Стр = ТаблицаСведений.Добавить();
		Стр.ШифрыРасценки = ШифрыРасценки;
	Иначе
		Стр = МассивСтрокТаблицы[0];
		Стр.ШифрыРасценки = Стр.ШифрыРасценки + ";" + ШифрыРасценки;
	КонецЕсли;	   		
	ЗаполнитьЗначенияСвойств(Стр, Отбор);
	Для Каждого СтрПозиция Из ТаблицаСведений Цикл
		Структура = Новый Структура("ШифрыРасценки, КодРайона, КодРегиональнойБазы, СборникКоэффициентов, ТипНормативногоСборника");
		ЗаполнитьЗначенияСвойств(Структура, СтрПозиция);
		Массив.Добавить(Структура);     		
	КонецЦикла;
	
	Возврат Массив;
		
КонецФункции

