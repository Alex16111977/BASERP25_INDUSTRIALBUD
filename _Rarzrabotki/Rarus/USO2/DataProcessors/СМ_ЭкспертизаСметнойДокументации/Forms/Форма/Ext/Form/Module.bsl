Процедура СверитьТекущиеЦеныВПозиции(Смета, ДанныеЦен,ЕстьОшибки,СписокПозиций,ТабДок,МакетТекущихЦен,ОбластьСтрокиТЦ) 

	ТаблТекЦенВСмете = СМ_СметаРасчетВызовСервера.ПолучитьТаблицуСтоимостиРесурсовСметы(СписокПозиций,Истина,Ложь);

	Ошибка = Ложь;
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("Шифр");
	ТаблицаОшибок.Колонки.Добавить("Наименование");
	ТаблицаОшибок.Колонки.Добавить("ЕдИзм");
	ТаблицаОшибок.Колонки.Добавить("ДляСортировки");
	ТаблицаОшибок.Колонки.Добавить("ВидРесурса");
	ТаблицаОшибок.Колонки.Добавить("ТЦ");
	ТаблицаОшибок.Колонки.Добавить("ТЗМ");
	ТаблицаОшибок.Колонки.Добавить("ТЦ_СНБ");
	ТаблицаОшибок.Колонки.Добавить("ТЗМ_СНБ");
	ТаблицаОшибок.Колонки.Добавить("РазныеЦены");

	Если Не ЗначениеЗаполнено(ДанныеЦен) Тогда
		Возврат ;
	КонецЕсли;
	ТаблицаТЦ = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьТекущиеЦеныВТаблицу(ДанныеЦен);
	Если ТаблицаТЦ.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для каждого СтрокаРесурса Из  ТаблТекЦенВСмете Цикл
			Отбор = Новый Структура();
			Отбор.Вставить("ШифрРасценки", СтрокаРесурса.КодРесурса);
			МассивЦенВБ = ТаблицаТЦ.НайтиСтроки(Отбор);
			Если МассивЦенВБ.Количество()=0 Тогда
				ТЦ_СНБ = 0;
				ТЗМ_СНБ = 0;
			Иначе
				ЗначениеСНБ = Число(МассивЦенВБ[0].ТекущаяЦена);
				ТЦ_СНБ = ЗначениеСНБ;
				ЗначениеСНБ = Число(МассивЦенВБ[0].ТекущаяЗарплатаМашинистов);
				ТЗМ_СНБ = ЗначениеСНБ;
			КонецЕсли;
			
	        ОшибкаЛок = Ложь;
			СтрОшибок = ТаблицаОшибок.Добавить();
			СтрОшибок.Шифр = СтрокаРесурса.КодРесурса;
			СтрОшибок.Наименование = СтрокаРесурса.НаименованиеРесурса;
			СтрОшибок.ЕдИзм = СтрокаРесурса.ЕдиницаИзмеренияРесурса;
			СтрОшибок.ВидРесурса = СтрокаРесурса.ВидРесурса;
			Если СтрокаРесурса.ЭтоНеучтенный Тогда
				СтрОшибок.ДляСортировки = 1;
			Иначе
				СтрОшибок.ДляСортировки = 2;
			КонецЕсли;	
			ИмяРеквизита = "ТекущаяЦена";
			Если СтрокаРесурса.ЦенаТекущая <> ТЦ_СНБ Тогда
				Ошибка = Истина;
				ОшибкаЛок = Истина;
				Если СтрокаРесурса.ЦенаТекущаяЕстьОтклонение Тогда
					СтрОшибок.ТЦ = НСтр("ru='Разные цены'");
				Иначе
					СтрОшибок.ТЦ = СтрокаРесурса.ЦенаТекущая;
				КонецЕсли;
				СтрОшибок.ТЦ_СНБ = ТЦ_СНБ;
			КонецЕсли;
			
			Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы  Тогда	
				ИмяРеквизита = "ТекущаяЗарплатаМашинистов";
				Если СтрокаРесурса.ЦенаТекущаяЗМ <> ТЗМ_СНБ Тогда
					Ошибка = Истина;
					ОшибкаЛок = Истина;
					СтрОшибок.ТЗМ = СтрокаРесурса.ЦенаТекущаяЗМ;
					СтрОшибок.ТЗМ_СНБ = ТЗМ_СНБ;
				КонецЕсли;
			КонецЕсли;
			Если Не ОшибкаЛок Тогда
				ТаблицаОшибок.Удалить(СтрОшибок);
			КонецЕсли;
	КонецЦикла;
	Если Ошибка Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	ТаблицаОшибок.Сортировать("ДляСортировки,ВидРесурса");
	СтарыйВид = Неопределено;
	ДляСортировки = Истина;
	Если ЕстьОшибки Тогда
		Для каждого СтрокаЦен Из ТаблицаОшибок Цикл
			Если СтрокаЦен.ДляСортировки = 1 И ДляСортировки = Истина  Тогда 
				ДляСортировки = Ложь;
				ВывестиОбластьГруппы(ТабДок,МакетТекущихЦен,ОбластьСтрокиТЦ,СтрокаЦен,Истина);
				СтарыйВид = СтрокаЦен.ВидРесурса;
			КонецЕсли;	
			Если СтарыйВид <> СтрокаЦен.ВидРесурса Тогда
				ВывестиОбластьГруппы(ТабДок,МакетТекущихЦен,ОбластьСтрокиТЦ,СтрокаЦен);
				СтарыйВид = СтрокаЦен.ВидРесурса;
			КонецЕсли;
			ВывестиОбластьЦены(ТабДок,МакетТекущихЦен,ОбластьСтрокиТЦ,СтрокаЦен);
		КонецЦикла;
		ВывестиОбластьПодвал(ТабДок,МакетТекущихЦен);
	Иначе
		ВывестиОбластьНетОшибок(ТабДок,МакетТекущихЦен);
	КонецЕсли;

КонецПроцедуры

