					стрОшибок.БЗМ_СНБ = ЗначениеСНБ;
					Если ТекПояснение <> "" Тогда
						ТекПояснение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1,зарпл. машинистов'"), ТекПояснение);
					Иначе
						ТекПояснение = НСтр("ru='расхождение базисной зарпл. машинистов'");
					КонецЕсли;
				КонецЕсли;
				стрОшибок.Пояснение = ТекПояснение;
			Иначе
				ЗначениеСНБ = ?(СтрСНБ.БазиснаяЦена=Неопределено,0,СтрСНБ.БазиснаяЦена);
				ИмяРеквизита = "БазиснаяЦена";
