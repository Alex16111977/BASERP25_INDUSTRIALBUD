					стрОшибок.Пояснение = НСтр("ru='расхождение базисной цены ресурса.'");
				КонецЕсли;
			КонецЕсли;
			
			Если Не Ошибка Тогда
				ТаблицаОшибок.Удалить(стрОшибок);
			КонецЕсли;
			ТаблицаРесурсовСНБ.Удалить(СтрСНБ);
		Иначе
			Ошибка = Истина;
			стрОшибок = ТаблицаОшибок.Добавить();
			стрОшибок.Шифр = стр.СметныйКодРесурса;
