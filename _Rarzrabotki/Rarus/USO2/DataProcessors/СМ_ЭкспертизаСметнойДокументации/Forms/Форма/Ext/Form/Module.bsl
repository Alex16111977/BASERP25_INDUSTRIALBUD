Процедура ВывестиОбластьНачала(ТабДок,Макет,ОбластиСтрок,Смета=Неопределено)
	ОбластиСтрок = Новый Структура;
	ОбластиСтрок.Вставить("ОбластьПозиции",Макет.ПолучитьОбласть("Позиции"));
	ОбластиСтрок.Вставить("ОбластьПрочие",Макет.ПолучитьОбласть("Прочие"));
	ОбластиСтрок.Вставить("ОбластьОшибкиПозиции",Макет.ПолучитьОбласть("ОшибкиПозиции"));
	ОбластиСтрок.Вставить("ОбластьОшибкиПрочие",Макет.ПолучитьОбласть("ОшибкиПрочие"));
	ОбластиСтрок.Вставить("ОбластьСметы",Макет.ПолучитьОбласть("Данные"));
	ОбластиСтрок.Вставить("ОбластьРазделитель",Макет.ПолучитьОбласть("Пунктирная"));
	ОбластиСтрок.Вставить("ОбластьНетто",Макет.ПолучитьОбласть("МассаНетто"));
	ОбластиСтрок.Вставить("ОбластьБрутто",Макет.ПолучитьОбласть("МассаБрутто"));
	ОбластиСтрок.Вставить("ОбластьЦены",Макет.ПолучитьОбласть("Цены"));
	ОбластиСтрок.Вставить("ОбластьОшибкиЦены",Макет.ПолучитьОбласть("ОшибкиЦены"));
	ОбластиСтрок.Вставить("ОбластьКартинки",Макет.ПолучитьОбласть("Картинки"));
	ОбластиСтрок.Вставить("ОбластьИндексы",Макет.ПолучитьОбласть("Индексы"));
	ОбластиСтрок.Вставить("ОбластьОшибкиИндексы",Макет.ПолучитьОбласть("ОшибкиИндексы"));
	ОбластиСтрок.Вставить("Шапка", Макет.ПолучитьОбласть("Шапка"));
	ОбластиСтрок.Вставить("КолонкиПовтора", Макет.ПолучитьОбласть("Шапка|КолонкиПовтора"));
    ОбластиСтрок.Вставить("ОбластьНРСП",Макет.ПолучитьОбласть("НРСП"));
	
	ОбластьМакета = Макет.ПолучитьОбласть("Заголовок");
	ТабДок.Вывести(ОбластьМакета);
	
	Если Не Смета=Неопределено Тогда
		ОбластьСтроки = Макет.ПолучитьОбласть("Данные");
		ОбластьСтроки.Параметры.Данные = ПредставлениеОбъекта(Смета);
		ТабДок.Вывести(ОбластьСтроки);
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
	ТабДок.Вывести(ОбластьМакета);

КонецПроцедуры

Процедура ВывестиОбластьНачалаТекЦен(ТабДокЦ,МакетТекущихЦен,ОбластиСтрокТЦ,Смета=Неопределено)
	ОбластиСтрокТЦ = Новый Структура;
	ОбластиСтрокТЦ.Вставить("ОбластьСметы",МакетТекущихЦен.ПолучитьОбласть("Данные"));
	ОбластиСтрокТЦ.Вставить("ОбластьРазделитель",МакетТекущихЦен.ПолучитьОбласть("Пунктирная"));
	ОбластиСтрокТЦ.Вставить("ОбластьЦены",МакетТекущихЦен.ПолучитьОбласть("ДетальнаяСтрока"));
	ОбластиСтрокТЦ.Вставить("ОбластьГруппы",МакетТекущихЦен.ПолучитьОбласть("Группа"));
	ОбластиСтрокТЦ.Вставить("Шапка", МакетТекущихЦен.ПолучитьОбласть("Шапка"));
	ОбластиСтрокТЦ.Вставить("КолонкиПовтора", МакетТекущихЦен.ПолучитьОбласть("Шапка|КолонкиПовтора"));

	ОбластьМакета = МакетТекущихЦен.ПолучитьОбласть("Заголовок");
	ТабДокЦ.Вывести(ОбластьМакета);
	
	Если Не Смета=Неопределено Тогда
		ОбластьСтрокиТЦ = МакетТекущихЦен.ПолучитьОбласть("Данные");
		ОбластьСтрокиТЦ.Параметры.Данные = ПредставлениеОбъекта(Смета);
		ТабДокЦ.Вывести(ОбластьСтрокиТЦ);
	КонецЕсли;
	
	ОбластьМакета = МакетТекущихЦен.ПолучитьОбласть("Шапка");
	ОбластьМакета.Параметры.ДатаЦен = Формат(?(ЗначениеЗаполнено(Объект.ДатаТекущихЦен),Объект.ДатаТекущихЦен,ТекущаяДатаСеанса()),"ДФ=dd.MM.yyyy");
	ТабДокЦ.Вывести(ОбластьМакета);

КонецПроцедуры

Процедура ВывестиОбластьПодвал(ТабДок,Макет)
	ОбластьМакета = Макет.ПолучитьОбласть("Пунктирная");
	ТабДок.Вывести(ОбластьМакета);
КонецПроцедуры

Процедура ВывестиОбластьНетОшибок(ТабДок,Макет)
	ОбластьМакета = Макет.ПолучитьОбласть("НетОшибок");
