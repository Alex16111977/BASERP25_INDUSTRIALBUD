КонецПроцедуры

Функция ПредставлениеОбъекта(ДанныеОбъекта)
	Если ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Смета №%1 %2'"), Строка(ДанныеОбъекта.НомерСметы), Строка(ДанныеОбъекта.Наименование));
	ИначеЕсли ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Объектная смета №%1 %2'"), Строка(ДанныеОбъекта.НомерСметы), Строка(ДанныеОбъекта.Наименование));
	ИначеЕсли ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Сводная смета №%1 %2'"), Строка(ДанныеОбъекта.НомерСметы), (ДанныеОбъекта.Наименование));
	ИначеЕсли ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 %2 %3 %4'"), Строка(ДанныеОбъекта.ШифрРасценки), Строка(ДанныеОбъекта.Наименование), Строка(ДанныеОбъекта.ЕдиницаИзмерения), Строка(ДанныеОбъекта.ТипНормативныхСборников));
	ИначеЕсли ТипЗнч(ДанныеОбъекта) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Раздел %1'"), Строка(ДанныеОбъекта.НаименованиеДляПечати));
	КонецЕсли;
	Возврат Представление;
КонецФункции

Функция ПолучитьСметы(СметаСсылка)
	Если ТипЗнч(СметаСсылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		ТЗ = СметаСсылка.ЛокальныеСметы.выгрузить();
		МассивСмет = ТЗ.ВыгрузитьКолонку("ЛокальнаяСмета");
	ИначеЕсли ТипЗнч(СметаСсылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ТЗ = СметаСсылка.Сметы.выгрузить();
		МассивСмет = ТЗ.ВыгрузитьКолонку("Смета");
	КонецЕсли;	
	Возврат МассивСмет; 
КонецФункции

Функция ВернутьМассив(СметаСсылка)
	ТЗ = ПолучитьТаблицуПодчиненных(СметаСсылка);
	Возврат ТЗ.ВыгрузитьКолонку("Ид"); 
КонецФункции

Функция ПолучитьТаблицуПодчиненных(Ид) 
	
	Таблица = Новый ТаблицаЗначений();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Раздел,
	               |	СМ_НумерацияПозицийЛокальныхСмет.Позиция,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВДереве,
	               |	СМ_НумерацияПозицийЛокальныхСмет.НомерВПределахСметы,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер
	               |ПОМЕСТИТЬ Номера
	               |ИЗ
	               |	РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |ГДЕ
	               |	СМ_НумерацияПозицийЛокальныхСмет.Смета = &ИДРодителя
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметы.Ссылка КАК Ид,
	               |	ПозицияЛокальнойСметы.ИДРодителя КАК ИдРодителя,
	               |	ПозицияЛокальнойСметы.ИДСметы КАК ИДСметы,
	               |	ПозицияЛокальнойСметы.ИДПозицииВладельца КАК ИДПозицииВладельца
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Номера КАК Номера
	               |		ПО (Номера.Позиция = ПозицияЛокальнойСметы.Ссылка)
	               |			И (Номера.Раздел = ПозицияЛокальнойСметы.ИДРодителя)
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДСметы = &ИДРодителя
	               |	И НЕ ПозицияЛокальнойСметы.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Номера.ПорНомер";
	
	Запрос.УстановитьПараметр("ИДРодителя", Ид);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ВернутьРаздел(ОбъектПозиции)
    Возврат ОбъектПозиции.ИдРодителя;
КонецФункции

