			ЗначениеСНБ = ?(СтрСНБ.НормаРасхода=Неопределено,0,СтрСНБ.НормаРасхода);
			ИмяРеквизита = "НормаРасхода";
			Если стр.НормаРасхода <> ЗначениеСНБ Тогда
				Ошибка = Истина;
				стрОшибок.Всего_СНБ = ЗначениеСНБ;
				стрОшибок.Пояснение = НСтр("ru='расхождение норм'");

			КонецЕсли;
			Если стр.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				ТекПояснение = "";
				ЗначениеСНБ = ?(СтрСНБ.БазиснаяЦена=Неопределено,0,СтрСНБ.БазиснаяЦена);
				ИмяРеквизита = "БазиснаяЦена";
				Если стр.БазиснаяЦена <> ЗначениеСНБ Тогда
					Ошибка = Истина;
					стрОшибок.ОЗ_СНБ = ЗначениеСНБ;
					ТекПояснение = НСтр("ru='расхождение базисной экспл. машин'")+" ";
				КонецЕсли;
				
				ЗначениеСНБ = ?(СтрСНБ.БазиснаяЗарплатаМашинистов=Неопределено,0,СтрСНБ.БазиснаяЗарплатаМашинистов);
				ИмяРеквизита = "БазиснаяЗарплатаМашинистов";
				Если стр.БазиснаяЗарплатаМашинистов <> ЗначениеСНБ Тогда
