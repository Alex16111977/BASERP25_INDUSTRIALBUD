			стрОшибок.БЗМ = стр.БазиснаяЗарплатаМашинистов;
			стрОшибок.СНБ = Ложь;
			стрОшибок.Пояснение = НСтр("ru='отсутствует в БД (добавлен)'");
		КонецЕсли;	
		Если Ошибка Тогда
			ЕстьОшибкиЛок = Истина;
		КонецЕсли;
	КонецЦикла;
	Для каждого стрСНБ Из ТаблицаРесурсовСНБ Цикл
		ЕстьОшибкиЛок = Истина;
		стрОшибок = ТаблицаОшибок.Добавить();
		стрОшибок.Шифр = стрСНБ.СметныйКодРесурса;
		стрОшибок.Наименование = стрСНБ.Ресурс.Наименование;
		стрОшибок.Единица = стрСНБ.Ресурс.ЕдиницаИзмерения.Наименование;
		стрОшибок.Всего = стрСНБ.НормаРасхода;
		стрОшибок.ОЗ = стрСНБ.БазиснаяЦена;
		стрОшибок.БЗМ = стрСНБ.БазиснаяЗарплатаМашинистов;
		стрОшибок.СНБ = Ложь;
		стрОшибок.Пояснение = НСтр("ru='отсутствует в позиции (есть в БД)'");
	КонецЦикла;
	Если ЕстьОшибкиЛок Тогда
