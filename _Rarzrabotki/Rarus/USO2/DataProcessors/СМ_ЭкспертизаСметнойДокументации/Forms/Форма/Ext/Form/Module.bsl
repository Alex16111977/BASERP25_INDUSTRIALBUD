Процедура ВывестиОбластьМассы(ТабДок,Макет,ОбластьСтрок,СтрокаМасс)
	Если СтрокаМасс.МассаН<>Неопределено ИЛИ СтрокаМасс.МассаН_СНБ<>Неопределено Тогда
		ОбластьСтроки = ОбластьСтрок.ОбластьНетто;
		ОбластьСтроки.Параметры.МассаН = "";
		ОбластьСтроки.Параметры.МассаН_СНБ = "";
		ОбластьСтроки.Параметры.Заполнить(СтрокаМасс);
		ТабДок.Вывести(ОбластьСтроки);
	КонецЕсли;
	Если СтрокаМасс.МассаБ<>Неопределено ИЛИ СтрокаМасс.МассаБ_СНБ<>Неопределено Тогда
		ОбластьСтроки = ОбластьСтрок.ОбластьБрутто;
		ОбластьСтроки.Параметры.МассаБ = "";
		ОбластьСтроки.Параметры.МассаБ_СНБ = "";
		ОбластьСтроки.Параметры.Заполнить(СтрокаМасс);
		ТабДок.Вывести(ОбластьСтроки);
	КонецЕсли;

КонецПроцедуры

Процедура ВывестиИнформацию(ТабДок,Макет,ОбластьСтроки,Инфо)
	ОбластьСтроки.Параметры.Данные = Инфо;
	ТабДок.Вывести(ОбластьСтроки);
