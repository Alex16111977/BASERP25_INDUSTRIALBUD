	Запрос.УстановитьПараметр("ДатаТекЦен", ?(ЗначениеЗаполнено(Объект.ДатаТекущихЦен),НачалоДня(Объект.ДатаТекущихЦен),НачалоДня(ТекущаяДатаСеанса())));
	//Запрос.УстановитьПараметр("СНБ", СНБ);
	Запрос.УстановитьПараметр("СНБ", Объект.СНБ);
	Запрос.УстановитьПараметр("СписокРесурсов", СписокРесурсов.ВыгрузитьЗначения());
	//Запрос.УстановитьПараметр("Район", Район);
