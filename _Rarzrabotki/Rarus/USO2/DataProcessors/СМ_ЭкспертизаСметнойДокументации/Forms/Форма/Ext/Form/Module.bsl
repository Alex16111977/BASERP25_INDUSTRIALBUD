Процедура ВывестиОбластьИндексов(ТабДок,Макет,ОбластьСтрок,ТаблицаОшибокИндексов)
	
	Если ТаблицаОшибокИндексов.Количество()=1 Тогда
		СНБ = ТаблицаОшибокИндексов[0].СНБ;
		Если СНБ Тогда
			ОбластьСтроки = ОбластьСтрок.ОбластьОшибкиИндексы;
		Иначе
			ОбластьСтроки = ОбластьСтрок.ОбластьИндексы;
		КонецЕсли;
		ОбластьСтроки.Параметры.ОЗ = "";
		ОбластьСтроки.Параметры.ЭМ = "";
		ОбластьСтроки.Параметры.МАТ = "";
		ОбластьСтроки.Параметры.Пояснение = "";
		ОбластьСтроки.Параметры.Заполнить(ТаблицаОшибокИндексов[0]);
		ТабДок.Вывести(ОбластьСтроки);
	Иначе
		ОбластьСтроки = ОбластьСтрок.ОбластьИндексы;
		ОбластьСтроки.Параметры.ОЗ = "";
		ОбластьСтроки.Параметры.ЭМ = "";
		ОбластьСтроки.Параметры.МАТ = "";
		ОбластьСтроки.Параметры.Пояснение = "";
		ОбластьСтроки.Параметры.Заполнить(ТаблицаОшибокИндексов[0]);
		ТабДок.Вывести(ОбластьСтроки);
		
		ОбластьСтроки = ОбластьСтрок.ОбластьОшибкиИндексы;
		ОбластьСтроки.Параметры.ОЗ = "";
		ОбластьСтроки.Параметры.ЭМ = "";
		ОбластьСтроки.Параметры.МАТ = "";
		ОбластьСтроки.Параметры.Пояснение = "";
		ОбластьСтроки.Параметры.Заполнить(ТаблицаОшибокИндексов[1]);
		ТабДок.Вывести(ОбластьСтроки);
	КонецЕсли;
КонецПроцедуры

