Функция ЗагрузитьРесурсИзXML(Тег, Год = Неопределено, СНБ = Неопределено, ВставкаВПозицию = Истина, ВерсияФормата = 1)
	
	НаименованиеСправочника = "СМ_Ресурсы";
	
	КодРесурса = Тег.ПолучитьАтрибут(?(ВерсияФормата=1,"code","Code")); 
	Если Не ЗначениеЗаполнено(КодРесурса) Тогда
		КодРесурса = Тег.ПолучитьАтрибут("code");
	КонецЕсли;
	
	ОбъектДляЗаписи = НайтиРесурсПоСметномуКоду(КодРесурса, НаименованиеСправочника);
	Если ОбъектДляЗаписи = Справочники[НаименованиеСправочника].ПустаяСсылка() ИЛИ ОбъектДляЗаписи = неопределено Тогда
	Иначе 
		ОбъектДляЗаписи = ОбъектДляЗаписи.ПолучитьОбъект().ссылка;
	КонецЕсли;
	Возврат ОбъектДляЗаписи;
	
КонецФункции

// Поиск в справочнике ресурсов.
Функция НайтиРесурсПоСметномуКоду(Код, НаименованиеСправочника = "СМ_Ресурсы")
	
	Ресурс = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		               |	СправочникСмета.Ссылка КАК Ресурс
	    	           |ИЗ
	        	       |	Справочник."+НаименованиеСправочника+" КАК СправочникСмета
	            	   |ГДЕ
		               |	СправочникСмета.Код = &СметныйКод";
				   
	       
	Запрос.УстановитьПараметр("СметныйКод",Код);
	РесурсыДанные = Запрос.Выполнить().Выбрать();
	Если РесурсыДанные.Следующий() Тогда
		Ресурс = РесурсыДанные.Ресурс;
	КонецЕсли; 
	Если РесурсыДанные.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Нарушен регистр сметных реквизитов справочника %1!!!%2'"), НаименованиеСправочника, СтатусСообщения.ОченьВажное));	
	КонецЕсли;
	Возврат(Ресурс);

	
КонецФункции


Процедура СверитьРаботыПозицииЛСИзXML(ТаблицаРаботСНБ,Тег,Объект,ЕстьОшибки)
	
	НоваяСтрокаТЧ = ТаблицаРаботСНБ.Добавить();
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "number" ИЛИ ТегИмя = "code" Тогда
			НоваяСтрокаТЧ.Номер = Число(Тег.Значение); 	
		ИначеЕсли ТегИмя = "work" ИЛИ ТегИмя = "description" Тогда
			НоваяСтрокаТЧ.НаименованиеРаботы = Тег.Значение; 	
		КонецЕсли;
	КонецЦикла;
	

КонецПроцедуры

Процедура СверитьДанныеВПозицииЛС(Данные,ДанныеЦен,ДанныеИнд, ПозицияЛС, ПараметрыСметы,ТабДок,Макет,ОбластьСтроки,ЕстьОшибки,Раздел,ШапкаВыведена,СметаЛС,СметаРодитель, ВерсияКомпоненты = 1)  
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Данные);
	
	ТипРасценки = "БазисныеЦены";
	
	ТаблицаДанныхПозиции = Новый ТаблицаЗначений;
	ТаблицаДанныхПозиции.Колонки.Добавить("Шифр");
	ТаблицаДанныхПозиции.Колонки.Добавить("Наименование");
	ТаблицаДанныхПозиции.Колонки.Добавить("Единица");
	ТаблицаДанныхПозиции.Колонки.Добавить("ОЗ");
	ТаблицаДанныхПозиции.Колонки.Добавить("ЭМ");
	ТаблицаДанныхПозиции.Колонки.Добавить("ЗМ");
	ТаблицаДанныхПозиции.Колонки.Добавить("МАТ");
	ТаблицаДанныхПозиции.Колонки.Добавить("Всего"); 
	ТаблицаДанныхПозиции.Колонки.Добавить("ЗТМ");
	ТаблицаДанныхПозиции.Колонки.Добавить("ЗТР");
	ТаблицаДанныхПозиции.Колонки.Добавить("МассаН");
	ТаблицаДанныхПозиции.Колонки.Добавить("МассаН_СНБ");
	ТаблицаДанныхПозиции.Колонки.Добавить("МассаБ");
	ТаблицаДанныхПозиции.Колонки.Добавить("МассаБ_СНБ");
	
	ТаблицаРесурсовСНБ = Новый ТаблицаЗначений;
	ТаблицаРесурсовСНБ.Колонки.Добавить("ТипМатериала");
	ТаблицаРесурсовСНБ.Колонки.Добавить("НормаРасхода");
	ТаблицаРесурсовСНБ.Колонки.Добавить("БазиснаяЦена");
	ТаблицаРесурсовСНБ.Колонки.Добавить("БазиснаяЗарплатаМашинистов");
	ТаблицаРесурсовСНБ.Колонки.Добавить("СметныйКодРесурса");
	ТаблицаРесурсовСНБ.Колонки.Добавить("Ресурс");
	ТаблицаРесурсовСНБ.Колонки.Добавить("ВидРесурса");

	ТаблицаРаботСНБ = Новый ТаблицаЗначений;
	ТаблицаРаботСНБ.Колонки.Добавить("Номер");
	ТаблицаРаботСНБ.Колонки.Добавить("НаименованиеРаботы");
	ОшибкиЦен = Ложь;
	ОшибкиНаимен = Ложь;
	Если Объект.ЭкспертизаСНБ Тогда
		СтрокаПозицииСНБ = ТаблицаДанныхПозиции.Добавить();
		Пока ЧтениеXML.Прочитать() Цикл
			Если (ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента)ИЛИ(ЧтениеXML.ТипУзла = ТипУзлаXML.Текст) Тогда
				Имя = НРег(ЧтениеXML.Имя);
				Если Имя = "norm" Тогда
					 СверитьРасценкиПозицииЛСИзXML(ЧтениеXML,ПозицияЛС, ТипРасценки, ПараметрыСметы.МетодикаТСН,ОшибкиНаимен,СтрокаПозицииСНБ);
				ИначеЕсли Имя = "resource" Тогда
					СверитьРеcурсыПозицииЛСИзXML(ТаблицаРесурсовСНБ,ЧтениеXML,ПозицияЛС, ПараметрыСметы,ЕстьОшибки, ВерсияКомпоненты);
				ИначеЕсли Имя = "work" Тогда
					СверитьРаботыПозицииЛСИзXML(ТаблицаРаботСНБ,ЧтениеXML,ПозицияЛС,ЕстьОшибки);
				ИначеЕсли Имя = "pz" Тогда
					Если ТипРасценки = "БазисныеЦены" Тогда
						СверитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ПрямЗатраты",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"Всего");
					КонецЕсли;
				ИначеЕсли Имя = "zpr" Тогда
					Если ТипРасценки = "БазисныеЦены" Тогда
						СверитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ОснЗарплата",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"ОЗ");
					КонецЕсли;
				ИначеЕсли Имя = "mm" Тогда
					Если ТипРасценки = "БазисныеЦены" Тогда
						СверитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ЭксплМашин",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"ЭМ");
					КонецЕсли;
				ИначеЕсли Имя = "zpmm" Тогда
					Если ТипРасценки = "БазисныеЦены" Тогда
						СверитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"ЗарплМашинистов",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"ЗМ");
					КонецЕсли;
				ИначеЕсли Имя = "smat" Тогда
					Если ТипРасценки = "БазисныеЦены" Тогда
						СверитьРеквизитПозицииЛСИзXML(ЧтениеXML,ПозицияЛС,"СтоимМатериалов",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"МАТ");
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли;
	ОшибкаПозиции = ЕстьОшибки;
	Если Объект.СверятьРесурсы Тогда
		ТаблицаОшибокРесурсов = СверкаРесурсов(ТаблицаРесурсовСНБ,ПозицияЛС,ЕстьОшибки);	
	КонецЕсли;
	Если Объект.СверятьРаботы Тогда
		ТаблицаОшибокРабот = СверкаРабот(ТаблицаРаботСНБ,ПозицияЛС,ЕстьОшибки);
	КонецЕсли;
	Если Объект.ЭкспертизаИндексов Тогда
		ТаблицаОшибокИндексов = СверитьИндексыВПозиции(ПозицияЛС, ДанныеИнд, ВариантПересчетаЭММ(ПозицияЛС),ЕстьОшибки);	
	КонецЕсли;
	Если Объект.ЭкспертизаНРСП Тогда
		ТаблицаОшибокНРСП = СверитьНРСПВПозиции(ПозицияЛС,ЕстьОшибки);	
	КонецЕсли;

	ОшибкаРесурс = ?(Объект.СверятьРесурсы,?(ТаблицаОшибокРесурсов.Количество()=0,Ложь,Истина),Ложь);
	ОшибкаРабот = ?(Объект.СверятьРаботы,?(ТаблицаОшибокРабот.Количество()=0,Ложь,Истина),Ложь);
	ОшибкаИнд = ?(Объект.ЭкспертизаИндексов,?(ТаблицаОшибокИндексов.Количество()=0,Ложь,Истина),Ложь);
	ОшибкаНРСП = ?(Объект.ЭкспертизаНРСП,?(ТаблицаОшибокНРСП.Количество()=0,Ложь,Истина),Ложь);
	
	Если ОшибкиНаимен Или ОшибкиЦен Или ОшибкаПозиции Или ОшибкаРесурс Или ОшибкаРабот Или ОшибкаИнд Или ОшибкаНРСП Тогда
		
		Если Не ШапкаВыведена Тогда
			ШапкаВыведена = Истина;
			Если Не СметаРодитель = Неопределено Тогда
				ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СметаРодитель);
			КонецЕсли;
			ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СметаЛС);
		КонецЕсли;
		
		РазделПозиции = ВернутьРаздел(ПозицияЛС);
		Если Раздел = Неопределено Тогда
			Раздел = РазделПозиции;
			ВывестиОбластьРаздел(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,РазделПозиции);
		ИначеЕсли Раздел<>РазделПозиции Тогда
			Раздел = РазделПозиции;
			ВывестиОбластьРаздел(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,РазделПозиции);
		КонецЕсли;
		ВывестиОбластьПозиции(ТабДок,Макет,ОбластьСтроки,ПозицияЛС,ОшибкаРесурс,ОшибкаРабот,ОшибкиЦен,ОшибкиНаимен,ОшибкаИнд);
		ВывестиОбластьПозицииОшибки(ТабДок,Макет,ОбластьСтроки,СтрокаПозицииСНБ);
		ВывестиОбластьПодвал(ТабДок,Макет);
		
		Если ОшибкаРесурс Тогда
			Инфо = НСтр("ru='Расхождение по ресурсам, нормам расхода и базисным ценам'");
			ВывестиИнформацию(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,Инфо);
			Для каждого СтрокаРесурс Из ТаблицаОшибокРесурсов Цикл
				ВывестиОбластьРесурсы(ТабДок,Макет,ОбластьСтроки,СтрокаРесурс);
			КонецЦикла;
			ВывестиОбластьПодвал(ТабДок,Макет);
		КонецЕсли;
		
		Если ОшибкаРабот Тогда
			Инфо = НСтр("ru='Расхождение по составу работ'");
			ВывестиИнформацию(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,Инфо);
			Для каждого СтрокаРабота Из ТаблицаОшибокРабот Цикл
				ВывестиОбластьРабот(ТабДок,Макет,ОбластьСтроки,СтрокаРабота);
			КонецЦикла;
			ВывестиОбластьПодвал(ТабДок,Макет);
		КонецЕсли;
		
		Если ОшибкаИнд Тогда
			Инфо = НСтр("ru='Расхождение по индексам'");
			ВывестиИнформацию(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,Инфо);
			ВывестиОбластьИндексов(ТабДок,Макет,ОбластьСтроки,ТаблицаОшибокИндексов);
			ВывестиОбластьПодвал(ТабДок,Макет);
		КонецЕсли;
		
		Если ОшибкаНРСП Тогда
			Инфо = НСтр("ru='Экспертиза НР и СП'");
			ВывестиИнформацию(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,Инфо);
			ВывестиОбластьНРСП(ТабДок,Макет,ОбластьСтроки,ТаблицаОшибокНРСП);
			ВывестиОбластьПодвал(ТабДок,Макет);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

Процедура СверитьДанныеВПозицииЛСНормы(Данные,ПозицияЛС, ПараметрыСметы,ТабДок,Макет,ОбластьСтроки,ЕстьОшибки,Раздел,ШапкаВыведена,СметаЛС,СметаРодитель)  
	
	ТаблицаДанныхПозиции = Новый ТаблицаЗначений;
	ТаблицаДанныхПозиции.Колонки.Добавить("Шифр");
	ТаблицаДанныхПозиции.Колонки.Добавить("Наименование");
	ТаблицаДанныхПозиции.Колонки.Добавить("Единица");
	ТаблицаДанныхПозиции.Колонки.Добавить("ОЗ");
	ТаблицаДанныхПозиции.Колонки.Добавить("ЭМ");
	ТаблицаДанныхПозиции.Колонки.Добавить("ЗМ");
	ТаблицаДанныхПозиции.Колонки.Добавить("МАТ");
	ТаблицаДанныхПозиции.Колонки.Добавить("Всего"); 
	ТаблицаДанныхПозиции.Колонки.Добавить("ЗТМ");
	ТаблицаДанныхПозиции.Колонки.Добавить("ЗТР");
	ТаблицаДанныхПозиции.Колонки.Добавить("МассаН");
	ТаблицаДанныхПозиции.Колонки.Добавить("МассаН_СНБ");
	ТаблицаДанныхПозиции.Колонки.Добавить("МассаБ");
	ТаблицаДанныхПозиции.Колонки.Добавить("МассаБ_СНБ");
	
	ТаблицаРесурсовСНБ = Новый ТаблицаЗначений;
	ТаблицаРесурсовСНБ.Колонки.Добавить("ТипМатериала");
	ТаблицаРесурсовСНБ.Колонки.Добавить("НормаРасхода");
	ТаблицаРесурсовСНБ.Колонки.Добавить("БазиснаяЦена");
	ТаблицаРесурсовСНБ.Колонки.Добавить("БазиснаяЗарплатаМашинистов");
	ТаблицаРесурсовСНБ.Колонки.Добавить("СметныйКодРесурса");
	ТаблицаРесурсовСНБ.Колонки.Добавить("Ресурс");
	ТаблицаРесурсовСНБ.Колонки.Добавить("ВидРесурса");

	ТаблицаРаботСНБ = Новый ТаблицаЗначений;
	ТаблицаРаботСНБ.Колонки.Добавить("Номер");
	ТаблицаРаботСНБ.Колонки.Добавить("НаименованиеРаботы");
	ОшибкиЦен = Ложь;
	ОшибкиНаимен = Ложь;
	Если Объект.ЭкспертизаСНБ Тогда
		Если ТипЗнч(Данные) = Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда
			МассивЦен = Данные.ЦеныНормативныхСборников.НайтиСтроки(Новый Структура("РегиональнаяБаза,Район",Объект.СНБ,ПозицияЛС.ИДСметы.Район));
			ЦеныНормы = Неопределено;
			Если МассивЦен.Количество() > 0 Тогда
				ЦеныНормы = МассивЦен[0];
			КонецЕсли;
			СтрокаПозицииСНБ = ТаблицаДанныхПозиции.Добавить();
			СверитьРасценкиПозицииЛСИзНорм(Данные,ПозицияЛС,ПараметрыСметы.МетодикаТСН,ОшибкиНаимен,СтрокаПозицииСНБ,ЦеныНормы);
			СверитьРеквизитПозицииЛСИзНорм(ЦеныНормы,ПозицияЛС,"ПрямЗатраты",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"Всего","ПрямыеЗатраты");
			СверитьРеквизитПозицииЛСИзНорм(ЦеныНормы,ПозицияЛС,"ОснЗарплата",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"ОЗ","ОсновнаяЗарплата");
			СверитьРеквизитПозицииЛСИзНорм(ЦеныНормы,ПозицияЛС,"ЭксплМашин",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"ЭМ","ЭксплуатацияМашинИМеханизмов");
			СверитьРеквизитПозицииЛСИзНорм(ЦеныНормы,ПозицияЛС,"ЗарплМашинистов",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"ЗМ","ВТомЧислеЗарплатаМашинистов");
			СверитьРеквизитПозицииЛСИзНорм(ЦеныНормы,ПозицияЛС,"СтоимМатериалов",Истина,ОшибкиЦен,СтрокаПозицииСНБ,"МАТ","СтоимостьМатериалов");
		Иначе
			СтрокаПозицииСНБ = ТаблицаДанныхПозиции.Добавить();
			СверитьРасценкиПозицииЛСИзРесурс(Данные,ПозицияЛС,ПараметрыСметы.МетодикаТСН,ОшибкиНаимен,СтрокаПозицииСНБ);
		КонецЕсли;
	КонецЕсли;
	ОшибкаПозиции = ЕстьОшибки;
	Если Объект.СверятьРесурсы И ТипЗнч(Данные) = Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда
		ТаблицаОшибокРесурсов = СверкаРесурсовНорм(Данные,ПозицияЛС,ЕстьОшибки);	
	КонецЕсли;
	Если Объект.СверятьРаботы И ТипЗнч(Данные) = Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда
		ТаблицаОшибокРабот = СверкаРаботНорм(Данные,ПозицияЛС,ЕстьОшибки);
	КонецЕсли;

	Если ТипЗнч(Данные) = Тип("СправочникСсылка.СМ_НормативныеСборники") Тогда
		ОшибкаРесурс = ?(Объект.СверятьРесурсы,?(ТаблицаОшибокРесурсов.Количество()=0,Ложь,Истина),Ложь);
		ОшибкаРабот = ?(Объект.СверятьРаботы,?(ТаблицаОшибокРабот.Количество()=0,Ложь,Истина),Ложь);
	Иначе
		ОшибкаРесурс = Ложь;
		ОшибкаРабот = Ложь;
	КонецЕсли;
	ОшибкаИнд = Ложь;
	ОшибкаНРСП = Ложь;
	
	Если ОшибкиНаимен Или ОшибкиЦен Или ОшибкаПозиции Или ОшибкаРесурс Или ОшибкаРабот Или ОшибкаИнд Или ОшибкаНРСП Тогда
		
		Если Не ШапкаВыведена Тогда
			ШапкаВыведена = Истина;
			Если Не СметаРодитель = Неопределено Тогда
				ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СметаРодитель);
			КонецЕсли;
			ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,СметаЛС);
		КонецЕсли;
		
		РазделПозиции = ВернутьРаздел(ПозицияЛС);
		Если Раздел = Неопределено Тогда
			Раздел = РазделПозиции;
			ВывестиОбластьРаздел(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,РазделПозиции);
		ИначеЕсли Раздел<>РазделПозиции Тогда
			Раздел = РазделПозиции;
			ВывестиОбластьРаздел(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,РазделПозиции);
		КонецЕсли;
		ВывестиОбластьПозиции(ТабДок,Макет,ОбластьСтроки,ПозицияЛС,ОшибкаРесурс,ОшибкаРабот,ОшибкиЦен,ОшибкиНаимен,ОшибкаИнд);
		ВывестиОбластьПозицииОшибки(ТабДок,Макет,ОбластьСтроки,СтрокаПозицииСНБ);
		ВывестиОбластьПодвал(ТабДок,Макет);
		
		Если ОшибкаРесурс Тогда
			Инфо = НСтр("ru='Расхождение по ресурсам, нормам расхода и базисным ценам'");
			ВывестиИнформацию(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,Инфо);
			Для каждого СтрокаРесурс Из ТаблицаОшибокРесурсов Цикл
				ВывестиОбластьРесурсы(ТабДок,Макет,ОбластьСтроки,СтрокаРесурс);
			КонецЦикла;
			ВывестиОбластьПодвал(ТабДок,Макет);
		КонецЕсли;
		
		Если ОшибкаРабот Тогда
			Инфо = НСтр("ru='Расхождение по составу работ'");
			ВывестиИнформацию(ТабДок,Макет,ОбластьСтроки.ОбластьСметы,Инфо);
			Для каждого СтрокаРабота Из ТаблицаОшибокРабот Цикл
				ВывестиОбластьРабот(ТабДок,Макет,ОбластьСтроки,СтрокаРабота);
			КонецЦикла;
			ВывестиОбластьПодвал(ТабДок,Макет);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

Процедура СверитьРасценкиПозицииЛСИзXML(Тег, Объект, ТипРасценки, ЭтоТСН,ЕстьОшибки,СтрокаПозицииСНБ)
	
	ТипРасценки = "БазисныеЦены";
	
	Пока Тег.ПрочитатьАтрибут() Цикл
		ЕстьОшибкиЛок = Ложь;
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "code" Тогда
			ЗначениеСНБ = Тег.Значение; 
			Если Объект.ШифрРасценки <> ЗначениеСНБ Тогда
				ЕстьОшибкиЛок = Истина;
				ИмяРеквизита = "ШифрРасценки";
			КонецЕсли;
			СтрокаПозицииСНБ.Шифр = ЗначениеСНБ;
		ИначеЕсли ТегИмя = "name" Тогда
			ЗначениеСНБ = Тег.Значение; 
			Если Объект.Наименование <> ЗначениеСНБ Тогда
				ЕстьОшибкиЛок = Истина;
				ИмяРеквизита = "Наименование";
			КонецЕсли;
			СтрокаПозицииСНБ.Наименование = ЗначениеСНБ;
		ИначеЕсли ТегИмя = "izm" Тогда
		ИначеЕсли ТегИмя = "unit" Тогда
			ЗначениеСНБ = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоКоду(Тег.Значение); 
			Если Объект.ЕдиницаИзмерения <> ЗначениеСНБ Тогда
				ЕстьОшибкиЛок = Истина;
				ИмяРеквизита = "ЕдиницаИзмерения";
			КонецЕсли;
			СтрокаПозицииСНБ.Единица = ЗначениеСНБ;
		ИначеЕсли (ТегИмя = "mass1")ИЛИ(ТегИмя = "mas1") Тогда
			ЗначениеСНБ = Число(Тег.Значение); 
			Если Объект.МассаБрутто <> ЗначениеСНБ Тогда
				ЕстьОшибкиЛок = Истина;
				ИмяРеквизита = "МассаБрутто";
				СтрокаПозицииСНБ.МассаБ = Объект.МассаБрутто;
				СтрокаПозицииСНБ.МассаБ_СНБ = ЗначениеСНБ;
			КонецЕсли;
		ИначеЕсли (ТегИмя = "mass2")ИЛИ(ТегИмя = "mas2") Тогда
			ЗначениеСНБ = Число(Тег.Значение); 
			Если Объект.МассаНетто <> ЗначениеСНБ Тогда
				ЕстьОшибкиЛок = Истина;
				ИмяРеквизита = "МассаНетто";
				СтрокаПозицииСНБ.МассаН = Объект.МассаНетто;
				СтрокаПозицииСНБ.МассаН_СНБ = ЗначениеСНБ;
			КонецЕсли;
		ИначеЕсли ТегИмя = "opr" Тогда
			ЗначениеСНБ = Справочники.СМ_Определители.НайтиПоКоду(Число(Тег.Значение)); 
			Если Объект.Определитель <> ЗначениеСНБ Тогда
				ЕстьОшибкиЛок = Истина;
				ИмяРеквизита = "Определитель";
			КонецЕсли;
		ИначеЕсли ТегИмя = "ztr" Тогда
			ЗначениеСНБ = Число(Тег.Значение); 
			Если Объект.ЗатратыТрудаРабочих <> ЗначениеСНБ Тогда
				ЕстьОшибкиЛок = Истина;
				ИмяРеквизита = "ЗатратыТрудаРабочих";
			КонецЕсли;
			СтрокаПозицииСНБ.ЗТР = ЗначениеСНБ;
		ИначеЕсли ТегИмя = "ztm" Тогда
			ЗначениеСНБ = Число(Тег.Значение); 
			Если Объект.ЗатратыТрудаМашинистов <> ЗначениеСНБ Тогда
				ЕстьОшибкиЛок = Истина;
				ИмяРеквизита = "ЗатратыТрудаМашинистов";
			КонецЕсли;
			СтрокаПозицииСНБ.ЗТМ = ЗначениеСНБ;
		КонецЕсли;
		
		Если ЕстьОшибкиЛок Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Процедура СверитьРеквизитПозицииЛСИзXML(ЧтениеXML, Объект, ИмяРеквизита,ЭтоЧисло,ЕстьОшибки,СтрокаПозицииСНБ,ИмяКолонки)
	
	ЧтениеXML.Прочитать();
	Если ЭтоЧисло Тогда
		ЗначениеСНБ = Число(ЧтениеXML.Значение);
	Иначе
		ЗначениеСНБ = ЧтениеXML.Значение;
	КонецЕсли;
	СтрокаПозицииСНБ[ИмяКолонки] = ЗначениеСНБ;
	Если Объект[ИмяРеквизита] <> ЗначениеСНБ Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура СверитьРасценкиПозицииЛСИзНорм(Норма, Объект,ЭтоТСН,ЕстьОшибки,СтрокаПозицииСНБ,ЦеныНормы)
	
	ЕстьОшибкиЛок = Ложь;
	
	ЗначениеСНБ = Норма.КодНормативнойРасценки; 
	Если Объект.ШифрРасценки <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
	КонецЕсли;
	СтрокаПозицииСНБ.Шифр = ЗначениеСНБ;
	
	ЗначениеСНБ = Норма.ДлинноеНаименование; 
	Если Объект.Наименование <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
	КонецЕсли;
	СтрокаПозицииСНБ.Наименование = ЗначениеСНБ;
	
	ЗначениеСНБ = Норма.ЕдиницаИзмерения; 
	Если Объект.ЕдиницаИзмерения <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
	КонецЕсли;
	СтрокаПозицииСНБ.Единица = ЗначениеСНБ;
	
	ЗначениеСНБ = Норма.МассаБруттоТ; 
	Если Объект.МассаБрутто <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
		СтрокаПозицииСНБ.МассаБ = Объект.МассаБрутто;
		СтрокаПозицииСНБ.МассаБ_СНБ = ЗначениеСНБ;
	КонецЕсли;
	
	ЗначениеСНБ = Норма.МассаНеттоТ; 
	Если Объект.МассаНетто <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
		СтрокаПозицииСНБ.МассаН = Объект.МассаНетто;
		СтрокаПозицииСНБ.МассаН_СНБ = ЗначениеСНБ;
	КонецЕсли;
	
	ЗначениеСНБ = Норма.Определитель; 
	Если Объект.Определитель <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
	КонецЕсли;
	
	ЗначениеСНБ = ?(ЦеныНормы = Неопределено,0,ЦеныНормы.ЗатратыТрудаРабочих); 
	Если Объект.ЗатратыТрудаРабочих <> ЗначениеСНБ Тогда
		ЕстьОшибкиЛок = Истина;
	КонецЕсли;
	СтрокаПозицииСНБ.ЗТР = ЗначениеСНБ;
	
	Если ЕстьОшибкиЛок Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура СверитьРасценкиПозицииЛСИзРесурс(Ресурс, Объект,ЭтоТСН,ЕстьОшибки,СтрокаПозицииСНБ)
	
