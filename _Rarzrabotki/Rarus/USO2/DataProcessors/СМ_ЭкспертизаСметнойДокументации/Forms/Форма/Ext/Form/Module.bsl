&НаСервере
Функция СверитьИндексыВПозиции(Позиция, ДанныеОбИндексах, ВариантПересчетаЭММ,ЕстьОшибки)
	Ошибка = Ложь;
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("ОЗ");
	ТаблицаОшибок.Колонки.Добавить("ЭМ");
	ТаблицаОшибок.Колонки.Добавить("ЗМ");
	ТаблицаОшибок.Колонки.Добавить("МАТ");
	ТаблицаОшибок.Колонки.Добавить("Пояснение");
	ТаблицаОшибок.Колонки.Добавить("СНБ");

	Если Не ЗначениеЗаполнено(ДанныеОбИндексах) Тогда
		Возврат ТаблицаОшибок;
	КонецЕсли;
	ТаблицаИндексов = СМ_СметаЗагрузкаВызовСервера.ЗагрузитьИндексыВТаблицу(ДанныеОбИндексах);
	Если Не ТаблицаИндексов.Количество() = 0 И Не Позиция.НеПрименятьИндексы Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("ШифрРасценки", Позиция.ШифрРасценки);
		Отбор.Вставить("ТипНормативногоСборника", Позиция.ТипНормативныхСборников);
		МассивИндексов = ТаблицаИндексов.НайтиСтроки(Отбор);
	КонецЕсли;
	Если МассивИндексов = Неопределено Тогда
		Возврат ТаблицаОшибок;
	КонецЕсли;
	Если Позиция.КоэффициентыПересчета.Количество()=0 И МассивИндексов.Количество()>0 Тогда
		СтрИнд = ТаблицаОшибок.Добавить();
		СтрИнд.ОЗ = МассивИндексов[0].КоэффОснЗарплаты;
		СтрИнд.ЭМ = МассивИндексов[0].КоэффСтоимЭксплМашин;
		СтрИнд.ЗМ = МассивИндексов[0].КоэффСтоимЗарплатеМашин;
		СтрИнд.МАТ = МассивИндексов[0].КоэффСтоимМатериалов;
		СтрИнд.Пояснение = НСтр("ru='Отсутствует в расценке.'");
		СтрИнд.СНБ = Истина;
		Ошибка = Истина;
	ИначеЕсли Позиция.КоэффициентыПересчета.Количество()>0 И МассивИндексов.Количество()=0 Тогда
		СтрИнд = ТаблицаОшибок.Добавить();
		СтрИнд.ОЗ = Позиция.КоэффициентыПересчета[0].КоэффОснЗарплаты;
		СтрИнд.ЭМ = Позиция.КоэффициентыПересчета[0].КоэффСтоимЭксплМашин;
		СтрИнд.ЗМ = Позиция.КоэффициентыПересчета[0].КоэффСтоимЗарплатеМашин;
		СтрИнд.МАТ = Позиция.КоэффициентыПересчета[0].КоэффСтоимМатериалов;
		СтрИнд.Пояснение = НСтр("ru='Отсутствует в СНБ.'");
		СтрИнд.СНБ = Ложь;
		Ошибка = Истина;
	ИначеЕсли Позиция.КоэффициентыПересчета.Количество()>0 И МассивИндексов.Количество()>0 Тогда
		СтрПозиции = Позиция.КоэффициентыПересчета[0];
		СтрИндекс = МассивИндексов[0];
		Если СтрПозиции.КоэффОснЗарплаты<>СтрИндекс.КоэффОснЗарплаты Тогда
			Ошибка = Истина;
		КонецЕсли;
		Если СтрПозиции.КоэффСтоимЭксплМашин<>СтрИндекс.КоэффСтоимЭксплМашин Тогда
			Ошибка = Истина;
		КонецЕсли;
		Если СтрПозиции.КоэффСтоимМатериалов<>СтрИндекс.КоэффСтоимМатериалов Тогда
			Ошибка = Истина;
		КонецЕсли;
		Если Ошибка Тогда
			СтрИнд = ТаблицаОшибок.Добавить();
			СтрИнд.ОЗ = Позиция.КоэффициентыПересчета[0].КоэффОснЗарплаты;
			СтрИнд.ЭМ = Позиция.КоэффициентыПересчета[0].КоэффСтоимЭксплМашин;
			СтрИнд.ЗМ = Позиция.КоэффициентыПересчета[0].КоэффСтоимЗарплатеМашин;
			СтрИнд.МАТ = Позиция.КоэффициентыПересчета[0].КоэффСтоимМатериалов;
			
			СтрИнд1 = ТаблицаОшибок.Добавить();
			СтрИнд1.ОЗ = МассивИндексов[0].КоэффОснЗарплаты;
			СтрИнд1.ЭМ = МассивИндексов[0].КоэффСтоимЭксплМашин;
			СтрИнд1.ЗМ = МассивИндексов[0].КоэффСтоимЗарплатеМашин;
			СтрИнд1.МАТ = МассивИндексов[0].КоэффСтоимМатериалов;
		КонецЕсли;
	КонецЕсли;
	
	
	Если Ошибка Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;

	Возврат ТаблицаОшибок;
КонецФункции

&НаСервере
Функция СверитьНРСПВПозиции(Позиция, ЕстьОшибки)
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("Наименование");
	ТаблицаОшибок.Колонки.Добавить("Значение");
	ТаблицаОшибок.Колонки.Добавить("ЗначениеНорм");
	СтруктураПараметровЛС = ПолучитьСтруктуруПараметровРасчетаЛС(Позиция.ИдСметы);
	
	ТекМетодика = Позиция.ИДСметы.МетодикаРасчета;
	Норматив 	= СМ_СметаВызовСервера.ПолучитьНормативыНРиСП(Позиция.ТипНормативныхСборников, СтруктураПараметровЛС.ТипРайона, Позиция.ШифрРасценки, ТекМетодика, СтруктураПараметровЛС.МетодикаКазахстана);
	Если Не Норматив = Неопределено Тогда
		
		Если Позиция.ВидРабот <> Норматив.ВидРаботДляНачисленияНРиСП Тогда
			 СтрОшибок = ТаблицаОшибок.Добавить();
			 СтрОшибок.Наименование = НСтр("ru='Вид работ'");
			 СтрОшибок.Значение = Позиция.ВидРабот;
			 СтрОшибок.ЗначениеНорм = Норматив.ВидРаботДляНачисленияНРиСП;
		КонецЕсли;
		СтрокаНорматива 					= Норматив.Нормативы.Найти(СтруктураПараметровЛС.ТипРайона);
		Если Позиция.НакладныеРасходыБазисные <> СтрокаНорматива.НормативНакладныхРасходов Тогда
			 СтрОшибок = ТаблицаОшибок.Добавить();
			 СтрОшибок.Наименование = НСтр("ru='Накладные расходы % базисные'");
			 СтрОшибок.Значение = Позиция.НакладныеРасходыБазисные;
			 СтрОшибок.ЗначениеНорм = СтрокаНорматива.НормативНакладныхРасходов;
		КонецЕсли;
		Если Позиция.СметнаяПрибыльБазисные <> СтрокаНорматива.НормативСметнойПрибыли Тогда
			 СтрОшибок = ТаблицаОшибок.Добавить();
			 СтрОшибок.Наименование = НСтр("ru='Сметная прибыль % базисные'");
			 СтрОшибок.Значение = Позиция.СметнаяПрибыльБазисные;
			 СтрОшибок.ЗначениеНорм = СтрокаНорматива.НормативСметнойПрибыли;
		КонецЕсли;
		Если Позиция.НакладныеРасходыТекущие <>  СтрокаНорматива.НормативНакладныхРасходов Тогда
			 СтрОшибок = ТаблицаОшибок.Добавить();
			 СтрОшибок.Наименование = НСтр("ru='Накладные расходы % текущие'");
			 СтрОшибок.Значение = Позиция.НакладныеРасходыТекущие;
			 СтрОшибок.ЗначениеНорм = СтрокаНорматива.НормативНакладныхРасходов;
		КонецЕсли;
		Если Позиция.СметнаяПрибыльТекущие <> СтрокаНорматива.НормативСметнойПрибыли Тогда
			 СтрОшибок = ТаблицаОшибок.Добавить();
			 СтрОшибок.Наименование = НСтр("ru='Сметная прибыль % текущие'");
			 СтрОшибок.Значение = Позиция.СметнаяПрибыльТекущие;
			 СтрОшибок.ЗначениеНорм = СтрокаНорматива.НормативСметнойПрибыли;
		КонецЕсли;
		
		КоэффНРРемонтБазис 	= Константы.СМ_КоэффициентНРбазисныйРемонт.Получить();
		КоэффНРРемонт  		= Константы.СМ_КоэффициентНРтекущийРемонт.Получить();
		КоэффНРУСН 			= Константы.СМ_КоэффициентНРтекущийУСН.Получить();
		КоэффНРУСНБазис 	= Константы.СМ_КоэффициентНРбазисныйУСН.Получить();
		КоэффНРАЭС 			= Константы.СМ_КоэффициентНРтекущийАЭС.Получить();
		КоэффНРАЭСБазис 	= Константы.СМ_КоэффициентНРбазисныйАЭС.Получить();
		
		КоэффСПРемонтБазис 	= Константы.СМ_КоэффициентСПбазисныйРемонт.Получить();
		КоэффСПРемонт  		= Константы.СМ_КоэффициентСПтекущийРемонт.Получить();
		КоэффСПУСН 			= Константы.СМ_КоэффициентСПтекущийУСН.Получить();
		КоэффСПУСНБазис 	= Константы.СМ_КоэффициентСПбазисныйУСН.Получить();
		КоэффСПАЭС 			= Константы.СМ_КоэффициентСПтекущийАЭС.Получить();
		КоэффСПАЭСБазис 	= Константы.СМ_КоэффициентСПбазисныйАЭС.Получить();
		
		Если НЕ СтруктураПараметровЛС.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.НовоеСтроительство Тогда
			Если СтруктураПараметровЛС.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ПрименятьНРиСП Тогда
				Если Норматив.ПрименитьКоэффициентНР = Истина  Тогда
					Если Позиция.КоэффициентКНРНаРемонтБазисный <> КоэффНРРемонтБазис Тогда
						СтрОшибок = ТаблицаОшибок.Добавить();
						СтрОшибок.Наименование = НСтр("ru='Коэффициент к накладным расходам в случае смет на ремонт (базисный)'");
						СтрОшибок.Значение = Позиция.КоэффициентКНРНаРемонтБазисный;
						СтрОшибок.ЗначениеНорм = КоэффНРРемонтБазис;
					КонецЕсли;
					Если Позиция.КоэффициентКНРНаРемонтТекущий  <> КоэффНРРемонт Тогда
						СтрОшибок = ТаблицаОшибок.Добавить();
						СтрОшибок.Наименование = НСтр("ru='Коэффициент к накладным расходам в случае смет на ремонт (текущий)'");
						СтрОшибок.Значение = Позиция.КоэффициентКНРНаРемонтТекущий;
						СтрОшибок.ЗначениеНорм = КоэффНРРемонт;
					КонецЕсли;
				КонецЕсли;
				Если Норматив.ПрименитьКоэффициентСП = Истина Тогда
					Если Позиция.КоэффициентКСПНаРемонтБазисный  <> КоэффСПРемонтБазис Тогда
						СтрОшибок = ТаблицаОшибок.Добавить();
						СтрОшибок.Наименование = НСтр("ru='Коэффициент к сметной прибыли в случае смет на ремонт (базисный)'");
						СтрОшибок.Значение = Позиция.КоэффициентКСПНаРемонтБазисный;
						СтрОшибок.ЗначениеНорм = КоэффСПРемонтБазис;
					КонецЕсли;
					Если Позиция.КоэффициентКСПНаРемонтТекущий  <> КоэффСПРемонт Тогда 
						СтрОшибок = ТаблицаОшибок.Добавить();
						СтрОшибок.Наименование = НСтр("ru='Коэффициент к сметной прибыли в случае смет на ремонт (текущий)'");
						СтрОшибок.Значение = Позиция.КоэффициентКСПНаРемонтТекущий;
						СтрОшибок.ЗначениеНорм = КоэффСПРемонт;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли СтруктураПараметровЛС.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ТолькоНР И Норматив.ПрименитьКоэффициентНР = Истина Тогда
				Если Позиция.КоэффициентКНРНаРемонтБазисный <> КоэффНРРемонтБазис Тогда
					СтрОшибок = ТаблицаОшибок.Добавить();
					СтрОшибок.Наименование = НСтр("ru='Коэффициент к накладным расходам в случае смет на ремонт (базисный)'");
					СтрОшибок.Значение = Позиция.КоэффициентКНРНаРемонтБазисный;
					СтрОшибок.ЗначениеНорм = КоэффНРРемонтБазис;
				КонецЕсли;
				Если Позиция.КоэффициентКНРНаРемонтТекущий  <> КоэффНРРемонт Тогда
					СтрОшибок = ТаблицаОшибок.Добавить();
					СтрОшибок.Наименование = НСтр("ru='Коэффициент к накладным расходам в случае смет на ремонт (текущий)'");
					СтрОшибок.Значение = Позиция.КоэффициентКНРНаРемонтТекущий;
					СтрОшибок.ЗначениеНорм = КоэффНРРемонт;
				КонецЕсли;
			ИначеЕсли СтруктураПараметровЛС.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ТолькоСП И Норматив.ПрименитьКоэффициентСП = Истина Тогда
				Если Позиция.КоэффициентКСПНаРемонтБазисный  <> КоэффСПРемонтБазис Тогда
					СтрОшибок = ТаблицаОшибок.Добавить();
					СтрОшибок.Наименование = НСтр("ru='Коэффициент к сметной прибыли в случае смет на ремонт (базисный)'");
					СтрОшибок.Значение = Позиция.КоэффициентКСПНаРемонтБазисный;
					СтрОшибок.ЗначениеНорм = КоэффСПРемонтБазис;
				КонецЕсли;
				Если Позиция.КоэффициентКСПНаРемонтТекущий  <> КоэффСПРемонт Тогда 
					СтрОшибок = ТаблицаОшибок.Добавить();
					СтрОшибок.Наименование = НСтр("ru='Коэффициент к сметной прибыли в случае смет на ремонт (текущий)'");
					СтрОшибок.Значение = Позиция.КоэффициентКСПНаРемонтТекущий;
					СтрОшибок.ЗначениеНорм = КоэффСПРемонт;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		Если СтруктураПараметровЛС.УпрощеннаяСН Тогда
			Если Позиция.КоэффициентКНРУСНБазисный 	<> КоэффНРУСНБазис Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Коэффициент к накладным расходам в случае применения УСН (базисный)'");
				СтрОшибок.Значение = Позиция.КоэффициентКНРУСНБазисный;
				СтрОшибок.ЗначениеНорм = КоэффНРУСНБазис;
			КонецЕсли;
			Если Позиция.КоэффициентКНРУСНТекущий 	<> КоэффНРУСН Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Коэффициент к накладным расходам в случае применения УСН (текущий)'");
				СтрОшибок.Значение = Позиция.КоэффициентКНРУСНТекущий;
				СтрОшибок.ЗначениеНорм = КоэффНРУСН;
			КонецЕсли;
			Если Позиция.КоэффициентКСПУСНБазисный 	<> КоэффСПУСНБазис Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Коэффициент к сметной прибыли в случае применения УСН (базисный)'");
				СтрОшибок.Значение = Позиция.КоэффициентКСПУСНБазисный;
				СтрОшибок.ЗначениеНорм = КоэффСПУСНБазис;
			КонецЕсли;
			Если Позиция.КоэффициентКСПУСНТекущий 	<> КоэффСПУСН Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Коэффициент к сметной прибыли в случае применения УСН (текущий)'");
				СтрОшибок.Значение = Позиция.КоэффициентКСПУСНТекущий;
				СтрОшибок.ЗначениеНорм = КоэффСПУСН;
			КонецЕсли;
		КонецЕсли;
		
		Если СтруктураПараметровЛС.РеконструкцияАЭС Тогда 
			Если Позиция.КоэффициентКНРАЭСБазисный 	<> КоэффНРАЭСБазис Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Коэффициент к накладным расходам при реконструкции АЭС (базисный)'");
				СтрОшибок.Значение = Позиция.КоэффициентКНРАЭСБазисный;
				СтрОшибок.ЗначениеНорм = КоэффНРАЭСБазис;
			КонецЕсли;
			Если Позиция.КоэффициентКНРАЭСТекущий 	<> КоэффНРАЭС Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Коэффициент к накладным расходам при реконструкции АЭС (текущий)'");
				СтрОшибок.Значение = Позиция.КоэффициентКНРАЭСТекущий;
				СтрОшибок.ЗначениеНорм = КоэффНРАЭС;
			КонецЕсли;
			Если Позиция.КоэффициентКСПАЭСБазисный 	<> КоэффСПАЭСБазис Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Коэффициент к сметной прибыли при реконструкции АЭС (базисный)'");
				СтрОшибок.Значение = Позиция.КоэффициентКСПАЭСБазисный;
				СтрОшибок.ЗначениеНорм = КоэффСПАЭСБазис;
			КонецЕсли;
			Если Позиция.КоэффициентКСПАЭСТекущий 	<> КоэффСПАЭС Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Коэффициент к сметной прибыли при реконструкции АЭС (текущий)'");
				СтрОшибок.Значение = Позиция.КоэффициентКСПАЭСТекущий;
				СтрОшибок.ЗначениеНорм = КоэффСПАЭС;
			КонецЕсли;
		КонецЕсли;
		
		Если Норматив.ПрименятьПоправочныйКоэффициентКНР Тогда
			Если Позиция.ПоправочныйКоэффициентКНРБазисный 	<> Константы.СМ_ПоправочныйКоэффициентНРБазисный.Получить() Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Поправочный коэффициент к накладным расходам базисный'");
				СтрОшибок.Значение = Позиция.ПоправочныйКоэффициентКНРБазисный;
				СтрОшибок.ЗначениеНорм = Константы.СМ_ПоправочныйКоэффициентНРБазисный.Получить();
			КонецЕсли;
			Если Позиция.ПоправочныйКоэффициентКНРТекущий 	<> Константы.СМ_ПоправочныйКоэффициентНРТекущий.Получить() Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Поправочный коэффициент к накладным расходам текущий'");
				СтрОшибок.Значение = Позиция.ПоправочныйКоэффициентКНРТекущий;
				СтрОшибок.ЗначениеНорм = Константы.СМ_ПоправочныйКоэффициентНРТекущий.Получить();
			КонецЕсли;
		КонецЕсли;	
		
		Если Норматив.ПрименятьПоправочныйКоэффициентКСП Тогда
			Если Позиция.ПоправочныйКоэффициентКСПБазисный 	<> Константы.СМ_ПоправочныйКоэффициентСПБазисный.Получить() Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Поправочный коэффициент к сметной прибыли базисный'");
				СтрОшибок.Значение = Позиция.ПоправочныйКоэффициентКСПБазисный;
				СтрОшибок.ЗначениеНорм = Константы.СМ_ПоправочныйКоэффициентСПБазисный.Получить();
			КонецЕсли;
			Если Позиция.ПоправочныйКоэффициентКСПТекущий 	<> Константы.СМ_ПоправочныйКоэффициентСПТекущий.Получить() Тогда
				СтрОшибок = ТаблицаОшибок.Добавить();
				СтрОшибок.Наименование = НСтр("ru='Поправочный коэффициент к сметной прибыли текущий'");
				СтрОшибок.Значение = Позиция.ПоправочныйКоэффициентКСПТекущий;
				СтрОшибок.ЗначениеНорм = Константы.СМ_ПоправочныйКоэффициентСПТекущий.Получить();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТаблицаОшибок.Количество()>0 Тогда
		ЕстьОшибки = Истина;
	КонецЕсли;

	Возврат ТаблицаОшибок;
КонецФункции

Процедура ЗаполнитьРеквизитыИзСметы(Смета)
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СметаСсылка = Смета;
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Если Смета.ЛокальныеСметы.Количество()=0 Тогда
			Возврат;
		КонецЕсли;
		СметаСсылка = Смета.ЛокальныеСметы[0].ЛокальнаяСмета;
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Если Смета.Сметы.Количество()=0 Тогда
			Возврат;
		КонецЕсли;
		СметаСС = Смета.Сметы[0].Смета;
		Если ТипЗнч(СметаСС) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			СметаСсылка = СметаСС;
		ИначеЕсли ТипЗнч(СметаСС) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			Если СметаСС.ЛокальныеСметы.Количество()=0 Тогда
				Возврат;
			КонецЕсли;
			СметаСсылка = СметаСС.ЛокальныеСметы[0].ЛокальнаяСмета;
		КонецЕсли;
	КонецЕсли;
	
	Объект.РайонСтроительства = СметаСсылка.Район;
	Объект.ФайлСборникаКоэффициентовПредставление = СметаСсылка.ФайлСборникаКоэффициентовПредставление;
	Объект.ФайлСборникаКоэффициентов = СметаСсылка.ФайлСборникаКоэффициентов;
	Объект.КодРегионаФайлаИндексовПересчета = СметаСсылка.КодРегионаФайлаИндексовПересчета;

	Объект.ЭкспертизаИндексов = ЗначениеЗаполнено(Объект.ФайлСборникаКоэффициентовПредставление);
	Объект.ФайлСборникаТекущихЦенПредставление = СметаСсылка.ФайлСборникаТекущихЦенПредставление;
	Объект.ФайлСборникаТекущихЦен = СметаСсылка.ФайлСборникаТекущихЦен;
	Объект.КодРегионаФайлаТекущихЦен = СметаСсылка.КодРегионаФайлаТекущихЦен;

	Объект.ЭкспертизаЦен = ЗначениеЗаполнено(Объект.ФайлСборникаТекущихЦенПредставление);
	Объект.ДатаВыпускаИндексов = СметаСсылка.ДатаВыпускаИндексов;
	Объект.ДатаТекущихЦен = СметаСсылка.ДатаТекущихЦен;
	Если ЗначениеЗаполнено(СметаСсылка.Район) Тогда
		Объект.СНБ = ПолучитьСНБ(СметаСсылка.Район);
		Объект.ЭкспертизаСНБ = ЗначениеЗаполнено(Объект.СНБ);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСНБ(Район)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СМ_СметноНормативныеБазыРайоны.Ссылка
	|ИЗ
	|	Справочник.СМ_СметноНормативныеБазы.Районы КАК СМ_СметноНормативныеБазыРайоны
	|ГДЕ
	|	СМ_СметноНормативныеБазыРайоны.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И СМ_СметноНормативныеБазыРайоны.ТерриториальныйРайон = &ТерриториальныйРайон";
	Запрос.УстановитьПараметр("ТерриториальныйРайон",Район);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.СМ_СметноНормативныеБазы.ПустаяСсылка();
	КонецЕсли;
КонецФункции

Процедура СверитьРеcурсыПозицииЛСИзXML(ТаблицаРесурсовСНБ,Тег,Объект, ПараметрыСметы,ЕстьОшибки, ВерсияКомпоненты = 1)
	
	НоваяСтрокаТЧ = ТаблицаРесурсовСНБ.Добавить();
	Ресурс = ЗагрузитьРесурсИзXML(Тег,Объект.РегиональнаяБаза.ГодВыпуска,,,ВерсияКомпоненты);
	
	
	Тег.ПервыйАтрибут();
	Пока Тег.ПрочитатьАтрибут() Цикл
		Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
			Продолжить;
		КонецЕсли;
		ТегИмя = НРег(Тег.Имя);
		Если ТегИмя = "type" Тогда
			НоваяСтрокаТЧ.ТипМатериала = Перечисления.СМ_ТипыМатериалов[СтрЗаменить(СтрЗаменить(Тег.Значение, " ", ""),"ё","е")]; 	
		ИначеЕсли ТегИмя = "rate" Тогда
			НоваяСтрокаТЧ.НормаРасхода = Число(Тег.Значение); 	
		ИначеЕсли ТегИмя = "basis" Тогда
			НоваяСтрокаТЧ.БазиснаяЦена = Число(Тег.Значение); 	
		ИначеЕсли ТегИмя = "basis_zpm" Тогда
			НоваяСтрокаТЧ.БазиснаяЗарплатаМашинистов = Число(Тег.Значение); 	
		КонецЕсли;
	КонецЦикла;
	
	Если ТипЗнч(Ресурс.Ссылка) = Тип("СправочникСсылка.СМ_Ресурсы") Тогда
		НоваяСтрокаТЧ.СметныйКодРесурса = Ресурс.Код;
		НоваяСтрокаТЧ.Ресурс = Ресурс.Ссылка;
		НоваяСтрокаТЧ.ВидРесурса = Ресурс.ВидРесурса;
	КонецЕсли;
	
	Если ВерсияКомпоненты > 1 Тогда
		Пока Тег.Прочитать() Цикл
			Если (Тег.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда	
				Имя = НРег(Тег.Имя);
				Если Имя = "resourcebaseprice" Тогда   				
					Пока Тег.ПрочитатьАтрибут() Цикл
						Если Тег.Значение = " " ИЛИ Тег.Значение = "" Тогда
							Продолжить;
						КонецЕсли;
						ТегИмя = НРег(Тег.Имя);
						Если ТегИмя = "price" Тогда
							НоваяСтрокаТЧ.БазиснаяЦена = Число(Тег.Значение); 	
						ИначеЕсли (ТегИмя = "opt") И (НоваяСтрокаТЧ.Ресурс.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы) Тогда
							НоваяСтрокаТЧ.БазиснаяЗарплатаМашинистов = Число(Тег.Значение); 	
						КонецЕсли;
					КонецЦикла;              					
				КонецЕсли;				
			ИначеЕсли (НРег(Тег.Имя) = "resource")И(Тег.ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда	
				Прервать;			
			КонецЕсли
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция	ВыбратьПозицииСметы(Смета)
	Если ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_ПозицияЛокальнойСметы.Ссылка КАК Позиция
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
		               |ГДЕ
		               |	СМ_ПозицияЛокальнойСметы.ИДСметы = &ИДСметы
		               |	И СМ_ПозицияЛокальнойСметы.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("ИДСметы",Смета);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_ПозицияЛокальнойСметы.Ссылка КАК Позиция
		               |ИЗ
		               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
		               |		ПО СМ_ПозицияЛокальнойСметы.ИДСметы = СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета
		               |ГДЕ
		               |	СМ_ОбъектнаяСметаЛокальныеСметы.Расчет = ИСТИНА
		               |	И СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка = &Ссылка
		               |	И СМ_ПозицияЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
		               |	И СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("Ссылка",Смета);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
	ИначеЕсли ТипЗнч(Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		                |	СМ_ПозицияЛокальнойСметы.Ссылка КАК Позиция
		                |ИЗ
		                |	Документ.СМ_СводнаяСмета.Сметы КАК СМ_СводнаяСметаСметы
		                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
		                |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
		                |			ПО СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета = СМ_ПозицияЛокальнойСметы.ИДСметы
		                |		ПО СМ_СводнаяСметаСметы.Смета = СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка
		                |ГДЕ
		                |	СМ_СводнаяСметаСметы.Ссылка = &Ссылка
		                |	И СМ_ОбъектнаяСметаЛокальныеСметы.Расчет = ИСТИНА
		                |	И СМ_ПозицияЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
		                |	И СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета.ПометкаУдаления = ЛОЖЬ
		                |	И СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка.ПометкаУдаления = ЛОЖЬ
		                |
		                |ОБЪЕДИНИТЬ ВСЕ
		                |
		                |ВЫБРАТЬ
		                |	СМ_ПозицияЛокальнойСметы.Ссылка
		                |ИЗ
		                |	Документ.СМ_СводнаяСмета.Сметы КАК СМ_СводнаяСметаСметы
		                |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
		                |		ПО СМ_СводнаяСметаСметы.Смета = СМ_ПозицияЛокальнойСметы.ИДСметы
		                |ГДЕ
		                |	СМ_СводнаяСметаСметы.Ссылка = &Ссылка
		                |	И СМ_ПозицияЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
		                |	И СМ_СводнаяСметаСметы.Смета.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("Ссылка",Смета);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли;
	
	СписокПозиций = Новый СписокЗначений;
	СписокПозиций.ЗагрузитьЗначения(РезультатЗапроса.ВыгрузитьКолонку("Позиция"));
	Возврат(СписокПозиций);
КонецФункции

