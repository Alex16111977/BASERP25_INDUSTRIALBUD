Процедура ВывестиОбластьПозиции(ТабДок,Макет,ОбластьСтрок,ОбъектСсылка,ОшибкаРесурс,ОшибкаРабот,ОшибкиЦен,ОшибкаПозици,ОшибкаИнд)
	ОбластьСтроки = ОбластьСтрок.ОбластьКартинки;
	Если Объект.ДляПечати Тогда
		ОбластьСтроки.Параметры.КартинкаН = "";
		ОбластьСтроки.Параметры.КартинкаЦ = "";
		ОбластьСтроки.Параметры.КартинкаР = "";
		ОбластьСтроки.Параметры.КартинкаС = "";
		Если ОшибкаПозици Тогда
			ОбластьСтроки.Параметры.КартинкаН = "Н";
	    КонецЕсли;
		Если ОшибкиЦен Тогда
			ОбластьСтроки.Параметры.КартинкаЦ = "Ц";
		КонецЕсли;
		Если ОшибкаРесурс Тогда
			ОбластьСтроки.Параметры.КартинкаР = "Р";
		КонецЕсли;
		Если ОшибкаРабот Тогда
			ОбластьСтроки.Параметры.КартинкаС = "С";
		КонецЕсли;
	Иначе
		Если ОшибкаПозици Тогда
			ОбластьСтроки.Область("R1C2").ЦветФона = Новый Цвет(255,0,0);
		Иначе
			ОбластьСтроки.Область("R1C2").ЦветФона = Новый Цвет(0,255,0);
		КонецЕсли;
		Если ОшибкиЦен Тогда
			ОбластьСтроки.Область("R1C4").ЦветФона = Новый Цвет(255,0,0);
		Иначе
			ОбластьСтроки.Область("R1C4").ЦветФона = Новый Цвет(0,255,0);
		КонецЕсли;
		Если ОшибкаРесурс Тогда
			ОбластьСтроки.Область("R1C6").ЦветФона = Новый Цвет(255,0,0);
		ИначеЕсли Не Объект.СверятьРесурсы Тогда
			ОбластьСтроки.Область("R1C6").ЦветФона = Новый Цвет(192,192,192);
		Иначе
			ОбластьСтроки.Область("R1C6").ЦветФона = Новый Цвет(0,255,0);
		КонецЕсли;
		Если ОшибкаРабот Тогда
			ОбластьСтроки.Область("R1C8").ЦветФона = Новый Цвет(255,0,0);
		ИначеЕсли Не Объект.СверятьРаботы Тогда
			ОбластьСтроки.Область("R1C8").ЦветФона = Новый Цвет(192,192,192);
		Иначе
			ОбластьСтроки.Область("R1C8").ЦветФона = Новый Цвет(0,255,0);
		КонецЕсли;
	КонецЕсли;
	ТабДок.Вывести(ОбластьСтроки);
	
	ОбластьСтроки = ОбластьСтрок.ОбластьПозиции;
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ОбъектСсылка, "СМ_ПозицияЛокальнойСметы");
	ОбластьСтроки.Параметры.Номер = Номера.ПорНомер;
	ОбластьСтроки.Параметры.Шифр = ОбъектСсылка.ШифрРасценки;
	ОбластьСтроки.Параметры.Наименование = ОбъектСсылка.Наименование;
	ОбластьСтроки.Параметры.Единица = ОбъектСсылка.ЕдиницаИзмерения;
	ОбластьСтроки.Параметры.Всего = ОбъектСсылка.ПрямЗатраты;
	ОбластьСтроки.Параметры.ОЗ = ОбъектСсылка.ОснЗарплата;
	ОбластьСтроки.Параметры.ЭМ = ОбъектСсылка.ЭксплМашин;
	ОбластьСтроки.Параметры.ЗМ = ОбъектСсылка.ЗарплМашинистов;
	ОбластьСтроки.Параметры.МАТ = ОбъектСсылка.СтоимМатериалов;
	ОбластьСтроки.Параметры.ЗТМ = ОбъектСсылка.ЗатратыТрудаМашинистов;
	ОбластьСтроки.Параметры.ЗТР = ОбъектСсылка.ЗатратыТрудаРабочих;
	ТабДок.Присоединить(ОбластьСтроки);
КонецПроцедуры

Процедура ВывестиОбластьПозицииНетВБазе(ТабДок,Макет,ОбластьСтрок,ОбъектСсылка,Раздел)
	РазделПозиции = ВернутьРаздел(ОбъектСсылка);
	Если Раздел = Неопределено Тогда
		Раздел = РазделПозиции;
		ВывестиОбластьРаздел(ТабДок,Макет,ОбластьСтрок.ОбластьСметы,РазделПозиции);
	ИначеЕсли Раздел<>РазделПозиции Тогда
		Раздел = РазделПозиции;
		ВывестиОбластьРаздел(ТабДок,Макет,ОбластьСтрок.ОбластьСметы,РазделПозиции);
	КонецЕсли;

	ОбластьСтроки = ОбластьСтрок.ОбластьПозиции;;
	ОбластьСтроки.Параметры.НетВБазе = НСтр("ru='Нет в базе'");
	
	ОбластьСтроки = ОбластьСтрок.ОбластьПозиции;
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ОбъектСсылка, "СМ_ПозицияЛокальнойСметы");
	ОбластьСтроки.Параметры.Номер = Номера.ПорНомер;
	ОбластьСтроки.Параметры.Шифр = ОбъектСсылка.ШифрРасценки;
	ОбластьСтроки.Параметры.Наименование = ОбъектСсылка.Наименование;
	ОбластьСтроки.Параметры.Единица = ОбъектСсылка.ЕдиницаИзмерения;
	ОбластьСтроки.Параметры.Всего = ОбъектСсылка.ПрямЗатраты;
	ОбластьСтроки.Параметры.ОЗ = ОбъектСсылка.ОснЗарплата;
	ОбластьСтроки.Параметры.ЭМ = ОбъектСсылка.ЭксплМашин;
	ОбластьСтроки.Параметры.ЗМ = ОбъектСсылка.ЗарплМашинистов;
	ОбластьСтроки.Параметры.МАТ = ОбъектСсылка.СтоимМатериалов;
	ОбластьСтроки.Параметры.ЗТМ = ОбъектСсылка.ЗатратыТрудаМашинистов;
	ОбластьСтроки.Параметры.ЗТР = ОбъектСсылка.ЗатратыТрудаРабочих;
	ТабДок.Присоединить(ОбластьСтроки);
	ВывестиОбластьПодвал(ТабДок,Макет);	
КонецПроцедуры


Процедура ВывестиОбластьСметы(ТабДок,Макет,ОбластьСтроки,ОбъектСсылка)
	ОбластьСтроки.Параметры.Данные = ПредставлениеОбъекта(ОбъектСсылка);
