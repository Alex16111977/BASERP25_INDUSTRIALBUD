&НаСервере
Функция СоздатьСмету()
	ТабДок = ШаблонСДанными;
	
	ЛокальнаяСмета = Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
	ЛокальнаяСмета.Дата = ТекущаяДатаСеанса();
	ЛокальнаяСмета.Автор = Пользователи.ТекущийПользователь();
	СМ_СметаВызовСервера.ЗаполнитьНастройкиПользователяПоУмолчанию(ЛокальнаяСмета);
	ЛокальнаяСмета.Валюта = Справочники.Валюты.НайтиПоКоду("643");
	
	Для Каждого стр Из СоответствияСмета Цикл
		Если Не стр.Обрабатывать ИЛИ Не ЗначениеЗаполнено(стр.ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		ТекстЯчейки = СокрЛП(ТабДок.область(стр.НомСтроки, стр.НомерКолонки, стр.НомСтроки, стр.НомерКолонки).Текст);
		
		Если Найти(стр.ИмяРеквизита,"Заказчик")>0 Тогда
			ЗначениеРеквизита 	= ПолучитьСоздатьКонтрагента(ТекстЯчейки,1);
		ИначеЕсли Найти(стр.ИмяРеквизита,"Подрядчик")>0 Тогда
			ЗначениеРеквизита 	= ПолучитьСоздатьКонтрагента(ТекстЯчейки,2);
		ИначеЕсли Найти(стр.ИмяРеквизита,"Основание")>0 Тогда
			ЗначениеРеквизита 	= ТекстЯчейки;
		ИначеЕсли Найти(стр.ИмяРеквизита,"Договор")>0 Тогда
			Если ЗначениеЗаполнено(ЛокальнаяСмета.Заказчик) Тогда
				ЗначениеРеквизита = ПолучитьСоздатьДоговор(ЛокальнаяСмета.Заказчик, ТекстЯчейки);	
			КонецЕсли;
		ИначеЕсли Найти(стр.ИмяРеквизита,"Наименование")>0 Тогда
			Часть1 = ТекстЯчейки;
			Часть2 = СокрЛП(ТабДок.область(стр.НомСтроки+1, стр.НомерКолонки, стр.НомСтроки+1, стр.НомерКолонки).Текст);
			ТекстНаименование = ТекстЯчейки + ?(ЗначениеЗаполнено(Часть2)," "+Часть2,"");
			ЗначениеРеквизита 	= ТекстНаименование;
		Иначе
			ЗначениеРеквизита 	= ТекстЯчейки;
		КонецЕсли;
		
		ЛокальнаяСмета[стр.ИмяРеквизита] = ЗначениеРеквизита;
	КонецЦикла;
	НомерСметы = "";
	НомерПозиция = Найти(ЛокальнаяСмета.Наименование,"№");
	Если НомерПозиция>0 Тогда
		СтрокаПоиска = СокрЛП(Сред(ЛокальнаяСмета.Наименование,НомерПозиция+1));
		НайтиПробел = Найти(СтрокаПоиска," ");
		НомерСметы = Сред(СтрокаПоиска,1,НайтиПробел-1);
	КонецЕсли;
	ЛокальнаяСмета.НомерСметы = НомерСметы;
	ЛокальнаяСмета.Организация = Организация;
	ЛокальнаяСмета.Район = Район;
	ЛокальнаяСмета.Стройка = ТекСтройка;
	ЛокальнаяСмета.Записать();
	Возврат ЛокальнаяСмета.Ссылка;
КонецФункции

Функция ПолучитьСоздатьКонтрагента(НаименованиеКонтрагента,ТипКонтрагента);
	
	НаименованиеКонтрагента = СокрЛП(НаименованиеКонтрагента);
	Если НЕ ЗначениеЗаполнено(НаименованиеКонтрагента) Тогда
		Если ТипКонтрагента = 1 Тогда
			НаименованиеКонтрагента	= НСтр("ru='Основной заказчик'");			
		ИначеЕсли ТипКонтрагента = 2 Тогда
			НаименованиеКонтрагента	= НСтр("ru='Основной подрядчик'");
		КонецЕсли;
	КонецЕсли;
	
	ТекКонтрагент = Справочники.Контрагенты.НайтиПоНаименованию(НаименованиеКонтрагента,Истина);
	Если ТекКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		Если СоздаватьНовыеЭлементы Тогда
			НовыйОбъект 				= Справочники.Контрагенты.СоздатьЭлемент();
			НовыйОбъект.Наименование 	= НаименованиеКонтрагента;
			НовыйОбъект.Записать();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый контрагент: %1, %2'"), НовыйОбъект.Код, НовыйОбъект.Наименование));
			Возврат НовыйОбъект.Ссылка;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден контрагент: %1'"), НаименованиеКонтрагента));
		КонецЕсли;
	Иначе
		Возврат ТекКонтрагент;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСоздатьДоговор(Контрагент,НаименованиеДоговора);
	
	НаименованиеДоговора = СокрЛП(НаименованиеДоговора);
	Если НЕ ЗначениеЗаполнено(НаименованиеДоговора) Тогда
		НаименованиеДоговора = НСтр("ru='Основной договор'");			
	КонецЕсли;
	
	ТекДоговор = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(НаименованиеДоговора,Истина,Контрагент);
	Если ТекДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда
		Если СоздаватьНовыеЭлементы Тогда
			НовыйОбъект 				= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			НовыйОбъект.Наименование 	= НаименованиеДоговора;
			НовыйОбъект.Контрагент		= Контрагент;
			НовыйОбъект.Записать();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый договор: %1, %2'"), НовыйОбъект.Код, НовыйОбъект.Наименование));
			Возврат НовыйОбъект.Ссылка;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден договор: %1'"), НаименованиеДоговора));
		КонецЕсли;
	Иначе
		Возврат ТекДоговор;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура СоответствияПозицииОбрабатыватьПриИзменении(Элемент)
	Если Элементы.СоответствияПозиции.ТекущиеДанные.Обрабатывать Тогда
		Смещение = 1;
	Иначе
		Смещение = -1;
	КонецЕсли;
	СместитьКолонкиКлиент(Смещение,Элементы.СоответствияПозиции.ТекущиеДанные.НомерКолонки,Элементы.СоответствияПозиции.ТекущиеДанные.НазваниеКолонки,Элементы.СоответствияПозиции.ТекущиеДанные.Смещение);
КонецПроцедуры

&НаКлиенте
Процедура СместитьКолонкиКлиент(Смещение,НомерКолонки,ПропускаемаяСтрока,СравнениеСмещения)
	 Отбор = Новый Структура("НомерКолонки,Обрабатывать",НомерКолонки,Истина);
	 МассивСтрок = СоответствияПозиции.НайтиСтроки(Отбор);
	 Для Каждого Строка Из МассивСтрок Цикл
		 Если Строка.НазваниеКолонки = ПропускаемаяСтрока ИЛИ Число(СравнениеСмещения) > Число(Строка.Смещение) Тогда
			 Продолжить;
		КонецЕсли;
		 Строка.Смещение = Строка(Число(Строка.Смещение)+Смещение);
	 КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ФормаСметы = 1;
	Если СметнаяКомпонента = Неопределено Тогда
		Элементы.ОбновлятьПоНормативнойБазе.Видимость = Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.ИмяФайла) Тогда
		АдресВременногоХранилища = "";
		Оповещение = Новый ОписаниеОповещения("ПриОкончаниеПомещенияФайла", ЭтотОбъект);
		НачатьПомещениеФайла(Оповещение, АдресВременногоХранилища, Параметры.ИмяФайла, Ложь);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
