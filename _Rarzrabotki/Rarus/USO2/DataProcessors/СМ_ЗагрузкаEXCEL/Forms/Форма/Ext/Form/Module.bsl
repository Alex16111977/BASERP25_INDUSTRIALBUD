&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	Элементы.СтраницаРезультат.Видимость = Ложь;
	Элементы.Страница_Smeta_ru.Видимость = Ложь;
	ЗаполнитьНастройкиПользователяПоУмолчанию(ЭтаФорма);
	ЗаполнитьМетаданныеХранилище();
КонецПроцедуры

Процедура ЗаполнитьМетаданныеХранилище()
	ТабСмета = Новый СписокЗначений;
	Для Каждого Реквизит Из Метаданные.Документы.СМ_ЛокальнаяСмета.Реквизиты Цикл
		  Элементы.СоответствияСметаИмяРеквизита.СписокВыбора.Добавить(Реквизит.Имя,Реквизит.Представление());
		  ТабСмета.Добавить(Реквизит.Имя,Реквизит.Представление());
	КонецЦикла;

	ТабПоз = Новый СписокЗначений;
	Для Каждого Реквизит Из Метаданные.Документы.СМ_ПозицияЛокальнойСметы.Реквизиты Цикл
		Элементы.СоответствияПозицииИмяРеквизита.СписокВыбора.Добавить(Реквизит.Имя,Реквизит.Представление());
		ТабПоз.Добавить(Реквизит.Имя,Реквизит.Представление());
	КонецЦикла;
    Структура = Новый Структура("ЛокальнаяСмета,Позиция",ТабСмета,ТабПоз);
	АдресХранилищаМетаданных = ПоместитьВоВременноеХранилище(Структура, ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

