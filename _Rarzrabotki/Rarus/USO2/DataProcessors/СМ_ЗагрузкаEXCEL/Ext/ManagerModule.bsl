
#Область Загрузка

Процедура ЗагрузитьФайлВТаблицу(ПараметрыВызоваСервера, АдресХранилища) Экспорт
	
	Расширение = ПараметрыВызоваСервера.Расширение;
	ШаблонСДанными = ПараметрыВызоваСервера.ШаблонСДанными;
	ИмяВременногоФайла = ПараметрыВызоваСервера.ИмяВременногоФайла;
	
	Если Расширение = "xlsx" Тогда 
		ЗагрузитьФайлExcel2007ВТаблицу(ИмяВременногоФайла, ШаблонСДанными);
	ИначеЕсли Расширение = "csv" Тогда 
		ЗагрузитьCSVФайлВТаблицу(ИмяВременногоФайла, ШаблонСДанными);
	ИначеЕсли Расширение = "xls" Тогда
		ЗагрузитьXLSФайл(ИмяВременногоФайла, ШаблонСДанными);
	Иначе
		ШаблонСДанными.Прочитать(ИмяВременногоФайла);
	КонецЕсли;
	
	СоответствияРеквизитов = ПолучитьСоответствия(ШаблонСДанными);
	Структура = Новый Структура("ШаблонСДанными,СоответствияРеквизитов",ШаблонСДанными,СоответствияРеквизитов);
	АдресХранилища = ПоместитьВоВременноеХранилище(Структура, АдресХранилища);
	
КонецПроцедуры

Функция ПолучитьСоответствия(ШаблонСДанными)
	Соответствия = Новый Соответствие;
	Строки = ШаблонСДанными.ВысотаТаблицы;
	Колонки = ШаблонСДанными.ШиринаТаблицы;
	Для стр = 1 По Строки Цикл
		
		ТекстЯчейки = ШаблонСДанными.область(стр, 1, стр, 1).Текст;
		Если Найти(Врег(ТекстЯчейки),"СОСТАВЛЕНА")>0 Тогда // обрабатываем шапку.
			Структура = Новый Структура;
			Структура.Вставить("НачалоШапки",стр + 1);
			
			НачСтр = стр+1; 
			Для кол = 1 По Колонки Цикл
				смещ = 0;
				Для стр = НачСтр По Строки Цикл
					Смещать = Ложь;
					ТекстЯчейки = ШаблонСДанными.область(стр, кол, стр, кол).Текст;
					Если ЗначениеЗаполнено(ТекстЯчейки) Тогда
						Если Обработки.СМ_ЗагрузкаEXCEL.СтрокуВЧисло(ТекстЯчейки)>0 Тогда
							КонецШапки = стр;
							Прервать;
						КонецЕсли;
						Смещать = Истина;
						Координаты = Новый Структура("Колонка,Смещение,ИмяКолонки",кол,смещ,ТекстЯчейки);
						Если Найти(Врег(СтрЗаменить(ТекстЯчейки," ","")),"П/П")>0 Тогда
							Ключ = "НомерВПределахСметы";
						ИначеЕсли Найти(Врег(ТекстЯчейки),"ШИФР")>0
							ИЛИ Найти(Врег(ТекстЯчейки),"ОБОСНОВАНИЕ")>0 Тогда
							Ключ = "ШифрРасценки";
						ИначеЕсли Найти(Врег(СтрЗаменить(ТекстЯчейки," ","")),"НАИМЕНОВАНИЕРАБОТ")>0 Тогда
							Ключ = "Наименование";
						ИначеЕсли Найти(Врег(СтрЗаменить(ТекстЯчейки," ","")),"ЕДИНИЦАИЗМЕРЕНИЯ")>0
							ИЛИ Найти(ТекстЯчейки,"ед. изм.")>0 Тогда
							Ключ = "ЕдиницаИзмерения";	
						ИначеЕсли Найти(Врег(СтрЗаменить(ТекстЯчейки," ","")),"КОЛИЧЕСТВО")>0
							ИЛИ Найти(ТекстЯчейки,"Кол-во")>0 Тогда
							Ключ = "ОбъемРабот";	
						Иначе
							Ключ = "Неизвестно_"+Строка(стр)+"_"+Строка(кол);
						КонецЕсли;
						Структура.Вставить(Ключ,Координаты);
					КонецЕсли;
					Если Смещать Тогда
						смещ = смещ+1;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Структура.Вставить("КонецШапки",КонецШапки);
			Соответствия.Вставить("Шапка",Структура);
			Прервать;
		КонецЕсли;
		
		Для кол = 1 По Колонки Цикл
			ТекстЯчейки = ШаблонСДанными.область(стр, кол, стр, кол).Текст;
			Если Найти(Врег(ТекстЯчейки),"ЗАКАЗЧИК")>0
				И Соответствия.Получить("Заказчик") = Неопределено Тогда
				Структура = Новый Структура("Строка,Колонка,ИмяКолонки",стр,кол+1,ТекстЯчейки);
				Соответствия.Вставить("Заказчик",Структура);
                Прервать;
			ИначеЕсли Найти(Врег(ТекстЯчейки),"ПОДРЯДЧИК")>0 
				И Соответствия.Получить("Подрядчик") = Неопределено Тогда
				Структура = Новый Структура("Строка,Колонка,ИмяКолонки",стр,кол+1,ТекстЯчейки);
				Соответствия.Вставить("Подрядчик",Структура);
				Прервать;
			ИначеЕсли Найти(Врег(ТекстЯчейки),"ДОГОВОР")>0 
				И Соответствия.Получить("Договор") = Неопределено Тогда
				Структура = Новый Структура("Строка,Колонка,ИмяКолонки",стр,кол+1,ТекстЯчейки);
				Соответствия.Вставить("Договор",Структура);
				Прервать;
			ИначеЕсли Найти(Врег(ТекстЯчейки),"СМЕТА")>0 Тогда
				Структура = Новый Структура("Строка,Колонка,ИмяКолонки",стр,кол,ТекстЯчейки);
				Соответствия.Вставить("Наименование",Структура);
				Прервать;
			ИначеЕсли Найти(Врег(ТекстЯчейки),"ОСНОВАНИЕ")>0 
				И Соответствия.Получить("Основание") = Неопределено Тогда
				Структура = Новый Структура("Строка,Колонка,ИмяКолонки",стр,кол+1,ТекстЯчейки);
				Соответствия.Вставить("Основание",Структура);
				Прервать;
			КонецЕсли;
		КонецЦикла
	КонецЦикла;
	
	Если Не Соответствия.Получить("Шапка") = Неопределено Тогда
		Если Не Соответствия.Получить("Шапка").Свойство("ШифрРасценки") Тогда
			Координаты = Новый Структура("Колонка,Смещение,ИмяКолонки",0,0,"Не найдено");
			Соответствия.Получить("Шапка").Вставить("ШифрРасценки",Координаты)
		КонецЕсли;
		Если Не Соответствия.Получить("Шапка").Свойство("Наименование") Тогда
			Координаты = Новый Структура("Колонка,Смещение,ИмяКолонки",0,0,"Не найдено");
			Соответствия.Получить("Шапка").Вставить("Наименование",Координаты)
		КонецЕсли;
		Если Не Соответствия.Получить("Шапка").Свойство("ЕдиницаИзмерения") Тогда
			Координаты = Новый Структура("Колонка,Смещение,ИмяКолонки",0,0,"Не найдено");
			Соответствия.Получить("Шапка").Вставить("ЕдиницаИзмерения",Координаты)
		КонецЕсли;
		Если Не Соответствия.Получить("Шапка").Свойство("ОбъемРабот") Тогда
			Координаты = Новый Структура("Колонка,Смещение,ИмяКолонки",0,0,"Не найдено");
			Соответствия.Получить("Шапка").Вставить("ОбъемРабот",Координаты)
		КонецЕсли;
	КонецЕсли;
	Возврат Соответствия;
КонецФункции

Процедура ЗагрузитьФайлВТаблицуПоВиду(ПараметрыВызоваСервера, АдресХранилища) Экспорт

	ВидЗагрузки = ПараметрыВызоваСервера.ВидЗагрузки;
	
	Если ВидЗагрузки = Справочники.СМ_СметныеПрограммы.СметаРу Тогда
		Если Не ПараметрыВызоваСервера.ДанныеЗаполнения.СтруктураПозиций = Неопределено Тогда
			ЗагрузитьФайлВТаблицуSmeta_ru_Доп(ПараметрыВызоваСервера, АдресХранилища);
		Иначе
			ЗагрузитьФайлВТаблицуSmeta_ru(ПараметрыВызоваСервера, АдресХранилища);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьФайлВТаблицуSmeta_ru(ПараметрыВызоваСервера, АдресХранилища) Экспорт
	ТекстОшибки = "";
	ДанныеЗаполнения = ПараметрыВызоваСервера.ДанныеЗаполнения;
	ОбработатьЛимЗатраты = ДанныеЗаполнения.ОбработатьЛимЗатраты;
	ИмяВременногоФайла = ПараметрыВызоваСервера.ИмяВременногоФайла;
	Попытка
		КнигаЭксель = ПолучитьCOMОбъект(ИмяВременногоФайла);
	Исключение
		ТекстОшибки = НСтр("ru='Ошибка. Невозможно открыть лист книги Excel.'");
	КонецПопытки;

	ТаблицаРезультата = Неопределено;
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
		ЧислоКолонок = КнигаЭксель.Sheets.Count;
		// лист позиций
		ЛистЭксель = КнигаЭксель.Sheets.Item(ЧислоКолонок-3);
		RowCount = ЛистЭксель.UsedRange.Rows.Count; // Кол-во строк
		ColumnCount = ЛистЭксель.UsedRange.Columns.Count; // Кол-во колонок
		ДиапазонДанных = ЛистЭксель.Range(ЛистЭксель.Cells(12, 1), ЛистЭксель.Cells(RowCount, ColumnCount));
		Данные = ДиапазонДанных.Value.Выгрузить();
		
		ТЗПозиции = ВернутьТЗ(Данные, RowCount, ColumnCount);
		ДанныеДокументов = ОбработатьДокументы(ТЗПозиции,ДанныеЗаполнения);
		

		// лист ресурсов
		ЛистЭксель = КнигаЭксель.Sheets.Item(ЧислоКолонок-1);
		RowCount = ЛистЭксель.UsedRange.Rows.Count; // Кол-во строк
		ColumnCount = ЛистЭксель.UsedRange.Columns.Count; // Кол-во колонок
		ДиапазонДанных = ЛистЭксель.Range(ЛистЭксель.Cells(1, 1), ЛистЭксель.Cells(RowCount, ColumnCount));
		Данные = ДиапазонДанных.Value.Выгрузить();
		
		ТЗРесурсы = ВернутьТЗ(Данные, RowCount, ColumnCount);
		ДанныеРесурсов = ОбработатьРесурсы(ТЗРесурсы);
		
		ДанныеЛимЗатрат = Неопределено;
		Если ОбработатьЛимЗатраты Тогда
			// лист лимитированных затрат
			ЛистЭксель = КнигаЭксель.Sheets.Item(ЧислоКолонок-2);
			RowCount = ЛистЭксель.UsedRange.Rows.Count; // Кол-во строк
			ColumnCount = ЛистЭксель.UsedRange.Columns.Count; // Кол-во колонок
			ДиапазонДанных = ЛистЭксель.Range(ЛистЭксель.Cells(12, 1), ЛистЭксель.Cells(RowCount, ColumnCount));
			Данные = ДиапазонДанных.Value.Выгрузить();
			
			ТЗЛимЗатраты = ВернутьТЗ(Данные, RowCount, ColumnCount);
			ДанныеЛимЗатрат = ОбработатьЛимЗатраты(ТЗЛимЗатраты)
		КонецЕсли;
		
		ТаблицаРезультата = СформироватьДокументы(ДанныеЗаполнения,ДанныеДокументов,ДанныеРесурсов,ДанныеЛимЗатрат);
	КонецЕсли;
	
	АдресХранилища = ПоместитьВоВременноеХранилище(ТаблицаРезультата, АдресХранилища);

КонецПроцедуры

Процедура ЗагрузитьФайлВТаблицуSmeta_ru_Доп(ПараметрыВызоваСервера, АдресХранилища) Экспорт
	ДанныеЗаполнения = ПараметрыВызоваСервера.ДанныеЗаполнения;
	ОбработатьЛимЗатраты = ДанныеЗаполнения.ОбработатьЛимЗатраты;
	
	СтруктураПозиций = ДанныеЗаполнения.СтруктураПозиций;
	СтруктураРесурсов = ДанныеЗаполнения.СтруктураРесурсов;
	СтруктураЛимЗатрат = ДанныеЗаполнения.СтруктураЛимЗатрат;
	
	ТаблицаРезультата = Неопределено;
	
	ТЗПозиции = ВернутьТЗ(СтруктураПозиций.МассивПозиций, СтруктураПозиций.RowCount, СтруктураПозиций.ColumnCount);
	ДанныеДокументов = ОбработатьДокументы(ТЗПозиции,ДанныеЗаполнения);
	
	ТЗРесурсы = ВернутьТЗ(СтруктураРесурсов.МассивРесурсов, СтруктураРесурсов.RowCount, СтруктураРесурсов.ColumnCount);
	ДанныеРесурсов = ОбработатьРесурсы(ТЗРесурсы);
	
	ДанныеЛимЗатрат = Неопределено;
	Если ОбработатьЛимЗатраты Тогда
		ТЗЛимЗатраты = ВернутьТЗ(СтруктураЛимЗатрат.МассивЛимЗатрат, СтруктураЛимЗатрат.RowCount, СтруктураЛимЗатрат.ColumnCount);
		ДанныеЛимЗатрат = ОбработатьЛимЗатраты(ТЗЛимЗатраты)
	КонецЕсли;
	
	ТаблицаРезультата = СформироватьДокументы(ДанныеЗаполнения,ДанныеДокументов,ДанныеРесурсов,ДанныеЛимЗатрат);
	
	АдресХранилища = ПоместитьВоВременноеХранилище(ТаблицаРезультата, АдресХранилища);

КонецПроцедуры

Функция СформироватьДокументы(ДанныеЗаполнения,ДанныеДокументов,ДанныеРесурсов,ДанныеЛимЗатрат)
	
	ТаблицаРезультата = Новый ТаблицаЗначений;
	ТаблицаРезультата.Колонки.Добавить("ТекстСообщения");
	ТаблицаРезультата.Колонки.Добавить("Ссылка");

	НачатьТранзакцию();
	
	Для Каждого Док Из ДанныеДокументов.ТабДокументов Цикл
		СтрокаФильтра = ДанныеЗаполнения.ТаблицаСмет.Найти(Док.ИДНомерСметы);
		Если Не СтрокаФильтра.Пометка Тогда
			Продолжить;
		КонецЕсли;
		СоздатьДокументЛС(Док,ДанныеЗаполнения,ТаблицаРезультата);
	КонецЦикла;
	
	Для Каждого Раздел Из ДанныеДокументов.ТабРазделов Цикл
		СтрокаСмета = ДанныеДокументов.ТабДокументов.Найти(Раздел.НомерСметы,"ИДНомерСметы");
		Если Не ЗначениеЗаполнено(СтрокаСмета.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		СоздатьДокументРаздел(СтрокаСмета.Ссылка,Раздел);
	КонецЦикла;

	Для Каждого Позиция Из ДанныеДокументов.ТабПозиций Цикл
		СтрокаСмета = ДанныеДокументов.ТабДокументов.Найти(Позиция.НомерСметы,"ИДНомерСметы");
		Если Не ЗначениеЗаполнено(СтрокаСмета.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		ПозицияВладелец = Неопределено;
		Если Позиция.Привязана Тогда
			СтрокаВладельца = ДанныеДокументов.ТабПозиций.Найти(Позиция.ИДВладельца,"НомерСтроки");
			ПозицияВладелец = СтрокаВладельца.Ссылка;
		КонецЕсли;
		
		СтрокаРаздел = ДанныеДокументов.ТабРазделов.НайтиСтроки(Новый Структура("НомерСметы,НомерРаздела",Позиция.НомерСметы,Позиция.НомерРаздела));
		Если ПустаяСтрока(Позиция.НомерРаздела) И СтрокаРаздел.Количество()=0 Тогда
			СоздатьДокументРаздел(СтрокаСмета.Ссылка,,ДанныеДокументов.ТабРазделов,Раздел);
		Иначе
			Раздел = СтрокаРаздел[0].Ссылка;
		КонецЕсли;
		СоздатьДокументПозицияЛС(СтрокаСмета.Ссылка,Позиция,ДанныеЗаполнения,Раздел,ПозицияВладелец);
		
		МассивРесурсов = ДанныеРесурсов.ТабРесурсов.НайтиСтроки(Новый Структура("НомерСтроки",Позиция.НомерСтроки));
		Если МассивРесурсов.Количество() > 0 Тогда
			ЗаполнитьРесурсыПозиции(Позиция.Ссылка,МассивРесурсов,ДанныеЗаполнения);
		КонецЕсли;
		
	КонецЦикла;
	
	
	ЗафиксироватьТранзакцию();
	
	Для Каждого Док Из ДанныеДокументов.ТабДокументов Цикл
		СтрокаФильтра = ДанныеЗаполнения.ТаблицаСмет.Найти(Док.ИДНомерСметы);
		Если Не СтрокаФильтра.Пометка Тогда
			Продолжить;
		КонецЕсли;

		ТекущаяСмета = Док.Ссылка;
		Попытка
			СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(ТекущаяСмета);
			Документы.СМ_ЛокальнаяСмета.Перерасчет(ТекущаяСмета,Ложь);
		Исключение
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате EXCEL'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), ТекущаяСмета.Номер, ТекущаяСмета.Дата, ТекущаяСмета.Наименование));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрацииВызовСервера.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		КонецПопытки;
	КонецЦикла;

	Возврат ТаблицаРезультата; 
КонецФункции

Процедура ЗаполнитьРесурсыПозиции(ТекущаяПозицияЛС,МассивРесурсов,ДанныеЗаполнения)
	
	ТекОбъект = ТекущаяПозицияЛС.ПолучитьОбъект();
	
	Для Каждого ТекСтрока Из МассивРесурсов Цикл
		ТекРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду(ТекСтрока.КодРесурса);	
		
		Каталог = Справочники.СМ_Ресурсы[ДанныеЗаполнения.СметноНормативнаяБаза.ГруппаРесурсов.ИмяПредопределенныхДанных];
		Если ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
			МассивРодителей = Новый СписокЗначений;
			СМ_СметаЗагрузкаВызовСервера.ПолучитьВсехРодителей(Каталог,МассивРодителей);
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	Ресурсы.Ссылка
			|ИЗ
			|	Справочник.СМ_Ресурсы КАК Ресурсы
			|ГДЕ
			|	Ресурсы.Ссылка В (&Каталог)
			|	И Ресурсы.Наименование = &Наименование
			|	И Ресурсы.ЭтоГруппа = ЛОЖЬ";
			
			Запрос.УстановитьПараметр("Наименование", ТекСтрока.Наименование);
			Запрос.УстановитьПараметр("Каталог", МассивРодителей);
			
			Результат = Запрос.Выполнить();
			Выборка = Результат.Выбрать();
			
			Если Выборка.Следующий() Тогда
				ТекРесурс = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		Если ДанныеЗаполнения.СоздаватьНовыеЭлементы И ТекРесурс.Пустая() Тогда
			Если СМ_СметаВызовСервера.НедоступнаРаботаСПрайсами() Тогда
				Продолжить;
			КонецЕсли;
			ТекРесурсОб = Справочники.СМ_Ресурсы.СоздатьЭлемент();
			ТекРесурсОб.ВидРесурса = ТекСтрока.ВидРесурса;
			ТекРесурсОб.Код = ТекСтрока.КодРесурса;
			ТекРесурсОб.Наименование = ТекСтрока.Наименование;
			ТекРесурсОб.ДлинноеНаименование = ТекСтрока.Наименование;
			ТекРесурсОб.Родитель = СМ_СметаЗагрузкаВызовСервера.СоздатьПолучитьПапкуРесурсов(""+ТекРесурсОб.ВидРесурса,Каталог);
			ТекРесурсОб.ЕдиницаИзмерения = НайтиЕдиницуИзмеренияСметномуКоду(ТекСтрока.ЕдиницаИзмерения);
			ТекРесурсОб.ГодВыпуска = ?(ЗначениеЗаполнено(ДанныеЗаполнения.СметноНормативнаяБаза.ГодВыпуска),ДанныеЗаполнения.СметноНормативнаяБаза.ГодВыпуска,Перечисления.СМ_ГодыВыпускаБазы.г2009);
			ТекРесурсОб.ВводитьСтоимостьНаОбъем = Ложь;
			ТекРесурсОб.Записать();
			ТекРесурс = ТекРесурсОб.Ссылка;
		КонецЕсли;
		
		//  Создаем новую строку ресурса в ТЧ
		
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("СметныйКодРесурса", ?(ЗначениеЗаполнено(ТекРесурс),ТекРесурс.Код,ТекСтрока.КодРесурса));
		ПараметрыОтбора.Вставить("ЕдиницаИзмеренияРесурса", ТекСтрока.ЕдиницаИзмерения);
		ПараметрыОтбора.Вставить("НаименованиеРесурса", ТекСтрока.Наименование);
		
		НайденныеСтроки = ТекОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()=0 Тогда
			НоваяСтрока 					= ТекОбъект.РесурсыПозицииЛокальнойСметы.Добавить();
			НоваяСтрока.Ресурс              = ТекРесурс.Ссылка;
			НоваяСтрока.СметныйКодРесурса	= ?(ЗначениеЗаполнено(НоваяСтрока.Ресурс),ТекРесурс.Код,ТекСтрока.КодРесурса);
			НоваяСтрока.НаименованиеРесурса = ТекСтрока.Наименование;
			НоваяСтрока.ЕдиницаИзмеренияРесурса = ТекСтрока.ЕдиницаИзмерения;
			НоваяСтрока.ВидРесурса = ТекСтрока.ВидРесурса;
			НоваяСтрока.НормаРасхода                    = ТекСтрока.НормаРасхода;
			Если НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
				НоваяСтрока.БазиснаяЦена                    = ТекСтрока.БазиснаяЦенаТруда;
			ИначеЕсли НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
				НоваяСтрока.БазиснаяЦена                    = ТекСтрока.БазиснаяЦена;
			ИначеЕсли НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
				НоваяСтрока.БазиснаяЦена                    = ТекСтрока.БазиснаяЦенаМашин;
				НоваяСтрока.БазиснаяЗарплатаМашинистов	  	= ТекСтрока.БазиснаяЗарплатаМашинистов;
			КонецЕсли;
			НоваяСтрока.ТипМатериала                  	= ТекСтрока.ТипРесурса;
		Иначе
			НоваяСтрока 					            = НайденныеСтроки[0];
			НоваяСтрока.НормаРасхода                    = НоваяСтрока.НормаРасхода+ТекСтрока.НормаРасхода;
		КонецЕсли;
		
	КонецЦикла;
	ТекОбъект.Записать();
		

КонецПроцедуры

// Поиск единицы измерения.
//
Функция НайтиЕдиницуИзмеренияСметномуКоду(Код)
	ЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(Код);
	Если ЕдиницаИзмерения.Пустая() Тогда
		Единица = Справочники.СМ_ЕдиницыИзмеренияСмета.СоздатьЭлемент();
		Единица.Наименование = Код;
		Единица.ОбменДанными.Загрузка = Истина;;
		Единица.Записать();
		ЕдиницаИзмерения = Единица.Ссылка;
	КонецЕсли;
	Возврат ЕдиницаИзмерения;  
КонецФункции

Функция ПреобразоватьВЧисло(ТекСтрока)
	
	Если ЗначениеЗаполнено(ТекСтрока) Тогда
		Попытка
			ТекЧисло = Число(ТекСтрока);
		Исключение
			ТекЧисло = 0;
		КонецПопытки;
	Иначе
		ТекЧисло = 0;
	КонецЕсли;
	
	Возврат ТекЧисло;
	
КонецФункции

Процедура СоздатьДокументПозицияЛС(ТекущаяСмета,ТекСтрока,ДанныеЗаполнения,Раздел,ПозицияВладелец = Неопределено)
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	
	//  Поиск существующей в базе позиции по реквизиту "Наименование"
	ТекНаименование = ТекСтрока.НаименованиеПозиции;
	Если НЕ ЗначениеЗаполнено(ТекНаименование) Тогда
		ТекНаименование = НСтр("ru='Позиция ЛС'");		
	КонецЕсли;
	
	//  Создание нового документа "ПозицияЛС"
	НовДок					= СМ_СметаВызовСервера.СоздатьНовуюПозицию();
	НовДок.Наименование 	= ТекНаименование;
	НовДок.Дата				= ТекущаяДатаСеанса();
	НовДок.ИДРодителя 	    = Раздел;
	НовДок.ИДСметы 			= ТекущаяСмета;
	НовДок.ШифрРасценки 	= ТекСтрока.ШифрПозиции;
	НовДок.Расчет 			= Истина;
	
	//  Поиск / создание единицы измерения
	ТекЕдИзм = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(ТекСтрока.ЕдиницаИзмерения);
	НовДок.ЕдиницаИзмерения			= ТекЕдИзм;
	Если (Не ЗначениеЗаполнено(НовДок.ЕдиницаИзмерения)) Тогда
		НовДок.ЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(ТекСтрока.ЕдиницаИзмерения);
	КонецЕсли;
				
	НовДок.Измеритель				= ТекСтрока.ЕдиницаИзмерения;
	НовДок.ПрямЗатраты = ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);	

	НовДок.ОснЗарплата              = ПреобразоватьВЧисло(ТекСтрока.ОсновнаяЗП);
	НовДок.ЭксплМашин               = ПреобразоватьВЧисло(ТекСтрока.ЭксплМашин);
	НовДок.ЗарплМашинистов          = ПреобразоватьВЧисло(ТекСтрока.ЗарплатаМашинистов);
	НовДок.СтоимМатериалов          = ПреобразоватьВЧисло(ТекСтрока.СтоимостьМатериалов);
	НовДок.ЗатратыТрудаМашинистов   = ПреобразоватьВЧисло(ТекСтрока.ТрудозатратыРабочих);
	НовДок.ЗатратыТрудаРабочих      = ПреобразоватьВЧисло(ТекСтрока.ТрудозатратыМашинистов);
	НовДок.ОбъемРабот				= ПреобразоватьВЧисло(ТекСтрока.ОбъемРабот);
	
	Если ДанныеЗаполнения.ФормаСметы = 1 ИЛИ ДанныеЗаполнения.ФормаСметы = 2 Тогда // ФЕР, ТЕР
		НовДок.НакладныеРасходыБазисные = ПреобразоватьВЧисло(ТекСтрока.НакладныеРасходыБазисные);
		НовДок.НакладныеРасходыТекущие = ПреобразоватьВЧисло(ТекСтрока.НакладныеРасходыТекущие);
		НовДок.СметнаяПрибыльБазисные = ПреобразоватьВЧисло(ТекСтрока.СметнаяПрибыльБазисные);
		НовДок.СметнаяПрибыльТекущие = ПреобразоватьВЧисло(ТекСтрока.СметнаяПрибыльТекущие);
		НовДок.КоэффициентКНРНаРемонтТекущий = ПреобразоватьВЧисло(ТекСтрока.КоэффициентКНРНаРемонтТекущий);
		НовДок.КоэффициентКСПНаРемонтТекущий = ПреобразоватьВЧисло(ТекСтрока.КоэффициентКСПНаРемонтТекущий);
		НовДок.ПоправочныйКоэффициентКНРТекущий = ПреобразоватьВЧисло(ТекСтрока.ПоправочныйКоэффициентКНРТекущий);
		НовДок.ПоправочныйКоэффициентКСПТекущий = ПреобразоватьВЧисло(ТекСтрока.ПоправочныйКоэффициентКСПТекущий);
	Иначе // ТСН
		НовДок.НакладныеРасходыТекущие = ПреобразоватьВЧисло(ТекСтрока.НакладныеРасходыТекущие);
		НовДок.НРТСНТекущиеРемонт = ПреобразоватьВЧисло(ТекСтрока.НРТСНТекущиеРемонт);
		НовДок.СПТСНТекущиеРемонт = ПреобразоватьВЧисло(ТекСтрока.СПТСНТекущиеРемонт);
		НовДок.СметнаяПрибыльТекущие = ПреобразоватьВЧисло(ТекСтрока.СметнаяПрибыльТекущие);
		НовДок.НакладныеРасходыБазисные = ПреобразоватьВЧисло(ТекСтрока.НакладныеРасходыБазисные);
		НовДок.НРТСНБазисРемонт = ПреобразоватьВЧисло(ТекСтрока.НРТСНБазисРемонт);
		НовДок.СметнаяПрибыльБазисные = ПреобразоватьВЧисло(ТекСтрока.СметнаяПрибыльБазисные);
		НовДок.СПТСНБазисРемонт = ПреобразоватьВЧисло(ТекСтрока.СПТСНБазисРемонт);
		НовДок.ЗимнееУдорож = ПреобразоватьВЧисло(ТекСтрока.ЗимнееУдорож);
		НовДок.ЗимнееУдорожРемонт = ПреобразоватьВЧисло(ТекСтрока.ЗимнееУдорожРемонт);
		НовДок.ЗимнееУдорожМатериал = ПреобразоватьВЧисло(ТекСтрока.ЗимнееУдорожМатериал);
		НовДок.ЗимнееУдорожМатериалРемонт = ПреобразоватьВЧисло(ТекСтрока.ЗимнееУдорожМатериалРемонт);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекСтрока.КоэффОснЗарплаты)
		ИЛИ Не ПустаяСтрока(ТекСтрока.КоэффСтоимЗарплатеМашин)
		ИЛИ Не ПустаяСтрока(ТекСтрока.КоэффСтоимЭксплМашин)
		ИЛИ Не ПустаяСтрока(ТекСтрока.КоэффСтоимМатериалов)Тогда 
		Кэф = НовДок.КоэффициентыПересчета.Добавить();
		Кэф.ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые;
		Кэф.КоэффОснЗарплаты = ПреобразоватьВЧисло(ТекСтрока.КоэффОснЗарплаты);
		Кэф.КоэффСтоимЗарплатеМашин = ПреобразоватьВЧисло(ТекСтрока.КоэффСтоимЗарплатеМашин);
		Кэф.КоэффСтоимЭксплМашин = ПреобразоватьВЧисло(ТекСтрока.КоэффСтоимЭксплМашин);
		Кэф.КоэффСтоимМатериалов = ПреобразоватьВЧисло(ТекСтрока.КоэффСтоимМатериалов);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекСтрока.Обоснование) Тогда
		ДобавитьПоправки(НовДок,ТекСтрока);
	КонецЕсли;

	НовДок.СпособСоздания			= Перечисления.СМ_ИсточникиДобавленияПозиций.Загружена;
	НовДок.ИсточникСоздания			= ДанныеЗаполнения.СметнаяПрограмма.Наименование + "#EXCEL";	
	
	Если ТекСтрока.Привязана Тогда
		Если ЗначениеЗаполнено(ПозицияВладелец) Тогда
			НовДок.ИДПозицииВладельца = ПозицияВладелец;
			// Ищем ресурсы неучтенные.
			ТекОбъект 						= ПозицияВладелец.ПолучитьОбъект();
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("СметныйКодРесурса", ТекСтрока.ШифрПозиции);
			ПараметрыОтбора.Вставить("ЕдиницаИзмеренияРесурса", ТекСтрока.ЕдиницаИзмерения);
			ПараметрыОтбора.Вставить("НаименованиеРесурса", ТекСтрока.НаименованиеПозиции);
			
			НайденныеСтроки = ТекОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаРесурс ИЗ НайденныеСтроки Цикл			
				СтрокаРесурс.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный;
			КонецЦикла;
			Если НайденныеСтроки.Количество()>0 Тогда
				ТекОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	НовДок.Определитель = ТекСтрока.Определитель;
	
	// Если определитель еще не нашли - ищем по косвенным признакам
	Если Не ЗначениеЗаполнено(НовДок.Определитель) Тогда
		Если (НовДок.СтоимМатериалов<>0) И ((НовДок.ОснЗарплата+НовДок.ЭксплМашин+НовДок.СтоимМатериалов) = 0) Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(19);
		ИначеЕсли (НовДок.Оборудование<>0) Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(14);
		Иначе
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(1);
		КонецЕсли;
	КонецЕсли;
	
	НовДок.РегиональнаяБаза = ДанныеЗаполнения.СметноНормативнаяБаза;
	НовДок.ТипНормативныхСборников = ТекСтрока.ТНС;
	
	НовДок.Записать();
	ТекПозиция = НовДок.Ссылка;
	
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате EXCEL'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ позиция ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	
	// Запись сообщений в журнал регистрации
	ЖурналРегистрацииВызовСервера.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	ТекСтрока.Ссылка = ТекПозиция;
	
КонецПроцедуры	

Процедура ДобавитьПоправки(НовДок,ТекСтрока)
	ПоправкиПозиции = НовДок.ПоправкиПозиции.Выгрузить();	
	
	МассивКэф = ПолучитьМассивЗначений(ТекСтрока.КоэффСМ);
	Для Каждого Кэф Из МассивКэф Цикл 
		Поправка 			= ПоправкиПозиции.Добавить();	
		Поправка.Применить 	= Истина;
		Поправка.Обоснование = ТекСтрока.Обоснование;
		Поправка.УсловияПрименения		= ТекСтрока.УсловияПрименения;
		Поправка.ТипПоправки = Перечисления.СМ_ТипыПоправок.ТехчастиСборников;
		Поправка.ВариантРасчета = Перечисления.СМ_ВариантыРасчетаЭММ.Одинаковые;
		Поправка.КоэффСМ = Кэф;
	КонецЦикла;
	
	МассивКэф = ПолучитьМассивЗначений(ТекСтрока.КоэффЭМ);
	сч = 0;
	Для Каждого Кэф Из МассивКэф Цикл 
		сч=сч+1;
		Если ПоправкиПозиции.Количество()>=сч Тогда
			Поправка = ПоправкиПозиции[сч-1];
