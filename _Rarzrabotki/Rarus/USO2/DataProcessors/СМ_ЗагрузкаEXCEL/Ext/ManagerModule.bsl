	ТабПозиций.Колонки.Добавить("ЗимнееУдорож");
	ТабПозиций.Колонки.Добавить("ЗимнееУдорожРемонт");
	ТабПозиций.Колонки.Добавить("ЗимнееУдорожМатериал");
	ТабПозиций.Колонки.Добавить("ЗимнееУдорожМатериалРемонт");
	
	ТабПозиций.Колонки.Добавить("КоэффициентКНРНаРемонтТекущий");
	ТабПозиций.Колонки.Добавить("КоэффициентКСПНаРемонтТекущий");
	ТабПозиций.Колонки.Добавить("ПоправочныйКоэффициентКНРТекущий");
	ТабПозиций.Колонки.Добавить("ПоправочныйКоэффициентКСПТекущий");
	
	// КоэффициентыПересчета
	ТабПозиций.Колонки.Добавить("КоэффОснЗарплаты");
	ТабПозиций.Колонки.Добавить("КоэффСтоимЗарплатеМашин");
	ТабПозиций.Колонки.Добавить("КоэффСтоимЭксплМашин");
	ТабПозиций.Колонки.Добавить("КоэффСтоимМатериалов");
	
	// Поправки
	ТабПозиций.Колонки.Добавить("Обоснование");
	ТабПозиций.Колонки.Добавить("УсловияПрименения");
	ТабПозиций.Колонки.Добавить("КоэффСМ");
	ТабПозиций.Колонки.Добавить("КоэффЭМ");
	ТабПозиций.Колонки.Добавить("КоэффОЗ");
	ТабПозиций.Колонки.Добавить("КоэффЗМ");
	ТабПозиций.Колонки.Добавить("КоэффТР");
	ТабПозиций.Колонки.Добавить("КоэффТM");
	
	
	Стройка = "";
	ИДПозиции = "";
	ИДРаздела = "";
	НомерСтроки = 11;
	
	ПрефиксыПрограммы = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксы(ДанныеЗаполнения.СметнаяПрограмма);
	
	Для Каждого Док Из ТЗПозиции Цикл
		НомерСтроки = НомерСтроки + 1;
		Если ПустаяСтрока(Док.Колонка6) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Док.Колонка1 = "1" Тогда  // стройка
			Стройка = СокрЛП(Док.Колонка7);
			Продолжить;
		КонецЕсли;
		
		Если Док.Колонка1 = "3" Тогда // смета
			НовСмета = ТабДокументов.Добавить();
			НовСмета.Стройка = Стройка;
			НовСмета.ИДНомерСметы = СокрЛП(Док.Колонка4);
			НовСмета.Наименование = СокрЛП(Док.Колонка7);
			НовСмета.Стройка = Стройка;
			НовСмета.ПерваяСтраница = ?(Док.Колонка2 = "1",Истина,Ложь);
			ИДРаздела = "";
			Продолжить;
		КонецЕсли;

		Если Док.Колонка1 = "4" Тогда // раздел
			НовРаздел = ТабРазделов.Добавить();
			НовРаздел.НомерРаздела = СокрЛП(Док.Колонка4);
			НовРаздел.НаименованиеРаздела = СокрЛП(Док.Колонка7);
			НовРаздел.НомерСметы = НовСмета.ИДНомерСметы;
			ИДРаздела = НовРаздел.НомерРаздела;
			Продолжить;
		КонецЕсли;

		Если Док.Колонка1 = "17"
			ИЛИ Док.Колонка1 = "18" Тогда // позиция
			
			Если Не Док.Колонка68 = "1" Тогда
				Продолжить;
			КонецЕсли;

			Определитель = "";
			ТНС = "";
			НовПозиция = ТабПозиций.Добавить();
			НовПозиция.Привязана = ?(Док.Колонка1 = "17",Ложь,Истина);
			НовПозиция.НомерРаздела = ИДРаздела;
			НовПозиция.НомерСтроки = Формат(НомерСтроки,"ЧГ=0");
			НовПозиция.НомерПозицииВСмете = СокрЛП(Док.Колонка5);
			НовПозиция.ШифрПозиции = СокрЛП(Док.Колонка6);
			НовПозиция.НаименованиеПозиции = СокрЛП(Док.Колонка7);
			НовПозиция.НомерСметы = НовСмета.ИДНомерСметы;
			НовПозиция.ЕдиницаИзмерения = СокрЛП(Док.Колонка8);
			НовПозиция.ОбъемРабот = СокрЛП(Док.Колонка9);
			
			Префикс = СокрЛП(Док.Колонка62);
			
			НужнаяСтрока = Неопределено;
			Если ПрефиксыПрограммы<>Неопределено И ПрефиксыПрограммы.Количество()>0 Тогда
				НужнаяСтрока = СМ_АРПС_ОбменВызовСервера.НайтиСтрокуПоПрефиксу(НовПозиция.ШифрПозиции,ПрефиксыПрограммы);
				Если НЕ НужнаяСтрока = Неопределено Тогда
					НовПозиция.ШифрПозиции = ?(НужнаяСтрока.НеОтбрасыватьПрефикс,НовПозиция.ШифрПозиции,НужнаяСтрока.ШифрБезПрефикса);
					Определитель = НужнаяСтрока.Определитель;
					ТНС = НужнаяСтрока.ТНС; 
				КонецЕсли;
			КонецЕсли;

			Если НужнаяСтрока = Неопределено Тогда
				Если СокрЛП(Док.Колонка60) = "0" И СокрЛП(Док.Колонка61) = "1" Тогда
					
					НомерСборника = "";
					сч = 1;
					Пока сч<=СтрДлина(НовПозиция.ШифрПозиции) Цикл
						Символ = Сред(НовПозиция.ШифрПозиции,сч,1);
						Если СтрНайти("0123456789",Символ)>0 Тогда
							НомерСборника = НомерСборника + Строка(Символ);
						КонецЕсли;
						сч = сч + 1;
						Если СтрДлина(НомерСборника)=2 Тогда
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					НомерСборника = Число(НомерСборника);
					Если  НомерСборника<51 Тогда
						ТНС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;
					Иначе
						ТНС = Перечисления.СМ_ТипыНормативныхСборников.РемонтноСтроительныеРаботы;
					КонецЕсли;
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(1);
				ИначеЕсли СокрЛП(Док.Колонка60) = "0" И СокрЛП(Док.Колонка61) = "2" Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(6);
					ТНС = Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы;
				ИначеЕсли СокрЛП(Док.Колонка60) = "3" И СокрЛП(Док.Колонка61) = "1" Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(19);
					ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
				ИначеЕсли СокрЛП(Док.Колонка60) = "3" И СокрЛП(Док.Колонка61) = "2" Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(13);
					ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
				Иначе
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(1);
				КонецЕсли;
			КонецЕсли;
			
			НовПозиция.Определитель = Определитель;
			НовПозиция.ТНС = ТНС;
				
			НовПозиция.ПрямыеЗатраты = СокрЛП(Док.Колонка37);
			НовПозиция.ОсновнаяЗП = СокрЛП(Док.Колонка41);
			НовПозиция.ЭксплМашин = СокрЛП(Док.Колонка39);
			НовПозиция.ЗарплатаМашинистов = СокрЛП(Док.Колонка40);
			НовПозиция.СтоимостьМатериалов = СокрЛП(Док.Колонка38);
			НовПозиция.ТрудозатратыРабочих = СокрЛП(Док.Колонка43);
			НовПозиция.ТрудозатратыМашинистов = СокрЛП(Док.Колонка44);
			Если ДанныеЗаполнения.ФормаСметы = 1 ИЛИ ДанныеЗаполнения.ФормаСметы = 2 Тогда // ФЕР, ТЕР
				НовПозиция.НакладныеРасходыБазисные = СокрЛП(Док.Колонка78);
				НовПозиция.СметнаяПрибыльБазисные = СокрЛП(Док.Колонка79);
			Иначе
				НовПозиция.НакладныеРасходыБазисные = СокрЛП(Док.Колонка118);
				НовПозиция.СметнаяПрибыльБазисные = СокрЛП(Док.Колонка119);
			КонецЕсли;
			НовПозиция.НакладныеРасходыТекущие = СокрЛП(Док.Колонка78);
			НовПозиция.НРТСНТекущиеРемонт = СокрЛП(Док.Колонка78);
			
			НовПозиция.СметнаяПрибыльТекущие = СокрЛП(Док.Колонка79);
			НовПозиция.СПТСНТекущиеРемонт = СокрЛП(Док.Колонка79);
			НовПозиция.НРТСНБазисРемонт = СокрЛП(Док.Колонка118);
			НовПозиция.СПТСНБазисРемонт = СокрЛП(Док.Колонка119);
			
			НовПозиция.ЗимнееУдорож = СокрЛП(Док.Колонка48);   // Колонка120
			НовПозиция.ЗимнееУдорожРемонт = СокрЛП(Док.Колонка48);// Колонка120
			НовПозиция.ЗимнееУдорожМатериал = СокрЛП(Док.Колонка49); // Колонка121
			НовПозиция.ЗимнееУдорожМатериалРемонт = СокрЛП(Док.Колонка49);  // Колонка121
			
			НовПозиция.КоэффициентКНРНаРемонтТекущий = СокрЛП(Сред(Док.Колонка176,2,6)); //убрала*
			НовПозиция.КоэффициентКСПНаРемонтТекущий = СокрЛП(Сред(Док.Колонка177,2,6)); //убрала*
			НовПозиция.ПоправочныйКоэффициентКНРТекущий = СокрЛП(Сред(Док.Колонка178,2,6)); //убрала*
			НовПозиция.ПоправочныйКоэффициентКСПТекущий = СокрЛП(Сред(Док.Колонка179,2,6));  //убрала*
			
			НовПозиция.КоэффОснЗарплаты = СокрЛП(Док.Колонка53);
			НовПозиция.КоэффСтоимЗарплатеМашин = СокрЛП(Док.Колонка53);
			НовПозиция.КоэффСтоимЭксплМашин = СокрЛП(Док.Колонка54);
			НовПозиция.КоэффСтоимМатериалов = СокрЛП(Док.Колонка55);

			СтрокаПоправки = СокрЛП(Док.Колонка92);
			НомОбоснование = СтрНайти(СтрокаПоправки,"Поправка:");
			НомНаименование = СтрНайти(СтрокаПоправки,"Наименование:");
			Обоснование = "";
			УсловияПрименения = "";
			Если НомОбоснование>0 И НомНаименование>0 Тогда
				Обоснование = Сред(СтрокаПоправки,НомОбоснование+9,НомНаименование-(НомОбоснование+9));
				УсловияПрименения = Сред(СтрокаПоправки,НомНаименование+13);
			КонецЕсли;
			
			НовПозиция.Обоснование = СокрЛП(Обоснование);
			НовПозиция.УсловияПрименения = СокрЛП(УсловияПрименения);
			НовПозиция.КоэффСМ = СокрЛП(Док.Колонка108);
			НовПозиция.КоэффЭМ = СокрЛП(Док.Колонка109);
			НовПозиция.КоэффОЗ = СокрЛП(Док.Колонка111);
			НовПозиция.КоэффЗМ = СокрЛП(Док.Колонка112);
			НовПозиция.КоэффТР = СокрЛП(Док.Колонка113);
			НовПозиция.КоэффТM = СокрЛП(Док.Колонка114);
			
			Если Не НовПозиция.Привязана Тогда
				ИДПозиции = НовПозиция.НомерСтроки;
			Иначе
				НовПозиция.ИДВладельца = ИДПозиции;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;

	КонецЦикла;
	
	Возврат Новый Структура("ТабДокументов,ТабРазделов,ТабПозиций",ТабДокументов,ТабРазделов,ТабПозиций);
КонецФункции

Функция ОбработатьРесурсы(ТЗРесурсы)
	//  Таблица ресурсов
	ТабРесурсов = Новый ТаблицаЗначений;
	ТабРесурсов.Колонки.Добавить("КодРесурса");
	ТабРесурсов.Колонки.Добавить("ЕдиницаИзмерения");
	ТабРесурсов.Колонки.Добавить("Наименование");
	ТабРесурсов.Колонки.Добавить("ВидРесурса");
	ТабРесурсов.Колонки.Добавить("НормаРасхода");
	ТабРесурсов.Колонки.Добавить("БазиснаяЦенаТруда");
	ТабРесурсов.Колонки.Добавить("БазиснаяЦенаМашин");
	ТабРесурсов.Колонки.Добавить("БазиснаяЗарплатаМашинистов");// для машин
	ТабРесурсов.Колонки.Добавить("БазиснаяЦена"); // для материалов
	ТабРесурсов.Колонки.Добавить("ТипРесурса");
	ТабРесурсов.Колонки.Добавить("НомерСтроки");
	
	Для Каждого Рес Из ТЗРесурсы Цикл
		НовСтрока = ТабРесурсов.Добавить();
		НовСтрока.КодРесурса = СокрЛП(Рес.Колонка9);
		НовСтрока.ЕдиницаИзмерения = СокрЛП(Рес.Колонка16);
		НовСтрока.Наименование = СокрЛП(Рес.Колонка11);
		НовСтрока.НормаРасхода = СокрЛП(Рес.Колонка25);
		НовСтрока.БазиснаяЦенаТруда = СокрЛП(Рес.Колонка30);
		НовСтрока.БазиснаяЦенаМашин = СокрЛП(Рес.Колонка32);
		НовСтрока.БазиснаяЗарплатаМашинистов = СокрЛП(Рес.Колонка33);
		НовСтрока.БазиснаяЦена = СокрЛП(Рес.Колонка31);
		НовСтрока.НомерСтроки = Формат(Число(Рес.Колонка1),"ЧГ=0");
		
		Если СокрЛП(Рес.Колонка8)="1" Тогда
			НовСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;
		ИначеЕсли СокрЛП(Рес.Колонка8)="2" Тогда
			НовСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
		ИначеЕсли СокрЛП(Рес.Колонка8)="3" Тогда
			НовСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
		КонецЕсли;
		
		ТипРесурса = Перечисления.СМ_ТипыМатериалов.Учтенный;
		Если СокрЛП(Рес.Колонка41)="0"
			И СокрЛП(Рес.Колонка42)="1" Тогда
			ТипРесурса = Перечисления.СМ_ТипыМатериалов.НеУчтенный;
		КонецЕсли;
		НовСтрока.ТипРесурса = ТипРесурса;
	КонецЦикла;
	
	Возврат Новый Структура("ТабРесурсов",ТабРесурсов);
КонецФункции

