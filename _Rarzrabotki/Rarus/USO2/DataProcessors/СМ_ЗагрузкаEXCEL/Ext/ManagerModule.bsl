Функция ПолучитьМассивЗначений(ТекСтрока)
	
	ТекФормула = СтрЗаменить(ТекСтрока,")","");
	ТекФормула = СтрЗаменить(ТекФормула,",",".");
	МассивКэф = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекФормула,"*",Истина,Истина);
	Возврат МассивКэф;
	
КонецФункции

Процедура СоздатьДокументЛС(ТекСтрока,ДанныеЗаполнения,ТаблицаРезультата)

	//  Создание нового документа "Локальная смета".
	НовДок 					= Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
	НовДок.Автор 			= ПользователиКлиентСервер.АвторизованныйПользователь();
	НовДок.Наименование 	= ТекСтрока.Наименование;
	//НовДок.ДатаТекущихЦен	= ТекСтрока.ДатаЦен;
	//НовДок.Основание		= ТекСтрока.ПроектнаяДокументация;
	НовДок.НомерСметы		= ТекСтрока.ИДНомерСметы;
	//НовДок.Договор		= ТекДоговор;
	//НовДок.Подрядчик    	= ТекПодрядчик;
	НовДок.Дата				= ТекущаяДатаСеанса();
	СМ_СметаВызовСервера.ЗаполнитьНастройкиПользователяПоУмолчанию(НовДок);
	Если ЗначениеЗаполнено(ДанныеЗаполнения.Заказчик) Тогда
		НовДок.Заказчик 		= ДанныеЗаполнения.Заказчик;
	КонецЕсли;
	НовДок.Организация		= ДанныеЗаполнения.Организация;
	НовДок.Район			= ДанныеЗаполнения.Район;
	
	Если ДанныеЗаполнения.ФормаСметы = 1 ИЛИ ДанныеЗаполнения.ФормаСметы = 2 Тогда // ФЕР
		НовДок.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35;
	ИначеЕсли ДанныеЗаполнения.ФормаСметы = 3 Тогда // ТСН
		НовДок.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_МетодикаТСНГородаМосква;
	КонецЕсли;
	
	Если ДанныеЗаполнения.ФормаСметы = 1 ИЛИ ДанныеЗаполнения.ФормаСметы = 2 Тогда // ФЕР, ТЕР
		НовДок.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
		НовДок.МетодикаТСН = Ложь;
		НовДок.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат;
		НовДок.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка;
		НовДок.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ПрименятьНРиСП;
	Иначе
		НовДок.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
		НовДок.МетодикаТСН = Истина;
		НовДок.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат;
		НовДок.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка;
	КонецЕсли;
	
	// Если ЗначениеЗаполнено(ТекСтрока.Стройка) Тогда
	//	НовДок.Стройка = ПолучитьСтройку(ТекСтрока.Стройка);
	// Иначе
		НовДок.Стройка = ДанныеЗаполнения.ТекСтройка;
	// КонецЕсли;
	
	НовДок.Записать();
	
	ТекСмета = НовДок.Ссылка;
	
	// Запись сообщений в журнал регистрации
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате EXCEL'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	ЖурналРегистрацииВызовСервера.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		
	ТекСтрока.Ссылка = ТекСмета.Ссылка;
	
	НовСтр = ТаблицаРезультата.Добавить();
	НовСтр.Ссылка = ТекСмета.Ссылка;
КонецПроцедуры

Процедура СоздатьДокументРаздел(ТекущаяСмета,ТекСтрока = Неопределено,ТабРазделов = Неопределено,Раздел = Неопределено,НомерСметы = Неопределено)

	
	Если ТекСтрока = Неопределено Тогда
		НаименованиеРаздела = ТекущаяСмета.Наименование;
	Иначе
		НаименованиеРаздела	= ТекСтрока.НаименованиеРаздела;
	КонецЕсли;
	
	//  Создание нового документа "Раздел ЛС". 
	НовДок							= СМ_СметаВызовСервера.СоздатьНовыйРаздел();
	НовДок.НаименованиеДляПечати 	= НаименованиеРаздела;
	НовДок.Дата						= ТекущаяДатаСеанса();
	НовДок.ИДРодителя   			= ТекущаяСмета.Ссылка;
	НовДок.ИДСметы      			= ТекущаяСмета.Ссылка;
	НовДок.Расчет					= Истина;
	
	НовДок.Записать();
	ТекРаздел = НовДок.Ссылка;
	

	// Запись сообщений в журнал регистрации
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате EXCEL'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ раздел: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НаименованиеРаздела));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	ЖурналРегистрацииВызовСервера.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	Если Не ТекСтрока = Неопределено Тогда
		ТекСтрока.Ссылка =  ТекРаздел;
	Иначе
		Раздел = ТекРаздел;
		НовРаздел = ТабРазделов.Добавить();
		НовРаздел.НомерРаздела = "";
		НовРаздел.НаименованиеРаздела = НаименованиеРаздела;
		НовРаздел.НомерСметы = ТекущаяСмета.НомерСметы;
		НовРаздел.Ссылка = ТекРаздел;
	КонецЕсли;
	
КонецПроцедуры	

Функция ВернутьТЗ(Данные, ВсегоСтрок, ВсегоКолонок)
	ТЗ =  Новый ТаблицаЗначений;
	
	Для Счетчик = 1 По ВсегоКолонок Цикл
	    ТЗ.Колонки.Добавить("Колонка"+Счетчик, Новый ОписаниеТипов("Строка"));
	КонецЦикла;
	
	Для Счетчик = 1 По ВсегоСтрок Цикл
	    НоваяСтрока = ТЗ.Добавить();
	КонецЦикла;
	
	Для Счетчик = 0 По ВсегоКолонок-1 Цикл
	    ТЗ.ЗагрузитьКолонку(Данные[Счетчик], Счетчик);
	КонецЦикла;
	
	Возврат ТЗ;
КонецФункции

