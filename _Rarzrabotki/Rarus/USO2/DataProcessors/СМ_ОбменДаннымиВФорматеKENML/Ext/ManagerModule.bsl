							НоваяСтрока.ПрямыеЗатраты = ПреобразоватьВЧисло(""+Значение);
						ИначеЕсли ИмяПараметра = "МТ" Тогда
							НоваяСтрока.СтоимостьМатериалов = ПреобразоватьВЧисло(""+Значение);
