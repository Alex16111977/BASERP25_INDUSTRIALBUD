
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ДокСсылка;
Перем СметнаяПрограмма;
Перем ФорматВыгрузки;
Перем ТекущаяСмета;
Перем ТекущийРаздел;
Перем ТекущаяПозицияЛС;
Перем ТекКонтрагент;
Перем Форма;
Перем ПрефиксыПрограммы;

#КонецОбласти

#Область ПроцедурыИФункцииЭкспорта

// Основная процедура выгрузки документов в файл в формате KENML. 
// Вызывается из модуля формы обработки по кнопке "Выгрузить".
// 
//  Параметры:
//   ФорматВыгрузки		- Формат выгрузки указанный на форме.
//   ДокументВыгрузки	- Строка таблицы смет.
// 
Процедура ВыгрузитьВФайлKENML(ДокументВыгрузки,АдресФайлаВоВременномХранилище,ИмяВременногоФайла) Экспорт 
	
	СметнаяПрограмма = ?(СметнаяПрограммаВыбор.Пустая(),Справочники.СМ_СметныеПрограммы.Смета30,СметнаяПрограммаВыбор);
		
	ФайлВыгрузки = ДокументВыгрузки.Файл;
	
	АдресФайлаВоВременномХранилище = Новый Соответствие;
	
	ЗаписьXML 		= Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла,"UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ДОКУМЕНТ");
	ЗаписьXML.ЗаписатьАтрибут("ВерсияФормата","01.00");
	ЗаписьXML.ЗаписатьАтрибут("Тип","1");
	ЗаписьXML.ЗаписатьАтрибут("ГЕНЕРАТОР","SANA-2015");
	ЗаписьXML.ЗаписатьАтрибут("Дата",Формат(ДокументВыгрузки.Смета.Дата,"ДФ=dd.MM.yyyy"));
	ЗаписьXML.ЗаписатьАтрибут("Время",Формат(ДокументВыгрузки.Смета.Дата,"ДЛФ=T"));
	ЗаписьXML.ЗаписатьАтрибут("ВерсияСНБ","");
	ЗаписьXML.ЗаписатьАтрибут("Версия","");
	ЗаписьXML.ЗаписатьАтрибут("УникальныйИдентификатор","");
	ЗаписьXML.ЗаписатьАтрибут("НаименованиеСтройки","");
	ЗаписьXML.ЗаписатьАтрибут("ШифрСтройки","");
	ЗаписьXML.ЗаписатьАтрибут("СтадияПроектирования","");
	ЗаписьXML.ЗаписатьАтрибут("Руководитель","");
	ЗаписьXML.ЗаписатьАтрибут("ГИП","");
	ЗаписьXML.ЗаписатьАтрибут("НачальникСметногоОтдела","");
	ЗаписьXML.ЗаписатьАтрибут("Валюта","");
	ЗаписьXML.ЗаписатьАтрибут("КодВалюты","");
	ЗаписьXML.ЗаписатьАтрибут("НомерРегиона","");
	ЗаписьXML.ЗаписатьАтрибут("НомерРайона","");
	ЗаписьXML.ЗаписатьАтрибут("НомерЗоны","");
	ЗаписьXML.ЗаписатьАтрибут("НомерЗоныКСЦ","");
	ЗаписьXML.ЗаписатьАтрибут("КодОрганизации","");
	ЗаписьXML.ЗаписатьАтрибут("ВидСтроительства","");
	ЗаписьXML.ЗаписатьАтрибут("ПоказательНК2","");
	ЗаписьXML.ЗаписатьАтрибут("ПоказательСП","");
	ЗаписьXML.ЗаписатьАтрибут("УровеньЦен","");
	ЗаписьXML.ЗаписатьАтрибут("ОкруглениеЕдиницы","");
	ЗаписьXML.ЗаписатьАтрибут("ОкруглениеВсего","");
	ЗаписьXML.ЗаписатьАтрибут("ОкруглениеТрудЕдиницы","");
	ЗаписьXML.ЗаписатьАтрибут("ОкруглениеТрудВсего","");
	ЗаписьXML.ЗаписатьАтрибут("Глава","");
	ЗаписьXML.ЗаписатьАтрибут("НаименованиеОбъекта","");
	ЗаписьXML.ЗаписатьАтрибут("НаименованиеДок","");
	ЗаписьXML.ЗаписатьАтрибут("ШифрОбъекта","");
	ЗаписьXML.ЗаписатьАтрибут("ШифрСметы","");
	ЗаписьXML.ЗаписатьАтрибут("СписокЧертежей","");
	ЗаписьXML.ЗаписатьАтрибут("СтроительныйОбъем","");
	ЗаписьXML.ЗаписатьАтрибут("Измеритель","");
	ЗаписьXML.ЗаписатьАтрибут("НомерДокумента",ДокументВыгрузки.Смета.НомерСметы);
	ЗаписьXML.ЗаписатьАтрибут("СписокРабот","");
	ЗаписьXML.ЗаписатьАтрибут("Составил","");
	ЗаписьXML.ЗаписатьАтрибут("Проверил","");
	ЗаписьXML.ЗаписатьАтрибут("ВводДанных","");
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("СТРУКТУРА");
	
	ДеревоРасценок = Новый ДеревоЗначений;
	ДеревоРасценок.Колонки.Добавить("НомерПозиции");
	ДеревоРасценок.Колонки.Добавить("Позиция");
	ДеревоРасценок.Колонки.Добавить("ЕдИзм");
	ДеревоРасценок.Колонки.Добавить("Объем");
	ДеревоРасценок.Колонки.Добавить("ТипПозиции");
	ДеревоРасценок.Колонки.Добавить("Ид");
	ДеревоРасценок.Колонки.Добавить("ИдРодителя");
	ДеревоРасценок.Колонки.Добавить("Расчет");	
	
	Если ДокументВыгрузки.Смета.Метаданные().Имя  = "АктВыполненныхРабот" Тогда
		ДеревоРасценок.Колонки.Добавить("НомерПоСмете");	
	КонецЕсли; 
			
	ПараметрыДокумента 	= Новый Структура("ВыводитьЗаголовокСметы,ЗаполнитьАктСметой,ВыводитьРесурсы,Документ",истина, ложь, ложь, истина);
	ДокСсылка 			= СоберемТаблицыДокумента(ДокументВыгрузки.Смета);
	
	ДокЗаполнитьДеревоДокумента(ДокументВыгрузки.Смета, ДеревоРасценок, ПодготовитьТаблицуРеквизитов(ДокументВыгрузки.Смета, ДеревоРасценок), ПараметрыДокумента, ДокСсылка);
	ОбходСтрокДереваДокументов(ЗаписьXML,ДокументВыгрузки.Смета,ДеревоРасценок.Строки, ДокСсылка, ФорматВыгрузки); 
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // СТРУКТУРА
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИТОГДОК");
	ЗаписьXML.ЗаписатьАтрибут("ID","");
	ЗаписьXML.ЗаписатьАтрибут("Строительные","");
	ЗаписьXML.ЗаписатьАтрибут("Монтажные","");
	ЗаписьXML.ЗаписатьАтрибут("ИнженерноеОБ","0");
	ЗаписьXML.ЗаписатьАтрибут("ТехнологическоеОБ","0");
	ЗаписьXML.ЗаписатьАтрибут("МебельИнвентарь","0");
	ЗаписьXML.ЗаписатьАтрибут("Прочие","");
	ЗаписьXML.ЗаписатьАтрибут("Всего","");
	ЗаписьXML.ЗаписатьАтрибут("ЗатратыПодрядчика","");
	ЗаписьXML.ЗаписатьАтрибут("ЗатратыЗаказчика","");
	ЗаписьXML.ЗаписатьКонецЭлемента(); // ИТОГДОК
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("ИТОГРЕСУРС");
	ЗаписьXML.ЗаписатьКонецЭлемента(); // ИТОГРЕСУРС
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // ДОКУМЕНТ

	Попытка
		ЗаписьXML.Закрыть();
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
		АдресФайлаВоВременномХранилище.Вставить(ФайлВыгрузки,АдресФайла);

	Исключение
		СтруктураСообщения 	= Новый Структура;
		СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
		СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
		СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось записать в файл: %1'"), ФайлВыгрузки));
		СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
		
		СообщенияДляЖурнала	= Новый СписокЗначений();
		СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	КонецПопытки;
		
КонецПроцедуры //  ВыгрузитьВФайлKENML()

// Процедура формирует строку информации о разделах, позициях и поправках.
// В АРПС 1.10 - Тип 10 - Заголовок раздела документа, Тип 20 - Позиция документа,
// Тип 25 - поправочные коэффициенты.
// Записи раздела используются для задания структуры документа. 
// Записи позиций задают состав работ документа.
// Записи поправок задают состав и значения поправочных коэффициентов, 
// примененных к ближайшей предшествующей позиции документа.
// 
//  Параметры:
//   ТекстВыгрузки 			 - ТекстовыйДокумент - формируемый текст выгрузки.
//   Документ 				 - ДокументСсылка,ДокументОбъект - документ Локальная смета или Акт выполненных работ.
//   СтрокиДерева 			 - КоллекцияСтрокДереваЗначений - строки дерева документов,
//   						                                  по которым будет формироваться рекурсивно записи о структуре.
//   ТЗРазделыЛС  			 - ТаблицаЗначений - таблица разделов локальной сметы.
//   ТЗПозицииЛС  			 - ТаблицаЗначений - таблица позиций локальной сметы.
//   ТЗВидСтоимостиНаЕдиницу - ТаблицаЗначений - таблица информации о стоимостных показателях
//   						   					 позиций локальной сметы.
//   ТаблицаПоправок 		- ТаблицаЗначений - таблица поправочных коэффициентов.
//   РазрешеныПоправки 		- Булево - определяет формирование поправочных коэффициентов.
// 
Процедура ОбходСтрокДереваДокументов(ЗаписьXML,ДокументСсылка,СтрокиДерева, ДокСсылка, ФорматВыгрузки)
	
	МетодРасчета = ДокументСсылка.МетодРасчета;
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		//  Выгрузка раздела
		Если СтрокаДерева.ТипПозиции = "Раздел" И СтрокаДерева.Расчет Тогда
			
			ЗаписьXML.ЗаписатьНачалоЭлемента("РАЗДЕЛ");
			
			НомерРаздела 		= СтрокаДерева.НомерПозиции;
			НаименованиеРаздела = СтрокаДерева.Позиция.НаименованиеДляПечати;
			ТекущийРаздел		= СтрокаДерева.Позиция; 
			ТекУровень 			= СтрокаДерева.Уровень();
					
			ЗаписьXML.ЗаписатьАтрибут("Тип",?(СтрокаДерева.Позиция.ИДРодителя = СтрокаДерева.Позиция.ИДСметы,"3","4"));
			ЗаписьXML.ЗаписатьАтрибут("ID",XMLСтрока(НомерРаздела));
			ЗаписьXML.ЗаписатьАтрибут("Наименование",НаименованиеРаздела);
			ЗаписьXML.ЗаписатьАтрибут("Измеритель","");
			ЗаписьXML.ЗаписатьАтрибут("Примечание","");
			

						
			мСтрокиРасценок = Новый ТаблицаЗначений();
			Если НЕ СтрокаДерева.Строки.Количество() = 0 Тогда
				мСтрокиРасценок = МассивРасценок(СтрокаДерева.Строки[0].ИДРодителя);
			Иначе
				мСтрокиРасценок.Очистить();
			КонецЕсли;	
			
			Для Каждого СтрокаРасценки Из мСтрокиРасценок Цикл
				
				ЗаписьXML.ЗаписатьНачалоЭлемента("ПОЗИЦИЯ");
				
				КодПозиции				= СтрокаРасценки.Шифр;						// строкаРасценки.Позиция.Ид;
				НомерСтрокиВДокументе	= СтрокаРасценки.НомерВПределахСметы;
				ЕдИзм					= Строка(СтрокаРасценки.ЕдИзм);
				КомментарийРасценки     = СокрЛП(СтрокаРасценки.Комментарий);
				ОбъемРабот        		= СтрокаРасценки.Объем;
				ТекПозицияЛС 			= СтрокаРасценки.Позиция;

				Если ЗначениеЗаполнено(СтрокаРасценки.СобственноеНаименование) Тогда
					НаименованиеПозиции = СтрокаРасценки.СобственноеНаименование; 
				Иначе
					НаименованиеПозиции = СтрокаРасценки.Позиция.ПолноеНаименование;
				КонецЕсли;
			
				//  Вид затрат
				ТекВидРабот	= ТекПозицияЛС.Определитель.ВидРабот;
				ТекТипПозиции = "0";
				Если ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы Тогда
					ТекТипПозиции = "0";	
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.РемонтноСтроительныеРаботы Тогда
					ТекТипПозиции = "0";
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы Тогда
					ТекТипПозиции = "0";
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.ПусконаладочныеРаботы Тогда
					ТекТипПозиции = "0";	
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка Тогда
					ТекТипПозиции = "6";	
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы Тогда
					ТекТипПозиции = "1";	
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин Тогда
					ТекТипПозиции = "3";	
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция Тогда
					ТекТипПозиции = "0";	
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.УкрупненныеСметныеНормы Тогда
					ТекТипПозиции = "0";
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.ПрейскурантОптовыхЦенНаМатериалыИОборудование Тогда
					ТекТипПозиции = "1";
				ИначеЕсли ТекПозицияЛС.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.РеставрационноВосстановительныеРаботы Тогда
					ТекТипПозиции = "0";	
				КонецЕсли;
				
				ЗаписьXML.ЗаписатьАтрибут("ID",XMLСтрока(НомерСтрокиВДокументе));
				ЗаписьXML.ЗаписатьАтрибут("Тип",ТекТипПозиции);
				ЗаписьXML.ЗаписатьАтрибут("GUID","");
				ЗаписьXML.ЗаписатьАтрибут("КодСНБ",КодПозиции);
				ЗаписьXML.ЗаписатьАтрибут("КодЛокальный","");
				ЗаписьXML.ЗаписатьАтрибут("Наименование",НаименованиеПозиции);  
				ЗаписьXML.ЗаписатьАтрибут("КомментКод","");
				ЗаписьXML.ЗаписатьАтрибут("КомментНаим","");
				ЗаписьXML.ЗаписатьАтрибут("Объем",XMLСтрока(ОбъемРабот));
				ЗаписьXML.ЗаписатьАтрибут("ОбъемФормула","");
				ЗаписьXML.ЗаписатьАтрибут("Измеритель",СтрокаРасценки.Позиция.Измеритель);
				Если ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы Тогда
					ЗаписьXML.ЗаписатьАтрибут("ВидЗатрат","М");
				ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы Тогда
					ЗаписьXML.ЗаписатьАтрибут("ВидЗатрат","С");	
				ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					ЗаписьXML.ЗаписатьАтрибут("ВидЗатрат","О");	
				Иначе
					ЗаписьXML.ЗаписатьАтрибут("ВидЗатрат","ПР");	
				КонецЕсли;
				ЗаписьXML.ЗаписатьАтрибут("ВидРабот","");
				
				
				ЗаписьXML.ЗаписатьНачалоЭлемента("СТОИМОСТЬ");
				
				ЗаписьXML.ЗаписатьНачалоЭлемента("ЕДИНИЦА");
				ЗаписьXML.ЗаписатьАтрибут("ПЗ",Формат(СтрокаРасценки.ПрямЗатраты,"ЧЦ=20; ЧДЦ=2; ЧРД=.; ЧГ=0"));
				ЗаписьXML.ЗаписатьАтрибут("МТ",Формат(СтрокаРасценки.СтоимМатериалов,"ЧЦ=20; ЧДЦ=2; ЧРД=.; ЧГ=0"));
				ЗаписьXML.ЗаписатьАтрибут("ЗП",Формат(СтрокаРасценки.ОснЗарплата,"ЧЦ=20; ЧДЦ=2; ЧРД=.; ЧГ=0"));
				ЗаписьXML.ЗаписатьАтрибут("СР","0.0");
				ЗаписьXML.ЗаписатьАтрибут("ЗМ",Формат(СтрокаРасценки.ЗарплМашинистов,"ЧЦ=20; ЧДЦ=2; ЧРД=.; ЧГ=0"));
				ЗаписьXML.ЗаписатьАтрибут("ЕМ",Формат(СтрокаРасценки.ЭксплМашин,"ЧЦ=20; ЧДЦ=2; ЧРД=.; ЧГ=0"));  
				ЗаписьXML.ЗаписатьАтрибут("МАССА","0.0");
				ЗаписьXML.ЗаписатьАтрибут("МТВ",Формат(СтрокаРасценки.ВозвратМатер,"ЧЦ=20; ЧДЦ=2; ЧРД=.; ЧГ=0"));
				ЗаписьXML.ЗаписатьАтрибут("ОТП",Формат(СтрокаРасценки.Оборудование,"ЧЦ=20; ЧДЦ=2; ЧРД=.; ЧГ=0"));
				ЗаписьXML.ЗаписатьАтрибут("ТР","0.0");
				ЗаписьXML.ЗаписатьАтрибут("ЗГС","0.0");  
				ЗаписьXML.ЗаписатьАтрибут("ЗГСП","0.0");
