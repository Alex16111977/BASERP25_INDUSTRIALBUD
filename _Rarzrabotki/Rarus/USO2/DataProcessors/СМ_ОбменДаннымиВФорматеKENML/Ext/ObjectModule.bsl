// Реверсивная функция заполнения.
Процедура ДокДобавитьСтрокиВДеревоРеверс(Документ, Позиция, СтрокаДерева, Дерево, ТабРазделов, ТабПозиции, ТабРесурсы, ТабДопЗатрат, РеквизитыТаблиц,Параметры, ДокСсылка)
	
	ЮК_ИмяДокумента	= Документ.Метаданные().Имя;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ИДСметы",Позиция);
	МасСтрокПозиций = ТабРазделов.НайтиСтроки(СтруктураОтбора);
	Для Каждого Эл Из масСтрокПозиций Цикл
		
		Если ТипЗнч(Эл.ИДРодителя) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			НайденнаяСтрока = СтрокаДерева.Строки.Найти(Эл.ИДРодителя,"Позиция");	
			Если НайденнаяСтрока <> Неопределено Тогда
				НоваяПодСтрока = НайденнаяСтрока.Строки.Добавить();
			Иначе
				НоваяПодСтрока = СтрокаДерева.Строки.Добавить();
			КонецЕсли;
		Иначе
			НоваяПодСтрока = СтрокаДерева.Строки.Добавить();
		КонецЕсли;
		
		Если Параметры = Неопределено  Тогда
			ЗаполнитьРеквизиты(НоваяПодСтрока, эл, РеквизитыТаблиц, Параметры, "Раздел");
		Иначе
			Если Параметры["ВыводитьЗаголовокСметы"] Тогда
				ЗаполнитьРеквизиты(НоваяПодСтрока, эл, РеквизитыТаблиц, Параметры,"Раздел");
			Иначе
				НоваяПодСтрока 						= СтрокаДерева;
				СтрокаДерева.Ид 					= эл.Ид;
				Параметры["ВыводитьЗаголовокСметы"] = истина;
			КонецЕсли; 
		КонецЕсли;
		
		Если Не Параметры = Неопределено Тогда
			Если Параметры.Свойство("ЗаполнитьАктСметой") Тогда
				Если Параметры.ЗаполнитьАктСметой Тогда
					НоваяПодСтрока.НомерПоСмете = эл.НомерПозиции;
				ИначеЕсли ЮК_ИмяДокумента = "СМ_АктВыполненныхРабот" Тогда
					НоваяПодСтрока.НомерПоСмете = эл.НомерПоСмете;			 
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
		
		//  Добавляем расценки по разделам
		Если ТабПозиции <> неопределено И ТабПозиции.Количество() Тогда
			масСтрокРасценок = ТабПозиции.НайтиСтроки(Новый Структура("ИдРодителя",эл.Ссылка));
			Для каждого элРасценки Из масСтрокРасценок Цикл
				НоваяСтрокаРасценки = НоваяПодСтрока.Строки.Добавить();
				ЗаполнитьРеквизиты(НоваяСтрокаРасценки, элРасценки, РеквизитыТаблиц, Параметры, "Расценка");
				Если Не Параметры = Неопределено Тогда
					Если Параметры.Свойство("ЗаполнитьАктСметой") Тогда
						Если Параметры.ЗаполнитьАктСметой Тогда
							НоваяСтрокаРасценки.НомерПоСмете = элРасценки.НомерПозиции;			 
						ИначеЕсли ЮК_ИмяДокумента="СМ_АктВыполненныхРабот" Тогда
							НоваяСтрокаРасценки.НомерПоСмете = элРасценки.НомерПоСмете;			 
						КонецЕсли; 
					КонецЕсли; 
				КонецЕсли; 
				ДокДобавитьСтрокуРесурсов(НоваяСтрокаРасценки, ТабРесурсы, РеквизитыТаблиц, элРасценки.Позиция,  Параметры) ; 
				ДобавитьСтрокуДопЗатрат(Документ, НоваяСтрокаРасценки,ТабДопЗатрат,РеквизитыТаблиц,Параметры);
			КонецЦикла; 
		КонецЕсли;
		ДобавитьСтрокуДопЗатрат(Документ, НоваяПодСтрока,ТабДопЗатрат,РеквизитыТаблиц,Параметры);
	КонецЦикла; 
			   
КонецПроцедуры

Процедура ДобавитьСтрокуДопЗатрат(Документ, СтрокаДерева,ТабДопЗатрат,РеквизитыТаблиц, Параметры)
	
	ВыводитьДЗ = истина;
	 Если Параметры<> неопределено И Параметры.свойство("ВыводитьДЗ") Тогда
	     ВыводитьДЗ = Параметры["ВыводитьДЗ"];
	 КонецЕсли; ;
	 Если ТабДопЗатрат <> неопределено И ТабДопЗатрат.Количество() И  ВыводитьДЗ  Тогда
		МассивДопЗатрат = ТабДопЗатрат.НайтиСтроки(Новый Структура("ИдРодителя",СтрокаДерева.Ид));
		Для каждого элЗатраты Из МассивДопЗатрат Цикл
			СуммаБазисная = 0;

			Если ТипЗнч(Документ) = Тип("ДокументОбъект.СМ_ЛокальнаяСмета") ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот") Тогда
				НоваяСтрокаЗатраты = СтрокаДерева.Строки.Добавить();
				Если НЕ Параметры.Свойство("Документ") Тогда
					НоваяСтрокаЗатраты.ВсегоНаОбъем = СуммаБазисная;
				КонецЕсли;
			КонецЕсли;
			Если ТипЗнч(Документ) = Тип("ДокументОбъект.СМ_ОбъектнаяСмета") ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.СМ_СводнаяСмета") Тогда
				НоваяСтрокаЗатраты = СтрокаДерева.Строки.Добавить();
				НоваяСтрокаЗатраты.Всего = СуммаБазисная;
			КонецЕсли;
			
			Если НЕ НоваяСтрокаЗатраты = Неопределено Тогда
				// Был последний параметр ПланыВидовХарактеристик.Разделы.ДопЗатрата.
				//	Такого в смете 3 нет. Поставил Неопределено.
				ЗаполнитьРеквизиты(НоваяСтрокаЗатраты, элЗатраты, РеквизитыТаблиц, Параметры, Неопределено);
			КонецЕсли;	
			
		КонецЦикла; 
	 КонецЕсли; 

КонецПроцедуры

Процедура ДокДобавитьСтрокуРесурсов(НоваяСтрокаРасценки, ТабРесурсов,РеквизитыТаблиц, ИдРодителя, Параметры)  
	 
	Если ТабРесурсов <> неопределено И ТабРесурсов.Количество() Тогда
		масСтрокРесурсов = ТабРесурсов.НайтиСтроки(Новый Структура("Объект", ИдРодителя));
		Для каждого элРесурса Из масСтрокРесурсов Цикл
			Если (НЕ элРесурса.ТипМатериала  = Перечисления.СМ_ТипыМатериалов.НеУчтенный ИЛИ элРесурса.ТипМатериала  = Перечисления.СМ_ТипыМатериалов.ПоПроекту) Тогда 
				НоваяСтрокаРесурса = НоваяСтрокаРасценки.Строки.Добавить();
				ЗаполнитьРеквизиты(НоваяСтрокаРесурса, элРесурса, РеквизитыТаблиц, Параметры, "Ресурс");
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры

// Заполняем колонками реквизитами дерева.
//
// Параметры:
// 		НоваяСтрока 	- заполняемая строка дерева значений.
// 		СтрокаТаблицы 	- текущая строка табилцы с данными.
//  	РеквизитыТаблиц - массив с именами реквизитов дерева.
// 		Параметры 		- структура с дополнительными параметрами.
// 		ТипПозиции 		- тип позиции (позиция, ресурс).
//
Процедура ЗаполнитьРеквизиты(НоваяСтрока, СтрокаТаблицы, РеквизитыТаблиц, Параметры, ТипПозиции) 
	
	Если Параметры <> неопределено И (Параметры.Свойство("ЗаполнитьАктСметой") И Параметры["ЗаполнитьАктСметой"]) Тогда
		
		НоваяСтрока.СметнаяСтоимость 	= СтрокаТаблицы.ВсегоНаОбъем;
		НоваяСтрока.ИдСтрокиЛС      	= СтрокаТаблицы.Ид; 
		НоваяСтрока.НомерПоСмете    	= СтрокаТаблицы.НомерПозиции;			
		НоваяСтрока.КодСтроки 			= Параметры.Документ.ИндексПоследнейСтроки + 1;

		Если ТипПозиции = "Ресурс" Тогда
		   НоваяСтрока.СметныйОбъем = СтрокаТаблицы.Количество;
        Иначе
		   НоваяСтрока.СметныйОбъем = СтрокаТаблицы.Объем;
		КонецЕсли; 
		 
		Для Каждого Реквизит Из Параметры["РеквизитыСметыДляАкта"] Цикл
			НоваяСтрока[Реквизит] =  СтрокаТаблицы[Реквизит];
		КонецЦикла;
		
		Параметры.Документ.ИндексПоследнейСтроки = НоваяСтрока.КодСтроки;
		 
	ИначеЕсли Параметры <> неопределено И (Параметры.Свойство("ЗаполнитьМ29Актом") И Параметры["ЗаполнитьМ29Актом"]) Тогда
		
		НоваяСтрока.СметныйОбъем = СтрокаТаблицы.Объем;
		Для Каждого Реквизит Из Параметры["РеквизитыСметыДляАкта"] Цикл
			НоваяСтрока[Реквизит] = СтрокаТаблицы[Реквизит];
		КонецЦикла;

	Иначе
		
		Для каждого Реквизит Из РеквизитыТаблиц Цикл
			Если ТипПозиции = "Ресурс" Тогда
				Если Параметры.Свойство("ПоляРесурсов") И Параметры["ПоляРесурсов"].Найти(Реквизит) <> Неопределено  Тогда
					Если  Реквизит  = "МатериалыНаОбъем"  И (СтрокаТаблицы.ТипМатериала  = Перечисления.СМ_ТипыМатериалов.НеУчтенный ИЛИ СтрокаТаблицы.ТипМатериала  = Перечисления.СМ_ТипыМатериалов.ПоПроекту ) Тогда
						Если Параметры.РасчетДокументаВБазисныхЦенах Тогда
						    НоваяСтрока[Реквизит] =  СтрокаТаблицы["СтоимостьБазис"];
						Иначе	
						    НоваяСтрока[Реквизит] =  СтрокаТаблицы["Стоимость"];
						КонецЕсли; 
					ИначеЕсли Реквизит  = "Объем" Тогда
						НоваяСтрока[Реквизит] =  СтрокаТаблицы["Количество"];
					ИначеЕсли Реквизит  = "СметныйОбъем" Тогда
						НоваяСтрока[Реквизит] =  СтрокаТаблицы["СметноеКоличество"];
					Иначе
						НоваяСтрока[Реквизит] =  СтрокаТаблицы[Реквизит];
					КонецЕсли;
				КонецЕсли; 
			Иначе
				НоваяСтрока[Реквизит] = СтрокаТаблицы[Реквизит];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
   	Если ТипПозиции = "Раздел" Тогда
		НоваяСтрока.Позиция = СтрокаТаблицы.Ссылка;  
	КонецЕсли;

КонецПроцедуры

Функция НайтиРесурсСметы(КодРесурса,Ресурс)
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СМ_АРПС_СоответствияШифров.ШифрАРПС
	               |ИЗ
	               |	РегистрСведений.СМ_АРПС_СоответствияШифров КАК СМ_АРПС_СоответствияШифров
	               |ГДЕ
	               |	СМ_АРПС_СоответствияШифров.СметнаяПрограмма = &СметнаяПрограмма
	               |	И (СМ_АРПС_СоответствияШифров.Ресурс = &Ресурс
	               |			ИЛИ СМ_АРПС_СоответствияШифров.Шифр = &КодРесурса)";
	Запрос.УстановитьПараметр("КодРесурса",КодРесурса);
	Запрос.УстановитьПараметр("Ресурс",Ресурс);
	Запрос.УстановитьПараметр("СметнаяПрограмма",СметнаяПрограмма);
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ШифрАРПС;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииИмпорта

Функция ЗапуститьЗагрузкаKENML(СведенияФайлов,Организация,Район,ТекФорма, ТабДокументов, ТабРазделов, ТабПозиций, ТабКоэффициентов, ТабРесурсов, ТабЛимЗатраты, ТабКомментарии) Экспорт
	СтруктураТекФорма = Новый Структура();
	СтруктураТекФорма.Вставить("АнализФайла",ТекФорма.АнализФайла);
	СтруктураТекФорма.Вставить("СоответствияРесурсов",ТекФорма.СоответствияРесурсов.Выгрузить());
	СтруктураТекФорма.Вставить("СоответствияПрефиксов",ТекФорма.СоответствияПрефиксов.Выгрузить());
	СтруктураТекФорма.Вставить("СоответствияЛЗ",ТекФорма.СоответствияЛЗ.Выгрузить());
	СтруктураТекФорма.Вставить("СметнаяПрограмма",ТекФорма.СметнаяПрограмма);
	СтруктураТекФорма.Вставить("КаталогЗагрузки",ТекФорма.КаталогЗагрузки);
	СтруктураТекФорма.Вставить("ИзФайла",ТекФорма.ИзФайла);
	СтруктураТекФорма.Вставить("Стройка",ТекФорма.Стройка);
	СтруктураТекФорма.Вставить("ОбъектСтроительства",ТекФорма.ОбъектСтроительства);
	СтруктураТекФорма.Вставить("НаименованиеСНБазы",ТекФорма.НаименованиеСНБазы);
	СтруктураТекФорма.Вставить("НомерРегиона",ТекФорма.НомерРегиона);
	СтруктураТекФорма.Вставить("НомерРайона",ТекФорма.НомерРайона);
	СтруктураТекФорма.Вставить("ДатаУровняЦен",ТекФорма.ДатаУровняЦен);
	СтруктураТекФорма.Вставить("ТипНСБазы",ТекФорма.ТипНСБазы);
	СтруктураТекФорма.Вставить("СпособРасчета",ТекФорма.СпособРасчета);
	СтруктураТекФорма.Вставить("СоздаватьНовыеЭлементы",ТекФорма.СоздаватьНовыеЭлементы);
	СтруктураТекФорма.Вставить("СметноНормативнаяБаза",ТекФорма.СметноНормативнаяБаза);
	СтруктураТекФорма.Вставить("ТекСтройка",ТекФорма.ТекСтройка);

                          
	ПараметрыЗадания = Новый Структура();
	ПараметрыЗадания.Вставить("СведенияФайлов",СведенияФайлов);
	ПараметрыЗадания.Вставить("ТекФорма",СтруктураТекФорма);
	ПараметрыЗадания.Вставить("ТабДокументов",ТабДокументов);
	ПараметрыЗадания.Вставить("ТабРазделов",ТабРазделов);
	ПараметрыЗадания.Вставить("ТабПозиций",ТабПозиций);
	ПараметрыЗадания.Вставить("ТабКоэффициентов",ТабКоэффициентов);
	ПараметрыЗадания.Вставить("ТабРесурсов",ТабРесурсов);
	ПараметрыЗадания.Вставить("ТабЛимЗатраты",ТабЛимЗатраты);
	ПараметрыЗадания.Вставить("ТабКомментарии",ТабКомментарии);
	ПараметрыЗадания.Вставить("Организация",Организация);
	ПараметрыЗадания.Вставить("Район",Район);
	
	Для Каждого ТекФайл Из СведенияФайлов Цикл
		Запись = РегистрыСведений.СМ_Файлы.СоздатьМенеджерЗаписи();
		Запись.ИмяФайла = ТекФайл.Загрузка_ПолныйПуть;
		Запись.Файл = Новый ХранилищеЗначения(ПолучитьИЗВременногоХранилища(ТекФайл.Загрузка_АдресВременногоХранилища));
		Запись.Записать();
	КонецЦикла;
	УИН = ТекФорма.УникальныйИдентификатор;
	АдресХранилища = Неопределено;
	Попытка
		ЗагрузитьKENML(ПараметрыЗадания,АдресХранилища,УИН);		
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = НСтр("ru = 'Загрузка KENML'");
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПредставлениеОшибки);
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат АдресХранилища;

КонецФункции

Процедура ЗагрузитьKENML(СтруктураПараметровЗадания,АдресХранилища,УИН) Экспорт
	Перем ДокСсылка;
	Перем СметнаяПрограмма;
	Перем ФорматВыгрузки;
	Перем ТекущаяСмета;
	Перем ТекущийРаздел;
	Перем ТекущаяПозицияЛС;
	Перем ТекКонтрагент;
	Перем Форма;
	Перем ПрефиксыПрограммы;

	Форма = СтруктураПараметровЗадания.ТекФорма;
	ТабДокументов = СтруктураПараметровЗадания.ТабДокументов;
	ТабРазделов = СтруктураПараметровЗадания.ТабРазделов;
	ТабПозиций = СтруктураПараметровЗадания.ТабПозиций;
	ТабКоэффициентов = СтруктураПараметровЗадания.ТабКоэффициентов;
	ТабРесурсов = СтруктураПараметровЗадания.ТабРесурсов;
	ТабЛимЗатраты = СтруктураПараметровЗадания.ТабЛимЗатраты;
	ТабКомментарии = СтруктураПараметровЗадания.ТабКомментарии;
	Организация = СтруктураПараметровЗадания.Организация;
	Район = СтруктураПараметровЗадания.Район;
    СведенияФайлов = СтруктураПараметровЗадания.СведенияФайлов;
	Если Не Форма.АнализФайла Тогда
		Если Форма.СоответствияПрефиксов.Количество()>0 Тогда
			Для Каждого стр Из Форма.СоответствияПрефиксов Цикл
				РС_Шифр = РегистрыСведений.СМ_АРПС_ПрефиксыОбъектов.СоздатьМенеджерЗаписи();
				РС_Шифр.СметнаяПрограмма = стр.СметнаяПрограмма;
				РС_Шифр.СтрокаПрефикса = стр.СтрокаПрефикса;
				РС_Шифр.ТипНормативногоСборника = стр.ТипНормативногоСборника;
				РС_Шифр.Определитель = стр.Определитель;
				РС_Шифр.ВидРесурса = стр.ВидРесурса;
				РС_Шифр.СоздаватьЗаписиВСправочнике = стр.СоздаватьЗаписиВСправочнике;
				РС_Шифр.НеОтбрасыватьПрефикс = стр.НеОтбрасыватьПрефикс;
				РС_Шифр.РедактироваласьПользователем = Истина;
				РС_Шифр.Записать(Ложь);
			КонецЦикла;
		КонецЕсли;
		Если Форма.СоответствияРесурсов.Количество()>0 Тогда
			Для Каждого стр Из Форма.СоответствияРесурсов Цикл
				Если стр.СсылкаВБазе.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				РС_Шифр = РегистрыСведений.СМ_АРПС_СоответствияШифров.СоздатьМенеджерЗаписи();
				РС_Шифр.СметнаяПрограмма = стр.СметнаяПрограмма;
				РС_Шифр.ШифрАРПС = стр.КодРесурса;
				РС_Шифр.Шифр = стр.СсылкаВБазе.Код;
				РС_Шифр.Ресурс = стр.СсылкаВБазе;
				РС_Шифр.РедактироваласьПользователем = Истина;
				РС_Шифр.Записать(Ложь);
			КонецЦикла;
		КонецЕсли;
		Если Форма.СоответствияЛЗ.Количество()>0 Тогда		
			Для Каждого стр Из Форма.СоответствияЛЗ Цикл
				Если стр.НеЯвляетсяЛимЗатратой Тогда
					РС_ЛимЗатрат = РегистрыСведений.СМ_АРПС_Итоги.СоздатьМенеджерЗаписи();
					РС_ЛимЗатрат.НаименованиеЛимзатратыАРПС = стр.НаименованиеЛЗ;
					РС_ЛимЗатрат.РедактироваласьПользователем = Истина;
					РС_ЛимЗатрат.Записать(Ложь);
					Продолжить;
				КонецЕсли;
				Если стр.СсылкаВБазе.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				РС_ЛимЗатрат = РегистрыСведений.СМ_АРПС_СоответствияЛимЗатрат.СоздатьМенеджерЗаписи();
				РС_ЛимЗатрат.СметнаяПрограмма = стр.СметнаяПрограмма;
				РС_ЛимЗатрат.НаименованиеЛимзатратыАРПС = стр.НаименованиеЛЗ;
				РС_ЛимЗатрат.ИдентификаторЛимЗатраты = стр.СсылкаВБазе.Идентификатор;
				РС_ЛимЗатрат.ЛимЗатрата =  стр.СсылкаВБазе;
				РС_ЛимЗатрат.НаименованиеЛимзатраты = стр.СсылкаВБазе.Наименование;
				РС_ЛимЗатрат.РедактироваласьПользователем = Истина;
				РС_ЛимЗатрат.Записать(Ложь);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

    СметнаяПрограмма = Справочники.СМ_СметныеПрограммы.ПустаяСсылка();
	
	//  ******************************************
	
	Если НЕ ЗначениеЗаполнено(Форма.КаталогЗагрузки) Тогда
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Каталог / файл загрузки не указан!'"));
		
		// Запись сообщений в журнал регистрации
		СтруктураСообщения 	= Новый Структура;
		СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
		СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
		СтруктураСообщения.Вставить("Комментарий",НСтр("ru='Каталог / файл загрузки не указан!'"));
		СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
		
		СообщенияДляЖурнала	= Новый СписокЗначений();
		СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	НачатьТранзакцию();
	Если Форма.ИзФайла Тогда
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",СведенияФайлов[0].Загрузка_ПолныйПуть)); 
		Запись.Следующий();
		ДвоичныеДанные = Запись.Файл.Получить();
		ДвоичныеДанные.Записать(ИмяВременногоФайла);

		//  Чтение файла
		Стр 		= "пустая";
		сч=1;
		КодВерхнейСтроки = "";
		ВерхнийРаздел = Неопределено;
		ТекущаяПозицияВладелецЛС = Неопределено;
		
		СтрокаПрограммы = СведенияФайлов[0];
		СметнаяПрограмма = СтрокаПрограммы.Загрузка_СведенияОПрограмме;
		ПрефиксыПрограммы = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксы(СметнаяПрограмма);

		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ИмяВременногоФайла);
		Пока Чтение.Прочитать() Цикл 
			ИмяУзла = Чтение.Имя; 
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
				Если ИмяУзла = "ДОКУМЕНТ" Тогда
					ЗагрузитьЭлементМассива(СтрокаПрограммы,Организация,Район,ТекущаяСмета,ТекущийРаздел,ТекущаяПозицияЛС,ТекКонтрагент,Форма,ПрефиксыПрограммы,СметнаяПрограмма,Чтение,ТабПозиций,ТабДокументов,ТабРазделов,ТабКоэффициентов,ТабРесурсов,ТабКомментарии,ТабЛимЗатраты,КодВерхнейСтроки,ВерхнийРаздел,ТекущаяПозицияВладелецЛС,ТекстОшибки);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если Не Форма.АнализФайла Тогда
			Попытка
				СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(ТекущаяСмета);
				Документы.СМ_ЛокальнаяСмета.Перерасчет(ТекущаяСмета, Ложь);
			Исключение
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), ТекущаяСмета.Номер, ТекущаяСмета.Дата, ТекущаяСмета.Наименование));
				
				// Запись сообщений в журнал регистрации
				СтруктураСообщения 	= Новый Структура;
				СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
				СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
				СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), ТекущаяСмета.Номер, ТекущаяСмета.Дата, ТекущаяСмета.Наименование));
				СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
				
				СообщенияДляЖурнала	= Новый СписокЗначений();
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
				ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
			КонецПопытки;
		КонецЕсли;
	Иначе
	
		Для Каждого ТекФайл Из СведенияФайлов Цикл

			ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
			Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",ТекФайл.Загрузка_ПолныйПуть)); 
			Запись.Следующий();
			ДвоичныеДанные = Запись.Файл.Получить();
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
			
			//  Чтение файла
			Стр = "пустая";
			сч=1;
			КодВерхнейСтроки = "";
			ВерхнийРаздел = Неопределено;
			ТекущаяПозицияВладелецЛС = Неопределено;
			
			СтрокаПрограммы = СведенияФайлов.Найти(ТекФайл.Загрузка_ПолныйПуть,"Загрузка_ПолныйПуть");
			СметнаяПрограмма = СтрокаПрограммы.Загрузка_СведенияОПрограмме;
			ПрефиксыПрограммы = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксы(СметнаяПрограмма);
			
			Чтение = Новый ЧтениеXML;
			Чтение.ОткрытьФайл(ИмяВременногоФайла);
			Пока Чтение.Прочитать() Цикл 
				ИмяУзла = Чтение.Имя; 
				Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
					Если ИмяУзла = "ДОКУМЕНТ" Тогда
						ЗагрузитьЭлементМассива(СтрокаПрограммы,Организация,Район,ТекущаяСмета,ТекущийРаздел,ТекущаяПозицияЛС,ТекКонтрагент,Форма,ПрефиксыПрограммы,СметнаяПрограмма,Чтение,ТабПозиций,ТабДокументов,ТабРазделов,ТабКоэффициентов,ТабРесурсов,ТабКомментарии,ТабЛимЗатраты,КодВерхнейСтроки,ВерхнийРаздел,ТекущаяПозицияВладелецЛС,ТекстОшибки);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Если Не Форма.АнализФайла Тогда
				Попытка
					СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(ТекущаяСмета);
					Документы.СМ_ЛокальнаяСмета.Перерасчет(ТекущаяСмета, Ложь);
				Исключение
					//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), Форма.ТекущаяСмета.Номер, Форма.ТекущаяСмета.Дата, Форма.ТекущаяСмета.Наименование));
					
					// Запись сообщений в журнал регистрации
					СтруктураСообщения 	= Новый Структура;
					СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
					СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
					СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), Форма.ТекущаяСмета.Номер, Форма.ТекущаяСмета.Дата, Форма.ТекущаяСмета.Наименование));
					СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
					
					СообщенияДляЖурнала	= Новый СписокЗначений();
					СообщенияДляЖурнала.Добавить(СтруктураСообщения);
					ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТекстОшибки = "" Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		Для Каждого ТекСтрока Из СведенияФайлов Цикл
			ТекСтрока.Загрузка_СозданныйДокумент = "";
		КонецЦикла;
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		// Запись сообщений в журнал регистрации
		СтруктураСообщения 	= Новый Структура;
		СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
		СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
		СтруктураСообщения.Вставить("Комментарий",ТекстОшибки);
		СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
		
		СообщенияДляЖурнала	= Новый СписокЗначений();
		СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		
		ОтменитьТранзакцию();
	КонецЕсли;
		
	СтруктураПараметровЗадания.ТекФорма = Форма;
	СтруктураПараметровЗадания.ТабДокументов = ТабДокументов;
	СтруктураПараметровЗадания.ТабРазделов = ТабРазделов;
	СтруктураПараметровЗадания.ТабПозиций = ТабПозиций;
	СтруктураПараметровЗадания.ТабКоэффициентов = ТабКоэффициентов;
	СтруктураПараметровЗадания.ТабРесурсов = ТабРесурсов;
	СтруктураПараметровЗадания.ТабЛимЗатраты = ТабЛимЗатраты;
	СтруктураПараметровЗадания.ТабКомментарии = ТабКомментарии;
	СтруктураПараметровЗадания.СведенияФайлов = СведенияФайлов;
	АдресХранилища = ПоместитьВоВременноеХранилище(СтруктураПараметровЗадания, УИН); 
	
КонецПроцедуры

Процедура ЗагрузитьЭлементМассива(СтрокаПрограммы,Организация,Район,ТекущаяСмета,ТекущийРаздел,ТекущаяПозицияЛС,ТекКонтрагент,Форма,ПрефиксыПрограммы,СметнаяПрограмма,Чтение,ТабПозиций,ТабДокументов,ТабРазделов,ТабКоэффициентов,ТабРесурсов,ТабКомментарии,ТабЛимЗатраты,КодВерхнейСтроки,ВерхнийРаздел,ТекущаяПозицияВладелецЛС,ТекстОшибки)
	Комментарий = "";
	
	СтруктураРеквизитовСмета = Новый Структура;
	
	СтрокаСметы = Неопределено;
	СтрокаРаздела = Неопределено;
	СтрокаПозиции = Неопределено;
	СтрокаРесурса = Неопределено;
	
	НоваяСтрока = ТабДокументов.Добавить();
	СтрокаСметы = НоваяСтрока; 
	Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
		
		ТипУзла 		= Чтение.ТипУзла; 
		ИмяПараметра 	= Чтение.Имя; 
		Значение 		= Чтение.Значение; 
		
		Если ИмяПараметра = "ВерсияФормата" Тогда
			Формат = Значение;
		ИначеЕсли Врег(ИмяПараметра) = "ГЕНЕРАТОР" Тогда
			НаименованиеПрограммыИсточника = Значение; 
		ИначеЕсли ИмяПараметра = "НаименованиеСтройки" Тогда
			НаименованиеСтройки = Значение;
			Форма.Стройка 	= НаименованиеСтройки;
		ИначеЕсли ИмяПараметра = "ШифрСтройки" Тогда
			КодСтройки = Значение;
		ИначеЕсли ИмяПараметра = "НаименованиеОбъекта" Тогда
			НаименованиеОбъекта = Значение;
			Форма.ОбъектСтроительства 	= НаименованиеОбъекта;
		ИначеЕсли ИмяПараметра = "ШифрОбъекта" Тогда
			КодОбъекта = Значение;
		ИначеЕсли ИмяПараметра = "ШифрСметы" Тогда
			НоваяСтрока.НомерДокумента = Значение;
		ИначеЕсли ИмяПараметра = "НаименованиеДок" Тогда
			НоваяСтрока.НаименованиеДокумента = Значение;
		ИначеЕсли ИмяПараметра = "Глава" Тогда
			Глава = Значение;
		ИначеЕсли ИмяПараметра = "НомерРегиона" Тогда
			Форма.НомерРегиона = Значение;
		ИначеЕсли ИмяПараметра = "НомерРайона" Тогда
			Форма.НомерРайона = Значение;
		ИначеЕсли ИмяПараметра = "ВерсияСНБ" Тогда
			Форма.НаименованиеСНБазы = Значение;
		ИначеЕсли ИмяПараметра = "Версия" Тогда
			Версия = Значение;
		ИначеЕсли ИмяПараметра = "Дата" Тогда
			Дата = Значение;
		ИначеЕсли ИмяПараметра = "Время" Тогда
			Время = Значение;
		ИначеЕсли ИмяПараметра = "ПоказательНК2" Тогда
			СтруктураРеквизитовСмета.Вставить("ПоказательНК2",Значение);
		ИначеЕсли ИмяПараметра = "ПоказательСП" Тогда
			СтруктураРеквизитовСмета.Вставить("ПоказательСП",Значение);
		ИначеЕсли ИмяПараметра = "УровеньЦен" Тогда
			СтруктураРеквизитовСмета.Вставить("УровеньЦен",Значение);
		КонецЕсли;
		
		
	КонецЦикла;
	
	Если НЕ Форма.АнализФайла Тогда
		
		Если Не ПустаяСтрока(Форма.НомерРегиона) Тогда
			
			КодРегиона = Число(Форма.НомерРегиона);
			КодРегиона = Формат(КодРегиона,"ЧЦ=4; ЧДЦ=2; ЧРД=.; ЧВН=");
			ПоискРайон = Справочники.СМ_ТерриториальныеРайоны.НайтиПоКоду(КодРегиона);
			Если Не ПоискРайон.Пустая() Тогда
				Район = ПоискРайон;
			КонецЕсли;
			
		КонецЕсли;
		
		ТекущаяСмета = ПолучитьСоздатьДокументЛС(Организация,Район,Форма,НоваяСтрока,СтруктураРеквизитовСмета);
		Если Не ЗначениеЗаполнено(СтрокаПрограммы.Загрузка_СозданныйДокумент) Тогда
			СтрокаПрограммы.Загрузка_СозданныйДокумент = ТекущаяСмета;
		КонецЕсли;
	КонецЕсли;

	НомерРаздела = 0;
	сч = 0;
	ОсновнойРаздел = Неопределено;
	Пока Чтение.Прочитать() Цикл 
		
		ИмяУзла = Чтение.Имя; 
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			
			Если ИмяУзла = "СТРУКТУРА" Тогда
				ВерхнийРаздел = ТекущаяСмета;
			ИначеЕсли ИмяУзла = "РАЗДЕЛ" Тогда
				ЭтоПодраздел = Ложь;
				НомерРаздела = НомерРаздела + 1;
				НоваяСтрока = ТабРазделов.Добавить();
				СтрокаРаздела = НоваяСтрока;
				НоваяСтрока.НомерРаздела = НомерРаздела;
				НоваяСтрока.ИдРаздела = НомерРаздела;
				
				
				Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл
					
					ТипУзла 		= Чтение.ТипУзла; 
					ИмяПараметра 	= Чтение.Имя; 
					Значение 		= Чтение.Значение; 
					
					Если ИмяПараметра = "ID" Тогда
						НоваяСтрока.НомерРаздела = ?(ПустаяСтрока(Значение),НоваяСтрока.НомерРаздела,Значение);
					ИначеЕсли ИмяПараметра = "Наименование" Тогда
						НоваяСтрока.НаименованиеРаздела = Значение;
					ИначеЕсли ИмяПараметра = "Тип" Тогда
						ЭтоПодраздел = Значение = "4";
					КонецЕсли;
						
				КонецЦикла;
				
				Если НЕ Форма.АнализФайла Тогда
					ТекущийРаздел = ПолучитьСоздатьДокументРаздел(ТекущаяСмета,НоваяСтрока.НомерРаздела,НоваяСтрока.НаименованиеРаздела,?(ЭтоПодраздел,ВерхнийРаздел,Неопределено));
					
					Если ОсновнойРаздел = Неопределено Тогда
						ОсновнойРаздел = ТекущийРаздел;
					КонецЕсли;

					НоваяСтрока.Ссылка = ТекущийРаздел;
					ВерхнийРаздел = ТекущийРаздел; 
				КонецЕсли;

			ИначеЕсли ИмяУзла = "ПОЗИЦИЯ" Тогда
				
				НоваяСтрока = ТабПозиций.Добавить();
				СтрокаПозиции = НоваяСтрока;
				НоваяСтрока.ПризнакПодчиненности = Ложь;
				КодЛокальный = "";
				Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл
					
					ТипУзла 		= Чтение.ТипУзла; 
					ИмяПараметра 	= Чтение.Имя; 
					Значение 		= Чтение.Значение; 
					
					Если ИмяПараметра = "ID" Тогда
						НоваяСтрока.НомерПозицииВСмете = Значение;
					ИначеЕсли ИмяПараметра = "Наименование" Тогда
						НоваяСтрока.НаименованиеПозиции = Значение;
					ИначеЕсли ИмяПараметра = "КодСНБ" Тогда
						НоваяСтрока.ШифрПозиции = Значение;
					ИначеЕсли ИмяПараметра = "Объем" Тогда
						НоваяСтрока.ОбъемРабот = Значение;
					ИначеЕсли ИмяПараметра = "Измеритель" Тогда
						НоваяСтрока.ЕдиницаИзмерения = Значение;
					ИначеЕсли ИмяПараметра = "Тип" Тогда
						НоваяСтрока.ТипПозиции = Значение;
					ИначеЕсли ИмяПараметра = "ВидЗатрат" Тогда
						НоваяСтрока.ВидЗатрат = Значение;
					ИначеЕсли ИмяПараметра = "НК1" Тогда
						НоваяСтрока.НК1 = Значение;
					ИначеЕсли ИмяПараметра = "КодЛокальный" Тогда
						КодЛокальный = Значение;
					КонецЕсли;
					
				КонецЦикла;
				
				Если Не ЗначениеЗаполнено(НоваяСтрока.ШифрПозиции) И Не ПустаяСтрока(КодЛокальный) Тогда
					НоваяСтрока.ШифрПозиции = КодЛокальный;
				КонецЕсли;

			ИначеЕсли ИмяУзла = "СТОИМОСТЬ" Тогда
				
				ЗаполнитьСтоимостьПозиции(Чтение,СтрокаПозиции);
				
				Определитель = Неопределено;
				ТСН = Неопределено; 
				НужнаяСтрока = Неопределено;
				Если ПрефиксыПрограммы<>Неопределено И ПрефиксыПрограммы.Количество()>0 Тогда
					НужнаяСтрока = СМ_АРПС_ОбменВызовСервера.НайтиСтрокуПоПрефиксу(СтрокаПозиции.ШифрПозиции,ПрефиксыПрограммы);
					Если НЕ НужнаяСтрока = Неопределено Тогда
						СтрокаПозиции.ШифрПозиции = ?(НужнаяСтрока.НеОтбрасыватьПрефикс,СтрокаПозиции.ШифрПозиции,НужнаяСтрока.ШифрБезПрефикса);
						Определитель = НужнаяСтрока.Определитель;
						ТНС = НужнаяСтрока.ТНС; 
					КонецЕсли;
				КонецЕсли;
				
				Если НЕ Форма.АнализФайла Тогда
					ТекущаяПозицияЛС = ПолучитьСоздатьДокументПозицияЛС(ТекущаяПозицияВладелецЛС,ТекущаяСмета,ТекущийРаздел,Форма,СтрокаПозиции,Определитель,ТНС,СметнаяПрограмма);
				Иначе
					Если НужнаяСтрока = Неопределено Тогда
						АнализДокументПозицияЛС(СтрокаПрограммы,Форма,СтрокаПозиции,Определитель,ТНС);
					КонецЕсли;
				КонецЕсли;

			ИначеЕсли ИмяУзла = "РЕСУРС" Тогда
				
				НоваяСтрока = ТабРесурсов.Добавить();
				СтрокаРесурса = НоваяСтрока;
				Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл
					
					ТипУзла 		= Чтение.ТипУзла; 
					ИмяПараметра 	= Чтение.Имя; 
					Значение 		= Чтение.Значение; 
					КодЛокальный = "";
					Если ИмяПараметра = "ID" Тогда
						НоваяСтрока.ДопКодРесурса = СтрокаПозиции.НомерПозицииВСмете+"-"+Значение;
					ИначеЕсли ИмяПараметра = "Наименование" Тогда
						НоваяСтрока.Наименование = Значение;
					ИначеЕсли ИмяПараметра = "КодСНБ" Тогда
						НоваяСтрока.КодРесурса = Значение;
					ИначеЕсли ИмяПараметра = "Тип" Тогда
						НоваяСтрока.ПризнакТипа = Значение;
					ИначеЕсли ИмяПараметра = "Цена" Тогда
						НоваяСтрока.ЦенаЕдиницыТекущая = Значение;
					ИначеЕсли ИмяПараметра = "Измеритель" Тогда
						НоваяСтрока.ЕдиницаИзмерения = Значение;
					ИначеЕсли ИмяПараметра = "Норма" Тогда
						НоваяСтрока.НормаРасхода = Значение;
					ИначеЕсли ИмяПараметра = "Статус" Тогда
						НоваяСтрока.Статус = Значение;
					ИначеЕсли ИмяПараметра = "ЗМ" Тогда
						НоваяСтрока.ЗПМашинистовТекущая = Значение;
					ИначеЕсли ИмяПараметра = "КодЛокальный" Тогда
						КодЛокальный = Значение;
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(НоваяСтрока.КодРесурса) И Не ПустаяСтрока(КодЛокальный) Тогда
						НоваяСтрока.КодРесурса = КодЛокальный;
					КонецЕсли;

				КонецЦикла;
				
				
				
				ВидРесурса = Неопределено; 
				РесурсРС = Неопределено;
				НужнаяСтрока = Неопределено;
				Если ПрефиксыПрограммы<>Неопределено И ПрефиксыПрограммы.Количество()>0 Тогда
					НужнаяСтрока = СМ_АРПС_ОбменВызовСервера.НайтиСтрокуПоПрефиксу(НоваяСтрока.КодРесурса,ПрефиксыПрограммы);
					Если НЕ НужнаяСтрока = Неопределено Тогда
						НоваяСтрока.КодРесурса = ?(НужнаяСтрока.НеОтбрасыватьПрефикс,НоваяСтрока.КодРесурса,НужнаяСтрока.ШифрБезПрефикса);
						ВидРесурса = ?(ЗначениеЗаполнено(НужнаяСтрока.ВидРесурса),НужнаяСтрока.ВидРесурса,Неопределено);
						РесурсРС = СМ_АРПС_ОбменВызовСервера.НайтиРесурсАРПС(СметнаяПрограмма,НоваяСтрока);
					КонецЕсли;
				КонецЕсли;
				
				ПолучитьСоздатьРесурс(НужнаяСтрока,СтрокаПрограммы,ТекущаяПозицияЛС,Форма,НоваяСтрока,ВидРесурса,РесурсРС,ТекстОшибки);

			ИначеЕсли ИмяУзла = "КОЭФФИЦИЕНТ" Тогда
				
				НоваяСтрока = ТабКоэффициентов.Добавить();
				НоваяСтрока.НомерПозицииВСмете = СтрокаПозиции.НомерПозицииВСмете;
				Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл
					
					ТипУзла 		= Чтение.ТипУзла; 
					ИмяПараметра 	= Чтение.Имя; 
					Значение 		= Чтение.Значение; 
					
					Если ИмяПараметра = "Наименование" Тогда
						НоваяСтрока.НаименованиеКоэффициента = Значение;
					ИначеЕсли ИмяПараметра = "Тип" Тогда
						НоваяСтрока.ТипПоправки = Значение;
					ИначеЕсли ИмяПараметра = "СписокПозиций" Тогда
						НоваяСтрока.СписокПозиций = Значение;
					ИначеЕсли ИмяПараметра = "Ссылка" Тогда
						НоваяСтрока.ОснованиеКоэффициента = Значение;
					ИначеЕсли ИмяПараметра = "Ктруд" Тогда
						НоваяСтрока.Ктруд = Значение;
					ИначеЕсли ИмяПараметра = "Кзп" Тогда
						НоваяСтрока.Кзп = Значение;
					ИначеЕсли ИмяПараметра = "Кмаш" Тогда
						НоваяСтрока.Кмаш = Значение;
					ИначеЕсли ИмяПараметра = "Ктрудмаш" Тогда
						НоваяСтрока.Ктрудмаш = Значение;
					ИначеЕсли ИмяПараметра = "Кзпмашин" Тогда
						НоваяСтрока.Кзпмашин = Значение;
					ИначеЕсли ИмяПараметра = "Кматериалов" Тогда
						НоваяСтрока.Кматериалов = Значение;
					ИначеЕсли ИмяПараметра = "Кстмт" Тогда
						НоваяСтрока.Кстмт = Значение;
					ИначеЕсли ИмяПараметра = "Ктрпрц" Тогда
						НоваяСтрока.Ктрпрц = Значение;
					ИначеЕсли ИмяПараметра = "Кзгспрц" Тогда
						НоваяСтрока.Кзгспрц = Значение;
					ИначеЕсли ИмяПараметра = "КНК1" Тогда
						НоваяСтрока.КНК1 = Значение;
					ИначеЕсли ИмяПараметра = "КНК2" Тогда
						НоваяСтрока.КНК2 = Значение;
					ИначеЕсли ИмяПараметра = "КСП" Тогда
						НоваяСтрока.КСП = Значение;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда 
			
			Если ИмяУзла = "РАЗДЕЛ" Тогда
				Если НомерРаздела>1 Тогда
					
					сч=сч+1;
					ТекНомер = НомерРаздела-сч;
					Если ТекНомер = 1 Тогда
						ВерхнийРаздел = ОсновнойРаздел;
						ТекущийРаздел = ОсновнойРаздел;
					Иначе
						СтрокаРаздела = ТабРазделов.Найти(ТекНомер,"ИдРаздела");
						Если Не СтрокаРаздела = Неопределено Тогда
							ВерхнийРаздел = СтрокаРаздела.Ссылка;
							ТекущийРаздел = ВерхнийРаздел;
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли  НомерРаздела = 1 И ЭтоПодраздел Тогда
					
					сч=сч+1;
					ТекНомер = НомерРаздела-сч;
					Если ТекНомер = 1 Тогда
						ВерхнийРаздел = ОсновнойРаздел;
						ТекущийРаздел = ОсновнойРаздел;
					Иначе
						СтрокаРаздела = ТабРазделов.Найти(ТекНомер,"ИдРаздела");
						Если Не СтрокаРаздела = Неопределено Тогда
							ВерхнийРаздел = СтрокаРаздела.Ссылка;
							ТекущийРаздел = ВерхнийРаздел;
						КонецЕсли;
					КонецЕсли;

				КонецЕсли;
			ИначеЕсли ИмяУзла = "ПОЗИЦИЯ" Тогда 
				
				Если НЕ Форма.АнализФайла Тогда
					ОбработатьПозицию(СтрокаПозиции,ТекущаяПозицияЛС,ТабКоэффициентов);
				КонецЕсли;

			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;


КонецПроцедуры

Процедура ЗаполнитьСтоимостьПозиции(Чтение,НоваяСтрока)
	Пока Чтение.Прочитать() Цикл 
		
		ИмяУзла = Чтение.Имя; 
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Если ИмяУзла = "ЕДИНИЦА" Тогда
				
				Если Чтение.КоличествоАтрибутов()>0 Тогда
					
					Пока Чтение.ПрочитатьАтрибут() Цикл
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "ПЗ" Тогда
							НоваяСтрока.ПрямыеЗатраты = Значение;
						ИначеЕсли ИмяПараметра = "МТ" Тогда
							НоваяСтрока.СтоимостьМатериалов = Значение;
						ИначеЕсли ИмяПараметра = "ЗП" Тогда
							НоваяСтрока.ОсновнаяЗП = Значение;
						ИначеЕсли ИмяПараметра = "Цена" Тогда
							НоваяСтрока.ПрямыеЗатраты = Значение;
						ИначеЕсли ИмяПараметра = "ЗМ" Тогда
							НоваяСтрока.ЗарплатаМашинистов = Значение;
						ИначеЕсли ИмяПараметра = "ЕМ" Тогда
							НоваяСтрока.ЭксплМашин = Значение;
						ИначеЕсли ИмяПараметра = "МТВ" Тогда
							НоваяСтрока.ВозвратМатериалов = Значение;
						ИначеЕсли ИмяПараметра = "ОТП" Тогда
							НоваяСтрока.Оборудование = Значение;
						КонецЕсли;
						
					КонецЦикла;
					
				Иначе
					
					Пока Чтение.Прочитать() Цикл
						
						ТипУзла 		= Чтение.ТипУзла; 
						Если ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
							ИмяПараметра 	= Чтение.Имя; 
							Продолжить;
						ИначеЕсли ТипУзла = ТипУзлаXML.Текст Тогда
							Значение 		= Чтение.Значение;
						ИначеЕсли ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
							Если Чтение.Имя = "ЕДИНИЦА" Тогда
								Прервать;
							Иначе
								Продолжить;
							КонецЕсли;
						КонецЕсли;
						
						Если ИмяПараметра = "ПЗ" Тогда
							НоваяСтрока.ПрямыеЗатраты = Значение;
						ИначеЕсли ИмяПараметра = "МТ" Тогда
							НоваяСтрока.СтоимостьМатериалов = Значение;
						ИначеЕсли ИмяПараметра = "ЗП" Тогда
							НоваяСтрока.ОсновнаяЗП = Значение;
						ИначеЕсли ИмяПараметра = "Цена" Тогда
							НоваяСтрока.ПрямыеЗатраты = Значение;
						ИначеЕсли ИмяПараметра = "ЗМ" Тогда
							НоваяСтрока.ЗарплатаМашинистов = Значение;
						ИначеЕсли ИмяПараметра = "ЕМ" Тогда
							НоваяСтрока.ЭксплМашин = Значение;
						ИначеЕсли ИмяПараметра = "МТВ" Тогда
							НоваяСтрока.ВозвратМатериалов = Значение;
						ИначеЕсли ИмяПараметра = "ОТП" Тогда
							НоваяСтрока.Оборудование = Значение;
							//ИначеЕсли ИмяПараметра = "ТР" Тогда
							//	НоваяСтрока.КодРесурса = Значение;
							//ИначеЕсли ИмяПараметра = "ЗГС" Тогда
							//	НоваяСтрока.Наименование = Значение;
							//ИначеЕсли ИмяПараметра = "ЗГСП" Тогда
							//	НоваяСтрока.КодРесурса = Значение;
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;
				
				// ИначеЕсли ИмяУзла = "ВСЕГО" Тогда
				//	
				//	Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл
				//		
				//		ТипУзла 		= Чтение.ТипУзла; 
				//		ИмяПараметра 	= Чтение.Имя; 
				//		Значение 		= Чтение.Значение; 
				//		
				//		
				//		Если ИмяПараметра = "ПЗ" Тогда
				//			НоваяСтрока.ДопКодРесурса = СтрокаПозиции.НомерПозицииВСмете+"-"+Значение;
				//		ИначеЕсли ИмяПараметра = "МТ" Тогда
				//			НоваяСтрока.Наименование = Значение;
				//		ИначеЕсли ИмяПараметра = "ЗП" Тогда
				//			НоваяСтрока.КодРесурса = Значение;
				//		ИначеЕсли ИмяПараметра = "СР" Тогда
				//			НоваяСтрока.Наименование = Значение;
				//		ИначеЕсли ИмяПараметра = "ЗМ" Тогда
				//			НоваяСтрока.КодРесурса = Значение;
				//		ИначеЕсли ИмяПараметра = "ЕМ" Тогда
				//			НоваяСтрока.КодРесурса = Значение;
				//		ИначеЕсли ИмяПараметра = "МТВ" Тогда
				//			НоваяСтрока.Наименование = Значение;
				//		ИначеЕсли ИмяПараметра = "ОБ" Тогда
				//			НоваяСтрока.КодРесурса = Значение;
				//		ИначеЕсли ИмяПараметра = "ТР" Тогда
				//			НоваяСтрока.КодРесурса = Значение;
				//		ИначеЕсли ИмяПараметра = "НК1" Тогда
				//			НоваяСтрока.Наименование = Значение;
				//		ИначеЕсли ИмяПараметра = "НК2" Тогда
				//			НоваяСтрока.КодРесурса = Значение;
				//		ИначеЕсли ИмяПараметра = "СП" Тогда
				//			НоваяСтрока.КодРесурса = Значение;
				//		КонецЕсли;
				//		
				//	КонецЦикла;
				//	
				// КонецЕсли;
				//
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			Если ИмяУзла = "СТОИМОСТЬ" Тогда
				Прервать;
			КонецЕсли;
			
			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПолучитьСоздатьРесурс(НужнаяСтрока,СтрокаПрограммы,ТекущаяПозицияЛС,Форма,ТекСтрока,ВидРесурса,РесурсРС,ТекстОшибки)
	НоваяСтрокаПрефикс = Неопределено;
	СоздаватьРесурсы = Ложь;
	Если НужнаяСтрока <> Неопределено И НужнаяСтрока.СоздаватьЗаписиВСправочнике Тогда
		СоздаватьРесурсы = Истина;
	КонецЕсли;
	Если РесурсРС = Неопределено Тогда
		Если НужнаяСтрока = Неопределено Тогда
			Префикс = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксИзСтроки(ТекСтрока.КодРесурса);
			Если ЗначениеЗаполнено(Префикс) Тогда
				НоваяСтрокаПрефикс = Форма.СоответствияПрефиксов.Найти(Префикс,"СтрокаПрефикса");
				Если НоваяСтрокаПрефикс = Неопределено Тогда
					НоваяСтрокаПрефикс	= Форма.СоответствияПрефиксов.Добавить();
					НоваяСтрокаПрефикс.СтрокаПрефикса = Префикс;
				КонецЕсли;
				НоваяСтрокаПрефикс.СметнаяПрограмма = СтрокаПрограммы.Загрузка_СведенияОПрограмме;
			КонецЕсли;
		КонецЕсли;
		ТекРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду(ТекСтрока.КодРесурса);	
	Иначе
		ТекРесурс = РесурсРС;
	КонецЕсли;
	Каталог = Справочники.СМ_Ресурсы[Форма.СметноНормативнаяБаза.ГруппаРесурсов.ИмяПредопределенныхДанных];
	Если ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
		МассивРодителей = Новый СписокЗначений;   			
		СМ_СметаЗагрузкаВызовСервера.ПолучитьВсехРодителей(Каталог,МассивРодителей);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Ресурсы.Ссылка
		|ИЗ
		|	Справочник.СМ_Ресурсы КАК Ресурсы
		|ГДЕ
		|	Ресурсы.Ссылка В (&Каталог)
		|	И Ресурсы.Код = &КодРесурса
		|	И Ресурсы.ЭтоГруппа = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("КодРесурса", ТекСтрока.КодРесурса);
		Запрос.УстановитьПараметр("Каталог", МассивРодителей);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ТекРесурс = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Если Не Форма.АнализФайла И СоздаватьРесурсы И Форма.СоздаватьНовыеЭлементы И ТекРесурс.Пустая() Тогда
		Если СМ_СметаВызовСервера.НедоступнаРаботаСПрайсами() Тогда
			ТекстОшибки = ТекстОшибки + "Не найден ресурс: " + ТекСтрока.Наименование + ". Загрузка отменена." + Символы.ПС;
			Возврат;
		КонецЕсли;
		ТекРесурсОб = Справочники.СМ_Ресурсы.СоздатьЭлемент();
		Если ТекСтрока.ПризнакТипа = "0" Тогда
			ТекРесурсОб.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;		
		ИначеЕсли ТекСтрока.ПризнакТипа = "1" Тогда
			ТекРесурсОб.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
		ИначеЕсли ТекСтрока.ПризнакТипа = "2" Тогда
			ТекРесурсОб.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
		ИначеЕсли ТекСтрока.ПризнакТипа = "3" Тогда
			ТекРесурсОб.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов;
		КонецЕсли;	
		Если НЕ ВидРесурса = Неопределено Тогда
			ТекРесурсОб.ВидРесурса = ВидРесурса;
		КонецЕсли;
		ТекРесурсОб.Код = ТекСтрока.КодРесурса;
		ТекРесурсОб.Наименование = ТекСтрока.Наименование;
		ТекРесурсОб.ДлинноеНаименование = ТекСтрока.Наименование;
		ТекРесурсОб.Родитель = СМ_СметаЗагрузкаВызовСервера.СоздатьПолучитьПапкуРесурсов(""+ТекРесурсОб.ВидРесурса,Каталог);
		ТекРесурсОб.ЕдиницаИзмерения = НайтиЕдиницуИзмеренияСметномуКоду(ТекСтрока.ЕдиницаИзмерения);
		ТекРесурсОб.ГодВыпуска = ?(ЗначениеЗаполнено(Форма.СметноНормативнаяБаза.ГодВыпуска),Форма.СметноНормативнаяБаза.ГодВыпуска,Перечисления.СМ_ГодыВыпускаБазы.г2009);
		ТекРесурсОб.Записать();
		ТекРесурс = ТекРесурсОб.Ссылка;
	КонецЕсли;
	Если Форма.АнализФайла Тогда
		Если ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() И СоздаватьРесурсы Тогда
			НоваяСтрока 					= Форма.СоответствияРесурсов.Добавить();
			НоваяСтрока.НаименованиеРесурса = ТекСтрока.Наименование;
			НоваяСтрока.КодРесурса          = ТекСтрока.КодРесурса;
			НоваяСтрока.СметнаяПрограмма 	= СтрокаПрограммы.Загрузка_СведенияОПрограмме;
			
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ресурс не найден в справочнике: %1, %2'"), ТекСтрока.КодРесурса, ТекСтрока.Наименование));
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ресурс не найден в справочнике: %1, %2'"), ТекСтрока.КодРесурса, ТекСтрока.Наименование));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		КонецЕсли;
	Иначе	
		Если ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() И СоздаватьРесурсы Тогда
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("НаименованиеРесурса",ТекСтрока.Наименование);
	    	МассивСтрок = Форма.СоответствияРесурсов.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 Тогда
				ТекРесурс = МассивСтрок[0].СсылкаВБазе;
			Иначе
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ресурс: %1, %2 - не задано соответствие в таблице'"), ТекСтрока.КодРесурса, ТекСтрока.Наименование));	
				
				// Запись сообщений в журнал регистрации
				СтруктураСообщения 	= Новый Структура;
				СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
				СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
				СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ресурс: %1, %2 - не задано соответствие в таблице'"), ТекСтрока.КодРесурса, ТекСтрока.Наименование));
				СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
				
				СообщенияДляЖурнала	= Новый СписокЗначений();
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
				ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		//  Создаем новую строку ресурса в ТЧ
		ТекОбъект 						= ТекущаяПозицияЛС.ПолучитьОбъект();
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("СметныйКодРесурса", ?(ЗначениеЗаполнено(ТекРесурс),ТекРесурс.Код,ТекСтрока.КодРесурса));
		ПараметрыОтбора.Вставить("ЕдиницаИзмеренияРесурса", ТекСтрока.ЕдиницаИзмерения);
		ПараметрыОтбора.Вставить("НаименованиеРесурса", ?(ЗначениеЗаполнено(ТекРесурс),ТекРесурс.Наименование,ТекСтрока.Наименование));

		НайденныеСтроки = ТекОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()=0 Тогда
			НоваяСтрока 					= ТекОбъект.РесурсыПозицииЛокальнойСметы.Добавить();
			НоваяСтрока.Ресурс              = ТекРесурс.Ссылка;
			НоваяСтрока.СметныйКодРесурса	= ?(ЗначениеЗаполнено(НоваяСтрока.Ресурс),ТекРесурс.Код,ТекСтрока.КодРесурса);
			НоваяСтрока.НаименованиеРесурса = ?(ЗначениеЗаполнено(ТекРесурс),ТекРесурс.Наименование,ТекСтрока.Наименование);
			НоваяСтрока.ЕдиницаИзмеренияРесурса = ТекСтрока.ЕдиницаИзмерения;
			
			
			Если ТекСтрока.ПризнакТипа = "1" Тогда
				НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;		
			ИначеЕсли ТекСтрока.ПризнакТипа = "2" Тогда
				НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
			ИначеЕсли ТекСтрока.ПризнакТипа = "3" Тогда
				НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
			ИначеЕсли ТекСтрока.ПризнакТипа = "4" ИЛИ ТекСтрока.ПризнакТипа = "5" Тогда
				НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование;
			КонецЕсли;	
			Если НЕ ВидРесурса = Неопределено Тогда
				НоваяСтрока.ВидРесурса = ВидРесурса;
			КонецЕсли;
			
			НоваяСтрока.ВидРесурса = ?(ЗначениеЗаполнено(ТекРесурс),ТекРесурс.ВидРесурса,НоваяСтрока.ВидРесурса);
			
			НоваяСтрока.НормаРасхода                    = ТекСтрока.НормаРасхода;
			НоваяСтрока.БазиснаяЦена                    = ТекСтрока.ЦенаЕдиницыБазовая;
			НоваяСтрока.БазиснаяЗарплатаМашинистов	  	= ТекСтрока.ЗПМашинистовБазовая;
			НоваяСтрока.ТекущаяЦена                     = ТекСтрока.ЦенаЕдиницыТекущая;
			Если НоваяСтрока.ТекущаяЦена = 0 Тогда
				НоваяСтрока.ТекущаяЦена                     = ТекСтрока.ЦенаЕдиницыФактическая;
			КонецЕсли;
			НоваяСтрока.ТекущаяЗарплатаМашинистов       = ТекСтрока.ЗПМашинистовТекущая;
			НоваяСтрока.ТипМатериала                  	= Перечисления.СМ_ТипыМатериалов.Учтенный;
		Иначе
			НоваяСтрока 					            = НайденныеСтроки[0];
			НоваяСтрока.НормаРасхода                    = НоваяСтрока.НормаРасхода+ТекСтрока.НормаРасхода;
		КонецЕсли;

		ТекОбъект.Записать();
		
	КонецЕсли;
	Если Не НоваяСтрокаПрефикс = Неопределено Тогда 
		НоваяСтрокаПрефикс.ВидРесурса = ВидРесурса;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработатьПозицию(СтрокаПозиции,ТекущаяПозицияЛС,ТабКоэффициентов)
	
	ТекОбъект = ТекущаяПозицияЛС.ПолучитьОбъект();
	
	Если Не ТабКоэффициентов = Неопределено Тогда
		МассивКоэффициентов = ТабКоэффициентов.НайтиСтроки(Новый Структура("НомерПозицииВСмете",СтрокаПозиции.НомерПозицииВСмете));
		Для Каждого ТекСтрока Из МассивКоэффициентов Цикл
			ПолучитьСоздатьПоправочныйКоэффициентПоВсем(ТекСтрока,ТекущаяПозицияЛС,ТекОбъект);
		КонецЦикла;	
	КонецЕсли;
	

	// перемножаем.
	Если ТекОбъект.ПоправкиПозиции.количество() > 0 Тогда
		ТаблицаСтрок = ТекОбъект.ПоправкиПозиции.Выгрузить(,"Применить,УсловияПрименения,Обоснование,ВариантРасчета,Справка,ТипПоправки,ДобавПЗ,ДобавОЗ,ДобавЭМ,ДобавЗМ,ДобавСМ,ДобавТР,ДобавТ");
		ТаблицаСтрок.Свернуть("Применить,УсловияПрименения,Обоснование,ВариантРасчета,Справка,ТипПоправки","ДобавПЗ,ДобавОЗ,ДобавЭМ,ДобавЗМ,ДобавСМ,ДобавТР,ДобавТ");
		
		Итоговая = ТекОбъект.ПоправкиПозиции.Выгрузить().СкопироватьКолонки();
		
		Для Каждого Поправка Из ТаблицаСтрок Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("Применить",Поправка.Применить);
			Отбор.Вставить("УсловияПрименения",Поправка.УсловияПрименения);
			Отбор.Вставить("Обоснование",Поправка.Обоснование);
			Отбор.Вставить("ВариантРасчета",Поправка.ВариантРасчета);
			Отбор.Вставить("Справка",Поправка.Справка);
			Отбор.Вставить("ТипПоправки",Поправка.ТипПоправки);
			МассивПоправок = ТекОбъект.ПоправкиПозиции.НайтиСтроки(Отбор);
			
			НовСтр = Итоговая.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Поправка);
			
			Для каждого Поп Из МассивПоправок Цикл
				НовСтр.КоэффПЗ = ?(НовСтр.КоэффПЗ=0,Поп.КоэффПЗ,НовСтр.КоэффПЗ * ?(Поп.КоэффПЗ=0,1,НовСтр.КоэффПЗ)); 
				НовСтр.КоэффОЗ = ?(НовСтр.КоэффОЗ=0,Поп.КоэффОЗ,НовСтр.КоэффОЗ * ?(Поп.КоэффОЗ=0,1,НовСтр.КоэффОЗ)); 
				НовСтр.КоэффЭМ = ?(НовСтр.КоэффЭМ=0,Поп.КоэффЭМ,НовСтр.КоэффЭМ * ?(Поп.КоэффЭМ=0,1,НовСтр.КоэффЭМ)); 
				НовСтр.КоэффЗМ = ?(НовСтр.КоэффЗМ=0,Поп.КоэффЗМ,НовСтр.КоэффЗМ * ?(Поп.КоэффЗМ=0,1,НовСтр.КоэффЗМ)); 
				НовСтр.КоэффСМ = ?(НовСтр.КоэффСМ=0,Поп.КоэффСМ,НовСтр.КоэффСМ * ?(Поп.КоэффСМ=0,1,НовСтр.КоэффСМ)); 
				НовСтр.КоэффТР = ?(НовСтр.КоэффТР=0,Поп.КоэффТР,НовСтр.КоэффТР * ?(Поп.КоэффТР=0,1,НовСтр.КоэффТР)); 
				НовСтр.КоэффТМ = ?(НовСтр.КоэффТМ=0,Поп.КоэффТМ,НовСтр.КоэффТМ * ?(Поп.КоэффТМ=0,1,НовСтр.КоэффТМ)); 
			КонецЦикла;
			
		КонецЦикла;
		ТекОбъект.ПоправкиПозиции.Загрузить(Итоговая);
	КонецЕсли;
	// перемножаем.
	
	Если Не ЗначениеЗаполнено(СтрокаПозиции.НК1) Тогда
		Документы.СМ_ПозицияЛокальнойСметы.ОбновитьНРиСП(ТекОбъект);
	КонецЕсли;

	ЗатратыТрудаРабочих = 0;
	ЗатратыТрудаМашинистов = 0;
	
	МассивРаб = ТекОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(Новый Структура("ВидРесурса",Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих));
	Для Каждого эл Из МассивРаб Цикл
		ЗатратыТрудаРабочих = ЗатратыТрудаРабочих + эл.НормаРасхода;
	КонецЦикла;
	
	МассивМаш = ТекОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(Новый Структура("ВидРесурса",Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов));
	Для Каждого эл Из МассивМаш Цикл
		ЗатратыТрудаМашинистов = ЗатратыТрудаМашинистов + эл.НормаРасхода;
	КонецЦикла;
	
	ТекОбъект.ЗатратыТрудаРабочих = ЗатратыТрудаРабочих;
	ТекОбъект.ЗатратыТрудаМашинистов = ЗатратыТрудаМашинистов;
	
	ТекОбъект.Записать();
	
КонецПроцедуры

Процедура ПолучитьСоздатьПоправочныйКоэффициентПоВсем(ТекСтрока,ТекущаяПозицияЛС,ТекОбъект)

	// Тип поправки 1.0
	// 1 – Условия производства работ, 
	// 2 – Условия применения, 
	// 3 – Начисления на оборудование, 
	// 4 – Коэффициенты к показателям для расчета накладных и прибыли,
	// 5 – Не определен.		
	
	//  **************************************************
	//  Поправки позиции и начисления позиции.
	//  Все грузим в ТЧ "Поправки позиции".
	НоваяСтрока 			= ТекОбъект.ПоправкиПозиции.Добавить();	
	НоваяСтрока.Применить 	= Ложь;
	НоваяСтрока.Обоснование = ТекСтрока.ОснованиеКоэффициента;
	НоваяСтрока.УсловияПрименения		= ТекСтрока.НаименованиеКоэффициента;
	
	Если ТекСтрока.ТипПоправки = "1" Тогда
		НоваяСтрока.ТипПоправки	= Перечисления.СМ_ТипыПоправок.УсловияПроизводстваРаботМДС;
	Иначе
		НоваяСтрока.ТипПоправки	= Перечисления.СМ_ТипыПоправок.ТехчастиСборников;
	КонецЕсли;
	
	НоваяСтрока.КоэффОЗ	= ТекСтрока.Кзп;
	НоваяСтрока.КоэффЭМ	= ТекСтрока.Кмаш;	
	НоваяСтрока.КоэффСМ	= ТекСтрока.Кстмт;	
	НоваяСтрока.КоэффЗМ	= ТекСтрока.Кзпмашин;	
	НоваяСтрока.КоэффТР	= ТекСтрока.Ктруд;	
	НоваяСтрока.КоэффТМ = ТекСтрока.Ктрудмаш;	
	//НоваяСтрока.КоэффПЗ = ТекСтрока.ПоправочныйКоэффициент;
		
КонецПроцедуры

Процедура АнализДокументПозицияЛС(СтрокаПрограммы,Форма,ТекСтрока,Определитель,ТНС)
	НоваяСтрокаПрефикс = Неопределено;
	ШифрРасценки = ТекСтрока.ШифрПозиции;
	Префикс = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксИзСтроки(ШифрРасценки);
	Если ЗначениеЗаполнено(Префикс) Тогда
		НоваяСтрокаПрефикс = Форма.СоответствияПрефиксов.Найти(Префикс,"СтрокаПрефикса");
		Если НоваяСтрокаПрефикс = Неопределено Тогда
			НоваяСтрокаПрефикс	= Форма.СоответствияПрефиксов.Добавить();
			НоваяСтрокаПрефикс.СтрокаПрефикса = Префикс;
		КонецЕсли;
		НоваяСтрокаПрефикс.СметнаяПрограмма = СтрокаПрограммы.Загрузка_СведенияОПрограмме;
	КонецЕсли;

	Если Не НоваяСтрокаПрефикс = Неопределено Тогда
		Если Определитель = Неопределено Тогда	
			Если ТекСтрока.ТипПозиции = "0" Тогда // работа
				Определитель = Справочники.СМ_Определители.НайтиПоКоду(1);
			ИначеЕсли ТекСтрока.ТипПозиции = "2" И ТекСтрока.ВидЗатрат = "О" Тогда // оборудование
				Определитель = Справочники.СМ_Определители.НайтиПоКоду(14);
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
			ИначеЕсли ТекСтрока.ТипПозиции = "1"
				ИЛИ ТекСтрока.ТипПозиции = "2"
				ИЛИ ТекСтрока.ТипПозиции = "4"
				ИЛИ ТекСтрока.ТипПозиции = "5" Тогда // материал
				Определитель = Справочники.СМ_Определители.НайтиПоКоду(19);
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
			ИначеЕсли ТекСтрока.ТипПозиции = "3"  Тогда // оборудование
				Определитель = Справочники.СМ_Определители.НайтиПоКоду(14);
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
			ИначеЕсли ТекСтрока.ТипПозиции = "6"  Тогда // перевозки
				Определитель = Справочники.СМ_Определители.НайтиПоКоду(12);
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка;
			Иначе
				Определитель = Справочники.СМ_Определители.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		
		Если ТНС = Неопределено И ТекСтрока.ТипПозиции = "0" Тогда 
			Если ТекСтрока.ВидЗатрат = "С" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;	
			ИначеЕсли ТекСтрока.ВидЗатрат = "М" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы;
			ИначеЕсли ТекСтрока.ВидЗатрат = "П" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.ПусконаладочныеРаботы;	
			ИначеЕсли ТекСтрока.ВидЗатрат = "ПР" Тогда
			ИначеЕсли ТекСтрока.ВидЗатрат = "О" Тогда
			КонецЕсли;
		КонецЕсли;	
		НоваяСтрокаПрефикс.ТипНормативногоСборника = ТНС;
		НоваяСтрокаПрефикс.Определитель = Определитель;
	КонецЕсли;
КонецПроцедуры	

Функция ПолучитьСоздатьДокументПозицияЛС(ТекущаяПозицияВладелецЛС,ТекущаяСмета,ТекущийРаздел,Форма,ТекСтрока,Определитель,ТНС,СметнаяПрограмма)
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	
	//  Поиск существующей в базе позиции по реквизиту "Наименование"
	ТекНаименование = ТекСтрока.НаименованиеПозиции;
	Если НЕ ЗначениеЗаполнено(ТекНаименование) Тогда
		ТекНаименование = НСтр("ru='Позиция ЛС'");		
	КонецЕсли;

	Если ТекСтрока.ТипПозиции = "0" Тогда // работа
		
		Если ТекСтрока.ВидЗатрат = "С" Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(1);
			ТНС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;
		ИначеЕсли ТекСтрока.ВидЗатрат = "М" Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(6);
			ТНС = Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы;
		ИначеЕсли ТекСтрока.ВидЗатрат = "П" Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(0);
			ТНС = Перечисления.СМ_ТипыНормативныхСборников.ПусконаладочныеРаботы;
		ИначеЕсли ТекСтрока.ВидЗатрат = "ПР" Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(1);
			ТНС = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция;
		КонецЕсли;

		
	ИначеЕсли (ТекСтрока.ТипПозиции = "2" ИЛИ ТекСтрока.ТипПозиции = "3")
		И ТекСтрока.ВидЗатрат = "О" Тогда// оборудование
		ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(14);
		ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
	ИначеЕсли ТекСтрока.ТипПозиции = "1" 
		ИЛИ ТекСтрока.ТипПозиции = "4"
		ИЛИ ТекСтрока.ТипПозиции = "5" Тогда // материал
		ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(19);
		ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
	ИначеЕсли ТекСтрока.ТипПозиции = "6"  Тогда // перевозки
		ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(12);
		ТНС = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка;
	Иначе
		СтруктураСообщения 	= Новый Структура;
		СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
		СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Предупреждение'"));
		СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Определитель не распознан, вид затрат: %1, тип позиции: %2'"), ТекСтрока.ВидЗатрат, ТекСтрока.ТипПозиции));
		СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
		СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	КонецЕсли;


	//  Создание нового документа "ПозицияЛС"
	НовДок					= СМ_СметаВызовСервера.СоздатьНовуюПозицию();
	НовДок.Наименование 	= ТекНаименование;
	НовДок.Дата				= ТекущаяДатаСеанса();
	
	Если ЗначениеЗаполнено(ТекущийРаздел) Тогда
		НовДок.ИДРодителя = ТекущийРаздел;	
	Иначе                    			
		ТекущийРаздел 	 	= ПолучитьСоздатьДокументРаздел(ТекущаяСмета,"",ТекущаяСмета.Наименование);
		НовДок.ИДРодителя 	= ТекущийРаздел;
	КонецЕсли;

	НовДок.ИДСметы 			= ТекущаяСмета;
	НовДок.ШифрРасценки 	= ТекСтрока.ШифрПозиции;
	НовДок.Расчет 			= Истина;
	
	//  Поиск / создание единицы измерения
	ТекЕдИзм = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(ТекСтрока.ЕдиницаИзмерения);
	НовДок.ЕдиницаИзмерения			= ТекЕдИзм;
	Если (Не ЗначениеЗаполнено(НовДок.ЕдиницаИзмерения)) Тогда
		НовДок.ЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(ТекСтрока.ЕдиницаИзмерения);
	КонецЕсли;
				
	НовДок.Измеритель				= ТекСтрока.ЕдиницаИзмерения;
	
	НовДок.ОбъемРабот				= ПреобразоватьВЧисло(ТекСтрока.ОбъемРабот);
	
	Если ТНС = Неопределено И ТекСтрока.ТипПозиции = "0" Тогда 
		Если ТекСтрока.ВидЗатрат = "С" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;	
		ИначеЕсли ТекСтрока.ВидЗатрат = "М" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы;
		ИначеЕсли ТекСтрока.ВидЗатрат = "П" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.ПусконаладочныеРаботы;	
		ИначеЕсли ТекСтрока.ВидЗатрат = "ПР" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция;
		ИначеЕсли ТекСтрока.ВидЗатрат = "О" Тогда
		Иначе
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;	
		КонецЕсли;
	Иначе
		НовДок.ТипНормативныхСборников = ТНС;
	КонецЕсли;	

	Если ТекСтрока.ТипПозиции = "0" Тогда
		НовДок.ПрямЗатраты              = ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);
		НовДок.СтоимМатериалов          = ПреобразоватьВЧисло(ТекСтрока.СтоимостьМатериалов);
		НовДок.ОснЗарплата              = ПреобразоватьВЧисло(ТекСтрока.ОсновнаяЗП);
		НовДок.ЭксплМашин               = ПреобразоватьВЧисло(ТекСтрока.СтоимостьЭМиМех);
		НовДок.ЗарплМашинистов          = ПреобразоватьВЧисло(ТекСтрока.ЗарплатаМашинистов);
	ИначеЕсли (ТекСтрока.ТипПозиции = "2" ИЛИ ТекСтрока.ТипПозиции = "3")
		И ТекСтрока.ВидЗатрат = "О" Тогда
		НовДок.Оборудование          = ПреобразоватьВЧисло(ТекСтрока.Оборудование);
		НовДок.ТекущаяЦена          = ПреобразоватьВЧисло(ТекСтрока.Оборудование);
	ИначеЕсли ТекСтрока.ТипПозиции = "1" 
		ИЛИ ТекСтрока.ТипПозиции = "2" 
		ИЛИ ТекСтрока.ТипПозиции = "4"
		ИЛИ ТекСтрока.ТипПозиции = "5" Тогда
		НовДок.НормаРасходаРесурса = 1;
		НовДок.КоличествоРесурса = 1;
		НовДок.ПрямЗатраты = ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);
		НовДок.СтоимМатериалов          = ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);
		НовДок.ТекущаяЦена          = ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);
	ИначеЕсли ТекСтрока.ТипПозиции = "6"	 Тогда
		НовДок.ПрямЗатраты          = ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);
		НовДок.ТекущаяЦена          = ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);
	КонецЕсли;
	

	НовДок.СпособСоздания			= Перечисления.СМ_ИсточникиДобавленияПозиций.Загружена;
	НовДок.ИсточникСоздания			= СметнаяПрограмма.Наименование + "#KENML";	
	
	Если ТекСтрока.ПризнакПодчиненности Тогда
		Если ЗначениеЗаполнено(ТекущаяПозицияВладелецЛС) Тогда
			НовДок.ИДПозицииВладельца = ТекущаяПозицияВладелецЛС;
			// Ищем ресурсы неучтенные.
			ТекОбъект 						= ТекущаяПозицияВладелецЛС.ПолучитьОбъект();
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("СметныйКодРесурса", ТекСтрока.ШифрПозиции);
			ПараметрыОтбора.Вставить("ЕдиницаИзмеренияРесурса", ТекСтрока.ЕдиницаИзмерения);
			ПараметрыОтбора.Вставить("НаименованиеРесурса", ТекСтрока.НаименованиеПозиции);
			
			НайденныеСтроки = ТекОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаРесурс ИЗ НайденныеСтроки Цикл			
				СтрокаРесурс.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный;
			КонецЦикла;
			Если НайденныеСтроки.Количество()>0 Тогда
				ТекОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	НовДок.Определитель = ?(Определитель = Неопределено,ТекОпределитель,Определитель);
	
	// Если определитель еще не нашли - ищем по косвенным признакам
	Если Не ЗначениеЗаполнено(НовДок.Определитель) Тогда
		Если (НовДок.СтоимМатериалов<>0) И ((НовДок.ОснЗарплата+НовДок.ЭксплМашин+НовДок.СтоимМатериалов) = 0) Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(19);
		ИначеЕсли (НовДок.Оборудование<>0) Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(14);
		Иначе
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(1);
		КонецЕсли;
	КонецЕсли;
	
	//  Определение сметно-нормативной базы
	Если ЗначениеЗаполнено(Форма.СметноНормативнаяБаза) Тогда
		НовДок.РегиональнаяБаза = Форма.СметноНормативнаяБаза;
	Иначе	
		НайденныйЭлемент 		= Справочники.СМ_СметноНормативныеБазы.НайтиПоНаименованию(Форма.НаименованиеСНБазы);
		НовДок.РегиональнаяБаза = НайденныйЭлемент;
	КонецЕсли;
	
	//  Опеределение "ТипПозиции" = "Тип нормативного сборника"
	
	Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(НовДок);
	
	//Документы.СМ_ПозицияЛокальнойСметы.ОбновитьНРиСП(НовДок);
	Если ЗначениеЗаполнено(ТекСтрока.НК1) Тогда
		НовДок.НакладныеРасходыБазисные = ТекСтрока.НК1;
		НовДок.НакладныеРасходыТекущие = ТекСтрока.НК1;
	КонецЕсли;
	
	НовДок.Записать();
	ТекПозиция = НовДок.Ссылка;
	
	Если НЕ ТекСтрока.ПризнакПодчиненности Тогда
		ТекущаяПозицияВладелецЛС = ТекПозиция;
	КонецЕсли;	

	//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ позиция ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование));
	
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ позиция ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	
	// Запись сообщений в журнал регистрации
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	Возврат ТекПозиция;
	
КонецФункции	

Функция ПолучитьСоздатьКонтрагента(Форма,НаименованиеКонтрагента,ТипКонтрагента);
	
	НаименованиеКонтрагента = СокрЛП(НаименованиеКонтрагента);
	Если НЕ ЗначениеЗаполнено(НаименованиеКонтрагента) Тогда
		Если ТипКонтрагента = 1 Тогда
			НаименованиеКонтрагента	= НСтр("ru='Основной заказчик'");			
		ИначеЕсли ТипКонтрагента = 2 Тогда
			НаименованиеКонтрагента	= НСтр("ru='Основной подрядчик'");
		КонецЕсли;
	КонецЕсли;
	
	ТекКонтрагент = Справочники.Контрагенты.НайтиПоНаименованию(НаименованиеКонтрагента,Истина);
	Если ТекКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		Если Форма.СоздаватьНовыеЭлементы Тогда
			НовыйОбъект 				= Справочники.Контрагенты.СоздатьЭлемент();
			НовыйОбъект.Наименование 	= НаименованиеКонтрагента;
			НовыйОбъект.Записать();
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
