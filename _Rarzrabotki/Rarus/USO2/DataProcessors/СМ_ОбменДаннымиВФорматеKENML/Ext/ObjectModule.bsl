Функция ПолучитьСоздатьДоговор(Форма,Контрагент,НаименованиеДоговора,НомерДоговора,ДатаДоговора);
	
	НаименованиеДоговора = СокрЛП(НаименованиеДоговора);
	Если НЕ ЗначениеЗаполнено(НаименованиеДоговора) Тогда
		НаименованиеДоговора = НСтр("ru='Основной договор'");			
	КонецЕсли;
	
	ТекДоговор = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(НаименованиеДоговора,Истина,Контрагент);
	Если ТекДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда
		Если Форма.СоздаватьНовыеЭлементы Тогда
			НовыйОбъект 				= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			НовыйОбъект.Наименование 	= НаименованиеДоговора;
			НовыйОбъект.Контрагент		= Контрагент;
			НовыйОбъект.Записать();
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый договор: %1, %2'"), НовыйОбъект.Код, НовыйОбъект.Наименование));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
			
			Возврат НовыйОбъект.Ссылка;
		Иначе
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Предупреждение'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден договор: %1, %2'"), НомерДоговора, НаименованиеДоговора));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		КонецЕсли;
	Иначе
		Возврат ТекДоговор;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСоздатьДокументЛС(Организация,Район,Форма,ТекСтрока,СтруктураРеквизитовСмета)

	ТекЗаказчик 	= ПолучитьСоздатьКонтрагента(Форма,ТекСтрока.Заказчик,1);
	ТекПодрядчик 	= ПолучитьСоздатьКонтрагента(Форма,ТекСтрока.Подрядчик,2);
	
	Если ЗначениеЗаполнено(ТекЗаказчик) И ТекЗаказчик <> Справочники.Контрагенты.ПустаяСсылка() Тогда
		ТекДоговор = ПолучитьСоздатьДоговор(Форма,ТекЗаказчик, ТекСтрока.НаименованиеДоговора, ТекСтрока.НомерДоговора, ТекСтрока.ДатаДоговора);	
	КонецЕсли;
	
	НовДок 					= Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
	НовДок.Автор 			= ПользователиКлиентСервер.АвторизованныйПользователь();
	НовДок.Наименование 	= ТекСтрока.НаименованиеДокумента;
	НовДок.ДатаТекущихЦен	= ТекСтрока.ДатаЦен;
	НовДок.Основание		= ТекСтрока.ПроектнаяДокументация;
	НовДок.НомерСметы		= ТекСтрока.НомерДокумента;
	НовДок.Договор			= ТекДоговор;
	НовДок.Заказчик 		= ТекЗаказчик;
	НовДок.Подрядчик    	= ТекПодрядчик;
	НовДок.Дата				= ТекущаяДатаСеанса();
	НовДок.Организация		= Организация;
	НовДок.Район			= Район;
	
	Если Форма.НаименованиеСНБазы = "СН РК 2002-2004" Тогда
		НовДок.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
		НовДок.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета;
		НовДок.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ;
		НовДок.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости;
	Иначе
		НовДок.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный;
		НовДок.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_КЗ_РСНБ
	КонецЕсли;

	СМ_АРПС_ОбменВызовСервера.ЗаполнитьИзНастроекПользователяПоУмолчанию(НовДок);
	
	Если ЗначениеЗаполнено(Форма.ТекСтройка) Тогда
		НовДок.Стройка = Форма.ТекСтройка;
	КонецЕсли;
	
	Если СтруктураРеквизитовСмета.Свойство("ПоказательНК2") Тогда
		НовДок.НР2_ВС = СтруктураРеквизитовСмета.ПоказательНК2;
	КонецЕсли;
	
	Если СтруктураРеквизитовСмета.Свойство("ПоказательСП") Тогда
		НовДок.СП_ВС = СтруктураРеквизитовСмета.ПоказательСП;
	КонецЕсли;
	
	Если СтруктураРеквизитовСмета.Свойство("УровеньЦен") Тогда
		ДатаЦен = СтруктураРеквизитовСмета.УровеньЦен;
		Попытка
			ДатаТекущихЦен = Дата(Лев(ДатаЦен,4),Прав(ДатаЦен,1),1);
		Исключение
			ДатаТекущихЦен = Дата(1,1,1);
		КонецПопытки;
		НовДок.ДатаТекущихЦен = ДатаТекущихЦен;
	КонецЕсли;


	НовДок.ПечататьСетку = Истина;
	НовДок.ПечататьЗаголовкиРазделов = Истина;
	НовДок.ПечататьИтогиПоРазделам = Перечисления.СМ_ПечатьИтоговРаздела.ПечататьПервые;
	НовДок.РасшифроватьСостав = Истина;
	НовДок.РегионДляВыбораЦен = Форма.СметноНормативнаяБаза;
	
	НовДок.АвтозагрузкаЦен = Истина;
	НовДок.РегионДляВыбораЦен = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду("RK");

	НовДок.Записать();
	
	ТекСмета = НовДок.Ссылка;
	
	// Запись сообщений в журнал регистрации
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		
	Возврат ТекСмета.Ссылка;
	
КонецФункции

Функция ПолучитьСоздатьДокументРаздел(ТекущаяСмета,НомерРаздела,ТекНаименованиеРаздела,ВерхнийРаздел = Неопределено)

	//  Поиск существующего документа раздел в базе по типовому номеру документа.
	Если ЗначениеЗаполнено(НомерРаздела) Тогда
		ДлинаСтроки	 	= СтрДлина(СокрЛП(НомерРаздела));
		ДлинаНомера  	= 9;
		ДлинаОстатка 	= ДлинаНомера-ДлинаСтроки;
		ТекНомерРаздела = "";
		Для Сч = 1 По ДлинаОстатка Цикл
			ТекНомерРаздела = ТекНомерРаздела + "0";	
		КонецЦикла;
		ТекНомерРаздела = ТекНомерРаздела + СокрЛП(НомерРаздела);
	КонецЕсли;
	
	
	Если НЕ ЗначениеЗаполнено(ТекНаименованиеРаздела) Тогда
		НаименованиеРаздела = ТекущаяСмета.Наименование;
	Иначе
		НаименованиеРаздела	= ТекНаименованиеРаздела;
	КонецЕсли;
	
	//  Создание нового документа "Раздел ЛС". 
	НовДок							= СМ_СметаВызовСервера.СоздатьНовыйРаздел();
	НовДок.НаименованиеДляПечати 	= НаименованиеРаздела;
	НовДок.Дата						= ТекущаяДатаСеанса();
	НовДок.ИДРодителя   			= ?(ВерхнийРаздел = Неопределено,ТекущаяСмета.Ссылка,ВерхнийРаздел);
	НовДок.ИДСметы      			= ТекущаяСмета.Ссылка;
	НовДок.Расчет					= Истина;
	
	НовДок.Записать();
	ТекРаздел = НовДок.Ссылка;

	// Запись сообщений в журнал регистрации
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате KENML'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ раздел: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НаименованиеРаздела));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	Возврат ТекРаздел;
	
КонецФункции	

Функция ПреобразоватьВЧисло(ТекСтрока)
	
	Если ЗначениеЗаполнено(ТекСтрока) Тогда
		Попытка
			ТекЧисло = Число(ТекСтрока);
		Исключение
			ТекЧисло = 0;
		КонецПопытки;
	Иначе
		ТекЧисло = 0;
	КонецЕсли;
	
	Возврат ТекЧисло;
	
КонецФункции

// Поиск единицы измерения.
//
Функция НайтиЕдиницуИзмеренияСметномуКоду(Код)
	
	ЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(Код);
	Если ЕдиницаИзмерения.Пустая() Тогда
		Единица = Справочники.СМ_ЕдиницыИзмеренияСмета.СоздатьЭлемент();
		Единица.Наименование = Код;
		Единица.ОбменДанными.Загрузка = Истина;;
		Единица.Записать();
		ЕдиницаИзмерения = Единица.Ссылка;
	КонецЕсли;
	Возврат(ЕдиницаИзмерения);  
	
КонецФункции

