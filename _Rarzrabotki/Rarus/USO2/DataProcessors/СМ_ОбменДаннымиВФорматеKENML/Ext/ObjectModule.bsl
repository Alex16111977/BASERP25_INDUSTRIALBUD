// Процедура формирует строку информации о ресурсе.
//  В АРПС 1.10 - Тип 30 - Ресурс.
//  Записи задают состав и количество ресурсов, необходимых для выполнения 
//  позиций документа. 
// 
//  Параметры:
//   ТекстВыгрузки 	- ТекстовыйДокумент - формируемый текст выгрузки.
//   Документ 		- ДокументСсылка,ДокументОбъект - документ Локальная смета или Акт выполненных работ.
//   Позиция  		- ДокументСсылка.ПозицияЛокальнойСметы - ссылка на позицию локальной сметы. 
// 
Процедура ИдентификацияРесурсов(ЗаписьXML, Документ, СтрокаРасценки, ФорматВыгрузки)
	
	мРесурсов = ДокСсылка[2].Выгрузить();
	мРесурсов = мРесурсов.НайтиСтроки(Новый Структура("Ссылка, Расчет", СтрокаРасценки.Позиция, Истина));
	
	Для Каждого СтрокаРесурса Из мРесурсов Цикл
		
		//  Не выгружать ресурсы с признаком «не учтенный» и «по проекту»
		Если СтрокаРесурса.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный
			ИЛИ СтрокаРесурса.ТипМатериала = Перечисления.СМ_ТипыМатериалов.ПоПроекту Тогда
			Продолжить;
		КонецЕсли;
		ЗаписьXML.ЗаписатьНачалоЭлемента("РЕСУРС");
		
		Если Не СметнаяПрограммаВыбор.Пустая() Тогда
			КодРесурса = НайтиРесурсСметы(СтрокаРесурса.Позиция.Код,СтрокаРесурса.Позиция);
		Иначе
			КодРесурса = ?(ПустаяСтрока(СтрокаРесурса.Позиция.Код),СтрокаРесурса.СметныйКодРесурса,СтрокаРесурса.Позиция.Код);
		КонецЕсли;
		
		ПризнакТипа = "1";
		Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
			ПризнакТипа = "1";		
		ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
			ПризнакТипа = "2";
		ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
			ПризнакТипа = "3";
		ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование Тогда
			ПризнакТипа = "4";
		КонецЕсли;	

		ЗаписьXML.ЗаписатьАтрибут("ID",XMLСтрока(СтрокаРесурса.НомерПозиции));
		ЗаписьXML.ЗаписатьАтрибут("Наименование",СтрокаРесурса.НаименованиеРесурса);
		ЗаписьXML.ЗаписатьАтрибут("Тип",ПризнакТипа);
		ЗаписьXML.ЗаписатьАтрибут("КодСНБ",КодРесурса);
		ЗаписьXML.ЗаписатьАтрибут("КодЛокальный",КодРесурса);
		ЗаписьXML.ЗаписатьАтрибут("Цена",XMLСтрока(СтрокаРесурса.ТекущаяЦена)); 
		ЗаписьXML.ЗаписатьАтрибут("ЗМ",XMLСтрока(СтрокаРесурса.ТекущаяЗарплатаМашинистов));
		ЗаписьXML.ЗаписатьАтрибут("СР","0.0");
		ЗаписьXML.ЗаписатьАтрибут("ОТП","0.0");
		ЗаписьXML.ЗаписатьАтрибут("ТР","0.0");
		ЗаписьXML.ЗаписатьАтрибут("ЗГС","0.0");
		ЗаписьXML.ЗаписатьАтрибут("ЗГСП","0.0");
		ЗаписьXML.ЗаписатьАтрибут("Норма",XMLСтрока(СтрокаРесурса.Количество));
		ЗаписьXML.ЗаписатьАтрибут("Измеритель",СтрокаРесурса.ЕдиницаИзмеренияРесурса);
		ЗаписьXML.ЗаписатьАтрибут("Масса","0.0");
		ЗаписьXML.ЗаписатьАтрибут("Статус","");
		ЗаписьXML.ЗаписатьАтрибут("IDЗамены","");
		ЗаписьXML.ЗаписатьАтрибут("Поставка",?(СтрокаРесурса.СтатусРесурса = Перечисления.СМ_ОбеспечениеРесурса.Подрядчика,"П","З"));
		
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // РЕСУРС
	КонецЦикла;
	
КонецПроцедуры //  ИдентификацияРесурсов()

