&НаКлиенте
Процедура Подключаемый_ЗапуститьВыполнениеЗадания()
	Результат = ЗапуститьЗадание();
	ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	АдресХранилища = Результат.АдресХранилища;
	Если Результат.ЗаданиеВыполнено Тогда
		ОбработкаРезультата();
		Если АнализФайла Тогда
			Если этаформа.ВладелецФормы<>Неопределено Тогда
				Если этаформа.ВладелецФормы.ИмяФормы = "Обработка.СМ_ДеревоСмет.Форма.ФормаУпр" Тогда
					этаформа.ВладелецФормы.Элементы.СписокОбъектыСтроительства.обновить()
				КонецЕсли;
			КонецЕсли;
			Если ЭтаФорма.СоответствияЛЗ.Количество() > 0 ИЛИ ЭтаФорма.СоответствияРесурсов.Количество() > 0 ИЛИ ЭтаФорма.СоответствияПрефиксов.Количество() > 0 Тогда
				ПоказатьПредупреждение(,НСтр("ru='Требуется заполнить соответствия ресурсов, лимитированных затрат и префиксов..'"));
				Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных.Видимость = Истина;
				Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных;
				Если ЭтаФорма.СоответствияПрефиксов.Количество() > 0 Тогда 
					Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответствияПрефиксов;
				ИначеЕсли ЭтаФорма.СоответствияРесурсов.Количество() > 0 Тогда
					Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответствияРесурсов;					
				ИначеЕсли ЭтаФорма.СоответствияЛЗ.Количество() > 0 Тогда
					Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответсвияЛЗ;
				КонецЕсли;
				ВидимостьСтраницСоответствия();
			Иначе
				Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных.Видимость = Ложь;
				ВидимостьСтраницСоответствия();
			КонецЕсли;
			ФормироватьДокументы = Истина;
			ВидимостьКнопок();
		Иначе
			ПоказатьПредупреждение(,НСтр("ru='Документы сформированы.'"));
			Элементы.СформироватьДокументы.Видимость = Ложь;
			Оповестить("ОбновитьДеревоСмет");
		КонецЕсли;
	Иначе
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, Результат.ИдентификаторЗадания);
	КонецЕсли;                       

	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			
			Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда 
				ОбработкаРезультата();
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
				Если АнализФайла Тогда
					Если этаформа.ВладелецФормы<>Неопределено Тогда
						Если этаформа.ВладелецФормы.ИмяФормы = "Обработка.СМ_ДеревоСмет.Форма.ФормаУпр" Тогда
							этаформа.ВладелецФормы.Элементы.СписокОбъектыСтроительства.обновить()
						КонецЕсли;
					КонецЕсли;
					Если ЭтаФорма.СоответствияЛЗ.Количество() > 0 ИЛИ ЭтаФорма.СоответствияРесурсов.Количество() > 0 ИЛИ ЭтаФорма.СоответствияПрефиксов.Количество() > 0 Тогда
						ПоказатьПредупреждение(,НСтр("ru='Требуется заполнить соответствия ресурсов, лимитированных затрат и префиксов.'"));
						Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных.Видимость = Истина;
						Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных;
						Если ЭтаФорма.СоответствияПрефиксов.Количество() > 0 Тогда 
							Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответствияПрефиксов;
						ИначеЕсли ЭтаФорма.СоответствияРесурсов.Количество() > 0 Тогда
							Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответствияРесурсов;					
						ИначеЕсли ЭтаФорма.СоответствияЛЗ.Количество() > 0 Тогда
							Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответсвияЛЗ;
						КонецЕсли;
						ВидимостьСтраницСоответствия();
					Иначе
						Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных.Видимость = Ложь;
						ВидимостьСтраницСоответствия();
					КонецЕсли;
					ФормироватьДокументы = Истина;
					ВидимостьКнопок();
				Иначе
					ПоказатьПредупреждение(,НСтр("ru='Документы сформированы.'"));
					Элементы.СформироватьДокументы.Видимость = Ложь;
					Оповестить("ОбновитьДеревоСмет");
				КонецЕсли;

			Иначе
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания(
					"Подключаемый_ПроверитьВыполнениеЗадания", 
					ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
					Истина);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ЗаписатьИсключениеНаСервере(ПредставлениеОшибки);
		ПоказатьПредупреждение(,НСтр("ru='Произошла ошибка. Подробности в журнале регистрации.'"));
	КонецПопытки;
		
КонецПроцедуры

&НаСервере
Процедура ОбработкаРезультата()
	
	Если Не ИзФайла Тогда
		Для Каждого Стр Из СведенияФайлов Цикл
			Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",Стр.Загрузка_ПолныйПуть)); 
			Запись.Следующий();
			Запись.ПолучитьМенеджерЗаписи().Удалить();
		КонецЦикла;
	Иначе
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",Загрузка_ПолныйПуть)); 
		Запись.Следующий();
		Запись.ПолучитьМенеджерЗаписи().Удалить();
	КонецЕсли;

	
	РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимОтладки Тогда
		//  Вывод таблицы документов на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабДокументов,ЭтаФорма,"ДокументыАктСмета","ТабДок","СтраницаАктыСметы") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабДокументов,"ДокументыАктСмета");
		КонецЕсли; 
		
		//  Вывод таблицы разделов на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабРазделов,ЭтаФорма,"Разделы","ТабРазделы","СтраницаРазделы") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабРазделов,"Разделы");
		КонецЕсли; 
		
		//  Вывод таблицы позиций на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабПозиций,ЭтаФорма,"ПозицииЛС","ТабПоз","СтраницаПозицииЛС") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабПозиций,"ПозицииЛС");
		КонецЕсли; 
		
		//  Вывод таблицы коэффициентов на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабКоэффициентов,ЭтаФорма,"Коэффициенты","ТабКоэфф","СтраницаКоэффициенты") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабКоэффициентов,"Коэффициенты");
		КонецЕсли; 
		
		//  Вывод таблицы ресурсов на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабРесурсов,ЭтаФорма,"Ресурсы","ТабРес","СтраницаРесурсы") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабРесурсов,"Ресурсы");
		КонецЕсли; 
		
		//  Вывод таблицы лимитированных затрат на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабЛимЗатраты,ЭтаФорма,"ЛимЗатраты","ТабЛЗ","СтраницаЛимЗатраты") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабЛимЗатраты,"ЛимЗатраты");
		КонецЕсли; 	
		
		//  Вывод таблицы комментариев на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабКомментарии,ЭтаФорма,"Комментарии","ТабКом","СтраницаКомментарии") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабКомментарии,"Комментарии");
		КонецЕсли; 
	КонецЕсли; 
	
	Если АнализФайла Тогда
		
		//  Свернуть таблицу соответствия ресурсов
		ТабСоответствияРес = РезультатВыполнения.ТекФорма.СоответствияРесурсов;
		ТабСоответствияРес.Свернуть("НаименованиеРесурса,КодРесурса,СсылкаВБазе,СметнаяПрограмма");
		ЗначениеВРеквизитФормы(ТабСоответствияРес,"СоответствияРесурсов");
		
		//  Свернуть таблицу соответствия лимитированных затрат
		ТабСоответствияЛЗ = РезультатВыполнения.ТекФорма.СоответствияЛЗ;
		ТабСоответствияЛЗ.Свернуть("НаименованиеЛЗ,СсылкаВБазе,НеЯвляетсяЛимЗатратой,СметнаяПрограмма");
		ЗначениеВРеквизитФормы(ТабСоответствияЛЗ,"СоответствияЛЗ");
		
		//  Свернуть таблицу соответствия лимитированных затрат
		ТабСоответствияПрефиксов = РезультатВыполнения.ТекФорма.СоответствияПрефиксов;
		ТабСоответствияПрефиксов.Свернуть("СтрокаПрефикса,ТипНормативногоСборника,Определитель,ВидРесурса,СметнаяПрограмма,НеОтбрасыватьПрефикс,СоздаватьЗаписиВСправочнике");
		ЗначениеВРеквизитФормы(ТабСоответствияПрефиксов,"СоответствияПрефиксов");
	Иначе
		ТабСведенияФайлов = РезультатВыполнения.СведенияФайлов;
		Если ИзФайла Тогда
			Загрузка_СозданныйДокумент = ТабСведенияФайлов[0].Загрузка_СозданныйДокумент;
		Иначе   
			ЗначениеВРеквизитФормы(ТабСведенияФайлов,"СведенияФайлов");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьИсключениеНаСервере(Знач ПредставлениеОшибки)
	
	Событие = НСтр("ru = 'Ошибка в задании'");
	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПредставлениеОшибки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
