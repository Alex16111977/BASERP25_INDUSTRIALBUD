&НаСервере
Процедура ЗаполнитьСписокДокументов(ДатаНачала, ДатаОкончания)
	
	Объект.СписокДокументовВыгрузки.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ЛокальнаяСмета.Ссылка КАК Смета,
				   |	СМ_ЛокальнаяСмета.Номер КАК Номер,
				   |	СМ_ЛокальнаяСмета.Наименование КАК Наименование						   
				   |ИЗ
	               |	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	               |ГДЕ
	               |	СМ_ЛокальнаяСмета.Дата МЕЖДУ &ДатаНач И &ДатаКон
	               |	И СМ_ЛокальнаяСмета.Проведен = &Проведен";
				   
	Запрос.УстановитьПараметр("Проведен", Истина);
	Запрос.УстановитьПараметр("ДатаНач", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаКон", ДатаОкончания);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Объект.СписокДокументовВыгрузки.Загрузить(Результат);
	
КонецПроцедуры	

