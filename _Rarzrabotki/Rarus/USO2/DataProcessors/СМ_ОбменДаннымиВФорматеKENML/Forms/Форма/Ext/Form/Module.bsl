		// Определим сразу же версию и программу.
		Файлик = Новый Файл(КаталогЗагрузки);
		Загрузка_ИмяФайла = Файлик.ИмяБезРасширения;
		ДвоичныеДанные = Новый ДвоичныеДанные(КаталогЗагрузки);
		АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные,ЭтаФорма.УникальныйИдентификатор); 
		Загрузка_ПолныйПуть = КаталогЗагрузки;
		Загрузка_АдресВременногоХранилища = АдресВременногоХранилища;
		Попытка
			СтруктураСведений = ВернутьВерсиюФормата(КаталогЗагрузки);
			Загрузка_Формат = СтруктураСведений.Формат;
			Загрузка_СведенияОПрограмме = СМ_АРПС_ОбменВызовСервера.ПолучитьПрограмму(СтруктураСведений.НаименованиеПрограммы);
		Исключение
			Загрузка_СведенияОПрограмме = ПредопределенноеЗначение("Справочник.СМ_СметныеПрограммы.ПустаяСсылка");
			Загрузка_Формат = "";
		КонецПопытки;
	ИначеЕсли Не ИзФайла И ЗначениеЗаполнено(КаталогЗагрузки) Тогда
		
		// Синхронный вызов
		//СписокФайлов = НайтиФайлы(Этаформа.КаталогЗагрузки,"*.KENML"); 
		//Для Каждого ТекФайл Из СписокФайлов Цикл
		//	Если ТекФайл.ЭтоКаталог() Тогда
		//		Продолжить;
		//	КонецЕсли;
		//	НовСвед 					= СведенияФайлов.Добавить();
		//	НовСвед.Загрузка_ИмяФайла 	= ТекФайл.ИмяБезРасширения;
		//	ДвоичныеДанные 				= Новый ДвоичныеДанные(ТекФайл.ПолноеИмя);
		//	АдресВременногоХранилища 	= ПоместитьВоВременноеХранилище(ДвоичныеДанные,ЭтаФорма.УникальныйИдентификатор);
		//	НовСвед.Загрузка_ПолныйПуть = ТекФайл.ПолноеИмя;
		//	НовСвед.Загрузка_АдресВременногоХранилища = АдресВременногоХранилища;
		//	Попытка
		//		СтруктураСведений = ВернутьВерсиюФормата(ТекФайл.ПолноеИмя);
		//		НовСвед.Загрузка_Формат = СтруктураСведений.Формат;
		//		НовСвед.Загрузка_СведенияОПрограмме = СМ_АРПС_ОбменВызовСервера.ПолучитьПрограмму(СтруктураСведений.НаименованиеПрограммы);
		//	Исключение
		//		НовСвед.Загрузка_СведенияОПрограмме = ПредопределенноеЗначение("Справочник.СМ_СметныеПрограммы.ПустаяСсылка");
		//		НовСвед.Загрузка_Формат = "";
		//	КонецПопытки;
		//КонецЦикла;
		
		// Замена на асинхронный вызов
		ОповещениеПоиска = Новый ОписаниеОповещения("ВыполнитьПослеПоискаФайлов", ЭтотОбъект);
		НачатьПоискФайлов(ОповещениеПоиска,Этаформа.КаталогЗагрузки,"*.KENML");
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеПоискаФайлов(НайденныеФайлы,ДополнительныеПараметры) Экспорт
	
	Для Каждого ТекФайл Из НайденныеФайлы Цикл
		Если ТекФайл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		НовСвед 					= СведенияФайлов.Добавить();
		НовСвед.Загрузка_ИмяФайла 	= ТекФайл.ИмяБезРасширения;
		ДвоичныеДанные 				= Новый ДвоичныеДанные(ТекФайл.ПолноеИмя);
		АдресВременногоХранилища 	= ПоместитьВоВременноеХранилище(ДвоичныеДанные,ЭтаФорма.УникальныйИдентификатор);
		НовСвед.Загрузка_ПолныйПуть = ТекФайл.ПолноеИмя;
		НовСвед.Загрузка_АдресВременногоХранилища = АдресВременногоХранилища;
		Попытка
			СтруктураСведений = ВернутьВерсиюФормата(ТекФайл.ПолноеИмя);
			НовСвед.Загрузка_Формат = СтруктураСведений.Формат;
			НовСвед.Загрузка_СведенияОПрограмме = СМ_АРПС_ОбменВызовСервера.ПолучитьПрограмму(СтруктураСведений.НаименованиеПрограммы);
		Исключение
			НовСвед.Загрузка_СведенияОПрограмме = ПредопределенноеЗначение("Справочник.СМ_СметныеПрограммы.ПустаяСсылка");
			НовСвед.Загрузка_Формат = "";
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВернутьВерсиюФормата(ИмяФайла="") 
	
	СтруктураСведений = Новый Структура;
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ИмяФайла);
	Иначе
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(КаталогЗагрузки);
	КонецЕсли;
	
	НомерРегиона = "";
	
	Пока Чтение.Прочитать() Цикл 
		
		ИмяУзла = Чтение.Имя; 
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			Если ИмяУзла = "ДОКУМЕНТ" Тогда
				Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
					
					ТипУзла 		= Чтение.ТипУзла; 
					ИмяПараметра 	= ВРег(Чтение.Имя); 
					Значение 		= Чтение.Значение; 
					
					Если ИмяПараметра = ВРег("ВерсияФормата") Тогда
						СтруктураСведений.Вставить("Формат",Значение);
					ИначеЕсли ИмяПараметра = ВРег("ГЕНЕРАТОР") Тогда
						СтруктураСведений.Вставить("НаименованиеПрограммы",Значение);
					ИначеЕсли ИмяПараметра = ВРег("НомерРегиона") Тогда
						НомерРегиона = Значение;
					КонецЕсли;
					
				КонецЦикла;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	
	Если Не ПустаяСтрока(НомерРегиона) Тогда
		
		КодРегиона = Число(НомерРегиона);
		КодРегиона = Формат(КодРегиона,"ЧЦ=4; ЧДЦ=2; ЧРД=.; ЧВН=");
		ПоискРайон = Справочники.СМ_ТерриториальныеРайоны.НайтиПоКоду(КодРегиона);
		Если Не ПоискРайон.Пустая() Тогда
			Объект.Район = ПоискРайон;
		КонецЕсли;
		 
	КонецЕсли;

	Возврат СтруктураСведений;
КонецФункции 

