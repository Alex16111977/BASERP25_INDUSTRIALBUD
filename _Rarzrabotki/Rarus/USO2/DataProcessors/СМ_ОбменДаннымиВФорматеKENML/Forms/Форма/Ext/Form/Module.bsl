&НаКлиенте
Процедура ВыгрузитьKENML(Команда)
	
	ПрогрессВыполнения = 0;
	Индикатор 		= ЭтаФорма.Элементы.ПрогрессВыполнения;
	
	Индикатор.Видимость = Истина;
	Индикатор.МаксимальноеЗначение = Объект.СписокДокументовВыгрузки.Количество();
	НомерФайла = 1;
		
	Для Каждого ДокументВыгрузки Из Объект.СписокДокументовВыгрузки Цикл
		Если НЕ ЗначениеЗаполнено(ДокументВыгрузки.Файл) Тогда
			Если НЕ ЗначениеЗаполнено(ЭтаФорма.КаталогВыгрузки) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не задан каталог выгрузки!'"));
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ДокументВыгрузки Из Объект.СписокДокументовВыгрузки Цикл
		
		
		ПрогрессВыполнения 	= ПрогрессВыполнения + 1;
		
		АдресФайлаВоВременномХранилище = "";
		
		ВыгрузитьВФайлKENML(ДокументВыгрузки.ПолучитьИдентификатор(),АдресФайлаВоВременномХранилище);
			
 		НомерФайла = НомерФайла+1;
		
		Если Не ТипЗнч(АдресФайлаВоВременномХранилище) = Тип("Соответствие") Тогда
			Возврат;
		КонецЕсли;
		
		Для Каждого ключ Из АдресФайлаВоВременномХранилище Цикл
			ПолучитьФайл(ключ.Значение,ключ.Ключ,Ложь);
		КонецЦикла;

	КонецЦикла;
		
КонецПроцедуры

