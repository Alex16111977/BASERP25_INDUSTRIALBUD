&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("СМ_КЗ_МетодикаРСНБКазахстан") Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ЭтаФорма.АнализФайла 	= Истина;
	
	// Вставить содержимое обработчика
	ДатаНач = НачалоМесяца(ТекущаяДатаСеанса());
	ДатаКон = КонецМесяца(ТекущаяДатаСеанса());
	
	ФорматСНБ   = Истина;
	
	Если Параметры.Свойство("СписокЛС") Тогда
		Для Каждого ТекСсылка Из Параметры.СписокЛС Цикл
			ДобавитьСтрокуЛСВТаблицу(ТекСсылка);
		КонецЦикла;
	КонецЕсли;	
	
	Если Параметры.Свойство("Смета") Тогда
		Если ЗначениеЗаполнено(Параметры.Смета) Тогда
			ДобавитьСтрокуЛСВТаблицу(Параметры.Смета);
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("Загрузка") Тогда
		Если Параметры.Загрузка Тогда
			Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.СтраницаЗагрузка;
		КонецЕсли;
	КонецЕсли;
	

	СМ_АРПС_ОбменВызовСервера.ЗаполнитьНастройкиПользователяПоУмолчанию(Объект, ЭтаФорма);
	
	Если Параметры.Свойство("Стройка") Тогда
		Если ЗначениеЗаполнено(Параметры.Стройка) И НЕ Параметры.Стройка.ЭтоГруппа Тогда
			ТекСтройка = Параметры.Стройка;
		КонецЕсли;
	КонецЕсли;

	СметноНормативнаяБаза = Справочники.СМ_СметноНормативныеБазы.НайтиПоКоду("RK");
КонецПроцедуры

&НаКлиенте
