		Возврат;
	КонецЕсли;	
	
	Для каждого стр Из ВыбранноеЗначение Цикл
		НоваяСтрока = Объект.СписокДокументовВыгрузки.Добавить();
		НоваяСтрока.Смета 		= стр;
		НоваяСтрока.Номер			= стр.Номер;
		НоваяСтрока.Наименование	= стр.Наименование;		
	КонецЦикла;	
	
