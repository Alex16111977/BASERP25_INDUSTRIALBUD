&НаСервере
Процедура ДобавитьСтрокуЛСВТаблицу(ТекЛС)

	ТекОбъект = ТекЛС.ПолучитьОбъект();
	
	НоваяСтрока 				= Объект.СписокДокументовВыгрузки.Добавить();
	НоваяСтрока.Смета 		    = ТекОбъект.Ссылка;
	НоваяСтрока.Номер			= ТекОбъект.Номер;
	НоваяСтрока.Наименование	= ТекОбъект.Наименование;
	
КонецПроцедуры

// Основная процедура выгрузки документов в файл в формате KENML. 
// Вызывается из модуля формы обработки по кнопке "Выгрузить".
// 
//  Параметры:
//   Форма			- Форма  - основная форма обработки.
//   ДатаНач		- Дата   - дата начала выборки документов.
//   ДатаКон		- Дата   - дата конца выборки документов.
//   ВыгружатьСразу	- Булево - если Истина, то выгружаются все документы за период
//  						   иначе только из списка документов выгрузки.
//   Индикатор		- ЭлементыФормы.Индикатор - индикатор выгрузки.
// 
&НаСервере
Процедура ВыгрузитьВФайлKENML(Идентификатор,АдресФайлаВоВременномХранилище) 
	
	ДокументВыгрузки = Объект.СписокДокументовВыгрузки.НайтиПоИдентификатору(Идентификатор);
	Если ДокументВыгрузки = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Ошибка получения строки!'"));
		Возврат;
	КонецЕсли;
	
	Если НЕ ДокументВыгрузки.Смета.Проведен Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Документ %1 не проведен. Выгрузка отменена!'"), Строка(ДокументВыгрузки.Смета)));
		Возврат;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ДокументВыгрузки.Файл) Тогда
		ИмяФайла 				= СокрЛП(ДокументВыгрузки.Смета.НомерСметы) + ".KENML";
		ФайлВыгрузки 			= ЭтаФорма.КаталогВыгрузки + "\" + ИмяФайла;
		Файл 					= Новый Файл(ФайлВыгрузки);
		ДокументВыгрузки.Файл 	= ФайлВыгрузки;
	КонецЕсли;
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();	
	ОбъектДляСервера = РеквизитФормыВЗначение("Объект");
	ОбъектДляСервера.ВыгрузитьВФайлKENML(ДокументВыгрузки, АдресФайлаВоВременномХранилище,ИмяВременногоФайла);
		
	
КонецПроцедуры //  ВыгрузитьВФайлKENML()

