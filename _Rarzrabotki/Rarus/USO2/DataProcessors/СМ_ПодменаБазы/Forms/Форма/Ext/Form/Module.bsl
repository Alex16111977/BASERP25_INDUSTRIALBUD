#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьАкты()
	СуществуютАкты = СМ_УчетВыполненныхРаботСервер.СуществуютАктыПоСмете(ЛокальнаяСмета.Ссылка);
	ТаблицаОтчет.Очистить();
КонецПроцедуры

&НаСервере
Функция НайтиКод(СпрСсылка)
	 Код = СокрЛП(СпрСсылка.Код);	
	 Возврат(Код);
КонецФункции

&НаСервере
Функция ПолучитьОписаниеОбъекта(Ссылка,ПараметрыДляОбновления)
	ТипСборника = СМ_СметаЗагрузкаВызовСервера.ОпределитьКодТипаСборника(ССылка.ТипНормативныхСборников);
	НомерСборника = СМ_СметаВызовСервера.ОпределитьНомерСборника(ТипСборника, Ссылка.ШифрРасценки);
	ПараметрыДляОбновления.Вставить("РегионПозиции",Ссылка.РегиональнаяБаза);
	ПараметрыДляОбновления.Вставить("ИДПозицииВладельца",Ссылка.ИДПозицииВладельца);

	ПараметрыДляОбновления.Вставить("ТипСборника", ТипСборника);	
	ПараметрыДляОбновления.Вставить("ШифрРасценки", Ссылка.ШифрРасценки);	
	ПараметрыДляОбновления.Вставить("НомерСборника", СокрЛП(Строка(НомерСборника)));	
 КонецФункции
       
&НаСервере
 Процедура ЗавершениеОбновления()
	ЛокСмета = ЛокальнаяСмета.ПолучитьОбъект();
	ЛокСмета.Район = Район;
	ЛокСмета.ФайлСборникаКоэффициентов = "";
	ЛокСмета.ФайлСборникаКоэффициентовПредставление = "";
	ЛокСмета.АвтозагрузкаИндексов = Ложь;
	ЛокСмета.ПрименятьИндексыКоВсемБазам = Ложь;
	ЛокСмета.ДатаВыпускаИндексов = "";
	ЛокСмета.КодРегионаФайлаИндексовПересчета = "";
	ЛокСмета.ФайлСборникаТекущихЦен = "";
	ЛокСмета.ФайлСборникаТекущихЦенПредставление = "";
	ЛокСмета.АвтозагрузкаЦен = Ложь;
	ЛокСмета.ДатаТекущихЦен = "";
	ЛокСмета.КодРегионаФайлаТекущихЦен = "";
	Если ФайлТекущихЦен <> "" Тогда
		ЛокСмета.ФайлСборникаТекущихЦен = ФайлТекущихЦен;
		ЛокСмета.ФайлСборникаТекущихЦенПредставление = ФайлТекущихЦенПредставление;
		ЛокСмета.АвтозагрузкаЦен = Истина;
		ЛокСмета.ДатаТекущихЦен = ДатаТекущихЦен;
		ЛокСмета.КодРегионаФайлаТекущихЦен = КодРегионаФайлаТекущихЦен;
	КонецЕсли;
	Если ФайлИндексов <> "" Тогда
		ЛокСмета.ФайлСборникаКоэффициентов = ФайлИндексов;
		ЛокСмета.ФайлСборникаКоэффициентовПредставление = ФайлИндексовПредставление;
		ЛокСмета.АвтозагрузкаИндексов = Истина;
		ЛокСмета.ПрименятьИндексыКоВсемБазам = ПрименятьИндексыКоВсемБазам;
		ЛокСмета.ДатаВыпускаИндексов = ДатаВыпускаИндексов;
		ЛокСмета.КодРегионаФайлаИндексовПересчета = КодРегионаФайлаИндексовПересчета;
	КонецЕсли;
	ЛокСмета.Записать();
	Документы.СМ_ЛокальнаяСмета.Перерасчет(ЛокСмета, Ложь);
	
КонецПроцедуры

&НаСервере
Процедура 	ДобавитьВТаблицу(ТекПозиция)
	Позиция = ТекПозиция.ПолучитьОбъект();
	Номера = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ТекПозиция, "СМ_ПозицияЛокальнойСметы");
	ТекСтрокаТаблицы = ТаблицаПечати.Добавить();
	ТекСтрокаТаблицы.Наименование = СокрЛП(Позиция.Наименование);
	ТекСтрокаТаблицы.НомерВДереве = Номера.НомерВДереве;
	ТекСтрокаТаблицы.НомерПозиции = Номера.ПорНомер;
	ТекСтрокаТаблицы.Шифр = СокрЛП(Позиция.ШифрРасценки);
	ТекСтрокаТаблицы.Родитель = Позиция.ИДРодителя;
	ТекСтрокаТаблицы.РегиональнаяБаза = Позиция.РегиональнаяБаза;
КонецПроцедуры


&НаКлиенте
Процедура ОК(Команда)
	Элементы.ФормированиеОтчета.Доступность = Ложь;

	ТаблицаПечати.Очистить();
	Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.Протокол.Доступность = Ложь;
	Если ЛокальнаяСмета.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Не выбрана смета для подмены базы!'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	Если РегиональнаяБаза.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Не выбрана региональная база для подмены!'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	Если Район.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Не выбран район'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;	
	СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(ЛокальнаяСмета);
	ОбъектыОбновления = СМ_СметаВызовСервера.ПолучитьМассивВсехПозиций(ЛокальнаяСмета);
	Состояние(НСтр("ru='Идет подмена позиций'"));
	Для Каждого ПозицияОбновления Из ОбъектыОбновления Цикл
		ПараметрыДляОбновления = Новый Структура();
		КодРегиона = НайтиКод(РегиональнаяБаза);
		КодРайона = НайтиКод(Район);
		ПараметрыДляОбновления.Вставить("КодБазы", КодРегиона);
		ПараметрыДляОбновления.Вставить("КодЗоны", КодРайона);
		
		ПараметрыДляОбновления.Вставить("ТипСборника");
		ПараметрыДляОбновления.Вставить("НомерСборника");
		ПараметрыДляОбновления.Вставить("ШифрРасценки");
		ПараметрыДляОбновления.Вставить("РегионПозиции");
		ПараметрыДляОбновления.Вставить("ИДПозицииВладельца");
		ПолучитьОписаниеОбъекта(ПозицияОбновления,ПараметрыДляОбновления);
		Если ПараметрыДляОбновления.ТипСборника = ПредопределенноеЗначение("Перечисление.СМ_ТипыНормативныхСборников.Калькуляция")
			Или ПараметрыДляОбновления.РегионПозиции.Пустая() Тогда
			Продолжить;
		КонецЕсли;	
		// Выбираются все расценки.                      
		Если ПараметрыДляОбновления.НомерСборника = "0" Тогда
			Продолжить;
		КонецЕсли;
		Данные = СметнаяКомпонента.ОбновитьПоБазе(ПараметрыДляОбновления.ШифрРасценки,КодРайона,КодРегиона,ПараметрыДляОбновления.ТипСборника,ПараметрыДляОбновления.НомерСборника);
		Если ЗначениеЗаполнено(Данные) И СМ_СметаЗагрузкаВызовСервера.ЕстьДанные(Данные) = Ложь Тогда
			ДобавитьВТаблицу(ПозицияОбновления);
		КонецЕсли;
		Если ЗначениеЗаполнено(Данные) Тогда
			СтруктураПараметровФормыВыбораВНБ = СМ_СметаВызовСервера.ОбновитьДанныеВПозицииЛС(Данные, ПозицияОбновления, Истина, СтруктураПараметровФормыВыбораВНБ, СтруктураПараметровРасчетаЛС, СМ_ВерсияКомпоненты, Истина);
		КонецЕсли;
			
	КонецЦикла;	
	//  Обновление коэффицментов.
	Состояние(НСтр("ru='Подмена позиций по смете завершена'"));
	МетодРасчета = СтруктураПараметровРасчетаЛС.МетодРасчета;
	Уровень = СтруктураПараметровРасчетаЛС.Уровень;
	ВариантПересчетаЭММ =  СтруктураПараметровРасчетаЛС.ВариантПересчетаЭММ;
	Если (МетодРасчета = ПредопределенноеЗначение("Перечисление.СМ_МетодыРасчетаЛС.БазисноИндексный")
		И Уровень = ПредопределенноеЗначение("Перечисление.СМ_УровеньЗаданияИндексов.Расценка")) Тогда
		Если ИзменятьИндексы И ЗначениеЗаполнено(ФайлИндексов) Тогда
		Состояние(НСтр("ru='Обновление коэффициентов по смете'"));
		СтруктураДанных = Новый Структура("СборникКоэффициентов", ФайлИндексов);
			Если ПрименятьИндексыКоВсемБазам Тогда
				СтруктураДанных.Вставить("КодРегиональнойБазы", КодРегионаФайлаИндексовПересчета);
			КонецЕсли;
			ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОбИндексахПересчета(ЛокальнаяСмета, , СтруктураДанных);
			СМ_СметаВызовСервера.ЗагрузитьИндексыВПозиции(ЛокальнаяСмета, ДанныеИнд, ВариантПересчетаЭММ, Истина, Ложь);

			Состояние(НСтр("ru='Обновление коэффициентов по смете завершено'"));

		КонецЕсли;
	КонецЕсли;	
	Если ИзменятьЦены И ЗначениеЗаполнено(ФайлТекущихЦен) Тогда
		// Обновление текущих цен.
		Состояние(НСтр("ru='Обновление текущих цен по смете'"));
		СтруктураДанных = Новый Структура("СборникТекущихЦен, КодРегиональнойБазы", ФайлТекущихЦен, КодРегионаФайлаТекущихЦен);
		ДанныеИнд = СМ_СметаЗагрузкаКлиент.ПолучитьДанныеОТекущихЦенах(ЛокальнаяСмета, , СтруктураДанных);
		СМ_СметаВызовСервера.ЗагрузитьТекущиеЦеныВПозиции(ЛокальнаяСмета, ДанныеИнд, Истина, Ложь);
		Состояние(НСтр("ru='Обновление текущих цен по смете завершено'"));
	КонецЕсли;					

	ЗавершениеОбновления();
	Сообщение = Новый СообщениеПользователю();
	Сообщение.Текст = НСтр("ru='Подмена позиций по смете завершена'");
	Сообщение.Сообщить();
	Элементы.ФормированиеОтчета.Доступность = Истина;

КонецПроцедуры

&НаКлиенте
Процедура РегиональнаяБазаПриИзменении(Элемент)
	Район.Пустая();
	ДатаТекущихЦен = "";
	ИзменятьЦены = Ложь;
	ФайлТекущихЦенПредставление = "";
	ФайлТекущихЦен = "";
	КодРегионаФайлаТекущихЦен = "";
	ФайлСборникаКоэффициентов = "";
	ФайлСборникаКоэффициентовПредставление = "";
	АвтозагрузкаИндексов = Ложь;
	ПрименятьИндексыКоВсемБазам = Ложь;
	ДатаВыпускаИндексов = "";
	КодРегионаФайлаИндексовПересчета = "";
	ТаблицаПечати.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьДоступность()
	Элементы.ОК.Доступность = ?(СуществуютАкты,Ложь,Истина);	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не ГлобальнаяСтрокаДереваСмет = Неопределено Тогда
		ЛокальнаяСмета = ГлобальнаяСтрокаДереваСмет.Ссылка;
		ПроверитьАкты();
		Если СуществуютАкты Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = НСтр("ru='Смета не может быть изменена, существуют акты'");
			Сообщение.Сообщить();
		КонецЕсли;
		ИзменитьДоступность();
		Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.Протокол.Доступность = Ложь;
		Элементы.ФормированиеОтчета.Доступность = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЛокальнаяСметаПриИзменении(Элемент)
	ТаблицаПечати.Очистить();

	Если Не ЛокальнаяСмета.Пустая() Тогда
		ПроверитьАкты();
		Если СуществуютАкты Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = НСтр("ru='Смета не может быть изменена, существуют акты'");
			Сообщение.Сообщить();
		КонецЕсли;
	Иначе
		ДатаТекущихЦен = "";
		ИзменятьЦены = Ложь;
		ФайлТекущихЦен = "";
		ФайлТекущихЦенПредставление = "";
		КодРегионаФайлаТекущихЦен = "";
		СуществуютАкты = Ложь;
		ФайлИндексов = "";
		ФайлИндексовПредставление = "";
		ДатаВыпускаИндексов = "";
		КодРегионаФайлаИндексовПересчета = "";
		ИзменятьИндексы = Ложь;
		ПрименятьИндексыКоВсемБазам = Ложь;

	КонецЕсли;
	ИзменитьДоступность();

КонецПроцедуры

&НаКлиенте
Процедура ФайлТекущихЦенПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если  СметнаяКомпонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеФормаВыбораСборникаЦен", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.СМ_ФормаВыбораСборникаЦен",Новый Структура("СборникиРесурсов",Истина), ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

Процедура ПослеФормаВыбораСборникаЦен(Результат, СтруктураПараметров) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФайлТекущихЦен = Результат.ИмяФайла;
	ФайлТекущихЦенПредставление = Результат.Представление;
	ДатаТекущихЦен = Результат.Дата;
	КодРегионаФайлаТекущихЦен = Результат.КодНормативнойБазы;
КонецПроцедуры


&НаКлиенте
Процедура ИзФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если  СметнаяКомпонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораФайлСборникаКоэффициентов", ЭтаФорма);
	ОткрытьФорму("ОбщаяФорма.СМ_ФормаВыбораСборникаЦен",Новый Структура("СборникиРесурсов",Ложь), ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайлСборникаКоэффициентов(Результат, СтруктураПараметров) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФайлИндексов = Результат.ИмяФайла;
	ФайлИндексовПредставление = Результат.Представление;
	ДатаВыпускаИндексов = Результат.Дата;
	КодРегионаФайлаИндексовПересчета = Результат.КодНормативнойБазы;
КонецПроцедуры


&НаКлиенте
Процедура ФайлИндексовПредставлениеОчистка(Элемент, СтандартнаяОбработка)
	ФайлИндексов = "";
	ФайлИндексовПредставление = "";
	ДатаВыпускаИндексов = "";
	КодРегионаФайлаИндексовПересчета = "";
	ИзменятьИндексы = Ложь;
	ПрименятьИндексыКоВсемБазам = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ФайлТекущихЦенПредставлениеОчистка(Элемент, СтандартнаяОбработка)
		ДатаТекущихЦен = "";
		ИзменятьЦены = Ложь;
		ФайлТекущихЦен = "";
		ФайлТекущихЦенПредставление = "";
		КодРегионаФайлаТекущихЦен = "";
КонецПроцедуры

&НаКлиенте
Процедура ФормированиеОтчета(Команда)
	ВызовНаСервере();
	Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.Протокол.Доступность = Истина;
	Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.Протокол
КонецПроцедуры

&НаСервере
Процедура ВызовНаСервере()
	ТаблицаОтчет = Обработки.СМ_ПодменаБазы.ПечатьПротокола(ТаблицаПечати,ЛокальнаяСмета);
КонецПроцедуры	

&НаКлиенте
Процедура ЛокальнаяСметаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 			= Ложь;
	ОписаниеОЗакрытииФормыВыбораЛС 	= Новый ОписаниеОповещения("ПриЗакрытииФормыПодбораЛС",ЭтаФорма);
	СтруктураПараметров 			= Новый Структура;
	СтруктураПараметров.Вставить("ОтборСтройка",Истина);
	
	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",СтруктураПараметров,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораЛС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыПодбораЛС(ТекЛС,ТекПараметр) Экспорт
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЛокальнаяСмета = ТекЛС;
КонецПроцедуры

#КонецОбласти