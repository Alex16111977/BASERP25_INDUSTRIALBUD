					//	ИтогКоличествоЧасовПоПлану 	= ИтогКоличествоЧасовПоПлану + СтрокаГрафика.ЧасовВсего;
					//КонецЕсли;
					
				КонецЕсли;
				
				//ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовПоПлану	= ?(КоличествоЧасовПоПлану=0,"0",КоличествоЧасовПоПлану);
				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовПоГрафику 	= "0";
			Иначе 
				
				СтрокаГрафика = ТаблицаГрафик.Найти(ТекущийДень,"Дата");
				Если СтрокаГрафика <> Неопределено Тогда 
					КоличествоЧасовПоГрафику 		= КоличествоЧасовПоГрафику + СтрокаГрафика.ЧасовВсего;
					ИтогКоличествоЧасовПоГрафику 	= ИтогКоличествоЧасовПоГрафику + СтрокаГрафика.ЧасовВсего;
				КонецЕсли;

				ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовПоГрафику 	= ?(КоличествоЧасовПоГрафику=0,"0",КоличествоЧасовПоГрафику);
				
			КонецЕсли;
			//--
			
		
			// Для поддержки навигации по работам с сохранением и адекватным выводом данных ТЧ Зарезервировано при смене работ
			// ++
			ОтборРезерв = Новый Структура;
			ОтборРезерв.Вставить("Сотрудник",ТекСтрокаРабота.Сотрудник);
			ОтборРезерв.Вставить("Работа",ТекущиеДанные.Работа);
			ОтборРезерв.Вставить("Ресурс",ТекущиеДанные.Ресурс);
			ОтборРезерв.Вставить("СоставРесурса",ТекущиеДанные.СоставРесурса);
			ОтборРезерв.Вставить("Дата",ТекущийДень);
			
			НайденныеСтрокиЗарезервировано = Зарезервировано.НайтиСтроки(ОтборРезерв);  
			Для Каждого ТекСтр Из НайденныеСтрокиЗарезервировано Цикл 
				
				КоличествоЧасовЗарезервировано 			= КоличествоЧасовЗарезервировано			+ ТекСтр.КоличествоЧасов;
				//КоличествоЧасовЗарезервированоВсего 	= КоличествоЧасовЗарезервированоВсего 		+ ТекСтр.КоличествоЧасов;
				ИтогКоличествоЧасовЗарезервировано 		= ИтогКоличествоЧасовЗарезервировано 		+ ТекСтр.КоличествоЧасов;
				ТекСтр.НомерКолонки = ИндексКолонки;
				ТекСтр.НомерСтрокиРезерв = СчетчикСтрокМесяца + 4;
				
				ОтборВсего = Новый Структура;
				ОтборВсего.Вставить("Дата", 		ТекСтр.Дата);
				ОтборВсего.Вставить("Сотрудник",	ТекСтр.Сотрудник);
				ЧасовПоСотруднику 		= Зарезервировано.НайтиСтроки(ОтборВсего);
				ТЗ_ЧасовПоСотруднику 	= Зарезервировано.Выгрузить(ЧасовПоСотруднику, "КоличествоЧасов");
				КоличествоЧасовВсего = ТЗ_ЧасовПоСотруднику.Итог("КоличествоЧасов");
				КоличествоЧасовВсего = ?(КоличествоЧасовВсего <> Неопределено, КоличествоЧасовВсего, 0);
				
				ИтогКоличествоЧасовЗарезервированоВсего = ИтогКоличествоЧасовЗарезервированоВсего 	+ КоличествоЧасовВсего;
				
			КонецЦикла;
			
			ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовЗарезервировано 		= ?(КоличествоЧасовЗарезервировано		= 0, "0", КоличествоЧасовЗарезервировано);
			ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовЗарезервированоВсего	= ?(КоличествоЧасовЗарезервированоВсего = 0, "0", КоличествоЧасовЗарезервированоВсего);
		
			Если КоличествоЧасовЗарезервировано > 0 Тогда 
				Если КоличествоЧасовЗарезервировано > 8 ИЛИ ВыходнойДень(ТекСтрокаРабота.Сотрудник, ТекущийДень) Тогда 
					ОбластьДетальныхЗаписей.Область(3,1).ЦветФона = WebЦвета.ОранжевоКрасный;
				Иначе 
					ОбластьДетальныхЗаписей.Область(3,1).ЦветФона = WebЦвета.Голубой;
				КонецЕсли;
			Иначе
				//++
				//выделяем зеленым цветом ячейки с периодом в который выполняется работа
				//ОбластьДетальныхЗаписей.Область(3,1).ЦветФона = WebЦвета.Белоснежный;
				Если ТекущийДень >= НачалоДня(мТекущаяРабота.ДатаНачала) и ТекущийДень <= мТекущаяРабота.ДатаОкончания Тогда
					ОбластьДетальныхЗаписей.Область(3,1).ЦветФона = WebЦвета.ЗеленоватоЛимонный;
				Иначе
					ОбластьДетальныхЗаписей.Область(3,1).ЦветФона = WebЦвета.Белоснежный;
				КонецЕсли;
				//--
			КонецЕсли;
			
			Если КоличествоЧасовЗарезервированоВсего > 0 Тогда 
				Если КоличествоЧасовЗарезервированоВсего > 8 ИЛИ ВыходнойДень(ТекСтрокаРабота.Сотрудник, ТекущийДень) Тогда 
					ОбластьДетальныхЗаписей.Область(4,1).ЦветФона = WebЦвета.ОранжевоКрасный;
				Иначе 
					ОбластьДетальныхЗаписей.Область(4,1).ЦветФона = WebЦвета.Голубой;
				КонецЕсли;
			Иначе
				ОбластьДетальныхЗаписей.Область(4,1).ЦветФона = WebЦвета.Белоснежный;
			КонецЕсли;
			
			Если ВыходнойДень(ТекСтрокаРабота.Сотрудник, ТекущийДень)  Тогда  				
				ТабДок.Область(СчетчикСтрокМесяца + 2,ИндексКолонки,СчетчикСтрокМесяца + 2,ИндексКолонки).ЦветФона = ЦветаСтиля.ПолеСОшибкойФон;
				ТабДок.Область(СчетчикСтрокМесяца + 3,ИндексКолонки,СчетчикСтрокМесяца + 3,ИндексКолонки).ЦветФона = ЦветаСтиля.ПолеСОшибкойФон;
				Если КоличествоЧасовЗарезервировано <> 0 Тогда
					ТабДок.Область(СчетчикСтрокМесяца + 4,ИндексКолонки,СчетчикСтрокМесяца + 4,ИндексКолонки).ЦветФона = ЦветаСтиля.ПолеСОшибкойФон;
				КонецЕсли;
			КонецЕсли;

			// --
			
			
			// строка "свободно"
			// ++
			
			//Свободно = Число(ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовПоГрафику) - Число(ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовЗарезервировано);
			//Если Свободно > 0 Тогда 
			//	ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовСвободно = Свободно;
			//	//ИтогКоличествоЧасовСвободно = ИтогКоличествоЧасовСвободно + Свободно;

			//Иначе
			//	ОбластьДетальныхЗаписей.Параметры.КоличествоЧасовСвободно = "0";
			//КонецЕсли;
			// --
			
			ТабДок.Присоединить(ОбластьДетальныхЗаписей);
			
			ТекущийДень = ТекущийДень + 60*60*24;
			ИндексКолонки = ИндексКолонки +1;
			Если ТекущийМесяц <> Месяц(ТекущийДень) ИЛИ КонецДня(ТекущийДень) = КонецДня(мДатаОкончания) Тогда 
				Если КонецДня(ТекущийДень) = КонецДня(мДатаОкончания) Тогда 
					
					ТабДок.Область(СчетчикСтрокМесяца+1,ИндексКолонки,СчетчикСтрокМесяца+4,ИндексКолонки).ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,);
					
				Иначе 
					
					ТабДок.Область(СчетчикСтрокМесяца+1,ИндексКолонки-1,СчетчикСтрокМесяца+4,ИндексКолонки-1).ГраницаСправа = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,);
					КолонкаНачалаМесяца = ИндексКолонки;
					ТекущийМесяц = Месяц(ТекущийДень);
					
				КонецЕсли;
			КонецЕсли;
			
			
			ОтборСотрудник.Удалить("ПериодДень");
			
		КонецЦикла;
		
		//Вывод ИТОГОВ
		
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовСвободно 				= ?(ИтогКоличествоЧасовСвободно 			= 0, "0", ИтогКоличествоЧасовСвободно);
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовЗарезервировано 		= ?(ИтогКоличествоЧасовЗарезервировано 		= 0, "0", ИтогКоличествоЧасовЗарезервировано);
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовЗарезервированоВсего 	= ?(ИтогКоличествоЧасовЗарезервированоВсего = 0, "0", ИтогКоличествоЧасовЗарезервированоВсего);
		ОбластьДетальныхЗаписейИтог.Параметры.КоличествоЧасовПоГрафику      		= ?(ИтогКоличествоЧасовПоГрафику 			= 0, "0", ИтогКоличествоЧасовПоГрафику);
		
		ТабДок.Присоединить(ОбластьДетальныхЗаписейИтог);
		СчетчикСтрокМесяца = СчетчикСтрокМесяца + 6;
		Если ТекСтрокаРабота.Сотрудник <> 0 Тогда  
			НайденныйСотрудник.НомерСтрокиРезерв = СчетчикСтрокМесяца - 2; //Пока решил ограничиться номером строки резерва и все
			//НайденныйСотрудник.НомерСтрокиОкончания = СчетчикСтрокМесяца -1;
		КонецЕсли;

	КонецЦикла;
		

	мЗапретитьВызовПриАктивизации = Ложь;
	
КонецПроцедуры

&НаСервере
Функция ОпределитьДатуПоКолонке(НомерКолонки)
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерКолонки",НомерКолонки);
	
	НайденнаяСтрокаДаты = мТЗКолонкиДат.НайтиСтроки(Отбор);
	Если НайденнаяСтрокаДаты.Количество() > 0 Тогда 
		Возврат НайденнаяСтрокаДаты[0].Дата;
	Иначе 
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 

Функция ПолучитьДанныеГрафикаЗаПериод(СписокСотрудников,мДатаНачала,мДатаОкончания)
		
	ВыборкаДанныхОВремени = ДанныеОВремениСотрудников(СписокСотрудников, мДатаНачала,мДатаОкончания);
	
	ТаблицаДанныхПоГрафику = Новый ТаблицаЗначений;
	ТаблицаДанныхПоГрафику.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаДанныхПоГрафику.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	ТаблицаДанныхПоГрафику.Колонки.Добавить("ЧасовВсего", Новый ОписаниеТипов("Число"));
	
	ГрафикРаботыСотрудников.Очистить();
	
	Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Сотрудник") Цикл
		Пока ВыборкаДанныхОВремени.СледующийПоЗначениюПоля("Дата") Цикл 								
			НоваяСтрока = ТаблицаДанныхПоГрафику.Добавить();
			НоваяСтрока.Сотрудник 	= ВыборкаДанныхОВремени.Сотрудник;
			НоваяСтрока.Дата 		= ВыборкаДанныхОВремени.Дата;
			//НоваяСтрока.ЧасовВсего 	= ВыборкаДанныхОВремени.НормаЧасов; 
			
			НоваяСтрокаГрафика = ГрафикРаботыСотрудников.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаГрафика, ВыборкаДанныхОВремени);
			//НоваяСтрокаГрафика.КоличествоЧасов = ВыборкаДанныхОВремени.НормаЧасов;
			Если ВыборкаДанныхОВремени.НайтиСледующий(Новый Структура("Дата, Сотрудник, ВидУчетаВремени", ВыборкаДанныхОВремени.Дата, ВыборкаДанныхОВремени.Сотрудник, ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РабочееВремя"))) Тогда
				НоваяСтрока.ЧасовВсего 				= ВыборкаДанныхОВремени.НормаЧасов; 
				НоваяСтрокаГрафика.КоличествоЧасов 	= ВыборкаДанныхОВремени.НормаЧасов;
			КонецЕсли;
		КонецЦикла;	   							
	КонецЦикла;	
	
	Возврат ТаблицаДанныхПоГрафику;
	
КонецФункции

&НаСервере
Функция ДанныеОВремениСотрудников(СписокСотрудников = Неопределено, мДатаНачала,мДатаОкончания) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ПараметрыЗаполнения = УчетРабочегоВремениРасширенный.ПараметрыДляЗапросВТДанныеУчетаВремениИСостоянийСотрудников();
	
	ПараметрыЗаполнения.ИмяВТСотрудники = "ВТСотрудники";
	ПараметрыЗаполнения.ИмяВТРезультат = "ВТДанныеУчетаВремениИСостоянийСотрудников";
	ПараметрыЗаполнения.РассчитыватьПлановоеВремя 		= Ложь;
	ПараметрыЗаполнения.Организация  					= Организация;
	ПараметрыЗаполнения.ДатаАктуальности  				= НачалоМесяца(мДатаНачала);
	ПараметрыЗаполнения.ДатаНачала 						= мДатаНачала;
	ПараметрыЗаполнения.ДатаОкончания 					= мДатаОкончания;
	
	ПараметрыЗаполнения.МесяцДатаНачала 				= НачалоМесяца(мДатаНачала);
	ПараметрыЗаполнения.МесяцДатаОкончания 				= КонецМесяца(мДатаОкончания);
	ПараметрыЗаполнения.ПолучатьУжеРассчитанныеДанные 	= Ложь;
	ПараметрыЗаполнения.ПересчитыватьФактическоеВремя 	= Истина;
	

	Запрос.УстановитьПараметр("ДатаНачала", ПараметрыЗаполнения.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ПараметрыЗаполнения.ДатаОкончания);
	
	Если СписокСотрудников = Неопределено Тогда
		ПараметрыПолученияСотрудников 					= КадровыйУчет.ПараметрыПолученияСотрудниковОрганизацийПоВременнойТаблице();
		ПараметрыПолученияСотрудников.Организация  		= Организация;
		ПараметрыПолученияСотрудников.НачалоПериода 	= мДатаНачала;
		ПараметрыПолученияСотрудников.ОкончаниеПериода 	= мДатаОкончания;
		ПараметрыПолученияСотрудников.ИмяВТФизическиеЛица = Неопределено;
		// Подработки
		Если ПолучитьФункциональнуюОпцию("ИспользоватьПодработки") Тогда
			
			ПараметрыПолученияСотрудников.ПодработкиРаботниковПоТрудовымДоговорам = Истина;
			
		КонецЕсли;	
		// Подработки конец
		
		КадровыйУчет.СоздатьВТСотрудникиОрганизации(Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыПолученияСотрудников, "ВТСотрудникиОрганизации");
		
		Запрос.Текст = 
		"ВЫБРАТЬ  РАЗРЕШЕННЫЕ
		|	СотрудникиОрганизации.Сотрудник,
		|	&ДатаНачала,
		|	&ДатаОкончания
		|ПОМЕСТИТЬ ВТСотрудники
		|ИЗ
		|	ВТСотрудникиОрганизации КАК СотрудникиОрганизации";
		
		Запрос.Выполнить();
		
	Иначе
		ТаблицаСотрудников = Новый ТаблицаЗначений;
		ТаблицаСотрудников.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
		ТаблицаСотрудников.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
		ТаблицаСотрудников.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата"));
		
		Для каждого Сотрудник Из СписокСотрудников Цикл
			СтрокаТаблицы = ТаблицаСотрудников.Добавить();
			СтрокаТаблицы.Сотрудник = Сотрудник;
			СтрокаТаблицы.ДатаНачала = мДатаНачала;
			СтрокаТаблицы.ДатаОкончания = мДатаОкончания;
		КонецЦикла;
		
		Запрос.УстановитьПараметр("ТаблицаСотрудников", ТаблицаСотрудников);
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаСотрудников.Сотрудник,
		|	ТаблицаСотрудников.ДатаНачала,
		|	ТаблицаСотрудников.ДатаОкончания
		|ПОМЕСТИТЬ ВТСотрудники
		|ИЗ
		|	&ТаблицаСотрудников КАК ТаблицаСотрудников";
		
		Запрос.Выполнить();

	КонецЕсли;	
	
	УчетРабочегоВремениРасширенный.СоздатьВТДанныеУчетаВремениИСостоянийСотрудников(Запрос.МенеджерВременныхТаблиц, Истина, ПараметрыЗаполнения);	
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеУчетаВремениИСостоянийСотрудников.Сотрудник КАК Сотрудник,
	|	ДанныеУчетаВремениИСостоянийСотрудников.Дата КАК Дата,
	|	ДанныеУчетаВремениИСостоянийСотрудников.ВидУчетаВремени КАК ВидУчетаВремени,
	|	ДанныеУчетаВремениИСостоянийСотрудников.Дни КАК Дни,
	|	ДанныеУчетаВремениИСостоянийСотрудников.Часы КАК Часы,
	|	ДанныеУчетаВремениИСостоянийСотрудников.НормаЧасов,
	|	ВЫБОР
	|		КОГДА ОписаниеВидовВремени.Ссылка = &Явка
	|			ТОГДА 1
	|		КОГДА ОписаниеВидовВремени.ОсновноеВремя = &Явка
	|			ТОГДА 2
	|		КОГДА ОписаниеВидовВремени.Ссылка = &ВечерниеЧасы
	|			ТОГДА 3
	|		КОГДА ОписаниеВидовВремени.ОсновноеВремя = &ВечерниеЧасы
	|			ТОГДА 3
	|		КОГДА ОписаниеВидовВремени.Ссылка = &НочныеЧасы
	|			ТОГДА 5
	|		КОГДА ОписаниеВидовВремени.ОсновноеВремя = &НочныеЧасы
	|			ТОГДА 6
	|		КОГДА ОписаниеВидовВремени.Ссылка = &Сверхурочно
	|			ТОГДА 7
	|		КОГДА ОписаниеВидовВремени.ОсновноеВремя = &Сверхурочно
	|			ТОГДА 8
	|		ИНАЧЕ 9
	|	КОНЕЦ КАК ПриоритетВидаВремени
	|ИЗ
	|	ВТДанныеУчетаВремениИСостоянийСотрудников КАК ДанныеУчетаВремениИСостоянийСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|		ПО ДанныеУчетаВремениИСостоянийСотрудников.Сотрудник = Сотрудники.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыИспользованияРабочегоВремени КАК ОписаниеВидовВремени
	|		ПО ДанныеУчетаВремениИСостоянийСотрудников.ВидУчетаВремени = ОписаниеВидовВремени.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудники.Наименование,
	|	Сотрудник,
	|	Дата,
	|	ПриоритетВидаВремени,
	|	ОписаниеВидовВремени.Наименование,
	|	ВидУчетаВремени";
	
	Запрос.УстановитьПараметр("Явка", ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.Явка"));
	Запрос.УстановитьПараметр("ВечерниеЧасы", ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РаботаВечерниеЧасы"));
	Запрос.УстановитьПараметр("НочныеЧасы", ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РаботаНочныеЧасы"));
	Запрос.УстановитьПараметр("Сверхурочно", ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.Сверхурочные"));
	
	Возврат Запрос.Выполнить().Выбрать();
КонецФункции

&НаСервере
Функция ДоступныеДляВводаВидыВремени() Экспорт
	ДоступныеДляВводаВидыВремени = Новый Соответствие;
	
	ВидВремениРабочееВремя = ОбщегоНазначенияКлиентСервер.ПредопределенныйЭлемент("Справочник.ВидыИспользованияРабочегоВремени.РабочееВремя");	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РабочееВремя", ВидВремениРабочееВремя);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВидыИспользованияРабочегоВремени.ОсновноеВремя
	|ИЗ
	|	Справочник.ВидыИспользованияРабочегоВремени КАК ВидыИспользованияРабочегоВремени
	|ГДЕ
	|	ВидыИспользованияРабочегоВремени.Ссылка <> &РабочееВремя";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДоступныеДляВводаВидыВремени.Вставить(Выборка.ОсновноеВремя, Истина);
	КонецЦикла;
	
	Возврат ДоступныеДляВводаВидыВремени;
КонецФункции	

&НаСервере
Функция  ПолучитьДанныеПоРаботе(ТекущиеДанные, ТаблицаСотрудников, мДатаНачала, мДатаОкончания)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеПоСотрудникам.Сотрудник,
	|	ДанныеПоСотрудникам.Дата,
	|	ДанныеПоСотрудникам.ЧасовВсего КАК ЧасовПоГрафику,
	|	ДанныеПоСотрудникам.ЧасовВсего КАК ЧасовСвободно,
	|	0 КАК ЧасовЗарезервировано
	|ПОМЕСТИТЬ ВТ_ДанныеПоСотрудникам
	|ИЗ
	|	&ДанныеПоСотрудникам КАК ДанныеПоСотрудникам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеПоСотрудникам.Сотрудник,
	|	ДанныеПоСотрудникам.Дата,
	|	ДанныеПоСотрудникам.ЧасовПоГрафику КАК ЧасовПоГрафику,
	|	ДанныеПоСотрудникам.ЧасовСвободно КАК ЧасовСвободно,
	|	0 КАК ЧасовЗарезервировано
	|ПОМЕСТИТЬ ВТ_КоличествоЧасов
	|ИЗ
	|	ВТ_ДанныеПоСотрудникам КАК ДанныеПоСотрудникам
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УСОERP_НазначенияИсполнителейРаботОбороты.Сотрудник,
	|	УСОERP_НазначенияИсполнителейРаботОбороты.Период,
	|	СУММА(0),
	|	СУММА(-ЕСТЬNULL(УСОERP_НазначенияИсполнителейРаботОбороты.КоличествоОборот, 0)),
	|	СУММА(0)
	|ИЗ
	|	РегистрНакопления.УСОERP_НазначенияИсполнителейРабот.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Организация = &Организация
	//|				И Подразделение = &Подразделение
	//|				И ОбъектСтроительства = &ОбъектСтроительства
	//|				И Работа = &Работа
	//|				И Ресурс = &Ресурс
	//|				И СоставРесурса = &СоставРесурса
	|				И Сотрудник В (&Сотрудники)) КАК УСОERP_НазначенияИсполнителейРаботОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	УСОERP_НазначенияИсполнителейРаботОбороты.Сотрудник,
	|	УСОERP_НазначенияИсполнителейРаботОбороты.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_КоличествоЧасов.Сотрудник КАК Сотрудник,
	|	ВТ_КоличествоЧасов.Дата КАК ПериодДень,
	|	СУММА(ВТ_КоличествоЧасов.ЧасовПоГрафику) КАК КоличествоЧасовПоГрафику,
	|	ВЫБОР
	|		КОГДА СУММА(ВТ_КоличествоЧасов.ЧасовСвободно) < 0
	|			ТОГДА 0
	|		ИНАЧЕ СУММА(ВТ_КоличествоЧасов.ЧасовСвободно)
	|	КОНЕЦ КАК КоличествоЧасовСвободно,
	|	СУММА(ВТ_КоличествоЧасов.ЧасовЗарезервировано) КАК КоличествоЧасовЗарезервировано,
	|	СУММА(ВТ_КоличествоЧасов.ЧасовЗарезервировано) КАК КоличествоЧасовЗарезервированоВсего
	|ИЗ
	|	ВТ_КоличествоЧасов КАК ВТ_КоличествоЧасов
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_КоличествоЧасов.Сотрудник,
	|	ВТ_КоличествоЧасов.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник,
	|	ВТ_КоличествоЧасов.Дата";
	Запрос.УстановитьПараметр("ДанныеПоСотрудникам", ТаблицаСотрудников);
	Запрос.УстановитьПараметр("Сотрудники", ТаблицаСотрудников.ВыгрузитьКолонку("Сотрудник"));
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоДня(мДатаНачала), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(мДатаОкончания), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("Подразделение", 	Подразделение);
	Запрос.УстановитьПараметр("ОбъектСтроительства", ОбъектСтроительства);
	Запрос.УстановитьПараметр("Работа", ТекущиеДанные.Работа);
	Запрос.УстановитьПараметр("Ресурс", ТекущиеДанные.Ресурс);
	Запрос.УстановитьПараметр("СоставРесурса", ТекущиеДанные.СоставРесурса);
	
	
	Возврат Запрос.Выполнить();
			
КонецФункции

&НаСервере
Функция ВыходнойДень(Сотрудник, АнализируемаяДата)
	
	МассивСтрок = ГрафикРаботыСотрудников.НайтиСтроки(Новый Структура("Сотрудник, Дата", Сотрудник , АнализируемаяДата));
	Если МассивСтрок.Количество() > 0 Тогда
		СтрокаГрафика = МассивСтрок[0];
		Если СтрокаГрафика.ВидУчетаВремени = Справочники.ВидыИспользованияРабочегоВремени.ВыходныеДни
			ИЛИ СтрокаГрафика.ВидУчетаВремени = Справочники.ВидыИспользованияРабочегоВремени.Праздники Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	Иначе		
		Если ДеньНедели(АнализируемаяДата) = 6 ИЛИ ДеньНедели(АнализируемаяДата) = 7 Тогда 
			Возврат Истина;
		Иначе 
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;	

КонецФункции

&НаКлиенте
Процедура ОткрытьУказаниеЧасовНаРезервированиеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ЗначениеВозврата = Результат;
	
	Если ЗначениеВозврата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ОбщееЧислоЧасовРезервирования = ЗначениеВозврата;
	ЗадействоватьРесурсНаСервере(ДополнительныеПараметры.КоординатыВыделеннойОбласти);
	
	ТекущиеДанные = Элементы.ДеревоРабот.ТекущиеДанные;
	Элементы.Зарезервировано.ОтборСтрок = Новый ФиксированнаяСтруктура("Работа, Ресурс, СоставРесурса, Ид_Строки", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.СоставРесурса, ТекущиеДанные.Ид_Строки);
	Элементы.Зарезервировано.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДокументыНазначений()
	
	ТЗ_РаспределенныеРаботы = Зарезервировано.Выгрузить();
	ТЗ_РаспределенныеРаботы.Свернуть("Работа");
	
	мДеревоРабот = РеквизитФормыВЗначение("ДеревоРабот");
	
	Для Каждого СтрРабота из ТЗ_РаспределенныеРаботы Цикл
		НовыйДокументНазначение = Документы.УСОERP_НазначениеИсполнителейРабот.СоздатьДокумент();
		НовыйДокументНазначение.Дата = ТекущаяДата();
		НовыйДокументНазначение.ДокументУтверждения = ДокументУтверждения;
		
		Если ЗначениеЗаполнено(ДатаНачала) Тогда
			мДатаНачала = ДатаНачала;
		Иначе		
			СтрокиДерева = мДеревоРабот.Строки.НайтиСтроки(Новый Структура("Работа", СтрРабота.Работа));
			мДатаНачала = СтрокиДерева[0].ДатаНачала;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаОкончания) Тогда
			мДатаОкончания = ДатаОкончания;
		Иначе		
			СтрокиДерева = мДеревоРабот.Строки.НайтиСтроки(Новый Структура("Работа", СтрРабота.Работа));
			мДатаОкончания = СтрокиДерева[0].ДатаОкончания;
		КонецЕсли;
		
		НовыйДокументНазначение.ДатаНачала 		= мДатаНачала;
		НовыйДокументНазначение.ДатаОкончания 	= мДатаОкончания;
		
		НовыйДокументНазначение.Организация 		= Организация;
		НовыйДокументНазначение.ОбъектСтроительства = ОбъектСтроительства;
		НовыйДокументНазначение.Ответственный 		= ПараметрыСеанса.ТекущийПользователь;
		НовыйДокументНазначение.Подразделение 		= Подразделение;
		
		ТаблицаРаспределения = Зарезервировано.Выгрузить(Новый Структура("Работа", СтрРабота.Работа));
		ТаблицаРесурсовИСоставов = ТаблицаРаспределения.Скопировать();
		ТаблицаРесурсовИСоставов.Свернуть("Ресурс, СоставРесурса, Ид_Строки");
		
		Для Каждого СтрокаРесурс Из ТаблицаРесурсовИСоставов Цикл
			НоваяСтрокаРабота = НовыйДокументНазначение.Работы.Добавить();
			НоваяСтрокаРабота.Работа 		= СтрРабота.Работа;
			НоваяСтрокаРабота.Ресурс 		= СтрокаРесурс.Ресурс;
			НоваяСтрокаРабота.СоставРесурса = СтрокаРесурс.СоставРесурса;
			НоваяСтрокаРабота.ИдентификаторДляПоиска = СтрокаРесурс.Ид_Строки; 
		КонецЦикла;
		
		ТаблицаРаспределения.Свернуть("Сотрудник, Должность, Дата, Работа, Ресурс, СоставРесурса, Ид_Строки", "КоличествоЧасов");
		
		Для Каждого СтрокаСотрудник Из  ТаблицаРаспределения Цикл
			НоваяСтрокаИсполнитель = НовыйДокументНазначение.Исполнители.Добавить();
			НоваяСтрокаИсполнитель.Сотрудник 		= СтрокаСотрудник.Сотрудник;
			НоваяСтрокаИсполнитель.Должность 		= СтрокаСотрудник.Должность;
			НоваяСтрокаИсполнитель.Дата 			= СтрокаСотрудник.Дата;
			НоваяСтрокаИсполнитель.КоличествоЧасов 	= СтрокаСотрудник.КоличествоЧасов;
			НоваяСтрокаИсполнитель.Работа 			= СтрокаСотрудник.Работа;
			НоваяСтрокаИсполнитель.Ресурс 			= СтрокаСотрудник.Ресурс;
			НоваяСтрокаИсполнитель.СоставРесурса 	= СтрокаСотрудник.СоставРесурса;
			НоваяСтрокаИсполнитель.ИдентификаторДляПоиска = СтрокаСотрудник.Ид_Строки; 
			
			СтрокиДляУдаления = Зарезервировано.НайтиСтроки(Новый Структура("Сотрудник, Работа, Ресурс, СоставРесурса, Дата, Ид_Строки", 
							  																			СтрокаСотрудник.Сотрудник,
							  																			СтрокаСотрудник.Работа,
							  																			СтрокаСотрудник.Ресурс,
							  																			СтрокаСотрудник.СоставРесурса,
							  																			СтрокаСотрудник.Дата,
																										СтрокаСотрудник.Ид_Строки));
																										
			Для Каждого СтрокаУдалить Из СтрокиДляУдаления Цикл
				Зарезервировано.Удалить( СтрокаУдалить);
			КонецЦикла;
																										
			  
		КонецЦикла;
		
		
		НовыйДокументНазначение.Комментарий = "#Создан программно пользователем " + НовыйДокументНазначение.Ответственный + " " + Формат(ТекущаяДата(), "ДЛФ=DDT") + ".";
		ДокументЗаписан = Ложь;
		Попытка
			НовыйДокументНазначение.Записать(РежимЗаписиДокумента.Проведение);
			ДокументЗаписан = Истина;
		Исключение
			ТекстСообщения = НСтр("ru = 'Не удалось сформировать документ назначения исполнителей для работы <%КодСДР% %Работа%> по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%КодСДР%", СтрокаСотрудник.Работа.КодСДР);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Работа%", СтрокаСотрудник.Работа);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.УСОERP_НазначениеИсполнителейРабот, СтрокаСотрудник.Работа, ТекстСообщения);
			
		КонецПопытки;
		
		Если ДокументЗаписан Тогда
			НовоеНазначение = Объект.ДокументыНазначений.Добавить();
			НовоеНазначение.Работа = СтрРабота.Работа;
			НовоеНазначение.Назначение = НовыйДокументНазначение.Ссылка;
		КонецЕсли;
		
	КонецЦикла;
	
	
КонецПроцедуры

// Функция Преобразует КодСДР в число 
//    Параметр - КодСДР
//    Возврат в формате: Первый уровень = целая часть, остальное дробная
//    Пример 1.1.2 ==> 1,12  
// 	
Функция КодСДРвЧисло(КодСДР) Экспорт
	пКодСДР = КодСДР;
	Если СтрЧислоВхождений(пКодСДР,".") >=1 Тогда
		Пока НЕ СтрЧислоВхождений(пКодСДР,".") = 1 Цикл
			НачальнаяПозиция = Найти(пКодСДР, ".");
			ВременнаяСтрока = Прав(пКодСДР, СтрДлина(пКодСДР) - НачальнаяПозиция);
			КоличествоСимволов = СтрДлина(ВременнаяСтрока);
			НоваяСтрока = СтрЗаменить(ВременнаяСтрока, ".", "");
			пКодСДР = Лев(пКодСДР, СтрДлина(пКодСДР) - КоличествоСимволов) +  НоваяСтрока;
		КонецЦикла;
		КодСДРЧисло = Число(?(СОКРЛП(пКодСДР)="", 0, СтрЗаменить(СтрЗаменить(пКодСДР, ".", ",")," ","")));	
	Иначе
		КодСДРЧисло = Число(?(СОКРЛП(пКодСДР)="", 0, пКодСДР))
	КонецЕсли;
	      
	Возврат КодСДРЧисло;

КонецФункции // КодСДРвЧисло()

