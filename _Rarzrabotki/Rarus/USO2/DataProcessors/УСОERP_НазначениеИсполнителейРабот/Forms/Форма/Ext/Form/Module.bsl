		НоваяСтрока.КодСДРЧисло = КодСДРвЧисло(НоваяСтрока.Работа.КодСДР);
		
		МассивСоставов = ТаблицаСоставов.Найтистроки(Новый Структура("Ресурс", НоваяСтрока.Ресурс));
		Если МассивСоставов.Количество() = 1 тогда
			НоваяСтрока.СоставРесурса = МассивСоставов[0].СоставРесурса;
		КонецЕсли;		
	КонецЦикла;
	
	ТаблицаРаботИРесурсов.Сортировать("КодСДРЧисло Иерархия");   
	
	ТаблицаРабот = ТаблицаРаботИРесурсов.Скопировать();
	ТаблицаРабот.Свернуть("Работа, ДатаНачала, ДатаОкончания, Длительность, ЕдиницаДлительности");
	
	ДанныеДляДерева = Новый ДеревоЗначений;
	ТипыЗначений = Новый Массив; 
	ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_Ресурсы")); 
	ТипыЗначений.Добавить(Тип("СправочникСсылка.УСОERP_СтроительныеРаботы")); 
	Если ДанныеДляДерева.Колонки.Найти("Работа") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("Работа",                 Новый ОписаниеТипов(ТипыЗначений));
	КонецЕсли;
	Если ДанныеДляДерева.Колонки.Найти("РаботаРодитель") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("РаботаРодитель",         Новый ОписаниеТипов(ТипыЗначений));
	КонецЕсли;
	Если ДанныеДляДерева.Колонки.Найти("НомерРаботыВУровне") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("НомерРаботыВУровне",     Новый ОписаниеТипов("Число"));
	КонецЕсли;
	Если ДанныеДляДерева.Колонки.Найти("КодСДР") = Неопределено Тогда
		ДанныеДляДерева.Колонки.Добавить("КодСДР",     Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	Для каждого ПолеТаблицы Из мДеревоРесурсов.Колонки Цикл
		Если ДанныеДляДерева.Колонки.Найти(ПолеТаблицы.Имя) = Неопределено Тогда
			ДанныеДляДерева.Колонки.Добавить(ПолеТаблицы.Имя, ПолеТаблицы.ТипЗначения);
		КонецЕсли; 
	КонецЦикла; 		
	
	Работы.Очистить();
	Ид_Строки = 1;
	Для Каждого СтрокаРабота Из ТаблицаРабот Цикл
		СтрокаДерева_Работа = ДанныеДляДерева.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева_Работа, СтрокаРабота);
		СтрокаДерева_Работа.Работа 		 =  СтрокаРабота.Работа;
		СтрокаДерева_Работа.РаботаРесурс =  СтрокаРабота.Работа;
		СтрокаДерева_Работа.ЭтоРабота	 =  Истина;
		СтрокаДерева_Работа.РаботаРодитель     = СтрокаРабота.Работа.Родитель;
		СтрокаДерева_Работа.КодСДР             = СтрокаРабота.Работа.КодСДР ;
		СтрокаДерева_Работа.НомерРаботыВУровне = СтрокаРабота.Работа.НомерРаботыВУровне;
		
		МассивРесурсов = ТаблицаРаботИРесурсов.НайтиСтроки(Новый Структура("Работа", СтрокаРабота.Работа));
		Ид_Строки = Ид_Строки + 1;
		Для Каждого СтрокаРесурс Из  МассивРесурсов Цикл
			Для к = 1 по СтрокаРесурс.Количество Цикл
				Ид_Строки = Ид_Строки + 1;
				СтрокаДерева_Ресурс = СтрокаДерева_Работа.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаДерева_Ресурс,  СтрокаРесурс,, "СоставРесурса");
				СтрокаДерева_Ресурс.РаботаРесурс =  СтрокаРесурс.Ресурс;
				Если к = 1 Тогда
					СтрокаДерева_Ресурс.СоставРесурса = СтрокаРесурс.СоставРесурса;
				КонецЕсли;
				СтрокаДерева_Ресурс.Ид_Строки          = Ид_Строки;
				//СтрокаДерева_Ресурс.Работа             = СтрокаРесурс.Ресурс;
				СтрокаДерева_Ресурс.РаботаРодитель     = СтрокаДерева_Работа.Работа;
				СтрокаДерева_Ресурс.КодСДР             = Неопределено;
				СтрокаДерева_Ресурс.НомерРаботыВУровне = Неопределено;
				
			КонецЦикла;
		КонецЦикла;
		
		НоваяСтрокаРабота = Работы.Добавить();
		НоваяСтрокаРабота.Работа = СтрокаРабота.Работа;
	КонецЦикла;
	
	//ВыражениеИсточник = "Работа";
	//ВыражениеПриемник = "РаботаРодитель" ;
	//Справочник        = Справочники.УСОERP_СтроительныеРаботы;
	//ДеревоРезультат   = УСОERP_ОбработкаТабличныхЧастей.УСОERP_ПодготовитьДанныеИСформироватьДеревоСВосстановлениемСтруктуры(ДанныеДляДерева,ВыражениеИсточник,ВыражениеПриемник,"РаботаРесурс",Справочник);
	//
	//ВремРодноеДерево = РеквизитФормыВЗначение("ДеревоРабот"); // берется родная структура с родной типизацией
	//ВремРодноеДерево.Строки.Очистить();
	//УСОERP_ОбработкаТабличныхЧастей.УСОERP_ЗаполнитьРоднуюСтруктуруДереваИзВнешнего(ВремРодноеДерево.Строки, ДеревоРезультат.Строки); // и рекурсивно заполняется из дерева, где, возможн, типиация создаст проблемы
	//ЗначениеВРеквизитФормы(ВремРодноеДерево, "ДеревоРабот");
	//ВремРодноеДерево.Строки.Очистить(); // уборка за собой
	
	ЗначениеВРеквизитФормы(ДанныеДляДерева, "ДеревоРабот");
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьНаКлиенте()
	
	КоллекцияЭлементовДерева = ДеревоРабот.ПолучитьЭлементы();
	
		
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Свернуть(ИдентификаторСтроки);
	КонецЦикла;
	

КонецПроцедуры

&НаКлиенте
Процедура РазвернутьНаКлиенте(СтрокаДерева)
	
	КоллекцияЭлементовДерева = СтрокаДерева.ПолучитьЭлементы();
		
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл
		ИдентификаторСтроки	= Строка.ПолучитьИдентификатор();
		Элементы.ДеревоРабот.Развернуть(ИдентификаторСтроки);
		
		Если Строка.ПолучитьЭлементы().количество()>0 Тогда
			РазвернутьНаКлиенте(Строка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСотрудниковИзСоставов(ИдентификаторСтроки = Неопределено)
	
	Если ИдентификаторСтроки = Неопределено Тогда
		Сотрудники.Очистить();
		
		РаботыОбъекта  = ДеревоРабот.ПолучитьЭлементы();
		Для Каждого СтрокаРабота Из РаботыОбъекта Цикл
			РесурсыРабот = СтрокаРабота.ПолучитьЭлементы();
			Для Каждого СтрокаСостава Из РесурсыРабот Цикл
				Если ЗначениеЗаполнено(СтрокаСостава.СоставРесурса) Тогда
					ТаблицаСотрудников = ПолучитьИсполнителейРабот(СтрокаСостава.СоставРесурса);
					
					Для Каждого СтрокаСотрудник из ТаблицаСотрудников Цикл
						НоваяСтрока = Сотрудники.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСотрудник);
						НоваяСтрока.Работа 			= СтрокаСостава.Работа;
						НоваяСтрока.Ресурс 			= СтрокаСостава.Ресурс;
						НоваяСтрока.СоставРесурса 	= СтрокаСостава.СоставРесурса;
						НоваяСтрока.Ид_Строки 		= СтрокаСостава.Ид_Строки;
						
						КадровыеДанныеСотрудника = КадровыйУчет.КадровыеДанныеСотрудников(Истина, НоваяСтрока.Сотрудник, "Организация,ГрафикРаботы", ТекущаяДатаСеанса());
						Если КадровыеДанныеСотрудника.Количество() > 0 Тогда
							НоваяСтрока.ГрафикРаботы = КадровыеДанныеСотрудника[0].ГрафикРаботы;
						КонецЕсли; 

					КонецЦикла;
					
				КонецЕсли;			
			КонецЦикла; 		
		КонецЦикла;
		
	Иначе
		ТекущиеДанные = ДеревоРабот.НайтиПоИдентификатору( ИдентификаторСтроки);
		
		СтрокиКУдалению = Сотрудники.НайтиСтроки(Новый Структура("Работа, Ресурс, Ид_Строки", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.Ид_Строки));
		Для Каждого СтрокаУдаление Из СтрокиКУдалению Цикл
			Сотрудники.Удалить(СтрокаУдаление);
		КонецЦикла;
		
		СтрокиКУдалению = Зарезервировано.НайтиСтроки(Новый Структура("Работа, Ресурс, Ид_Строки", ТекущиеДанные.Работа, ТекущиеДанные.Ресурс, ТекущиеДанные.Ид_Строки));
		Для Каждого СтрокаУдаление Из СтрокиКУдалению Цикл
			Зарезервировано.Удалить(СтрокаУдаление);
		КонецЦикла;

		ТаблицаСотрудников = ПолучитьИсполнителейРабот(ТекущиеДанные.СоставРесурса);
		
		Для Каждого СтрокаСотрудник из ТаблицаСотрудников Цикл
			НоваяСтрока = Сотрудники.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСотрудник);
			НоваяСтрока.Работа 			= ТекущиеДанные.Работа;
			НоваяСтрока.Ресурс 			= ТекущиеДанные.Ресурс;
			НоваяСтрока.СоставРесурса 	= ТекущиеДанные.СоставРесурса;
			НоваяСтрока.Ид_Строки       = ТекущиеДанные.Ид_Строки;
			
			КадровыеДанныеСотрудника = КадровыйУчет.КадровыеДанныеСотрудников(Истина, НоваяСтрока.Сотрудник, "Организация,ГрафикРаботы", ТекущаяДатаСеанса());
			Если КадровыеДанныеСотрудника.Количество() > 0 Тогда
				НоваяСтрока.ГрафикРаботы = КадровыеДанныеСотрудника[0].ГрафикРаботы;
			КонецЕсли; 
						
		КонецЦикла;   
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьИсполнителейРабот(СоставРесурса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УСОERP_СоставРесурсовРабочие.Сотрудник,
	|	УСОERP_СоставРесурсовРабочие.Должность
	|ИЗ
	|	Справочник.УСОERP_СоставРесурсов.Рабочие КАК УСОERP_СоставРесурсовРабочие
	|ГДЕ
	|	УСОERP_СоставРесурсовРабочие.Ссылка = &СоставРесурса
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СоставРесурсовРабочие.НомерСтроки";
	Запрос.УстановитьПараметр("СоставРесурса", СоставРесурса);
	
	Результат = Запрос.Выполнить();
	
	Возврат Результат.Выгрузить();
	
КонецФункции

&НаКлиенте
Функция ВернутьКоординатыВыделеннойОбласти()
	
	
	Если ТабличноеПоле.ВыделенныеОбласти.Количество() > 1 Тогда 
		ПоказатьПредупреждение(,"Выделено более одной области!!!",,"...Ошибка...");
		Возврат Неопределено;
	КонецЕсли;
	Если ТабличноеПоле.ВыделенныеОбласти.Количество() = 0 Тогда 
		ПоказатьПредупреждение(,"Не выделено ни одной области!!!",,"...Ошибка...");
		Возврат Неопределено;
	КонецЕсли;
	
	ВыделеннаяОбласть = ТабличноеПоле.ВыделенныеОбласти.Получить(0);

	Если ВыделеннаяОбласть.Верх <> ВыделеннаяОбласть.Низ Тогда 
	    ПоказатьПредупреждение(,"Ошибка выделения области!!! Выделено более одной строки",,"...Ошибка...");
		Возврат Неопределено;
	КонецЕсли;
	
	КоординатыВыделеннойОбласти = Новый Структура;
	КоординатыВыделеннойОбласти.Вставить("СтрокаВерх",ВыделеннаяОбласть.Верх);
	КоординатыВыделеннойОбласти.Вставить("КолонкаЛево",ВыделеннаяОбласть.Лево);
	КоординатыВыделеннойОбласти.Вставить("КолонкаПраво",ВыделеннаяОбласть.Право);
	
	Возврат КоординатыВыделеннойОбласти;
	
КонецФункции

&НаСервере
Процедура ЗадействоватьРесурсНаСервере(КоординатыВыделеннойОбласти)
	
		
	Если Объект.ОбщееЧислоЧасовРезервирования = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	КЧ_12_2 = Новый КвалификаторыЧисла(12,2);
    Массив = Новый Массив;
    Массив.Добавить(Тип("Число"));
    ОписаниеТиповЧисло_12_2 = Новый ОписаниеТипов(Массив, , ,КЧ_12_2);
		
	ТЗЗарезервировано = Новый ТаблицаЗначений;
	ТЗЗарезервировано.Колонки.Добавить("Сотрудник");
	ТЗЗарезервировано.Колонки.Добавить("Должность");
	ТЗЗарезервировано.Колонки.Добавить("Работа");
	ТЗЗарезервировано.Колонки.Добавить("Ресурс");
	ТЗЗарезервировано.Колонки.Добавить("СоставРесурса");
	ТЗЗарезервировано.Колонки.Добавить("Дата");
	ТЗЗарезервировано.Колонки.Добавить("НомерКолонки");
	ТЗЗарезервировано.Колонки.Добавить("НомерСтрокиРезерв");
	ТЗЗарезервировано.Колонки.Добавить("КоличествоЧасов",ОписаниеТиповЧисло_12_2);
	ТЗЗарезервировано.Колонки.Добавить("ВремяНачала");
	ТЗЗарезервировано.Колонки.Добавить("ВремяОкончания");
	ТЗЗарезервировано.Колонки.Добавить("Ид_Строки");
		
	СтруктураПараметров = ОпределитьСотрудникаПоСтроке(КоординатыВыделеннойОбласти.СтрокаВерх);
	
	Если Не ЗначениеЗаполнено(СтруктураПараметров) Тогда
		Возврат;
	КонецЕсли;
	
	РесурсСотрудник = СтруктураПараметров.Сотрудник;
	 
	Если РесурсСотрудник = Неопределено Тогда 
		Сообщить("Неверно выделена область! выделите область ""Зарезервировано"" напротив сотрудника...",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	
	// Возможность "размазывать" руками указанное количество часов при резервировании
	// ++
	КоличествоДней = (КоординатыВыделеннойОбласти.КолонкаПраво - КоординатыВыделеннойОбласти.КолонкаЛево)+1;
	ОстатокЧасовНаПервыйДень = 0;
	
	ОсновноеКоличествоЧасов = Цел(Объект.ОбщееЧислоЧасовРезервирования/КоличествоДней);
	ОсновноеКоличествоЧасов = Объект.ОбщееЧислоЧасовРезервирования/КоличествоДней; 
	
	КоличествоДнейДляЕжей  = 0; //rarus_BeDm_2014_05_28 -->
	
	Ид_Строки = мТекущийИд_Строки;
	
	Для НомерКолонки = КоординатыВыделеннойОбласти.КолонкаЛево по КоординатыВыделеннойОбласти.КолонкаПраво Цикл 
		
		ДатаКолонки = ОпределитьДатуПоКолонке(НомерКолонки);
		
		Если ДатаКолонки = Неопределено Тогда 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверно выделена область! область выходит за рамки разметки...");
			Возврат;
		КонецЕсли;
		
		Если ОстатокЧасовНаПервыйДень > 0 Тогда
			//rarus_BeDm_2014_05_28 изменим чутка алгоритм -->
			//КоличествоЧасовДляСписания = ОсновноеКоличествоЧасов + ОстатокЧасовНаПервыйДень;
			//ОстатокЧасовНаПервыйДень = 0;
			
			//Вариант 1 более идеальный, но кому-то не понравился
			
			//КоличествоЧасовДляСписания	= ОсновноеКоличествоЧасов + 1;
			//ОстатокЧасовНаПервыйДень 	= ОстатокЧасовНаПервыйДень - 1;
			
			//Вариант 2
			
			Если (КоличествоДней - КоличествоДнейДляЕжей) = ОстатокЧасовНаПервыйДень Тогда
				КоличествоЧасовДляСписания	= ОсновноеКоличествоЧасов + 1;
				ОстатокЧасовНаПервыйДень 	= ОстатокЧасовНаПервыйДень - 1;
			Иначе
				КоличествоЧасовДляСписания = ОсновноеКоличествоЧасов;
			КонецЕсли;
			КоличествоДнейДляЕжей = КоличествоДнейДляЕжей + 1;
			//rarus_BeDm_2014_05_28 <--
		Иначе 
			КоличествоЧасовДляСписания = ОсновноеКоличествоЧасов;
		КонецЕсли;
		
			
		МассивСтрокПоСотруднику = ГрафикРаботыСотрудников.НайтиСтроки(Новый Структура("Сотрудник, Дата", РесурсСотрудник, ДатаКолонки));
		
		Если МассивСтрокПоСотруднику.Количество() >0 Тогда
			СтрутктураГрафик = МассивСтрокПоСотруднику[0];
			Если СтрутктураГрафик.ВидУчетаВремени = Справочники.ВидыИспользованияРабочегоВремени.ВыходныеДни
				ИЛИ СтрутктураГрафик.ВидУчетаВремени = Справочники.ВидыИспользованияРабочегоВремени.Праздники Тогда 
				// Выходной (без обедов и начинается с 1:00 до 23:00)
				НоваяСтрока = ТЗЗарезервировано.Добавить();
				НоваяСтрока.Сотрудник = РесурсСотрудник;
				НоваяСтрока.Должность = СтруктураПараметров.Должность;;
				НоваяСтрока.Работа = СтруктураПараметров.Работа;
				НоваяСтрока.Ресурс = СтруктураПараметров.Ресурс;
				НоваяСтрока.СоставРесурса = СтруктураПараметров.СоставРесурса;
				НоваяСтрока.Дата = ДатаКолонки;
				НоваяСтрока.НомерКолонки = НомерКолонки;
				НоваяСтрока.НомерСтрокиРезерв = КоординатыВыделеннойОбласти.СтрокаВерх;
				//НоваяСтрока.ВремяНачала = ДатаКолонки + 3600;
				//НоваяСтрока.ВремяОкончания = ДатаКолонки + 3600 + ?(КоличествоЧасовДляСписания>22,79200,КоличествоЧасовДляСписания*3600); 
				НоваяСтрока.КоличествоЧасов = КоличествоЧасовДляСписания;
				НоваяСтрока.Ид_Строки = Ид_Строки;
				
				
			ИначеЕсли СтрутктураГрафик.КоличествоЧасов >= КоличествоЧасовДляСписания Тогда 
				
				// поместились в первую половину дня
				НоваяСтрока = ТЗЗарезервировано.Добавить();
				НоваяСтрока.Сотрудник = РесурсСотрудник;
				НоваяСтрока.Должность = СтруктураПараметров.Должность;
				НоваяСтрока.Работа = СтруктураПараметров.Работа;
				НоваяСтрока.Ресурс = СтруктураПараметров.Ресурс;
				НоваяСтрока.СоставРесурса = СтруктураПараметров.СоставРесурса;
				НоваяСтрока.Дата = ДатаКолонки;
				НоваяСтрока.НомерКолонки = НомерКолонки;
				НоваяСтрока.НомерСтрокиРезерв = КоординатыВыделеннойОбласти.СтрокаВерх;
				//НоваяСтрока.ВремяНачала = СтрутктураГрафик.ВремяНачала;
				//НоваяСтрока.ВремяОкончания = СтрутктураГрафик.ВремяНачала + КоличествоЧасовДляСписания*3600;
				НоваяСтрока.КоличествоЧасов = КоличествоЧасовДляСписания;
				НоваяСтрока.Ид_Строки = Ид_Строки;

				
			ИначеЕсли СтрутктураГрафик.КоличествоЧасов < КоличествоЧасовДляСписания Тогда
				// не поместились в первую, переходим на вторую списав всю первую
				НоваяСтрока = ТЗЗарезервировано.Добавить();
				НоваяСтрока.Сотрудник = РесурсСотрудник;
				НоваяСтрока.Должность = СтруктураПараметров.Должность;;
				НоваяСтрока.Работа = СтруктураПараметров.Работа;
				НоваяСтрока.Ресурс = СтруктураПараметров.Ресурс;
				НоваяСтрока.СоставРесурса = СтруктураПараметров.СоставРесурса;
				НоваяСтрока.Дата = ДатаКолонки;
				НоваяСтрока.НомерКолонки = НомерКолонки;
				НоваяСтрока.НомерСтрокиРезерв = КоординатыВыделеннойОбласти.СтрокаВерх;
				//НоваяСтрока.ВремяНачала = СтрутктураГрафик.ВремяНачала;
				//НоваяСтрока.ВремяОкончания = СтрутктураГрафик.ВремяОкончания;
				НоваяСтрока.КоличествоЧасов = СтрутктураГрафик.КоличествоЧасов; 
				НоваяСтрока.Ид_Строки = Ид_Строки;

				КоличествоЧасовДляСписания = КоличествоЧасовДляСписания - СтрутктураГрафик.КоличествоЧасов; 
				
				
				НоваяСтрока = ТЗЗарезервировано.Добавить();
				НоваяСтрока.Сотрудник = РесурсСотрудник;
				НоваяСтрока.Должность = СтруктураПараметров.Должность;;
				НоваяСтрока.Работа = СтруктураПараметров.Работа;
				НоваяСтрока.Ресурс = СтруктураПараметров.Ресурс;
				НоваяСтрока.СоставРесурса = СтруктураПараметров.СоставРесурса;
				НоваяСтрока.Дата = ДатаКолонки;
				НоваяСтрока.НомерКолонки = НомерКолонки;
				НоваяСтрока.НомерСтрокиРезерв = КоординатыВыделеннойОбласти.СтрокаВерх;
				//НоваяСтрока.ВремяНачала = СтрутктураГрафик.ВремяНачала;
				//НоваяСтрока.ВремяОкончания =  ?(КоличествоЧасовДляСписания>СтрутктураГрафик.ЧасовВпериоде,СтрутктураГрафик.ВремяОкончания,СтрутктураГрафик.ВремяНачала + КоличествоЧасовДляСписания*3600);
				НоваяСтрока.КоличествоЧасов = КоличествоЧасовДляСписания;
				НоваяСтрока.Ид_Строки = Ид_Строки;

				
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	ИтогПоЧасам = ТЗЗарезервировано.Скопировать(Новый Структура("Сотрудник,Работа",РесурсСотрудник,СтруктураПараметров.Работа)).Итог("КоличествоЧасов");
	
	Разница =   Объект.ОбщееЧислоЧасовРезервирования - ИтогПоЧасам;
	
	Если Разница <> 0 Тогда
		
		Строка = ТЗЗарезервировано.НайтиСтроки(Новый Структура("Сотрудник,Работа",РесурсСотрудник,СтруктураПараметров.Работа)).Получить(0);
		Строка.КоличествоЧасов = Строка.КоличествоЧасов+Разница;
		
	КонецЕсли;
	
	
	// Найдем строку работ для обновления итогов по Резерву
	ОтборРабота = Новый Структура;
	ОтборРабота.Вставить("Работа", СтруктураПараметров.Работа);
	
	
	
	МассивСтрок = Работы.НайтиСтроки(ОтборРабота);
	Если МассивСтрок.Количество()>0 Тогда 
		НайденнаяСтрокаРабот = МассивСтрок[0];
	Иначе
		Сообщить("Не найдена работа!!! при обновлении итогов...",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ТЗЗарезервировано Цикл 
		
		Отбор = Новый Структура;
		Отбор.Вставить("НомерСтрокиРезерв",ТекСтрока.НомерСтрокиРезерв);
		Отбор.Вставить("НомерКолонки",ТекСтрока.НомерКолонки);
		Отбор.Вставить("Сотрудник",ТекСтрока.Сотрудник);
		Отбор.Вставить("Работа",ТекСтрока.Работа);
		Отбор.Вставить("Ресурс",ТекСтрока.Ресурс);
		Отбор.Вставить("СоставРесурса",ТекСтрока.СоставРесурса);
		Отбор.Вставить("Дата",ТекСтрока.Дата);
		Отбор.Вставить("ВремяНачала",ТекСтрока.ВремяНачала);
		Отбор.Вставить("Ид_Строки", Ид_Строки);

		НайденныеСтрокиРезерв = Зарезервировано.НайтиСтроки(Отбор);
		Если НайденныеСтрокиРезерв.Количество() > 0 Тогда
			// если есть такая строка добавлять не будем
			// а для изменения колличества, пока очищаем и заново ставим
			Продолжить;
		КонецЕсли;
				
		НоваяСтрока = Зарезервировано.Добавить();
		НайденнаяСтрокаРабот.КоличествоЧасовЗарезервировано 		= НайденнаяСтрокаРабот.КоличествоЧасовЗарезервировано + ТекСтрока.КоличествоЧасов; 
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекСтрока);
		
		ОтборВсего = Новый Структура;
		ОтборВсего.Вставить("Дата", 		ТекСтрока.Дата);
		ОтборВсего.Вставить("Сотрудник",	ТекСтрока.Сотрудник);
		ЧасовПоСотруднику 		= Зарезервировано.НайтиСтроки(ОтборВсего);
		ТЗ_ЧасовПоСотруднику 	= Зарезервировано.Выгрузить(ЧасовПоСотруднику, "КоличествоЧасов");
		ЧасовВсего = ТЗ_ЧасовПоСотруднику.Итог("КоличествоЧасов");
		НайденнаяСтрокаРабот.КоличествоЧасовЗарезервированоВсего 	= НайденнаяСтрокаРабот.КоличествоЧасовЗарезервированоВсего + ?(ЧасовВсего <> Неопределено, ЧасовВсего, 0); 
		
		ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв, ТекСтрока.НомерКолонки).Текст = Число(ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв, ТекСтрока.НомерКолонки).Текст) 
																						 + ТекСтрока.КоличествоЧасов;
		ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).Текст = Число(ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).Текст) 
																						 + ТекСтрока.КоличествоЧасов;
		Если  Число(ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв, ТекСтрока.НомерКолонки).Текст) > 8 ИЛИ ВыходнойДень(ТекСтрока.Сотрудник, ТекСтрока.Дата) Тогда 
			ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв, ТекСтрока.НомерКолонки).ЦветФона = WebЦвета.ОранжевоКрасный;
		Иначе 
			
			ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв, ТекСтрока.НомерКолонки).ЦветФона = WebЦвета.Голубой;
		КонецЕсли;
		Если  Число(ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).Текст) > 8 ИЛИ ВыходнойДень(ТекСтрока.Сотрудник, ТекСтрока.Дата) Тогда 
			ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).ЦветФона = WebЦвета.ОранжевоКрасный;
		Иначе 
			
			ТабличноеПоле.Область(ТекСтрока.НомерСтрокиРезерв + 1, ТекСтрока.НомерКолонки).ЦветФона = WebЦвета.Голубой;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ОсвободитьРесурсНаСервере(КоординатыВыделеннойОбласти)
	
	СтруктураПараметров = ОпределитьСотрудникаПоСтроке(КоординатыВыделеннойОбласти.СтрокаВерх);
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров) Тогда
		Возврат;
	КонецЕсли;
	
	РесурсСотрудник = СтруктураПараметров.Сотрудник;
	
	Если РесурсСотрудник = Неопределено Тогда 
		Сообщить("Неверно выделена область! выделите область напротив сотрудника...",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Сотрудник",РесурсСотрудник);
	Отбор.Вставить("Работа",СтруктураПараметров.Работа);
	
	// Найдем строку работ для обновления итогов по Резерву
	ОтборРабота = Новый Структура;
	ОтборРабота.Вставить("Работа",СтруктураПараметров.Работа);
	МассивСтрок = Работы.НайтиСтроки(ОтборРабота);
	Если МассивСтрок.Количество()>0 Тогда 
		НайденнаяСтрокаРабот = МассивСтрок[0];
	Иначе
		Сообщить("Не найдена работа!!! при обновлении итогов...",СтатусСообщения.ОченьВажное);
		Возврат;
	КонецЕсли;

	
	Для НомерКолонки = КоординатыВыделеннойОбласти.КолонкаЛево по КоординатыВыделеннойОбласти.КолонкаПраво Цикл 
		
		Отбор.Вставить("НомерКолонки",		НомерКолонки);
		Отбор.Вставить("НомерСтрокиРезерв",	КоординатыВыделеннойОбласти.СтрокаВерх);
		
		НайденныеСтрокиРезерв = Зарезервировано.НайтиСтроки(Отбор);
		
		ТЗ_Дата = Зарезервировано.Выгрузить(НайденныеСтрокиРезерв, "Дата");
		ТЗ_Дата.Свернуть("Дата");
		Если ТЗ_Дата.Количество() > 0 Тогда
			ДатаКолонки = ТЗ_Дата[0].Дата;
		Иначе 
			ДатаКолонки = Дата(1, 1, 1);
		КонецЕсли;
		
		Для Каждого ТекСтрока Из НайденныеСтрокиРезерв Цикл 
						
			НайденнаяСтрокаРабот.КоличествоЧасовЗарезервировано 		= НайденнаяСтрокаРабот.КоличествоЧасовЗарезервировано - ТекСтрока.КоличествоЧасов;
			Зарезервировано.Удалить(ТекСтрока);
						
		КонецЦикла;
		
		ОтборВсего = Новый Структура;
		ОтборВсего.Вставить("НомерКолонки", НомерКолонки);
		ОтборВсего.Вставить("Сотрудник",	РесурсСотрудник);
		ЧасовПоСотруднику 		= Зарезервировано.НайтиСтроки(ОтборВсего);
		ТЗ_ЧасовПоСотруднику 	= Зарезервировано.Выгрузить(ЧасовПоСотруднику, "КоличествоЧасов");
		КоличествоЧасовЗарезервированоВсего = ТЗ_ЧасовПоСотруднику.Итог("КоличествоЧасов");
		НайденнаяСтрокаРабот.КоличествоЧасовЗарезервированоВсего = ?(КоличествоЧасовЗарезервированоВсего <> Неопределено, КоличествоЧасовЗарезервированоВсего, 0); 
		
		ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх, НомерКолонки).Текст = "0";
		ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх, НомерКолонки).ЦветФона = WebЦвета.Белоснежный;
		ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).Текст = Строка(НайденнаяСтрокаРабот.КоличествоЧасовЗарезервированоВсего);
		Если Число(ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).Текст) = 0 Тогда 
			ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).ЦветФона = WebЦвета.Белоснежный;
		ИначеЕсли  Число(ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).Текст) > 8 ИЛИ ВыходнойДень(РесурсСотрудник, ДатаКолонки) Тогда 
			ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).ЦветФона = WebЦвета.ОранжевоКрасный;
		Иначе 
			ТабличноеПоле.Область(КоординатыВыделеннойОбласти.СтрокаВерх + 1, НомерКолонки).ЦветФона = WebЦвета.Голубой;
		КонецЕсли;
			
		Отбор.Удалить("НомерКолонки");
		Отбор.Удалить("НомерСтрокиРезерв");

	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОпределитьСотрудникаПоСтроке(СтрокаВерх)
	
	Отбор = Новый Структура;
	Отбор.Вставить("НомерСтрокиРезерв", СтрокаВерх);
	Отбор.Вставить("Работа", 			мТекущаяРабота);
	Отбор.Вставить("Ресурс", 			мТекущийРесурс);
	Отбор.Вставить("СоставРесурса", 	мТекущийСоставРесурса);
	Отбор.Вставить("Ид_Строки", 		мТекущийИд_Строки);
	
	
	МассивСотрудников = Сотрудники.НайтиСтроки(Отбор);
	
	Если МассивСотрудников.Количество() = 1 Тогда
		
		ТекСотрудник = МассивСотрудников[0];
		
		СтруктураВозврата = Новый Структура();
		СтруктураВозврата.Вставить("Сотрудник", 	ТекСотрудник.Сотрудник); 
		СтруктураВозврата.Вставить("Должность", 	ТекСотрудник.Должность); 
		СтруктураВозврата.Вставить("Работа", 		ТекСотрудник.Работа);
		СтруктураВозврата.Вставить("Ресурс", 		ТекСотрудник.Ресурс);
		СтруктураВозврата.Вставить("СоставРесурса", ТекСотрудник.СоставРесурса);
		СтруктураВозврата.Вставить("Ид_Строки",     ТекСотрудник.Ид_Строки);
		
		Возврат СтруктураВозврата;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
		
КонецФункции

&НаСервере
Процедура СформироватьОтчетНаСервере(СтруктураПараметров = Неопределено)
	
	мЗапретитьВызовПриАктивизации = Истина;
	
	Если СтруктураПараметров = Неопределено Тогда
		Если ДеревоРабот.ПолучитьЭлементы().Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекущиеДанные = ДеревоРабот.ПолучитьЭлементы()[0];
		Если ТекущиеДанные.ПолучитьЭлементы().Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		ТекущиеДанные = ТекущиеДанные.ПолучитьЭлементы()[0];
