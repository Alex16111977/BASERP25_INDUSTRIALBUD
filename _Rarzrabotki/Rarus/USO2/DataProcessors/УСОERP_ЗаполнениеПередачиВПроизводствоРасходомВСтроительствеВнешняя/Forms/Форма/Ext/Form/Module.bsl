&НаКлиенте
Перем ПредыдущиеРеквизитыШапки; //используется для проверки при изменении реквизитов шапки

&НаКлиенте
Перем ТекущиеДанныеИдентификатор; //используется для передачи текущей строки в обработчик ожидания

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("ОбъектыНазначения") Тогда
		Если Параметры.ОбъектыНазначения.Количество()>0 Тогда
			СсылкаНаДокумент = Параметры.ОбъектыНазначения[0];
		Иначе
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
		
	Если СсылкаНаДокумент.ХозяйственнаяОперация <> Перечисления.ХозяйственныеОперации.ПередачаВПроизводство Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Заполнение расходом в строительстве доступно только для хозяйственной операции: """ + "Передача в производство" + """" + ".");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Объект.ДатаНачала 		= СсылкаНаДокумент.Дата;
	Объект.ДатаОкончания 	= СсылкаНаДокумент.Дата;
	Объект.Организация		= СсылкаНаДокумент.Организация;
	Объект.Подразделение 	= СсылкаНаДокумент.Подразделение;
	Объект.Склад 			= СсылкаНаДокумент.Склад;
		
	ЗаполнитьМатериалыНаСервере();
	
	ЭтаФорма.ЗакрыватьПриЗакрытииВладельца = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПараметрыУказанияСерий = ЭтаФорма.ВладелецФормы.ПараметрыУказанияСерий;  
КонецПроцедуры

#КонецОбласти

