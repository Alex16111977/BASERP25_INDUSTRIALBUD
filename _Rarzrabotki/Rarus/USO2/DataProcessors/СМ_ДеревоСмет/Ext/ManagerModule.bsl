
#Область ОбработчикиСобытийФормы

Процедура УдалитьСметы(ПараметрыВызоваСервера, АдресХранилища) Экспорт
	
	СписокСмет = ПараметрыВызоваСервера.СписокСмет;
	ОчиститьИдРодителяПоТЧСметы = ПараметрыВызоваСервера.ОчиститьИдРодителяПоТЧСметы;
	
	Для Каждого ТекСтрока Из СписокСмет Цикл
		
		Если (ТипЗнч(ТекСтрока.Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета")
			ИЛИ ТипЗнч(ТекСтрока.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета"))
			И НЕ ТекСтрока.СнятиеПометки И ОчиститьИдРодителяПоТЧСметы Тогда
			
			СМ_СметаВызовСервера.ОчиститьИдРодителяПоТЧСметы(ТекСтрока.Смета);				
			
		КонецЕсли;
		
		СМ_СметаВызовСервера.УстановитьСнятьПометкуУдаленияОбъекта(ТекСтрока.Смета,ТекСтрока.СнятиеПометки);
		
		//  При пометке удаления из формы обработки, срабатывает событие при удалении модуля объекта.
		//  В этом событии в зависимости от настроек пользователя удаляются подчиненные документы.
		//  Поиск подчиненных документов идет по ид родителя и по табличной части сметы объекта
		//  поэтому может возникать ситуация, что по ИД родителя документы не связаны, 
		//  но при пометке удаления - отмечаются пометкой удаления несколько документов.
		
	КонецЦикла;
	
	КонецПроцедурыСписокСмет = ПараметрыВызоваСервера.СписокСмет;
	ОчиститьИдРодителяПоТЧСметы = ПараметрыВызоваСервера.ОчиститьИдРодителяПоТЧСметы;
	
	Для Каждого ТекСтрока Из СписокСмет Цикл
		
		Если (ТипЗнч(ТекСтрока.Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета")
			ИЛИ ТипЗнч(ТекСтрока.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета"))
			И НЕ ТекСтрока.СнятиеПометки И ОчиститьИдРодителяПоТЧСметы Тогда
			
			СМ_СметаВызовСервера.ОчиститьИдРодителяПоТЧСметы(ТекСтрока.Смета);    
			
		КонецЕсли;
		
		СМ_СметаВызовСервера.УстановитьСнятьПометкуУдаленияОбъекта(ТекСтрока.Смета,ТекСтрока.СнятиеПометки);
		
		//  При пометке удаления из формы обработки, срабатывает событие при удалении модуля объекта.
		//  В этом событии в зависимости от настроек пользователя удаляются подчиненные документы.
		//  Поиск подчиненных документов идет по ид родителя и по табличной части сметы объекта
		//  поэтому может возникать ситуация, что по ИД родителя документы не связаны, 
		//  но при пометке удаления - отмечаются пометкой удаления несколько документов.
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
