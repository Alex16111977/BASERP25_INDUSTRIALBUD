&НаКлиенте
Процедура СкопироватьСмету(Команда)
	
	ОтключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания");

	ФоновоеЗадание 	= Ложь;
	ТекДанные 		= Элементы.СписокСметы.ТекущиеДанные;
	ТекСмета		= ТекДанные.Ссылка;
	
	Если ТипЗнч(ТекСмета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		
		ТекОперация	= "СкопироватьЛокальнуюСметуДлительнаяОперация";
		
		СтруктураПараметров = Новый Структура; 	
		СтруктураПараметров.Вставить("СтараяСмета", ТекСмета);
		СтруктураПараметров.Вставить("Корректировка", Ложь);
		СтруктураПараметров.Вставить("Транзакция", Ложь);
		СтруктураПараметров.Вставить("ВАрхив", Ложь);
		СтруктураПараметров.Вставить("Перерасчет", Истина);
		
		ВыполнитьФоновоеЗаданиеНаСервере(АдресХранилища,ФоновоеЗадание,ТекСмета,СтруктураПараметров,ТекОперация);
		Если ФоновоеЗадание Тогда
			ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
			ПодключитьОбработчикОжидания("ФоновоеЗаданиеНаКлиенте",1,Истина);
			ПараметрыОбработчика.МаксимальныйИнтервал = 5;
			ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, ИдентификаторЗадания);
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ТекСмета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		
		ТекОперация	= "СкопироватьОбъектнуюСметуДлительнаяОперация";
		
		СтруктураПараметров = Новый Структура; 	
		СтруктураПараметров.Вставить("СтараяСмета", ТекСмета);
		СтруктураПараметров.Вставить("Транзакция", Истина);
		СтруктураПараметров.Вставить("ВАрхив", Ложь);
		СтруктураПараметров.Вставить("Перерасчет", Истина);
		
		СтруктураОповещения = Новый Структура;
		СтруктураОповещения.Вставить("Операция",ТекОперация);
		СтруктураОповещения.Вставить("Параметры",СтруктураПараметров);
		СтруктураОповещения.Вставить("Смета",ТекСмета);
		
		ТекстВопроса = "Смета будет скопирована. Вы точно уверены?";
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаВопросаКопированияСметы",ЭтотОбъект,СтруктураОповещения),ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	ИначеЕсли ТипЗнч(ТекДанные.Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		
		ТекОперация	= "СкопироватьСводнуюСметуДлительнаяОперация";
		
		СтруктураПараметров = Новый Структура; 	
		СтруктураПараметров.Вставить("СтараяСмета", ТекСмета);
		СтруктураПараметров.Вставить("ВАрхив", Ложь);
		СтруктураПараметров.Вставить("Перерасчет", Истина);
		
		СтруктураОповещения = Новый Структура;
		СтруктураОповещения.Вставить("Операция",ТекОперация);
		СтруктураОповещения.Вставить("Параметры",СтруктураПараметров);
		СтруктураОповещения.Вставить("Смета",ТекСмета);
		
		ТекстВопроса = "Смета будет скопирована. Вы точно уверены?";
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаВопросаКопированияСметы",ЭтотОбъект,СтруктураОповещения),ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	Иначе	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Копирование данного типа смет запрещено.'"));
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКорректировку(Команда)
	
	ТекДанные = Элементы.СписокСметы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если ТипЗнч(ТекДанные.Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			СМ_СметаВызовСервера.СкопироватьЛокальнуюСмету(ТекДанные.Ссылка,Истина,Ложь,,,Ложь,Истина);
			ТекСтройка = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
			Если ТекСтройка = Неопределено Тогда
				ОбновитьДеревоСметСервер();
			Иначе
				ОбновитьДеревоСметСервер(ТекСтройка.Ссылка);
			КонецЕсли;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Копирование данного типа смет запрещено.'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСметуНаОстаток(Команда)
	
	ТекДанные = Элементы.СписокСметы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если ТипЗнч(ТекДанные.Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			НовСмета = СМ_СметаВызовСервера.СоздатьЛокальнуюСметуНаОстаток(ТекДанные.Ссылка);
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("СтараяСмета",ТекДанные.Ссылка);
			СтруктураПараметров.Вставить("Ключ",НовСмета);
			СтруктураПараметров.Вставить("НаОстаток",Истина);
			
			Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеЗакрытияФормаОбъекта", ЭтотОбъект);

			ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.ФормаОбъекта",СтруктураПараметров,,,,,Оповещение);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Создание документа ""На остаток"" для данного типа смет запрещено.'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

