&НаКлиенте
Процедура РежимОтображенияДерева(Команда)
	
	Элементы.РежимОтображенияДерева.Пометка = Не Элементы.РежимОтображенияДерева.Пометка;
	Если Элементы.РежимОтображенияДерева.Пометка Тогда
		Элементы.СписокОбъектыСтроительства.Видимость = Истина;
		ТекДанные = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			ОбновитьДеревоСметСервер(ТекущаяСтройка);
		Иначе
			ОбновитьДеревоСметСервер(ТекДанные.Ссылка);
		КонецЕсли;
	Иначе
		Элементы.СписокОбъектыСтроительства.Видимость = Ложь;
		ОбновитьДеревоСметСервер();
	КонецЕсли;
	
