&НаКлиенте
Процедура НайтиРесурс(Команда)
	
	Подсказка = "Введите строку для поиска ресурсов";
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтрокиПоиска",ЭтотОбъект);
	ПоказатьВводСтроки(Оповещение,"",Подсказка,0,Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПоискРесурса(Команда)
	
	Если Элементы.СписокОбъектыСтроительства.ТекущиеДанные <> Неопределено Тогда
		ТекОбъектСтроительства = Элементы.СписокОбъектыСтроительства.ТекущиеДанные.Ссылка;
	Иначе
		ТекОбъектСтроительства = Неопределено;
	КонецЕсли;
	ОбновитьДеревоСметСервер(ТекОбъектСтроительства);
	Элементы.СписокСметыОтменитьПоискРесурса.Доступность = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтрокиПоиска(Строка,Параметры) Экспорт
	
	Если ЗначениеЗаполнено(Строка) Тогда
		Если Элементы.СписокОбъектыСтроительства.ТекущиеДанные <> Неопределено Тогда
			ТекОбъектСтроительства = Элементы.СписокОбъектыСтроительства.ТекущиеДанные.Ссылка;
		Иначе
			ТекОбъектСтроительства = Неопределено;
		КонецЕсли;
		ОбновитьДеревоСметСервер(ТекОбъектСтроительства,Строка);
		Элементы.СписокСметыОтменитьПоискРесурса.Доступность = Истина;
	Иначе
		Элементы.СписокСметыОтменитьПоискРесурса.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры 

#Область КопированиеСметДлительныеОперации

&НаКлиенте
Процедура ОбработкаВопросаКопированияСметы(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ФоновоеЗадание = Ложь;
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ВыполнитьФоновоеЗаданиеНаСервере(АдресХранилища,ФоновоеЗадание,ДополнительныеПараметры.Смета,ДополнительныеПараметры.Параметры,ДополнительныеПараметры.Операция);
		Если ФоновоеЗадание Тогда
			ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
			ПодключитьОбработчикОжидания("ФоновоеЗаданиеНаКлиенте",1,Истина);
			ПараметрыОбработчика.МаксимальныйИнтервал = 5;
			ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, ИдентификаторЗадания);
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВыполнитьФоновоеЗаданиеНаСервере(АдресХранилища,ФоновоеЗадание = Ложь,ТекСмета,СтруктураПараметров,ТекОперация)
	
	РезультатФоновогоЗадания = ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
	"СМ_СметаВызовСервера." + ТекОперация,СтруктураПараметров, НСтр("ru = 'Копирование сметы'"));

	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		ОбновитьДеревоСметСервер();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Фоновое задание копирования сметы закончено!'"));
	Иначе
		ФоновоеЗадание 			= Истина;
		ИдентификаторЗадания  	= РезультатФоновогоЗадания.ИдентификаторЗадания;
		АдресХранилища 			= РезультатФоновогоЗадания.АдресХранилища;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗаданиеНаКлиенте()
	
	Результат = ФоновоеЗаданиеПолучитьРезультат();
	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		
		ТекСтройка = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
		Если ТекСтройка = Неопределено Тогда
			ОбновитьДеревоСметСервер();
		Иначе
			ОбновитьДеревоСметСервер(ТекСтройка.Ссылка);
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Фоновое задание копирования сметы закончено!'"));
	Иначе
		ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ФоновоеЗаданиеПолучитьРезультат()
	
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРасчеты(Команда)
	ПараметрыФормы = Новый Структура("ВыбранныйДокумент", Элементы.СписокСметы.ТекущиеДанные.Смета);
	ОткрытьФорму("ОбщаяФорма.СМ_ИтогиПоДокументу", ПараметрыФормы); 
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбновлениеДереваСметФоновое

&НаКлиенте
Процедура ОбновитьДеревоСметФоноваяКлиент(ТекОбъект)

	ПустойИдентификатор = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Если ИдентификаторОбновлениеДерева = ПустойИдентификатор Тогда
		ДлительнаяОперацияДерево = ОбновитьДеревоВФоне(ТекОбъект);
	Иначе
		ДлительнаяОперацияДерево = ОбновитьДеревоВФоне(ТекОбъект,Истина,ИдентификаторОбновлениеДерева);
	КонецЕсли;
	
    ЗапуститьПроверкуФоновогоЗаданияОбновитьДеревоСмет(ДлительнаяОперацияДерево);

КонецПроцедуры

&НаСервере
Функция ОбновитьДеревоВФоне(ТекОбъект,ПерезапускЗадания = Ложь, ИдентификаторЗадания = Неопределено)
	
	Если ПерезапускЗадания Тогда
		ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания); 
	КонецЕсли;

	ПараметрыЗапуска = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗапуска.НаименованиеФоновогоЗадания = НСтр("ru = 'Обновление дерева смет'");
	
	ДеревоЗначений 	= РеквизитФормыВЗначение("СписокСметы", Тип("ДеревоЗначений"));
	ДеревоЗначений.Строки.Очистить();
	
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("ТекОбъект",ТекОбъект);
	ПараметрыВыполнения.Вставить("СтрокаРесурса","");
	ПараметрыВыполнения.Вставить("ДеревоЗначений",ДеревоЗначений);
	
	ДлительнаяОперация 				= ДлительныеОперации.ВыполнитьВФоне("СМ_СметныйСоставВызовСервера.ОбновитьДеревоСмет",ПараметрыВыполнения, ПараметрыЗапуска);
	ИдентификаторОбновлениеДерева 	= ДлительнаяОперация.ИдентификаторЗадания;
	
	Если ДлительнаяОперация.Статус = "Выполнено" Тогда
		ЗаполнитьДеревоПослеОбновленияВФоне(ДлительнаяОперация);
		Возврат Неопределено;
	Иначе
		УстановитьСостояниеОбновленияДереваСмет(Ложь);
		Возврат ДлительнаяОперация;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДеревоПослеОбновленияВФоне(Результат)
	
	УстановитьСостояниеОбновленияДереваСмет(Истина);
	ТекДеревоЗначений = ПолучитьИзВременногоХранилища(Результат.АдресРезультата); 
	ЗначениеВРеквизитФормы(ТекДеревоЗначений,"СписокСметы");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСостояниеОбновленияДереваСмет(ДеревоПолучено)
	
	Элементы.СписокСметы.Видимость 									= ДеревоПолучено;
	Элементы.ГруппаОжиданиеЗаполненияПлатежныхДокументов.Видимость 	= НЕ ДеревоПолучено;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьПроверкуФоновогоЗаданияОбновитьДеревоСмет(ДлительнаяОперация)
	
	Если ДлительнаяОперация <> Неопределено Тогда
		ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
		
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбновитьДеревоСметЗавершение", ЭтотОбъект);
		ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоСметЗавершение(ДлительнаяОперация, ДополнительныеПараметры) Экспорт
	
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ДлительнаяОперация.Статус = "Ошибка" Тогда
		ПоказатьОшибкуОбновленияДереваСмет(ДлительнаяОперация);
	Иначе
		ЗаполнитьДеревоПослеОбновленияВФоне(ДлительнаяОперация);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибкуОбновленияДереваСмет(ДлительнаяОперация)
	
	УстановитьСостояниеОбновленияДереваСмет(Истина);
	
	Текст = НСтр("ru = 'Ошибка при обновлении дерева смет:'");
	Предупреждение = Новый Структура;
	Предупреждение.Вставить("Текст",    Текст + Символы.ПС + ДлительнаяОперация.КраткоеПредставлениеОшибки);
	Предупреждение.Вставить("Подробно", ДлительнаяОперация.ПодробноеПредставлениеОшибки);
	СтандартныеПодсистемыКлиент.ВывестиПредупреждение(ЭтотОбъект, Предупреждение);
	
КонецПроцедуры

