	               |			СУММА(СМ_ИтогиПоГлавамОС.ПрямЗатраты) КАК СуммаБазис,
	               |			СУММА(СМ_ИтогиПоГлавамОС.ТекПрямЗатраты) КАК СуммаТек
	               |		ИЗ
	               |			РегистрСведений.СМ_ИтогиПоГлавамОС КАК СМ_ИтогиПоГлавамОС
	               |		ГДЕ
	               |			СМ_ИтогиПоГлавамОС.Итог ССЫЛКА Справочник.СМ_ЛимитированныеЗатраты
	               |			И СМ_ИтогиПоГлавамОС.Смета ССЫЛКА Документ.СМ_ОбъектнаяСмета
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СМ_ИтогиПоГлавамОС.Смета,
	               |			СМ_ИтогиПоГлавамОС.Итог) КАК ЛимЗатратыОС
	               |		ПО СМ_ОбъектнаяСметаЛимитированныеЗатраты.Ссылка = ЛимЗатратыОС.Смета
	               |			И СМ_ОбъектнаяСметаЛимитированныеЗатраты.ЛимитированнаяЗатрата.Ссылка = ЛимЗатратыОС.Итог
	               |ГДЕ
	               |	СМ_ОбъектнаяСметаЛимитированныеЗатраты.Ссылка.Стройка = &ОбъектСтроительства
	               |	И СМ_ОбъектнаяСметаЛимитированныеЗатраты.Ссылка = &ТекДокумент
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СМ_СводнаяСметаЛимитированныеЗатраты.Ссылка,
	               |	СМ_СводнаяСметаЛимитированныеЗатраты.ЛимитированнаяЗатрата.Ссылка,
	               |	СМ_СводнаяСметаЛимитированныеЗатраты.Ссылка,
	               |	СМ_СводнаяСметаЛимитированныеЗатраты.Ссылка.Стройка,
	               |	СМ_СводнаяСметаЛимитированныеЗатраты.ЛимитированнаяЗатрата.Обоснование,
	               |	СМ_СводнаяСметаЛимитированныеЗатраты.ЛимитированнаяЗатрата.Наименование,
	               |	СМ_СводнаяСметаЛимитированныеЗатраты.Ссылка.ПометкаУдаления КАК ПометкаУдаления,
	               |	4,
	               |	0,
	               |	ЛимЗатратыСС.СуммаБазис,
	               |	ЛимЗатратыСС.СуммаТек
	               |ИЗ
	               |	Документ.СМ_СводнаяСмета.ЛимитированныеЗатраты КАК СМ_СводнаяСметаЛимитированныеЗатраты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СМ_ИтогиПоГлавамСС.Смета КАК Смета,
	               |			СМ_ИтогиПоГлавамСС.Итог КАК Итог,
	               |			СУММА(СМ_ИтогиПоГлавамСС.ПрямЗатраты) КАК СуммаБазис,
	               |			СУММА(СМ_ИтогиПоГлавамСС.ТекПрямЗатраты) КАК СуммаТек
	               |		ИЗ
	               |			РегистрСведений.СМ_ИтогиПоГлавамСС КАК СМ_ИтогиПоГлавамСС
	               |		ГДЕ
	               |			СМ_ИтогиПоГлавамСС.Итог ССЫЛКА Справочник.СМ_ЛимитированныеЗатраты
	               |			И СМ_ИтогиПоГлавамСС.Смета ССЫЛКА Документ.СМ_СводнаяСмета
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СМ_ИтогиПоГлавамСС.Смета,
	               |			СМ_ИтогиПоГлавамСС.Итог) КАК ЛимЗатратыСС
	               |		ПО СМ_СводнаяСметаЛимитированныеЗатраты.Ссылка = ЛимЗатратыСС.Смета
	               |			И СМ_СводнаяСметаЛимитированныеЗатраты.ЛимитированнаяЗатрата.Ссылка = ЛимЗатратыСС.Итог
	               |ГДЕ
	               |	СМ_СводнаяСметаЛимитированныеЗатраты.Ссылка.Стройка = &ОбъектСтроительства
	               |	И СМ_СводнаяСметаЛимитированныеЗатраты.Ссылка = &ТекДокумент";
				   
	Запрос.Текст = ТекстЗапроса;
	ИтогПоСмете = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ИтогСметыДляДерева");
	Если Не ИтогПоСмете = Неопределено
		И ИтогПоСмете.Пустая() Тогда
		ИтогПоСмете = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4");
	КонецЕсли;
	Запрос.УстановитьПараметр("ТекДокумент",ТекДокумент);
	Запрос.УстановитьПараметр("ИтогПоСмете",ИтогПоСмете);
	Запрос.УстановитьПараметр("ОбъектСтроительства",ТекДокумент.Стройка);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;
	
КонецФункции

&НаКлиенте
Процедура СписокОбъектыСтроительстваПриАктивизацииСтроки(Элемент)
	
	ОбновлятьДеревоСметВФоне = Ложь;
	
	ТекДанные = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПредыдущаяСтройка 	= ТекущаяСтройка;
		ТекущаяСтройка 		= ТекДанные.Ссылка;
		Если ТекущаяСтройка <> ПредыдущаяСтройка Тогда
			ТекОбъектСтроительства = ТекДанные.Ссылка;       	
			Если Не НеОбновлять Тогда
				Если ОбновлятьДеревоСметВФоне Тогда
					ОбновитьДеревоСметФоноваяКлиент(ТекОбъектСтроительства);
				Иначе
					ОбновитьДеревоСметСервер(ТекОбъектСтроительства);	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПодчиненныеНаСервере(ТекЭлемент)

	Если ТипЗнч(ТекЭлемент) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
		Возврат;	
	КонецЕсли;
	
	ТабРезультат = ПолучитьПодчиненныеДокументы(ТекЭлемент);
	ТабРезультат.Сортировать("Сортировка Возр, Родитель Убыв, Смета Возр");
		
	ДеревоЗначений = РеквизитФормыВЗначение("СписокСметы", Тип("ДеревоЗначений"));
	НайденнаяСтрока = ДеревоЗначений.Строки.Найти(ТекЭлемент,"Смета",Истина);	
	// ДокторСофт
	Если НайденнаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// ДокторСофт
	НайденнаяСтрока.Строки.Очистить();
	Для Каждого ТекСтрока Из ТабРезультат Цикл
		НайденнаяСтрока2 = ДеревоЗначений.Строки.Найти(ТекСтрока.Родитель,"Смета",Истина);	
		Если НайденнаяСтрока <> Неопределено Тогда
			СтрокаДерева = НайденнаяСтрока2.Строки.Добавить();	
		Иначе
			СтрокаДерева = НайденнаяСтрока.Строки.Добавить();	
		КонецЕсли;			
		ЗаполнитьЗначенияСвойств(СтрокаДерева,ТекСтрока);
		СтрокаДерева.Картинка 		 = ПолучитьКартинкуСтроки(СтрокаДерева.Ссылка, СтрокаДерева.ПометкаУдаления);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначений,"СписокСметы");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПодчиненные(Команда)
	
	ТекДанные 	= Элементы.СписокСметы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекЭлемент 	= ТекДанные.Смета;      	
	    ОбновитьПодчиненныеНаСервере(ТекЭлемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьСтруктуруПараметровСметы() 
	
	ТекДанные = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
	СтруктураПараметров = Новый Структура;
	Если ТекДанные <> Неопределено Тогда
		СтруктураПараметров.Вставить("Стройка",ТекДанные.Ссылка);
	КонецЕсли;

	Возврат СтруктураПараметров;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьЛС(Команда)
	
	СтруктураПараметров = СформироватьСтруктуруПараметровСметы();
	ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаДокументаУпр",СтруктураПараметров,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЛСизШаблона(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораШаблонаСметы", ЭтаФорма);
	ОткрытьФорму("Справочник.СМ_ШаблоныСмет.ФормаВыбора",,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораШаблонаСметы(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = СформироватьСтруктуруПараметровСметы();
	СтруктураПараметров.Вставить("ШаблонСмет", Результат);
	ОткрытьФорму("Документ.СМ_ЛокальнаяСмета.Форма.ФормаДокументаУпр",СтруктураПараметров,ЭтаФорма,,ВариантОткрытияОкна.ОтдельноеОкно,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьОС(Команда)
	
	СтруктураПараметров = СформироватьСтруктуруПараметровСметы();
	ОткрытьФорму("Документ.СМ_ОбъектнаяСмета.Форма.ФормаДокументаУпр",СтруктураПараметров,ЭтаФорма);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ДобавитьСС(Команда)
	
	СтруктураПараметров = СформироватьСтруктуруПараметровСметы();
	ОткрытьФорму("Документ.СМ_СводнаяСмета.Форма.ФормаДокументаУпр",СтруктураПараметров,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСмету()
	
	ТекДанные = Элементы.СписокСметы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
	
		ЛимЗатрата = Неопределено;
		Если ТипЗнч(ТекДанные.Ссылка) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			ЛимЗатрата = ТекДанные.Ссылка;
			Если ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда 	
				ТекИмяФормы = "Документ.СМ_ЛокальнаяСмета.Форма.ФормаДокументаУпр";
			ИначеЕсли ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда 	
				ТекИмяФормы = "Документ.СМ_ОбъектнаяСмета.Форма.ФормаДокументаУпр";
			ИначеЕсли ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда 	
				ТекИмяФормы = "Документ.СМ_СводнаяСмета.Форма.ФормаДокументаУпр";
			Иначе
				Возврат;
			КонецЕсли;
		ИначеЕсли ТипЗнч(ТекДанные.Ссылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда 	
			ТекИмяФормы = "Документ.СМ_ЛокальнаяСмета.Форма.ФормаДокументаУпр";
		ИначеЕсли ТипЗнч(ТекДанные.Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда 	
			ТекИмяФормы = "Документ.СМ_ОбъектнаяСмета.Форма.ФормаДокументаУпр";
		ИначеЕсли ТипЗнч(ТекДанные.Ссылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда 	
			ТекИмяФормы = "Документ.СМ_СводнаяСмета.Форма.ФормаДокументаУпр";
		Иначе 
			Возврат;
		КонецЕсли;
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Ссылка",ТекДанные.Смета);
		СтруктураПараметров.Вставить("Ключ",ТекДанные.Смета);
		Если Не ЛимЗатрата = Неопределено Тогда
			СтруктураПараметров.Вставить("ЛимЗатрата",ЛимЗатрата);
		КонецЕсли;
		ОткрытьФорму(ТекИмяФормы,СтруктураПараметров);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСмету(Команда)
	
	УдалитьСметуВыполнить();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПослеУдаления(Ответ, СписокСмет) Экспорт

	ОчиститьИдРодителяПоТЧСметы = Ложь;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ОчиститьИдРодителяПоТЧСметы = Истина;
	КонецЕсли;	
	
	РезультатФоновогоЗадания = ЗапуститьУдалениеВФоне(Новый Структура("СписокСмет, ОчиститьИдРодителяПоТЧСметы", СписокСмет, ОчиститьИдРодителяПоТЧСметы));	
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		ТекСтрока = Неопределено;
		СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ТекСтрока, Элементы.СписокСметы.ТекущиеДанные, Элементы.СписокСметы, СписокСметы.ПолучитьЭлементы(), "Ссылка");
			
		Если Элементы.СписокОбъектыСтроительства.ТекущиеДанные <> Неопределено Тогда
			ТекОбъектСтроительства = Элементы.СписокОбъектыСтроительства.ТекущиеДанные.Ссылка;
		Иначе
			ТекОбъектСтроительства = Неопределено;
		КонецЕсли;
		ОбновитьДеревоСметСервер(ТекОбъектСтроительства);
		
		СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.СписокСметы, СписокСметы.ПолучитьЭлементы(), СписокСметы, ТекСтрока, "Ссылка");
	Иначе
		ФоновоеЗаданиеИдентификатор = РезультатФоновогоЗадания.ИдентификаторЗадания;
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеУдалениеСметНаКлиенте", 3, Истина);
		ПараметрыОбработчика.МаксимальныйИнтервал = 5;
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, ФоновоеЗаданиеИдентификатор);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСметуВыполнить()
	
	СписокСмет = Новый Массив;
	
	ВопросБылЗадан = Ложь;
	
	Для Каждого ТекИдентификатор Из Элементы.СписокСметы.ВыделенныеСтроки Цикл
	
		ТекДанные = СписокСметы.НайтиПоИдентификатору(ТекИдентификатор);
		Если ТекДанные = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Снятие пометки
		Если ТекДанные.ПометкаУдаления Тогда
			СнятиеПометки = Истина;
		// Установка пометки
		Иначе 
			СнятиеПометки = Ложь;
		КонецЕсли;

		// При переносе в дерево - предварительно очищаем ИдРодителя у документов.
		// При удалении - стандартная процедура удаления.
		Если ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") 
			ИЛИ ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			Если НЕ СнятиеПометки И Не ВопросБылЗадан  Тогда
				ВопросБылЗадан = Истина;
			КонецЕсли;
		КонецЕсли;
		
		СписокСмет.Добавить(Новый Структура("Смета, СнятиеПометки", ТекДанные.Смета, СнятиеПометки));
	
	КонецЦикла;	
	
	Если ВопросБылЗадан Тогда
	
		ОписаниеОповещения = Новый ОписаниеОповещения("ВопросПослеУдаления", ЭтаФорма, СписокСмет);
		ПоказатьВопрос(ОписаниеОповещения, НСтр("ru='Удалять входящие в состав сметы? (Да - сметы будут удалены, Нет - сметы будут перенесены в дерево)'"), РежимДиалогаВопрос.ДаНет); 
	
	Иначе
		
		ВопросПослеУдаления(КодВозвратаДиалога.Да, СписокСмет);
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ЗапуститьУдалениеВФоне(ПараметрыВызоваСервера)
	Возврат ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
		"Обработки.СМ_ДеревоСмет.УдалитьСметы",
		ПараметрыВызоваСервера, 
		НСтр("ru = 'Выполняется удаление смет'"));
	
КонецФункции

&НаКлиенте
Процедура ФоновоеЗаданиеУдалениеСметНаКлиенте()
	
	Результат = ФоновоеЗаданиеУдалениеСметыПолучитьРезультат();
	
	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации <> Неопределено Тогда 
			Если ФормаДлительнойОперации.Открыта() 
				И ФормаДлительнойОперации.ИдентификаторЗадания = ФоновоеЗаданиеИдентификатор Тогда
					ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			КонецЕсли;
		КонецЕсли;
		
		ТекСтрока = Неопределено;
		СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(ТекСтрока, Элементы.СписокСметы.ТекущиеДанные, Элементы.СписокСметы, СписокСметы.ПолучитьЭлементы(), "Ссылка");
			
		Если Элементы.СписокОбъектыСтроительства.ТекущиеДанные <> Неопределено Тогда
			ТекОбъектСтроительства = Элементы.СписокОбъектыСтроительства.ТекущиеДанные.Ссылка;
		Иначе
			ТекОбъектСтроительства = Неопределено;
		КонецЕсли;
		ОбновитьДеревоСметСервер(ТекОбъектСтроительства);
		
		СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.СписокСметы, СписокСметы.ПолучитьЭлементы(), СписокСметы, ТекСтрока, "Ссылка");

	Иначе
		ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеУдалениеСметНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
		Если ФормаДлительнойОперации = Неопределено Тогда
			ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, ФоновоеЗаданиеИдентификатор);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ФоновоеЗаданиеУдалениеСметыПолучитьРезультат()
	
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(ФоновоеЗаданиеИдентификатор);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СписокСметыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьСмету();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// СтандартныеПодсистемы.Интеграция1СБухфон
	Если Элементы.Найти("ОбщаяКомандаЗапустить1СБухфон") <> Неопределено Тогда
		ВызовОнлайнПоддержкиКлиент.ОбработкаОповещения(ИмяСобытия, Элементы.ОбщаяКомандаЗапустить1СБухфон);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Интеграция1СБухфон
	
	Если ИмяСобытия = "ОбновитьДеревоСмет" Тогда
		//  Сохранение текущей строки дерева
		СтрокаДерева 	= Неопределено;
		ТекДанные 		= Элементы.СписокСметы.ТекущиеДанные;
		СМ_СметныйСоставКлиент.СохранитьТекущийЭлемент(СтрокаДерева, ТекДанные, Элементы.СписокСметы, СписокСметы.ПолучитьЭлементы(),"Смета");
		
		
		Если ТипЗнч(Параметр) = Тип("Структура") Тогда
			Если Параметр.Свойство("Смета") Тогда
				ТекСмета = Параметр.Смета;
				Если ЗначениеЗаполнено(ТекСмета) Тогда
					СтрокаДерева.ТекущийЭлемент = ТекСмета;
				КонецЕсли;
				ОбновитьПодчиненныеНаСервере(ТекСмета);
				Если Параметр.Свойство("Стройка") Тогда
					ТекСтройка =  Параметр.Стройка;
					Если Элементы.РежимОтображенияДерева.Пометка Тогда
						Элементы.СписокОбъектыСтроительства.ТекущаяСтрока = Параметр.Стройка;
						ОбновитьДеревоСметСервер(Параметр.Стройка);
					Иначе
						ОбновитьДеревоСметСервер();
					КонецЕсли;
				Иначе
					ОбновитьДеревоСметСервер();
				КонецЕсли;
			ИначеЕсли Параметр.Свойство("Стройка") Тогда
				ТекСтройка =  Параметр.Стройка;
				Если Элементы.РежимОтображенияДерева.Пометка Тогда
					ОбновитьДеревоСметСервер(Параметр.Стройка);
				Иначе
					ОбновитьДеревоСметСервер();
				КонецЕсли;
			Иначе
				ОбновитьДеревоСметСервер();
			КонецЕсли;
		Иначе
			Если Элементы.РежимОтображенияДерева.Пометка Тогда
				ОбновитьДеревоСметСервер(Элементы.СписокОбъектыСтроительства.ТекущаяСтрока);
			Иначе
				ОбновитьДеревоСметСервер();
			КонецЕсли;
		КонецЕсли;
		
		//  Восстановление текущей строки дерева
		Если СтрокаДерева <> Неопределено Тогда
			СМ_СметныйСоставКлиент.ВосстановитьТекущийЭлемент(Элементы.СписокСметы, СписокСметы.ПолучитьЭлементы(), СписокСметы, СтрокаДерева, "Смета");
		КонецЕсли;
		
	КонецЕсли;

	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДерево(Команда)
	
	ТекДанные = Элементы.СписокОбъектыСтроительства.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		ОбновитьДеревоСметСервер();
	Иначе
		ОбновитьДеревоСметСервер(ТекДанные.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьАкты(Команда)
	
	ТекДанные = Элементы.СписокСметы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		
		Если ТипЗнч(ТекДанные.Ссылка) <> Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			Возврат;	
		КонецЕсли;
		
		ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.Форма.ФормаСпискаУпр",Новый Структура("СметаСсылка",ТекДанные.Ссылка),ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузкаАРПС(Команда)
	
	ТекДанные = Элементы.СписокСметы.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		
		СписокЛС = ПолучитьСписокЛС(ТекДанные.Ссылка);
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("СписокЛС",СписокЛС);
		
		ОткрытьФорму("Обработка.СМ_ОбменДаннымиВФорматеАРПС.Форма.Форма",СтруктураПараметров);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЛС(ТекСсылка)
	
	ТекОбъект	= ТекСсылка.ПолучитьОбъект();
	СписокЛС 	= Новый Массив;
	
	//  Добавление разделов и позиций подчиненных документов
	Если ТипЗнч(ТекСсылка) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		Для Каждого ТекСтрока2 Из ТекОбъект.Сметы Цикл
			Если ТипЗнч(ТекСтрока2.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
				Для Каждого ТекСтрока3 Из ТекСтрока2.Смета.ЛокальныеСметы Цикл
					СписокЛС.Добавить(ТекСтрока3.ЛокальнаяСмета);			
				КонецЦикла;
			ИначеЕсли ТипЗнч(ТекСтрока2.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда	
				СписокЛС.Добавить(ТекСтрока2.Смета);		
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(ТекСсылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Для Каждого ТекСтрока3 Из ТекОбъект.ЛокальныеСметы Цикл
			СписокЛС.Добавить(ТекСтрока3.ЛокальнаяСмета);			
		КонецЦикла;
	ИначеЕсли ТипЗнч(ТекСсылка) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СписокЛС.Добавить(ТекСсылка);
	КонецЕсли;

	Возврат СписокЛС;	
	
КонецФункции

&НаКлиенте
Процедура ГрупповаяОбработкаПозиций(Команда)
	
	ТекДанные = Элементы.СписокСметы.ТекущиеДанные;
	
