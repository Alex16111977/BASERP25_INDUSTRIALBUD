&НаСервере
Функция ОбработкаВыгрузитьESTML (СписокВыгрузки,ТекДанные)
	Если ТипЗнч(ТекДанные) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СписокВыгрузки.Добавить(ТекДанные);
	ИначеЕсли ТипЗнч(ТекДанные) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		Для каждого Стр Из ТекДанные.ЛокальныеСметы Цикл
			СписокВыгрузки.Добавить(Стр.ЛокальнаяСмета);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ТекДанные) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		
		Для каждого Стр Из ТекДанные.Сметы Цикл
			Если ТипЗнч(Стр.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				СписокВыгрузки.Добавить(Стр.Смета);
			ИначеЕсли ТипЗнч(Стр.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
				Для каждого СтрСмета Из Стр.Смета.ЛокальныеСметы Цикл
					СписокВыгрузки.Добавить(СтрСмета.ЛокальнаяСмета);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СписокВыгрузки;
КонецФункции

// ДокторСофт

// Открывает форму выбранного отчета.
// Параметры:
//   ФормаТекст - Строка - полное имя формы.
//   СтрокаДерева - СтрокаДереваЗначений - текущая строка в дереве.
&НаКлиенте
Процедура ОткрытьВызываемуюФорму(ФормаТекст,СтрокаДерева)
	
	Если ГлобальнаяСтрокаДереваСмет = Неопределено 
		ИЛИ ТипЗнч(СтрокаДерева.Ссылка) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура;
	Если ЭтаФорма.ТекущийЭлемент.Имя = "СписокОбъектыСтроительства" Тогда
		ПараметрыЗаполнения.Вставить("КлючОбъектСмета", "ПоОбъектам");
		ПараметрыЗаполнения.Вставить("Смета", СтрокаДерева.Ссылка);
		ПараметрыЗаполнения.Вставить("ОбъектСтроительства", Элементы.СписокОбъектыСтроительства.ТекущиеДанные.Ссылка);
		ПараметрыЗаполнения.Вставить("ПометкаУдаления", СтрокаДерева.ПометкаУдаления);
	КонецЕсли;
	ОткрытьФорму(ФормаТекст, Новый Структура("ПараметрыЗаполнения", ПараметрыЗаполнения), ЭтаФорма);
	
КонецПроцедуры

// Открывает форму выбранного отчета на СКД.
// Параметры:
//   ФормаТекст - Строка - полное имя формы.
//   СтрокаДерева - СтрокаДереваЗначений - текущая строка в дереве.
//   ИмяОтчета - Строка - название отчета.
&НаКлиенте
Процедура ОткрытьВызываемуюФормуСКД(ФормаТекст,СтрокаДерева,ИмяОтчета)
	
	Если ГлобальнаяСтрокаДереваСмет = Неопределено 
		ИЛИ ТипЗнч(СтрокаДерева.Ссылка) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПользовательскиеНастройки",ЗаполнитьПользовательскиеНастройкиОтчета(ИмяОтчета,Новый Структура("Смета",СтрокаДерева.Ссылка)));
	ПараметрыФормы.Вставить("КлючНазначенияИспользования","ДеревоСмет");
	ОткрытьФорму(ФормаТекст, ПараметрыФормы);	
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПользовательскиеНастройкиОтчета(ИмяОтчета,ПараметрыПользователя)
      ОтчетОбъект=Отчеты[ИмяОтчета].Создать();
	  КомпоновщикНастроек = ОтчетОбъект.КомпоновщикНастроек;
	  Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	  Для каждого ПараметрПользователя Из ПараметрыПользователя Цикл
	        Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ПараметрПользователя.Ключ, ПараметрПользователя.Значение);
	  КонецЦикла;
	  КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	  Возврат КомпоновщикНастроек.ПользовательскиеНастройки;
