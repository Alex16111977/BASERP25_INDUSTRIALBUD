
#Область ОписаниеПеременных

&НаКлиенте
Перем ТекущийДокумент, ТекущаяСтройка;

&НаКлиенте
Перем ФормаДлительнойОперации, ПараметрыОбработчика, ФоновоеЗаданиеАдресХранилища;

#КонецОбласти

#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Возврат при получении формы для анализа.
	Если Параметры.Свойство("АвтоТест") Тогда 
		Возврат;
	КонецЕсли;
	
	// СтандартныеПодсистемы.Интеграция1СБухфон
	Если ПравоДоступа("Просмотр", Метаданные.ОбщиеКоманды.СвязатьсяСоСпециалистомОнлайнПоддержки) Тогда
	    ВызовОнлайнПоддержки.ПриСозданииНаСервере(Элементы.ОбщаяКомандаЗапустить1СБухфон);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Интеграция1СБухфон
	
	Если Не Пользователи.РолиДоступны("СМ_АдминистраторСмета, ПолныеПрава") Тогда
		Элементы.СписокСметыПоказатьРасчеты.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.СписокСметыОтменитьПоискРесурса.Доступность = Ложь;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды.
	СписокОбъектовПечати = Новый Массив;
	СписокОбъектовПечати.Добавить(Метаданные.Документы.СМ_ЛокальнаяСмета);
	СписокОбъектовПечати.Добавить(Метаданные.Документы.СМ_ОбъектнаяСмета);
	СписокОбъектовПечати.Добавить(Метаданные.Документы.СМ_СводнаяСмета);
	
	ПараметрыРазмещения 				= ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники 		= СписокОбъектовПечати;
	ПараметрыРазмещения.КоманднаяПанель	= Элементы.СписокСметы.КоманднаяПанель;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды.
	
	// ++ Закомментировано при добавлении СтандартныеПодсистемы.ПодключаемыеКоманды.
	// СоздатьКомандыПечати();
	// -- Закомментировано при добавлении СтандартныеПодсистемы.ПодключаемыеКоманды.
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Отказ = СМ_ЗащитаКлиент.ЗапускОбъекта();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузкаФГИС_ЦС(Команда)

	ОткрытьФорму("Обработка.СМ_ЗагрузкаРесурсовИзФГИС.Форма.Форма",,ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуПечати(Команда)
	
	Если Элементы.СписокСметы.ТекущиеДанные <> Неопределено Тогда
		УправлениеПечатьюКлиент.ВыполнитьПодключаемуюКомандуПечати(Команда, ЭтотОбъект, Элементы.СписокСметы.ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДеревоСметСервер(ТекОбъект = Неопределено,СтрокаРесурса = "")
	
	ТабРезультат 	= ПолучитьДеревоСмет(ТекОбъект, "УПОРЯДОЧИТЬ ПО Сортировка, Родитель Убыв, НомерСметы",СтрокаРесурса);
	ДеревоЗначений 	= РеквизитФормыВЗначение("СписокСметы", Тип("ДеревоЗначений"));
	ДеревоЗначений.Строки.Очистить();
	
	Для Каждого ТекСтрока Из ТабРезультат Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Родитель) Тогда
			НайденнаяСтрока = ДеревоЗначений.Строки.Найти(ТекСтрока.Родитель,"Смета",Истина);	
			Если НайденнаяСтрока <> Неопределено Тогда
				СтрокаДерева = НайденнаяСтрока.Строки.Добавить();	
			Иначе
				СтрокаДерева = ДеревоЗначений.Строки.Добавить();	
			КонецЕсли;			
		Иначе
			СтрокаДерева = ДеревоЗначений.Строки.Добавить();	
		КонецЕсли;	
		ЗаполнитьЗначенияСвойств(СтрокаДерева,ТекСтрока);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначений,"СписокСметы");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКартинкуСтроки(ТекЭлемент, ПометкаУдаления)
	
	// 0. Лим затрата
	// 1. СС
	// 2. ОС
	// 3. ЛС (ресурсный метод)
	// 4. ЛС (базисно инд метод)
	// 5. ЛС просто	
	
	//  с пометкой удаления
	// 6. Лим затрата
	// 7. СС
	// 8. ОС
	// 9. ЛС (ресурсный метод)
	// 10. ЛС (базисно инд метод)
	// 11. ЛС просто	
	
	//	КОРРЕКТИРОВКА
	//	18. ЛС (ресурсный метод).
	//	19. ЛС (базисно инд метод).
	//	20. ЛС просто.
	//	21. ПОМЕТКА УДАЛЕНИЯ ЛС (ресурсный метод).
	//	22. ПОМЕТКА УДАЛЕНИЯ ЛС (базисно инд метод).
	//	23. ПОМЕТКА УДАЛЕНИЯ ЛС просто.
	//	24. ПРОВЕДЕН ЛС (ресурсный метод).
	//	25. ПРОВЕДЕН ЛС (базисно инд метод).
	//	26. ПРОВЕДЕН ЛС просто.
	
	Если ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		Если ТекЭлемент.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			Если ЗначениеЗаполнено(ТекЭлемент.КорректируетСмету) тогда
				ТекКартинка = ?(ПометкаУдаления,21,?(ТекЭлемент.Проведен,24,18));
				Возврат ТекКартинка;
			Иначе
				ТекКартинка = ?(ПометкаУдаления,9,?(ТекЭлемент.Проведен,15,3));
				Возврат ТекКартинка;	
			КонецЕсли;
		ИначеЕсли ТекЭлемент.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
			Если ЗначениеЗаполнено(ТекЭлемент.КорректируетСмету) тогда
				ТекКартинка = ?(ПометкаУдаления,22,?(ТекЭлемент.Проведен,25,19));
				Возврат ТекКартинка;
			Иначе
				ТекКартинка = ?(ПометкаУдаления,10,?(ТекЭлемент.Проведен,16,4));
				Возврат ТекКартинка;
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(ТекЭлемент.КорректируетСмету) тогда
				ТекКартинка = ?(ПометкаУдаления,23,?(ТекЭлемент.Проведен,26,20));
				Возврат ТекКартинка;
			Иначе
				ТекКартинка = ?(ПометкаУдаления,11,?(ТекЭлемент.Проведен,17,5));
				Возврат ТекКартинка;
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		ТекКартинка = ?(ПометкаУдаления,8,?(ТекЭлемент.Проведен,14,2));
		Возврат ТекКартинка;
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		ТекКартинка = ?(ПометкаУдаления,7,?(ТекЭлемент.Проведен,13,1));
		Возврат ТекКартинка;
	ИначеЕсли ТипЗнч(ТекЭлемент) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
		ТекКартинка = ?(ПометкаУдаления,6,0);
		Возврат ТекКартинка;
	Иначе
		Возврат	5;
	КонецЕсли;	
		
КонецФункции

&НаСервере
Функция ПолучитьДеревоСмет(ТекОбъект3,Упорядочивание="",СтрокаРесурса="")
	
	Запрос 			= Новый Запрос;
	ТекстЗапроса 	= "";
	
	Если ЗначениеЗаполнено(СтрокаРесурса) Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|// Выборка ЛС по позициям
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка.ИДСметы КАК ЛокальнаяСмета
		|ПОМЕСТИТЬ ОтборЛС
		|ИЗ
		|	Документ.СМ_ПозицияЛокальнойСметы.РесурсыПозицииЛокальнойСметы КАК СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы
		|ГДЕ
		|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.СметныйКодРесурса ПОДОБНО &ТекСтрока ИЛИ
		|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.НаименованиеРесурса ПОДОБНО &ТекСтрока ИЛИ
		|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка.ШифрРасценки ПОДОБНО &ТекСтрока ИЛИ
		|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка.Наименование ПОДОБНО &ТекСтрока 	
		|СГРУППИРОВАТЬ ПО 
		|	СМ_ПозицияЛокальнойСметыРесурсыПозицииЛокальнойСметы.Ссылка.ИДСметы;
		|
		|// Выборка по ОС
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка КАК ОбъектнаяСмета
		|ПОМЕСТИТЬ ОтборОС
		|ИЗ
		|	Документ.СМ_ОбъектнаяСмета.ЛокальныеСметы КАК СМ_ОбъектнаяСметаЛокальныеСметы
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборЛС КАК ОтборЛС ПО СМ_ОбъектнаяСметаЛокальныеСметы.ЛокальнаяСмета = ОтборЛС.ЛокальнаяСмета
		|СГРУППИРОВАТЬ ПО 
		|	СМ_ОбъектнаяСметаЛокальныеСметы.Ссылка;
		|
		|// Выборка по СС
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СМ_СводнаяСметаСметы.Ссылка КАК СводнаяСмета
		|ПОМЕСТИТЬ ОтборСС
		|ИЗ
		|	Документ.СМ_СводнаяСмета.Сметы КАК СМ_СводнаяСметаСметы 
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборОС КАК ОтборОС ПО СМ_СводнаяСметаСметы.Смета = ОтборОС.ОбъектнаяСмета
		|СГРУППИРОВАТЬ ПО 
		|	СМ_СводнаяСметаСметы.Ссылка
		|	
		|ОБЪЕДИНИТЬ 
		|
		|ВЫБРАТЬ
		|	СМ_СводнаяСметаСметы.Ссылка
		|ИЗ
		|	Документ.СМ_СводнаяСмета.Сметы КАК СМ_СводнаяСметаСметы 
		| 	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборЛС КАК ОтборЛС ПО СМ_СводнаяСметаСметы.Смета = ОтборЛС.ЛокальнаяСмета
		|СГРУППИРОВАТЬ ПО 
		|	СМ_СводнаяСметаСметы.Ссылка;
		|";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|// Временная таблица по объектам строительства
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СМ_ОбъектыСтроительства.Ссылка 
	|ПОМЕСТИТЬ Стройки
	|ИЗ
	|	Справочник.СМ_ОбъектыСтроительства КАК СМ_ОбъектыСтроительства 
	|ГДЕ
	| 	Ссылка В ИЕРАРХИИ (&ОбъектСтроительства)
	|ИНДЕКСИРОВАТЬ ПО 
	|	СМ_ОбъектыСтроительства.Ссылка
	|;
	|
	|// Временная таблица по ЛС 
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СМ_ЛокальнаяСмета.Ссылка   
	|ПОМЕСТИТЬ ЛокальныеСметы
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|	"+?(ЗначениеЗаполнено(ТекОбъект3)," ВНУТРЕННЕЕ СОЕДИНЕНИЕ Стройки КАК Стройки ПО СМ_ЛокальнаяСмета.Стройка = Стройки.Ссылка","")+"
	|	"+?(ЗначениеЗаполнено(СтрокаРесурса)," ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборЛС КАК ОтборЛС ПО СМ_ЛокальнаяСмета.Ссылка = ОтборЛС.ЛокальнаяСмета","")+"
	|ГДЕ 
	|	СМ_ЛокальнаяСмета.СметаРассчитана = ЛОЖЬ 
	| 	
	|ОБЪЕДИНИТЬ ВСЕ 
	|
	|ВЫБРАТЬ  
	|	СМ_ЛокальнаяСмета.Ссылка   
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|	"+?(ЗначениеЗаполнено(ТекОбъект3)," ВНУТРЕННЕЕ СОЕДИНЕНИЕ Стройки КАК Стройки ПО СМ_ЛокальнаяСмета.ИДРодителя.Стройка = Стройки.Ссылка","")+"
	|	"+?(ЗначениеЗаполнено(СтрокаРесурса)," ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтборЛС КАК ОтборЛС ПО СМ_ЛокальнаяСмета.Ссылка = ОтборЛС.ЛокальнаяСмета","")+"
	|ГДЕ 
	|	СМ_ЛокальнаяСмета.СметаРассчитана = ЛОЖЬ 
	|ИНДЕКСИРОВАТЬ ПО 
	|	СМ_ЛокальнаяСмета.Ссылка
	|;   	
	|
	|// Временная таблица по актам выполненных работ
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_АктВыполненныхРабот.ЛокальнаяСмета,
	|	СУММА(1) КАК КоличествоАктов
	|ПОМЕСТИТЬ АктыСметы
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот 
	|  	"+?(ЗначениеЗаполнено(ТекОбъект3)," ВНУТРЕННЕЕ СОЕДИНЕНИЕ Стройки КАК Стройки ПО СМ_АктВыполненныхРабот.Стройка = Стройки.Ссылка","")+"
	|ГДЕ	
	|	НЕ СМ_АктВыполненныхРабот.ПометкаУдаления   
	|СГРУППИРОВАТЬ ПО
	|	СМ_АктВыполненныхРабот.ЛокальнаяСмета
	|;
	|
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_ИтогиПоГлавамСС.Смета КАК Смета,
	|	СУММА(СМ_ИтогиПоГлавамСС.ПрямЗатраты) КАК СуммаБазис,
	|	СУММА(СМ_ИтогиПоГлавамСС.ТекПрямЗатраты) КАК СуммаТек
	|ПОМЕСТИТЬ ИтогПоСС
	|	ИЗ
	|		РегистрСведений.СМ_ИтогиПоГлавамСС КАК СМ_ИтогиПоГлавамСС
	|	ГДЕ
	|		СМ_ИтогиПоГлавамСС.Итог = &ИтогПоСмете
	|СГРУППИРОВАТЬ ПО
	|	СМ_ИтогиПоГлавамСС.Смета
	|;
	|
	|// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АктыСметы.ЛокальнаяСмета,
	|	ВЫБОР
	|		КОГДА АктыСметы.КоличествоАктов > 1
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КартинкаАкт
	|ПОМЕСТИТЬ СметыКартинкиАкты
	|ИЗ
	|	АктыСметы КАК АктыСметы
	|;
	|
	|// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_ЛокальнаяСметаПрисоединенныеФайлы.ВладелецФайла КАК ЛокальнаяСмета,
	|	1 КАК КоличествоФайлов
	|ПОМЕСТИТЬ СметыКартинкиФайлы
	|ИЗ
	|	Справочник.СМ_ЛокальнаяСметаПрисоединенныеФайлы КАК СМ_ЛокальнаяСметаПрисоединенныеФайлы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Стройки КАК Стройки ПО СМ_ЛокальнаяСметаПрисоединенныеФайлы.ВладелецФайла.Стройка = Стройки.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	СМ_ЛокальнаяСметаПрисоединенныеФайлы.ВладелецФайла
	|;	
	// Итоги по лимзатратам ЛС
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СМ_ИтогиПоГлавам.Смета,
	|	СМ_ИтогиПоГлавам.Итог КАК Итог,
	|	Сумма(СМ_ИтогиПоГлавам.ПрямЗатраты) КАК СуммаБазис,
	|	Сумма(СМ_ИтогиПоГлавам.ТекПрямЗатраты) КАК СуммаТек
	|ПОМЕСТИТЬ ВсеИтоги
	|ИЗ 
	|	РегистрСведений.СМ_ИтогиПоГлавам КАК СМ_ИтогиПоГлавам
	|ГДЕ
