&НаКлиенте
Процедура РазбитьСтроку(Команда)
	
	Если ВариантГруппировки= "ПоЗаказам" Тогда
		ТекущаяСтрока = Элементы.ТаблицаКДоставкеПоЗаказам.ТекущиеДанные;
		ТаблицаФормы  = Элементы.ТаблицаКДоставкеПоЗаказам;
	Иначе
		ТекущаяСтрока = Элементы.ТаблицаКДоставкеПоНоменклатуре.ТекущиеДанные;
		ТаблицаФормы  = Элементы.ТаблицаКДоставкеПоНоменклатуре;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено 
		ИЛИ ТекущаяСтрока.ПолучитьРодителя()= Неопределено Тогда
		Возврат;
	Конецесли;
		
	ДанныеТаблицы = ТекущаяСтрока.ПолучитьЭлементы();
	ТекущийРодитель = ТекущаяСтрока.ПолучитьРодителя().ПолучитьЭлементы();
	
	Оповещение = Новый ОписаниеОповещения("РазбитьСтрокуЗавершение", ЭтотОбъект);
	ОбщегоНазначенияУТКлиент.РазбитьСтрокуТЧ(ТекущийРодитель, ТаблицаФормы);
		
	//РазбитьСтрокуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РазбитьСтрокуЗавершение(НоваяСтрока, ДополнительныеПараметры) Экспорт 
	
	Если ВариантГруппировки= "ПоЗаказам" Тогда
		ТекущаяСтрока = Элементы.ТаблицаКДоставкеПоЗаказам.ТекущиеДанные;
	Иначе
		ТекущаяСтрока = Элементы.ТаблицаКДоставкеПоНоменклатуре.ТекущиеДанные;
	КонецЕсли;
	
	Если НоваяСтрока <> Неопределено Тогда
			
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц",    			ТекущаяСтрока.Упаковка); 	
		СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
			ЭтаФорма.ИмяФормы, "ТаблицаКДоставке"));

		ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц",    			НоваяСтрока.Упаковка); 	
		СтруктураДействий.Вставить("НоменклатураПриИзмененииПереопределяемый", Новый Структура("ИмяФормы, ИмяТабличнойЧасти",
			ЭтаФорма.ИмяФормы, "ТаблицаКДоставке"));

		ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, КэшированныеЗначения);
		
	КонецЕсли;
	
КонецПроцедуры

