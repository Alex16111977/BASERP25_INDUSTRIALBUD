&НаСервере
Процедура ТаблицаКДоставкеВыбратьПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока = ТаблицаКДоставке.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
		ТекущаяСтрока.ПолучитьЭлементы();
		ДеревоКДоставке = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
		СтруктураПоиска = Новый Структура;
		Если ВариантГруппировки = "ПоЗаказам" Тогда
			СтруктураПоиска.Вставить("ЗаказПоставщику", ТекущаяСтрока.ЗаказПоставщику);
		Иначе
			СтруктураПоиска.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
			СтруктураПоиска.Вставить("Характеристика", ТекущаяСтрока.Характеристика);
		КонецЕсли;
			
		СтрокиДерева = ДеревоКДоставке.Строки.НайтиСтроки(СтруктураПоиска);
		Для Каждого СтрокаДерева Из СтрокиДерева Цикл
			Для Каждого ПодчиненнаяСтрока Из СтрокаДерева.Строки Цикл
				ПодчиненнаяСтрока.Выбрать =  ТекущаяСтрока.Выбрать;
			КонецЦикла;
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(ДеревоКДоставке, "ТаблицаКДоставке");
				
	КонецЕсли;
	
КонецПроцедуры

