&НаКлиенте
Перем КэшированныеЗначения;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВариантГруппировки = "ПоЗаказам";
	
	УстановитьУсловноеоформление();
	
	ЗаполнитьЗначенияПоУмолчанию();

	ЗагрузитьНастройкиОтбораПоУмолчанию();

	ЗаполнитьТаблицуКДоставкеНаСервере();

	ОбновитьСписокЗаказовнаПеревозку();
	
	ТекущаяОрганизация = Объект.Организация;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастроитьВидимостьСтраниц();
	РазвернутьДеревоКДоставке();
	НастроитьОтборЗаказовНаПеревозку();
	
	Элементы.ЗаказыНаДоставкуПоказыватьВсеСформированныеЗаказы.Пометка = ПоказыватьВсеЗаказыНаДоставку;
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	Если ЭтоАдресВременногоХранилища(СохраненныеНастройки) Тогда
		
		ТаблицаСохраненныеНастройки = ПолучитьИзВременногоХранилища(СохраненныеНастройки);
		Для Каждого СтрокаТЧ Из ТаблицаСохраненныеНастройки Цикл
			Настройки.Вставить(СтрокаТЧ.Ключ, СтрокаТЧ.Значение);
		КонецЦикла;
		
	Иначе
		
		// Сохранение отбора выполняется только если это не печать из документа
		Настройки.Вставить("НастройкиОтбора",Новый ХранилищеЗначения(КомпоновщикНастроек.Настройки));
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
		
	Если Параметры.Свойство("АдресВХранилище") И ЭтоАдресВременногоХранилища(Параметры.АдресВХранилище) Тогда
		
		ТаблицаСохраненныеНастройки = Новый ТаблицаЗначений;
		ТаблицаСохраненныеНастройки.Колонки.Добавить("Ключ");
		ТаблицаСохраненныеНастройки.Колонки.Добавить("Значение");
		
		Для Каждого КлючИЗначение Из Настройки Цикл
			НоваяСтрока = ТаблицаСохраненныеНастройки.Добавить();
			НоваяСтрока.Ключ = КлючИЗначение.Ключ;
			НоваяСтрока.Значение = КлючИЗначение.Значение;
		КонецЦикла;
		
		СохраненныеНастройки = ПоместитьВоВременноеХранилище(ТаблицаСохраненныеНастройки, УникальныйИдентификатор);
		
		Настройки.Очистить();
		
	Иначе
		
		НастройкиОтбора = Настройки.Получить("НастройкиОтбора");
		Если НастройкиОтбора <> Неопределено Тогда
			КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиОтбора.Получить());
		Иначе
			ЗагрузитьНастройкиОтбораПоУмолчанию();
		КонецЕсли;
				
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.УСОERP_ШаблоныАдресов.ФормаВыбора" Тогда
		ДобавитьТочкуДоставкиНаСервере(ВыбранноеЗначение);
		Попытка
			Если ВариантГруппировки = "ПоЗаказам" Тогда
				Элементы.ТаблицаКДоставкеПоЗаказам.ТекущиеДанные = ТаблицаКДоставке.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
			Иначе
				Элементы.ТаблицаКДоставкеПоНоменклатуре.ТекущиеДанные = ТаблицаКДоставке.НайтиПоИдентификатору(ИдентификаторТекущейСтроки);
			КонецЕсли;
		Исключение
		КонецПопытки;
		
		РазвернутьДеревоКДоставке();
		
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВариантГруппировкиПриИзменении(Элемент)
	
	НастроитьВидимостьСтраниц();
	Если ВариантГруппировки = "ПоЗаказам" Тогда
		ВывестиДеревоКДоставкеПоЗаказам();
	Иначе
		ВывестиДеревоКДоставкеПоНоменклатуре();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если ТекущаяОрганизация<>Объект.Организация И  ДеревоКДоставкеЗаполнено() Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОрганизацияПриИзмененииПродолжение",ЭтотОбъект),"Данные к доставке будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет);
		
	Иначе
		
		ТекущаяОрганизация = Объект.Организация;
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзмененииПродолжение(Ответ,ДопПараметры)Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.Организация = ТекущаяОрганизация;
		Возврат;
	КонецЕсли;
	
	  ОчиститьДеревоКДоставке();
	  ТекущаяОрганизация = Объект.Организация;
	
КонецПроцедуры


&НаКлиенте
Процедура ВключитьЦветовоеОформлениеПриИзменении(Элемент)
	ВключитьЦветовоеОформлениеПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВключитьЦветовоеОформлениеПриИзмененииНаСервере()
	УстановитьУсловноеОформление();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКДоставке

&НаКлиенте
Процедура ТаблицаКДоставкеПоЗаказамКоличествоУпаковокПриИзменении(Элемент)
	
	Если ВариантГруппировки = "ПоЗаказам" Тогда
		ТекущаяСтрока = Элементы.ТаблицаКДоставкеПоЗаказам.ТекущиеДанные;
	Иначе
		ТекущаяСтрока = Элементы.ТаблицаКДоставкеПоНоменклатуре.ТекущиеДанные;
	КонецЕсли;
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	
	ОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, Неопределено);
	

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКДоставкеПоЗаказамВыбратьПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаКДоставкеПоЗаказам.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Родитель = ТекущаяСтрока.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		ИдентификаторСтроки = ТекущаяСтрока.ПолучитьИдентификатор();
		ТаблицаКДоставкеВыбратьПриИзмененииНаСервере(ИдентификаторСтроки);
		
		//Развернуть дерево 
		КоллекцияЭлементовДерева = ТаблицаКДоставке.ПолучитьЭлементы();	
		Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
			мИдентификаторСтроки=Строка.ПолучитьИдентификатор(); 			
			Элементы.ТаблицаКДоставкеПоЗаказам.Развернуть(мИдентификаторСтроки);
		КонецЦикла;
		
		Элементы.ТаблицаКДоставкеПоЗаказам.ТекущийЭлемент =  Элементы.ТаблицаКДоставкеПоЗаказамЗаказПоставщику;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКДоставкеПоНоменклатуреВыбратьПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ТаблицаКДоставкеПоНоменклатуре.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено тогда
		Возврат;
	КонецЕсли;
	
	Родитель = ТекущаяСтрока.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		
		ТаблицаКДоставкеВыбратьПриИзмененииНаСервере(ТекущаяСтрока.ПолучитьИдентификатор());
		
		//Развернуть дерево 
		КоллекцияЭлементовДерева = ТаблицаКДоставке.ПолучитьЭлементы();	
		Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
			мИдентификаторСтроки=Строка.ПолучитьИдентификатор();
			Элементы.ТаблицаКДоставкеПоНоменклатуре.Развернуть(мИдентификаторСтроки);
		КонецЦикла;
		
		Элементы.ТаблицаКДоставкеПоНоменклатуре.ТекущийЭлемент =  Элементы.ТаблицаКДоставкеПоНоменклатуреНоменклатура;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКДоставкеПоЗаказамСрокДоставкиПриИзменении(Элемент)
	
	Если ВариантГруппировки = "ПоЗаказам" Тогда
		ТекущиеДанные = Элементы.ТаблицаКДоставкеПоЗаказам.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.ТаблицаКДоставкеПоНоменклатуре.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ТаблицаКДоставкеПоЗаказамСрокДоставкиПриИзмененииПродолжение",ЭтотОбъект),"Изменить срок доставки для всех подчиненных строк?", РежимДиалогаВопрос.ДаНет, 30, КодВозвратаДиалога.Нет);
		
	Иначе
		Если ТекущиеДанные.СрокДоставки>ТекущиеДанные.ДатаПоступления Тогда
			ТекущиеДанные.СрокДоставки = ТекущиеДанные.ДатаПоступления;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Срок доставки не может быть больше даты поступления.");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКДоставкеПоЗаказамСрокДоставкиПриИзмененииПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если ВариантГруппировки = "ПоЗаказам" Тогда
		ТекущиеДанные = Элементы.ТаблицаКДоставкеПоЗаказам.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.ТаблицаКДоставкеПоНоменклатуре.ТекущиеДанные;
	КонецЕсли; 

	СрокДоставкиПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор()); 	
	
КонецПроцедуры 

