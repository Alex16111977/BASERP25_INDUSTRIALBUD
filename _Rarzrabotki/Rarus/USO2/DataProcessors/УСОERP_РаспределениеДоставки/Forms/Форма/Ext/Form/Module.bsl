&НаСервере
Процедура ОбновитьИсполнителяНаСервере(Отказ = Ложь)
	
	ДеревоКДоставке = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
	ВыбранныеСтроки = ДеревоКДоставке.Строки.НайтиСтроки(Новый Структура("Выбрать, Исполнитель", Истина, Перечисления.УСОERP_ИсполнителиДоставки.ПустаяСсылка()), Истина);
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Строки для заполнения значением по умолчанию не найдены (либо нет выбранных строк, либо в выбранных строках исполнитель доставки заполнен).",,);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Для Каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
		Если ВыбраннаяСтрока.Родитель<>Неопределено Тогда
			ВыбраннаяСтрока.Исполнитель = Исполнитель;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоКДоставке, "ТаблицаКДоставке");
	
КонецПроцедуры

