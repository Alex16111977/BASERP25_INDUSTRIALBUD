		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Для Каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
		Если ВыбраннаяСтрока.Родитель<>Неопределено Тогда
			ВыбраннаяСтрока.ВидДоставки = ВидДоставки;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоКДоставке, "ТаблицаКДоставке");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьАдресДоставкиНаСервере(Отказ = Ложь)
	
	ДеревоКДоставке = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
	ВыбранныеСтроки = ДеревоКДоставке.Строки.НайтиСтроки(Новый Структура("Выбрать, АдресДоставки", Истина, Справочники.УСОERP_ШаблоныАдресов.ПустаяСсылка()), Истина);
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Строки для заполнения значением по умолчанию не найдены (либо нет выбранных строк, либо в выбранных строках адрес доставки заполнен).",,);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Для Каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
		Если ВыбраннаяСтрока.Родитель<>Неопределено Тогда
			ВыбраннаяСтрока.АдресДоставки = АдресДоставки;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоКДоставке, "ТаблицаКДоставке");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСкладНаСервере(Отказ = Ложь)
	
	ДеревоКДоставке = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
	ВыбранныеСтроки = ДеревоКДоставке.Строки.НайтиСтроки(Новый Структура("Выбрать, Склад", Истина, Справочники.Склады.ПустаяСсылка()), Истина);
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Строки для заполнения значением по умолчанию не найдены (либо нет выбранных строк, либо в выбранных строках склад заполнен).",,);
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Для Каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
		Если ВыбраннаяСтрока.Родитель<>Неопределено Тогда
			ВыбраннаяСтрока.Склад = Склад;
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоКДоставке, "ТаблицаКДоставке");

КонецПроцедуры

&НаСервере
Процедура СформироватьЗаказыНаДоставкуНаСервере()
	
	
	ДеревоВЗаказ = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
	
	ВыбранныеСтроки = ДеревоВЗаказ.Строки.НайтиСтроки(Новый Структура("Выбрать", Истина), Истина);
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрано ни одной строки для формирования заказов на доставку!");
		Возврат;
	КонецЕсли;

	
	ТаблицаДанныхВЗаказ = Объект.КДоставке.Выгрузить();
	ТаблицаДанныхВЗаказ.Очистить();
	
	Отказ = Ложь;
	Для Каждого СтрокаДерева Из ВыбранныеСтроки Цикл 		
		Если СтрокаДерева.Родитель <> Неопределено Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаДерева.ЗаказНаДоставку) Тогда 
				Если Не ЗначениеЗаполнено(СтрокаДерева.СрокДоставки) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранной строки материала: " + СокрЛП(СтрокаДерева.Номенклатура) 
					+ ?(ЗначениеЗаполнено(СтрокаДерева.Характеристика), ", " + СокрЛП(СтрокаДерева.Характеристика), "") + " по заказу поставщика: "
					+ СокрЛП( СтрокаДерева.ЗаказПоставщику)
					+ " не указан срок доставки.");
					
					Отказ = Истина;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаДерева.Исполнитель) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранной строки материала: " + СокрЛП(СтрокаДерева.Номенклатура) 
					+ ?(ЗначениеЗаполнено(СтрокаДерева.Характеристика), ", " + СокрЛП(СтрокаДерева.Характеристика), "") + " по заказу поставщика: "
					+ СокрЛП( СтрокаДерева.ЗаказПоставщику)
					+ " не указан исполнитель.");
					
					Отказ = Истина;
				КонецЕсли;

				Если СтрокаДерева.Исполнитель = Перечисления.УСОERP_ИсполнителиДоставки.СтороннийПеревозчик Тогда
					Если Не ЗначениеЗаполнено(СтрокаДерева.Партнер) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранной строки материала: " + СокрЛП(СтрокаДерева.Номенклатура) 
						+ ?(ЗначениеЗаполнено(СтрокаДерева.Характеристика), ", " + СокрЛП(СтрокаДерева.Характеристика), "") + " по заказу поставщика: "
						+ СокрЛП( СтрокаДерева.ЗаказПоставщику)
						+ " не указан перевозчик-партнер.");
						
						Отказ = Истина;
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(СтрокаДерева.Контрагент) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранной строки материала: " + СокрЛП(СтрокаДерева.Номенклатура) 
						+ ?(ЗначениеЗаполнено(СтрокаДерева.Характеристика), ", " + СокрЛП(СтрокаДерева.Характеристика), "") + " по заказу поставщика: "
						+ СокрЛП( СтрокаДерева.ЗаказПоставщику)
						+ " не указан контрагент.");
						
						Отказ = Истина;
					КонецЕсли;
										
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаДерева.ВидДоставки) Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранной строки материала: " + СокрЛП(СтрокаДерева.Номенклатура) 
						+ ?(ЗначениеЗаполнено(СтрокаДерева.Характеристика), ", " + СокрЛП(СтрокаДерева.Характеристика), "") + " по заказу поставщика: "
						+ СокрЛП( СтрокаДерева.ЗаказПоставщику)
						+ " не указан вид доставки.");
						
						Отказ = Истина;
					КонецЕсли;

				Если Не ЗначениеЗаполнено(СтрокаДерева.АдресОтправления) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранной строки материала: " + СокрЛП(СтрокаДерева.Номенклатура) 
					+ ?(ЗначениеЗаполнено(СтрокаДерева.Характеристика), ", " + СокрЛП(СтрокаДерева.Характеристика), "") + " по заказу поставщика: "
					+ СокрЛП( СтрокаДерева.ЗаказПоставщику)
					+ " не указан адрес отправения.");
					
					Отказ = Истина;
				КонецЕсли;

				Если Не ЗначениеЗаполнено(СтрокаДерева.АдресДоставки) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Для выбранной строки материала: " + СокрЛП(СтрокаДерева.Номенклатура) 
					+ ?(ЗначениеЗаполнено(СтрокаДерева.Характеристика), ", " + СокрЛП(СтрокаДерева.Характеристика), "") + " по заказу поставщика: "
					+ СокрЛП( СтрокаДерева.ЗаказПоставщику)
					+ " не указан адрес доставки.");
					
					Отказ = Истина;
				КонецЕсли;

				Если Не Отказ Тогда
					НоваяСтрока = ТаблицаДанныхВЗаказ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;  		
	КонецЦикла;
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("По одной или нескольким строкам есть не заполненные данные, которые обязательны для формирования заказов на доставку. Необходимо заполнить данные вручную либо воспользоваться заполнением значениями по умолчанию.");
		Возврат;
	КонецЕсли;
	
	
	ТаблицаГруппировок = ТаблицаДанныхВЗаказ.Скопировать();
	ТаблицаГруппировок.Свернуть("СрокДоставки, Исполнитель, Контрагент, Партнер, АдресДоставки, АдресОтправления, ВидДоставки, Склад, СрокДоставки");
	
	
	мТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	Для Каждого СтрГруппировка Из ТаблицаГруппировок Цикл
		НовыйДокументДоставки = Документы.УСОERP_ЗаказНаПеревозку.СоздатьДокумент();
		
		ЗаполнитьЗначенияСвойств(НовыйДокументДоставки, СтрГруппировка);
		НовыйДокументДоставки.Организация = Объект.Организация;
		НовыйДокументДоставки.ВидОперации = СтрГруппировка.Исполнитель;
		НовыйДокументДоставки.Ответственный = мТекущийПользователь;
		НовыйДокументДоставки.Дата = ТекущаяДата();
		
		НовыйДокументДоставки.Валюта                         = ДоходыИРасходыСервер.ПолучитьВалютуУправленческогоУчета(НовыйДокументДоставки.Валюта);
		НовыйДокументДоставки.ВалютаВзаиморасчетов           = ДоходыИРасходыСервер.ПолучитьВалютуУправленческогоУчета(НовыйДокументДоставки.ВалютаВзаиморасчетов);
	    НовыйДокументДоставки.Статус 				= Перечисления.УСОERP_СтатусыЗаказаНаПеревозку.Подготовлен;
		НовыйДокументДоставки.НалогообложениеНДС 	= Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("СрокДоставки" , СтрГруппировка.СрокДоставки);
		СтруктураОтбора.Вставить("Исполнитель" , СтрГруппировка.Исполнитель);
		СтруктураОтбора.Вставить("Контрагент" , СтрГруппировка.Контрагент);
		СтруктураОтбора.Вставить("Партнер" , СтрГруппировка.Партнер);
		СтруктураОтбора.Вставить("АдресДоставки" , СтрГруппировка.АдресДоставки);
		СтруктураОтбора.Вставить("АдресОтправления" , СтрГруппировка.АдресОтправления);
		СтруктураОтбора.Вставить("ВидДоставки", СтрГруппировка.ВидДоставки);
		СтрокиВЗаказ = ТаблицаДанныхВЗаказ.НайтиСтроки(СтруктураОтбора);
		Для Каждого мСтрокаВЗаказ Из СтрокиВЗаказ Цикл
			НоваяСтрокаВЗаказ = НовыйДокументДоставки.КДоставке.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаВЗаказ, мСтрокаВЗаказ);
		КонецЦикла;
		
		ДокументЗаписан = Истина;
		Попытка
			НовыйДокументДоставки.Записать(РежимЗаписиДокумента.Проведение);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан новый документ: " + СокрЛП(НовыйДокументДоставки.Ссылка) + ". Новый докумен проведен.");
		Исключение
			Попытка
				НовыйДокументДоставки.Записать(РежимЗаписиДокумента.Запись);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан новый документ: " + СокрЛП(НовыйДокументДоставки.Ссылка) + ". Документ записан без проведения.");				
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания документа.");
				ДокументЗаписан = Ложь;
			конецПопытки;
		КонецПопытки;
		
		Если ДокументЗаписан Тогда
			Для Каждого СтрЗаказа Из НовыйДокументДоставки.КДоставке Цикл
				СтрокиДерева = ДеревоВЗаказ.Строки.НайтиСтроки(Новый Структура("ЗаказПоставщику, Номенклатура, 
				|Характеристика, АдресДоставки, АдресОтправления, 
				|СрокДоставки, Исполнитель, ВидДоставки, Партнер, Контрагент, Количество, Выбрать", СтрЗаказа.ЗаказПоставщику, СтрЗаказа.Номенклатура, СтрЗаказа.Характеристика,
				НовыйДокументДоставки.АдресДоставки, НовыйДокументДоставки.АдресОтправления,
				НовыйДокументДоставки.СрокДоставки, НовыйДокументДоставки.ВидОперации,
				НовыйДокументДоставки.ВидДоставки, НовыйДокументДоставки.Партнер, НовыйДокументДоставки.Контрагент, СтрЗаказа.Количество, Истина), Истина);
				
				Для Каждого мСтрокаДерева Из СтрокиДерева Цикл
					Если мСтрокаДерева.Родитель<>Неопределено Тогда
						мСтрокаДерева.ЗаказНаДоставку = НовыйДокументДоставки.Ссылка;
						мСтрокаДерева.Выбрать = Ложь;
						//мСтрокаДерева.КоличествоОстаток = мСтрокаДерева.КоличествоОстаток - СтрЗаказа.Количество;
					КонецЕсли;					
				КонецЦикла;
				
				СтрокиДереваПроверка = ДеревоВЗаказ.Строки.НайтиСтроки(Новый Структура("ЗаказПоставщику, Номенклатура, 
				|Характеристика, АдресДоставки, АдресОтправления, 
				|СрокДоставки, Исполнитель, ВидДоставки, Партнер, Контрагент", СтрЗаказа.ЗаказПоставщику, СтрЗаказа.Номенклатура, СтрЗаказа.Характеристика,
				НовыйДокументДоставки.АдресДоставки, НовыйДокументДоставки.АдресОтправления,
				НовыйДокументДоставки.СрокДоставки, НовыйДокументДоставки.ВидОперации,
				НовыйДокументДоставки.ВидДоставки, НовыйДокументДоставки.Партнер, НовыйДокументДоставки.Контрагент), Истина);
				
				Для Каждого мСтрокаДереваПроверка Из СтрокиДереваПроверка Цикл
					Если мСтрокаДереваПроверка.Родитель<>Неопределено Тогда
						мСтрокаДереваПроверка.КоличествоОстаток = мСтрокаДереваПроверка.КоличествоОстаток - СтрЗаказа.Количество;
					КонецЕсли;					
				КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
	
	КонецЦикла;
		
	ЗначениеВРеквизитФормы(ДеревоВЗаказ, "ТаблицаКДоставке");
	
	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьТочкуДоставкиНаСервере(ВыбранноеЗначение)
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ДеревоВЗаказ = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
	
	
	Если Не ТочкаДоставкиДляТекущйСтроки Тогда
		
		НовоеДеревоВЗаказ = ДеревоВЗаказ.Скопировать();
		НовоеДеревоВЗаказ.Строки.Очистить();
		
		Для Каждого мСтрокаДерева0 Из ДеревоВЗаказ.Строки Цикл
			НоваяСтрокаДереваВЗаказ = НовоеДеревоВЗаказ.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДереваВЗаказ, мСтрокаДерева0);
			
			Для Каждого мСтрокаДерева1 Из мСтрокаДерева0.Строки Цикл
				НоваяСтрокаВЗаказ = НоваяСтрокаДереваВЗаказ.Строки.Добавить();			
				ЗаполнитьЗначенияСвойств( НоваяСтрокаВЗаказ, мСтрокаДерева1);
				
				Если НоваяСтрокаВЗаказ.Выбрать Тогда
					НоваяСтрокаВЗаказ.АдресДоставки = ВыбранноеЗначение;
					
					НоваяСтрокаВЗаказДопТочка = НоваяСтрокаДереваВЗаказ.Строки.Добавить();			
					ЗаполнитьЗначенияСвойств( НоваяСтрокаВЗаказДопТочка, мСтрокаДерева1);
					НоваяСтрокаВЗаказДопТочка.АдресОтправления = ВыбранноеЗначение;
					НоваяСтрокаВЗаказДопТочка.АдресДоставки = мСтрокаДерева1.АдресДоставки; 
					
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(НовоеДеревоВЗаказ, "ТаблицаКДоставке");
		
	Иначе
		ТекущиеДанные = ТаблицаКДоставке.НайтиПоИдентификатору(ИдентификаторТекущейСтрокиДляТочкиДоставки);
		Если ТекущиеДанные = Неопределено тогда
			Возврат;
		КонецЕсли;
				
		ТекущийРодитель = ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы();
		
		ИндексТекущейСтроки 	 = ТекущийРодитель.Индекс(ТекущиеДанные);
		НоваяСтрока 			 = ТекущийРодитель.Вставить(ИндексТекущейСтроки + 1);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);

		НоваяСтрока.АдресДоставки = ТекущиеДанные.АдресДоставки;
		НоваяСтрока.АдресОтправления = ВыбранноеЗначение;
		
		ТекущиеДанные.АдресДоставки = ВыбранноеЗначение;
		
		ТекущиеДанные.Выбрать = Истина;
		НоваяСтрока.Выбрать = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Прочее

&НаКлиенте
Процедура НастроитьОтборЗаказовНаПеревозку()
	
	Если ВариантГруппировки = "ПоЗаказам" тогда
		ТекущиеДанные = Элементы.ТаблицаКДоставкеПоЗаказам.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.ТаблицаКДоставкеПоНоменклатуре.ТекущиеДанные;
	КонецЕсли;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПоказыватьВсеЗаказыНаДоставку Тогда
		Элементы.ЗаказыНаДоставку.ОтборСтрок = Неопределено;
	Иначе
		Элементы.ЗаказыНаДоставку.ОтборСтрок = Новый ФиксированнаяСтруктура("ЗаказНаДоставку", ТекущиеДанные.ЗаказНаДоставку);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьВидимостьСтраниц()
	
	Элементы.ГруппировкаПоНоменклатуре.Видимость = (ВариантГруппировки = "ПоНоменклатуре");
	Элементы.ГруппировкаПоЗаказу.Видимость = (ВариантГруппировки = "ПоЗаказам");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияПоУмолчанию()
	
Объект.Организация = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Объект.Организация);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОбязательныеПоляДанных(СтруктураНастроек)
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЗаказПоставщику");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Поставщик");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Номенклатура");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры") Тогда
		СтруктураНастроек.ОбязательныеПоля.Добавить("Характеристика");
		СтруктураНастроек.ОбязательныеПоля.Добавить("ХарактеристикиИспользуются");
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры") Тогда
		СтруктураНастроек.ОбязательныеПоля.Добавить("Упаковка");
	КонецЕсли;
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("КоличествоУпаковок");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Количество");  
	СтруктураНастроек.ОбязательныеПоля.Добавить("КоличествоВДокументе"); 
	СтруктураНастроек.ОбязательныеПоля.Добавить("КоличествоОстаток");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Вес");
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДатаПоступления");
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Исполнитель");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Контрагент");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Партнер");
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("АдресДоставки");
	СтруктураНастроек.ОбязательныеПоля.Добавить("АдресОтправления");
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Склад");
	//СтруктураНастроек.ОбязательныеПоля.Добавить("АдресСклада");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЗаказНаДоставку");
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("ВидДоставки");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СрокДоставки");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ОжидаемаяДатаДоставки");
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоКДоставке()
	
	//Развернуть дерево 
	КоллекцияЭлементовДерева = ТаблицаКДоставке.ПолучитьЭлементы();	
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
		мИдентификаторСтроки=Строка.ПолучитьИдентификатор(); 
		Если ВариантГруппировки = "ПоЗаказам" Тогда
			Элементы.ТаблицаКДоставкеПоЗаказам.Развернуть(мИдентификаторСтроки);
		Иначе
			Элементы.ТаблицаКДоставкеПоНоменклатуре.Развернуть(мИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокЗаказовНаПеревозку()
	
	ДеревоКДоставке = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
	
	ТаблицаДокументов = Объект.ЗаказыНаДоставку.Выгрузить();
	ТаблицаДокументов.Очистить();
	Для Каждого СтрокаГруппировка Из ДеревоКДоставке.Строки Цикл
		Для Каждого СтрокаКДоставке Из СтрокаГруппировка.Строки Цикл
			Если ЗначениеЗаполнено( СтрокаКДоставке.ЗаказНаДоставку) Тогда
				НоваяСтрока = ТаблицаДокументов.Добавить();
				НоваяСтрока.ЗаказНаДоставку = СтрокаКДоставке.ЗаказНаДоставку;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаДокументов.Свернуть("ЗаказНаДоставку");
	Объект.ЗаказыНаДоставку.Очистить();
	Объект.ЗаказыНаДоставку.Загрузить(ТаблицаДокументов);
	
КонецПроцедуры

&НаСервере
Функция ДеревоКДоставкеЗаполнено()
	
	ДеревоКДоставке = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
	
	Возврат (ДеревоКДоставке.Строки.Количество()>0 );
	
КонецФункции

&НаСервере
Процедура ОчиститьДеревоКДоставке()
	
	ДеревоКДоставке = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
	ДеревоКДоставке.Строки.Очистить();
	ЗначениеВРеквизитФормы(ДеревоКДоставке, "ТаблицаКДоставке");

КонецПроцедуры

#КонецОбласти

#Область ПеренесеноИзМодуляМенеджера

// Функция подготавливает структуру данных, необходимую для печати ценников и этикеток.
//
// Возвращаемое значение:
//  Стрруктура - данные, необходимые для печати этикеток и ценников.
//
&НаСервере
Функция ПодготовитьСтруктуруДанных(СтруктураНастроек) Экспорт
	
	Если СтруктураНастроек.ИсходныеДанные <> Неопределено Тогда
		ИсходныеДанные = СтруктураНастроек.ИсходныеДанные.Скопировать();
	Иначе
		ИсходныеДанные = Неопределено;
	КонецЕсли;
	
	СтруктураРезультата = Новый Структура;
	СтруктураРезультата.Вставить("Таблица",                             Неопределено);
	СтруктураРезультата.Вставить("СоответствиеПолейСКДКолонкамТаблицы", Новый Соответствие);

#Область ПодготовкаСхемыКомпоновкиДанныхИКомпоновщикаНастроекСкд
	
	// Схема компоновки.
	//СхемаКомпоновкиДанных = Обработки.УСОERP_РаспределениеДоставки.ПолучитьМакет(СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных);
	СхемаКомпоновкиДанных = РеквизитФормыВЗначение("Объект").ПолучитьМакет(СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных);
	
	// Подготовка компоновщика макета компоновки данных.
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	Компоновщик.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Компоновщик.Настройки.Отбор.Элементы.Очистить();
	
	// Отбор компоновщика настроек.
	Если СтруктураНастроек.КомпоновщикНастроек <> Неопределено Тогда
		КомпоновкаДанныхКлиентСервер.СкопироватьЭлементы(Компоновщик.Настройки.Отбор, СтруктураНастроек.КомпоновщикНастроек.Настройки.Отбор);
	КонецЕсли;
	
	// Выбранные поля компоновщика настроек.
	Для Каждого ОбязательноеПоле Из СтруктураНастроек.ОбязательныеПоля Цикл
		ПолеСКД = КомпоновкаДанныхСервер.НайтиПолеСКДПоПолномуИмени(Компоновщик.Настройки.Выбор.ДоступныеПоляВыбора.Элементы, ОбязательноеПоле);
		Если ПолеСКД <> Неопределено Тогда
			ВыбранноеПоле = Компоновщик.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВыбранноеПоле.Поле = ПолеСКД.Поле;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьЗначениеПараметраСКД(Компоновщик, "Организация",  СтруктураНастроек.ПараметрыДанных.Организация);
	УстановитьЗначениеПараметраСКД(Компоновщик, "КонецПериода",  Новый Граница(ТекущаяДата(), ВидГраницы.Включая));

	// Компоновка макета компоновки данных.
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Компоновщик.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));

#КонецОбласти

#Область ВыполнениеЗапроса
	
	Запрос = Новый Запрос(МакетКомпоновкиДанных.НаборыДанных.НаборДанных.Запрос);
	
	// Заполнение параметров с полей отбора компоновщика настроек формы обработки.
	Для каждого Параметр Из МакетКомпоновкиДанных.ЗначенияПараметров Цикл
		Запрос.Параметры.Вставить(Параметр.Имя, Параметр.Значение);
	КонецЦикла;
		
	СтруктураРезультата.Таблица = Запрос.Выполнить().Выгрузить();	
		
	Возврат СтруктураРезультата;

#КонецОбласти
	
КонецФункции

&НаСервере
Функция УстановитьЗначениеПараметраСКД(КомпоновщикНастроек, ИмяПараметра, ЗначениеПараметра, ИспользоватьНеЗаполненный = Истина)
	
	ПараметрУстановлен = Ложь;
	
	ПараметрКомпоновкиДанных = Новый ПараметрКомпоновкиДанных(ИмяПараметра);
	ЗначениеПараметраКомпоновкиДанных = КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновкиДанных);
	Если ЗначениеПараметраКомпоновкиДанных <> Неопределено Тогда
		
		ЗначениеПараметраКомпоновкиДанных.Значение = ЗначениеПараметра;
		ЗначениеПараметраКомпоновкиДанных.Использование = ?(ИспользоватьНеЗаполненный, Истина, ЗначениеЗаполнено(ЗначениеПараметраКомпоновкиДанных.Значение));
		
		ПараметрУстановлен = Истина;
		
	КонецЕсли;
	
	Возврат ПараметрУстановлен;
	
КонецФункции

// Функция возвращает пустую структуру настроек
// 
// Параметры: 
//  Нет
// 
// Возвращаемое значение: 
//  Структура - структура настроек
&НаСервере
Функция СтруктураНастроек() Экспорт
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ИсходныеДанные",                         Неопределено);
	СтруктураНастроек.Вставить("ОбязательныеПоля",                       Новый Массив);
	СтруктураНастроек.Вставить("СоответствиеШаблоновИСтруктурыШаблонов", Новый Соответствие);
	СтруктураНастроек.Вставить("ПараметрыДанных"    ,                    Новый Структура);
	СтруктураНастроек.Вставить("КомпоновщикНастроек",                    Неопределено);
	СтруктураНастроек.Вставить("ИмяМакетаСхемыКомпоновкиДанных",         Неопределено);
	
	Возврат СтруктураНастроек;
	
КонецФункции

#КонецОбласти

