&НаСервере
Процедура ПроверкаНаличияВыбранныхСтрок(Отказ = Ложь)
	
	ДеревоКДоставке = РеквизитФормыВЗначение("ТаблицаКДоставке", Тип("ДеревоЗначений"));
	ВыбранныеСтроки = ДеревоКДоставке.Строки.НайтиСтроки(Новый Структура("Выбрать", Истина), Истина);
	Если ВыбранныеСтроки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не выбрано ни одной строки.");
		Отказ = Истина;
	КОнецЕсли;	
