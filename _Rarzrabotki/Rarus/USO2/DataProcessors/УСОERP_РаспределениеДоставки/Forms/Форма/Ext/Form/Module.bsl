&НаСервере
Процедура ЗаполнитьТаблицуКДоставкеНаСервере(ПроверятьЗаполнение = Истина, Сохранять = Истина)
	
	// Поля необходимые для вывода в таблицу товаров на форме.
	//СтруктураНастроек = Обработки.УСОERP_РаспределениеДоставки.СтруктураНастроек();
	СтруктураНастроек = СтруктураНастроек();
	
	УстановитьОбязательныеПоляДанных(СтруктураНастроек);
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Объект.Организация);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "МакетМатериалы";
			
	Объект.КДоставке.Очистить();

	НомерСтроки = 0;
	
	// Загрузка сформированного списка товаров.
	//СтруктураРезультата = Обработки.УСОERP_РаспределениеДоставки.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	СтруктураРезультата = ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	ИспользоватьХарактеристикиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	ИспользоватьУпаковкиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьУпаковкиНоменклатуры");
	
	Для Каждого СтрокаТЧ Из СтруктураРезультата.Таблица Цикл
		
		НоваяСтрока = Объект.КДоставке.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
		НомерСтроки = НомерСтроки + 1;
		
		Если СтруктураРезультата.Таблица.Колонки.Найти("СрокДоставки")=Неопределено Тогда
			Если Не СтруктураРезультата.Таблица.Колонки.Найти("ОжидаемаяДатаДоставки")= Неопределено Тогда
				Если ЗначениеЗаполнено(СтрокаТЧ.ОжидаемаяДатаДоставки) тогда
					НоваяСтрока.СрокДоставки = СтрокаТЧ.ОжидаемаяДатаДоставки;
				Иначе
					НоваяСтрока.СрокДоставки = СтрокаТЧ.ДатаПоступления;
				КонецЕсли;
			Иначе
				НоваяСтрока.СрокДоставки = СтрокаТЧ.ДатаПоступления;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
				
	Если ВариантГруппировки = "ПоНоменклатуре" Тогда
		ВывестиДеревоКДоставкеПоНоменклатуре(Истина);
		Элементы.ТаблицаКДоставкеПоЗаказам.Обновить();
	Иначе
		ВывестиДеревоКДоставкеПоЗаказам(Истина);
		Элементы.ТаблицаКДоставкеПоНоменклатуре.Обновить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиДеревоКДоставкеПоНоменклатуре(ЗаполнениеТаблиц = Ложь)
	
	ДеревоКДоставке = ДанныеФормыВЗначение(ТаблицаКДоставке, Тип("ДеревоЗначений"));

	ТаблицаДанныеКДоставке = Объект.КДоставке.Выгрузить(); 
	Если НЕ ЗаполнениеТаблиц Тогда
		ТаблицаДанныеКДоставке.Очистить();
		
		Для Каждого СтрокаДерева Из ДеревоКДоставке.Строки Цикл
			Для Каждого СтрокаКДоставке Из СтрокаДерева.Строки Цикл
				НоваяСтрока = ТаблицаДанныеКДоставке.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКДоставке);
			КонецЦикла;
		КонецЦикла;
		Объект.КДоставке.Загрузить(ТаблицаДанныеКДоставке);
	КонецЕсли;

	ТаблицаГруппировок = ТаблицаДанныеКДоставке.Скопировать();
	ТаблицаГруппировок.Свернуть("Номенклатура, Характеристика, Упаковка", "КоличествоУпаковок, Количество, Вес");
	
	ДеревоКДоставке = ДанныеФормыВЗначение(ТаблицаКДоставке, Тип("ДеревоЗначений"));
	ДеревоКДоставке.Строки.Очистить();
	Для Каждого СтрГруппировка Из ТаблицаГруппировок Цикл
		НоваяСтрокаДерева = ДеревоКДоставке.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДерева, СтрГруппировка);
		НоваяСтрокаДерева.ХарактеристикиИспользуются = (НЕ НоваяСтрокаДерева.Номенклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать);
		
		МассивСтрок =  ТаблицаДанныеКДоставке.НайтиСтроки(Новый Структура("Номенклатура, Характеристика, Упаковка", СтрГруппировка.Номенклатура, СтрГруппировка.Характеристика, СтрГруппировка.Упаковка));
		Для Каждого СтрДанные Из МассивСтрок Цикл
			НоваяСтрока = НоваяСтрокаДерева.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрДанные);
			НоваяСтрока.УровеньСтроки = 1;
			НоваяСтрока.ХарактеристикиИспользуются = (НЕ НоваяСтрока.Номенклатура.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать);
		КонецЦикла;
	КонецЦикла;
	ЗначениеВРеквизитФормы(ДеревоКДоставке, "ТаблицаКДоставке");	
	
КонецПроцедуры

&НаСервере
