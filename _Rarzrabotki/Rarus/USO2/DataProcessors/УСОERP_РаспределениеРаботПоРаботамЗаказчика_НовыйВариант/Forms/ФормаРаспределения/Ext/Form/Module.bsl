&НаКлиенте
Процедура КомандаПеренести(Команда)
	
	Если СуммаТаблицы <> 100 Тогда
		ПоказатьПредупреждение(,"Неверно распределены работы!");
		Возврат;
	КонецЕсли;
	
	Если ТаблицаРаспределения.НайтиСтроки(Новый Структура("РаботаВнешняя",ПредопределенноеЗначение("Справочник.УСОERP_СтроительныеРаботы.ПустаяСсылка"))).Количество() Тогда
		ПоказатьПредупреждение(,"Не заполнены работы!");
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(ТаблицаРаспределения);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРаспределенияРаботаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если  ПроверитьРаботу(ВыбранноеЗначение) Тогда
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьРаботу(Работа)
	
	Если Работа.СуммарнаяРабота ИЛИ ТаблицаРаспределения.НайтиСтроки(Новый Структура("РаботаВнешняя",Работа)).Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
	
	
КонецФункции


&НаКлиенте
Процедура ТаблицаРаспределенияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элементы.ТаблицаРаспределения.ТекущиеДанные.РаспределениеСтоимостиРабот = 100;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРаспределенияПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	СуммаТаблицы = ТаблицаРаспределения.Итог("РаспределениеСтоимостиРабот");
КонецПроцедуры
