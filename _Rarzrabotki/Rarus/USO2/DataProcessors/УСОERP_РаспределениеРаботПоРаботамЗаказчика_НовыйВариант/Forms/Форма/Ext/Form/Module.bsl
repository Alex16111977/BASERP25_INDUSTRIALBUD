
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 	

Пункт1=Элементы.Добавить("СписокИсточникКонтекстноеМенюРаспределитьПоРаботамЗаказчика", Тип("КнопкаФормы"), Элементы.СписокИсточник.КонтекстноеМеню);
Пункт1.Заголовок="Распределить по работам заказчика";
Пункт1.ИмяКоманды="КомандаРаспределитьПоРаботамЗаказчика";

КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыСписка(ЗаполнятьТаблицу = Истина)
	
	Если ЗаполнятьТаблицу Тогда
	ЗаполнитьТаблицуСопоставления();
	КонецЕсли;
	
	СценарийПланирования = ДокументУтверждения.КопияСценария;
	СписокИсточник.Отбор.Элементы.Очистить();

	СписокИсточник.Параметры.УстановитьЗначениеПараметра("СценарийПланирования",СценарийПланирования);
	СписокИсточник.Параметры.УстановитьЗначениеПараметра("МассивРабот",ТаблицаСопоставления.Выгрузить().ВыгрузитьКолонку("Работа"));
			
	ЭлементОтбора = СписокИсточник.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = СценарийПланирования;  	
	
	СписокПриемник.Отбор.Элементы.Очистить();
	
	СписокПриемник.Параметры.УстановитьЗначениеПараметра("СценарийПриемник",СценарийПриемник);
		
	ЭлементОтбора = СписокПриемник.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ПравоеЗначение = СценарийПриемник;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗаписиРегистра(СценарийПланирования,СценарийПриемник)
	
	 Запрос = Новый Запрос;
	 Запрос.УстановитьПараметр("СценарийПланирования",СценарийПланирования);
	 Запрос.УстановитьПараметр("СценарийПриемник",СценарийПриемник);
	 
	 Запрос.Текст =
	 "ВЫБРАТЬ
	 |	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа КАК Работа,
	 |	УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя КАК РаботаВнешняя,
	 |	УСОERP_СоответствиеРаботРаботамЗаказчика.РаспределениеСтоимостиРабот КАК РаспределениеСтоимостиРабот,
	 |	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа.СуммарнаяРабота КАК СуммарнаяРабота,
	 |	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа.ПорядокСортировки КАК ПорядокСортировки
	 |ИЗ
	 |	РегистрСведений.УСОERP_СоответствиеРаботРаботамЗаказчика КАК УСОERP_СоответствиеРаботРаботамЗаказчика
	 |ГДЕ
	 |	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа.Владелец = &СценарийПланирования
	 |	И УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец = &СценарийПриемник
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	ПорядокСортировки";
	 
	 Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуСопоставления()
	
   	 ТЗ = ПолучитьЗаписиРегистра(ДокументУтверждения.КопияСценария,СценарийПриемник);
	 ЗначениеВРеквизитФормы(ТЗ,"ТаблицаСопоставления");	
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументУтвержденияПриИзменении(Элемент)
	
	УстановитьПараметрыСписка();

КонецПроцедуры

&НаКлиенте
Процедура СценарийПриемникПриИзменении(Элемент)
	
	УстановитьПараметрыСписка();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.КомандаПоказатьНастройки.Пометка = Не ЗначениеЗаполнено(ДокументУтверждения);

	УстановитьПараметрыСписка();
	УстановитьВидимость();
	ОбработатьПереносРаботы();
	УстановитьПараметрыСписка(Ложь);    

КонецПроцедуры

&НаКлиенте
Процедура КомандаПеренестиРаботу(Команда)
	
	ТекДанные = Элементы.СписокПриемник.ТекущиеДанные;
	Если ТекДанные = Неопределено ИЛИ ТекДанные.СуммарнаяРабота Тогда
		Возврат;
	КонецЕсли;
	
	ТекРабота = Элементы.СписокИсточник.ТекущиеДанные;
	
	Если ТекРабота = Неопределено Тогда
		Возврат;
	КонецЕсли; 	
	
	МассивРабот = Элементы.СписокИсточник.ВыделенныеСтроки;
	
	ПеренестиРаботу(МассивРабот,ТекДанные.Ссылка);
		
	УстановитьПараметрыСписка(Ложь); 
	Модифицированность = Истина;
	
КонецПроцедуры  

&НаКлиенте
Процедура СписокПриемникПриАктивизацииСтроки(Элемент)
	ТекСтрока = Элементы.СписокПриемник.ТекущаяСтрока;
	Элементы.ТаблицаСопоставления.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("РаботаВнешняя,СуммарнаяРабота",ТекСтрока,Ложь));
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСопоставленияПослеУдаления(Элемент)
	
	ОбработатьПереносРаботы(Истина);
	УстановитьПараметрыСписка(Ложь);
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ПеренестиРаботу(Работа,РаботаПриемник)
	
	ТЗ = РеквизитФормыВЗначение("ТаблицаСопоставления");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Группа",Работа);
	Запрос.УстановитьПараметр("РаботаВнешняя",РаботаПриемник);
	Запрос.УстановитьПараметр("МассивРабот",ТЗ.ВыгрузитьКолонку("Работа"));
	Запрос.УстановитьПараметр("СценарийПланирования",СценарийПланирования);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
	|	УСОERP_СтроительныеРаботы.СуммарнаяРабота КАК СуммарнаяРабота,
	|	&РаботаВнешняя КАК РаботаВнешняя,
	|	100 КАК РаспределениеСтоимостиРабот,
	|	УСОERP_СтроительныеРаботы.ПорядокСортировки КАК ПорядокСортировки
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Ссылка В ИЕРАРХИИ(&Группа)
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И НЕ УСОERP_СтроительныеРаботы.Ссылка В (&МассивРабот)
	|	И УСОERP_СтроительныеРаботы.Владелец = &СценарийПланирования";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ТЗ.Добавить(),Выборка);
		
	КонецЦикла;
	
	ТЗ.Сортировать("ПорядокСортировки");
	
	ЗначениеВРеквизитФормы(ТЗ,"ТаблицаСопоставления");
	
	ОбработатьПереносРаботы();
	
КонецПроцедуры  

&НаСервере
Процедура ОбработатьПереносРаботы(Удаление = Ложь) 	
	
	ТЗ = РеквизитФормыВЗначение("ТаблицаСопоставления");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	Запрос.УстановитьПараметр("СценарийПланирования",ДокументУтверждения.КопияСценария);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Работа КАК Работа,
	|	ТЗ.РаботаВнешняя КАК РаботаВнешняя,
	|	ТЗ.РаспределениеСтоимостиРабот КАК РаспределениеСтоимостиРабот,
	|	ТЗ.СуммарнаяРабота КАК СуммарнаяРабота
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УСОERP_СтроительныеРаботы.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ВрТаб.Работа ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьВТаблице,
	|	УСОERP_СтроительныеРаботы.КодСДР КАК КодСДР,
	|	УСОERP_СтроительныеРаботы.СуммарнаяРабота КАК СуммарнаяРабота
	|ИЗ
	|	Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВрТаб КАК ВрТаб
	|		ПО УСОERP_СтроительныеРаботы.Ссылка = ВрТаб.Работа
	|ГДЕ
	|	УСОERP_СтроительныеРаботы.Владелец = &СценарийПланирования
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СтроительныеРаботы.НомерРаботыВУровне
	|ИТОГИ
	|	МИНИМУМ(ЕстьВТаблице)
	|ПО
	|	Ссылка ИЕРАРХИЯ";	
	
	ДеревоДанных = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Строки = ДеревоДанных.Строки.НайтиСтроки(Новый Структура("СуммарнаяРабота,ЕстьВТаблице",Истина,Истина),Истина);
	
	Для Каждого НайденнаяСтрока ИЗ Строки Цикл
		
		Нстр = Тз.Добавить();
		Нстр.Работа = НайденнаяСтрока.Ссылка;
		Нстр.СуммарнаяРабота = Истина;
		
	КонецЦикла;   
	
	Если Удаление Тогда
		
		МассивСтрокДляУдаления = Новый Массив;
		
		Строки = ТЗ.НайтиСтроки(Новый Структура("СуммарнаяРабота",Истина));
		
		Для Каждого НайденнаяСтрока ИЗ Строки Цикл
			
			Если ДеревоДанных.Строки.НайтиСтроки(Новый Структура("Ссылка,ЕстьВТаблице",НайденнаяСтрока.Работа,Ложь),Истина).Количество() Тогда
				
				МассивСтрокДляУдаления.Добавить(НайденнаяСтрока);
				
			КонецЕсли;   			
			
		КонецЦикла;
		
		Для Каждого ЭлементМассива ИЗ МассивСтрокДляУдаления Цикл
			
			ТЗ.Удалить(ЭлементМассива);
			
		КонецЦикла;  		
		
	КонецЕсли;  	
	
	ЗначениеВРеквизитФормы(ТЗ,"ТаблицаСопоставления");  	
	
КонецПроцедуры  

