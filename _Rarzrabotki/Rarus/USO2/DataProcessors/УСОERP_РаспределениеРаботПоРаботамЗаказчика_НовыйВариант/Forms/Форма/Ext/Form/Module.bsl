Процедура СписокИсточникПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	 
КонецПроцедуры  

&НаКлиенте
Процедура КомандаЗаписать(Команда)
	
	Если НЕ ПроверитьНаПравильность() Тогда
		Возврат;
	КонецЕсли;
	
	КомандаЗаписатьНаСервере();
	Модифицированность = Ложь;
КонецПроцедуры 

&НаСервере
Функция ПроверитьНаПравильность()
	
	Результат = Истина;
	
	ТЗ = РеквизитФормыВЗначение("ТаблицаСопоставления");
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗ",ТЗ);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТЗ.Работа КАК Справочник.УСОERP_СтроительныеРаботы) КАК Работа,
	|	ТЗ.РаботаВнешняя КАК РаботаВнешняя,
	|	ТЗ.РаспределениеСтоимостиРабот КАК РаспределениеСтоимостиРабот
	|ПОМЕСТИТЬ ВрТаб
	|ИЗ
	|	&ТЗ КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВрТаб.Работа КАК Работа,
	|	СУММА(ВрТаб.РаспределениеСтоимостиРабот) КАК РаспределениеСтоимостиРабот
	|ИЗ
	|	ВрТаб КАК ВрТаб
	|ГДЕ
	|	НЕ ВрТаб.Работа.СуммарнаяРабота
	|
	|СГРУППИРОВАТЬ ПО
	|	ВрТаб.Работа
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВрТаб.РаспределениеСтоимостиРабот) <> 100";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат = Ложь;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Неверное распределение работы "+Выборка.Работа+" ("+Выборка.Работа.КодСДР+"), сумма распределения = "+Выборка.РаспределениеСтоимостиРабот+"%");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


&НаСервере
Процедура КомандаЗаписатьНаСервере()
	
	ТЗ = ПолучитьЗаписиРегистра(ДокументУтверждения.КопияСценария,СценарийПриемник);
	
	Для Каждого СтрокаТЗ ИЗ ТЗ Цикл
		
		МЗ = РегистрыСведений.УСОERP_СоответствиеРаботРаботамЗаказчика.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ,СТрокаТЗ);
		МЗ.Удалить();
		
	КонецЦикла; 
	
	ТЗ = РеквизитФормыВЗначение("ТаблицаСопоставления");  	
	
	Для Каждого СтрокаТЗ ИЗ ТЗ Цикл
		
		Если СтрокаТЗ.СуммарнаяРабота Тогда
			Продолжить;
		КонецЕсли;
		
			МЗ = РегистрыСведений.УСОERP_СоответствиеРаботРаботамЗаказчика.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ,СТрокаТЗ);
		МЗ.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

