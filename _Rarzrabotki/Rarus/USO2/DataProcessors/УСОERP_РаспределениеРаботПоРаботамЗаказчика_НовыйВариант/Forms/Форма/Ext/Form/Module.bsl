	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаполнитьПоПредыдущемуСценарию(Команда)
	
	ПараметрыОтбора = Новый Структура("ОбъектСтроительства,Проведен,Статус",ОбъектСтроительства,Истина,ПредопределенноеЗначение("Перечисление.СтатусыПланов.Утвержден"));
	ПараметрыВыбора = Новый Структура("Отбор",ПараметрыОтбора);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоСценариюПродолжение",ЭтотОбъект);
	
	ОткрытьФорму("Документ.УСОERP_УтверждениеКалендарногоПланаГрафика.Форма.ФормаВыбора",ПараметрыВыбора,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	   
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоСценариюПродолжение(ВыбранноеЗначение,ДопПараметры)Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура("ДокументУтверждения",ВыбранноеЗначение);
	
	Если ТаблицаСопоставления.Количество() Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоСценариюОкончание",ЭтотОбъект,ПараметрыЗаполнения);		
		ПоказатьВопрос(ОписаниеОповещения,"Текущие данные будут очищены, продолжить?",РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ЗаполнитьПоСценариюОкончание(КодВозвратаДиалога.Да,ПараметрыЗаполнения);
		
	КонецЕсли;   	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоСценариюОкончание(Ответ,ДопПараметры)Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоСценариюНаСервере(ДопПараметры.ДокументУтверждения);
	Модифицированность = Истина;
		
КонецПроцедуры

&НаСервере
Процедура   ЗаполнитьПоСценариюНаСервере(ТекДокумент)
	
	  ТекСценарий = ТекДокумент.КопияСценария;
	  
	  Запрос = Новый Запрос;
	  Запрос.УстановитьПараметр("ТекСценарий",ТекСценарий);
	  Запрос.УстановитьПараметр("СценарийПланирования",СценарийПланирования);
	  Запрос.УстановитьПараметр("СценарийПриемник",СценарийПриемник);
	  Запрос.Текст = 
	  "ВЫБРАТЬ
	  |	УСОERP_СтроительныеРаботы.Ссылка КАК Работа,
	  |	УСОERP_СтроительныеРаботы.ПорядокСортировки КАК ПорядокСортировки,
	  |	УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя КАК РаботаВнешняя,
	  |	УСОERP_СоответствиеРаботРаботамЗаказчика.РаспределениеСтоимостиРабот КАК РаспределениеСтоимостиРабот,
	  |	УСОERP_СтроительныеРаботы.СуммарнаяРабота КАК СуммарнаяРабота
	  |ИЗ
	  |	РегистрСведений.УСОERP_СоответствиеРаботРаботамЗаказчика КАК УСОERP_СоответствиеРаботРаботамЗаказчика
	  |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	  |		ПО УСОERP_СоответствиеРаботРаботамЗаказчика.Работа.РаботаИсточник = УСОERP_СтроительныеРаботы.РаботаИсточник
	  |ГДЕ
	  |	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа.Владелец = &ТекСценарий
	  |	И УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец = &СценарийПриемник
	  |	И УСОERP_СтроительныеРаботы.Владелец = &СценарийПланирования
	  |	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	  |	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	  |
	  |УПОРЯДОЧИТЬ ПО
	  |	УСОERP_СтроительныеРаботы.ПорядокСортировки";
	  
	  ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(),"ТаблицаСопоставления");
	  ОбработатьПереносРаботы();
	  УстановитьПараметрыСписка(Ложь);  
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	
	ПоказатьНастройки = Элементы.КомандаПоказатьНастройки.Пометка;
	Элементы.Организация.Видимость = ПоказатьНастройки;
	Элементы.ГруппаДокументУтверждения.Видимость = ПоказатьНастройки;
	Элементы.ОрганизацияПриемник.Видимость = ПоказатьНастройки;
	Элементы.ГруппаСценарийПриемник.Видимость = ПоказатьНастройки;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаПоказатьНастройки(Команда)
	
	Элементы.КомандаПоказатьНастройки.Пометка = НЕ Элементы.КомандаПоказатьНастройки.Пометка;
	УстановитьВидимость();
	
КонецПроцедуры 

&НаКлиенте
Процедура КомандаЗаполнитьПоПредыдущемуСценариюЗаказчика(Команда)
	
	ПараметрыОтбора = Новый Структура("Владелец,ВидСценария",ОбъектСтроительства,ПредопределенноеЗначение("Перечисление.УСОERP_ВидыСценариевПланирования.ВнешнийРабочий"));
	ПараметрыВыбора = Новый Структура("Отбор,ОтборВерсийДляОтчета",ПараметрыОтбора,Истина);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоСценариюЗаказчикаПродолжение",ЭтотОбъект);
	
	ОткрытьФорму("Справочник.УСОERP_СценарииПланированияПроектовСтроительства.Форма.ФормаВыбораВерсий",ПараметрыВыбора,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьПоСценариюЗаказчикаПродолжение(ВыбранноеЗначение,ДопПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура("СценарийЗаказчика",ВыбранноеЗначение);
	
	Если ТаблицаСопоставления.Количество() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьПоСценариюЗаказчикаОкончание",ЭтотОбъект,ПараметрыЗаполнения);
		ПоказатьВопрос(ОписаниеОповещения,"Текущие данные будут очищены, продолжить?",РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПоСценариюЗаказчикаОкончание(КодВозвратаДиалога.Да,ПараметрыЗаполнения);
	КонецЕсли;  	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоСценариюЗаказчикаОкончание(Ответ,ДопПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьПоСценариюЗаказчикаНаСервере(ДопПараметры);	
	Модифицированность = Истина;		
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПоСценариюЗаказчикаНаСервере(ДопПараметры)
	
	Запрос= Новый Запрос;
	
	Запрос.УстановитьПараметр("СценарийЗаказчика",ДопПараметры.СценарийЗаказчика);
	Запрос.УстановитьПараметр("СценарийПланирования",ДокументУтверждения.КопияСценария);
	Запрос.УстановитьПараметр("ТекСценарий",СценарийПриемник);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа КАК Работа,
	|	УСОERP_СтроительныеРаботы.Ссылка КАК РаботаВнешняя,
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаспределениеСтоимостиРабот КАК РаспределениеСтоимостиРабот,
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа.ПорядокСортировки КАК ПорядокСортировки,
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа.СуммарнаяРабота КАК СуммарнаяРабота
	|ИЗ
	|	РегистрСведений.УСОERP_СоответствиеРаботРаботамЗаказчика КАК УСОERP_СоответствиеРаботРаботамЗаказчика
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.УСОERP_СтроительныеРаботы КАК УСОERP_СтроительныеРаботы
	|		ПО УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.РаботаИсточник = УСОERP_СтроительныеРаботы.РаботаИсточник
	|ГДЕ
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.РаботаВнешняя.Владелец = &СценарийЗаказчика
	|	И УСОERP_СоответствиеРаботРаботамЗаказчика.Работа.Владелец = &СценарийПланирования
	|	И УСОERP_СтроительныеРаботы.Владелец = &ТекСценарий
	|	И НЕ УСОERP_СтроительныеРаботы.ПометкаУдаления
	|	И НЕ УСОERP_СтроительныеРаботы.СуммарнаяРабота
	|
	|УПОРЯДОЧИТЬ ПО
	|	УСОERP_СоответствиеРаботРаботамЗаказчика.Работа.ПорядокСортировки";
	
	  ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(),"ТаблицаСопоставления");
	  ОбработатьПереносРаботы();
	  УстановитьПараметрыСписка(Ложь); 
	  
КонецПроцедуры 

&НаКлиенте
Процедура КомандаРаспределитьПоРаботамЗаказчика(Команда)
	
	ТекСтрока = Элементы.СписокИсточник.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено ИЛИ ТекСтрока.СуммарнаяРабота= Истина Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура("Работа,СценарийЗаказчика",ТекСтрока.Ссылка,СценарийПриемник);
	ОписаниеОповещения = Новый ОписаниеОповещения("РаспределитьПоРаботамПродолжение",ЭтотОбъект);
	
	ОткрытьФорму("Обработка.УСОERP_РаспределениеРаботПоРаботамЗаказчика_НовыйВариант.Форма.ФормаРаспределения",СтруктураПараметров,ЭтотОбъект,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПоРаботамПродолжение(Результат,ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.СписокИсточник.ТекущиеДанные;
	
	Для Каждого СтрокаТЗ ИЗ Результат Цикл
		
		Нстр = ТаблицаСопоставления.Добавить();
		Нстр.Работа = ТекСтрока.Ссылка;
		Нстр.ПорядокСортировки = ТекСтрока.ПорядокСортировки;
		ЗаполнитьЗначенияСвойств(Нстр,СтрокаТЗ);  		
		
	КонецЦикла;
	
	ОбработатьПереносРаботы();
	
	УстановитьПараметрыСписка(Ложь);
	ТаблицаСопоставления.Сортировать("ПорядокСортировки");
	Модифицированность = Истина;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы Тогда
		
		Если Модифицированность Тогда
			
			СтандартнаяОбработка = Ложь;
			Отказ = Истина;
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемПродолжение",ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещения,"Данные были изменены, сохранить изменения?",РежимДиалогаВопрос.ДаНетОтмена);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемПродолжение(Ответ,ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Закрыть();
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		КомандаЗаписать(Истина);
		Закрыть();
	КонецЕсли; 	
	
КонецПроцедуры

