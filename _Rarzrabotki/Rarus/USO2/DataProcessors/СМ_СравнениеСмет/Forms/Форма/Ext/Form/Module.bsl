&НаСервере
Функция СформироватьОтборРасценок(ПоляПоиска)
	ТекстОтбора = "ОрборРасценок = Новый Структура(""";
	
	Для Каждого стр из ПоляПоиска Цикл
		Если Не стр.Поиск Тогда
			Продолжить;
		КонецЕсли;
		ТекстОтбора = ТекстОтбора+стр.ИмяРеквизита+",";
	КонецЦикла;
	ТекстОтбора = Лев(ТекстОтбора,СтрДлина(ТекстОтбора)-1)+""",";
	
	Для Каждого стр из ПоляПоиска Цикл
		Если Не стр.Поиск Тогда
			Продолжить;
		КонецЕсли;
		ТекстОтбора = ТекстОтбора+"стр."+стр.ИмяРеквизитаДоп+",";
	КонецЦикла;
	ТекстОтбора = Лев(ТекстОтбора,СтрДлина(ТекстОтбора)-1)+")";
	
	Возврат ТекстОтбора;
КонецФункции

&НаСервере
Процедура ВывестиУровень(РеквизитыСравнения,Макет,СтрокиДерева,СтрокиДерева2,ПолноеДерево,ТекстОтбора,Уровень,Пусто = Ложь)
	
	Для Каждого стр Из СтрокиДерева Цикл
		
		Если стр.ТипСтроки <= 1 Тогда // разделы.
			
			СтрокаСравнения = Неопределено;
			Если СтрокиДерева2 = Неопределено Тогда
				МассивСтрок = ПолноеДерево.Строки.НайтиСтроки(Новый Структура("Наименование1,Уровень1,Обработано1",стр.Наименование,стр.Уровень,Ложь),Истина)
			Иначе
				МассивСтрок = СтрокиДерева2.НайтиСтроки(Новый Структура("Наименование1,Уровень1,Обработано1",стр.Наименование,стр.Уровень,Ложь),Истина)
			КонецЕсли;
			
			Если МассивСтрок.Количество()>0 Тогда
				СтрокаСравнения = МассивСтрок[0];
			КонецЕсли;
			
			Если Не СтрокаСравнения = Неопределено Тогда
				СтрокаСравнения.Обработано1 = Истина;
				ОбластьРаздел = Макет.ПолучитьОбласть("ОбластьРаздел");
				ОбластьРаздел.Параметры.Заполнить(стр);
				ОбластьРаздел.Параметры.Заполнить(СтрокаСравнения);
				ШаблонСДанными.Вывести(ОбластьРаздел,Уровень);
				ВывестиУровень(РеквизитыСравнения,Макет,стр.Строки,СтрокаСравнения.Строки,ПолноеДерево,ТекстОтбора,Уровень+1);
				
				МассивСтрок = СтрокаСравнения.Строки.НайтиСтроки(Новый Структура("Обработано1",Ложь),Ложь);
				ВывестиНеОбработанные(Макет,МассивСтрок,Уровень+1,Ложь);
				
				МассивСтрок = ПолноеДерево.Строки.НайтиСтроки(Новый Структура("Уровень1,Обработано1",стр.Уровень+1,Ложь),Ложь);
				ВывестиНеОбработанные(Макет,МассивСтрок,Уровень,Ложь);
			Иначе
				ОбластьРаздел = Макет.ПолучитьОбласть("ОбластьРазделПусто");
				ОбластьРаздел.Параметры.Заполнить(стр);
				ШаблонСДанными.Вывести(ОбластьРаздел,Уровень);
				ВывестиУровень(РеквизитыСравнения,Макет,стр.Строки,Неопределено,ПолноеДерево,ТекстОтбора,Уровень+1,Истина);
			КонецЕсли;
			
		Иначе // позиции.
			
			Если Пусто Тогда // позиции не найденного раздела.
				
				Если стр.ТипСтроки = 2 Тогда
					ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПусто");
					ОбластьПозиция.Параметры.Заполнить(стр);
					ШаблонСДанными.Вывести(ОбластьПозиция,Уровень);
				Иначе
					ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПодчиненПусто");
					ОбластьПозиция.Параметры.Заполнить(стр);
					ШаблонСДанными.Вывести(ОбластьПозиция,Уровень+1);
				КонецЕсли;
				
			Иначе 
				
				ОрборРасценок = "";
				Выполнить(ТекстОтбора);
				ОрборРасценок.Вставить("ТипСтроки1",стр.ТипСтроки);
				ОрборРасценок.Вставить("Обработано1",Ложь);
				МассивСтрок = СтрокиДерева2.НайтиСтроки(ОрборРасценок,Ложь);

				СтрокаСравнения = Неопределено;
				Если МассивСтрок.Количество()>0 Тогда
					СтрокаСравнения = МассивСтрок[0];
					СтрокаСравнения.Обработано1 = Истина;
				КонецЕсли;

				Если СтрокаСравнения = Неопределено Тогда // не нашли позицию.
					
					Если стр.ТипСтроки = 2 Тогда
						ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПусто");
						ОбластьПозиция.Параметры.Заполнить(стр);
						ШаблонСДанными.Вывести(ОбластьПозиция,Уровень);
					Иначе
						ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПодчиненПусто");
						ОбластьПозиция.Параметры.Заполнить(стр);
						ШаблонСДанными.Вывести(ОбластьПозиция,Уровень+1);
					КонецЕсли;

				Иначе
					
					ЕстьРазличия = СверитьДанныеПозиций(стр,СтрокаСравнения,РеквизитыСравнения);
					Если стр.ТипСтроки = 2 Тогда
						ОбластьПозиция = ?(ЕстьРазличия,Макет.ПолучитьОбласть("ОбластьРазличия"),Макет.ПолучитьОбласть("ОбластьПозиция"));
						ОбластьПозиция.Параметры.Заполнить(стр);
						ОбластьПозиция.Параметры.Заполнить(СтрокаСравнения);
						Если СравнениеПоАкту Тогда
							ОбластьПозиция.Параметры.Кол1 = СтрокаСравнения.ОбъемПоАкту1; 	
						КонецЕсли;
						ШаблонСДанными.Вывести(ОбластьПозиция,Уровень);
					Иначе
						ОбластьПозиция = ?(ЕстьРазличия,Макет.ПолучитьОбласть("ОбластьПодчиненРазличия"),Макет.ПолучитьОбласть("ОбластьПодчинен"));
						ОбластьПозиция.Параметры.Заполнить(стр);
						ОбластьПозиция.Параметры.Заполнить(СтрокаСравнения);
						Если СравнениеПоАкту Тогда
							ОбластьПозиция.Параметры.Кол1 = СтрокаСравнения.ОбъемПоАкту1; 	
						КонецЕсли;
						ШаблонСДанными.Вывести(ОбластьПозиция,Уровень+1);
					КонецЕсли;
						
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиНеОбработанные(Макет,МассивСтрок,Уровень,ИскатьПодчиненные = Истина)
	
	Для Каждого стр Из МассивСтрок Цикл
		
		Если стр.Обработано1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если стр.ТипСтроки1 <= 1 Тогда // разделы.
			стр.Обработано1 = Истина;
			ОбластьРаздел = Макет.ПолучитьОбласть("ОбластьРазделПусто");
			ОбластьРаздел.Параметры.Заполнить(стр);
			ШаблонСДанными.Вывести(ОбластьРаздел,Уровень);
			
			МассивСтрокНовый = стр.Строки.НайтиСтроки(Новый Структура("Обработано1",Ложь),ИскатьПодчиненные);
			ВывестиНеОбработанные(Макет,МассивСтрокНовый,Уровень+1);
			
		Иначе // позиции.
			стр.Обработано1 = Истина;
			Если стр.ТипСтроки1 = 2 Тогда
				ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПусто");
				ОбластьПозиция.Параметры.Заполнить(стр);
				ШаблонСДанными.Вывести(ОбластьПозиция,Уровень);
			Иначе
				ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПодчиненПусто");
				ОбластьПозиция.Параметры.Заполнить(стр);
				ШаблонСДанными.Вывести(ОбластьПозиция,Уровень+1);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СверитьДанныеПозиций(СтрокаЭталон,СтрокаСравнения,РеквизитыСравнения)
	
	ЕстьРазличия = Ложь;
	Для Каждого КлючИЗначение Из РеквизитыСравнения Цикл
		Если Не СтрокаЭталон[КлючИЗначение.Ключ] = СтрокаСравнения[КлючИЗначение.Значение] Тогда
			ЕстьРазличия = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьРазличия;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьАктПоСмете()

	Объект.Акт = Документы.СМ_АктВыполненныхРабот.ПустаяСсылка();
	ТабАктов = СМ_СметаВызовСервера.ПолучитьАктыСметы(Объект.Смета1);
	Если ТабАктов.Количество() > 0 Тогда
		Для Каждого ТекСтрока Из ТабАктов Цикл
			Если НЕ ТекСтрока.Ссылка.ПометкаУдаления Тогда
				Объект.Акт = ТекСтрока.Ссылка;	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиДанныеПоОС(РеквизитыСравнения,Макет,ТабДанных1,ТабДанных2,ТаблицаДанныхОС,ТипСтроительства)
	
	ПовторИтога 	= 0;
	ПовторИтога1 	= 0;
	НомПП			= 0;
	НомПП1			= 0;
	
	Для Каждого ТекСтрока Из ТаблицаДанныхОС Цикл
		
		ВсегоПоСтроке 	= 0;
		ВсегоПоСтроке1 	= 0;
		ВыводитьСтроку 	= Истина;
		ВыводитьСтроку1 = Истина;

		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Итог",ТекСтрока.Итог);

		СтруктураОтбора1 = Новый Структура;
		СтруктураОтбора1.Вставить("Итог",ТекСтрока.Итог);

		НайденнаяСтрока 	= ТабДанных1.Найти(ТекСтрока.Итог,"Итог");
		НайденнаяСтрока1 	= ТабДанных2.Найти(ТекСтрока.Итог,"Итог1");
		
		Если ЗначениеЗаполнено(НайденнаяСтрока) Тогда
			ВсегоПоСтроке = НайденнаяСтрока.СтроительныеРаботы + НайденнаяСтрока.МонтажныеРаботы + НайденнаяСтрока.Оборудование + НайденнаяСтрока.Прочие;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденнаяСтрока1) Тогда
			ВсегоПоСтроке1 = НайденнаяСтрока1.СтроительныеРаботы1 + НайденнаяСтрока1.МонтажныеРаботы1 + НайденнаяСтрока1.Оборудование1 + НайденнаяСтрока1.Прочие1;
		КонецЕсли;
		
		Если ТипЗнч(ТекСтрока.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") Тогда
			Если ТекСтрока.Итог.Накопительный Тогда
				Если ПовторИтога = ВсегоПоСтроке Тогда
					ВыводитьСтроку = Ложь;
				КонецЕсли;
			
				Если ПовторИтога1 = ВсегоПоСтроке1 Тогда
					ВыводитьСтроку1 = Ложь;
				КонецЕсли;
				
				ПовторИтога 	= ВсегоПоСтроке;
				ПовторИтога1 	= ВсегоПоСтроке1;
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденнаяСтрока) И ЗначениеЗаполнено(НайденнаяСтрока1) Тогда
			ЕстьРазличия = СверитьДанныеСмет(НайденнаяСтрока,НайденнаяСтрока1,РеквизитыСравнения);
			Если ЕстьРазличия Тогда
				ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПустая");
			Иначе
				ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			КонецЕсли;
		Иначе
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПустая");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденнаяСтрока) И ВыводитьСтроку Тогда
			ОбластьСтрока.Параметры.Заполнить(НайденнаяСтрока);		
			ОбластьСтрока.Параметры.НаименованиеСметы	= НайденнаяСтрока.Итог.Наименование;
			ОбластьСтрока.Параметры.ВсегоПоСтроке 		= ВсегоПоСтроке;
			Если НайденнаяСтрока.ЭтоСмета Тогда
				НомПП 								= НомПП + 1;
				ОбластьСтрока.Параметры.НомерСметы 	= НайденнаяСтрока.Итог.НомерСметы;	 
				ОбластьСтрока.Параметры.НомерПП		= НомПП;
			ИначеЕсли ТипЗнч(НайденнаяСтрока.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") Тогда
				Если ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					ОбластьСтрока.Параметры.НаименованиеСметы = НайденнаяСтрока.Итог.НаименованиеРемонт;	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденнаяСтрока1) И ВыводитьСтроку1 Тогда
			ОбластьСтрока.Параметры.Заполнить(НайденнаяСтрока1);		                                                                                        
			ОбластьСтрока.Параметры.НаименованиеСметы1 	= НайденнаяСтрока1.Итог1.Наименование;
			ОбластьСтрока.Параметры.ВсегоПоСтроке1 		= ВсегоПоСтроке1;
			Если НайденнаяСтрока1.ЭтоСмета1 Тогда
				НомПП1 								= НомПП1 + 1;
				ОбластьСтрока.Параметры.НомерСметы1	= НайденнаяСтрока1.Итог1.НомерСметы;	 
				ОбластьСтрока.Параметры.НомерПП1	= НомПП1;
			ИначеЕсли ТипЗнч(НайденнаяСтрока1.Итог1) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") Тогда
				Если ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
					ОбластьСтрока.Параметры.НаименованиеСметы1 = НайденнаяСтрока1.Итог1.НаименованиеРемонт;	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ВыводитьСтроку ИЛИ ВыводитьСтроку1 Тогда
			ШаблонСДанными.Вывести(ОбластьСтрока);
		КонецЕсли;
		
	КонецЦикла;	
		
КонецПроцедуры
	
&НаСервере
Процедура ВывестиДанныеПоСС(РеквизитыСравнения,Макет,ТабДанных1,ТабДанных2,ТаблицаДанныхСС,ТабГлавы,ТипСтроительства)
	
	ПовторИтога 	= 0;
	ПовторИтога1 	= 0;
	ПовторГлавы		= 0;	
	НомПП			= 0;
	НомПП1          = 0;
	
	ШаблонСДанными.НачатьАвтогруппировкуСтрок();
	
	Для Каждого СтрокаГлавы Из ТабГлавы Цикл
		
		НайденнаяГлава 	= ТабДанных1.Найти(СтрокаГлавы.Глава,"Глава");
		НайденнаяГлава1 = ТабДанных2.Найти(СтрокаГлавы.Глава,"Глава1");
		
		Если ЗначениеЗаполнено(НайденнаяГлава) И ЗначениеЗаполнено(НайденнаяГлава1) Тогда
			ОбластьГлава = Макет.ПолучитьОбласть("Глава");	
		Иначе
			ОбластьГлава = Макет.ПолучитьОбласть("ГлаваПустая");
		КонецЕсли;
		
		//ИтогПоГлаве = СМ_СметаПечатьОбъектнаяСводнаяВызовСервера.НайтиИтогПоГлаве(СтрокаГлавы.Глава,ТипСтроительства);
		
		Если ЗначениеЗаполнено(НайденнаяГлава) Тогда
			ОбластьГлава.Параметры.НаименованиеГлавы = СтрокаГлавы.Глава.Наименование;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НайденнаяГлава1) Тогда
			ОбластьГлава.Параметры.НаименованиеГлавы1 = СтрокаГлавы.Глава.Наименование;
		КонецЕсли;
		
		СтруктураОтбораГлав = Новый Структура;
		СтруктураОтбораГлав.Вставить("Глава",СтрокаГлавы.Глава);
		НайденныеСтрокиГлавы = ТаблицаДанныхСС.НайтиСтроки(СтруктураОтбораГлав);
		
		Если СтрокаГлавы.Всего <> ПовторГлавы Тогда
			ШаблонСДанными.Вывести(ОбластьГлава,1);
		КонецЕсли;
		
		Для Каждого ТекСтрока Из НайденныеСтрокиГлавы Цикл
			
			ВсегоПоСтроке 	= 0;
			ВсегоПоСтроке1 	= 0;
			ВыводитьСтроку 	= Истина;
			ВыводитьСтроку1 = Истина;

			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("Итог",ТекСтрока.Итог);

			СтруктураОтбора1 = Новый Структура;
			СтруктураОтбора1.Вставить("Итог",ТекСтрока.Итог);

			НайденнаяСтрока 	= ТабДанных1.Найти(ТекСтрока.Итог,"Итог");
			НайденнаяСтрока1 	= ТабДанных2.Найти(ТекСтрока.Итог,"Итог1");
			
			Если ЗначениеЗаполнено(НайденнаяСтрока) Тогда
				ВсегоПоСтроке = НайденнаяСтрока.СтроительныеРаботы + НайденнаяСтрока.МонтажныеРаботы + НайденнаяСтрока.Оборудование + НайденнаяСтрока.Прочие;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НайденнаяСтрока1) Тогда
				ВсегоПоСтроке1 = НайденнаяСтрока1.СтроительныеРаботы1 + НайденнаяСтрока1.МонтажныеРаботы1 + НайденнаяСтрока1.Оборудование1 + НайденнаяСтрока1.Прочие1;
			КонецЕсли;
			
			Если ТипЗнч(ТекСтрока.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") Тогда
				Если ТекСтрока.Итог.Накопительный Тогда
					Если ПовторИтога = ВсегоПоСтроке Тогда
						ВыводитьСтроку = Ложь;
					КонецЕсли;
				
					Если ПовторИтога1 = ВсегоПоСтроке1 Тогда
						ВыводитьСтроку1 = Ложь;
					КонецЕсли;
					
					ПовторИтога 	= ВсегоПоСтроке;
					ПовторИтога1 	= ВсегоПоСтроке1;
				Иначе
					Продолжить;
				КонецЕсли;
 			КонецЕсли;
			
			Если ЗначениеЗаполнено(НайденнаяСтрока) И ЗначениеЗаполнено(НайденнаяСтрока1) Тогда
				// Сравнение строк 
				ЕстьРазличия = СверитьДанныеСмет(НайденнаяСтрока,НайденнаяСтрока1,РеквизитыСравнения);
				Если ЕстьРазличия Тогда
					ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПустая");
				Иначе
					ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
				КонецЕсли;
			Иначе
				ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПустая");
			КонецЕсли;
		
			Если ЗначениеЗаполнено(НайденнаяСтрока) И ВыводитьСтроку Тогда
				ОбластьСтрока.Параметры.Заполнить(НайденнаяСтрока);		
				ОбластьСтрока.Параметры.НаименованиеСметы	= НайденнаяСтрока.Итог.Наименование;
				ОбластьСтрока.Параметры.ВсегоПоСтроке 		= ВсегоПоСтроке;
				Если НайденнаяСтрока.ЭтоСмета Тогда
					НомПП 								= НомПП + 1;
					ОбластьСтрока.Параметры.НомерСметы 	= НайденнаяСтрока.Итог.НомерСметы;	 
					ОбластьСтрока.Параметры.НомерПП		= НомПП;
				ИначеЕсли ТипЗнч(НайденнаяСтрока.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") Тогда
					Если ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
						ОбластьСтрока.Параметры.НаименованиеСметы = НайденнаяСтрока.Итог.НаименованиеРемонт;	
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НайденнаяСтрока1) И ВыводитьСтроку1 Тогда
				ОбластьСтрока.Параметры.Заполнить(НайденнаяСтрока1);		                                                                                        
				ОбластьСтрока.Параметры.НаименованиеСметы1 	= НайденнаяСтрока1.Итог1.Наименование;
				ОбластьСтрока.Параметры.ВсегоПоСтроке1 	 	= ВсегоПоСтроке1;
				Если НайденнаяСтрока1.ЭтоСмета1 Тогда
					НомПП1 									= НомПП1 + 1;
					ОбластьСтрока.Параметры.НомерСметы1 	= НайденнаяСтрока1.Итог1.НомерСметы;	  
					ОбластьСтрока.Параметры.НомерПП1		= НомПП1;
				ИначеЕсли ТипЗнч(НайденнаяСтрока1.Итог1) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") Тогда
					Если ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт Тогда
						ОбластьСтрока.Параметры.НаименованиеСметы1 = НайденнаяСтрока1.Итог1.НаименованиеРемонт;	
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ВыводитьСтроку ИЛИ ВыводитьСтроку1 Тогда
				ШаблонСДанными.Вывести(ОбластьСтрока,2);
			КонецЕсли;
			
		КонецЦикла;	
		
		ПовторГлавы = СтрокаГлавы.Всего;
		
	КонецЦикла;
	
	ШаблонСДанными.ЗакончитьАвтогруппировкуСтрок();
	
КонецПроцедуры

&НаСервере
Функция СобратьДанныеПоСмете(Ссылка)
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		ТекРегистр = "СМ_ИтогиПоГлавамОС";
	Иначе
		ТекРегистр = "СМ_ИтогиПоГлавамСС";
	КонецЕсли;	
	
	Если Ссылка.БазисныеЦены Тогда
		
		Запрос 			= Новый Запрос;
		Запрос.Текст 	= "
		|ВЫБРАТЬ
		|	ИтогиПоГлавам.Смета КАК ОбъектнаяСмета,
		|	ИтогиПоГлавам.Итог КАК Итог,
		|	ИтогиПоГлавам.Глава КАК Глава,
		|	СУММА(ЕСТЬNULL(
		|		ВЫБОР КОГДА ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы) ИЛИ
		|			        ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.МеталломонтажныеРаботы) ИЛИ 
		|		 			ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.БуровзрывныеРаботы) ИЛИ 
		|		  			ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.СантехническиеРаботы) ИЛИ 
		|		  			ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ГорнопроходческиеРаботы) ТОГДА
		|					ИтогиПоГлавам.ПрямЗатраты / 1000 ИНАЧЕ 0 КОНЕЦ,0)) КАК СтроительныеРаботы, 	  
		|	СУММА(ЕСТЬNULL(
		|		ВЫБОР КОГДА ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.МонтажныеРаботы) ТОГДА 
		|		ИтогиПоГлавам.ПрямЗатраты / 1000 ИНАЧЕ 0 КОНЕЦ,0)) КАК МонтажныеРаботы, 	  
		|	СУММА(ЕСТЬNULL(
		|		ВЫБОР КОГДА ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.Оборудование) ТОГДА 
		|		ИтогиПоГлавам.Оборуд / 1000 ИНАЧЕ 0 КОНЕЦ,0)) КАК Оборудование,  
		|	СУММА(ЕСТЬNULL(
		|		ВЫБОР КОГДА ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ПрочиеРаботы) ТОГДА 
		|		ИтогиПоГлавам.ПрямЗатраты / 1000 ИНАЧЕ 0 КОНЕЦ,0)) КАК Прочие, 			
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ОснЗарплата / 1000,0) + ЕСТЬNULL(ИтогиПоГлавам.ЗарплМашин / 1000,0)) КАК ОплатаТруда,
		|		ЛОЖЬ КАК СтрокаОбработана
		|ИЗ
		|	РегистрСведений." + ТекРегистр + " КАК ИтогиПоГлавам
		|ГДЕ
		|	ИтогиПоГлавам.Смета = &Смета
		|СГРУППИРОВАТЬ ПО
		|	ИтогиПоГлавам.Смета,		
		|	ИтогиПоГлавам.Глава,
		|	ИтогиПоГлавам.Итог
		|УПОРЯДОЧИТЬ ПО
		|	ИтогиПоГлавам.Итог.ГлаваССРС.ПорядковыйНомер";	
	Иначе
		Запрос 			= Новый Запрос;
		Запрос.Текст 	= "
		|ВЫБРАТЬ
		|	ИтогиПоГлавам.Смета КАК ОбъектнаяСмета,
		|	ИтогиПоГлавам.Итог КАК Итог,
		|	ИтогиПоГлавам.Глава КАК Глава,
		|	СУММА(ЕСТЬNULL(
		|		ВЫБОР КОГДА ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы) ИЛИ
		|			        ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.МеталломонтажныеРаботы) ИЛИ 
		|		 			ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.БуровзрывныеРаботы) ИЛИ 
		|		  			ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.СантехническиеРаботы) ИЛИ 
		|		  			ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ГорнопроходческиеРаботы) ТОГДА
		|					ИтогиПоГлавам.ТекПрямЗатраты / 1000 ИНАЧЕ 0 КОНЕЦ,0)) КАК СтроительныеРаботы, 	  
		|	СУММА(ЕСТЬNULL(
		|		ВЫБОР КОГДА ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.МонтажныеРаботы) ТОГДА 
		|		ИтогиПоГлавам.ТекПрямЗатраты / 1000 ИНАЧЕ 0 КОНЕЦ,0)) КАК МонтажныеРаботы, 	  
		|	СУММА(ЕСТЬNULL(
		|		ВЫБОР КОГДА ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.Оборудование) ТОГДА 
		|		ИтогиПоГлавам.ТекОборуд / 1000 ИНАЧЕ 0 КОНЕЦ,0)) КАК Оборудование,  
		|	СУММА(ЕСТЬNULL(
		|		ВЫБОР КОГДА ИтогиПоГлавам.ВидРабот = Значение(Перечисление.СМ_ВидыЗатратСмета.ПрочиеРаботы) ТОГДА 
		|		ИтогиПоГлавам.ТекПрямЗатраты / 1000 ИНАЧЕ 0 КОНЕЦ,0)) КАК Прочие, 			
		|	СУММА(ЕСТЬNULL(ИтогиПоГлавам.ТекОснЗарплата / 1000,0) + ЕСТЬNULL(ИтогиПоГлавам.ТекЗарплМашин / 1000,0)) КАК ОплатаТруда, 	
		|		ЛОЖЬ КАК СтрокаОбработана
		|ИЗ
		|	РегистрСведений." + ТекРегистр + " КАК ИтогиПоГлавам
		|ГДЕ
		|	ИтогиПоГлавам.Смета = &Смета
		|СГРУППИРОВАТЬ ПО
		|	ИтогиПоГлавам.Смета,		
		|	ИтогиПоГлавам.Глава,
		|	ИтогиПоГлавам.Итог
		|УПОРЯДОЧИТЬ ПО
		|	ИтогиПоГлавам.Итог.ГлаваССРС.ПорядковыйНомер";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Смета",Ссылка);
	ТабРезультат = Запрос.Выполнить().Выгрузить();

	ТабРезультат.Колонки.Добавить("СортировкаИтогов",Новый ОписаниеТипов("Число"));
	ТабРезультат.Колонки.Добавить("ЭтоСмета", Новый ОписаниеТипов("Булево"));
	ТабРезультат.Колонки.Добавить("Порядковыйномер");
	ТабРезультат.Колонки.Добавить("НомерИтогаКЧему");
	
	Для Каждого СтрокаИтога Из ТабРезультат Цикл
		Если ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ЛимитированныеЗатраты") Тогда
			СтрокаИтога.СортировкаИтогов 	= СтрокаИтога.Глава.ПорядковыйНомер * 10000 + 2000 + СтрокаИтога.Итог.НомерПоПорядку;
			СтрокаИтога.НомерИтогаКЧему		= СтрокаИтога.Итог.КИтогу.ПорядковыйНомер;
			СтрокаИтога.Порядковыйномер		= СтрокаИтога.Итог.КИтогу.ПорядковыйНомер;
		ИначеЕсли ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") ИЛИ ТипЗнч(СтрокаИтога.Итог) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
			СтрокаИтога.СортировкаИтогов 	= СтрокаИтога.Глава.ПорядковыйНомер * 10000 + 1000 + СМ_СметаПечатьОбъектнаяСводнаяВызовСервера.НайтиНомерПоПорядкуСметы(Ссылка,СтрокаИтога.Итог);
			СтрокаИтога.ЭтоСмета			= Истина;
		ИначеЕсли ТипЗнч(СтрокаИтога.Итог) = Тип("СправочникСсылка.СМ_ИтогиПоГлавам") Тогда
			СтрокаИтога.СортировкаИтогов 	= СтрокаИтога.Глава.ПорядковыйНомер * 10000 + 3000 + СтрокаИтога.Итог.ПорядковыйНомер;
			СтрокаИтога.Порядковыйномер		= СтрокаИтога.Итог.ПорядковыйНомер;
		КонецЕсли;	
	КонецЦикла;	
	
	ТабРезультат.Сортировать("СортировкаИтогов");
	
	//СтрокаЛС.Параметры.НомерПП = НайтиНомерПоПорядкуСметы(Ссылка,СтрокаИтога.Итог);
	//СтрокаЛС.Параметры.НомерСметыДляПечати =  СтрокаИтога.Итог.НомерСметы;
	//ИтогПоГлаве = НайтиИтогПоГлаве(ПовторГлаваНеНакопительногоИтога,Ссылка.ТипСтроительства);

	Возврат ТабРезультат;
	
КонецФункции

