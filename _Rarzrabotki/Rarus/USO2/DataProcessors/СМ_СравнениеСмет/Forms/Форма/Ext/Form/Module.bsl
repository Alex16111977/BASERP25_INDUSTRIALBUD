
#Область ОписаниеПеременных

&НаКлиенте
Перем ФормаДлительнойОперации;

&НаКлиенте
Перем ПараметрыОбработчика;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(ЭтотОбъект.ИмяФормы,"ВнешняяОбработка") = 0 Тогда
		Объект.Фоном = Истина;
	КонецЕсли;
	
	НовСтрока 					= ПоляПозиции.Добавить();
	НовСтрока.Поле 				= "Шифр позиции";
	НовСтрока.ИмяРеквизита 		= "ОбоснСметнойСтоим1";
	НовСтрока.ИмяРеквизитаДоп 	= "ОбоснСметнойСтоим";
	
	НовСтрока 					= ПоляПозиции.Добавить();
	НовСтрока.Поле 				= Метаданные.Документы.СМ_ПозицияЛокальнойСметы.Реквизиты.ТипНормативныхСборников.Синоним;
	НовСтрока.ИмяРеквизита 		= "ТНС1";
	НовСтрока.ИмяРеквизитаДоп 	= "ТНС";
	
	НовСтрока 					= ПоляПозиции.Добавить();
	НовСтрока.Поле 				= "Наименование";
	НовСтрока.ИмяРеквизита 		= "Наименование1";
	НовСтрока.ИмяРеквизитаДоп 	= "Наименование";
	
	НовСтрока 					= ПоляПозиции.Добавить();
	НовСтрока.Поле 				= "№ п/п";
	НовСтрока.ИмяРеквизита 		= "НомерПП1";
	НовСтрока.ИмяРеквизитаДоп 	= "НомерПП";
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		Объект.Акт = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СравнениеПоАктуПриИзменении(Элемент)
	
	Если СравнениеПоАкту Тогда
		Элементы.Смета2.Видимость 	= Ложь;
		Элементы.Акт.Видимость		= Истина;
		ЗаполнитьАктПоСмете();
	Иначе
		Элементы.Смета2.Видимость 	= Истина;
		Элементы.Акт.Видимость		= Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Смета1ПриИзменении(Элемент)
	
	Если СравнениеПоАкту Тогда
		ЗаполнитьАктПоСмете();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АктНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Смета1) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выберите смету!'"));
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЛокальнаяСмета",Объект.Смета1);
	ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.ФормаВыбора",СтруктураПараметров,ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура АктНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.Смета1) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выберите смету!'"));
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ЛокальнаяСмета",Объект.Смета1);
	ОткрытьФорму("Документ.СМ_АктВыполненныхРабот.ФормаВыбора",СтруктураПараметров,ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сравнить(Команда)
	
	Успешно = Ложь;
	Для Каждого стр Из ПоляПозиции Цикл
		Если стр.Поиск Тогда
			Успешно = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не Успешно Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбраны поля поиска расценок.'"));
		Возврат;
	КонецЕсли;
	
	Если СравнениеПоАкту Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Смета1) ИЛИ НЕ ЗначениеЗаполнено(Объект.Акт) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбрана смета / акт для сравнения.'"));
			Возврат;
		КонецЕсли;
	Иначе	
		Если НЕ ЗначениеЗаполнено(Объект.Смета1) ИЛИ НЕ ЗначениеЗаполнено(Объект.Смета2) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не выбраны сметы для сравнения.'"));
			Возврат;
		КонецЕсли;
		
		Если ТипЗнч(Объект.Смета1) <> ТипЗнч(Объект.Смета2) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для сравнения доступны только одинаковые виды смет.'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ФоновоеЗадание = Ложь;
	СравнитьНаСервере(ФоновоеЗадание);
	Если ФоновоеЗадание Тогда
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеНаКлиенте", 1, Истина);
		ПараметрыОбработчика.МаксимальныйИнтервал = 5;
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, ФоновоеЗаданиеИдентификатор);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОчисткаШаблонСДанными()
	ШаблонСДанными.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗаданиеНаКлиенте()
	Результат = ФоновоеЗаданиеЗагрузкаФайлаПолучитьРезультат();
	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = ФоновоеЗаданиеИдентификатор Тогда
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		СтруктураХранилище = ПолучитьИзВременногоХранилища(ФоновоеЗаданиеАдресХранилища);
		ШаблонСДанными = СтруктураХранилище.ШаблонСДанными;
	Иначе
		ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ФоновоеЗаданиеЗагрузкаФайлаПолучитьРезультат()
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(ФоновоеЗаданиеИдентификатор);
	Возврат Результат;
КонецФункции

&НаСервере
Процедура СравнитьНаСервере(ФоновоеЗадание = Ложь)
	
	ОчисткаШаблонСДанными();

	ПараметрыВызоваСервера = Новый Структура();
	ПараметрыВызоваСервера.Вставить("ПоляПозиции", ПоляПозиции.Выгрузить());
	ПараметрыВызоваСервера.Вставить("ШаблонСДанными", ШаблонСДанными);
	ПараметрыВызоваСервера.Вставить("СравнениеПоАкту",СравнениеПоАкту);
	
	Если СравнениеПоАкту Тогда
		ПараметрыВызоваСервера.Вставить("СметыСравнения", Новый Структура("Смета1,Смета2",Объект.Смета1,Объект.Акт));	
	Иначе
		ПараметрыВызоваСервера.Вставить("СметыСравнения", Новый Структура("Смета1,Смета2",Объект.Смета1,Объект.Смета2));
		Если Объект.Смета1.ТипСтроительства <> Объект.Смета2.ТипСтроительства Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для сравнения не доступны сметы с разным типом строительства.'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Не Объект.Фоном Тогда
		СравнитьСметы(ПараметрыВызоваСервера);  
	Иначе
		// Сравнение в фоновом режиме
		РезультатФоновогоЗадания = ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
		"Обработки.СМ_СравнениеСмет.СравнитьСметы",ПараметрыВызоваСервера, НСтр("ru = 'Обработка Сравнение смет: Выполнение серверного метода сравнения смет'"));
		
		Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
			ФоновоеЗаданиеАдресХранилища 	= РезультатФоновогоЗадания.АдресХранилища;
			СтруктураХранилище 				= ПолучитьИзВременногоХранилища(ФоновоеЗаданиеАдресХранилища);
			ШаблонСДанными 					= СтруктураХранилище.ШаблонСДанными;
		Иначе
			ФоновоеЗадание 					= Истина;
			ФоновоеЗаданиеИдентификатор  	= РезультатФоновогоЗадания.ИдентификаторЗадания;
			ФоновоеЗаданиеАдресХранилища 	= РезультатФоновогоЗадания.АдресХранилища;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СравнитьСметы(ПараметрыВызоваСервера)
	
	// Сравнение сметы с актом
	Если ПараметрыВызоваСервера.СравнениеПоАкту Тогда
		
		ДеревоСмета1 = СоздатьДерево();
		СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(ПараметрыВызоваСервера.СметыСравнения.Смета1, ДеревоСмета1);
		ПроставитьУровень(ДеревоСмета1.Строки,0);
		
		ДеревоСмета2		= СоздатьДеревоАкта();
		РеквизитыСравнения 	= ПолучитьСписокДляСравненияАкт();
		ТекАкт 				= ПараметрыВызоваСервера.СметыСравнения.Смета2;
		ТекСмета 			= ТекАкт.ЛокальнаяСмета;
		СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(ТекСмета,ДеревоСмета2,ТекАкт,Истина);
		ПроставитьУровень(ДеревоСмета2.Строки,0);
		ПереименуемКолонкиДерева(ДеревоСмета2);
		ТабСтоимости = ПолучитьЕдиничнуюСтоимостьПозиций(ТекСмета,ТекАкт);
		ПересчетДереваПоАктуДанныеРегистра(ДеревоСмета1,ТабСтоимости);
		
	Иначе
			
		// Сравнение объектных смет
		Если ТипЗнч(ПараметрыВызоваСервера.СметыСравнения.Смета2) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		
			ДеревоСмета1 = СобратьДанныеПоСмете(ПараметрыВызоваСервера.СметыСравнения.Смета1);
			ДеревоСмета2 = СобратьДанныеПоСмете(ПараметрыВызоваСервера.СметыСравнения.Смета2);
			
			ОбъектОбработки 	= РеквизитФормыВЗначение("Объект");
			Макет 				= ОбъектОбработки.ПолучитьМакет("МакетСравнениеОС");
			ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
			ОбластьШапка 		= Макет.ПолучитьОбласть("Шапка");

			ШаблонСДанными.Вывести(ОбластьЗаголовок);
			ШаблонСДанными.Вывести(ОбластьШапка);	
			
			ОбщаяТаблицаДанных 	= ПолучитьОбщуюТаблицуДанныхОС(ДеревоСмета1,ДеревоСмета2);
			РеквизитыСравнения 	= ПолучитьСписокРеквизитовСравнения();
			ТипСтроительства	= ПараметрыВызоваСервера.СметыСравнения.Смета1.ТипСтроительства;

			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ЭтоСмета",Истина);
			
			ТаблицаДанных1 	= ДеревоСмета1.Скопировать(СтруктураОтбора); 
			ТаблицаДанных2 	= ДеревоСмета2.Скопировать(СтруктураОтбора);
		
			ПереименуемКолонкиДерева(ТаблицаДанных2);
			ПереименуемКолонкиДерева(ДеревоСмета2);

			ВывестиДанныеПоОС(РеквизитыСравнения,Макет,ДеревоСмета1,ДеревоСмета2,ОбщаяТаблицаДанных,ТипСтроительства);
			
		// Сравнение сводных смет
		ИначеЕсли ТипЗнч(ПараметрыВызоваСервера.СметыСравнения.Смета2) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
			
			ДеревоСмета1 = СобратьДанныеПоСмете(ПараметрыВызоваСервера.СметыСравнения.Смета1);
			ДеревоСмета2 = СобратьДанныеПоСмете(ПараметрыВызоваСервера.СметыСравнения.Смета2);
			
			ОбъектОбработки 	= РеквизитФормыВЗначение("Объект");
			Макет 				= ОбъектОбработки.ПолучитьМакет("МакетСравнениеСС");
			ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
			ОбластьШапка 		= Макет.ПолучитьОбласть("Шапка");
			
			ШаблонСДанными.Вывести(ОбластьЗаголовок);
			ШаблонСДанными.Вывести(ОбластьШапка);
			
			СтруктураДанных		= ПолучитьОбщуюТаблицуДанныхСС(ДеревоСмета1,ДеревоСмета2);
			РеквизитыСравнения 	= ПолучитьСписокРеквизитовСравнения();
		
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ЭтоСмета",Истина);
			
			ТаблицаДанных1 = ДеревоСмета1.Скопировать(СтруктураОтбора); 
			ТаблицаДанных2 = ДеревоСмета2.Скопировать(СтруктураОтбора);

			ПереименуемКолонкиДерева(ТаблицаДанных2);
			ПереименуемКолонкиДерева(ДеревоСмета2);
			
			ОбщаяТаблицаДанных	= СтруктураДанных.ТабИтогов;
			ТабГлавы			= СтруктураДанных.ТабГлавы;
			ТипСтроительства	= ПараметрыВызоваСервера.СметыСравнения.Смета1.ТипСтроительства;
			
			ВывестиДанныеПоСС(РеквизитыСравнения,Макет,ДеревоСмета1,ДеревоСмета2,ОбщаяТаблицаДанных,ТабГлавы,ТипСтроительства);
			
		// Сравнение локальных смет
		ИначеЕсли ТипЗнч(ПараметрыВызоваСервера.СметыСравнения.Смета2) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
			
			ДеревоСмета1 = СоздатьДерево();
			СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(ПараметрыВызоваСервера.СметыСравнения.Смета1, ДеревоСмета1);
			ПроставитьУровень(ДеревоСмета1.Строки,0);			
					
			ДеревоСмета2 		= ДеревоСмета1.Скопировать();
			РеквизитыСравнения 	= ПолучитьСписокДляСравнения();
			СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(ПараметрыВызоваСервера.СметыСравнения.Смета2, ДеревоСмета2);
			ПроставитьУровень(ДеревоСмета2.Строки,0);
			ПереименуемКолонкиДерева(ДеревоСмета2);
			
			ОбъектОбработки = РеквизитФормыВЗначение("Объект");
			Макет = ОбъектОбработки.ПолучитьМакет("Макет");
			
			ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
			ШаблонСДанными.Вывести(ОбластьЗаголовок);
			
			ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
			ШаблонСДанными.Вывести(ОбластьШапка);	
			
			ОбластьРаздел 	= Макет.ПолучитьОбласть("ОбластьРаздел");
			ОбластьПозиция 	= Макет.ПолучитьОбласть("ОбластьПозиция");
			
			Корень = ДеревоСмета1.Строки[0];
			ОбластьРаздел.Параметры.Заполнить(Корень);
			Корень.Обработано = Истина;
			
			Корень1 = ДеревоСмета2.Строки[0];
			ОбластьРаздел.Параметры.Заполнить(Корень1);
			Корень1.Обработано1 = Истина;        
			
			ТекстОтбора = СформироватьОтборРасценок(ПараметрыВызоваСервера.ПоляПозиции);
			
			ШаблонСДанными.НачатьАвтогруппировкуСтрок();
			ШаблонСДанными.Вывести(ОбластьРаздел,0);
			
			ВывестиУровень(РеквизитыСравнения,Макет,Корень.Строки,Корень1.Строки,Корень1,ТекстОтбора,1);
			
			МассивСтрок = Корень1.Строки.НайтиСтроки(Новый Структура("Обработано1",Ложь),Истина);
			ВывестиНеОбработанные(Макет,МассивСтрок,1);
			
			ШаблонСДанными.ЗакончитьАвтогруппировкуСтрок();
			
		КонецЕсли;
		
	КонецЕсли;
		
КонецПроцедуры

// Единичная стоимость берется из дерева сметного состава и умножается на объем позиций по акту.
// Итоги суммируются по разделам / смете.
&НаСервере
Процедура ПересчетДереваПоАктуДанныеСметногоСостава(ДеревоСметы,ДеревоАкта)
	
	// Пересчет дерева по позициям акта
	Для Каждого ТекСтрока Из ДеревоСметы.Строки Цикл
		Если ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			НайденнаяСтрока = ДеревоАкта.Строки.Найти(ТекСтрока.Элемент,"Элемент1",Истина);
			Если НайденнаяСтрока <> Неопределено Тогда
				// Здесь нужно рассчитать стоимость по акту
				ПроцентПоАкту 						= НайденнаяСтрока.ОбъемПоАктуПроцент1 / 100;
				ОбъемПоАкту							= НайденнаяСтрока.ОбъемПоАкту1;
				ТекСтрока.Кол						= ОбъемПоАкту;
				ТекСтрока.ОбщВсего 				  	= ТекСтрока.ЕдВсего * ОбъемПоАкту;
				ТекСтрока.ОбщОснЗП                	= ТекСтрока.ЕдОснЗП * ОбъемПоАкту;
				ТекСтрока.ОбщЭксплМашин           	= ТекСтрока.ЕдЭксплМашин * ОбъемПоАкту;
				ТекСтрока.ОбщЭМЗарПлата           	= ТекСтрока.ЕдЭМЗарПлата * ОбъемПоАкту;
				ТекСтрока.ОбщСтоимостьМатериалов	= ТекСтрока.ЕдСтоимостьМатериалов * ОбъемПоАкту;
				ТекСтрока.ОбщЗатрТрРаб            	= ТекСтрока.ЕдЗатрТрРаб * ОбъемПоАкту;
				ТекСтрока.ОбщЗатрТрМех            	= ТекСтрока.ЕдЗатрТрМех * ОбъемПоАкту;
				ПересчитатьИтогиВладельца(ТекСтрока.Родитель,ТекСтрока);
			Иначе
				// можно удалить эту строку
				// пока просто пропускаем
			КонецЕсли;
		Иначе
			// Обнуление итогов владельца
			ТекСтрока.ОбщВсего 					= 0;
			ТекСтрока.ОбщОснЗП                	= 0;
			ТекСтрока.ОбщЭксплМашин           	= 0;
			ТекСтрока.ОбщЭМЗарПлата           	= 0;
			ТекСтрока.ОбщСтоимостьМатериалов  	= 0;
			ТекСтрока.ОбщЗатрТрРаб            	= 0;
			ТекСтрока.ОбщЗатрТрМех            	= 0;
		КонецЕсли;
		
		Если ТекСтрока.Строки.Количество() > 0 Тогда
			ПересчетДереваПоАктуДанныеСметногоСостава(ТекСтрока,ДеревоАкта);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Единичная стоимость берется по регистру "СМ_БазисноИндекснаяСтоимостьПозицииСКоэффициентамиПересчета".
// Единичные стоимости по позициям сразу соединяется с объемом по акту.
// Итоги перасчитываются суммированием по разделам / смете.
&НаСервере
Процедура ПересчетДереваПоАктуДанныеРегистра(ДеревоСметы,ТабСтоимости)
	
	// Пересчет дерева по позициям акта
	Для Каждого ТекСтрока Из ДеревоСметы.Строки Цикл
		Если ТипЗнч(ТекСтрока.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
			НайденнаяСтрока = ТабСтоимости.Найти(ТекСтрока.Элемент,"Позиция");
			Если НайденнаяСтрока <> Неопределено Тогда
				// Здесь нужно рассчитать стоимость по акту
				ОбъемПоАкту							= НайденнаяСтрока.ФактОбъем;
				ТекСтрока.Кол						= ОбъемПоАкту;
				ТекСтрока.ОбщВсего 				  	= НайденнаяСтрока.СтоимПрямЗатраты * ОбъемПоАкту;
				ТекСтрока.ОбщОснЗП                	= НайденнаяСтрока.СтоимОснЗарплата * ОбъемПоАкту;
				ТекСтрока.ОбщЭксплМашин           	= НайденнаяСтрока.СтоимЭксплМашин * ОбъемПоАкту;
				ТекСтрока.ОбщЭМЗарПлата           	= НайденнаяСтрока.СтоимЗарплМашин * ОбъемПоАкту;
				ТекСтрока.ОбщСтоимостьМатериалов	= НайденнаяСтрока.СтоимСтоимМатер * ОбъемПоАкту;
				ТекСтрока.ОбщЗатрТрРаб            	= НайденнаяСтрока.ЗатратыТрудаРабочих * ОбъемПоАкту;
				ТекСтрока.ОбщЗатрТрМех            	= НайденнаяСтрока.ЗатратыТрудаМашин * ОбъемПоАкту;
				ПересчитатьИтогиВладельца(ТекСтрока.Родитель,ТекСтрока);
			Иначе
				// можно удалить эту строку
				// пока просто пропускаем
			КонецЕсли;
		Иначе
			// Обнуление итогов владельца
			ТекСтрока.ОбщВсего 					= 0;
			ТекСтрока.ОбщОснЗП                	= 0;
			ТекСтрока.ОбщЭксплМашин           	= 0;
			ТекСтрока.ОбщЭМЗарПлата           	= 0;
			ТекСтрока.ОбщСтоимостьМатериалов  	= 0;
			ТекСтрока.ОбщЗатрТрРаб            	= 0;
			ТекСтрока.ОбщЗатрТрМех            	= 0;
		КонецЕсли;
		
		Если ТекСтрока.Строки.Количество() > 0 Тогда
			ПересчетДереваПоАктуДанныеРегистра(ТекСтрока,ТабСтоимости);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьИтогиВладельца(ТекРодитель,ТекСтрока)
	
	ТекРодитель.ОбщВсего 				= ТекРодитель.ОбщВсего + ТекСтрока.ОбщВсего;
	ТекРодитель.ОбщОснЗП                = ТекРодитель.ОбщОснЗП + ТекСтрока.ОбщОснЗП;
	ТекРодитель.ОбщЭксплМашин           = ТекРодитель.ОбщЭксплМашин + ТекСтрока.ОбщЭксплМашин;
	ТекРодитель.ОбщЭМЗарПлата           = ТекРодитель.ОбщЭМЗарПлата + ТекСтрока.ОбщЭМЗарПлата;
	ТекРодитель.ОбщСтоимостьМатериалов  = ТекРодитель.ОбщСтоимостьМатериалов + ТекСтрока.ОбщСтоимостьМатериалов;
	ТекРодитель.ОбщЗатрТрРаб            = ТекРодитель.ОбщЗатрТрРаб + ТекСтрока.ОбщЗатрТрРаб;
	ТекРодитель.ОбщЗатрТрМех            = ТекРодитель.ОбщЗатрТрМех + ТекСтрока.ОбщЗатрТрМех;
	
	Если ТекРодитель.Родитель <> Неопределено Тогда
		ПересчитатьИтогиВладельца(ТекРодитель.Родитель,ТекСтрока);
	КонецЕсли;
	
КонецПроцедуры

