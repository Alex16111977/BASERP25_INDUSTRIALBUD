	Возврат Соответствие;
	
КонецФункции

Процедура ПроставитьУровень(СтрокиДерева,Уровень,ПоАкту)
	
	Для Каждого стр Из СтрокиДерева Цикл
		Если ПоАкту Тогда
			Если ТипЗнч(Стр.Элемент) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				Стр.Кол	= Стр.ОбъемПоАкту;
			КонецЕсли;
		КонецЕсли;
		
		Если стр.ТипСтроки <= 1 Тогда
			стр.Уровень = Уровень;
			ПроставитьУровень(стр.Строки,Уровень+1,ПоАкту);
		Иначе
			стр.ТНС = стр.Элемент.ТипНормативныхСборников;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПереименуемКолонкиДерева(Дерево)
	
	Для Каждого кол Из Дерево.Колонки Цикл
		кол.Имя = кол.Имя+"1";
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьОтборРасценок(ПоляПоиска)
	
	ТекстОтбора = "ОрборРасценок = Новый Структура(""";
	
	Для Каждого стр из ПоляПоиска Цикл
		Если Не стр.Поиск Тогда
			Продолжить;
		КонецЕсли;
		ТекстОтбора = ТекстОтбора+стр.ИмяРеквизита+",";
	КонецЦикла;
	ТекстОтбора = Лев(ТекстОтбора,СтрДлина(ТекстОтбора)-1)+""",";
	
	Для Каждого стр из ПоляПоиска Цикл
		Если Не стр.Поиск Тогда
			Продолжить;
		КонецЕсли;
		ТекстОтбора = ТекстОтбора+"стр."+стр.ИмяРеквизитаДоп+",";
	КонецЦикла;
	ТекстОтбора = Лев(ТекстОтбора,СтрДлина(ТекстОтбора)-1)+")";
	
	Возврат ТекстОтбора;
	
КонецФункции

Процедура ВывестиУровень(ШаблонСДанными,РеквизитыСравнения,ОбластиРаскраски,Макет,СтрокиДерева,СтрокиДерева2,ПолноеДерево,ТекстОтбора,Уровень,Пусто = Ложь,ТолькоОтклонения = Ложь)
	
	Для Каждого стр Из СтрокиДерева Цикл
		
		Если Стр.Обработано Тогда
			Продолжить;
		КонецЕсли;
		
		Если стр.ТипСтроки <= 1 Тогда // разделы.
			
			СтрокаСравнения = Неопределено;
			Если СтрокиДерева2 = Неопределено Тогда
				МассивСтрок = ПолноеДерево.Строки.НайтиСтроки(Новый Структура("Наименование1,Уровень1,Обработано1",стр.Наименование,стр.Уровень,Ложь),Истина)
			Иначе
				МассивСтрок = СтрокиДерева2.НайтиСтроки(Новый Структура("Наименование1,Уровень1,Обработано1",стр.Наименование,стр.Уровень,Ложь),Истина)
			КонецЕсли;
			
			Если МассивСтрок.Количество()>0 Тогда
				СтрокаСравнения = МассивСтрок[0];
			КонецЕсли;
			
			Если Не СтрокаСравнения = Неопределено Тогда
				СтрокаСравнения.Обработано1 = Истина;
				ОбластьРаздел = Макет.ПолучитьОбласть("ОбластьРаздел");
				ОбластьРаздел.Параметры.Заполнить(стр);
				ОбластьРаздел.Параметры.Заполнить(СтрокаСравнения);
				ШаблонСДанными.Вывести(ОбластьРаздел,Уровень);
				ВывестиУровень(ШаблонСДанными,РеквизитыСравнения,ОбластиРаскраски,Макет,стр.Строки,СтрокаСравнения.Строки,ПолноеДерево,ТекстОтбора,Уровень+1,,ТолькоОтклонения);
				
				МассивСтрок = СтрокаСравнения.Строки.НайтиСтроки(Новый Структура("Обработано1",Ложь),Ложь);
				ВывестиНеОбработанные(ШаблонСДанными,Макет,МассивСтрок,Уровень+1,Ложь);
				
				МассивСтрок = ПолноеДерево.Строки.НайтиСтроки(Новый Структура("Уровень1,Обработано1",стр.Уровень+1,Ложь),Ложь);
				ВывестиНеОбработанные(ШаблонСДанными,Макет,МассивСтрок,Уровень,Ложь);
			Иначе
				ОбластьРаздел = Макет.ПолучитьОбласть("ОбластьРазделПусто");
				ОбластьРаздел.Параметры.Заполнить(стр);
				ШаблонСДанными.Вывести(ОбластьРаздел,Уровень);
				ВывестиУровень(ШаблонСДанными,РеквизитыСравнения,ОбластиРаскраски,Макет,стр.Строки,Неопределено,ПолноеДерево,ТекстОтбора,Уровень+1,Истина,ТолькоОтклонения);
			КонецЕсли;
			
		Иначе // позиции.
			
			Если Пусто Тогда // позиции не найденного раздела.
				
				Если стр.ТипСтроки = 2 Тогда
					ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПусто");
					ОбластьПозиция.Параметры.Заполнить(стр);
					ШаблонСДанными.Вывести(ОбластьПозиция,Уровень);
				Иначе
					ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПодчиненПусто");
					ОбластьПозиция.Параметры.Заполнить(стр);
					ШаблонСДанными.Вывести(ОбластьПозиция,Уровень+1);
				КонецЕсли;
				
			Иначе 
				
				ОрборРасценок = "";
				Выполнить(ТекстОтбора);
				ОрборРасценок.Вставить("ТипСтроки1",стр.ТипСтроки);
				ОрборРасценок.Вставить("Обработано1",Ложь);
				МассивСтрок = СтрокиДерева2.НайтиСтроки(ОрборРасценок,Ложь);

				СтрокаСравнения = Неопределено;
				Если МассивСтрок.Количество()>0 Тогда
					СтрокаСравнения = МассивСтрок[0];
					СтрокаСравнения.Обработано1 = Истина;
				КонецЕсли;

				Если СтрокаСравнения = Неопределено Тогда // не нашли позицию.
					
					Если стр.ТипСтроки = 2 Тогда
						ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПусто");
						ОбластьПозиция.Параметры.Заполнить(стр);
						ШаблонСДанными.Вывести(ОбластьПозиция,Уровень);
					Иначе
						ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПодчиненПусто");
						ОбластьПозиция.Параметры.Заполнить(стр);
						ШаблонСДанными.Вывести(ОбластьПозиция,Уровень+1);
					КонецЕсли;

				Иначе
					
					// обработаем разделенные
					ОрборРасценок = "";
					ТекстОтбораДоп = СтрЗаменить(ТекстОтбора,"1","");
					Выполнить(ТекстОтбораДоп);
					ОрборРасценок.Вставить("ТипСтроки",стр.ТипСтроки);
					ОрборРасценок.Вставить("Наименование",стр.Наименование);
					ОрборРасценок.Вставить("Измеритель",стр.Измеритель); 
					ОрборРасценок.Вставить("Обработано",Ложь);
					МассивСтрокДоп = стр.Родитель.Строки.НайтиСтроки(ОрборРасценок,Ложь);
					ТекСтрока = МассивСтрокДоп.Найти(стр);
					МассивСтрокДоп.Удалить(ТекСтрока);
					
					Для Каждого СтрДоп Из МассивСтрокДоп Цикл
						 стр.Кол 					= стр.Кол + СтрДоп.Кол;
						 стр.ОбщВсего 				= стр.ОбщВсего + СтрДоп.ОбщВсего;
						 стр.ОбщЗатрТрМех 			= стр.ОбщЗатрТрМех + СтрДоп.ОбщЗатрТрМех;
						 стр.ОбщЗатрТрРаб 			= стр.ОбщЗатрТрРаб + СтрДоп.ОбщЗатрТрРаб;
						 стр.ОбщОснЗП	 			= стр.ОбщОснЗП + СтрДоп.ОбщОснЗП;
						 стр.ОбщСтоимостьМатериалов = стр.ОбщСтоимостьМатериалов + СтрДоп.ОбщСтоимостьМатериалов;
						 стр.ОбщЭМЗарПлата 			= стр.ОбщЭМЗарПлата + СтрДоп.ОбщЭМЗарПлата;
						 стр.ОбщЭксплМашин 			= стр.ОбщЭксплМашин + СтрДоп.ОбщЭксплМашин;
						 стр.ОбъемВсего 			= стр.ОбъемВсего + СтрДоп.ОбъемВсего;
						 СтрДоп.Обработано 			= Истина;
					КонецЦикла;
					
					// обработаем разделенные
					ТекСтрока = МассивСтрок.Найти(СтрокаСравнения);
					МассивСтрок.Удалить(ТекСтрока);
					Для Каждого СтрДоп Из МассивСтрок Цикл
						СтрокаСравнения.Кол1 					= СтрокаСравнения.Кол1 + СтрДоп.Кол1;
						СтрокаСравнения.ОбщВсего1 				= СтрокаСравнения.ОбщВсего1 + СтрДоп.ОбщВсего1;
						СтрокаСравнения.ОбщЗатрТрМех1 			= СтрокаСравнения.ОбщЗатрТрМех1 + СтрДоп.ОбщЗатрТрМех1;
						СтрокаСравнения.ОбщЗатрТрРаб1 			= СтрокаСравнения.ОбщЗатрТрРаб1 + СтрДоп.ОбщЗатрТрРаб1;
						СтрокаСравнения.ОбщОснЗП1 				= СтрокаСравнения.ОбщОснЗП1 + СтрДоп.ОбщОснЗП1;
						СтрокаСравнения.ОбщСтоимостьМатериалов1 = СтрокаСравнения.ОбщСтоимостьМатериалов1 + СтрДоп.ОбщСтоимостьМатериалов1;
						СтрокаСравнения.ОбщЭМЗарПлата1 			= СтрокаСравнения.ОбщЭМЗарПлата1 + СтрДоп.ОбщЭМЗарПлата1;
						СтрокаСравнения.ОбщЭксплМашин1 			= СтрокаСравнения.ОбщЭксплМашин1 + СтрДоп.ОбщЭксплМашин1;
						СтрокаСравнения.ОбъемВсего1 			= СтрокаСравнения.ОбъемВсего1 + СтрДоп.ОбъемВсего1;
						СтрДоп.Обработано1 						= Истина;
					КонецЦикла;

					СписокРазличий = СверитьДанныеПозиций(стр,СтрокаСравнения,РеквизитыСравнения);
					ЕстьРазличия = СписокРазличий.Количество() > 0;
					
					Если ТолькоОтклонения И Не ЕстьРазличия Тогда
						Продолжить;
					КонецЕсли;
					
					Если стр.ТипСтроки = 2 Тогда
						ОбластьПозиция = ?(ЕстьРазличия,Макет.ПолучитьОбласть("ОбластьРазличия"),Макет.ПолучитьОбласть("ОбластьПозиция"));
						
						Если ЕстьРазличия Тогда
							ЦветЯчейки = Новый Цвет(255, 235, 205); 
							Для Каждого эл Из СписокРазличий Цикл
								Ячейки	 			= ОбластиРаскраски[эл.Значение];
								Ячейка 				= ОбластьПозиция.Область(Ячейки.Ячейка);
								Ячейка1 			= ОбластьПозиция.Область(Ячейки.Ячейка1);
								Ячейка.ЦветФона 	= ЦветЯчейки;
								Ячейка1.ЦветФона 	= ЦветЯчейки;
							КонецЦикла;
						КонецЕсли;

						ОбластьПозиция.Параметры.Заполнить(стр);
						ОбластьПозиция.Параметры.Заполнить(СтрокаСравнения);
						ШаблонСДанными.Вывести(ОбластьПозиция,Уровень);
					Иначе
						ОбластьПозиция = ?(ЕстьРазличия,Макет.ПолучитьОбласть("ОбластьПодчиненРазличия"),Макет.ПолучитьОбласть("ОбластьПодчинен"));
						Если ЕстьРазличия Тогда
							ЦветЯчейки = Новый Цвет(255, 235, 205); 
							Для Каждого эл Из СписокРазличий Цикл
								Ячейки = ОбластиРаскраски[эл.Значение];
								Ячейка = ОбластьПозиция.Область(Ячейки.Ячейка);
								Ячейка1 = ОбластьПозиция.Область(Ячейки.Ячейка1);
								Ячейка.ЦветФона = ЦветЯчейки;
								Ячейка1.ЦветФона = ЦветЯчейки;
							КонецЦикла;
						КонецЕсли;
						ОбластьПозиция.Параметры.Заполнить(стр);
						ОбластьПозиция.Параметры.Заполнить(СтрокаСравнения);
						ШаблонСДанными.Вывести(ОбластьПозиция,Уровень+1);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиНеОбработанные(ШаблонСДанными,Макет,МассивСтрок,Уровень,ИскатьПодчиненные = Истина)
	
	Для Каждого стр Из МассивСтрок Цикл
		
		Если стр.Обработано1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если стр.ТипСтроки1 <= 1 Тогда // разделы.
			стр.Обработано1 = Истина;
			ОбластьРаздел = Макет.ПолучитьОбласть("ОбластьРазделПусто");
			ОбластьРаздел.Параметры.Заполнить(стр);
			ШаблонСДанными.Вывести(ОбластьРаздел,Уровень);
			
			МассивСтрокНовый = стр.Строки.НайтиСтроки(Новый Структура("Обработано1",Ложь),ИскатьПодчиненные);
			ВывестиНеОбработанные(ШаблонСДанными,Макет,МассивСтрокНовый,Уровень+1);
			
		Иначе // позиции.
			стр.Обработано1 = Истина;
			Если стр.ТипСтроки1 = 2 Тогда
				ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПусто");
				ОбластьПозиция.Параметры.Заполнить(стр);
				ШаблонСДанными.Вывести(ОбластьПозиция,Уровень);
			Иначе
				ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПодчиненПусто");
				ОбластьПозиция.Параметры.Заполнить(стр);
				ШаблонСДанными.Вывести(ОбластьПозиция,Уровень+1);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция СверитьДанныеПозиций(СтрокаЭталон,СтрокаСравнения,РеквизитыСравнения)
	
	СписокРазличий = Новый СписокЗначений;
	
	Для Каждого КлючИЗначение Из РеквизитыСравнения Цикл
		Если Не СтрокаЭталон[КлючИЗначение.Ключ] = СтрокаСравнения[КлючИЗначение.Значение] Тогда
			СписокРазличий.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокРазличий;
	
КонецФункции

Процедура ВывестиУровеньПросмотр(ШаблонСДанными,Макет,СтрокиДерева,ПолноеДерево,Уровень)
	
	Для Каждого стр Из СтрокиДерева Цикл
		Если стр.ТипСтроки <= 1 Тогда // разделы.
			ОбластьРаздел = Макет.ПолучитьОбласть("ОбластьРаздел");
			ОбластьРаздел.Параметры.Заполнить(стр);
			ШаблонСДанными.Вывести(ОбластьРаздел,Уровень);
			ВывестиУровеньПросмотр(ШаблонСДанными,Макет,стр.Строки,ПолноеДерево,Уровень+1);
		Иначе // позиции.
			Если стр.ТипСтроки = 2 Тогда
				ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПозиция");
				ОбластьПозиция.Параметры.Заполнить(стр);
				ШаблонСДанными.Вывести(ОбластьПозиция,Уровень);
			Иначе
				ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПодчинен");
				ОбластьПозиция.Параметры.Заполнить(стр);
				ШаблонСДанными.Вывести(ОбластьПозиция,Уровень+1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

