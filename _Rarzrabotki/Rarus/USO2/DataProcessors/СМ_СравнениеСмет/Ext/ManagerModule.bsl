
#Область Сравнение

Процедура СравнитьСметы(ПараметрыВызоваСервера,АдресХранилища) Экспорт
	
	ШаблонСДанными 		= ПараметрыВызоваСервера.ШаблонСДанными;
	ТолькоОтклонения 	= ?(ПараметрыВызоваСервера.Свойство("ТолькоОтклонения"),ПараметрыВызоваСервера.ТолькоОтклонения,Ложь);
	ТолькоРасчет 		= ?(ПараметрыВызоваСервера.Свойство("ТолькоРасчет"),ПараметрыВызоваСервера.ТолькоРасчет,Ложь);
	ПоАкту 				= ПараметрыВызоваСервера.СравнениеПоАкту;

	// Сравнение объектных смет
	Если ТипЗнч(ПараметрыВызоваСервера.СметыСравнения.Смета1) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		
		ДеревоСмета1 = СобратьДанныеПоСмете(ПараметрыВызоваСервера.СметыСравнения.Смета1);
		ДеревоСмета2 = СобратьДанныеПоСмете(ПараметрыВызоваСервера.СметыСравнения.Смета2);
		
		Макет 				= Обработки.СМ_СравнениеСмет.ПолучитьМакет("МакетСравнениеОС");
		ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
		ОбластьШапка 		= Макет.ПолучитьОбласть("Шапка");

		ШаблонСДанными.Вывести(ОбластьЗаголовок);
		ШаблонСДанными.Вывести(ОбластьШапка);	
		
		ОбщаяТаблицаДанных 	= ПолучитьОбщуюТаблицуДанныхОС(ДеревоСмета1,ДеревоСмета2);
		РеквизитыСравнения 	= ПолучитьСписокРеквизитовСравнения();
		ТипСтроительства	= ПараметрыВызоваСервера.СметыСравнения.Смета1.ТипСтроительства;

		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ЭтоСмета",Истина);
		
		ТаблицаДанных1 	= ДеревоСмета1.Скопировать(СтруктураОтбора); 
		ТаблицаДанных2 	= ДеревоСмета2.Скопировать(СтруктураОтбора);
	
		ПереименуемКолонкиДерева(ТаблицаДанных2);
		ПереименуемКолонкиДерева(ДеревоСмета2);

		ВывестиДанныеПоОС(ШаблонСДанными,РеквизитыСравнения,Макет,ДеревоСмета1,ДеревоСмета2,ОбщаяТаблицаДанных,ТипСтроительства);
		
	// Сравнение сводных смет
	ИначеЕсли ТипЗнч(ПараметрыВызоваСервера.СметыСравнения.Смета1) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		
		ДеревоСмета1 = СобратьДанныеПоСмете(ПараметрыВызоваСервера.СметыСравнения.Смета1);
		ДеревоСмета2 = СобратьДанныеПоСмете(ПараметрыВызоваСервера.СметыСравнения.Смета2);
		
		Макет 				= Обработки.СМ_СравнениеСмет.ПолучитьМакет("МакетСравнениеСС");
		ОбластьЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
		ОбластьШапка 		= Макет.ПолучитьОбласть("Шапка");
		
		ШаблонСДанными.Вывести(ОбластьЗаголовок);
		ШаблонСДанными.Вывести(ОбластьШапка);
		
		СтруктураДанных		= ПолучитьОбщуюТаблицуДанныхСС(ДеревоСмета1,ДеревоСмета2);
		РеквизитыСравнения 	= ПолучитьСписокРеквизитовСравнения();
	
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ЭтоСмета",Истина);
		
		ТаблицаДанных1 = ДеревоСмета1.Скопировать(СтруктураОтбора); 
		ТаблицаДанных2 = ДеревоСмета2.Скопировать(СтруктураОтбора);

		ПереименуемКолонкиДерева(ТаблицаДанных2);
		ПереименуемКолонкиДерева(ДеревоСмета2);
		
		ОбщаяТаблицаДанных	= СтруктураДанных.ТабИтогов;
		ТабГлавы			= СтруктураДанных.ТабГлавы;
		ТипСтроительства	= ПараметрыВызоваСервера.СметыСравнения.Смета1.ТипСтроительства;
		
		ВывестиДанныеПоСС(ШаблонСДанными,РеквизитыСравнения,Макет,ДеревоСмета1,ДеревоСмета2,ОбщаяТаблицаДанных,ТабГлавы,ТипСтроительства);
		
	Иначе
		
		ДеревоСмета1 		= СоздатьДерево();
		ОбластиРаскраски 	= ПолучитьОбластиРаскраски();		
		
		СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(ПараметрыВызоваСервера.СметыСравнения.Смета1, ДеревоСмета1);
		Если ТолькоРасчет Тогда
			МассивУдалять = ДеревоСмета1.Строки.НайтиСтроки(Новый Структура("Расчет",Ложь),Истина);
			Для Каждого эл Из МассивУдалять Цикл
				Если эл.Родитель = Неопределено Тогда
					ДеревоСмета1.Строки.Удалить(эл);
				Иначе
					эл.Родитель.Строки.Удалить(эл);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ПроставитьУровень(ДеревоСмета1.Строки,0,Ложь);
		
		Если ПоАкту Тогда
			ДеревоСмета2		= СоздатьДеревоАкта();
			РеквизитыСравнения 	= ПолучитьСписокДляСравненияАкт();
			ТекАкт 				= ПараметрыВызоваСервера.СметыСравнения.Смета2;
			ТекСмета 			= ТекАкт.ЛокальнаяСмета;
			СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(ТекСмета,ДеревоСмета2,ТекАкт,Истина);
			ПроставитьУровень(ДеревоСмета2.Строки,0,Истина);
		Иначе
			ДеревоСмета2 		= ДеревоСмета1.Скопировать();
			РеквизитыСравнения 	= ПолучитьСписокДляСравнения();
			СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(ПараметрыВызоваСервера.СметыСравнения.Смета2, ДеревоСмета2);
			ПроставитьУровень(ДеревоСмета2.Строки,0,Ложь);
		КонецЕсли;
		
		ПереименуемКолонкиДерева(ДеревоСмета2);
		Если ТолькоРасчет Тогда
			МассивУдалять = ДеревоСмета2.Строки.НайтиСтроки(Новый Структура("Расчет",Ложь),Истина);
			Для Каждого эл Из МассивУдалять Цикл
				Если эл.Родитель = Неопределено Тогда
					ДеревоСмета2.Строки.Удалить(эл);
				Иначе
					эл.Родитель.Строки.Удалить(эл);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ПоАкту Тогда
			ТабСтоимости = ПолучитьЕдиничнуюСтоимостьПозиций(ТекСмета,ТекАкт);
			ПересчетДереваПоАктуДанныеРегистра(ДеревоСмета1,ТабСтоимости);
		КонецЕсли;
		
		Макет = Обработки.СМ_СравнениеСмет.ПолучитьМакет("Макет");
		
		ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ШаблонСДанными.Вывести(ОбластьЗаголовок);
		
		ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
		ШаблонСДанными.Вывести(ОбластьШапка);	
		
		ОбластьРаздел 	= Макет.ПолучитьОбласть("ОбластьРаздел");
		ОбластьПозиция 	= Макет.ПолучитьОбласть("ОбластьПозиция");
		
		Корень = ДеревоСмета1.Строки[0];
		ОбластьРаздел.Параметры.Заполнить(Корень);
		Корень.Обработано = Истина;
		
		Корень1 = ДеревоСмета2.Строки[0];
		ОбластьРаздел.Параметры.Заполнить(Корень1);
		Корень1.Обработано1 = Истина;        
		
		ТекстОтбора = СформироватьОтборРасценок(ПараметрыВызоваСервера.ПоляПозиции);
		
		ШаблонСДанными.НачатьАвтогруппировкуСтрок();
		ШаблонСДанными.Вывести(ОбластьРаздел,0);
		
		ВывестиУровень(ШаблонСДанными,РеквизитыСравнения,ОбластиРаскраски,Макет,Корень.Строки,Корень1.Строки,Корень1,ТекстОтбора,1,,ТолькоОтклонения);
		
		МассивСтрок = Корень1.Строки.НайтиСтроки(Новый Структура("Обработано1",Ложь),Истина);
		ВывестиНеОбработанные(ШаблонСДанными,Макет,МассивСтрок,1);
		
		ШаблонСДанными.ЗакончитьАвтогруппировкуСтрок();
		
		//Структура 		= Новый Структура("ШаблонСДанными",ШаблонСДанными);
		//АдресХранилища	= ПоместитьВоВременноеХранилище(Структура, АдресХранилища);
		
	КонецЕсли;

	Структура 		= Новый Структура("ШаблонСДанными",ШаблонСДанными);
	АдресХранилища	= ПоместитьВоВременноеХранилище(Структура, АдресХранилища);
	
КонецПроцедуры

Процедура ПоказатьСмету(ПараметрыВызоваСервера,АдресХранилища,ПоАкту) Экспорт
	
	ШаблонСДанными = ПараметрыВызоваСервера.ШаблонСДанными;
	ДеревоСмета = СоздатьДерево();
	
	СМ_СметныйСоставВызовСервера.ВывестиОбновитьДерево(ПараметрыВызоваСервера.Смета, ДеревоСмета);
	ПроставитьУровень(ДеревоСмета.Строки,0,ПоАкту);
	
	Макет 			= Обработки.СМ_СравнениеСмет.ПолучитьМакет("МакетПросмотр");
	ОбластьШапка 	= Макет.ПолучитьОбласть("Шапка");
	ШаблонСДанными.Вывести(ОбластьШапка);	
	
	ОбластьРаздел = Макет.ПолучитьОбласть("ОбластьРаздел");
	ОбластьПозиция = Макет.ПолучитьОбласть("ОбластьПозиция");
	
	Корень = ДеревоСмета.Строки[0];
	ОбластьРаздел.Параметры.Заполнить(Корень);
	Корень.Обработано = Истина;
	
	
	ШаблонСДанными.НачатьАвтогруппировкуСтрок();
	ШаблонСДанными.Вывести(ОбластьРаздел,0);
	
	ВывестиУровеньПросмотр(ШаблонСДанными,Макет,Корень.Строки,Корень,1);
	
	ШаблонСДанными.ЗакончитьАвтогруппировкуСтрок();
	
	Структура = Новый Структура("ШаблонСДанными",ШаблонСДанными);
	АдресХранилища = ПоместитьВоВременноеХранилище(Структура, АдресХранилища);
КонецПроцедуры

