Функция ПолучитьОбластиРаскраски()
	
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Расчет",Новый Структура("Ячейка,Ячейка1","R1C5:R2C7","R1C21:R2C23"));
	Соответствие.Вставить("ОбоснСметнойСтоим",Новый Структура("Ячейка,Ячейка1","R1C3:R1C4","R1C19:R1C20"));
	Соответствие.Вставить("НаимРаботИЗатрат",Новый Структура("Ячейка,Ячейка1","R1C5:R2C7","R1C21:R2C23"));
	Соответствие.Вставить("Кол",Новый Структура("Ячейка,Ячейка1","R1C8","R1C24"));
	Соответствие.Вставить("Измеритель",Новый Структура("Ячейка,Ячейка1","R2C8","R2C24"));
	Соответствие.Вставить("СтоимостьЕдиницы",Новый Структура("Ячейка,Ячейка1","R1C5:R2C7","R1C21:R2C23"));
	Соответствие.Вставить("ЕдВсего",Новый Структура("Ячейка,Ячейка1","R1C9","R1C25"));
	Соответствие.Вставить("ЕдОснЗП",Новый Структура("Ячейка,Ячейка1","R2C9","R2C25"));
	Соответствие.Вставить("ЕдЭксплМашин",Новый Структура("Ячейка,Ячейка1","R1C10","R1C26"));
	Соответствие.Вставить("ЕдЭМЗарПлата",Новый Структура("Ячейка,Ячейка1","R2C10","R2C26"));
	Соответствие.Вставить("ЕдСтоимостьМатериалов",Новый Структура("Ячейка,Ячейка1","R1C11","R1C27"));
	Соответствие.Вставить("ОбщаяСтоимость",Новый Структура("Ячейка,Ячейка1","R1C5:R2C7","R1C21:R2C23"));
	Соответствие.Вставить("ОбщВсего",Новый Структура("Ячейка,Ячейка1","R1C12","R1C28"));
	Соответствие.Вставить("ОбщОснЗП",Новый Структура("Ячейка,Ячейка1","R2C12","R2C28"));
	Соответствие.Вставить("ОбщЭксплМашин",Новый Структура("Ячейка,Ячейка1","R1C13","R1C29"));
	Соответствие.Вставить("ОбщЭМЗарПлата",Новый Структура("Ячейка,Ячейка1","R2C13","R2C29"));
	Соответствие.Вставить("ОбщСтоимостьМатериалов",Новый Структура("Ячейка,Ячейка1","R1C14","R1C30"));
	Соответствие.Вставить("ЕдЗатрТрРаб",Новый Структура("Ячейка,Ячейка1","R1C15","R1C31"));
	Соответствие.Вставить("ЕдЗатрТрМех",Новый Структура("Ячейка,Ячейка1","R2C15","R2C31"));
	Соответствие.Вставить("ОбщЗатрТрРаб",Новый Структура("Ячейка,Ячейка1","R1C16","R1C32"));
	Соответствие.Вставить("ОбщЗатрТрМех",Новый Структура("Ячейка,Ячейка1","R2C16","R2C32"));
	Соответствие.Вставить("Наименование",Новый Структура("Ячейка,Ячейка1","R1C5:R2C7","R1C21:R2C23"));
