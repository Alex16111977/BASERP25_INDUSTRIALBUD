#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	ВыборкаУзлов = ПланыОбмена.СМ_ОбменСметаМобильное.Выбрать();
	Пока ВыборкаУзлов.Следующий() Цикл
		Если ВыборкаУзлов.Ссылка =  ПланыОбмена.СМ_ОбменСметаМобильное.ЭтотУзел() ИЛИ ВыборкаУзлов.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		СтрМП = Объект.УзлыМП.Добавить();
		СтрМП.Узел = ВыборкаУзлов.Ссылка;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура Команда1(Команда)
	Список = Новый СписокЗначений;
	Для каждого стр Из Объект.УзлыМП Цикл
		Если Не стр.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Список.Добавить(стр.Узел);
	КонецЦикла;
	Закрыть(Список);
КонецПроцедуры

#КонецОбласти