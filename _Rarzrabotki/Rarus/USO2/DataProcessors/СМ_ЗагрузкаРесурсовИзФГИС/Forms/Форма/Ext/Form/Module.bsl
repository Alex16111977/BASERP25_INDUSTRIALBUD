&НаКлиенте
Процедура ВыполнитьПослеВыбораФайла(ВыбранныеФайлы,ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ВыбранныеФайлы Цикл
			ЗагрузитьИзЭксельНаСервере(ТекЭлемент);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьИзЭксельНаСервере(ИмяФайла)
	
    Попытка
    	КнигаЭксель = ПолучитьCOMОбъект(ИмяФайла);
    Исключение
    	Возврат;
    КонецПопытки;

    ExcelЛист 			= КнигаЭксель.Sheets.Item(1);
   // RowCount 			= ExcelЛист.UsedRange.Rows.Count; 		// Кол-во строк
   // ColumnCount 		= ExcelЛист.UsedRange.Columns.Count; 	// Кол-во колонок
    КоличествоЛистов 	= КнигаЭксель.Sheets.Count; 			// Количество листов
    
	Для Сч = 1 По КоличествоЛистов Цикл

		ExcelЛист 		= КнигаЭксель.Sheets.Item(Сч);
		ИмяЛиста 		= СокрЛП(ExcelЛист.name);
		КоличествоСтрок = ExcelЛист.UsedRange.Rows.Count;

		Если ИмяЛиста = "Материалы" Тогда
			ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
		ИначеЕсли ИмяЛиста = "Оборудование" Тогда
			ВидРесурса = Перечисления.СМ_ВидыРесурсов.Оборудование;
		ИначеЕсли ИмяЛиста = "Машины и механизмы" Тогда
			ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
		Иначе
			Возврат;
		КонецЕсли;

		ЗагрузитьРесурсыЛиста(ExcelЛист,КоличествоСтрок,ВидРесурса);

	КонецЦикла;
    
	Сообщение 		= Новый СообщениеПользователю();
	Сообщение.Текст = "Обработка данных завершена!";
	Сообщение.Сообщить();	
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРесурсыЛиста(ExcelЛист,КоличествоСтрок,ВидРесурса)
	
	ГруппаПоУмолчанию = Справочники.СМ_Ресурсы.Каталог2017;
	
	Для СтрокаЗагрузки = 3 По КоличествоСтрок Цикл
		
		КодРесурса		 	= ExcelЛист.Cells(СтрокаЗагрузки,1).Text;
		Наименование 		= ExcelЛист.Cells(СтрокаЗагрузки,2).Text;
		ЕдиницаИзмерения	= СокрЛП(ExcelЛист.Cells(СтрокаЗагрузки,3).Text);
		
		Если НЕ ЗначениеЗаполнено(КодРесурса) И НЕ ЗначениеЗаполнено(Наименование) И НЕ ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
			Прервать;
		КонецЕсли;
	
		Если КодРесурса = Наименование Тогда
			ТекущаяГруппа = НайтиСоздатьГруппу(Наименование,ГруппаПоУмолчанию);
		Иначе
			НайтиСоздатьРесурс(КодРесурса, Наименование, ЕдиницаИзмерения, ВидРесурса, ТекущаяГруппа);
		КонецЕсли;
	
	КонецЦикла;		
	
   Сообщение 		= Новый СообщениеПользователю();
   Сообщение.Текст 	= "Загружены ресурсы вида " + ВидРесурса;
   Сообщение.Сообщить();	
	
КонецПроцедуры
	
&НаСервере
Функция НайтиСоздатьГруппу(НаименованиеГруппы, ГруппаПоУмолчанию)
	
	МассивГруппы 		= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаименованиеГруппы,":",,Истина);
	СтрокаКода          = МассивГруппы[0];
	СтрокаНаименования  = МассивГруппы[1];

	МассивКода 			= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаКода," ",,Истина);
	КодГруппы 			= МассивКода[1];
	ТекПозиция 			= СтрНайти(КодГруппы,".",НаправлениеПоиска.СКонца);
	КодГруппыРодителя 	= Лев(КодГруппы,ТекПозиция-1);

	Если ЗначениеЗаполнено(КодГруппыРодителя) Тогда
		ГруппаРодитель = Справочники.СМ_Ресурсы.НайтиПоКоду(КодГруппыРодителя);	
	Иначе
		ГруппаРодитель = ГруппаПоУмолчанию;
	КонецЕсли;

	НайденнаяГруппа = Справочники.СМ_Ресурсы.НайтиПоКоду(КодГруппы,,ГруппаРодитель);
	Если НайденнаяГруппа = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
		НоваяГруппа 					= Справочники.СМ_Ресурсы.СоздатьГруппу();
		НоваяГруппа.Код                 = КодГруппы;
		НоваяГруппа.Наименование        = СтрокаНаименования;
		НоваяГруппа.ДлинноеНаименование	= НаименованиеГруппы;
		НоваяГруппа.Родитель			= ГруппаРодитель;
		Попытка 
			НоваяГруппа.Записать();
		Исключение                                                                            
			Сообщение 		= Новый СообщениеПользователю();
			Сообщение.Текст = "Не удалось записать группу: " + НоваяГруппа;
			Сообщение.Сообщить();				
		КонецПопытки;
		НайденнаяГруппа = НоваяГруппа.Ссылка;
	КонецЕсли;

	Возврат НайденнаяГруппа;
	
КонецФункции

&НаСервере
Процедура НайтиСоздатьРесурс(КодРесурсаСтр,Наименование, ЕдиницаИзмеренияСтр, ВидРесурса, ТекущаяГруппа)
	
	КодГруппы		= ТекущаяГруппа.Код;
	ДлинаКода		= СтрДлина(КодРесурсаСтр);
	ТекПозиция		= СтрНайти(КодРесурсаСтр,КодГруппы);
	КодРесурса		= Сред(КодРесурсаСтр,ТекПозиция);
	КодОКПД2		= Лев(КодРесурсаСтр,ТекПозиция-2);
		
	НайденныйРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду(КодРесурса,Ложь,ТекущаяГруппа);
	Если НайденныйРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
		ТекРесурс 						= Справочники.СМ_Ресурсы.СоздатьЭлемент();
		ТекРесурс.Код                   = КодРесурса;
		ТекРесурс.Наименование          = Наименование;
		ТекРесурс.ДлинноеНаименование   = Наименование;
		ТекРесурс.КодОКДП2              = КодОКПД2;
		ТекРесурс.ВидРесурса            = ВидРесурса;
		ТекРесурс.ГруппаРесурсов		= Справочники.СМ_ГруппыРесурсов.Каталог2017;
		ТекРесурс.ГодВыпуска			= Перечисления.СМ_ГодыВыпускаБазы.г2017;
		ТекРесурс.Родитель				= ТекущаяГруппа;
		ТекЕдиницаИзмерения 			= НайтиСоздатьЕдиницуИзмерения(ЕдиницаИзмеренияСтр);
		ТекРесурс.ЕдиницаИзмерения 		= ТекЕдиницаИзмерения;
		Попытка 
			ТекРесурс.Записать();
		Исключение
			Сообщение 		= Новый СообщениеПользователю();
			Сообщение.Текст = "Не удалось записать ресурс: " + ТекРесурс;
			Сообщение.Сообщить();			
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиСоздатьЕдиницуИзмерения(ЕдиницаИзмеренияСтр)
	
	ТекЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(ЕдиницаИзмеренияСтр);
	Если ТекЕдиницаИзмерения.Пустая() Тогда
		Если ЕдиницаИзмеренияСтр = "шт." Тогда
			ТекЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке("шт");
		КонецЕсли;
	КонецЕсли;

	Если ТекЕдиницаИзмерения.Пустая() Тогда
  		ЕдиницаИзмерения 						= Справочники.СМ_ЕдиницыИзмеренияСмета.СоздатьЭлемент();
		ЕдиницаИзмерения.Наименование 			= ЕдиницаИзмеренияСтр;
		ЕдиницаИзмерения.ОбменДанными.Загрузка 	= Истина;
		ЕдиницаИзмерения.Записать();
		ТекЕдиницаИзмерения = ЕдиницаИзмерения.Ссылка;
	КонецЕсли;
	
	Возврат ТекЕдиницаИзмерения;
	
КонецФункции

#КонецОбласти
