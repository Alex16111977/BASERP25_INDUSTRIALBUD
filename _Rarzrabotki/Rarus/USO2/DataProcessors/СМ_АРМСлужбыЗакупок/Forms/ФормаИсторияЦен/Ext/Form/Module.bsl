
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Ресурс") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СМ_СметныеЦеныРесурсов.Период,
		               |	СМ_СметныеЦеныРесурсов.СметнаяЦена,
		               |	СМ_СметныеЦеныРесурсов.Комментарий
		               |ИЗ
		               |	РегистрСведений.СМ_СметныеЦеныРесурсов КАК СМ_СметныеЦеныРесурсов
		               |ГДЕ
		               |	СМ_СметныеЦеныРесурсов.Ресурс = &Ресурс
		               |	И СМ_СметныеЦеныРесурсов.ТипЦен = ЗНАЧЕНИЕ(Перечисление.СМ_ТипыЦен.Текущая)";
		Запрос.УстановитьПараметр("Ресурс", Параметры.Ресурс);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла; 
		ЭтаФорма.Заголовок = "История цен ресурса """ + Строка(Параметры.Ресурс) + """";
	КонецЕсли; 
КонецПроцедуры

#КонецОбласти
