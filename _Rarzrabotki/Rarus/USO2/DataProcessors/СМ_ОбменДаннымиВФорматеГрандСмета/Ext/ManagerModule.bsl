					СтрокаРесурса 				= ТабРесурсов.Добавить();
					СтрокаРесурса.Акт           = Ложь;
					СтрокаРесурса.ВидРесурса 	= ИмяУзла;
					СтрокаРесурса.ИдПозиции		= ИдПозиции;
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						
						ТипУзла 		= Чтение.ТипУзла; 
