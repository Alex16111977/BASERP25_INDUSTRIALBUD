					// Подразделы.
				ИначеЕсли ИмяУзла = "Header" Тогда	
					
					Если Не НоваяСтрокаРаздела.Подраздел Тогда
						ВерхнийРаздел = НоваяСтрокаРаздела;
					КонецЕсли;
					
					НаименованиеРаздела = "НовыйПодраздел";
					НоваяСтрокаРаздела 	= ТабРазделов.Добавить();
					НоваяСтрокаРаздела.ИДсметы = СтрокаЛС.ИДсметы;
					НоваяСтрокаРаздела.ВерхнийРаздел = ВерхнийРаздел.SysID;
