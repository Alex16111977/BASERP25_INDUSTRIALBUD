Процедура ЗагрузитьГрандСмета(СтруктураПараметровЗадания,АдресХранилища) Экспорт
	
	Перем СтрокаЛС;
	Перем ИдПозиции;
	
	Форма 				= СтруктураПараметровЗадания.ТекФорма;
	ТабДокументов 		= СтруктураПараметровЗадания.ТабДокументов;
	ТабИндексов			= СтруктураПараметровЗадания.ТабИндексов; 
	ТабРазделов 		= СтруктураПараметровЗадания.ТабРазделов;
	ТабПозицийЛС		= СтруктураПараметровЗадания.ТабПозицийЛС;
	ТабРесурсов 		= СтруктураПараметровЗадания.ТабРесурсов;
	ТабЛимЗатраты 		= СтруктураПараметровЗадания.ТабЛимЗатраты;
	ТабВидовРабот 		= СтруктураПараметровЗадания.ТабВидовРабот;
	ТабПоправки 		= СтруктураПараметровЗадания.ТабПоправки;
	ТабРаботы 			= СтруктураПараметровЗадания.ТабРаботы;
	ТабСообщения 		= СтруктураПараметровЗадания.ТабСообщения;
	ТабЛимЗатраты		= СтруктураПараметровЗадания.ТабЛимЗатраты;
	ТабПодписи   		= СтруктураПараметровЗадания.ТабПодписи;
	СведенияФайлов 		= СтруктураПараметровЗадания.СведенияФайлов;
	СметнаяПрограмма 	= Справочники.СМ_СметныеПрограммы.ГрандСмета;
	
	Для Каждого ТекФайл Из СведенияФайлов Цикл
		ТекФайл.НаименованиеСметы = ТекФайл.Загрузка_ИмяФайла;
		ИмяУзлаРодителя	 = "";
		
		// Параметры индексов.
		IndexesMode 	= "";
		IndexFileName 	= "";
		IndexesLinkMode	= "";
		
		// ******************
		// ++ AVV
		ИДАкта			= "";
		// -- AVV
		// ******************
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",ТекФайл.Загрузка_ПолныйПуть)); 
		Запись.Следующий();
		ДвоичныеДанные = Запись.Файл.Получить();
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		
		Чтение = Новый ЧтениеXML; 
		Чтение.ОткрытьФайл(ИмяВременногоФайла); 
		Пока Чтение.Прочитать() Цикл 
			
			ИмяУзла = Чтение.Имя; 
			
			//  Прочитать "структурные части" элементов. 
			//  Проверить, какая часть элемента - текущая. 
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
				
				Если ИмяУзла = "Document" Тогда
					
					Если ИмяУзлаРодителя = "DbInfo" Тогда
						
						Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
							
							// ИмяПараметра: Caption
							
							ТипУзла 		= Чтение.ТипУзла; 
							ИмяПараметра 	= Чтение.Имя; 
							Значение 		= Чтение.Значение; 
							
							Если ИмяПараметра = "Caption" Тогда
								
							КонецЕсли;
							
						КонецЦикла;
						
					Иначе	
						
						СтрокаЛС 					= ТабДокументов.Добавить();
						СтрокаЛС.Акт = Ложь;
						СтрокаЛС.ИДсметы            = ТекФайл.Загрузка_ИмяФайла;
						СтрокаЛС.НаименованиеСметы 	= ТекФайл.Загрузка_ИмяФайла;
						СтрокаЛС.НомерСметы        	= "";
						
						Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
							
							// ИмяПараметра: ProgramVersion
							// ИмяПараметра: Generator
							// ИмяПараметра: DocumentType
							
							ТипУзла 		= Чтение.ТипУзла; 
							ИмяПараметра 	= Чтение.Имя; 
							Значение 		= Чтение.Значение; 
							
							Если ИмяПараметра = "ProgramVersion" Тогда
								ВерсияПрограммы 	= Значение; 
							ИначеЕсли ИмяПараметра = "Generator" Тогда
								ПрограммаИсточник	= Значение;	
							ИначеЕсли ИмяПараметра = "DocumentType" Тогда	
								ТипДокумента		= Значение;	
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЕсли;
					
				ИначеЕсли ИмяУзла = "Properties" Тогда	
					
					НаименованиеСметы1 = "";
					НаименованиеСметы2 = "";
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "LocNum" Тогда
							ТекФайл.НомерСметы 	= Значение; 
						ИначеЕсли ИмяПараметра = "Description" Тогда
							НаименованиеСметы1	= Значение;	
						ИначеЕсли ИмяПараметра = "Stage" Тогда	
							НаименованиеСметы2	= Значение;	
						ИначеЕсли ИмяПараметра = "Object" Тогда	
							ТекФайл.Стройка = Справочники.СМ_ОбъектыСтроительства.НайтиПоНаименованию(Значение,Истина);
						КонецЕсли;
						
					КонецЦикла;
					
					
				ИначеЕсли ИмяУзла = "DbInfo" Тогда	
					
					ИмяУзлаРодителя = ИмяУзла;
					
					// Объект строительства.
				ИначеЕсли ИмяУзла = "Object" И ИмяУзлаРодителя = "DbInfo" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Caption
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Caption" Тогда
						КонецЕсли;
						
					КонецЦикла;	
					
				ИначеЕсли ИмяУзла = "Construction" И ИмяУзлаРодителя = "DbInfo" Тогда	
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Caption
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Caption" Тогда
						КонецЕсли;
						
					КонецЦикла;	
					
				ИначеЕсли ИмяУзла = "RegionInfo" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						// ИмяПараметра: RegionName
						// ИмяПараметра: RegionID
						// ИмяПараметра: Zone84ID
						// ИмяПараметра: Zone01ID
						// ИмяПараметра:	Zone84Name
						// ИмяПараметра:	Zone01Name
						
						Если ИмяПараметра = "RegionName" Тогда
							СтрокаЛС.RegionName = Значение;
						ИначеЕсли ИмяПараметра = "RegionID" Тогда
							СтрокаЛС.RegionID 	= Значение;
						ИначеЕсли ИмяПараметра = "Zone84ID" Тогда	
							СтрокаЛС.Zone84ID 	= Значение;	
						ИначеЕсли ИмяПараметра = "Zone01ID" Тогда	
							СтрокаЛС.Zone01ID 	= Значение;	
						ИначеЕсли ИмяПараметра = "Zone01Name" Тогда	
							СтрокаЛС.Zone01Name	= Значение;	
						ИначеЕсли ИмяПараметра = "Zone84Name" Тогда
							СтрокаЛС.Zone84Name	= Значение;	
						КонецЕсли;
						
					КонецЦикла;	
					
					ТекФайл.ИмяРегиона 			= СтрокаЛС.RegionName;
					ТекФайл.НаименованиеРайона 	= СтрокаЛС.Zone01Name;
					НайтиТерриториальныйРайон(ТекФайл,СтрокаЛС.Zone01ID,СтрокаЛС.Zone84ID);
					
				ИначеЕсли ИмяУзла = "Parameters" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Options.
						// ИмяПараметра: BasePrices.
						// ИмяПараметра: BaseCalcVrs.
						// ИмяПараметра: BlockRoundMode.
						// ИмяПараметра: TempZone.
						// ИмяПараметра: MatRoundMode.
						// ИмяПараметра: MatDigits.
						// ИмяПараметра: ItogOptions.
						// ИмяПараметра: FirstItogItem.
						// ИмяПараметра: ItogExpandTo.
						// ИмяПараметра: TzDigits.
						// ИмяПараметра: PosKDigits.
						// ИмяПараметра: MultKPosCalcMode.
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Options" Тогда
							СтрокаЛС.Options = Значение;
						ИначеЕсли ИмяПараметра = "BasePrices" Тогда
							СтрокаЛС.BasePrices = Значение;	
						ИначеЕсли ИмяПараметра = "BaseCalcVrs" Тогда	
							СтрокаЛС.BaseCalcVrs = Значение;	
						ИначеЕсли ИмяПараметра = "BlockRoundMode" Тогда	
							СтрокаЛС.BlockRoundMode = Значение;	
						ИначеЕсли ИмяПараметра = "TempZone" Тогда	
							СтрокаЛС.TempZone = Значение;	
						ИначеЕсли ИмяПараметра = "MatRoundMode" Тогда	
							СтрокаЛС.MatRoundMode = Значение;	
						ИначеЕсли ИмяПараметра = "MatDigits" Тогда	
							СтрокаЛС.MatDigits = Значение;	
						ИначеЕсли ИмяПараметра = "ItogOptions" Тогда	
							СтрокаЛС.ItogOptions = Значение;	
						ИначеЕсли ИмяПараметра = "FirstItogItem" Тогда	
							СтрокаЛС.FirstItogItem = Значение;	
						ИначеЕсли ИмяПараметра = "ItogExpandTo" Тогда	
							СтрокаЛС.ItogExpandTo = Значение;							
						ИначеЕсли ИмяПараметра = "TzDigits" Тогда	
							СтрокаЛС.TzDigits = Значение;	
						ИначеЕсли ИмяПараметра = "PosKDigits" Тогда	
							СтрокаЛС.PosKDigits = Значение;	
						ИначеЕсли ИмяПараметра = "MultKPosCalcMode" Тогда	
							СтрокаЛС.MultKPosCalcMode = Значение;	
						КонецЕсли;
						
					КонецЦикла;	
					
				ИначеЕсли ИмяУзла = "CommonNK" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: MethodKI
						// ИмяПараметра: ActiveItems
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "MethodKI" Тогда
							СтрокаЛС.NK_MethodKI = Значение;
						ИначеЕсли ИмяПараметра = "ActiveItems" Тогда
							СтрокаЛС.NK_ActiveItems = Значение;	
						КонецЕсли;
						
					КонецЦикла;
					
				ИначеЕсли ИмяУзла = "CommonPK" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: MethodKI
						// ИмяПараметра: ActiveItems
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "MethodKI" Тогда
							СтрокаЛС.PK_MethodKI = Значение;
						ИначеЕсли ИмяПараметра = "ActiveItems" Тогда
							СтрокаЛС.PK_ActiveItems = Значение;	
						КонецЕсли;
						
					КонецЦикла;
					
				// Группа индексы, подчинена узлу "Document".
				ИначеЕсли ИмяУзла = "Indexes" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: IndexesMode
						// ИмяПараметра: IndexFileName
						// ИмяПараметра: IndexesLinkMode
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "IndexesMode" Тогда
							ТекФайл.IndexesMode = Значение;
						ИначеЕсли ИмяПараметра = "IndexFileName" Тогда
							IndexFileName = Значение;
						ИначеЕсли ИмяПараметра = "IndexesLinkMode" Тогда
							ТекФайл.IndexesLinkMode = Значение;
						КонецЕсли;
						
					КонецЦикла;
					
				// Групповой узел идексов.	
				// Подчинен узлу "Indexes".
				ИначеЕсли ИмяУзла = "IndexesPos" Тогда
					
				// Подчинен узлу "IndexesPos".
				// Строки индексов.
				ИначеЕсли ИмяУзла = "Index" Тогда

					СтрокаИндексы 					= ТабИндексов.Добавить();
					СтрокаИндексы.ИДсметы 			= СтрокаЛС.ИДсметы;
					СтрокаИндексы.УровеньДокумента 	= Ложь;
					
					// ***************************
					// ++ AVV
					// Определяем относится коэффициент к позициям акта или нет
					Если ИмяУзлаРодителя = "ImplemAct" Тогда
						СтрокаИндексы.ИндексыАкта	= Истина;	// Признак что коэффициент относится к акту
						СтрокаИндексы.ИдАкта	    = ИДАкта;	// Ид акта
					Иначе
						СтрокаИндексы.ИндексыАкта	= Ложь;		// Признак что коэффициент относится к акту
						СтрокаИндексы.ИдАкта	    = "";		// Ид акта
					КонецЕсли;
					// -- AVV
					// ***************************
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Caption
						// ИмяПараметра: Code
						// ИмяПараметра: OZ
						// ИмяПараметра: EM
						// ИмяПараметра: ZM
						// ИмяПараметра: MT
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Caption" Тогда
							СтрокаИндексы.Caption = Значение;
						ИначеЕсли ИмяПараметра = "Code" Тогда
							СтрокаИндексы.Code = Значение;	
						ИначеЕсли ИмяПараметра = "OZ" Тогда
							СтрокаИндексы.OZ = Значение; 	
						ИначеЕсли ИмяПараметра = "EM" Тогда
							СтрокаИндексы.EM = Значение;	
						ИначеЕсли ИмяПараметра = "ZM" Тогда
							СтрокаИндексы.ZM = Значение;	
						ИначеЕсли ИмяПараметра = "MT" Тогда
							СтрокаИндексы.MT = Значение; 
						ИначеЕсли ИмяПараметра = "Formula" Тогда
							СтрокаИндексы.Formula = Значение; 
						ИначеЕсли ИмяПараметра = "SMR" Тогда
							СтрокаИндексы.SMR = Значение;
						КонецЕсли;
						
					КонецЦикла;
					
				// Индекс на уровне документа.
				ИначеЕсли ИмяУзла = "CommonIndexB" И ИмяУзлаРодителя <> "ImplemAct" Тогда
					
					СтрокаИндексы 					= ТабИндексов.Добавить();
					СтрокаИндексы.ИДсметы 			= СтрокаЛС.ИДсметы;
					СтрокаИндексы.УровеньДокумента 	= Истина;
					СтрокаИндексы.ИндексыАкта		= Ложь;	// Признак что коэффициент относится к акту
					СтрокаИндексы.ИдАкта	    	= "";	// Ид акта
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Caption
						// ИмяПараметра: Code
						// ИмяПараметра: OZ
						// ИмяПараметра: EM
						// ИмяПараметра: ZM
						// ИмяПараметра: MT
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Caption" Тогда
							СтрокаИндексы.Caption = Значение;
						ИначеЕсли ИмяПараметра = "Code" Тогда
							СтрокаИндексы.Code = Значение;	
						ИначеЕсли ИмяПараметра = "OZ" Тогда
							СтрокаИндексы.OZ = Значение; 	
						ИначеЕсли ИмяПараметра = "EM" Тогда
							СтрокаИндексы.EM = Значение;	
						ИначеЕсли ИмяПараметра = "ZM" Тогда
							СтрокаИндексы.ZM = Значение;	
						ИначеЕсли ИмяПараметра = "MT" Тогда
							СтрокаИндексы.MT = Значение; 
						ИначеЕсли ИмяПараметра = "Formula" Тогда
							СтрокаИндексы.Formula = Значение; 	
						КонецЕсли;
						
					КонецЦикла;
					
				ИначеЕсли ИмяУзла = "OsIndexes" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// Пока не было значений в файле.
						// Какие могут быть параметры непонятно.
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
					КонецЦикла;
					
				ИначеЕсли ИмяУзла = "RegionalK" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Options
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
					КонецЦикла;
					
				ИначеЕсли ИмяУзла = "TerZoneK" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Options
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
					КонецЦикла;
					
					// Группировочный узел по видам работ.
				ИначеЕсли ИмяУзла = "VidRab_Catalog" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						// ИмяПараметра: Caption.
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 					
						
						Если ИмяПараметра = "Caption" Тогда
							ОпределитьПараметрыСтроительства(ТекФайл,СокрЛП(Значение),ТабСообщения);
						КонецЕсли;
						
					КонецЦикла;
					
					// Подчинен узлу "VidRab_Catalog".
				ИначеЕсли ИмяУзла = "Vids_Rab" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Type
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
					КонецЦикла;
					
					// Подчинен узлу "Vids_Rab".
				ИначеЕсли ИмяУзла = "VidRab_Group" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Caption
						// ИмяПараметра: ID
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "ID" Тогда
							ИдГруппыРабот = Значение;
						КонецЕсли;
						
					КонецЦикла;
					
					// Подчинен узлу "VidRab_Group".
				ИначеЕсли ИмяУзла = "Vid_Rab" Тогда
					
					СтрокаВР 				= ТабВидовРабот.Добавить();
					СтрокаВР.ИДсметы = СтрокаЛС.ИДсметы;
					СтрокаВР.ИдГруппаРабот  = ИдГруппыРабот;
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Caption
						// ИмяПараметра: ID
						// ИмяПараметра: Nacl
						// ИмяПараметра: NaclCurr
						// ИмяПараметра: NaclMask
						// ИмяПараметра: Plan
						// ИмяПараметра: PlanCurr
						// ИмяПараметра: PlanMask
						// ИмяПараметра: OsColumn
						// ИмяПараметра: NKB
						// ИмяПараметра: PNB
						// ИмяПараметра: NKI
						// ИмяПараметра: PKI
						// ИмяПараметра: NKR
						// ИмяПараметра: PKR
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Caption" Тогда
							СтрокаВР.Наименование = Значение; 
						ИначеЕсли ИмяПараметра = "ID" Тогда
							СтрокаВР.Ид = Значение;
						ИначеЕсли ИмяПараметра = "Nacl" Тогда
							СтрокаВР.НакладныеРасходыБазисные = Значение;
						ИначеЕсли ИмяПараметра = "NaclCurr" Тогда
							СтрокаВР.НакладныеРасходыТекущие = Значение;
						ИначеЕсли ИмяПараметра = "NaclMask" Тогда
							СтрокаВР.NaclMask = Значение;
						ИначеЕсли ИмяПараметра = "Plan" Тогда
							СтрокаВР.СметнаяПрибыльБазисные = Значение;
						ИначеЕсли ИмяПараметра = "PlanCurr" Тогда
							СтрокаВР.СметнаяПрибыльТекущие = Значение;
						ИначеЕсли ИмяПараметра = "PlanMask" Тогда
							СтрокаВР.PlanMask = Значение;
						ИначеЕсли ИмяПараметра = "OsColumn" Тогда
							СтрокаВР.OsColumn = Значение;
						ИначеЕсли ИмяПараметра = "NKB" Тогда
							СтрокаВР.КоэффициентКНРНаРемонтБазисный = Значение;
						ИначеЕсли ИмяПараметра = "PNB" Тогда 
							СтрокаВР.КоэффициентКСПНаРемонтБазисный = Значение;
						ИначеЕсли ИмяПараметра = "NKI" Тогда
							СтрокаВР.КоэффициентКНРНаРемонтТекущий = Значение;
						ИначеЕсли ИмяПараметра = "PKI" Тогда
							СтрокаВР.КоэффициентКСПНаРемонтТекущий = Значение;
						ИначеЕсли ИмяПараметра = "NKR" Тогда
							СтрокаВР.NKR = Значение;
						ИначеЕсли ИмяПараметра = "PKR" Тогда
							СтрокаВР.PKR = Значение;
						КонецЕсли;
						
					КонецЦикла;
					
					// Группа коэффициенты.
				ИначеЕсли ИмяУзла = "Koefficients" Тогда
					
					// Узел коэффициента, подчинен узлу "Koefficients".
				ИначеЕсли ИмяУзла = "K" Тогда
					
					СтрокаК 			= ТабПоправки.Добавить();
					СтрокаК.ИДсметы 	= СтрокаЛС.ИДсметы;
					СтрокаК.ИдПозиции   = ИдПозиции;
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						// ИмяПараметра: Caption
						// ИмяПараметра: Value_OZ
						// ИмяПараметра: Value_EM
						// ИмяПараметра: Value_MT
						// ИмяПараметра: Options
						// ИмяПараметра: Level
						// ИмяПараметра: AllVidRabs
						// ИмяПараметра: AllChapters
						// ИмяПараметра: VrGroupsLinks
						// ИмяПараметра: VrsLinks

						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Caption" Тогда
							СтрокаК.УсловияПрименения = Значение; 
						ИначеЕсли ИмяПараметра = "Value_OZ" Тогда
							СтрокаК.КоэффициентОЗ = Значение;
						ИначеЕсли ИмяПараметра = "Value_EM" Тогда
							СтрокаК.КоэффициентЭМ = Значение;
						ИначеЕсли ИмяПараметра = "Value_MT" Тогда
							СтрокаК.КоэффициентСМ = Значение;
						ИначеЕсли ИмяПараметра = "Value_ZM" Тогда
							СтрокаК.КоэффициентZM = Значение;
						ИначеЕсли ИмяПараметра = "Value_PZ" Тогда
							СтрокаК.КоэффициентPZ = Значение;
						ИначеЕсли ИмяПараметра = "Options" Тогда
							СтрокаК.Опции = Значение;
						ИначеЕсли ИмяПараметра = "Level" Тогда
							СтрокаК.Уровень = Значение;
						ИначеЕсли ИмяПараметра = "AllVidRabs" Тогда
							СтрокаК.ВсеВидыРабот = Значение;
						ИначеЕсли ИмяПараметра = "AllChapters" Тогда
							СтрокаК.ВсеРазделы = Значение;
						ИначеЕсли ИмяПараметра = "ChaptersLinks" Тогда	
							СтрокаК.Разделы = Значение;
						//ИначеЕсли ИмяПараметра = "VrGroupsLinks" Тогда
						//	СтрокаК.ВидыРабот = Значение;
						ИначеЕсли ИмяПараметра = "VrsLinks" Тогда
							СтрокаК.ВидыРабот = Значение;
						ИначеЕсли ИмяПараметра = "VrGroupsLinks" Тогда
							СтрокаК.ГруппыРабот = Значение;
						КонецЕсли;
										
					КонецЦикла;
					
				// Акты.
				ИначеЕсли ИмяУзла = "ImplemActs" Тогда
					
				// Узел конкретного акта.
				ИначеЕсли ИмяУзла = "ImplemAct" Тогда
					
					ИмяУзлаРодителя = ИмяУзла;
					
					СтрокаАкт 		= ТабДокументов.Добавить();
					СтрокаАкт.Акт 	= Истина;
					СтрокаАкт.SysID = СтрокаЛС.ИДсметы;
					
					ДатаГод 	= 1;
					ДатаМесяц 	= 1;
					ДеньОт 		= 1;
					ДеньДо 		= 1;
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						Если ИмяПараметра = "ActIndex" Тогда
							СтрокаАкт.ИДакта  = Значение;	
							// ***************************** 
							// ++ AVV
							ИДАкта = Значение;
							// -- AVV
							// *****************************
						ИначеЕсли ИмяПараметра = "Number" Тогда
							СтрокаАкт.НомерАкта  = Значение;
						ИначеЕсли ИмяПараметра = "MakingDate" Тогда
							СтрокаАкт.ДатаАкта  = Дата(Прав(Значение,4),Сред(Значение,4,2),Лев(Значение,2));
						ИначеЕсли ИмяПараметра = "Year" Тогда
							ДатаГод  = Значение;
						ИначеЕсли ИмяПараметра = "Month" Тогда
							ДатаМесяц  = Значение;
						ИначеЕсли ИмяПараметра = "DayStart" Тогда
							ДеньОт  = Значение;
						ИначеЕсли ИмяПараметра = "DayFinish" Тогда
							ДеньДо  = Значение;
						КонецЕсли;
					КонецЦикла;
					СтрокаАкт.ПериодОт = Дата(ДатаГод,ДатаМесяц,ДеньОт);
					СтрокаАкт.ПериодДо = Дата(ДатаГод,ДатаМесяц,ДеньДо);
					
				// Индексы Акта	
				ИначеЕсли ИмяУзла = "CommonIndexB" И ИмяУзлаРодителя = "ImplemAct" Тогда
					
				// Подписи Акта	
				ИначеЕсли ИмяУзла = "GsDocSignatures" И ИмяУзлаРодителя = "ImplemAct" Тогда
					
					ИмяУзлаРодителя = ИмяУзла+"ImplemAct";
					
				// Подпись Акта	
				ИначеЕсли ИмяУзла = "Item" И ИмяУзлаРодителя = "ImplemAct" Тогда
					
				// Группа главы	
				ИначеЕсли ИмяУзла = "Chapters" Тогда
					
				// Глава, подчинена узлу "Chapters"	
				ИначеЕсли ИмяУзла = "Chapter" Тогда
					
					НаименованиеРаздела = "НовыйРаздел";
					ИдРаздела			= "НовыйРаздел";
					НоваяСтрокаРаздела 	= ТабРазделов.Добавить();
					НоваяСтрокаРаздела.ИДсметы = СтрокаЛС.ИДсметы;
					НоваяСтрокаРаздела.Подраздел = Ложь;
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						
						ТипУзла 		= Чтение.ТипУзла; 
