	СтруктураТекФорма.Вставить("ДатаСметы",ТекФорма.ДатаСметы);
	СтруктураТекФорма.Вставить("Организация",ТекФорма.Организация);
	СтруктураТекФорма.Вставить("НаименованиеСметы",ТекФорма.НаименованиеСметы);
	СтруктураТекФорма.Вставить("Заказчик",ТекФорма.Заказчик);
	СтруктураТекФорма.Вставить("Стройка",ТекФорма.Стройка);
	СтруктураТекФорма.Вставить("ТипСтроительства",ТекФорма.ТипСтроительства);	
	СтруктураТекФорма.Вставить("ВариантПересчетаЭММ",ТекФорма.ВариантПересчетаЭММ);
	СтруктураТекФорма.Вставить("ПрименятьКоэффициентыНРСП",ТекФорма.ПрименятьКоэффициентыНРСП);
	СтруктураТекФорма.Вставить("ТипРайона",ТекФорма.ТипРайона);
	СтруктураТекФорма.Вставить("НаименованиеРайона",ТекФорма.НаименованиеРайона);
	СтруктураТекФорма.Вставить("Район",ТекФорма.Район);
	СтруктураТекФорма.Вставить("ИмяРегиона",ТекФорма.ИмяРегиона);
	СтруктураТекФорма.Вставить("СметноНормативнаяБаза",ТекФорма.СметноНормативнаяБаза);
	СтруктураТекФорма.Вставить("IndexesLinkMode",ТекФорма.IndexesLinkMode);
	СтруктураТекФорма.Вставить("IndexesMode",ТекФорма.IndexesMode);
	СтруктураТекФорма.Вставить("ЗагрузкаДанных",ТекФорма.ЗагрузкаДанных);
	
	ТабСообщения = Новый ТаблицаЗначений;
	ТабСообщения.Колонки.Добавить("ТекстСообщения");
	
	ПараметрыЗадания = Новый Структура();
	ПараметрыЗадания.Вставить("СведенияФайлов",СведенияФайлов);
	ПараметрыЗадания.Вставить("ТекФорма",СтруктураТекФорма);
	ПараметрыЗадания.Вставить("ТабДокументов",ТабДокументов); 
	ПараметрыЗадания.Вставить("ТабИндексов",ТабИндексов); 
	ПараметрыЗадания.Вставить("ТабРазделов",ТабРазделов);  
	ПараметрыЗадания.Вставить("ТабПозицийЛС",ТабПозицийЛС);  
	ПараметрыЗадания.Вставить("ТабРесурсов",ТабРесурсов);  
	ПараметрыЗадания.Вставить("ТабЛимЗатраты",ТабЛимЗатраты);  
	ПараметрыЗадания.Вставить("ТабВидовРабот",ТабВидовРабот); 
	ПараметрыЗадания.Вставить("ТабПоправки",ТабПоправки); 
	ПараметрыЗадания.Вставить("ТабРаботы",ТабРаботы); 
	ПараметрыЗадания.Вставить("ТабСообщения",ТабСообщения);
	ПараметрыЗадания.Вставить("ТабПодписи",ТабПодписи); 
	
	Для Каждого ТекФайл Из СведенияФайлов Цикл
		Запись = РегистрыСведений.СМ_Файлы.СоздатьМенеджерЗаписи();
		Запись.ИмяФайла = ТекФайл.Загрузка_ПолныйПуть;
		Запись.Файл = Новый ХранилищеЗначения(ПолучитьИЗВременногоХранилища(ТекФайл.Загрузка_АдресВременногоХранилища));
		Запись.Записать();
	КонецЦикла;

	Если ТекФорма.ЗагрузкаДанных Тогда
		Попытка
			Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(Новый УникальныйИдентификатор,"Обработки.СМ_ОбменДаннымиВФорматеГрандСмета.ЗагрузитьГрандСмета",ПараметрыЗадания,НСтр("ru = 'Загрузка Гранд Смета'"));
		Исключение
			ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Событие = НСтр("ru = 'Загрузка Гранд Смета'");
			ЗаписьЖурналаРегистрации(Событие,УровеньЖурналаРегистрации.Ошибка,,,ПредставлениеОшибки);
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

