					НомерГлавы = 0;
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Glava" Тогда
							НомерГлавы = Значение;
						КонецЕсли;
						
					КонецЦикла;
					
					// Лимитированные затраты.
				ИначеЕсли ИмяУзла = "AddZatr" Тогда
					
					СтрокаЛЗ 		= ТабЛимЗатраты.Добавить();
					Если ИмяУзлаРодителя = "ImplemAct" Тогда
						СтрокаЛЗ.ИДсметы = СтрокаЛС.ИДсметы;
						СтрокаЛЗ.ИДакта = СтрокаАкт.ИДакта;
						СтрокаЛЗ.Акт = Истина;
					Иначе
						СтрокаЛЗ.ИДсметы = СтрокаЛС.ИДсметы;
						СтрокаЛЗ.Акт = Ложь;
					КонецЕсли;
					СтрокаЛЗ.Глава 	= НомерГлавы; 
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Caption" Тогда
							СтрокаЛЗ.Наименование = Значение;	
						ИначеЕсли ИмяПараметра = "Value" Тогда
							СтрокаЛЗ.Значение =	Значение;
						ИначеЕсли ИмяПараметра = "Options" Тогда
							СтрокаЛЗ.Опции = Значение;	
						ИначеЕсли ИмяПараметра = "Level" Тогда
							СтрокаЛЗ.Уровень = Значение; 
						КонецЕсли;
						
					КонецЦикла;
					
					// Поиск ссылки на лим. затрату в регистрах АРПС.
					ТекСсылкаЛЗ = ОпределитьЛимЗатрату(СметнаяПрограмма,СтрокаЛЗ);
					Если ЗначениеЗаполнено(ТекСсылкаЛЗ) Тогда
						СтрокаЛЗ.СсылкаВБазе = ТекСсылкаЛЗ;
					Иначе
						СтрокаСоответсвия 						= Форма.СоответствияЛЗ.Добавить();
						СтрокаСоответсвия.НаименованиеЛЗ		= СтрокаЛЗ.Наименование;
						СтрокаСоответсвия.СметнаяПрограмма      = СметнаяПрограмма;
						СтрокаСоответсвия.НеЯвляетсяЛЗ			= СтрокаЛЗ.НеЯвляетсяЛЗ;
					КонецЕсли;
					
					// Информация какая-то, непонятно пока.
				ИначеЕсли ИмяУзла = "OsInfo" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "OSChapter" Тогда
						ИначеЕсли ИмяПараметра = "LinkType" Тогда
						КонецЕсли;
						
					КонецЦикла;
					
					// Информация какая-то, непонятно пока.	
				ИначеЕсли ИмяУзла = "CCChapter" Тогда
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Cons" Тогда
						ИначеЕсли ИмяПараметра = "Rec" Тогда
						ИначеЕсли ИмяПараметра = "Road" Тогда
						КонецЕсли;
						
					КонецЦикла;
					
					// Подписи.
				ИначеЕсли ИмяУзла = "GsDocSignatures" Тогда
					
					ИмяУзлаРодителя = ИмяУзла;
					
					// Строка подписи.	
				ИначеЕсли ИмяУзла = "Item" И (ИмяУзлаРодителя = "GsDocSignatures" ИЛИ ИмяУзлаРодителя = "GsDocSignaturesImplemAct") Тогда
					
					СтрокаПодпись = ТабПодписи.Добавить();
					
					Если ИмяУзлаРодителя = "GsDocSignaturesImplemAct" Тогда
						СтрокаПодпись.ИДсметы 	= СтрокаЛС.ИДсметы;
						СтрокаПодпись.ИДакта 	= СтрокаАкт.ИДакта;
						СтрокаПодпись.Акт = Истина;
					Иначе
						СтрокаПодпись.ИДсметы = СтрокаЛС.ИДсметы;
						СтрокаПодпись.Акт = Ложь;
					КонецЕсли;
					
					Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
						
						ТипУзла 		= Чтение.ТипУзла; 
						ИмяПараметра 	= Чтение.Имя; 
						Значение 		= Чтение.Значение; 
						
						Если ИмяПараметра = "Caption" Тогда
							СтрокаПодпись.Статус = Значение;
						ИначеЕсли ИмяПараметра = "Value" Тогда
							СтрокаПодпись.ФИО = Значение;
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;	
				
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				Если ИмяУзла = "Position" ИЛИ ИмяУзла = "Tzr" 
					ИЛИ ИмяУзла = "Tzm" ИЛИ ИмяУзла = "Mch" ИЛИ ИмяУзла = "Mat"
					ИЛИ ИмяУзла = "Replaced" ИЛИ ИмяУзла = "DbInfo" ИЛИ ИмяУзла = "ImplemAct"
					ИЛИ ИмяУзла = "Implementation_V2" ИЛИ ИмяУзла = "Implementation_V2Position"
					ИЛИ ИмяУзла = "GsDocSignatures" ИЛИ ИмяУзла = "GsDocSignaturesImplemAct" Тогда 
					ИмяУзлаРодителя = "";	
					
					// ************************************
					// ++ AVV
					ИДАкта = "";
					// -- AVV
					// ************************************
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;	
	КонецЦикла;
	
	ЗаполнитьНастройкиПоУмолчанию(СведенияФайлов);
	
	СтруктураПараметровЗадания.ТекФорма			= Форма;
	СтруктураПараметровЗадания.ТабДокументов	= ТабДокументов; 
	СтруктураПараметровЗадания.ТабИндексов		= ТабИндексов;
	СтруктураПараметровЗадания.ТабРазделов		= ТабРазделов; 
	СтруктураПараметровЗадания.ТабПозицийЛС		= ТабПозицийЛС;
	СтруктураПараметровЗадания.ТабРесурсов		= ТабРесурсов; 
	СтруктураПараметровЗадания.ТабЛимЗатраты	= ТабЛимЗатраты; 	
	СтруктураПараметровЗадания.ТабВидовРабот	= ТабВидовРабот; 	
	СтруктураПараметровЗадания.ТабПоправки		= ТабПоправки; 
	СтруктураПараметровЗадания.ТабРаботы		= ТабРаботы; 
	СтруктураПараметровЗадания.ТабСообщения		= ТабСообщения;
	СтруктураПараметровЗадания.СведенияФайлов = СведенияФайлов;
	СтруктураПараметровЗадания.ТабПодписи       = ТабПодписи;
	ПоместитьВоВременноеХранилище(СтруктураПараметровЗадания,АдресХранилища); 
	
КонецПроцедуры

Процедура ЗаполнитьНастройкиПоУмолчанию(СведенияФайлов)
	Для Каждого стр Из СведенияФайлов Цикл
		Если Не ЗначениеЗаполнено(стр.Стройка) Тогда
			стр.Стройка = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнаяСтройка");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(стр.Район) Тогда
			стр.Район = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(стр.Стройка,"ОсновнойРайон");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(стр.ТипРайона) Тогда
			стр.ТипРайона = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(стр.Стройка,"ТипРайона");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(стр.ТипСтроительства) Тогда
			стр.ТипСтроительства = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(стр.Стройка,"ОсновнойТипСтроительства");
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(стр.ВариантПересчетаЭММ) Тогда
			стр.ВариантПересчетаЭММ = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(стр.Стройка,"ВариантПересчетаЭММ");
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура НайтиТерриториальныйРайон(Форма,КодЗоны1,КодЗоны2)
	
	ТекРайон = Справочники.СМ_ТерриториальныеРайоны.НайтиПоКоду(КодЗоны1);
	Если ТекРайон = Справочники.СМ_ТерриториальныеРайоны.ПустаяСсылка() Тогда
		ТекРайон = Справочники.СМ_ТерриториальныеРайоны.НайтиПоКоду(КодЗоны2);
	КонецЕсли;
	
	Если ТекРайон = Справочники.СМ_ТерриториальныеРайоны.ПустаяСсылка() Тогда
		Форма.СметноНормативнаяБаза = Справочники.СМ_СметноНормативныеБазы.ПустаяСсылка();		
	Иначе
		Форма.Район 				= ТекРайон;
		Форма.СметноНормативнаяБаза = Справочники.СМ_СметноНормативныеБазы.ПолучитьПоРайону(ТекРайон);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьПараметрыСтроительства(Форма,ТекНаименование,ТабСообщения)
	ТекНаименование = ВРег(ТекНаименование);
	Если ТекНаименование =  ВРег(НСтр("ru='Ремонт жил Основной'")) ИЛИ ТекНаименование =  ВРег(НСтр("ru='Ремонт жил Основной с обоснованием'")) Тогда
		Форма.ТипСтроительства 			= Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт;
		Форма.ТипРайона		 			= Перечисления.СМ_ТипыРайонов.НеОтносится;
		Форма.ПрименятьКоэффициентыНРСП  = Перечисления.СМ_НРИСПДляСметыНаРемонт.ПрименятьНРиСП;
	ИначеЕсли ТекНаименование =  ВРег(НСтр("ru='Ремонт жил Районы приравненные к Крайнему Северу'")) ИЛИ ТекНаименование =  ВРег(НСтр("ru='Ремонт жил Районы приравненные к Крайнему Северу с обоснованием'")) Тогда
		Форма.ТипСтроительства 			= Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт;
		Форма.ТипРайона		 			= Перечисления.СМ_ТипыРайонов.Приравнен;
		Форма.ПрименятьКоэффициентыНРСП	= Перечисления.СМ_НРИСПДляСметыНаРемонт.ПрименятьНРиСП;
	ИначеЕсли ТекНаименование =  ВРег(НСтр("ru='Ремонт нежил Районы приравненные к Крайнему Северу'")) ИЛИ ТекНаименование =  ВРег(НСтр("ru='Ремонт нежил Районы приравненные к Крайнему Северу с обоснованием'")) Тогда 
		Форма.ТипСтроительства 			= Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт;
		Форма.ТипРайона		 			= Перечисления.СМ_ТипыРайонов.Приравнен;
		Форма.ПрименятьКоэффициентыНРСП   = Перечисления.СМ_НРИСПДляСметыНаРемонт.ТолькоСП;
	ИначеЕсли ТекНаименование =  ВРег(НСтр("ru='Основной справочник видов работ'")) ИЛИ ТекНаименование =  ВРег(НСтр("ru='Основной с обоснованием'")) Тогда
		Форма.ТипСтроительства 			= Перечисления.СМ_ТипыСтроительства.НовоеСтроительство;
		Форма.ТипРайона		 			= Перечисления.СМ_ТипыРайонов.НеОтносится;
	ИначеЕсли ТекНаименование =  ВРег(НСтр("ru='Районы приравненные к Крайнему Северу'")) Тогда
		Форма.ТипСтроительства 			= Перечисления.СМ_ТипыСтроительства.НовоеСтроительство;
		Форма.ТипРайона		 			= Перечисления.СМ_ТипыРайонов.Приравнен;
	ИначеЕсли ТекНаименование =  ВРег(НСтр("ru='Районы Крайнего Севера'")) Тогда
		Форма.ТипСтроительства 			= Перечисления.СМ_ТипыСтроительства.НовоеСтроительство;
		Форма.ТипРайона		 			= Перечисления.СМ_ТипыРайонов.Относится;
	Иначе	
		Форма.ТипРайона = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(Форма.Стройка,"ТипРайона");
		Форма.ТипСтроительства = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(Форма.Стройка,"ОсновнойТипСтроительства");
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьПараметрыРесурса(СтрокаРесурса,ТабСообщения,Учтенный = Ложь)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ВидРесурса");
	СтруктураВозврата.Вставить("ТипМатериала");
	
	ПозицияNotCount = Найти(СтрокаРесурса.Options,"NotCount");
	ПозицияSnipSet	= Найти(СтрокаРесурса.Атрибуты,"SnipSet");
	ВидРесурса 		= СтрокаРесурса.ВидРесурса;
	
	Если ВидРесурса = "Tzr" Тогда
		СтруктураВозврата.ВидРесурса 	= Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;
		СтруктураВозврата.ТипМатериала 	= Перечисления.СМ_ТипыМатериалов.Учтенный;
	ИначеЕсли ВидРесурса = "Tzm" Тогда
		СтруктураВозврата.ВидРесурса 	= Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов;
		Если ПозицияSnipSet > 0 Тогда
			СтруктураВозврата.ТипМатериала 	= Перечисления.СМ_ТипыМатериалов.Учтенный;
		Иначе	
			СтруктураВозврата.ТипМатериала 	= Перечисления.СМ_ТипыМатериалов.НеУчтенный;
		КонецЕсли;
	ИначеЕсли ВидРесурса = "Mch" Тогда
		СтруктураВозврата.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы; 	
		Если ПозицияNotCount > 0 Тогда
			Если ЗначениеЗаполнено(СтрокаРесурса.НормаРасхода) Тогда
				СтруктураВозврата.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный;
			Иначе
				СтруктураВозврата.ТипМатериала 	= Перечисления.СМ_ТипыМатериалов.Учтенный;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаРесурса.Options) Тогда
			СтруктураВозврата.ТипМатериала 	= Перечисления.СМ_ТипыМатериалов.Учтенный;
		КонецЕсли;
	ИначеЕсли ВидРесурса = "Mat" Тогда
		СтруктураВозврата.ВидРесурса 	= Перечисления.СМ_ВидыРесурсов.Материалы;	
		Если ПозицияNotCount > 0 Тогда
			Если ЗначениеЗаполнено(СтрокаРесурса.НормаРасхода) Тогда
				СтруктураВозврата.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный;
			Иначе
				СтруктураВозврата.ТипМатериала 	= Перечисления.СМ_ТипыМатериалов.Учтенный;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаРесурса.Options) Тогда
			СтруктураВозврата.ТипМатериала 	= Перечисления.СМ_ТипыМатериалов.Учтенный;
		КонецЕсли;
	Иначе
		СтрокаСообщения 				= ТабСообщения.Добавить();
		СтрокаСообщения.ТекстСообщения 	= НСтр("ru='Не определены параметры ресурса'")+" " + ВидРесурса; 
		Возврат Неопределено;
	КонецЕсли;	
	
	Если Учтенный Тогда
		СтруктураВозврата.ТипМатериала 	= Перечисления.СМ_ТипыМатериалов.Учтенный;
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция НайтиРесурсПоНаименованиюИВиду(Наименование,ВидРесурса,ЕдиницаИзмерения)
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "ВЫБРАТЬ
	|	СМ_Ресурсы.Ссылка,
	|	СМ_Ресурсы.Наименование,
	|	СМ_Ресурсы.ВидРесурса
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК СМ_Ресурсы
	|ГДЕ
	|	СМ_Ресурсы.Наименование = &Наименование
	|	И СМ_Ресурсы.ВидРесурса = &ВидРесурса
	|	И СМ_Ресурсы.ЕдиницаИзмерения = &ЕдиницаИзмерения";
	
	Запрос.УстановитьПараметр("Наименование",Наименование);
	Запрос.УстановитьПараметр("ВидРесурса",ВидРесурса);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения",ЕдиницаИзмерения);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	Если ТабРезультат.Количество() > 0 Тогда
		Возврат ТабРезультат[0].Ссылка;		
	Иначе
		Возврат Справочники.СМ_Ресурсы.ПустаяСсылка();	
	КонецЕсли;
	
КонецФункции

Функция НайтиРесурс(СметнаяПрограмма,СтрокаРесурса,ТабСообщения)
	
	// Поиск соответствия в регистре АРПС по коду.
	// Замена кода ресурса в таблице.
	// Заполнение ссылки на элемент в справочнике 1С.
	СтрокаРесурса.НеОтбрасыватьПрефикс = Ложь;
	СтрокаРесурса.СоздаватьЗаписиВСправочнике = Ложь;
	
	ТекСсылкаРесурс = Неопределено;
	НужнаяСтрока = Неопределено;
	ПрефиксыПрограммы = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксы(СметнаяПрограмма);
	Если ПрефиксыПрограммы<>Неопределено И ПрефиксыПрограммы.Количество()>0 Тогда
		НужнаяСтрока = СМ_АРПС_ОбменВызовСервера.НайтиСтрокуПоПрефиксу(СтрокаРесурса.КодРесурса,ПрефиксыПрограммы);
		Если НЕ НужнаяСтрока = Неопределено Тогда
			СтрокаРесурса.НеОтбрасыватьПрефикс = НужнаяСтрока.НеОтбрасыватьПрефикс;
			СтрокаРесурса.СоздаватьЗаписиВСправочнике = НужнаяСтрока.СоздаватьЗаписиВСправочнике;
			СтрокаРесурса.КодРесурса = ?(НужнаяСтрока.НеОтбрасыватьПрефикс,СтрокаРесурса.КодРесурса,НужнаяСтрока.ШифрБезПрефикса);
			ВидРесурса = ?(ЗначениеЗаполнено(НужнаяСтрока.ВидРесурса),НужнаяСтрока.ВидРесурса,Неопределено);
			ТекСсылкаРесурс = СМ_АРПС_ОбменВызовСервера.НайтиРесурсАРПС(СметнаяПрограмма,СтрокаРесурса);
		КонецЕсли;
	КонецЕсли;

	Если ТекСсылкаРесурс = Неопределено Тогда
		// Поиск по коду ресурса
		НайденныйРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду(СтрокаРесурса.КодРесурса);	
		Если НайденныйРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда	
			// Поиск по наименованию и виду ресурса
			СтруктураРесурса = ОпределитьПараметрыРесурса(СтрокаРесурса,ТабСообщения,Ложь);
			ВидРесурса 		 = СтруктураРесурса.ВидРесурса;
			Если ЗначениеЗаполнено(СтрокаРесурса.ЕдиницаИзмерения) Тогда
				ЕдИзм =  СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(СтрокаРесурса.ЕдиницаИзмерения);
			Иначе
				ЕдИзм =  Справочники.СМ_ЕдиницыИзмеренияСмета.ПустаяСсылка();
			КонецЕсли;
			ТекСсылкаРесурс  = НайтиРесурсПоНаименованиюИВиду(СтрокаРесурса.Наименование,ВидРесурса,ЕдИзм);
		Иначе
			ТекСсылкаРесурс  = НайденныйРесурс;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекСсылкаРесурс;
	
КонецФункции

Функция ОпределитьЛимЗатрату(СметнаяПрограмма,СтрокаЛЗ)
	
	// Поиск ссылки на лим. затрату в регистрах АРПС
	ПропуститьСроку = СМ_АРПС_ОбменВызовСервера.ПолучитьПропускаемуюЛимЗатрату(СокрЛП(СтрокаЛЗ.Наименование)); 
	Если ПропуститьСроку Тогда
		СтрокаЛЗ.НеЯвляетсяЛЗ = Истина; 
	Иначе
		СтрокаЛЗ.НеЯвляетсяЛЗ = Ложь; 
		ТекЛимЗатрата = СМ_АРПС_ОбменВызовСервера.ПолучитьЛимЗатрату(СметнаяПрограмма,СокрЛП(СтрокаЛЗ.Наименование));
		Если НЕ ЗначениеЗаполнено(ТекЛимЗатрата) Тогда
			ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоНаименованию(СтрокаЛЗ.Наименование);	
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекЛимЗатрата;
	
КонецФункции

// ******************************************
// Формирование документов. 

Процедура СформироватьДокументыГранСмета(СтруктураПараметровЗадания,АдресХранилища) Экспорт
	
	Форма 			= СтруктураПараметровЗадания.ТекФорма;
	ТабДокументов 	= СтруктураПараметровЗадания.ТабДокументов;
	ТабИндексов		= СтруктураПараметровЗадания.ТабИндексов; 
	ТабРазделов 	= СтруктураПараметровЗадания.ТабРазделов;
	ТабПозицийЛС	= СтруктураПараметровЗадания.ТабПозицийЛС;
	ТабРесурсов 	= СтруктураПараметровЗадания.ТабРесурсов;
	ТабЛимЗатраты 	= СтруктураПараметровЗадания.ТабЛимЗатраты;
	ТабВидовРабот 	= СтруктураПараметровЗадания.ТабВидовРабот;
	ТабПоправки 	= СтруктураПараметровЗадания.ТабПоправки;
	ТабРаботы 		= СтруктураПараметровЗадания.ТабРаботы;
	ТабСообщения 	= СтруктураПараметровЗадания.ТабСообщения;
	ТабФайлов       = СтруктураПараметровЗадания.ТабФайлов;
	ТабПодписи      = СтруктураПараметровЗадания.ТабПодписи;
	
	ТабСоответствияПрефиксов	= СтруктураПараметровЗадания.ТабСоответствияПрефиксов;
	ТабСоответствияРесурсов		= СтруктураПараметровЗадания.ТабСоответствияРесурсов;
	ТабСоответствияЛЗ			= СтруктураПараметровЗадания.ТабСоответствияЛЗ;
	
	НачатьТранзакцию();
	
	Для Каждого СтрФайла Из ТабФайлов Цикл
		ИДсметы = СтрФайла.Загрузка_ИмяФайла;
		СтруктураОтбора = Новый Структура("ИДсметы,Акт",ИДсметы,Ложь);
		МассивДокументов =  ТабДокументов.НайтиСтроки(СтруктураОтбора);
		Для Каждого ТекСтрока Из МассивДокументов Цикл
			СсылкаНового = Документы.СМ_ЛокальнаяСмета.ПолучитьСсылку();
			НовДок = Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
			НовДок.УстановитьСсылкуНового(СсылкаНового);
			НовДок.Дата 						= Форма.ДатаСметы;
			НовДок.Наименование 				= СтрФайла.НаименованиеСметы;
			НовДок.НомерСметы 					= СтрФайла.НомерСметы;
			НовДок.Организация                  = Форма.Организация; 
			НовДок.Заказчик                     = Форма.Заказчик;
			НовДок.Стройка                      = СтрФайла.Стройка;
			НовДок.Район                 		= СтрФайла.Район;
			НовДок.ПрименятьКоэффициентыНРСП    = СтрФайла.ПрименятьКоэффициентыНРСП;
			НовДок.РегионДляВыбораЦен           = СтрФайла.СметноНормативнаяБаза;
			НовДок.МетодикаРасчета				= Справочники.СМ_МетодикиРасчета.СМ_МетодикаМДС35;
			
			ЗаполнитьНастройкиПользователяПоУмолчанию(НовДок);
			
			Если ЗначениеЗаполнено(СтрФайла.ТипСтроительства) Тогда
				НовДок.ТипСтроительства = СтрФайла.ТипСтроительства;
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(СтрФайла.ТипРайона) Тогда
				НовДок.ТипРайона = СтрФайла.ТипРайона;
			КонецЕсли;
			
			СтруктураРасчета = ОпределитьПараметрыРасчетаЛС(СтрФайла);
			Если СтруктураРасчета <> Неопределено Тогда
				НовДок.Уровень              	= СтруктураРасчета.УровеньРасчетаИндексов;
				НовДок.МетодРасчета         	= СтруктураРасчета.МетодРасчета;
				НовДок.СпособРасчетаИндексов	= СтруктураРасчета.СпособРасчетаИндексов;
				// Пока не было таких индексов, нечего искать.
			Иначе
				СтрокаСообщения 				= ТабСообщения.Добавить();
				СтрокаСообщения.ТекстСообщения 	= НСтр("ru='Не удалось определить метод / способ / уровень расчета ЛС'"); 
			КонецЕсли;
			
			// Заполнение индексов.
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ИДсметы",ИДсметы);
			СтруктураОтбора.Вставить("УровеньДокумента",Истина);
			МассивСтрок = ТабИндексов.НайтиСтроки(СтруктураОтбора);
			Для Каждого ТекСтрокаИндекса Из МассивСтрок Цикл
				ПозицияСМР = Найти(ТекСтрокаИндекса.Caption,"Ксмр");
				ПозицияКЭМ = Найти(ТекСтрокаИндекса.Caption,"Кэм");
				Если ПозицияСМР > 0 Тогда
					НовДок.КоэффПолнСтоимРабот = ТекСтрокаИндекса.Formula;
				КонецЕсли;
				Если ПозицияКЭМ > 0 Тогда
					НовДок.КоэффСтоимЭксплМашин = ТекСтрокаИндекса.Formula;
				КонецЕсли;
			КонецЦикла;
			
			// Создание лимитированных затрат.
			СтруктураОтбора 	= Новый Структура("ИДсметы,Акт",ИДсметы,Ложь);
			МассивЛимЗатраты 	= ТабЛимЗатраты.НайтиСтроки(СтруктураОтбора);
			
			Для Каждого ТекСтрокаЛЗ Из МассивЛимЗатраты Цикл 
				Если ТекСтрокаЛЗ.НеЯвляетсяЛЗ Тогда
					Продолжить;
				КонецЕсли;
				ПолучитьСоздатьЛимЗатрата(Форма,ТекСтрокаЛЗ,НовДок,ТабСообщения);
			КонецЦикла;
			
			Попытка
				Если Не ЗначениеЗаполнено(НовДок.ДатаТекущихЦен) Тогда
					НовДок.ДатаТекущихЦен = ТекущаяДатаСеанса();
				КонецЕсли;
				НовДок.Записать();
				СтрокаСообщения 				= ТабСообщения.Добавить();
				СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ локальная смета: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование); 
			Исключение
				СтрокаСообщения 				= ТабСообщения.Добавить();
				СтрокаСообщения.ТекстСообщения 	= НСтр("ru='Локальная смета не записана:'")+" " + ОписаниеОшибки();
			КонецПопытки;
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ИДсметы",ИДсметы);
			МассивРазделов =  ТабРазделов.НайтиСтроки(СтруктураОтбора);
			
			СтруктураОтбора.Вставить("УровеньДокумента",Ложь);
			МассивИндексов =  ТабИндексов.НайтиСтроки(СтруктураОтбора);
			
			ОтборИндексов = ТабИндексов.Скопировать(МассивИндексов);
			
			СформироватьРазделыЛС(НовДок.Ссылка,МассивРазделов,ОтборИндексов,ТабСообщения);
			СформироватьПозицииЛС(НовДок.Ссылка,СтруктураПараметровЗадания,ТабСообщения,Форма.ЗагружатьНРСП,ИДсметы);
			ЗаполнитьПодписи(НовДок,СтруктураПараметровЗадания,ТабСообщения,ИДсметы);
			
			Попытка
				СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(НовДок);
				НовДок.Записать(РежимЗаписиДокумента.Проведение);
				// Документы.СМ_ЛокальнаяСмета.Перерасчет(НовДок.Ссылка,Ложь);
			Исключение
				СтрокаСообщения 				= ТабСообщения.Добавить();
				СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование);
			КонецПопытки;
			СтрФайла.Загрузка_СозданныйДокумент = СсылкаНового;
			
			// Формирование актов.
			СтруктураОтбора 	= Новый Структура("SysID,Акт",ИДсметы,Истина);
			МассивДокументов 	= ТабДокументов.НайтиСтроки(СтруктураОтбора);
			ЕстьАкт 			= Ложь;
			Смета 				= НовДок;
			
			Если МассивДокументов.Количество()>0 Тогда
				РазделыСметы = ПолучитьРазделы(СтрФайла.Загрузка_СозданныйДокумент);
			КонецЕсли;	
			
			ДатаАкта = СтрФайла.Загрузка_СозданныйДокумент.Дата;
			Для Каждого ТекСтрока Из МассивДокументов Цикл
				ДатаАкта = ДатаАкта+1;
				НовДок 								= Документы.СМ_АктВыполненныхРабот.СоздатьДокумент();
				ПараметрыАкта = Новый Структура("ЛокальнаяСмета",СтрФайла.Загрузка_СозданныйДокумент);
				СМ_СметаВызовСервера.ЗаполнитьАктПоСмете(ПараметрыАкта,НовДок);
				НовДок.Дата 						= ДатаАкта;
				НовДок.НомерАкта 					= ТекСтрока.НомерАкта;
				НовДок.ПериодОт                     = ТекСтрока.ПериодОт;
				НовДок.ПериодДо                     = ТекСтрока.ПериодДо;
				
				// Создание лимитированных затрат.
				СтруктураОтбора 	= Новый Структура("ИДсметы,ИДакта,Акт",ИДсметы,ТекСтрока.ИДакта,Истина);
				МассивЛимЗатраты 	= ТабЛимЗатраты.НайтиСтроки(СтруктураОтбора);
				Для Каждого ТекСтрокаЛЗ Из МассивЛимЗатраты Цикл 
					Если ТекСтрокаЛЗ.НеЯвляетсяЛЗ Тогда
						Продолжить;
					КонецЕсли;
					ПолучитьСоздатьЛимЗатрата(Форма,ТекСтрокаЛЗ,НовДок,ТабСообщения);
				КонецЦикла;
				
				Для Каждого СтрРаздел Из РазделыСметы Цикл
					СтрРазделАкт 		= НовДок.Разделы.Добавить();
					СтрРазделАкт.Раздел = СтрРаздел.Ссылка;
				КонецЦикла;
				
				// Позиции акта.
				СтруктураОтбора = Новый Структура("ИДсметы,ИДакта,Акт",ИДсметы,ТекСтрока.ИДакта,Истина);
				МассивПозиций 	= ТабПозицийЛС.НайтиСтроки(СтруктураОтбора);
				Для Каждого СтрПозиции Из МассивПозиций Цикл
					
					СтруктураОтбора 	= Новый Структура("ИДсметы,SysID,Акт",ИДсметы,СтрПозиции.SysID,Ложь);
					МассивПозицийСметы 	= ТабПозицийЛС.НайтиСтроки(СтруктураОтбора);
					Если МассивПозицийСметы.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
					
					СтрПозицияАкт 			= НовДок.Позиции.Добавить();
					СтрПозицияАкт.Позиция 	= МассивПозицийСметы[0].ПозицияСсылка;
					// СтрПозицияАкт.ФактОбъем 		= СтрПозиции.ОбъемРабот;
					// СтрПозицияАкт.ФормулаОбъема 	= СтрПозиции.Fx;
					
					Если СтрПозиции.Result=Неопределено Тогда
						ФормулаОбъема 	= СтрПозиции.ОбъемРабот;
						ФормулаОбъема 	= СтрЗаменить(ФормулаОбъема,",",".");
						ОбъемРабот 		= 0;
						Формула 		= "ОбъемРабот = Значение";
						Формула 		= СтрЗаменить(Формула,"Значение", ФормулаОбъема);
						Попытка
							Выполнить(Формула);
						Исключение
							Событие = НСтр("ru = 'Исключение Гранд-смета'");
							СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
						КонецПопытки;
						СтрПозицияАкт.ФактОбъем = ОбъемРабот;
					Иначе
						СтрПозицияАкт.ФактОбъем	= ПреобразоватьВЧисло(СтрПозиции.Result);
					КонецЕсли;
					СтрПозицияАкт.ФормулаОбъема = ?(СтрПозиции.Fx=Неопределено,СтрПозиции.ОбъемРабот,СтрПозиции.Fx);

					// Ресурсы акта.				
					СтруктураОтбора = Новый Структура("ИдПозиции,ИДакта,Акт,",СтрПозиции.SysID,ТекСтрока.ИДакта,Истина);
					МассивРесурсов 	= ТабРесурсов.НайтиСтроки(СтруктураОтбора);
					Для Каждого СтрРесурс Из МассивРесурсов Цикл
											
						СтруктураОтбора 	= Новый Структура("ИдПозиции,КодРесурса,Акт",СтрПозиции.SysID,СтрРесурс.КодРесурса,Ложь);
						МассивРесурсовСмета = ТабРесурсов.НайтиСтроки(СтруктураОтбора);
						Если МассивРесурсовСмета.Количество()=0 Тогда
							Продолжить;
						КонецЕсли;
						
						Учтенный 			= (СтрПозицияАкт.Позиция.ИдСметы.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный);
						СтруктураРесурса 	= ОпределитьПараметрыРесурса(МассивРесурсовСмета[0],ТабСообщения,Учтенный);
						ВидРесурса 			= СтруктураРесурса.ВидРесурса;
						ТипМатериала		= СтруктураРесурса.ТипМатериала;
						
						СтрРесурсАкт 								= НовДок.РесурсыПозицийАкта.Добавить();
						СтрРесурсАкт.Позиция 						= СтрПозицияАкт.Позиция;
						СтрРесурсАкт.Ресурс 						= МассивРесурсовСмета[0].СсылкаВБазе;
						СтрРесурсАкт.СметныйКодРесурса				= ?(ЗначениеЗаполнено(СтрРесурсАкт.Ресурс),СтрРесурсАкт.Ресурс.Код,СтрРесурс.КодРесурса);
						СтрРесурсАкт.ВидРесурса						= ВидРесурса;
						СтрРесурсАкт.НормаРасходаОбъем              = МассивРесурсовСмета[0].НормаРасхода;
						СтрРесурсАкт.ТипМатериала                  	= ТипМатериала;
						СтрРесурсАкт.БазиснаяЦена                   = МассивРесурсовСмета[0].Value;
						СтрРесурсАкт.БазиснаяЗарплатаМашинистов	  	= МассивРесурсовСмета[0].ЗарплатаМашинистов;
						СтрРесурсАкт.ТекущаяЦена                    = СтрРесурс.ValueТек;
						СтрРесурсАкт.ТекущаяЗарплатаМашинистов	  	= МассивРесурсовСмета[0].ТекущаяЗарплатаМашинистов;
						СтрРесурсАкт.НаименованиеРесурса 			= СтрРесурс.Наименование;
						СтрРесурсАкт.ЕдиницаИзмеренияРесурса 		= СтрРесурс.ЕдиницаИзмерения;

					КонецЦикла;

				КонецЦикла;

				ЗаполнитьПодписи(НовДок,СтруктураПараметровЗадания,ТабСообщения,ИДсметы,ТекСтрока.ИДакта,Истина);
				
				Попытка
					НовДок.Записать();
					СтрокаСообщения 				= ТабСообщения.Добавить();
					СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ акт: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, СтрФайла.Загрузка_СозданныйДокумент.Наименование); 
				Исключение
					СтрокаСообщения 				= ТабСообщения.Добавить();
					СтрокаСообщения.ТекстСообщения 	= НСтр("ru='Акт не записан:'")+" " + ОписаниеОшибки();
				КонецПопытки;

				Попытка
					НовДок.Записать(РежимЗаписиДокумента.Проведение);
					ЕстьАкт = Истина;
					// Документы.СМ_АктВыполненныхРабот.Перерасчет(НовДок.Ссылка,Ложь);
				Исключение
					СтрокаСообщения 				= ТабСообщения.Добавить();
					СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Акт не рассчитан: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, СтрФайла.Загрузка_СозданныйДокумент.Наименование);
				КонецПопытки;
			КонецЦикла;
			
			Если СМ_СметаВызовСервера.ЗначениеОпции("СМ_ИспользоватьСтатусыДокументов") И ЕстьАкт Тогда
				Смета.Статус = Перечисления.СМ_СтатусыСметныхДокументов.Согласован;
				Смета.Записать();
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;	
	
	ЕстьОшибки = Ложь;
	Для Каждого СтрокаСообщения Из ТабСообщения Цикл
		Если СтрНайти(СтрокаСообщения.ТекстСообщения, "Загрузка отменена") > 0 Тогда
			ЕстьОшибки = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		Для Каждого СтрФайла Из ТабФайлов Цикл
			СтрФайла.Загрузка_СозданныйДокумент = "";
		КонецЦикла;
		ОтменитьТранзакцию();
	Иначе
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(СтруктураПараметровЗадания,АдресХранилища); 
	
КонецПроцедуры	

Функция ПолучитьРазделы(Смета)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	РазделЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК РазделЛокальнойСметы
	               |ГДЕ
	               |	РазделЛокальнойСметы.ИДСметы = &Смета
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	РазделЛокальнойСметы.Номер";
	Запрос.УстановитьПараметр("Смета",Смета);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
				   
Процедура ЗаполнитьНастройкиПользователяПоУмолчанию(ТекОбъект) 
	
	Если НЕ ЗначениеЗаполнено(ТекОбъект.Стройка) Тогда
		ТекОбъект.Стройка = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнаяСтройка");	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекОбъект.РегионДляВыбораЦен) Тогда	
		ТекОбъект.РегионДляВыбораЦен = Справочники.СМ_СметноНормативныеБазы.ПолучитьПоРайону(ТекОбъект.Район);
	КонецЕсли;

	ТекОбъект.Подрядчик 				= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойПодрядчик");
	ТекОбъект.Инвестор 					= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойИнвестор");
	ТекОбъект.ТипРайона 				= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ТипРайона");
	ТекОбъект.ТипСтроительства 			= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойТипСтроительства");
	ТекОбъект.МетодРасчета 				= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОсновнойМетодСчета");
	ТекОбъект.Уровень 					= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"УровеньПримененияИндексов");
	ТекОбъект.ВариантПересчетаЭММ		= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ВариантПересчетаЭММ");
	ТекОбъект.ВариантРасчетаЗМ 			= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ВариантРасчетаЗМ");
	ТекОбъект.СпособРасчетаИндексов 	= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"СпособРасчетаИндексов");
	ТекОбъект.ОкруглятьДоРублей 		= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОкруглятьИтоговуюСтоимостьДоРублей");
	ТекОбъект.ОбрабатыватьПогрешность 	= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"ОбрабатыватьПогрешность");
	ТекОбъект.НеОкруглятьНДС 			= СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ТекОбъект.Стройка,"НеОкруглятьНДС");
	
КонецПроцедуры

Процедура СформироватьРазделыЛС(ТекСмета,ТабРазделов,ТабИндексов,ТабСообщения)
	
	ВерхнийРаздел = Неопределено;
	Для Каждого ТекСтрока Из ТабРазделов Цикл
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Code",ТекСтрока.IndexCode);
		МассивИндексов = ТабИндексов.НайтиСтроки(СтруктураОтбора);
		
		ТекРаздел 				= ПолучитьСоздатьДокументРаздел(ТекСтрока.НаименованиеРаздела,ТекСмета,МассивИндексов,ТабСообщения,?(ТекСтрока.Подраздел,ВерхнийРаздел,Неопределено));
		Если Не ТекСтрока.Подраздел Тогда
			ВерхнийРаздел = ТекРаздел;
		КонецЕсли;
		ТекущийРаздел 			= ТекРаздел; 
		ТекСтрока.РазделСсылка 	= ТекРаздел;  
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьПозицииЛС(ТекСмета,СтруктураПараметровЗадания,ТабСообщения,ЗагружатьНРСП,ИДсметы)
	
	СтруктураОтбора = Новый Структура("ИДсметы,Акт",ИДсметы,Ложь);
	МассивПозицийЛС =  СтруктураПараметровЗадания.ТабПозицийЛС.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из МассивПозицийЛС Цикл
		ПолучитьСоздатьДокументПозицияЛС(ТекСтрока,ТекСмета,СтруктураПараметровЗадания,ТабСообщения,ЗагружатьНРСП);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПодписи(ТекСмета,СтруктураПараметровЗадания,ТабСообщения,ИДсметы,ИДакта = "",Акт = Ложь)
	Если Акт Тогда
		СтруктураОтбора = Новый Структура("ИДсметы,ИДакта,Акт",ИДсметы,ИДакта,Акт);
	Иначе
		СтруктураОтбора = Новый Структура("ИДсметы,Акт",ИДсметы,Акт);
	КонецЕсли;
	МассивПодписи =  СтруктураПараметровЗадания.ТабПодписи.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из МассивПодписи Цикл
		НовСтрока = ТекСмета.Подписи.Добавить();
		НовСтрока.Статус = ТекСтрока.Статус;
		Физлицо = Справочники.ФизическиеЛица.НайтиПоНаименованию(ТекСтрока.ФИО,Истина);
		Если Физлицо.Пустая() Тогда
			Физлицо = Справочники.ФизическиеЛица.СоздатьЭлемент();
			Физлицо.Наименование = ТекСтрока.ФИО;
			Физлицо.ОбменДанными.Загрузка = Истина;
			Физлицо.Записать();
		КонецЕсли;
		НовСтрока.ФИО = Физлицо.Ссылка;
	КонецЦикла;
КонецПроцедуры

Функция ОпределитьПараметрыРасчетаЛС(Форма)
	
	// Метод расчета.
	// Уровень расчета индексов.
	// Способ расчета индексов. 
	// Вариант пересчета стоимости эксплуатации машин.
	
	// Параметр "IndexesLinkMode".
	// Default 	- привязка «По позициям сметы», т.е. индивидуальная.
	// Vrs 		- по видам работ.
	// Chapters - по разделам сметы.
	// OS 		- по графам объектной сметы.
	
	// Параметр "IndexesMode".
	// None 	- индексы в смете НЕ применяются.
	// PosOne 	- индексы по статьям затрат применяются В ПОЗИЦИИ сметы.
	// Total 	- индексы по статьям затрат применяются В ИТОГАХ сметы.
	// Smr 		- применять индексы к СМР.
	
	// 1. IndexesMode = "Smr", IndexesLinkMode	= "Chapters".
	// Базисно-индексный метод .
	// Уровень расчета индексов - раздел .
	// Способ расчета индексов - к полной стоимости.
	// Индексы храним в разделе?
	
	// 2. IndexesMode = "None", IndexesLinkMode="Default" и есть CommonIndexB, 
	// Базисно-индексный метод.
	// Уровень расчета индексов - смета.
	// Способ расчета индексов - к полной стоимости.
	// Индексы храним в смете.
	
	// 3. IndexesMode = "Total", IndexesLinkMode = "Default", 
	// Базисно-индексный метод,
	// Уровень расчета индексов - расценка, 
	// Способ расчета индексов - по элементам затрат.
	// Индексы храним в позициях?
	
	СтруктураРасчета = Новый Структура;
	СтруктураРасчета.Вставить("МетодРасчета");
	СтруктураРасчета.Вставить("УровеньРасчетаИндексов");
	СтруктураРасчета.Вставить("СпособРасчетаИндексов");
	
	Если Форма.IndexesLinkMode = "Chapters" Тогда
		Если Форма.IndexesMode = "None" Тогда
			СтруктураРасчета.МетодРасчета			= Перечисления.СМ_МетодыРасчетаЛС.Ресурсный;
			СтруктураРасчета.УровеньРасчетаИндексов	= Перечисления.СМ_УровеньЗаданияИндексов.ПустаяСсылка();
			СтруктураРасчета.СпособРасчетаИндексов	= Перечисления.СМ_СпособыРасчетаИндексов.ПустаяСсылка();
		ИначеЕсли Форма.IndexesMode = "Total" Тогда
			СтруктураРасчета.МетодРасчета			= Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
			СтруктураРасчета.УровеньРасчетаИндексов	= Перечисления.СМ_УровеньЗаданияИндексов.Раздел;
			СтруктураРасчета.СпособРасчетаИндексов	= Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат;
		ИначеЕсли Форма.IndexesMode = "PosOne" Тогда
			СтруктураРасчета.МетодРасчета			= Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
			СтруктураРасчета.УровеньРасчетаИндексов	= Перечисления.СМ_УровеньЗаданияИндексов.Раздел;
			СтруктураРасчета.СпособРасчетаИндексов	= Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат;
		ИначеЕсли Форма.IndexesMode = "Smr" Тогда
			СтруктураРасчета.МетодРасчета			= Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
			СтруктураРасчета.УровеньРасчетаИндексов	= Перечисления.СМ_УровеньЗаданияИндексов.Раздел;
			СтруктураРасчета.СпособРасчетаИндексов	= Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли Форма.IndexesLinkMode = "Default" Тогда
		
		Если Форма.IndexesMode = "None" Тогда
			СтруктураРасчета.МетодРасчета			= Перечисления.СМ_МетодыРасчетаЛС.Ресурсный;
			СтруктураРасчета.УровеньРасчетаИндексов	= Перечисления.СМ_УровеньЗаданияИндексов.ПустаяСсылка();
			СтруктураРасчета.СпособРасчетаИндексов	= Перечисления.СМ_СпособыРасчетаИндексов.ПустаяСсылка();
		ИначеЕсли Форма.IndexesMode = "Total" Тогда
			СтруктураРасчета.МетодРасчета			= Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
			СтруктураРасчета.УровеньРасчетаИндексов	= Перечисления.СМ_УровеньЗаданияИндексов.Смета;
			СтруктураРасчета.СпособРасчетаИндексов	= Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат;
		ИначеЕсли Форма.IndexesMode = "PosOne" Тогда
			СтруктураРасчета.МетодРасчета			= Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
			СтруктураРасчета.УровеньРасчетаИндексов	= Перечисления.СМ_УровеньЗаданияИндексов.Расценка;
			СтруктураРасчета.СпособРасчетаИндексов	= Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат;
		ИначеЕсли Форма.IndexesMode = "Smr" Тогда
			СтруктураРасчета.МетодРасчета			= Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный;
			СтруктураРасчета.УровеньРасчетаИндексов	= Перечисления.СМ_УровеньЗаданияИндексов.Смета;
			СтруктураРасчета.СпособРасчетаИндексов	= Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	
	
	Возврат СтруктураРасчета;
	
КонецФункции

Процедура ПолучитьСоздатьЛимЗатрата(Форма,ТекСтрока,ТекСмета,ТабСообщения)
	
	ТекЛимЗатрата = ТекСтрока.СсылкаВБазе;
	Если ТекСтрока.НеЯвляетсяЛЗ Тогда
		Возврат;
	КонецЕсли;
	
	// Поиск заданного пользователем соответствия ЛЗ.
	Если Не ЗначениеЗаполнено(ТекЛимЗатрата) Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("НаименованиеЛЗ",ТекСтрока.Наименование);
		МассивСтрок = Форма.СоответствияЛЗ.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 Тогда
			ТекЛимЗатрата = МассивСтрок[0].СсылкаВБазе;
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекЛимЗатрата) Тогда
		НоваяСтрока 								= ТекСмета.ЛимитированныеЗатраты.Добавить();
		НоваяСтрока.ЛимитированнаяЗатрата           = ТекЛимЗатрата;
		НоваяСтрока.КоэффициентСметнойЗарплаты 	    = ТекЛимЗатрата.КоэффициентСметнойЗарплаты;
		НоваяСтрока.КоэффициентТрудоемкости     	= ТекЛимЗатрата.КоэффициентТрудоемкости;
		НоваяСтрока.Примечание                      = ТекЛимЗатрата.Обоснование;
		НоваяСтрока.Расчет 							= Истина;
		НоваяСтрока.ЗначениеЛимЗатраты				= ТекСтрока.Значение; 
	Иначе
		СтрокаСообщения 				= ТабСообщения.Добавить();
		СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Лимитированная затрата: %1 не найдено соответствие.'"), ТекСтрока.Наименование);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСоздатьДокументРаздел(ТекНаименованиеРаздела,ТекСмета,ТабИндексов,ТабСообщения,ВерхнийРаздел = Неопределено)
	
	//// Поиск / создание элемента справочника "Разделы".
	//ТекСпрРаздел = Справочники.СМ_РазделыЛокальнойСметы.НайтиПоНаименованию(ТекНаименованиеРаздела,Истина);
	//Если ТекСпрРаздел = Справочники.СМ_РазделыЛокальнойСметы.ПустаяСсылка() Тогда
	//	ТекСпрРаздел 				= Справочники.СМ_РазделыЛокальнойСметы.СоздатьЭлемент();	
	//	ТекСпрРаздел.Наименование 	= ТекНаименованиеРаздела;
	//	ТекСпрРаздел.Записать();
	//	СтрокаСообщения 				= ТабСообщения.Добавить();
	//	СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый элемент справочника разделы: %1'"), ТекНаименованиеРаздела);
	//КонецЕсли;
	
	// Создание нового документа "Раздел ЛС". 
	НовДок							= СМ_СметаВызовСервера.СоздатьНовыйРаздел();
	НовДок.НаименованиеДляПечати 	= ТекНаименованиеРаздела;
	НовДок.Дата						= ТекущаяДатаСеанса();
	//НовДок.Раздел 					= ТекСпрРаздел.Ссылка; 
	НовДок.ИДРодителя   			= ?(ВерхнийРаздел = Неопределено,ТекСмета.Ссылка,ВерхнийРаздел);
	НовДок.ИДСметы      			= ТекСмета.Ссылка;
	НовДок.Расчет					= Истина;
	
	// Заполнение индексов.
	Индексы = ?(ТабИндексов.Количество()>0,ТабИндексов[0],Неопределено);
	Если Не Индексы = Неопределено Тогда
		НовДок.КоэффПолнСтоимРабот = Индексы.SMR;
		НовДок.КоэффОснЗарплаты = Индексы.OZ;
		НовДок.КоэффСтоимЭксплМашин = Индексы.EM;
		НовДок.КоэффСтоимЗарплатеМашин = Индексы.ZM;
		НовДок.КоэффСтоимМатериалов = Индексы.MT;
	КонецЕсли;
	
	Попытка
		НовДок.Записать();
		СтрокаСообщения 				= ТабСообщения.Добавить();
		СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ раздел: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, ТекНаименованиеРаздела); 
	Исключение
		СтрокаСообщения 				= ТабСообщения.Добавить();
		СтрокаСообщения.ТекстСообщения 	= НСтр("ru='Раздел не записан:'")+" " + ОписаниеОшибки();
	КонецПопытки;
	
	ТекРаздел = НовДок.Ссылка;
	Возврат ТекРаздел;
	
КонецФункции	

Функция ПолучитьСоздатьДокументПозицияЛС(ТекСтрока,ТекСмета,СтруктураПараметровЗадания,ТабСообщения,ЗагружатьНРСП)
	
	ТекФорма					= СтруктураПараметровЗадания.ТекФорма;
	ТабДокументов 				= СтруктураПараметровЗадания.ТабДокументов;
	ТабИндексов					= СтруктураПараметровЗадания.ТабИндексов; 
	ТабРазделов 				= СтруктураПараметровЗадания.ТабРазделов;
	ТабПозицийЛС				= СтруктураПараметровЗадания.ТабПозицийЛС;
	ТабРесурсов 				= СтруктураПараметровЗадания.ТабРесурсов;
	ТабЛимЗатраты 				= СтруктураПараметровЗадания.ТабЛимЗатраты;
	ТабВидовРабот 				= СтруктураПараметровЗадания.ТабВидовРабот;
	ТабПоправки 				= СтруктураПараметровЗадания.ТабПоправки;
	ТабРаботы 					= СтруктураПараметровЗадания.ТабРаботы;
	ТабЛимЗатраты				= СтруктураПараметровЗадания.ТабЛимЗатраты;
	ТабСоответствияПрефиксов	= СтруктураПараметровЗадания.ТабСоответствияПрефиксов;
	ТабСоответствияРесурсов		= СтруктураПараметровЗадания.ТабСоответствияРесурсов;
	ТабСоответствияЛЗ			= СтруктураПараметровЗадания.ТабСоответствияЛЗ;
	
	// Создание нового документа "ПозицияЛС".
	НовДок					= СМ_СметаВызовСервера.СоздатьНовуюПозицию();
	НовДок.Наименование 	= ТекСтрока.Наименование;
	НовДок.Дата				= ТекущаяДатаСеанса();
	НовДок.СпособСоздания	= Перечисления.СМ_ИсточникиДобавленияПозиций.Загружена;
	НовДок.ИсточникСоздания	= "Гранд Смета#XML";
	
	// Поиск раздела по ИД в таблице разделов
	Если ЗначениеЗаполнено(ТекСтрока.ИдРаздела) Тогда
		СтруктураОтбора = Новый Структура("SysID,ИДсметы",ТекСтрока.ИдРаздела,ТекСтрока.ИДсметы);
		МассивСтрок = ТабРазделов.НайтиСтроки(СтруктураОтбора);		
		Если МассивСтрок.Количество() > 0 Тогда
			ТекущийРаздел = МассивСтрок[0].РазделСсылка; 	
		Иначе
			СтрокаСообщения 				= ТабСообщения.Добавить();
			СтрокаСообщения.ТекстСообщения 	= НСтр("ru='Не найден раздел по ИД:'")+" " + ТекСтрока.ИдРаздела;			
		КонецЕсли;
	Иначе
		СтрокаСообщения 				= ТабСообщения.Добавить();
		СтрокаСообщения.ТекстСообщения 	= НСтр("ru='Не заполнено Ид раздела у позиции ЛС!'");			
	КонецЕсли;
	
	Если Врег(ТекСтрока.ItemFlags) = Врег("Red") Тогда
		НовДок.ОтмеченаВДереве = 5;
	ИначеЕсли Врег(ТекСтрока.ItemFlags) = Врег("Yellow") Тогда
		НовДок.ОтмеченаВДереве = 3;
	ИначеЕсли Врег(ТекСтрока.ItemFlags) = Врег("Green") Тогда
		НовДок.ОтмеченаВДереве = 4;
	ИначеЕсли Врег(ТекСтрока.ItemFlags) = Врег("Blue") Тогда
		НовДок.ОтмеченаВДереве = 2;
	ИначеЕсли Врег(ТекСтрока.ItemFlags) = Врег("Violet") Тогда
		НовДок.ОтмеченаВДереве = 6;
	КонецЕсли;	
	
	НовДок.Версия               = ?(ЗначениеЗаполнено(ТекСтрока.Версия),ТекСтрока.Версия,ТекСтрока.Comment);
	НовДок.ИДРодителя 			= ТекущийРаздел;
	НовДок.ИДСметы 				= ТекСмета;
	
	Опция = ?(ЗначениеЗаполнено(ТекСтрока.Options),Врег(ТекСтрока.Options),"");
	
	Расчет 				= ?(СтрНайти(Опция,Врег("Inactive"))=0,Истина,Ложь);
	РесурсЗаказчика 	= ?(СтрНайти(Опция,Врег("RETOWNMAT"))>0,Истина,Ложь);
	
	Если РесурсЗаказчика Тогда
		НовДок.СтатусРесурса = Перечисления.СМ_ОбеспечениеРесурса.Подрядчика;
		НовДок.СтоимМатериалов          = 0;
		НовДок.ВозвратМатер             = ПреобразоватьВЧисло(ТекСтрока.СтоимостьМатериалов);
	Иначе
		НовДок.СтоимМатериалов          = ПреобразоватьВЧисло(ТекСтрока.СтоимостьМатериалов);
		НовДок.ВозвратМатер             = 0;
	КонецЕсли;
	
	Если Не Расчет И РесурсЗаказчика Тогда
		НовДок.Расчет = Истина;
	Иначе
		НовДок.Расчет = Расчет;
	КонецЕсли;
	
	НовДок.НомерВПределахСметы 	= ТекСтрока.ПорядковыйНомерВСмете;
	НовДок.РегиональнаяБаза		= ТекФорма.СметноНормативнаяБаза;
	
	СимволПробел = СтрНайти(ТекСтрока.ШифрРасценки," ");
	Если СимволПробел > 0 Тогда
		Шифр = Лев(ТекСтрока.ШифрРасценки,СимволПробел-1);
		Примечание = Сред(ТекСтрока.ШифрРасценки,СимволПробел+1);
	Иначе
		Шифр = ТекСтрока.ШифрРасценки;
		Примечание = "";
	КонецЕсли;
	НовДок.ШифрРасценки 		= Шифр;
	НовДок.Примечание = Примечание;
	НовДок.Определитель          = ТекСтрока.Определитель;
	НовДок.ТипНормативныхСборников = ТекСтрока.ТипНормативныхСборников;
	Если Не ЗначениеЗаполнено(НовДок.Определитель) Или Не ЗначениеЗаполнено(НовДок.ТипНормативныхСборников) Тогда
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("СтрокаПрефикса",ТекСтрока.Префикс);
		СтруктураОтбора.Вставить("СметнаяПрограмма",ТекФорма.СметнаяПрограмма);
		МассивСтрок = ТабСоответствияПрефиксов.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 Тогда
			НовДок.Определитель            = МассивСтрок[0].Определитель;
			НовДок.ТипНормативныхСборников = МассивСтрок[0].ТипНормативногоСборника;
		КонецЕсли;
	КонецЕсли;	
	
	// *******************************************
	// Получение единицы измерения по строке измерителя.
	ТекЕдИзм 				= СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(ТекСтрока.Измеритель);
	НовДок.Измеритель 		= ТекСтрока.Измеритель;
	НовДок.ЕдиницаИзмерения = ТекЕдИзм;
	
	// ********************************************
	НовДок.ОснЗарплата              = ПреобразоватьВЧисло(ТекСтрока.ОсновнаяЗарплата);
	НовДок.ЭксплМашин               = ПреобразоватьВЧисло(ТекСтрока.ЭксплуатацияМашин);
	НовДок.ЗарплМашинистов          = ПреобразоватьВЧисло(ТекСтрока.ЗарплатаМашинистов);
	НовДок.ЗатратыТрудаМашинистов 	= 0;
	НовДок.ЗатратыТрудаРабочих    	= 0;
	НовДок.ПрямЗатраты				= ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);
	НовДок.ТекущаяЦена               = ПреобразоватьВЧисло(ТекСтрока.ValueТек);
	Если ТекСтрока.Result=Неопределено Тогда
		ФормулаОбъема = ТекСтрока.ОбъемРабот;
		ФормулаОбъема = СтрЗаменить(ФормулаОбъема,",",".");
		ОбъемРабот = 0;
		Формула = "ОбъемРабот = Значение";
		Формула = СтрЗаменить(Формула,"Значение", ФормулаОбъема);
		Попытка
			Выполнить(Формула);
		Исключение
			Событие = НСтр("ru = 'Исключение Гранд-смета'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
		КонецПопытки;
		НовДок.ОбъемРабот = ОбъемРабот;
	Иначе
		НовДок.ОбъемРабот			= ПреобразоватьВЧисло(ТекСтрока.Result);
	КонецЕсли;
	НовДок.ФормулаОбъема            = ?(ТекСтрока.Fx=Неопределено,ТекСтрока.ОбъемРабот,ТекСтрока.Fx);
	НовДок.ФормулаСМ                = ТекСтрока.ФормулаСМ;
	
	Если ЗагружатьНРСП Тогда
		// ********************************************
		// Определение вида работ по таблице видов работ.
		// Заполнение показателей по видам работ.
		ИдГруппаРабот = "";
		Если ЗначениеЗаполнено(ТекСтрока.ВидРабот) Тогда
			СтруктураОтбора = Новый Структура("Ид,ИДсметы",ТекСтрока.ВидРабот,ТекСтрока.ИДсметы);
			МассивСтрок = ТабВидовРабот.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 Тогда
				НовДок.ВидРабот = МассивСтрок[0].Наименование;
				СтрокаВидаРабот = МассивСтрок[0];
				ИдГруппаРабот 	= СтрокаВидаРабот.ИдГруппаРабот;
				ЗаполнитьПоказателиПоВидуРабот(НовДок,СтрокаВидаРабот);
			КонецЕсли
		КонецЕсли;
		
		// ********************************************	
		// Заполнение коэффициентов позиции, если есть. 
		Если ЗначениеЗаполнено(ТекСтрока.КоэффициентКНРНаРемонтБазисный) Тогда
			НовДок.КоэффициентКНРНаРемонтБазисный = ТекСтрока.КоэффициентКНРНаРемонтБазисный;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.КоэффициентКНРНаРемонтТекущий) Тогда
			НовДок.КоэффициентКНРНаРемонтТекущий = ТекСтрока.КоэффициентКНРНаРемонтТекущий;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.КоэффициентКСПНаРемонтБазисный) Тогда
			НовДок.КоэффициентКСПНаРемонтБазисный = ТекСтрока.КоэффициентКСПНаРемонтБазисный; 	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.КоэффициентКСПНаРемонтТекущий) Тогда
			НовДок.КоэффициентКСПНаРемонтТекущий = ТекСтрока.КоэффициентКСПНаРемонтТекущий;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.NKR) Тогда
			НовДок.КоэффициентКНРНаРемонтТекущий = ТекСтрока.NKR;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекСтрока.PKR) Тогда
			НовДок.КоэффициентКСПНаРемонтТекущий = ТекСтрока.PKR;
		КонецЕсли;

		НовДок.КоэффициентКСПУСНТекущий = ТекСтрока.PK_MethodKI;
		НовДок.КоэффициентКНРУСНТекущий = ТекСтрока.NK_MethodKI;
	КонецЕсли;

	// *************************************************
	// Переборка таблицы коэффициентов / поправок позиции.
	// Если ИдПозиции не заполнено, предположительно это коэффициенты по группе работ.
	// И нужно выяснить к какой группе относится вид работы позиции ЛС.
	
	Для Каждого СтрокаКоэффициент Из ТабПоправки Цикл
		// Коэффициент отностия к конкретной позиции ЛС.
		Если ЗначениеЗаполнено(СтрокаКоэффициент.ИдПозиции) Тогда
			Если СтрокаКоэффициент.ИдПозиции = ТекСтрока.SysID Тогда
				ПолучитьСоздатьПоправочныйКоэффициент(СтрокаКоэффициент,НовДок);
			КонецЕсли;
		// Коэффициенты относятся к видам работ.	
		Иначе	
			// ************************************* 
			// ++ AVV: Было
			//Если ЗначениеЗаполнено(ИдГруппаРабот) Тогда
			//	Если ЗначениеЗаполнено(СтрокаКоэффициент.ВидыРабот) Тогда
			//		ПозСимвола = Найти(СтрокаКоэффициент.ВидыРабот,ИдГруппаРабот);
			//		Если ПозСимвола > 0 Тогда
			//			ПолучитьСоздатьПоправочныйКоэффициент(СтрокаКоэффициент,НовДок);
			//		КонецЕсли;
			//	КонецЕсли;
			//КонецЕсли;
			
			// Стало: 
			// Определение коэффициента который относится к группе работ.
			Если ЗначениеЗаполнено(СтрокаКоэффициент.ГруппыРабот) Тогда
				Если ЗначениеЗаполнено(ИдГруппаРабот) Тогда
					ПозСимвола = Найти(СтрокаКоэффициент.ГруппыРабот,ИдГруппаРабот);
					Если ПозСимвола > 0 Тогда
						ПолучитьСоздатьПоправочныйКоэффициент(СтрокаКоэффициент,НовДок);
					КонецЕсли;
				КонецЕсли;
			// Определение коэффициента который относится к виду работ.
			ИначеЕсли ЗначениеЗаполнено(СтрокаКоэффициент.ВидыРабот) Тогда
				Если ЗначениеЗаполнено(ТекСтрока.ВидРабот) Тогда
					ПозСимвола = Найти(СтрокаКоэффициент.ВидыРабот,ТекСтрока.ВидРабот);
					Если ПозСимвола > 0 Тогда
						ПолучитьСоздатьПоправочныйКоэффициент(СтрокаКоэффициент,НовДок);
					КонецЕсли;
				КонецЕсли;
			// Определение коэффициента который относится к разделу.
			ИначеЕсли ЗначениеЗаполнено(СтрокаКоэффициент.Разделы) Тогда
				Если ЗначениеЗаполнено(ТекСтрока.ИдРаздела) Тогда
					ПозСимвола = Найти(СтрокаКоэффициент.Разделы,ТекСтрока.ИдРаздела);
					Если ПозСимвола > 0 Тогда
						ПолучитьСоздатьПоправочныйКоэффициент(СтрокаКоэффициент,НовДок);
					КонецЕсли;
				КонецЕсли;
			// Определение коэффициента который относится ко всем позициям без учета работ, видов работ и разделов.	
			Иначе
 				ПолучитьСоздатьПоправочныйКоэффициент(СтрокаКоэффициент,НовДок);
			КонецЕсли;
			// -- AVV
			// *************************************
		КонецЕсли;
	КонецЦикла;
	
	// *******************************
	// Опеределение и заполнение состава работ.
	СтруктураОтбора = Новый Структура("ИдПозиции,ИДсметы",ТекСтрока.SysID,ТекСтрока.ИДсметы);
	МассивСтрок = ТабРаботы.НайтиСтроки(СтруктураОтбора);
	НомСтр = 1;
	Для Каждого ТекЭлемент Из МассивСтрок Цикл
		СтрокаРабот 					= НовДок.СоставРабот.Добавить();
		СтрокаРабот.Номер 				= НомСтр;
		СтрокаРабот.НаименованиеРаботы 	= ТекЭлемент.НаименованиеРаботы;
		НомСтр = НомСтр + 1;
	КонецЦикла;
	
	// *****************************************
	// Поиск индексов в таблице по коду позиции.
	// Добавление в ТЧ "Коэффициенты пересчета" позиции ЛС.
	Если ТекСмета.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
		// ************************************* 
		// ++ AVV 
		// Было:
		// СтруктураОтбора = Новый Структура("Code,ИДсметы",ТекСтрока.IndexCode,ТекСтрока.ИДсметы);
		//
		// Стало: 
		СтруктураОтбора = Новый Структура("Code,ИДсметы,ИндексыАкта",ТекСтрока.IndexCode,ТекСтрока.ИДсметы,Ложь);
		// -- AVV
		// *************************************
		МассивСтрок = ТабИндексов.НайтиСтроки(СтруктураОтбора);
		Для Каждого ТекЭлемент Из МассивСтрок Цикл
			СтрокаКоэффициент							= НовДок.КоэффициентыПересчета.Добавить();
			СтрокаКоэффициент.ВидРабот 					= ТекЭлемент.Caption;
			СтрокаКоэффициент.КоэффОснЗарплаты          = ТекЭлемент.OZ;
			СтрокаКоэффициент.КоэффСтоимЭксплМашин      = ТекЭлемент.EM;
			СтрокаКоэффициент.КоэффСтоимЗарплатеМашин   = ТекЭлемент.ZM;
			СтрокаКоэффициент.КоэффСтоимМатериалов      = ТекЭлемент.MT;
			Если ТекЭлемент.OZ = ТекЭлемент.ZM Тогда
				СтрокаКоэффициент.ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Разные;
			Иначе
				СтрокаКоэффициент.ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ТекСтрока.УровеньЦен = "Curr" Тогда
		НовДок.НеПрименятьИндексы = ?(ТекСмета.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный,Ложь,Истина);
	КонецЕсли;
	
	// Создание ресурсов позиции ЛС.
	СтруктураОтбора = Новый Структура();
	СтруктураОтбора.Вставить("ИдПозиции",ТекСтрока.SysID);
	СтруктураОтбора.Вставить("Акт",Ложь);
	МассивСтрок = ТабРесурсов.НайтиСтроки(СтруктураОтбора);
	Если МассивСтрок.Количество() > 0 Тогда
		ПредСтрока = неопределено;
		Для Каждого ТекЭлемент Из МассивСтрок Цикл
			Если ВРег(ТекЭлемент.ВидРесурса) = ВРег("Tzr") Тогда
				НовДок.ЗатратыТрудаРабочих    	= НовДок.ЗатратыТрудаРабочих+?(ЗначениеЗаполнено(ТекЭлемент.НормаРасхода),ТекЭлемент.НормаРасхода,0);
			ИначеЕсли ВРег(ТекЭлемент.ВидРесурса) = ВРег("TZM") Тогда
				НовДок.ЗатратыТрудаМашинистов 	= НовДок.ЗатратыТрудаМашинистов+?(ЗначениеЗаполнено(ТекЭлемент.Value),ТекЭлемент.Value,0);
			КонецЕсли;
			ПолучитьСоздатьРесурс(ТекЭлемент,НовДок,ТекФорма,ТабСоответствияРесурсов,ТабСообщения);
			ПредСтрока = ТекЭлемент;
		КонецЦикла;
	Иначе
		НовДок.ТекущаяОснЗарплата 		= ?(ЗначениеЗаполнено(ТекСтрока.ТекОсновнаяЗарплата),ТекСтрока.ТекОсновнаяЗарплата,0);
		НовДок.ТекущаяЭксплМашин 		= ?(ЗначениеЗаполнено(ТекСтрока.ТекЭксплуатацияМашин),ТекСтрока.ТекЭксплуатацияМашин,0);
		НовДок.ТекущаяЗарплМашинистов 	= ?(ЗначениеЗаполнено(ТекСтрока.ТекЗарплатаМашинистов),ТекСтрока.ТекЗарплатаМашинистов,0);
		НовДок.ТекущаяСтоимМатериалов 	= ?(ЗначениеЗаполнено(ТекСтрока.ТекСтоимостьМатериалов),ТекСтрока.ТекСтоимостьМатериалов,0);
		
		НовДок.ФормулаТекущейОЗ = ?(ЗначениеЗаполнено(ТекСтрока.ФормулаТекОсновнаяЗарплата),ТекСтрока.ФормулаТекОсновнаяЗарплата,"");
		НовДок.ФормулаТекущейЭМ = ?(ЗначениеЗаполнено(ТекСтрока.ФормулаТекЭксплуатацияМашин),ТекСтрока.ФормулаТекЭксплуатацияМашин,"");
		НовДок.ФормулаТекущейЗМ = ?(ЗначениеЗаполнено(ТекСтрока.ФормулаТекЗарплатаМашинистов),ТекСтрока.ФормулаТекЗарплатаМашинистов,"");
		НовДок.ФормулаТекущейСМ = ?(ЗначениеЗаполнено(ТекСтрока.ФормулаТекСтоимостьМатериалов),ТекСтрока.ФормулаТекСтоимостьМатериалов,"");

		НовДок.ТекущаяЦена = НовДок.ТекущаяОснЗарплата + НовДок.ТекущаяЭксплМашин + НовДок.ТекущаяСтоимМатериалов;
		НовДок.Записать();
	КонецЕсли;
	
	Документы.СМ_ПозицияЛокальнойСметы.ЗаполнитьНачисленияПозицииПоУмолчанию(НовДок);
	
	// ************************************************************
	// ++ AVV
	// Ресурсный расчет единичной стоимости позиции по базисным ценам
	Если СтруктураПараметровЗадания.ТекФорма.ПересчитатьБазиснуюСтоимость Тогда
		Если НовДок.РесурсыПозицииЛокальнойСметы.Количество() > 0 Тогда 
			ПоБазису = Истина;
			РасчетПоЦенамРесурсов(НовДок, ТекСмета, ПоБазису);
		КонецЕсли;
	КонецЕсли;
	// -- AVV
	// ************************************************************
	
	НовДок.Записать();
	
	СтрокаСообщения 				= ТабСообщения.Добавить();
	СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ позиция ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование);	
	ТекСтрока.ПозицияСсылка = НовДок.Ссылка;
	Возврат НовДок.Ссылка;
	
КонецФункции

// ************************************************************
// ++ AVV

Процедура РасчетПоЦенамРесурсов(Позиция, ТекСмета, ПоБазису)
	
	СтруктураПараметровРасчетаЛС = СМ_СметаВызовСервера.ПолучитьСтруктуруПараметровРасчетаЛС(ТекСмета,Позиция);
	ВариантРасчетаЗМ = СтруктураПараметровРасчетаЛС.ВариантРасчетаЗМ;
	Если ВариантРасчетаЗМ.Пустая() Тогда
		ВариантРасчетаЗМ = Перечисления.СМ_ВариантыРасчетаЗМ.Расчетный;
	КонецЕсли;	
	
	КЧ 		= Новый КвалификаторыЧисла(20,6);
	Массив 	= Новый Массив;
	Массив.Добавить(Тип("Число"));
	ОписаниеТиповЧ = Новый ОписаниеТипов(Массив, , ,КЧ);
	
	ТаблЕдСтоим = Новый ТаблицаЗначений;
	ТаблЕдСтоим.Колонки.Добавить("ПрямЗатраты",			ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ОснЗарплата",			ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЭксплМашин",			ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЗарплМашинистов",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("СтоимМатериалов",		ОписаниеТиповЧ);
	ТаблЕдСтоим.Колонки.Добавить("ЗатратыТрудаРабочих",	ОписаниеТиповЧ);
	
	// По базисным (текущим) ценам рассчитываем единичные составляющие прямых затрат.
	СМ_СметаРасчетБазисноИндексныйСервер.РасчетЕдиничныхЗначенийСоставляющих(Позиция,ВариантРасчетаЗМ,ТаблЕдСтоим,ПоБазису);
	Для Каждого Значения Из ТаблЕдСтоим Цикл
		Позиция.ПрямЗатраты 			= Значения.ПрямЗатраты;
		Позиция.СтоимМатериалов 		= Значения.СтоимМатериалов;
		Позиция.ЭксплМашин 				= Значения.ЭксплМашин;
		Позиция.ЗарплМашинистов 		= Значения.ЗарплМашинистов;
		Позиция.ОснЗарплата 			= Значения.ОснЗарплата;
		Позиция.ЗатратыТрудаРабочих 	= Значения.ЗатратыТрудаРабочих;
		Позиция.ЗатратыТрудаМашинистов 	= Позиция.ЗатратыТрудаМашинистов;
	КонецЦикла;

КонецПроцедуры

// -- AVV
// ************************************************************

Функция ПолучитьШифрПозицииЛС(ТекШифр)
	
	СтруктураШифра = Новый Структура;
	СтруктураШифра.Вставить("Шифр","");
	СтруктураШифра.Вставить("Префикс","");
	ТекСтрока = ТекШифр;
	Пока СтрДлина(ТекСтрока) > 0 Цикл
		ТекСимвол = Лев(ТекСтрока,1);
		ТекПозиция = Найти("0123456789",ТекСимвол);
		Если ТекПозиция > 0 Тогда
			СтруктураШифра.Шифр = ТекСтрока;
			Возврат СтруктураШифра;
		Иначе	
			СтруктураШифра.Префикс = СтруктураШифра.Префикс + ТекСимвол;				
		КонецЕсли;
		ТекСтрока = Сред(ТекСтрока,2);	
	КонецЦикла;
	
	Возврат СтруктураШифра;
	
КонецФункции

Процедура ПолучитьСоздатьРесурс(СтрокаРесурса,ТекущаяПозицияЛС,ТекФорма,ТабСоответствияРесурсов,ТабСообщения)

	Учтенный = (ТекущаяПозицияЛС.ИдСметы.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный);
	СметнаяПрограмма 	= ТекФорма.СметнаяПрограмма;
	СтруктураРесурса 	= ОпределитьПараметрыРесурса(СтрокаРесурса,ТабСообщения,Учтенный);
	ВидРесурса 			= СтруктураРесурса.ВидРесурса;
	ТипМатериала		= СтруктураРесурса.ТипМатериала;
	
	ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка();
	// ****************************************************
	Если ЗначениеЗаполнено(СтрокаРесурса.СсылкаВБазе) Тогда
		ТекРесурс = СтрокаРесурса.СсылкаВБазе;
	Иначе
		СтруктураОтбора = Новый Структура();
		СтруктураОтбора.Вставить("НаименованиеРесурса",СтрокаРесурса.Наименование);
		СтруктураОтбора.Вставить("КодРесурса",СтрокаРесурса.КодРесурса);
		МассивСтрок = ТабСоответствияРесурсов.НайтиСтроки(СтруктураОтбора);
		Если МассивСтрок.Количество() > 0 Тогда
			ТекРесурс 					= МассивСтрок[0].СсылкаВБазе;	
			СтрокаРесурса.СсылкаВБазе 	= ТекРесурс;
		КонецЕсли;
	КонецЕсли;
	
	Если ТекРесурс.Пустая() Тогда
		ТекРесурс = НайтиРесурс(СметнаяПрограмма,СтрокаРесурса,ТабСообщения);
	КонецЕсли;
	
	Если ТекРесурс.Пустая() Тогда
		СтрокаСообщения 				= ТабСообщения.Добавить();
		СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не задано соответствие ресурса: %1, %2'"), СтрокаРесурса.КодРесурса, СтрокаРесурса.Наименование);
	КонецЕсли;	
	
	Если ТекРесурс.Пустая() И СтрокаРесурса.СоздаватьЗаписиВСправочнике Тогда
		
		Если СМ_СметаВызовСервера.НедоступнаРаботаСПрайсами() Тогда
			СтрокаСообщения = ТабСообщения.Добавить();
			СтрокаСообщения.ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден ресурс: %1. Загрузка отменена.'"), СтрокаРесурса.Наименование);
			Возврат;
		КонецЕсли;
		
		ТекРесурсОбъект 					= Справочники.СМ_Ресурсы.СоздатьЭлемент();
		ТекРесурсОбъект.ВидРесурса 			= ВидРесурса;
		ТекРесурсОбъект.Код 				= СтрокаРесурса.КодРесурса;
		ТекРесурсОбъект.Наименование 		= СтрокаРесурса.Наименование;
		ТекРесурсОбъект.ДлинноеНаименование = СтрокаРесурса.Наименование;
		ТекРесурсОбъект.Родитель 			= ПолучитьСоздатьПапкуРесурсов("" + ТекРесурсОбъект.ВидРесурса,ТабСообщения,ТекФорма.СметноНормативнаяБаза.ГруппаРесурсов);
		ЕдиницаИзмерения	= СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(СтрокаРесурса.ЕдиницаИзмерения);
		Если ЕдиницаИзмерения.Пустая() Тогда
			Единица = Справочники.СМ_ЕдиницыИзмеренияСмета.СоздатьЭлемент();
			Единица.Наименование = СтрокаРесурса.ЕдиницаИзмерения;
			Единица.ОбменДанными.Загрузка = Истина;;
			Единица.Записать();
			ЕдиницаИзмерения = Единица.Ссылка;
		КонецЕсли;
		
		ТекРесурсОбъект.ЕдиницаИзмерения 		= ЕдиницаИзмерения;
		ТекРесурсОбъект.ГодВыпуска 				= ?(ЗначениеЗаполнено(ТекФорма.СметноНормативнаяБаза.ГодВыпуска),ТекФорма.СметноНормативнаяБаза.ГодВыпуска,Перечисления.СМ_ГодыВыпускаБазы.г2009);
		ТекРесурсОбъект.ВводитьСтоимостьНаОбъем = Ложь;
		
		Попытка
			ТекРесурсОбъект.Записать();
			СтрокаСообщения 				= ТабСообщения.Добавить();
			СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый элемент справочника Ресурсы: %1, %2'"), СтрокаРесурса.КодРесурса,СтрокаРесурса.Наименование); 
		Исключение
			СтрокаСообщения 				= ТабСообщения.Добавить();
			СтрокаСообщения.ТекстСообщения 	= НСтр("ru='Элемент справочника Ресурсы не записан:'")+" " + ОписаниеОшибки();
		КонецПопытки;
		
		ТекРесурс 							= ТекРесурсОбъект.Ссылка;
		СтрокаРесурса.СсылкаВБазе 			= ТекРесурс;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаРесурса.Replaced) И СтрокаРесурса.Replaced Тогда
		ПредСтрока = ТекущаяПозицияЛС.РесурсыПозицииЛокальнойСметы.Получить(ТекущаяПозицияЛС.РесурсыПозицииЛокальнойСметы.Количество()-1);
		Запись = РегистрыСведений.СМ_ЗаменаМатериаловПозиции.СоздатьМенеджерЗаписи();
		Запись.ЗамененныйРесурс = ?(ЗначениеЗаполнено(ТекРесурс),ТекРесурс,СтрокаРесурса.Наименование);
		Запись.Смета = ТекущаяПозицияЛС.ИДСметы;
		Запись.Позиция = ТекущаяПозицияЛС.Ссылка;
		Запись.НормаРасходаСтарогоМатериала = СтрокаРесурса.НормаРасхода;
		Запись.БазиснаяЦенаСтарогоМатериала = СтрокаРесурса.Value;
		Запись.БазисЗарплМашСтарРесурс = СтрокаРесурса.ЗарплатаМашинистов;
		Запись.ТекЗарплМашСтарРесурс = СтрокаРесурса.ТекущаяЗарплатаМашинистов;
		Запись.ТекущаяЦенаСтарогоМатериала = СтрокаРесурса.ValueТек;
		Запись.НовыйРесурс = ?(ЗначениеЗаполнено(ПредСтрока.Ресурс),ПредСтрока.Ресурс,ПредСтрока.НаименованиеРесурса);
		Запись.Записать();
		Возврат;
	КонецЕсли;
	
	Если СтрНайти(ВРег(СтрокаРесурса.Атрибуты),ВРег("Deleted"))>0 Тогда
		Возврат;
	КонецЕсли;

	// Создаем новую строку ресурса в ТЧ.
	ТекОбъект 									= ТекущаяПозицияЛС;
	НоваяСтрока 								= ТекОбъект.РесурсыПозицииЛокальнойСметы.Добавить();
	НоваяСтрока.СметныйКодРесурса				= ?(ЗначениеЗаполнено(ТекРесурс),ТекРесурс.Код,СтрокаРесурса.КодРесурса);
	НоваяСтрока.Ресурс              			= ТекРесурс;
	НоваяСтрока.ВидРесурса						= ВидРесурса;
	НоваяСтрока.НормаРасхода                    = СтрокаРесурса.НормаРасхода;
	НоваяСтрока.ТипМатериала                  	= ТипМатериала;
	НоваяСтрока.БазиснаяЦена                    = СтрокаРесурса.Value;
	НоваяСтрока.БазиснаяЗарплатаМашинистов	  	= СтрокаРесурса.ЗарплатаМашинистов;
	НоваяСтрока.ТекущаяЦена                     = СтрокаРесурса.ValueТек;
	НоваяСтрока.ТекущаяЗарплатаМашинистов	  	= СтрокаРесурса.ТекущаяЗарплатаМашинистов;
	НоваяСтрока.НаименованиеРесурса = СтрокаРесурса.Наименование;
	НоваяСтрока.ЕдиницаИзмеренияРесурса = СтрокаРесурса.ЕдиницаИзмерения;
	
	
	ТекОбъект.Записать();
	
	
КонецПроцедуры

Функция ПреобразоватьВЧисло(ТекСтрока)
	
	Если ЗначениеЗаполнено(ТекСтрока) Тогда
		Попытка
			ТекЧисло = Число(ТекСтрока);
		Исключение
			ТекЧисло = 0;
		КонецПопытки;
	Иначе
		ТекЧисло = 0;
	КонецЕсли;
	
	Возврат ТекЧисло;
	
КонецФункции

Процедура ЗаполнитьПоказателиПоВидуРабот(ПозицияЛС,СтрокаВидаРабот)
	
	// Накладные расходы и Сметная прибыль.
	Если СтрокаВидаРабот.НакладныеРасходыТекущие = Неопределено Тогда
		ПозицияЛС.НакладныеРасходыБазисные	= СтрокаВидаРабот.НакладныеРасходыБазисные;
		ПозицияЛС.НакладныеРасходыТекущие		= СтрокаВидаРабот.НакладныеРасходыБазисные;
		ПозицияЛС.СметнаяПрибыльБазисные    	= СтрокаВидаРабот.СметнаяПрибыльБазисные;
		ПозицияЛС.СметнаяПрибыльТекущие       = СтрокаВидаРабот.СметнаяПрибыльБазисные;
	Иначе
		ПозицияЛС.НакладныеРасходыБазисные	= СтрокаВидаРабот.НакладныеРасходыБазисные;
		ПозицияЛС.НакладныеРасходыТекущие		= СтрокаВидаРабот.НакладныеРасходыТекущие;
		ПозицияЛС.СметнаяПрибыльБазисные    	= СтрокаВидаРабот.СметнаяПрибыльБазисные;
		ПозицияЛС.СметнаяПрибыльТекущие       = СтрокаВидаРабот.СметнаяПрибыльТекущие;
	КонецЕсли;
	
	// Коэффициенты к НР на ремонт.
	СтрокаКоэффициента = ?(ЗначениеЗаполнено(СтрокаВидаРабот.КоэффициентКНРНаРемонтБазисный),СтрокаВидаРабот.КоэффициентКНРНаРемонтБазисный,"");
	МассивКэф = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаКоэффициента,"*",,Истина);
	
	ПозицияЛС.КоэффициентКНРНаРемонтБазисный   = ?(МассивКэф.Количество()>0,МассивКэф[0],0);
	ПозицияЛС.ПоправочныйКоэффициентКНРБазисный = ?(МассивКэф.Количество()>1,МассивКэф[1],0);
	ПозицияЛС.КоэффициентКНРУСНБазисный = ?(МассивКэф.Количество()>2,МассивКэф[2],0);
	
	СтрокаКоэффициента = ?(ЗначениеЗаполнено(СтрокаВидаРабот.КоэффициентКНРНаРемонтТекущий),СтрокаВидаРабот.КоэффициентКНРНаРемонтТекущий,"");
	МассивКэф = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаКоэффициента,"*",,Истина);
	
	ПозицияЛС.КоэффициентКНРНаРемонтТекущий   = ?(МассивКэф.Количество()>0,МассивКэф[0],0);
	ПозицияЛС.ПоправочныйКоэффициентКНРТекущий = ?(МассивКэф.Количество()>1,МассивКэф[1],0);
	ПозицияЛС.КоэффициентКНРУСНТекущий = ?(МассивКэф.Количество()>2,МассивКэф[2],0);

	
	// Коэффициенты к СП на ремонт.
	СтрокаКоэффициента = ?(ЗначениеЗаполнено(СтрокаВидаРабот.КоэффициентКСПНаРемонтБазисный),СтрокаВидаРабот.КоэффициентКСПНаРемонтБазисный,"");
	МассивКэф = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаКоэффициента,"*",,Истина);
	
	ПозицияЛС.КоэффициентКСПНаРемонтБазисный   = ?(МассивКэф.Количество()>0,МассивКэф[0],0);
	ПозицияЛС.ПоправочныйКоэффициентКСПБазисный = ?(МассивКэф.Количество()>1,МассивКэф[1],0);
	ПозицияЛС.КоэффициентКСПУСНБазисный = ?(МассивКэф.Количество()>2,МассивКэф[2],0);
	
	СтрокаКоэффициента = ?(ЗначениеЗаполнено(СтрокаВидаРабот.КоэффициентКСПНаРемонтТекущий),СтрокаВидаРабот.КоэффициентКСПНаРемонтТекущий,"");
	МассивКэф = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаКоэффициента,"*",,Истина);
	
	ПозицияЛС.КоэффициентКСПНаРемонтТекущий   = ?(МассивКэф.Количество()>0,МассивКэф[0],0);
	ПозицияЛС.ПоправочныйКоэффициентКСПТекущий = ?(МассивКэф.Количество()>1,МассивКэф[1],0);
	ПозицияЛС.КоэффициентКСПУСНТекущий = ?(МассивКэф.Количество()>2,МассивКэф[2],0);
	
КонецПроцедуры

Процедура ПолучитьСоздатьПоправочныйКоэффициент(ТекСтрока,ТекПозицияЛС)
	
	НоваяСтрока 					= ТекПозицияЛС.ПоправкиПозиции.Добавить();	
	НоваяСтрока.Применить 			= Истина;
	НоваяСтрока.Обоснование			= ТекСтрока.УсловияПрименения;
	НоваяСтрока.УсловияПрименения	= ТекСтрока.УсловияПрименения;
	НоваяСтрока.КоэффЭМ 			= ТекСтрока.КоэффициентЭМ;
	НоваяСтрока.КоэффОЗ 			= ТекСтрока.КоэффициентОЗ;
	НоваяСтрока.КоэффСМ 			= ТекСтрока.КоэффициентСМ;
	НоваяСтрока.КоэффЗМ 			= ТекСтрока.КоэффициентZM;
	НоваяСтрока.КоэффПЗ     		= ТекСтрока.КоэффициентPZ;
	НоваяСтрока.ТипПоправки 		= Перечисления.СМ_ТипыПоправок.ТехчастиСборников;
	НоваяСтрока.ВариантРасчета 		= Перечисления.СМ_ВариантыРасчетаЭММ.РазныеКРазности;
	
	// Опции: Base Curr PzAll EmAll MatQty EmQty OzpTz ZpmTz.
	СтрокаОпций 	= ТекСтрока.Опции; 
	ПозицияEmAll 	= Найти(СтрокаОпций,"EmAll");
	ПозицияMatQty 	= Найти(СтрокаОпций,"MatQty");
	ПозицияOzpTz 	= Найти(СтрокаОпций,"OzpTz");
	ПозицияZpmTz 	= Найти(СтрокаОпций,"ZpmTz");
	ПозицияDisabled	= Найти(Нрег(СтрокаОпций),"disabled");
	
	Если ПозицияDisabled > 0 Тогда
		НоваяСтрока.Применить = Ложь;
	КонецЕсли;
	
	Если ПозицияEmAll > 0 ИЛИ ТекСтрока.КоэффициентЭМ = ТекСтрока.КоэффициентZM Тогда
		НоваяСтрока.КоэффЗМ 		= ТекСтрока.КоэффициентЭМ;
		НоваяСтрока.ВариантРасчета 	= Перечисления.СМ_ВариантыРасчетаЭММ.Одинаковые;
	КонецЕсли;
	
	Если ПозицияMatQty > 0 Тогда
		// Демонтаж.
		Если ТекСтрока.КоэффициентСМ = 0 ИЛИ ТекСтрока.КоэффициентСМ = "0" Тогда
			ТекПозицияЛС.Демонтаж 		 = Истина;
			ТекПозицияЛС.СтоимМатериалов = 0;
			// В табличной части ресурсам с видом "материалы",
			// установить признак удален.
		КонецЕсли;
	КонецЕсли;
	
	Если ПозицияOzpTz > 0 Тогда
		НоваяСтрока.КоэффТР = ТекСтрока.КоэффициентОЗ;	
	КонецЕсли;
	
	Если ПозицияZpmTz > 0 Тогда
		НоваяСтрока.КоэффТМ = НоваяСтрока.КоэффЗМ;	
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСоздатьПапкуРесурсов(НаименованиеПапки,ТабСообщения,ГруппаРесурсов) 
	
	ТекПапка = Справочники.СМ_Ресурсы.ПустаяСсылка();	
	Если Не ГруппаРесурсов.Пустая()  Тогда
		ТекПапка = Справочники.СМ_Ресурсы.НайтиПоКоду(ГруппаРесурсов.ИмяПредопределенныхДанных);
		Если  ТекПапка = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
			НовыйОбъект = Справочники.СМ_Ресурсы.СоздатьГруппу();
			НовыйОбъект.Наименование 	= Сред(ГруппаРесурсов.Наименование,1,120);
			НовыйОбъект.Код 		 	= ГруппаРесурсов.ИмяПредопределенныхДанных;
			НовыйОбъект.Записать();
			ТекПапка =  НовыйОбъект.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Группа = ТекПапка;
	
	МассивРодителей = Новый СписокЗначений;
	СМ_СметаЗагрузкаВызовСервера.ПолучитьВсехРодителей(Группа,МассивРодителей);
	
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "ВЫБРАТЬ
	|	Ресурсы.Ссылка
	|ИЗ
	|	Справочник.СМ_Ресурсы КАК Ресурсы
	|ГДЕ
	|	Ресурсы.Родитель В (&Каталог)
	|	И Ресурсы.Наименование = &Наименование
	|	И Ресурсы.ЭтоГруппа = ИСТИНА";
	
	Запрос.УстановитьПараметр("Наименование", НаименованиеПапки);
	Запрос.УстановитьПараметр("Каталог", МассивРодителей);
	
	Результат 	= Запрос.Выполнить();
	Выборка 	= Результат.Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		СпрОб = Справочники.СМ_Ресурсы.СоздатьГруппу();
		СпрОб.Наименование = НаименованиеПапки;
		СпрОб.УстановитьНовыйКод("ГР");
		СпрОб.Родитель = Группа;
		СпрОб.Записать();
		Спр = СпрОб.Ссылка;
		
		СтрокаСообщения 				= ТабСообщения.Добавить();
		СтрокаСообщения.ТекстСообщения 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создана новая группа справочника ресурсы: %1, %2'"), СпрОб.Код, СпрОб.Наименование);
		
	Иначе
		Спр = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Спр;
	
КонецФункции

#КонецОбласти

#КонецЕсли