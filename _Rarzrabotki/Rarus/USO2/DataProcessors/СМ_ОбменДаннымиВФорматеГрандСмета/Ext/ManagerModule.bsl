Функция НайтиРазделы(Смета) 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_РазделЛокальнойСметы.Ссылка КАК Раздел,
	               |	СМ_НумерацияПозицийЛокальныхСмет.ПорНомер КАК ПорНомер
	               |ИЗ
	               |	Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СМ_НумерацияПозицийЛокальныхСмет КАК СМ_НумерацияПозицийЛокальныхСмет
	               |		ПО (СМ_НумерацияПозицийЛокальныхСмет.Раздел = СМ_РазделЛокальнойСметы.Ссылка
	               |				И СМ_НумерацияПозицийЛокальныхСмет.Позиция = ЗНАЧЕНИЕ(Документ.СМ_ПозицияЛокальнойСметы.ПустаяСсылка))
	               |			И СМ_НумерацияПозицийЛокальныхСмет.Смета = СМ_РазделЛокальнойСметы.ИДСметы
	               |ГДЕ
	               |	СМ_РазделЛокальнойСметы.ПометкаУдаления = ЛОЖЬ
	               |	И СМ_РазделЛокальнойСметы.ИДСметы = &Смета
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПорНомер";
	Запрос.УстановитьПараметр("Смета",Смета);
	
	Возврат Запрос.Выполнить().Выбрать();
КонецФункции

