							СтрокаСоответсвия.НаименованиеРесурса	= СтрокаРесурса.Наименование;
							СтрокаСоответсвия.КодРесурса            = СтрокаРесурса.КодРесурса;
						КонецЕсли;
					КонецЕсли;
					
					// Подчинена узлу "Resources".		
				ИначеЕсли ИмяУзла = "Mch" Тогда	
					
