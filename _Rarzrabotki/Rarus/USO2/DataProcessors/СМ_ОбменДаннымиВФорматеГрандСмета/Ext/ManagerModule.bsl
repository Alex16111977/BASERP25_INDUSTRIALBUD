Функция НайтиРаботыПозиций(Смета)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СМ_ПозицияЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	               |ГДЕ
	               |	СМ_ПозицияЛокальнойСметы.ИДСметы = &Смета
	               |	И НЕ СМ_ПозицияЛокальнойСметы.ПометкаУдаления
	               |	И НЕ (ВЫРАЗИТЬ(СМ_ПозицияЛокальнойСметы.ВидРабот КАК СТРОКА(10))) = &Пусто
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_ПозицияЛокальнойСметы.Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	СМ_ПозицияЛокальнойСметы.Ссылка.Номер";
	Запрос.УстановитьПараметр("Пусто","");
	Запрос.УстановитьПараметр("Смета",Смета);
	
	Возврат Запрос.Выполнить().Выбрать();
