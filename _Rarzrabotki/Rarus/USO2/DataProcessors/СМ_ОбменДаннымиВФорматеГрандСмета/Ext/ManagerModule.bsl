
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область Выгрузка

// Процедура выгружает Локальные сметы в каталог, каждой смете соответствует свой файл. 
// ПАРАМЕТРЫ:
// // МассивСмет - массив ссылок для выборки смет
// // Путь - каталог для сохранения файлов.
Процедура ВыгрузитьНаСервере(Путь,МассивСмет,АдресФайлаВоВременномХранилище = "",ИмяВременногоФайла = "",ЭтоВеб = Ложь)  Экспорт
	
	Гранд = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "estml"));
	ТипЛС = ФабрикаXDTO.Тип("http://www.estml.ru/estml20.xsd", "ЛокальнаяСмета");

	АдресФайлаВоВременномХранилище = Новый Соответствие;		
	
	Для Каждого СтрокаЛС Из МассивСмет Цикл
		ЗаписьXML  = Новый ЗаписьXML;
		Номер = Строка(СтрокаЛС.Наименование);
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(Номер,"_");
		Если ЭтоВеб Тогда
			ЗаписьXML.ОткрытьФайл(Путь+"\"+ИмяФайла+".xml","windows-1251");
		Иначе
			ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла,"windows-1251");  		
		КонецЕсли;
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Document");
		ЗаписьXML.ЗаписатьАтрибут("ProgramVersion","7.0.4.12954");
		ЗаписьXML.ЗаписатьАтрибут("Generator","GrandSmeta");
		ЗаписьXML.ЗаписатьАтрибут("DocumentType","{2B0470FD-477C-4359-9F34-EEBE36B7D340}");

		ЗаписьXML.ЗаписатьНачалоЭлемента("RegionInfo");
		ЗаписьXML.ЗаписатьАтрибут("RegionName",СтрокаЛС.РегионДляВыбораЦен.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("RegionID",СтрокаЛС.РегионДляВыбораЦен.Код);
		ЗаписьXML.ЗаписатьАтрибут("Zone84Name",СтрокаЛС.Район.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("Zone84ID",СтрокаЛС.Район.Код);
		ЗаписьXML.ЗаписатьАтрибут("Zone01Name",СтрокаЛС.Район.Наименование);
		ЗаписьXML.ЗаписатьАтрибут("Zone01ID",СтрокаЛС.Район.Код);
		ЗаписьXML.ЗаписатьКонецЭлемента(); // RegionInfo
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Parameters");
		
		Options = "";
		Если СтрокаЛС.ОкруглятьДоРублей Тогда
			Options = "RoundPos ";
		КонецЕсли;
		Options = Options+"AddZatr CommonNakl CommonPlan ";
		// Если СтрокаЛС. Тогда
		//	Options = Options+"SeparateFot ";
		// КонецЕсли;
		// Если СтрокаЛС. Тогда
		//	Options = Options+"AutoIndexes";
		// КонецЕсли;
		
		ЗаписьXML.ЗаписатьАтрибут("Options",СокрЛП(Options));
		ЗаписьXML.ЗаписатьАтрибут("BasePrices","2001");
		//ЗаписьXML.ЗаписатьАтрибут("BaseCalcVrs",?(СтрокаЛС.Методика1984,"Vr1984","Vr2001"));
		Если СтрокаЛС.МетодикаРасчета = Справочники.СМ_МетодикиРасчета.СМ_Методика84года Тогда
			ЗаписьXML.ЗаписатьАтрибут("BaseCalcVrs","Vr1984");
		Иначе
			ЗаписьXML.ЗаписатьАтрибут("BaseCalcVrs","Vr2001");
		КонецЕсли;
		
		// ЗаписьXML.ЗаписатьАтрибут("BlockRoundMode","Smart");
		// ЗаписьXML.ЗаписатьАтрибут("TempZone","1");
		// ЗаписьXML.ЗаписатьАтрибут("MatRoundMode","SignDigitsPreserveInt");
		// ЗаписьXML.ЗаписатьАтрибут("MatDigits","4");
		
		ItogOptions = "SeparateVrs";
		
		ЗаписьXML.ЗаписатьАтрибут("ItogOptions",ItogOptions);
		ЗаписьXML.ЗаписатьАтрибут("FirstItogItem","K");
		ЗаписьXML.ЗаписатьАтрибут("ItogExpandTo","Default");
		ЗаписьXML.ЗаписатьАтрибут("TzDigits","2");
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("CommonNPBase");
		// ЗаписьXML.ЗаписатьАтрибут("Nacl",СтрокаЛС.Район.Код);
		// ЗаписьXML.ЗаписатьАтрибут("NaclMask",СтрокаЛС.Район.Код);
		// ЗаписьXML.ЗаписатьАтрибут("Plan",СтрокаЛС.Район.Код);
		// ЗаписьXML.ЗаписатьАтрибут("PlanMask",СтрокаЛС.Район.Код);
		ЗаписьXML.ЗаписатьКонецЭлемента(); //CommonNPBase  
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("CommonNPCurr");
		// ЗаписьXML.ЗаписатьАтрибут("Nacl",СтрокаЛС.Район.Код);
		// ЗаписьXML.ЗаписатьАтрибут("NaclMask",СтрокаЛС.Район.Код);
		// ЗаписьXML.ЗаписатьАтрибут("Plan",СтрокаЛС.Район.Код);
		// ЗаписьXML.ЗаписатьАтрибут("PlanMask",СтрокаЛС.Район.Код);
		ЗаписьXML.ЗаписатьКонецЭлемента(); //CommonNPCurr    
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("CommonNK");
		// ЗаписьXML.ЗаписатьАтрибут("CommonK",СтрокаЛС.Район.Код);
		// ЗаписьXML.ЗаписатьАтрибут("MethodKB",СтрокаЛС.Район.Код);
		// ЗаписьXML.ЗаписатьАтрибут("MethodKI",СтрокаЛС.Район.Код);
		// ЗаписьXML.ЗаписатьАтрибут("MethodKR",СтрокаЛС.Район.Код);
		ЗаписьXML.ЗаписатьАтрибут("ActiveItems",СтрокаЛС.Район.Код);
		ЗаписьXML.ЗаписатьКонецЭлемента(); //CommonNK    
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("CommonPK");
		// ЗаписьXML.ЗаписатьАтрибут("ActiveItems",СтрокаЛС.Район.Код);
		ЗаписьXML.ЗаписатьКонецЭлемента(); //CommonPK  
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); //Parameters

		ЗаписьXML.ЗаписатьНачалоЭлемента("Indexes");
		
		IndexesMode = "None";
		IndexesLinkMode = "Default";
		
		Если Не СтрокаЛС.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный Тогда
			Если СтрокаЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Раздел Тогда
				IndexesLinkMode = "Chapters";
				Если СтрокаЛС.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
					IndexesMode = "PosOne";
				Иначе
					IndexesMode = "Smr";
				КонецЕсли;
			Иначе
				Если СтрокаЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка
					И СтрокаЛС.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
					IndexesMode = "PosOne";
				ИначеЕсли СтрокаЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета
					И СтрокаЛС.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.ПоЭлементамЗатрат Тогда
					IndexesMode = "Total";
				ИначеЕсли СтрокаЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Смета
					И СтрокаЛС.СпособРасчетаИндексов = Перечисления.СМ_СпособыРасчетаИндексов.КПолнойСтоимости Тогда
					IndexesMode = "Smr";	
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		ЗаписьXML.ЗаписатьАтрибут("IndexesMode",IndexesMode);
		ЗаписьXML.ЗаписатьАтрибут("IndexesLinkMode",IndexesLinkMode);
		
		Если СтрокаЛС.Уровень = Перечисления.СМ_УровеньЗаданияИндексов.Расценка Тогда
			ИндексыПозиций = НайтиИндексыПозиций(СтрокаЛС);
			ЗаписьXML.ЗаписатьНачалоЭлемента("IndexesPos");
			Пока ИндексыПозиций.Следующий() Цикл
				Расценка = ИндексыПозиций.Ссылка;
				Индексы = Расценка.КоэффициентыПересчета.Выгрузить();
				Индексы.Свернуть("ВидРабот","КоэффПолнСтоимРабот,КоэффОснЗарплаты,КоэффСтоимЭксплМашин,КоэффСтоимЗарплатеМашин,КоэффСтоимМатериалов");
				сч = 1;
				Для Каждого Индекс Из Индексы Цикл
					ЗаписьXML.ЗаписатьНачалоЭлемента("Index");
					ЗаписьXML.ЗаписатьАтрибут("Caption",Индекс.ВидРабот);
					ЗаписьXML.ЗаписатьАтрибут("Code","П"+Расценка.Номер+"."+Строка(сч));
					ЗаписьXML.ЗаписатьАтрибут("SMR",XMLСтрока(Индекс.КоэффПолнСтоимРабот));
					ЗаписьXML.ЗаписатьАтрибут("OZ",XMLСтрока(Индекс.КоэффОснЗарплаты));
					ЗаписьXML.ЗаписатьАтрибут("EM",XMLСтрока(Индекс.КоэффСтоимЭксплМашин));
					ЗаписьXML.ЗаписатьАтрибут("ZM",XMLСтрока(Индекс.КоэффСтоимЗарплатеМашин));
					ЗаписьXML.ЗаписатьАтрибут("MT",XMLСтрока(Индекс.КоэффСтоимМатериалов));
					ЗаписьXML.ЗаписатьКонецЭлемента(); //Index 
					сч = сч + 1;
				КонецЦикла;
			КонецЦикла;
			ЗаписьXML.ЗаписатьКонецЭлемента(); //IndexesPos 
		КонецЕсли;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); //Indexes      
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("VidRab_Catalog");
		ЗаписьXML.ЗаписатьАтрибут("Caption",ПолучитьИмяКаталогаРабот(СтрокаЛС));
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("Vids_Rab");
		ЗаписьXML.ЗаписатьАтрибут("Type","Виды работ 2001г");
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("VidRab_Group");
		ЗаписьXML.ЗаписатьАтрибут("Caption","Общие работы");
		ЗаписьXML.ЗаписатьАтрибут("ID",СтрокаЛС.Номер);
		
		РаботыПозиций = НайтиРаботыПозиций(СтрокаЛС);
		Пока РаботыПозиций.Следующий() Цикл
			ЗаполнитьВидыРабот(РаботыПозиций.Ссылка,ЗаписьXML)
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); //VidRab_Group 
		ЗаписьXML.ЗаписатьКонецЭлемента(); //Vids_Rab
		ЗаписьXML.ЗаписатьКонецЭлемента(); //VidRab_Catalog
		
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("WinterCatalog");
		ЗаписьXML.ЗаписатьАтрибут("WinterMode","None");
		ЗаписьXML.ЗаписатьАтрибут("WinterLinkMode","Table");
		ЗаписьXML.ЗаписатьНачалоЭлемента("CommonWinterK");
		ЗаписьXML.ЗаписатьКонецЭлемента(); //CommonWinterK    
		ЗаписьXML.ЗаписатьКонецЭлемента(); //WinterCatalog    

		ЗаписьXML.ЗаписатьНачалоЭлемента("Chapters");
		ВыборкаРазделов = НайтиРазделы(СтрокаЛС);
		Пока ВыборкаРазделов.Следующий() Цикл
			СтрокаРаздел = ВыборкаРазделов.Раздел;
			ВыборкаРасценок = НайтиРасценки(СтрокаРаздел);
			Если ВыборкаРасценок.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			ЗаписьXML.ЗаписатьНачалоЭлемента("Chapter");
			ЗаписьXML.ЗаписатьАтрибут("Caption",СтрокаРаздел.НаименованиеДляПечати);
			ЗаписьXML.ЗаписатьАтрибут("SysID",СтрокаРаздел.Номер);
			// ЗаписьXML.ЗаписатьАтрибут("IndexCode","Table");
			
			// Если ТипЗнч(СтрокаРаздел.ИДРодителя) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			//	ЗаписьXML.ЗаписатьНачалоЭлемента("Header");
			//	ЗаписьXML.ЗаписатьАтрибут("Caption",СтрокаРаздел.НаименованиеДляПечати);
			//	ЗаписьXML.ЗаписатьКонецЭлемента(); //Header
			// КонецЕсли;
			
			
			Пока ВыборкаРасценок.Следующий() Цикл
				Позиция = ВыборкаРасценок.Ссылка;
                ВывестиПозицию(ЗаписьXML,Позиция,СтрокаЛС);
			КонецЦикла;
			
			ЗаписьXML.ЗаписатьКонецЭлемента(); //Chapter  
		КонецЦикла;
		ЗаписьXML.ЗаписатьКонецЭлемента(); //Chapters    

		ЗаписьXML.ЗаписатьКонецЭлемента(); //Document
		
		ЗаписьXML.Закрыть();
		Если Не ЭтоВеб Тогда
			ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
			АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
			АдресФайлаВоВременномХранилище.Вставить("\"+ИмяФайла+".xml",АдресФайла);
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

Процедура ЗаполнитьВидыРабот(ПозицияЛС,ЗаписьXML)
	 
	КоэффициентКНРНаРемонтБазисный = Строка(ПозицияЛС.КоэффициентКНРНаРемонтБазисный)+?(ПозицияЛС.ПоправочныйКоэффициентКНРБазисный=0,"","*"+Строка(ПозицияЛС.ПоправочныйКоэффициентКНРБазисный));
	КоэффициентКСПНаРемонтБазисный = Строка(ПозицияЛС.КоэффициентКСПНаРемонтБазисный)+?(ПозицияЛС.ПоправочныйКоэффициентКСПБазисный=0,"","*"+Строка(ПозицияЛС.ПоправочныйКоэффициентКСПБазисный));
	КоэффициентКНРНаРемонтТекущий = Строка(ПозицияЛС.КоэффициентКНРНаРемонтТекущий)+?(ПозицияЛС.ПоправочныйКоэффициентКНРТекущий=0,"","*"+Строка(ПозицияЛС.ПоправочныйКоэффициентКНРТекущий));
	КоэффициентКСПНаРемонтТекущий = Строка(ПозицияЛС.КоэффициентКСПНаРемонтТекущий)+?(ПозицияЛС.ПоправочныйКоэффициентКСПТекущий=0,"","*"+Строка(ПозицияЛС.ПоправочныйКоэффициентКСПТекущий));
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("Vid_Rab");
	ЗаписьXML.ЗаписатьАтрибут("Caption",ПозицияЛС.ВидРабот);
	ЗаписьXML.ЗаписатьАтрибут("ID",ПозицияЛС.Номер);
	ЗаписьXML.ЗаписатьАтрибут("Nacl",XMLСтрока(ПозицияЛС.НакладныеРасходыБазисные));
	ЗаписьXML.ЗаписатьАтрибут("NaclCurr",XMLСтрока(ПозицияЛС.НакладныеРасходыТекущие));
	ЗаписьXML.ЗаписатьАтрибут("Plan",XMLСтрока(ПозицияЛС.СметнаяПрибыльБазисные));
	ЗаписьXML.ЗаписатьАтрибут("PlanMask",XMLСтрока(ПозицияЛС.СметнаяПрибыльТекущие));
	ЗаписьXML.ЗаписатьАтрибут("NKB",XMLСтрока(КоэффициентКНРНаРемонтБазисный));
	ЗаписьXML.ЗаписатьАтрибут("PNB",XMLСтрока(КоэффициентКСПНаРемонтБазисный));
	ЗаписьXML.ЗаписатьАтрибут("NKI",XMLСтрока(КоэффициентКНРНаРемонтТекущий));
	ЗаписьXML.ЗаписатьАтрибут("PKI",XMLСтрока(КоэффициентКСПНаРемонтТекущий));
	ЗаписьXML.ЗаписатьАтрибут("NKR",XMLСтрока(КоэффициентКНРНаРемонтТекущий));
	ЗаписьXML.ЗаписатьАтрибут("PKR",XMLСтрока(КоэффициентКСПНаРемонтТекущий));
	ЗаписьXML.ЗаписатьКонецЭлемента(); //Vid_Rab 

КонецПроцедуры

Функция ПолучитьИмяКаталогаРабот(Смета)
	Если Смета.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт
		И Смета.ТипРайона = Перечисления.СМ_ТипыРайонов.НеОтносится
		И Смета.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ПрименятьНРиСП Тогда
		Возврат "Ремонт жил Основной";
	ИначеЕсли Смета.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт
		И Смета.ТипРайона = Перечисления.СМ_ТипыРайонов.Приравнен
		И Смета.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ПрименятьНРиСП Тогда
		Возврат "Ремонт жил Районы приравненные к Крайнему Северу";
	ИначеЕсли Смета.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.КапитальныйРемонт
		И Смета.ТипРайона = Перечисления.СМ_ТипыРайонов.Приравнен
		И Смета.ПрименятьКоэффициентыНРСП = Перечисления.СМ_НРИСПДляСметыНаРемонт.ТолькоСП Тогда
		Возврат "Ремонт нежил Районы приравненные к Крайнему Северу";
	ИначеЕсли Смета.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.НовоеСтроительство
		И Смета.ТипРайона = Перечисления.СМ_ТипыРайонов.НеОтносится Тогда
		Возврат "Основной справочник видов работ";
	ИначеЕсли Смета.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.НовоеСтроительство
		И Смета.ТипРайона = Перечисления.СМ_ТипыРайонов.Приравнен Тогда
		Возврат "Районы приравненные к Крайнему Северу";
	ИначеЕсли Смета.ТипСтроительства = Перечисления.СМ_ТипыСтроительства.НовоеСтроительство
		И Смета.ТипРайона = Перечисления.СМ_ТипыРайонов.Относится Тогда
		Возврат "Районы Крайнего Севера";
	Иначе	
		Возврат "";
	КонецЕсли;
	
	
КонецФункции

Процедура ВывестиПозицию(ЗаписьXML,Позиция,СтрокаЛС)
	ЗаписьXML.ЗаписатьНачалоЭлемента("Position");
	ЗаписьXML.ЗаписатьАтрибут("Caption",Позиция.Наименование);
	ЗаписьXML.ЗаписатьАтрибут("Number",Позиция.Номер);
	ЗаписьXML.ЗаписатьАтрибут("Code",Позиция.ШифрРасценки);
	ЗаписьXML.ЗаписатьАтрибут("Units",Позиция.Измеритель);
