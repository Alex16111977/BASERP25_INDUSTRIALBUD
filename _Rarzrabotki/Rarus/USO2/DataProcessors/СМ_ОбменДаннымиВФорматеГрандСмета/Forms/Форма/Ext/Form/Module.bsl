	ИначеЕсли Не ИзФайла И ЗначениеЗаполнено(КаталогЗагрузки) Тогда
		
		// Синхронный вызов
		//СписокФайлов = НайтиФайлы(Этаформа.КаталогЗагрузки,"*.*"); 
		//Для Каждого ТекФайл Из СписокФайлов Цикл
		//	Если ТекФайл.ЭтоКаталог() Тогда
		//		Продолжить;
		//	КонецЕсли;
		//	НовСвед 									= СведенияФайлов.Добавить();
		//	НовСвед.Загрузка_ИмяФайла 					= ТекФайл.ИмяБезРасширения;
		//	ДвоичныеДанные 								= Новый ДвоичныеДанные(ТекФайл.ПолноеИмя);
		//	АдресВременногоХранилища 					= ПоместитьВоВременноеХранилище(ДвоичныеДанные,ЭтаФорма.УникальныйИдентификатор);
		//	НовСвед.Загрузка_ПолныйПуть 				= ТекФайл.ПолноеИмя;
		//	НовСвед.Загрузка_АдресВременногоХранилища 	= АдресВременногоХранилища;
		//КонецЦикла;
		
		// Замена на асинхронный вызов
		ОповещениеПоиска = Новый ОписаниеОповещения("ВыполнитьПослеПоискаФайлов", ЭтотОбъект);
		НачатьПоискФайлов(ОповещениеПоиска,Этаформа.КаталогЗагрузки,"*.*");
	КонецЕсли;
	СостояниеКнопок = 1;
	ВидимостьКнопок();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеПоискаФайлов(НайденныеФайлы, ДополнительныеПараметры) Экспорт
	
	Для Каждого ТекФайл Из НайденныеФайлы Цикл
		Если ТекФайл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		НовСвед 									= СведенияФайлов.Добавить();
		НовСвед.Загрузка_ИмяФайла 					= ТекФайл.ИмяБезРасширения;
		ДвоичныеДанные 								= Новый ДвоичныеДанные(ТекФайл.ПолноеИмя);
		АдресВременногоХранилища 					= ПоместитьВоВременноеХранилище(ДвоичныеДанные,ЭтаФорма.УникальныйИдентификатор);
		НовСвед.Загрузка_ПолныйПуть 				= ТекФайл.ПолноеИмя;
		НовСвед.Загрузка_АдресВременногоХранилища 	= АдресВременногоХранилища;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных.Видимость = Ложь;
	#Если ВебКлиент Тогда
		Элементы.КаталогЗагрузки = Ложь;
		Элементы.ПутьСохранения.Видимость = Ложь;
	#КонецЕсли
	СтраницаФайлов();
	ПоказатьТаблицыДанныхПриИзменении();
	
	Если ЗначениеЗаполнено(Параметры.ИмяФайла) Тогда
		ИзФайла = Истина;
		ИзФайлаПриИзменении(Неопределено);
		КаталогЗагрузки = Параметры.ИмяФайла; 
		ОпределитьПервичныеПараметрыФайлов();
	КонецЕсли;
	СостояниеКнопок = 1;
	ВидимостьКнопок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТаблицыДанныхПриИзменении()
	
	ТекСтатус = ЭтаФорма.ПоказатьТаблицыДанных;
	
	Элементы.ТаблицыДанных.Видимость 		    = ТекСтатус;
	Элементы.СтраницаЛимЗатраты.Видимость 		= ТекСтатус;
	Элементы.СтраницаАктыСметы.Видимость        = ТекСтатус;
	Элементы.СтраницаИндексы.Видимость          = ТекСтатус;
	Элементы.СтраницаВидыРабот.Видимость 		= ТекСтатус;
	Элементы.СтраницаРазделы.Видимость          = ТекСтатус;
	Элементы.СтраницаПозицииЛС.Видимость        = ТекСтатус;
	Элементы.СтраницаКоэффициенты.Видимость     = ТекСтатус;
	Элементы.СтраницаРесурсы.Видимость          = ТекСтатус;
	Элементы.СтраницаКомментарии.Видимость      = ТекСтатус;
	Элементы.СтраницаПоправки.Видимость         = ТекСтатус;
	Элементы.СтраницаСоставРабот.Видимость      = ТекСтатус;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеФайла(Команда)
	
	ЭтаФорма.СоответствияРесурсов.Очистить();
	ЭтаФорма.СоответствияЛЗ.Очистить();
	ЭтаФорма.СоответствияПрефиксов.Очистить();
	ЭтаФорма.ЗагрузкаДанных 	= Истина;
	Если ИзФайла Тогда
		СведенияФайлов[0].Район = Район;
		СведенияФайлов[0].СметноНормативнаяБаза = СметноНормативнаяБаза;
		СведенияФайлов[0].НомерСметы = НомерСметы;
		СведенияФайлов[0].НаименованиеСметы = НаименованиеСметы;
		//СведенияФайлов[0].Стройка = Стройка;
		Если ЗначениеЗаполнено(Стройка) Тогда
			СведенияФайлов[0].Стройка = Стройка;	
		КонецЕсли;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭтаФорма.КаталогЗагрузки) Тогда
		ПодключитьОбработчикОжидания("Подключаемый_ЗапуститьВыполнениеЗадания",1,Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбран файл для загрузки данных!'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьДокументы(Команда)
	Если ИзФайла Тогда
		Район = СведенияФайлов[0].Район;
		СметноНормативнаяБаза = СведенияФайлов[0].СметноНормативнаяБаза;
		НомерСметы = СведенияФайлов[0].НомерСметы;
		НаименованиеСметы = СведенияФайлов[0].НаименованиеСметы;
		Стройка = СведенияФайлов[0].Стройка;
	КонецЕсли;

	ЭтаФорма.ЗагрузкаДанных = Ложь;
	СписокОшибок 			= Новый СписокЗначений;
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ДатаСметы) Тогда
		СписокОшибок.Добавить(1,"Не заполнено поле - дата локальной сметы");
	КонецЕсли;

	Если ИзФайла Тогда
		
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.НомерСметы) Тогда
			СписокОшибок.Добавить(2,"Не заполнено поле - номер локальной сметы");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.НаименованиеСметы) Тогда
			СписокОшибок.Добавить(3,"Не заполнено поле - наименование локальной сметы");
		КонецЕсли;
		
		
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.Стройка) Тогда
			СписокОшибок.Добавить(6,"Не заполнено поле - стройка");
		КонецЕсли;
		
		
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.Район) Тогда
			СписокОшибок.Добавить(8,"Не заполнено поле - район");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.СметноНормативнаяБаза) Тогда
			СписокОшибок.Добавить(11,"Не заполнено поле - региональная база");
		КонецЕсли;
	Иначе
		Для Каждого СтрФайл Из СведенияФайлов Цикл
			Если НЕ ЗначениеЗаполнено(СтрФайл.НомерСметы) Тогда
				СписокОшибок.Добавить(2,"Не заполнено поле - номер локальной сметы");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрФайл.НаименованиеСметы) Тогда
				СписокОшибок.Добавить(3,"Не заполнено поле - наименование локальной сметы");
			КонецЕсли;
			
			
			Если НЕ ЗначениеЗаполнено(СтрФайл.Стройка) Тогда
				СписокОшибок.Добавить(6,"Не заполнено поле - стройка");
			КонецЕсли;
			
			
			Если НЕ ЗначениеЗаполнено(СтрФайл.Район) Тогда
				СписокОшибок.Добавить(8,"Не заполнено поле - район");
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(СтрФайл.СметноНормативнаяБаза) Тогда
				СписокОшибок.Добавить(11,"Не заполнено поле - региональная база");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Организация) Тогда
		СписокОшибок.Добавить(4,"Не заполнено поле - организация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Заказчик) Тогда
		СписокОшибок.Добавить(5,"Не заполнено поле - заказчик");
	КонецЕсли;

	Если СписокОшибок.Количество() > 0 Тогда
		Для Каждого ТекЭлемент Из СписокОшибок Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("" + ТекЭлемент.Представление);	
		КонецЦикла;	
		Возврат;
	КонецЕсли;
	
	ЗаписатьСоответствияАРПС();
	
	ПодключитьОбработчикОжидания("Подключаемый_ЗапуститьВыполнениеЗадания", 1, Истина);
	

КонецПроцедуры

&НаСервере
Процедура ЗаписатьСоответствияАРПС()
	
	Если ЭтаФорма.СоответствияПрефиксов.Количество()>0 Тогда
		Для Каждого Стр Из ЭтаФорма.СоответствияПрефиксов Цикл
			РС_Префиксы = РегистрыСведений.СМ_АРПС_ПрефиксыОбъектов.СоздатьНаборЗаписей();
			РС_Префиксы.Отбор.СметнаяПрограмма.Установить(ЭтаФорма.СметнаяПрограмма);
			РС_Префиксы.Отбор.СтрокаПрефикса.Установить(Стр.СтрокаПрефикса); 
			РС_Префиксы.Прочитать(); 
			Если РС_Префиксы.Количество() = 0 Тогда
				НоваяЗапись								= РС_Префиксы.Добавить();
				НоваяЗапись.СметнаяПрограмма 			= ЭтаФорма.СметнаяПрограмма;
				НоваяЗапись.СтрокаПрефикса 				= Стр.СтрокаПрефикса;
				НоваяЗапись.ТипНормативногоСборника 	= Стр.ТипНормативногоСборника;
				НоваяЗапись.Определитель 				= Стр.Определитель;
				НоваяЗапись.ВидРесурса 					= Стр.ВидРесурса;
				НоваяЗапись.СоздаватьЗаписиВСправочнике = стр.СоздаватьЗаписиВСправочнике;
				НоваяЗапись.НеОтбрасыватьПрефикс = стр.НеОтбрасыватьПрефикс;
		
				НоваяЗапись.РедактироваласьПользователем = Истина;
				РС_Префиксы.Записать(Ложь);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
	Для Каждого Стр Из ЭтаФорма.СоответствияРесурсов Цикл
		Если Стр.СсылкаВБазе.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		РС_Шифр = РегистрыСведений.СМ_АРПС_СоответствияШифров.СоздатьНаборЗаписей();
		РС_Шифр.Отбор.СметнаяПрограмма.Установить(ЭтаФорма.СметнаяПрограмма);
		РС_Шифр.Отбор.ШифрАРПС.Установить(Стр.КодРесурса); 
		РС_Шифр.Прочитать(); 
		
		Если РС_Шифр.Количество() = 0 Тогда
			НоваяЗапись									= РС_Шифр.Добавить();
			НоваяЗапись.СметнаяПрограмма 				= ЭтаФорма.СметнаяПрограмма;
			НоваяЗапись.ШифрАРПС 						= Стр.КодРесурса;
			НоваяЗапись.Шифр 							= Стр.СсылкаВБазе.Код;
			НоваяЗапись.Ресурс 							= Стр.СсылкаВБазе;
			НоваяЗапись.РедактироваласьПользователем 	= Истина;
			РС_Шифр.Записать(Ложь);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Стр Из ЭтаФорма.СоответствияЛЗ Цикл
		
		Если Стр.НеЯвляетсяЛЗ Тогда
			РС_ЛимЗатрат = РегистрыСведений.СМ_АРПС_Итоги.СоздатьНаборЗаписей();
			РС_ЛимЗатрат.Отбор.НаименованиеЛимзатратыАРПС.Установить(Стр.НаименованиеЛЗ);
			РС_ЛимЗатрат.Прочитать(); 
			Если РС_ЛимЗатрат.Количество() = 0 Тогда
				НоваяЗапись									= РС_ЛимЗатрат.Добавить();
				НоваяЗапись.НаименованиеЛимзатратыАРПС 		= Стр.НаименованиеЛЗ;
				НоваяЗапись.РедактироваласьПользователем 	= Истина;
				РС_ЛимЗатрат.Записать(Ложь);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если Стр.СсылкаВБазе.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		РС_ЛимЗатрат = РегистрыСведений.СМ_АРПС_СоответствияЛимЗатрат.СоздатьНаборЗаписей();
		РС_ЛимЗатрат.Отбор.СметнаяПрограмма.Установить(ЭтаФорма.СметнаяПрограмма);
		РС_ЛимЗатрат.Отбор.НаименованиеЛимзатратыАРПС.Установить(Стр.НаименованиеЛЗ);
		РС_ЛимЗатрат.Прочитать(); 
		Если РС_ЛимЗатрат.Количество() = 0 Тогда
			НоваяЗапись 								= РС_ЛимЗатрат.Добавить();
			НоваяЗапись.СметнаяПрограмма 				= ЭтаФорма.СметнаяПрограмма;
			НоваяЗапись.НаименованиеЛимзатратыАРПС 		= Стр.НаименованиеЛЗ;
			НоваяЗапись.ИдентификаторЛимЗатраты 		= Стр.СсылкаВБазе.Идентификатор;
			НоваяЗапись.ЛимЗатрата 						= Стр.СсылкаВБазе;
			НоваяЗапись.НаименованиеЛимзатраты 			= Стр.СсылкаВБазе.Наименование;
			НоваяЗапись.РедактироваласьПользователем 	= Истина;
			РС_ЛимЗатрат.Записать(Ложь);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция глВывестиТЗНаФорму(тРезультат, текФорма, имяЭлементаРазмещения, префиксРеквизита = "автоРеквизит", ИмяРодителя = неопределено, мПроцедур = неопределено, видимостьКПанели = ложь)

	Попытка  
		//  отображение произвольной таблицы - результата запроса на форме
	    МассивДобавляемыхРеквизитов = Новый Массив;
	    МассивУдаляемыхРеквизитов 	= Новый Массив;
				
		Для Каждого Колонка Из тРезультат.Колонки Цикл
			//  установка имени колонки по заголовку
			Если Колонка.Заголовок <> "" Тогда 
				ЗаголовокКолонки = Колонка.Заголовок;
			Иначе 
				ЗаголовокКолонки = Колонка.Имя;
			КонецЕсли; 
	        МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, имяЭлементаРазмещения, ЗаголовокКолонки));
			Если текФорма.Элементы.Найти(префиксРеквизита+"_" + Колонка.Имя) <> Неопределено Тогда
	            МассивУдаляемыхРеквизитов.Добавить(нрег(имяЭлементаРазмещения+"." + Колонка.Имя));
	        КонецЕсли;
		КонецЦикла;
		
		//  Если на форме остались реквизиты "автоРеквизита" (при выводе различной структуры), то удалим и их.
		Попытка 
			МассивУдаляемыхРеквизитов2 = Новый Массив;
			Для каждого элем Из текФорма.Элементы[префиксРеквизита].ПодчиненныеЭлементы Цикл
				имяТекРеквизита = стрЗаменить(элем.Имя,префиксРеквизита+"_","");
				МассивУдаляемыхРеквизитов2.Добавить(нрег(имяЭлементаРазмещения+"." + имяТекРеквизита));  
			КонецЦикла;
			  			
			//  добавим необходимые реквизиты (отсуствующие) в МассивУдаляемыхРеквизитов
			Для каждого недостающий Из МассивУдаляемыхРеквизитов2 Цикл 
				Если МассивУдаляемыхРеквизитов.Найти(недостающий) = неопределено Тогда 
					МассивУдаляемыхРеквизитов.Добавить(недостающий); 
				КонецЕсли;  
			КонецЦикла; 
		Исключение 	
			Событие = НСтр("ru = 'Исключение Гранд-смета'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
		КонецПопытки;
 
	    текФорма.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов,МассивУдаляемыхРеквизитов);      
	    
		ЭлементФормы = текФорма.Элементы.Найти(префиксРеквизита);
		Если ЭлементФормы <> Неопределено Тогда
			текФорма.Элементы.Удалить(ЭлементФормы);
		КонецЕсли;
		
		// Зайцев 22072015
		Родитель = текФорма.Элементы.Найти(ИмяРодителя);
		Если Родитель = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось найти элемент формы %1'"),ИмяРодителя));
			Возврат Ложь;
		КонецЕсли;
		
		//  Создание элемента "Табличное поле" на форме
		ЭлементДерево 				= текФорма.Элементы.Добавить(префиксРеквизита,Тип("ТаблицаФормы"), Родитель);
		ЭлементДерево.ПутьКДанным 	= имяЭлементаРазмещения;
		ЭлементДерево.Отображение 	= ОтображениеТаблицы.Дерево;
		Если мПроцедур <> неопределено Тогда 
			Для каждого новПроцедура Из мПроцедур Цикл 
				ЭлементДерево.УстановитьДействие(новПроцедура,новПроцедура+"АвтоРеквизитов");  
			КонецЦикла;  
		КонецЕсли; 
		
		// ЭлементДерево.КоманднаяПанель.Доступность = ложь;		
		Если НЕ видимостьКПанели Тогда 
			ЭлементДерево.ПоложениеКоманднойПанели  = положениеКоманднойПанелиЭлементаФормы.Нет; 
		КонецЕсли; 		
			
		//  Создание колонок для элемента "Табличное поле"	
		Для Каждого Колонка Из тРезультат.Колонки Цикл
			НовыйЭлемент 	 			= ТекФорма.Элементы.Добавить(префиксРеквизита+"_" + Колонка.Имя, Тип("ПолеФормы"), ЭлементДерево);
			НовыйЭлемент.ПутьКДанным 	= ИмяЭлементаРазмещения+"." + Колонка.Имя;

			Если Колонка.ТипЗначения.СодержитТип(Тип("Булево")) Тогда 
				НовыйЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
			Иначе
				НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
			КонецЕсли;
			
		КонецЦикла; 
		
		Попытка 
			Для каждого Элем Из ЭлементДерево.ПодчиненныеЭлементы Цикл 
				//  выявим числовые поля и сделаем их значительно уже текстовых
				стрПути 	= элем.ПутьКДанным;
				поз 		= найти(стрПути,".");			
				имяКолонки 	= прав(стрПути,стрДлина(стрПути)-поз);
				типТекущейКолонки = тРезультат.Колонки[имяКолонки].ТипЗначения;
				Если типТекущейКолонки.СодержитТип(тип("Строка")) Тогда 
					элем.Ширина = 20;
				ИначеЕсли типТекущейКолонки.СодержитТип(тип("Число")) Тогда
					элем.Ширина = 3;
				КонецЕсли; 
			КонецЦикла;  
		Исключение 
			Событие = НСтр("ru = 'Исключение Гранд-смета'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
		КонецПопытки;
		
		Возврат истина;			  
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки()); 
	    Возврат ложь;
	КонецПопытки;

КонецФункции //  глВывестиТЗНаФорму()

&НаКлиенте
Процедура Подключаемый_ЗапуститьВыполнениеЗадания()
	
	Если ЭтаФорма.ЗагрузкаДанных Тогда
		Результат 				= ЗапуститьЗадание();
		ИдентификаторЗадания 	= Результат.ИдентификаторЗадания;
		АдресХранилища 		 	= Результат.АдресХранилища;
	Иначе
		Результат 				= ЗапуститьЗаданиеДокументы();	
		ИдентификаторЗадания 	= Результат.ИдентификаторЗадания;
		АдресХранилища 		 	= Результат.АдресХранилища	
	КонецЕсли;	
		
	Если Результат.ЗаданиеВыполнено Тогда
		ОбработкаРезультата();
		Если ЭтаФорма.ЗагрузкаДанных Тогда
			Если ЭтаФорма.СоответствияЛЗ.Количество() > 0 ИЛИ ЭтаФорма.СоответствияРесурсов.Количество() > 0 ИЛИ ЭтаФорма.СоответствияПрефиксов.Количество() > 0 Тогда
				ПоказатьПредупреждение(,НСтр("ru='Требуется заполнить соответствия ресурсов, лимитированных затрат и префиксов..'"));
				Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных.Видимость = Истина;
				Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных;
				Если ЭтаФорма.СоответствияПрефиксов.Количество() > 0 Тогда 
					Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответствияПрефиксов;
				ИначеЕсли ЭтаФорма.СоответствияРесурсов.Количество() > 0 Тогда
					Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответствияРесурсов;					
				ИначеЕсли ЭтаФорма.СоответствияЛЗ.Количество() > 0 Тогда
					Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответсвияЛЗ;
				КонецЕсли;
			Иначе
				Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных.Видимость = Ложь;
			КонецЕсли;
			ВидимостьСтраницСоответствия();
			СостояниеКнопок = 2;
			ВидимостьКнопок();
		Иначе
			Если Результат.Свойство("ТабСообщения") Тогда
				Для Каждого ТекСтрока Из Результат.ТабСообщения Цикл
					Событие = НСтр("ru = 'Загрузка Гранд-смета'");
					СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие,Ложь,ТекСтрока.ТекстСообщения);
				КонецЦикла;
			КонецЕсли;
			СостояниеКнопок = 3;
			ВидимостьКнопок();
			Оповестить("ОбновитьДеревоСмет");
			Оповестить("ИмпортШаблон",Загрузка_СозданныйДокумент);
		КонецЕсли;	
	Иначе
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтаФорма, Результат.ИдентификаторЗадания);
	КонецЕсли;  		
		
		
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ФормаДлительнойОперации.Открыта() И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда 
				ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
				ОбработкаРезультата();
				Если ЭтаФорма.ЗагрузкаДанных Тогда
					Если ЭтаФорма.СоответствияЛЗ.Количество() > 0 ИЛИ ЭтаФорма.СоответствияРесурсов.Количество() > 0 ИЛИ ЭтаФорма.СоответствияПрефиксов.Количество() > 0 Тогда
						ПоказатьПредупреждение(,НСтр("ru='Требуется заполнить соответствия ресурсов, лимитированных затрат и префиксов..'"));
						Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных.Видимость = Истина;
						Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных;
						Если ЭтаФорма.СоответствияПрефиксов.Количество() > 0 Тогда 
							Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответствияПрефиксов;
						ИначеЕсли ЭтаФорма.СоответствияРесурсов.Количество() > 0 Тогда
							Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответствияРесурсов;					
						ИначеЕсли ЭтаФорма.СоответствияЛЗ.Количество() > 0 Тогда
							Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницыТаблиц.ПодчиненныеЭлементы.СтраницаСоответсвияЛЗ;
						КонецЕсли;
					Иначе
						Элементы.ГруппаСтраниц.ПодчиненныеЭлементы.ТаблицыДанных.Видимость = Ложь;
					КонецЕсли;
					ВидимостьСтраницСоответствия();
					СостояниеКнопок = 2;
					ВидимостьКнопок();
				Иначе
					Оповестить("ОбновитьДеревоСмет");
					Оповестить("ИмпортШаблон",Загрузка_СозданныйДокумент);
					СостояниеКнопок = 3;
					ВидимостьКнопок();
				КонецЕсли;	
			Иначе
				ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
				ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания",ПараметрыОбработчикаОжидания.ТекущийИнтервал,Истина);
			КонецЕсли;
		КонецЕсли;
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ЗаписатьИсключениеНаСервере(ПредставлениеОшибки);
		ПоказатьПредупреждение(,НСтр("ru='Произошла ошибка. Подробности в журнале регистрации.'"));
	КонецПопытки;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

&НаСервере
Процедура ЗаписатьИсключениеНаСервере(Знач ПредставлениеОшибки)
	
	Событие = НСтр("ru = 'Ошибка в задании'");
	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПредставлениеОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидимостьСтраницСоответствия()
	
	Элементы.СтраницаСоответствияПрефиксов.Видимость 	= (ЭтаФорма.СоответствияПрефиксов.Количество() > 0);
	Элементы.СтраницаСоответствияРесурсов.Видимость  	= (ЭтаФорма.СоответствияРесурсов.Количество() > 0);					
	Элементы.СтраницаСоответсвияЛЗ.Видимость  			= (ЭтаФорма.СоответствияЛЗ.Количество() > 0);
	
КонецПроцедуры

&НаСервере
Функция ЗапуститьЗадание()
	
	// Таблица локальных смет
	ТабДокументов = Новый ТаблицаЗначений;
	ТабДокументов.Колонки.Добавить("НаименованиеСметы");
	ТабДокументов.Колонки.Добавить("ИДсметы");
	ТабДокументов.Колонки.Добавить("НомерСметы");
	ТабДокументов.Колонки.Добавить("Акт");
	ТабДокументов.Колонки.Добавить("ИДакта");
	ТабДокументов.Колонки.Добавить("НомерАкта");
	ТабДокументов.Колонки.Добавить("SysID");
	ТабДокументов.Колонки.Добавить("ДатаАкта");
	ТабДокументов.Колонки.Добавить("ПериодОт");
	ТабДокументов.Колонки.Добавить("ПериодДо");
	// RegionInfo
	ТабДокументов.Колонки.Добавить("RegionName");
