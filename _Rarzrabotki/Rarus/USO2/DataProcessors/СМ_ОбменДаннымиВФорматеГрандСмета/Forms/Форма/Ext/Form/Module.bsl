&НаСервере
Функция ЗапуститьЗаданиеДокументы()

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТабДокументов",РеквизитФормыВЗначение("ДокументыАктСмета"));
	СтруктураПараметров.Вставить("ТабИндексов",РеквизитФормыВЗначение("Индексы"));
	СтруктураПараметров.Вставить("ТабРазделов",РеквизитФормыВЗначение("Разделы"));
	СтруктураПараметров.Вставить("ТабПозицийЛС",РеквизитФормыВЗначение("ПозицииЛС"));
	СтруктураПараметров.Вставить("ТабРесурсов",РеквизитФормыВЗначение("Ресурсы"));
	СтруктураПараметров.Вставить("ТабЛимЗатраты",РеквизитФормыВЗначение("ЛимЗатраты"));
	СтруктураПараметров.Вставить("ТабВидовРабот",РеквизитФормыВЗначение("ВидыРабот"));
	СтруктураПараметров.Вставить("ТабПоправки",РеквизитФормыВЗначение("КоэффициентыПоправки"));
	СтруктураПараметров.Вставить("ТабРаботы", РеквизитФормыВЗначение("СоставРабот"));
	СтруктураПараметров.Вставить("ТабСоответствияПрефиксов",РеквизитФормыВЗначение("СоответствияПрефиксов"));
	СтруктураПараметров.Вставить("ТабСоответствияРесурсов",РеквизитФормыВЗначение("СоответствияРесурсов"));
	СтруктураПараметров.Вставить("ТабСоответствияЛЗ",РеквизитФормыВЗначение("СоответствияЛЗ"));
