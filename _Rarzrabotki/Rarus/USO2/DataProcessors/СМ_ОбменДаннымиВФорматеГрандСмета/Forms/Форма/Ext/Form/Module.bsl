#Область СлужебныеПроцедурыИФункции

Перем ДокСсылка;
Перем ПрефиксыПрограммы;

&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

&НаКлиенте
Перем ФормаДлительнойОперации;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Возврат при получении формы для анализа.
	Если Параметры.Свойство("АвтоТест") Тогда 
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ДатаСметы 		  	= ТекущаяДатаСеанса();
	ЭтаФорма.СметнаяПрограмма 	= Справочники.СМ_СметныеПрограммы.ГрандСмета;
	
	ЗаполнитьНастройкиПользователяПоУмолчанию();

	Если Параметры.Свойство("Загрузка") Тогда
		Если Параметры.Загрузка Тогда
			Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.СтраницаЗагрузка;
			Элементы.СтраницаВыгрузка.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("Ключ") Тогда
		Если Параметры.Ключ = "ДеревоСметВыгрузка" Тогда
			Для каждого эл Из Параметры.СписокВыгрузки Цикл
				СтрСмета = Объект.ОтборСмет.Добавить();
				СтрСмета.ЛокальнаяСмета = эл.Значение;
			КонецЦикла;
			Элементы.СтраницаЗагрузка.Видимость = Ложь;
			Элементы.ТаблицыДанных.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Процедура заполняет реквизиты объекта данными из настроек пользователя (значениями по умолчанию).
//
// Параметры:
//     ТекОбъект - Объект, реквизиты которого заполняются.
//     Форма - Контекст формы обработки.
//
&НаСервере
Процедура ЗаполнитьНастройкиПользователяПоУмолчанию()
	ЭтаФорма.Стройка 				= ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкиПользователяСмета","ОсновнаяСтройка");
	ЭтаФорма.Организация = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ЭтаФорма.Стройка,"ОсновнаяОрганизация");	
	ЭтаФорма.Район = СМ_СметаВызовСервера.ПолучитьНастройкуПользователяПообъектно(ЭтаФорма.Стройка,"ОсновнойРайон");	
	ЭтаФорма.СметноНормативнаяБаза 	= Справочники.СМ_СметноНормативныеБазы.ПолучитьПоРайону(ЭтаФорма.Район);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФайлаКаталога(Файл = Истина)
	
	СведенияФайлов.Очистить();
	Если Файл Тогда	
		Диалог 				= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ФильтрДляДиалога 	= "Гранд смета (*.xml)|*.xml";
		ФильтрДляДиалога 	= ФильтрДляДиалога + "|Все файлы (*.*)|*.*";
		Диалог.Фильтр 		= ФильтрДляДиалога;
		
		// Синхронный вызов
		//Если Диалог.Выбрать() Тогда
		//	КаталогЗагрузки = Диалог.ПолноеИмяФайла;
		//	ОпределитьПервичныеПараметрыФайлов();
		//КонецЕсли;
		
		// Замена на асинхронный вызов
		ОповещениеВыбора = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект);
		Диалог.Показать(ОповещениеВыбора);
	Иначе
		Диалог 			= Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		Диалог.Фильтр 	= "";
		
		// Синхронный вызов
		//Если Диалог.Выбрать() Тогда
		//	КаталогЗагрузки = Диалог.Каталог;
		//	ОпределитьПервичныеПараметрыФайлов();
		//КонецЕсли;
		
		// Замена на асинхронный вызов
		ОповещениеВыбора = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект);
		Диалог.Показать(ОповещениеВыбора);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайла(ВыбранныеФайлы,ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ВыбранныеФайлы Цикл
			КаталогЗагрузки = ТекЭлемент;
			ОпределитьПервичныеПараметрыФайлов();
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗагрузкаКаталогЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СведенияФайлов.Очистить();
	ВыборФайлаКаталога(ИзФайла);
КонецПроцедуры

&НаКлиенте
