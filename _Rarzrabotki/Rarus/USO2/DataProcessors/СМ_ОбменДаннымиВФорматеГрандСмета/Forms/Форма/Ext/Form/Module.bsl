&НаСервере
Процедура ОбработкаРезультата()
	
	Для Каждого Стр Из СведенияФайлов Цикл
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",Стр.Загрузка_ПолныйПуть)); 
		Если Запись.Следующий() Тогда
			Запись.ПолучитьМенеджерЗаписи().Удалить();
		КонецЕсли;
	КонецЦикла;

	РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтаФорма.ЗагрузкаДанных Тогда
		//  Вывод таблицы документов ЛС на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабДокументов,ЭтаФорма,"ДокументыАктСмета","ТабДок","СтраницаАктыСметы") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабДокументов,"ДокументыАктСмета");
		КонецЕсли; 
		
		// Вывод таблицы индексов на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабИндексов,ЭтаФорма,"Индексы","ТабИндексы","СтраницаИндексы") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабИндексов,"Индексы");
		КонецЕсли; 
		
		//  Вывод таблицы позиций на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабПозицийЛС,ЭтаФорма,"ПозицииЛС","ТабПоз","СтраницаПозицииЛС") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабПозицийЛС,"ПозицииЛС");
		КонецЕсли; 
		
		//  Вывод таблицы разделов на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабРазделов,ЭтаФорма,"Разделы","ТабРазделы","СтраницаРазделы") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабРазделов,"Разделы");
		КонецЕсли; 
		
		//  Вывод таблицы ресурсов на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабРесурсов,ЭтаФорма,"Ресурсы","ТабРес","СтраницаРесурсы") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабРесурсов,"Ресурсы");
		КонецЕсли; 	
		
		// Вывод таблицы видов работ на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабВидовРабот,ЭтаФорма,"ВидыРабот","ТабВидовРабот","СтраницаВидыРабот") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабВидовРабот,"ВидыРабот");
		КонецЕсли;	
		
		// Вывод таблицы коэффициентов/поправок на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабПоправки,ЭтаФорма,"КоэффициентыПоправки","ТабКоэффПоправки","СтраницаПоправки") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабПоправки,"КоэффициентыПоправки");
		КонецЕсли;	
		
		// Вывод таблицы состава работ на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабРаботы,ЭтаФорма,"СоставРабот","ТабСоставРабот","СтраницаСоставРабот") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабРаботы,"СоставРабот");
		КонецЕсли;	
		
		// Вывод таблицы лимитированных затрат на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабЛимЗатраты,ЭтаФорма,"ЛимЗатраты","ТабЛимитированныеЗатраты","СтраницаЛимЗатраты") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабЛимЗатраты,"ЛимЗатраты");
		КонецЕсли;	
		
		// Вывод таблицы подписи на форму
		Если глВывестиТЗНаФорму(РезультатВыполнения.ТабПодписи,ЭтаФорма,"ТаблицаПодписи","ТабПодписиДокументов","СтраницаПодписи") Тогда 
			ЗначениеВРеквизитФормы(РезультатВыполнения.ТабПодписи,"ТаблицаПодписи");
		КонецЕсли;	

		Для Каждого ТекСтрока Из РезультатВыполнения.ТабСообщения Цикл
			Событие = НСтр("ru = 'Загрузка Гранд-смета'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие,Ложь,ТекСтрока.ТекстСообщения);
		КонецЦикла;
	
		// Свернуть таблицу соответствия ресурсов
		ТабСоответствияРес = РезультатВыполнения.ТекФорма.СоответствияРесурсов;
		ТабСоответствияРес.Свернуть("НаименованиеРесурса,КодРесурса,СсылкаВБазе");
		ЗначениеВРеквизитФормы(ТабСоответствияРес,"СоответствияРесурсов");
		
		// Свернуть таблицу соответствия лимитированных затрат
		ТабСоответствияЛЗ = РезультатВыполнения.ТекФорма.СоответствияЛЗ;
		ТабСоответствияЛЗ.Свернуть("НаименованиеЛЗ,НеЯвляетсяЛЗ,СметнаяПрограмма,СсылкаВБазе");
		ЗначениеВРеквизитФормы(ТабСоответствияЛЗ,"СоответствияЛЗ");
		
		//  Свернуть таблицу соответствия префиксов
		ТабСоответствияПрефиксов = РезультатВыполнения.ТекФорма.СоответствияПрефиксов;
		ТабСоответствияПрефиксов.Свернуть("СтрокаПрефикса,ТипНормативногоСборника,Определитель,ВидРесурса,СметнаяПрограмма,НеОтбрасыватьПрефикс,СоздаватьЗаписиВСправочнике");
		ЗначениеВРеквизитФормы(ТабСоответствияПрефиксов,"СоответствияПрефиксов");
		
		ЗначениеВРеквизитФормы(РезультатВыполнения.СведенияФайлов,"СведенияФайлов");

		Если ИзФайла Тогда
			ТипРайона = РезультатВыполнения.СведенияФайлов[0].ТипРайона;
			НаименованиеРайона = РезультатВыполнения.СведенияФайлов[0].НаименованиеРайона;
			Загрузка_СозданныйДокумент = РезультатВыполнения.СведенияФайлов[0].Загрузка_СозданныйДокумент;
			Район = РезультатВыполнения.СведенияФайлов[0].Район;
			ИмяРегиона = РезультатВыполнения.СведенияФайлов[0].ИмяРегиона;
			СметноНормативнаяБаза = РезультатВыполнения.СведенияФайлов[0].СметноНормативнаяБаза;
			НомерСметы = РезультатВыполнения.СведенияФайлов[0].НомерСметы;
			НаименованиеСметы = РезультатВыполнения.СведенияФайлов[0].НаименованиеСметы;
			Стройка = РезультатВыполнения.СведенияФайлов[0].Стройка;
			IndexesLinkMode = РезультатВыполнения.СведенияФайлов[0].IndexesLinkMode;
			IndexesMode = РезультатВыполнения.СведенияФайлов[0].IndexesMode;
			ВариантПересчетаЭММ = РезультатВыполнения.СведенияФайлов[0].ВариантПересчетаЭММ;
			ПрименятьКоэффициентыНРСП = РезультатВыполнения.СведенияФайлов[0].ПрименятьКоэффициентыНРСП;
			ТипСтроительства = РезультатВыполнения.СведенияФайлов[0].ТипСтроительства;
		КонецЕсли;

	Иначе
		ЗначениеВРеквизитФормы(РезультатВыполнения.ТабФайлов,"СведенияФайлов");
		Если ИзФайла Тогда
			Загрузка_СозданныйДокумент = РезультатВыполнения.ТабФайлов[0].Загрузка_СозданныйДокумент;
		КонецЕсли;
		Для Каждого ТекСтрока Из РезультатВыполнения.ТабСообщения Цикл
			Событие = НСтр("ru = 'Загрузка Гранд-смета'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие,Ложь,ТекСтрока.ТекстСообщения);
		КонецЦикла;
	КонецЕсли;
	Если ЭтаФорма.ЗагрузкаДанных Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Данные загружены.'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Документы сформированы.'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзФайлаПриИзменении(Элемент)
	СтраницаФайлов();
	СведенияФайлов.Очистить();
	Загрузка_СозданныйДокумент = Неопределено;
	КаталогЗагрузки =  "";
КонецПроцедуры

&НаКлиенте
Процедура СтраницаФайлов()
	Если ИзФайла Тогда
		Элементы.ГруппаСтраницыФайлы.ТекущаяСтраница = Элементы.ГруппаСтраницыФайлы.ПодчиненныеЭлементы.СтраницаИзФайла;
	Иначе
		Элементы.ГруппаСтраницыФайлы.ТекущаяСтраница = Элементы.ГруппаСтраницыФайлы.ПодчиненныеЭлементы.СтраницаИзКаталога;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КаталогЗагрузкиПриИзменении(Элемент)
	ОпределитьПервичныеПараметрыФайлов();
	СведенияФайлов.Очистить();
    Загрузка_СозданныйДокумент = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияФайлНажатие(Элемент)
	ИзФайла = Истина;
	ВыборФайлаКаталога(ИзФайла); 
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияКаталогНажатие(Элемент)
	ИзФайла = Ложь;
	ВыборФайлаКаталога(ИзФайла);
КонецПроцедуры

&НаКлиенте
Процедура СведенияФайловПриАктивизацииЯчейки(Элемент)
	ТекЭлемент 	= Элементы.СведенияФайлов.ТекущийЭлемент;
	ТекДанные = Элементы.СведенияФайлов.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекЭлемент.Имя = "СведенияФайловЗагрузка_ТипРайона" ИЛИ ТекЭлемент.Имя = "СведенияФайловЗагрузка_Район"
		ИЛИ ТекЭлемент.Имя = "СведенияФайловЗагрузка_СметноНормативнаяБаза" ИЛИ ТекЭлемент.Имя = "СведенияФайловЗагрузка_Стройка" Тогда
		ИмяКолонки = Сред(ТекЭлемент.Имя,СтрНайти(ТекЭлемент.Имя,"_")+1);
		Если ЗначениеЗаполнено(ТекДанные[ИмяКолонки]) Тогда
			Элементы.СведенияФайлов.КоманднаяПанель.ПодчиненныеЭлементы.СведенияФайловКнопкаЗаполнитьВсе.Доступность = Истина;
			Элементы.СведенияФайлов.КоманднаяПанель.ПодчиненныеЭлементы.СведенияФайловКнопкаЗаполнитьПустые.Доступность = Истина;
		Иначе
			Элементы.СведенияФайлов.КоманднаяПанель.ПодчиненныеЭлементы.СведенияФайловКнопкаЗаполнитьВсе.Доступность = Ложь;
			Элементы.СведенияФайлов.КоманднаяПанель.ПодчиненныеЭлементы.СведенияФайловКнопкаЗаполнитьПустые.Доступность = Ложь;
		КонецЕсли;
	Иначе
		Элементы.СведенияФайлов.КоманднаяПанель.ПодчиненныеЭлементы.СведенияФайловКнопкаЗаполнитьВсе.Доступность = Ложь;
		Элементы.СведенияФайлов.КоманднаяПанель.ПодчиненныеЭлементы.СведенияФайловКнопкаЗаполнитьПустые.Доступность = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВсе(Команда)
	ТекЭлемент 	= Элементы.СведенияФайлов.ТекущийЭлемент;
	ТекДанные = Элементы.СведенияФайлов.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекЭлемент.Имя = "СведенияФайловЗагрузка_ТипРайона" ИЛИ ТекЭлемент.Имя = "СведенияФайловЗагрузка_Район"
		ИЛИ ТекЭлемент.Имя = "СведенияФайловЗагрузка_СметноНормативнаяБаза" ИЛИ ТекЭлемент.Имя = "СведенияФайловЗагрузка_Стройка" Тогда
		ИмяКолонки = Сред(ТекЭлемент.Имя,СтрНайти(ТекЭлемент.Имя,"_")+1);
		ТекЗначение = ТекДанные[ИмяКолонки];
		Для Каждого стр из СведенияФайлов Цикл
			стр[ИмяКолонки] = ТекЗначение;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПустые(Команда)
	ТекЭлемент 	= Элементы.СведенияФайлов.ТекущийЭлемент;
	ТекДанные = Элементы.СведенияФайлов.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекЭлемент.Имя = "СведенияФайловЗагрузка_ТипРайона" ИЛИ ТекЭлемент.Имя = "СведенияФайловЗагрузка_Район"
		ИЛИ ТекЭлемент.Имя = "СведенияФайловЗагрузка_СметноНормативнаяБаза" ИЛИ ТекЭлемент.Имя = "СведенияФайловЗагрузка_Стройка" Тогда
		ИмяКолонки = Сред(ТекЭлемент.Имя,СтрНайти(ТекЭлемент.Имя,"_")+1);
		ТекЗначение = ТекДанные[ИмяКолонки];
		Для Каждого стр из СведенияФайлов Цикл
			Если ЗначениеЗаполнено(стр[ИмяКолонки]) Тогда
				Продолжить;
			КонецЕсли;
			стр[ИмяКолонки] = ТекЗначение;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВидимостьКнопок()
	Элементы.ЗагрузитьXML.Видимость = (СостояниеКнопок <> 2);
	Элементы.СформироватьДокументы.Видимость = (СостояниеКнопок = 2);
	Элементы.Состояние2.Видимость = СостояниеКнопок = 3;
	Элементы.Состояние3.Видимость = СостояниеКнопок = 2;
	Элементы.ГруппаВыборФайла.Доступность = (СостояниеКнопок <> 2);
	Элементы.КаталогЗагрузки.Доступность = (СостояниеКнопок <> 2);
	
	Элементы.ЗагрузитьXML.КнопкаПоУмолчанию 			= Элементы.ЗагрузитьXML.Видимость;
	Элементы.СформироватьДокументы.КнопкаПоУмолчанию 	= Элементы.СформироватьДокументы.Видимость;

КонецПроцедуры

&НаКлиенте
Процедура Состояние3Нажатие(Элемент)
	СостояниеКнопок = 1;
	ВидимостьКнопок();
КонецПроцедуры

&НаКлиенте
Процедура Состояние2Нажатие(Элемент)
	СостояниеКнопок = 2;
	ВидимостьКнопок();
КонецПроцедуры

&НаКлиенте
Процедура СведенияФайловВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя = "СведенияФайловЗагрузка_СозданныйДокумент" И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Загрузка_СозданныйДокумент) Тогда
		ПоказатьЗначение(,Элемент.ТекущиеДанные.Загрузка_СозданныйДокумент);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПутьСохраненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Режим = РежимДиалогаВыбораФайла.ВыборКаталога;
	ДиалогОткрытияФайла = Новый ДиалогВыбораФайла(Режим);
	ДиалогОткрытияФайла.ПолноеИмяФайла = "";
	ДиалогОткрытияФайла.Заголовок = НСтр("ru='Выберите каталог'");
	Если ДиалогОткрытияФайла.Выбрать() Тогда
		Объект.ПутьСохранения = ДиалогОткрытияФайла.Каталог;
	КонецЕсли;

КонецПроцедуры
&НаКлиенте
Процедура ОтборСметЛокальнаяСметаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОписаниеОЗакрытииФормыВыбораЛС = Новый ОписаниеОповещения("ПриЗакрытииФормыПодбораЛС",ЭтаФорма);
	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораЛС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыПодбораЛС(ТекЛС,ТекПараметр) Экспорт
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элементы.ОтборСмет.ТекущиеДанные.ЛокальнаяСмета = ТекЛС;
КонецПроцедуры

&НаКлиенте
Процедура Выгрузить(Команда)
	// Возврат;
	#Если Не ВебКлиент Тогда
		Если Не ЗначениеЗаполнено(Объект.ПутьСохранения) Тогда
			ПоказатьПредупреждение(,НСтр("ru='Не выбран каталог!'"));
			Возврат;
		КонецЕсли;
     	АдресФайлаВоВременномХранилище = "";
		ВыгрузитьНаСервер(АдресФайлаВоВременномХранилище);
		
		Для Каждого ключ Из АдресФайлаВоВременномХранилище Цикл
			ПолучитьФайл(ключ.Значение,Объект.ПутьСохранения+ключ.Ключ,Ложь);
		КонецЦикла;

	#КонецЕсли

	#Если ВебКлиент Тогда
		Оповещение = Новый ОписаниеОповещения("ПродолжитьНачатьПодключениеРасширенияРаботыСФайлами", ЭтаФорма);
		НачатьПодключениеРасширенияРаботыСФайлами(Оповещение) ;
	#КонецЕсли

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выгрузка завершена...'"));
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьНачатьПодключениеРасширенияРаботыСФайлами(Подключено,ДополнительныеПараметры) Экспорт
	Если Не Подключено Тогда
		Оповещение = Новый ОписаниеОповещения("ПродолжитьНачатьУстановкуРасширения", ЭтаФорма);
		НачатьУстановкуРасширенияРаботыСФайлами(Оповещение);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ПродолжитьВыгрузкуВеб", ЭтаФорма);
		НачатьПолучениеКаталогаДокументов(Оповещение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьНачатьУстановкуРасширения(ДополнительныеПараметры) Экспорт
	Оповещение = Новый ОписаниеОповещения("ПродолжитьВыгрузкуВеб", ЭтаФорма);
	НачатьПолучениеКаталогаДокументов(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьВыгрузкуВеб(ИмяКаталогаДокументов,ДополнительныеПараметры) Экспорт
	ВыгрузитьНаСерверВеб(ИмяКаталогаДокументов);
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьНаСервер(АдресФайлаВоВременномХранилище)
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	Обработки.СМ_ОбменДаннымиВФорматеГрандСмета.ВыгрузитьНаСервере(Объект.ПутьСохранения,Объект.ОтборСмет.Выгрузить().ВыгрузитьКолонку("ЛокальнаяСмета"),АдресФайлаВоВременномХранилище,ИмяВременногоФайла);
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьНаСерверВеб(Адрес)
	ОбъектДляСервера = РеквизитФормыВЗначение("Объект");
	Обработки.СМ_ОбменДаннымиВФорматеГрандСмета.ВыгрузитьНаСервере(Адрес,Объект.ОтборСмет.Выгрузить().ВыгрузитьКолонку("ЛокальнаяСмета"),,Истина);
КонецПроцедуры

&НаКлиенте
Процедура СоответствияЛЗСсылкаВБазеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Оповещение = Новый ОписаниеОповещения("ПолучитьЛимитированныеЗатраты", ЭтотОбъект);
	ОткрытьФорму("Справочник.СМ_ЛимитированныеЗатраты.Форма.ФормаВыбораБезПомеченныхНаУдаление",,,,,,Оповещение,РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьЛимитированныеЗатраты(Результат, Структура) Экспорт
	
	Элементы.СоответствияЛЗ.ТекущиеДанные.СсылкаВБазе = Результат;

КонецПроцедуры


