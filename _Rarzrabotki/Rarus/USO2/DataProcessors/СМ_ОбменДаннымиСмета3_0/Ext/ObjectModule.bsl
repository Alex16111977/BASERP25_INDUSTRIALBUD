КонецПроцедуры

Процедура ДобавитьДокументыПоТЧРодителя(Документ, ТаблицаВыгрузки)
	                                    
	ТаблицаВыгрузки.Очистить();

	ТекДокумент = Документ;
	НоваяСтрока 				= ТаблицаВыгрузки.Добавить();
	НоваяСтрока.Документ 		= ТекДокумент;
	НоваяСтрока.ДокументАрхива 	= ТекДокумент;	
	
	Если ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		
		НоваяСтрока.Сортировка = 1;
		
		Для Каждого ТекСтрока Из ТекДокумент.Сметы Цикл
			НоваяСтрока 				= ТаблицаВыгрузки.Добавить();
			НоваяСтрока.Документ 		= ТекСтрока.Смета;
			НоваяСтрока.ИдРодителя 		= ТекСтрока.Смета.ИдРодителя;
			НоваяСтрока.ДокументАрхива 	= ТекДокумент;	
			НоваяСтрока.Сортировка		= 3;
			
			Если ТипЗнч(ТекСтрока.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
				НоваяСтрока.Сортировка = 2;
				Для Каждого ТекСтрокаОС Из ТекСтрока.Смета.ЛокальныеСметы Цикл
					НоваяСтрока 				= ТаблицаВыгрузки.Добавить();
					НоваяСтрока.Документ 		= ТекСтрокаОС.ЛокальнаяСмета;
					НоваяСтрока.ИдРодителя 		= ТекСтрокаОС.ЛокальнаяСмета.ИдРодителя;
					НоваяСтрока.ДокументАрхива 	= ТекДокумент;	
					НоваяСтрока.Сортировка		= 3;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ТекДокумент) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		НоваяСтрока.Сортировка = 2;
		Для Каждого ТекСтрокаОС Из ТекДокумент.ЛокальныеСметы Цикл
			НоваяСтрока 				= ТаблицаВыгрузки.Добавить();
			НоваяСтрока.Документ 		= ТекСтрокаОС.ЛокальнаяСмета;
			НоваяСтрока.ИдРодителя 		= ТекСтрокаОС.ЛокальнаяСмета.ИдРодителя;
			НоваяСтрока.ДокументАрхива 	= ТекДокумент;
			НоваяСтрока.Сортировка		= 3;
		КонецЦикла;
	Иначе
		НоваяСтрока.ДокументАрхива 	= ТекДокумент;	
		НоваяСтрока.Сортировка		= 3;
	КонецЕсли;
КонецПроцедуры

Функция ДобавитьДокументыПоЛС2(ТабДокументов)
	
	СписокСметы = ТабДокументов.ВыгрузитьКолонку("Документ"); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_АктВыполненныхРабот.Ссылка,
	|	СМ_АктВыполненныхРабот.ЛокальнаяСмета КАК ИДСметы,
	|	СМ_АктВыполненныхРабот.ИДРодителя,
	|   4 КАК Сортировка
	|ИЗ
	|	Документ.СМ_АктВыполненныхРабот КАК СМ_АктВыполненныхРабот
	|ГДЕ
	|	СМ_АктВыполненныхРабот.ЛокальнаяСмета В(&СписокСметы)	
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ПозицияЛокальнойСметы.Ссылка,
	|	СМ_ПозицияЛокальнойСметы.ИДСметы,
	|	СМ_ПозицияЛокальнойСметы.ИДРодителя,
	|   7 КАК Сортировка
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	|ГДЕ
	|	СМ_ПозицияЛокальнойСметы.ИДСметы В(&СписокСметы)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_РазделЛокальнойСметы.Ссылка,
	|	СМ_РазделЛокальнойСметы.ИДСметы,
	|	СМ_РазделЛокальнойСметы.ИДРодителя,
	|   5 КАК Сортировка
	|ИЗ
	|	Документ.СМ_РазделЛокальнойСметы КАК СМ_РазделЛокальнойСметы
	|ГДЕ
	|	СМ_РазделЛокальнойСметы.ИДСметы В(&СписокСметы)";
	
	Запрос.УстановитьПараметр("СписокСметы",СписокСметы);
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	ТабРезультат.Свернуть("Ссылка,ИДСметы,ИдРодителя,Сортировка");
	Для Каждого ТекСтрока Из ТабРезультат Цикл
		НайденнаяСтрока = ТабДокументов.Найти(ТекСтрока.ИДСметы);
		Если НайденнаяСтрока <> Неопределено Тогда
			
			НоваяСтрока 				= ТабДокументов.Добавить();
			НоваяСтрока.Документ        = ТекСтрока.Ссылка;
			НоваяСтрока.ИДРодителя      = ТекСтрока.ИдРодителя;
			НоваяСтрока.ДокументАрхива  = НайденнаяСтрока.ДокументАрхива;
			НоваяСтрока.Сортировка		= ТекСтрока.Сортировка;
			
			Если ТипЗнч(ТекСтрока.Ссылка) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				Если ТипЗнч(ТекСтрока.ИдРодителя) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
					НоваяСтрока.Сортировка = 6;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

КонецФункции

Функция ОпределитьТипСсылочногоРеквизита(ЗначениеРеквизита)
	
	Если ТипЗнч(ЗначениеРеквизита) = Тип("ОписаниеТипов") Тогда
		ТекТип = "ОписаниеТипов";
	Иначе
		ТекТип = ЗначениеРеквизита.Метаданные().ПолноеИмя();
	КонецЕсли;
	Возврат ТекТип;
	
КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииИмпорта

Процедура ЗагрузитьДокументы(ПутьКФайлу,ТЗЗагрузки,Версионирование = Ложь, Знач ВосстанавливаемоеЗначение = Неопределено,Откат = Ложь) Экспорт
	
	Если Откат Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Очистить();
	ТаблицаСсылок.Колонки.Добавить("Ссылка");	
	ТаблицаСсылок.Колонки.Добавить("НомерПоПорядку");            	
	ТаблицаСсылок.Колонки.Добавить("Тип");            
	ТаблицаСсылок.Колонки.Добавить("ТипОбъекта");       
	ТаблицаСсылок.Колонки.Добавить("НомерСортировки");                
	ТаблицаСсылок.Колонки.Добавить("НомерВДереве");            
	ТаблицаСсылок.Колонки.Добавить("НомерВПределахСметы");       
	ТаблицаСсылок.Колонки.Добавить("ПорНомер");                
	
	ТаблДок = Новый ТаблицаЗначений;
	ТаблДок.Колонки.Добавить("Ссылка");
	
	ТаблицаЗагрузкиИд =  Новый ТаблицаЗначений;
	ТаблицаЗагрузкиИд.Очистить();
	ТаблицаЗагрузкиИд.Колонки.Добавить("НомерПоПорядку");
	ТаблицаЗагрузкиИд.Колонки.Добавить("ИмяРеквизита");	
	ТаблицаЗагрузкиИд.Колонки.Добавить("ИДРодителя");
	
	Если Не Версионирование Тогда
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",ПутьКФайлу)); 
		Запись.Следующий();
		ДвоичныеДанные = Запись.Файл.Получить();
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
	Иначе
		ИмяВременногоФайла = ПутьКФайлу;
	КонецЕсли;
	
	ТекстОшибки = "";
	НачатьТранзакцию();
	
	Чтение = Новый ЧтениеXML; 
	Чтение.ОткрытьФайл(ИмяВременногоФайла); 
	Пока Чтение.Прочитать() Цикл 

		//  Прочитать "структурные части" элементов. 
		//  Проверить, какая часть элемента - текущая. 
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			ИмяУзла = Чтение.Имя; 
			
			Если ИмяУзла = "Объект" Тогда
				СтруктураОбъекта 	= Новый Структура;
				СтруктураАтрибутов 	= Новый Структура; 
				СтруктураТЧ			= Новый Структура;
				ТекИмяТЧ			= "";
				Номерссылки = 0;
				Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
					//  Прочитать данные узла атрибута. 
					ТипУзла 	= Чтение.ТипУзла; 
					Имя 		= Чтение.Имя; 
					Значение 	= Чтение.Значение; 
					//  Обработать полученные значения.
					Если Имя = "Тип" Тогда
						СтруктураОбъекта.Вставить(Имя,Значение);
						Если Найти(Чтение.Значение,"Справочник") > 0 Тогда 	
							
							ИмяОбъекта = СтрЗаменить(Чтение.Значение,"Справочник.","");						    				
							
							Попытка
								новэлемент = Справочники[ИмяОбъекта].СоздатьЭлемент();
							Исключение
								Продолжить;
							КонецПопытки;
							
							НоваяЗапись = ТаблицаСсылок.Добавить();
							НоваяЗапись.НомерПоПорядку = Число(Номерссылки);
							НоваяЗапись.Тип = "Справочник";
							Пока Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл 
								ЗаполнятьРеквизиты(новэлемент,Чтение);
							КонецЦикла;
							
							// СНБ ищем сначала по коду, потом по наименованию
							Если ИмяОбъекта = "СМ_СметноНормативныеБазы" Тогда
								резпоиска = Справочники.СМ_Ресурсы.НайтиПоКоду(новэлемент.Код);
								Если резпоиска = Справочники[ИмяОбъекта].ПустаяССылка() Тогда 
									резпоиска = Справочники[ИмяОбъекта].НайтиПоНаименованию(новэлемент.Наименование);
								КонецЕсли;
							// Ресурсы подгружаем по коду
							ИначеЕсли ИмяОбъекта = "СМ_Ресурсы" Тогда
								резпоиска = Справочники.СМ_Ресурсы.НайтиПоКоду(новэлемент.Код);
							Иначе
								резпоиска = Справочники[ИмяОбъекта].НайтиПоНаименованию(новэлемент.Наименование);
							КонецЕсли;
							
							Если резпоиска <> Справочники[ИмяОбъекта].ПустаяССылка() Тогда 
								НоваяЗапись.Ссылка = резпоиска.Ссылка;
							Иначе
								Если Не Версионирование Тогда
									Если ИмяОбъекта = "СМ_Ресурсы" И СМ_СметаВызовСервера.НедоступнаРаботаСПрайсами() Тогда
										ТекстОшибки = ТекстОшибки + "Не найден ресурс: " + новэлемент.Наименование + ". Загрузка отменена." + Символы.ПС;
									КонецЕсли;
								КонецЕсли;
								Если Не ЗначениеЗаполнено(новэлемент.Код) Тогда
									новэлемент.УстановитьНовыйКод();
								КонецЕсли;
								новэлемент.ОбменДанными.Загрузка = Истина;
								новэлемент.Записать();
								НоваяЗапись.Ссылка = новэлемент.Ссылка;
							КонецЕсли;
						Иначе 
							ИмяОбъекта = СтрЗаменить(Чтение.Значение,"Документ.","");
							// Первый документ - может быть наш документ.
							Если ВосстанавливаемоеЗначение <> Неопределено Тогда
								новэлемент =ВосстанавливаемоеЗначение.ПолучитьОбъект();
								ВосстанавливаемоеЗначение = Неопределено;
							Иначе
								Попытка
									СсылкаНового = Документы[ИмяОбъекта].ПолучитьСсылку();
								Исключение
									Продолжить;
								КонецПопытки;
								новэлемент = Документы[ИмяОбъекта].СоздатьДокумент();
								новэлемент.УстановитьСсылкуНового(СсылкаНового);
							КонецЕсли;
							
							НоваяЗапись = ТаблицаСсылок.Добавить();
							НоваяЗапись.Тип = "Документ";
							НоваяЗапись.НомерПоПорядку = Число(Номерссылки); 
							НоваяЗапись.ТипОбъекта = ИмяОбъекта;
							
							Если ИмяОбъекта = "СМ_ОбъектнаяСмета" Тогда
								НоваяЗапись.НомерСортировки = 1;
							ИначеЕсли ИмяОбъекта = "СМ_СводнаяСмета" Тогда
								НоваяЗапись.НомерСортировки = 2;
							ИначеЕсли ИмяОбъекта = "СМ_ЛокальнаяСмета" Тогда 
								НоваяЗапись.НомерСортировки = 3;
							Иначе 
								НоваяЗапись.НомерСортировки = 6;
							КонецЕсли;
							
							Пока Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл 
								ЗаполнятьРеквизиты(новэлемент,Чтение);
							КонецЦикла;
							
							Если новэлемент.ДополнительныеСвойства.Свойство("НомерВДереве") Тогда
								НоваяЗапись.НомерВДереве = новэлемент.ДополнительныеСвойства.НомерВДереве;
								НоваяЗапись.НомерВПределахСметы = новэлемент.ДополнительныеСвойства.НомерВПределахСметы;
								НоваяЗапись.ПорНомер = новэлемент.ДополнительныеСвойства.ПорНомер;
								новэлемент.ДополнительныеСвойства.Очистить();
								новэлемент.ДополнительныеСвойства.Вставить("Смета3");
							КонецЕсли;
							
							новэлемент.УстановитьНовыйНомер();
							
							Если Не ЗначениеЗаполнено(новэлемент.Дата) Тогда
								новэлемент.Дата = ТекущаяДатаСеанса();
							КонецЕсли;
							
							новэлемент.Записать(); 				
							НоваяЗапись.Ссылка = новэлемент.Ссылка;		
						КонецЕсли;

					ИначеЕсли Имя = "НПП" Тогда 
					    Номерссылки = Чтение.Значение;
					ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда  
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	

	Если ТекстОшибки = "" Тогда
		
		// Пересчет документов
		отбор = Новый Структура;
		отбор.Вставить("Тип","Документ");
		ТаблицаСсылок.Сортировать(НСтр("ru='НомерСортировки убыв, НомерПоПорядку убыв'")); 
		Для Каждого докст Из ТаблицаСсылок.НайтиСтроки(отбор) Цикл 
			отбор1 = Новый Структура;
			отбор1.Вставить("НомерПоПорядку",докст.НомерПоПорядку);
			д1 = докст.Ссылка.ПолучитьОбъект();
			Для Каждого док Из ТаблицаЗагрузкиИд.НайтиСтроки(отбор1) Цикл 
				искомыйродитель = ТаблицаСсылок.Найти(док.ИДРодителя,"НомерПоПорядку");
				Если искомыйродитель <> Неопределено Тогда
					д1[док.ИмяРеквизита] = искомыйродитель.Ссылка;
				КонецЕсли;
			КонецЦикла;
			д1.ПроверитьЗаполнение();
			д1.ОбменДанными.Загрузка = Истина;
			д1.Записать();
			
			Если ТипЗнч(докст.Ссылка) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				СМ_СметаВызовСервера.УстановитьНомерДокумента(докст.Ссылка,докст.ПорНомер,докст.НомерВПределахСметы,докст.НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
			ИначеЕсли ТипЗнч(докст.Ссылка) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				СМ_СметаВызовСервера.УстановитьНомерДокумента(докст.Ссылка,докст.ПорНомер,докст.НомерВПределахСметы,докст.НомерВДереве, , "СМ_РазделЛокальнойСметы");
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого докст Из ТаблицаСсылок.НайтиСтроки(отбор) Цикл 
			Если докст.НомерСортировки <= 3 Тогда
				д1 = докст.Ссылка.ПолучитьОбъект();
				
				Если докст.ТипОбъекта = "СМ_ЛокальнаяСмета" Тогда
					Документы[докст.ТипОбъекта].Перерасчет(д1.Ссылка,Ложь,,Версионирование);
				Иначе
					Документы[докст.ТипОбъекта].Перерасчет(д1.Ссылка,Ложь);
				КонецЕсли;
				
				Если Не Версионирование Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("документ "+д1+" пересчитан");
				КонецЕсли;
				
				д1.Записать(РежимЗаписиДокумента.Запись);
				Если докст.НомерСортировки = 3 Тогда
					// СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(д1.Ссылка);
				КонецЕсли;

			КонецЕсли;
			Если докст.НомерСортировки <= 3 Тогда
				СтрТЗ = ТЗЗагрузки.Добавить();
				СтрТЗ.Ссылка = докст.Ссылка;
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		ОтменитьТранзакцию();
	КонецЕсли;
	
	Если Откат Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнятьРеквизиты(новэлемент,Чтение)
	
	Пока Чтение.Прочитать() Цикл 
		Если Чтение.Имя = "ТабличнаяЧасть" Тогда
			Чтение.ПрочитатьАтрибут();
			ИмяТЧ = Чтение.Значение;
			Попытка
				ЭтоГруппа = новэлемент.ЭтоГруппа;
			Исключение
				ЭтоГруппа = Ложь;
			КонецПопытки;
			Если Не ЭтоГруппа Тогда
				Попытка
					ЗполнениеТабличнойЧасти(новэлемент[ИмяТЧ],Чтение);
				Исключение
					Продолжить;
				КонецПопытки;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента Тогда 
			Создатьреквизит(новэлемент,Чтение);
		ИначеЕсли Чтение.Имя = "ТабличныеЧасти"  Тогда 

		ИначеЕсли Чтение.Имя = "Объект"  Тогда 
			Возврат; 
 		КонецЕсли; 
	КонецЦикла;
	
КонецПроцедуры

Процедура Создатьреквизит(новэлемент,Чтение)
	
	
	Пока Чтение.ПрочитатьАтрибут() Цикл 
		
		Если Чтение.Имя = "Значение" Тогда
			Значение = Чтение.Значение;
		ИначеЕсли Чтение.Имя = "Ссылка" Тогда 
			
			Если СокрЛП(Чтение.Значение) = "пусто" Тогда
				ЗначениеСсылки = 0;			
			Иначе                                                       
				ЗначениеСсылки = Число(Чтение.Значение);
			КонецЕсли;
			
			Попытка
				Значение = ТаблицаСсылок.Найти(Число(Чтение.Значение),"НомерПоПорядку").Ссылка;
			Исключение
				Событие = НСтр("ru = 'Исключение Смета 3.0'");
				СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
			КонецПопытки;
		ИначеЕсли Чтение.Имя = "Имя" Тогда 
			ИмяРекв = Чтение.Значение; 
		ИначеЕсли Чтение.Имя = "Тип" Тогда 
			Если Найти(Чтение.Значение,"Перечисление.") > 0 Тогда
				ИмяПеречисления = СтрЗаменить(Чтение.Значение,"Перечисление.","");	 
				Попытка
					Значение = ПолучитьЗначениеПеречисления(ИмяПеречисления,Значение);
				Исключение
					Значение = Неопределено;
				КонецПопытки;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда 
		КонецЕсли;
	КонецЦикла;
	
	Если ((ИмяРекв = "Код") И (ИмяОбъекта = "СМ_Ресурсы" ИЛИ ИмяОбъекта = "СМ_СметноНормативныеБазы" ИЛИ ИмяОбъекта = "СМ_ТерриториальныеРайоны"))
		ИЛИ (Не(ИмяРекв = "Код")) Тогда
		
		Если ИмяРекв = "НомерВДереве"
			ИЛИ ИмяРекв = "НомерВПределахСметы"
			ИЛИ ИмяРекв = "ПорНомер" Тогда
			новэлемент.ДополнительныеСвойства.Вставить(ИмяРекв,Число(Значение));
			Возврат;
		КонецЕсли;

		
		Попытка
			Если (ИмяРекв = "ИДРодителя") ИЛИ (ИмяРекв = "ИДСметы") ИЛИ (ИмяРекв = "ИДПозицииВладельца") Тогда
				стр 					= ТаблицаЗагрузкиИд.Добавить();
				стр.НомерПоПорядку 	= Число(Номерссылки);
				стр.ИмяРеквизита 		= ИмяРекв; 		
				стр.ИДРодителя 		= Число(ЗначениеСсылки);
			КонецЕсли;
			
			Если Значение = "Да" ИЛИ Значение = "Нет" Тогда
				Если ИмяРекв = "ЭтоГруппа" И Значение = "Да" Тогда
					ИмяСпр = новэлемент.метаданные().Имя;
					новэлемент = Справочники[ИмяСпр].СоздатьГруппу(); 
				Иначе
					новэлемент[ИмяРекв] = ?(Значение = "Да",Истина,Ложь);
				КонецЕсли;
			Иначе
				новэлемент[ИмяРекв] = Значение;
			КонецЕсли;
		Исключение
			Событие = НСтр("ru = 'Исключение Смета 3.0'");
			СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
		КонецПопытки;
	КонецЕсли;
	
	Возврат;

КонецПроцедуры

Функция ПолучитьЗначениеПеречисления(ИмяПеречисления,ЗначениеПеречисления)
	
	Для Каждого ЭлементПеречисления Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
		Если ЭлементПеречисления.Синоним = Строка(ЗначениеПеречисления) Тогда
			Возврат Перечисления[ИмяПеречисления][ЭлементПеречисления.Имя];
		КонецЕсли; 
	КонецЦикла;
	
КонецФункции

Процедура ЗполнениеТабличнойЧасти(новэлемент,Чтение)
	Пока Чтение.Прочитать() Цикл 
		Если Чтение.Имя = "СтрокаТабличнойЧасти" Тогда
			новаястр = новэлемент.Добавить();
			Чтение.Прочитать();
			Пока(Чтение.Имя <> "СтрокаТабличнойЧасти") Цикл
				Создатьреквизит(новаястр,Чтение); 
				Чтение.Прочитать();
			КонецЦикла;
		ИначеЕсли (Чтение.Имя = "ТабличнаяЧасть") Тогда 
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЗагрузитьОбразыДокументов(ПутьКФайлу,Записывать) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Очистить();
	ТаблицаСсылок.Колонки.Добавить("Ссылка");	
	ТаблицаСсылок.Колонки.Добавить("НомерПоПорядку");            	
	ТаблицаСсылок.Колонки.Добавить("Тип");            
	ТаблицаСсылок.Колонки.Добавить("ТипОбъекта");       
	ТаблицаСсылок.Колонки.Добавить("НомерСортировки");                
	ТаблицаСсылок.Колонки.Добавить("ИДРодителя"); 
	ТаблицаСсылок.Колонки.Добавить("ИДПозицииВладельца");
	ТаблицаСсылок.Колонки.Добавить("НомерВДереве");            
	ТаблицаСсылок.Колонки.Добавить("НомерВПределахСметы");       
	ТаблицаСсылок.Колонки.Добавить("ПорНомер");                

	
	ТаблДок = Новый ТаблицаЗначений;
	ТаблДок.Колонки.Добавить("Ссылка");
	
	ТаблицаЗагрузкиИд =  Новый ТаблицаЗначений;
	ТаблицаЗагрузкиИд.Очистить();
	ТаблицаЗагрузкиИд.Колонки.Добавить("НомерПоПорядку");
	ТаблицаЗагрузкиИд.Колонки.Добавить("ИмяРеквизита");	
	ТаблицаЗагрузкиИд.Колонки.Добавить("ИДРодителя");
	
	ИмяВременногоФайла = ПутьКФайлу;
	
	ТекстОшибки = "";
	
	Чтение = Новый ЧтениеXML; 
	Чтение.ОткрытьФайл(ИмяВременногоФайла); 
	Пока Чтение.Прочитать() Цикл 

		//  Прочитать "структурные части" элементов. 
		//  Проверить, какая часть элемента - текущая. 
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			ИмяУзла = Чтение.Имя; 
			
			Если ИмяУзла = "Объект" Тогда
				СтруктураОбъекта 	= Новый Структура;
				СтруктураАтрибутов 	= Новый Структура; 
				СтруктураТЧ			= Новый Структура;
				ТекИмяТЧ			= "";
				Номерссылки = 0;
				Пока (Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента) И Чтение.ПрочитатьАтрибут() Цикл 
					//  Прочитать данные узла атрибута. 
					ТипУзла 	= Чтение.ТипУзла; 
					Имя 		= Чтение.Имя; 
					Значение 	= Чтение.Значение; 
					//  Обработать полученные значения.
					Если Имя = "Тип" Тогда
						СтруктураОбъекта.Вставить(Имя,Значение);
						Если Найти(Чтение.Значение,"Справочник") > 0 Тогда 	
							
							ИмяОбъекта = СтрЗаменить(Чтение.Значение,"Справочник.","");	
							
							СсылкаНового = Справочники[ИмяОбъекта].ПолучитьСсылку();
							новэлемент = Справочники[ИмяОбъекта].СоздатьЭлемент();
							новэлемент.УстановитьСсылкуНового(СсылкаНового);
							
							НоваяЗапись = ТаблицаСсылок.Добавить();
							НоваяЗапись.НомерПоПорядку = Число(Номерссылки);
							НоваяЗапись.Тип = "Справочник";
							Пока Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл 
								ЗаполнятьРеквизиты(новэлемент,Чтение);
							КонецЦикла;
							
							// СНБ ищем сначала по коду, потом по наименованию
							Если ИмяОбъекта = "СМ_СметноНормативныеБазы" Тогда
								резпоиска = Справочники.СМ_Ресурсы.НайтиПоКоду(новэлемент.Код);
								Если резпоиска = Справочники[ИмяОбъекта].ПустаяССылка() Тогда 
									резпоиска = Справочники[ИмяОбъекта].НайтиПоНаименованию(новэлемент.Наименование);
								КонецЕсли;
							// Ресурсы подгружаем по коду
							ИначеЕсли ИмяОбъекта = "СМ_Ресурсы" Тогда
								резпоиска = Справочники.СМ_Ресурсы.НайтиПоКоду(новэлемент.Код);
							Иначе
								резпоиска = Справочники[ИмяОбъекта].НайтиПоНаименованию(новэлемент.Наименование);
							КонецЕсли;
							
							Если резпоиска <> Справочники[ИмяОбъекта].ПустаяССылка() Тогда 
								НоваяЗапись.Ссылка = резпоиска.Ссылка;
							Иначе
								Если Записывать Тогда
									новэлемент.ОбменДанными.Загрузка = Истина;
									новэлемент.Записать();
									новэлемент = новэлемент.Ссылка;
								КонецЕсли;
								НоваяЗапись.Ссылка = новэлемент;
							КонецЕсли;
						Иначе 
							ИмяОбъекта = СтрЗаменить(Чтение.Значение,"Документ.","");

							НоваяЗапись = ТаблицаСсылок.Добавить();
							НоваяЗапись.Тип = "Документ";
							НоваяЗапись.НомерПоПорядку = Число(Номерссылки); 
							НоваяЗапись.ТипОбъекта = ИмяОбъекта;
							
							Если ИмяОбъекта = "СМ_ОбъектнаяСмета" Тогда
								НоваяЗапись.НомерСортировки = 1;
							ИначеЕсли ИмяОбъекта = "СМ_СводнаяСмета" Тогда
								НоваяЗапись.НомерСортировки = 2;
							ИначеЕсли ИмяОбъекта = "СМ_ЛокальнаяСмета" Тогда 
								НоваяЗапись.НомерСортировки = 3;
							ИначеЕсли ИмяОбъекта = "СМ_ПозицияЛокальнойСметы" Тогда 
								НоваяЗапись.НомерСортировки = 7;
							ИначеЕсли ИмяОбъекта = "СМ_РазделЛокальнойСметы" Тогда 
								НоваяЗапись.НомерСортировки = 8;
							Иначе 
								НоваяЗапись.НомерСортировки = 6;
							КонецЕсли;
							
							СсылкаНового = Документы[ИмяОбъекта].ПолучитьСсылку();
							новэлемент = Документы[ИмяОбъекта].СоздатьДокумент();
							новэлемент.УстановитьСсылкуНового(СсылкаНового);
							
							Пока  Чтение.ТипУзла <> ТипУзлаXML.КонецЭлемента Цикл 
								ЗаполнятьРеквизиты(новэлемент,Чтение);
							КонецЦикла;
							
							Если Записывать Тогда
															
								Если новэлемент.ДополнительныеСвойства.Свойство("НомерВДереве") Тогда
									НоваяЗапись.НомерВДереве = новэлемент.ДополнительныеСвойства.НомерВДереве;
									НоваяЗапись.НомерВПределахСметы = новэлемент.ДополнительныеСвойства.НомерВПределахСметы;
									НоваяЗапись.ПорНомер = новэлемент.ДополнительныеСвойства.ПорНомер;
									новэлемент.ДополнительныеСвойства.Очистить();
									новэлемент.ДополнительныеСвойства.Вставить("Смета3");
								КонецЕсли;

								новэлемент.УстановитьНовыйНомер(); 
								
								Если Не ЗначениеЗаполнено(новэлемент.Дата) Тогда
									новэлемент.Дата = ТекущаяДатаСеанса();
								КонецЕсли;
								
								новэлемент.Записать();
								новэлемент = новэлемент.Ссылка;
							КонецЕсли;

							НоваяЗапись.Ссылка = новэлемент;		
						КонецЕсли;

					ИначеЕсли Имя = "НПП" Тогда 
					    Номерссылки = Чтение.Значение;
					ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда  
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	

	// Пересчет документов
	отбор = Новый Структура;
	отбор.Вставить("Тип","Документ");
	ТаблицаСсылок.Сортировать(НСтр("ru='НомерСортировки убыв, НомерПоПорядку убыв'")); 
	Для Каждого докст Из ТаблицаСсылок.НайтиСтроки(отбор) Цикл 
		
		д1 = докст.Ссылка.ПолучитьОбъект();
		отбор1 = Новый Структура;
		отбор1.Вставить("НомерПоПорядку",докст.НомерПоПорядку);
		// отбор1.Вставить("ИмяРеквизита","ИДРодителя");
		
		Для Каждого док Из ТаблицаЗагрузкиИд.НайтиСтроки(отбор1) Цикл 
			искомыйродитель = ТаблицаСсылок.Найти(док.ИДРодителя,"НомерПоПорядку");
			Если искомыйродитель <> Неопределено Тогда
				д1[док.ИмяРеквизита] = искомыйродитель.Ссылка;
			КонецЕсли;
		КонецЦикла;
		
		
		Если докст.НомерСортировки <= 3 И Записывать Тогда
			Если докст.ТипОбъекта = "СМ_ЛокальнаяСмета" Тогда
				Документы[докст.ТипОбъекта].Перерасчет(д1.Ссылка,Ложь,,Ложь);
			Иначе
				Документы[докст.ТипОбъекта].Перерасчет(д1.Ссылка,Ложь);
			КонецЕсли;
		ИначеЕсли Записывать Тогда
			
			д1.ОбменДанными.Загрузка = Истина;
			д1.Записать();
			
			Если ТипЗнч(докст.Ссылка) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы") Тогда
				СМ_СметаВызовСервера.УстановитьНомерДокумента(докст.Ссылка,докст.ПорНомер,докст.НомерВПределахСметы,докст.НомерВДереве, , "СМ_ПозицияЛокальнойСметы");
			ИначеЕсли ТипЗнч(докст.Ссылка) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
				СМ_СметаВызовСервера.УстановитьНомерДокумента(докст.Ссылка,докст.ПорНомер,докст.НомерВПределахСметы,докст.НомерВДереве, , "СМ_РазделЛокальнойСметы");
			КонецЕсли;
			
		КонецЕсли;
		
		Если докст.НомерСортировки = 3 И Записывать Тогда
			СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(докст.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Инд = ТаблицаСсылок.Количество()-1;
	
	Пока Инд>=0 Цикл
		Стр = ТаблицаСсылок.Получить(Инд);
		Если Не Стр.Тип = "Документ" Тогда
			ТаблицаСсылок.Удалить(стр);
		КонецЕсли;
		Инд = Инд - 1;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ТаблицаСсылок;
КонецФункции

