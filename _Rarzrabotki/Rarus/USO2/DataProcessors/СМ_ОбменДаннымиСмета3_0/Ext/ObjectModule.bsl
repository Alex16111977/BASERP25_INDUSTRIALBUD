
#Область ОписаниеПеременных

Перем НомерСсылки;
Перем ТаблицаЗагрузкиИд;
Перем ИмяОбъекта; 
Перем ТаблицаСсылок;

#КонецОбласти

#Область ПроцедурыИФункцииЭкспорта

Функция ХМЛРеквизит(ЗаписьXML,ТекОбъект,Реквизит,тип)
	ЗаписьXML.ЗаписатьНачалоЭлемента("Реквизит");
	ЗаписьXML.ЗаписатьАтрибут("Значение",Строка(ТекОбъект[Реквизит.Имя]));
	ЗаписьXML.ЗаписатьАтрибут("Имя",Строка(Реквизит.Имя));
	ЗаписьXML.ЗаписатьАтрибут("Тип",Строка(тип));
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецФункции

Функция ХМЛРеквизитНомер(ЗаписьXML,Значение,Реквизит)
	ЗаписьXML.ЗаписатьНачалоЭлемента("Реквизит");
	ЗаписьXML.ЗаписатьАтрибут("Значение",Строка(Значение));
	ЗаписьXML.ЗаписатьАтрибут("Имя",Реквизит);
	ЗаписьXML.ЗаписатьАтрибут("Тип","Число");
	ЗаписьXML.ЗаписатьКонецЭлемента();
КонецФункции

Функция ХМЛРеквизитССылка(ЗаписьXML,Реквизит2,ЗначениеСсылки,ТекТипЗнач)
	ЗаписьXML.ЗаписатьНачалоЭлемента("Реквизит");
	ЗаписьXML.ЗаписатьАтрибут("Ссылка",Строка(ЗначениеСсылки));
	ЗаписьXML.ЗаписатьАтрибут("Имя",Строка(Реквизит2.Имя));
	ЗаписьXML.ЗаписатьАтрибут("Тип",ТекТипЗнач);
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
КонецФункции

Функция ХМЛРеквизитТЧ(ЗаписьXML,СтрокаТЧ,РеквизитТЧ,типрекв)
	ЗаписьXML.ЗаписатьНачалоЭлемента("РеквизитТЧ");
	ЗаписьXML.ЗаписатьАтрибут("Значение",Строка(СтрокаТЧ[РеквизитТЧ.Имя]));
	ЗаписьXML.ЗаписатьАтрибут("Имя",Строка(РеквизитТЧ.Имя));
	ЗаписьXML.ЗаписатьАтрибут("Тип",Строка(типрекв));
	ЗаписьXML.ЗаписатьКонецЭлемента();  	
КонецФункции

Процедура ВыгрузитьДокументы(ДокументДляВыгрузки, ТаблицаВыгрузки, ТаблицаСсылок, ТаЗ, КаталогВыгрузки,АдресФайлаВоВременномХранилище,ИмяВременногоФайла,Версионирование = Ложь) Экспорт
	МассивТипов = Новый Массив;
	ЗаполнитьМассивТипов(МассивТипов); 
	ДобавитьДокументыПоТЧРодителя(ДокументДляВыгрузки, ТаблицаВыгрузки);
	ТаблицаСсылок = НоваяТС();

	// Формирование таблицы документов для выгрузки.
	ТабРезультат = ТаблицаВыгрузки.Скопировать();
	ТабРезультат.Свернуть("Документ,ИДРодителя,ДокументАрхива,Сортировка");
	ТабРезультат.Сортировать("Сортировка Возр");
	
	ДобавитьДокументыПоЛС2(ТабРезультат);
	ТабРезультат.Свернуть("Документ,ИДРодителя,ДокументАрхива,Сортировка");
	ТабРезультат.Сортировать("Сортировка Возр");
	
	// Определение глобальной таблицы ссылок и выгрузка документов.
    Для Каждого ТекСтрокаТаблицы Из ТабРезультат Цикл

		Документ 		= ТекСтрокаТаблицы.Документ;
    	ТекМетаданные 	= Документ.Метаданные();
		
		// Поиск уже выгруженных документов по ссылке.
		НайденнаяСтрокаДок = ТаблицаСсылок.Найти(Документ,"Ссылка");
		
		// Запись ссылок в глобальную таблицу.  
		Если НайденнаяСтрокаДок = Неопределено Тогда
			НоваяСтрока 					= ТаблицаСсылок.Добавить();
			НоваяСтрока.Ссылка				= Документ;
			НоваяСтрока.НаименованиеОбъекта	= ТекМетаданные.Имя;
			НоваяСтрока.НаименованиеПолное	= "";		
			НоваяСтрока.ТипОбъекта			= ТекМетаданные.ПолноеИмя();	
			НоваяСтрока.НомерПоПорядку		= 0;			
			НоваяСтрока.Загружен			= Ложь;
			
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
				НоваяСтрока.Порядок             = 5;
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
				НоваяСтрока.Порядок             = 4;
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				НоваяСтрока.Порядок             = 3;
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
				НоваяСтрока.Порядок             = 6;
			Иначе
				НоваяСтрока.Порядок             = 0;
			КонецЕсли;
			
			Если ТипЗнч(Документ) <> Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда 
				НоваяСтрока.ИдРодителя = Документ.ИДРодителя;
			КонецЕсли;
			НоваяСтрока.ДокументАрхива	= ТекСтрокаТаблицы.ДокументАрхива;
		Иначе
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
				НайденнаяСтрокаДок.Порядок             = 5;
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
				НайденнаяСтрокаДок.Порядок             = 4;
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
				НайденнаяСтрокаДок.Порядок             = 3;
			ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
				НайденнаяСтрокаДок.Порядок             = 6;
			Иначе
				НайденнаяСтрокаДок.Порядок             = 0;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
				
		// Выгрузка реквизитов
		Для Каждого Реквизит Из ТекМетаданные.Реквизиты Цикл
			
			// Для СС,ОС,ЛС не выгружаем родителя по ссылке.
			// Будем проставлять "ИДРодителя" после загрузки всех документов, при необходимости.
			Если (ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_СводнаяСмета")
				ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета")
				ИЛИ ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета"))
				И (Реквизит.Имя = "ИДРодителя" ИЛИ Реквизит.Имя = "ИДСметы") Тогда
				Продолжить;
			КонецЕсли;	
			
			ВыгрузитьСсылочныйРеквизит(Документ, Реквизит, ТаблицаСсылок, ТекСтрокаТаблицы.ДокументАрхива, МассивТипов);
			
		КонецЦикла;
		
		// Выгрузка стандарнтых реквизитов.
		Для Каждого СтандартныйРеквизит Из ТекМетаданные.СтандартныеРеквизиты Цикл
			Если СтандартныйРеквизит.Имя = "Ссылка" ИЛИ СтандартныйРеквизит.Имя = "ТипЗначения" Тогда
				Продолжить;
			КонецЕсли;
			ВыгрузитьСсылочныйРеквизит(Документ, СтандартныйРеквизит, ТаблицаСсылок, ТекСтрокаТаблицы.ДокументАрхива, МассивТипов);
		КонецЦикла;

		// Выгрузка табличных частей.
		Для Каждого ТабЧасть Из ТекМетаданные.ТабличныеЧасти Цикл
			Если ТабЧасть.Имя = "ДополнительныеРеквизиты" Тогда
				Продолжить;
			КонецЕсли;
			// Цикл по строкам ТЧ документа.
			Для Каждого СтрокаТЧ Из Документ[ТабЧасть.Имя] Цикл
				// Цикл по реквизитам строки ТЧ документа.
				Для Каждого РеквизитСтроки Из ТабЧасть.Реквизиты Цикл
					ВыгрузитьСсылочныйРеквизит(СтрокаТЧ, РеквизитСтроки, ТаблицаСсылок, ТекСтрокаТаблицы.ДокументАрхива, МассивТипов);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	ТаблицаСсылок.Сортировать("Порядок Возр");
	Ном = 1;
	Для Каждого ТекСтрока Из ТаблицаСсылок Цикл
		ТекСтрока.НомерСортировки = Ном;
		Ном = Ном+1;
	КонецЦикла;	
		
	// ТаблицаСсылок.Сортировать("НомерСортировки Убыв");
	НовТаблицаСсылок 	= ТаблицаСсылок.Скопировать(); 
	ТабАрхивов 			= ТаблицаСсылок.Скопировать(); 
		
    // ***************************
    // Формирование файла выгрузки
    // ****************************
	Если Не Версионирование Тогда
		СТРИмя = Лев(Строка(ДокументДляВыгрузки), 50);
		
		RegExp = Новый COMОбъект("VBScript.RegExp");
		RegExp.MultiLine=Ложь; 
		RegExp.Global=Истина;
		RegExp.Pattern = "[^A-Zf-z0-9а-яА-Я\_\s\№\-]";
		Str1 = СокрЛП(СТРИмя);
		СТРИмя = RegExp.Replace(Str1, "");
		
		ИмяФайла = "" + СТРИмя + "_" + Формат(ТекущаяДатаСеанса(),"ДФ=dd.MM.yyyy") + ".xml";
		ФайлЗаписи 	= КаталогВыгрузки + "\" + ИмяФайла; 
		новфайл = ТаЗ.Добавить();
		новфайл.файл = ФайлЗаписи;
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML();
    ЗаписьXML.ОткрытьФайл(ИмяВременногоФайла);
    ЗаписьXML.ЗаписатьОбъявлениеXML(); 
    ЗаписьXML.ЗаписатьНачалоЭлемента("Данные");   		
		
    //  Цикл по ссылочным объектам
    Для Каждого ТекСтрока Из ТаблицаСсылок Цикл
		
		Если ТекСтрока.Ссылка.ПолучитьОбъект() = Неопределено тогда
			Продолжить;
		КонецЕсли;

    	ЗаписьXML.ЗаписатьНачалоЭлемента("Объект");
    	// ЗаписьXML.ЗаписатьАтрибут("Наименование",Строка(ТекСтрока.НаименованиеОбъекта)); 
    	ЗаписьXML.ЗаписатьАтрибут("НПП",Строка(ТекСтрока.НомерСортировки));
    	ЗаписьXML.ЗаписатьАтрибут("Тип",Строка(ТекСтрока.ТипОбъекта));
    	
    	ТекМетаданные2  = ТекСтрока.Ссылка.Метаданные();
    	ТекОбъект		= ТекСтрока.Ссылка; 
		
		
		//  Выгрузка реквизитов
		Для Каждого Реквизит2 Из ТекМетаданные2.Реквизиты Цикл
			
			Если Реквизит2.Имя = "НомерВДереве"
				ИЛИ Реквизит2.Имя = "НомерВПределахСметы"
				ИЛИ Реквизит2.Имя = "ПорНомер" Тогда
				Продолжить;
			КонецЕсли;
			типрекв = ТипЗнч(ТекОбъект[Реквизит2.Имя]);
			
			//  Примитивный тип
			Если  МассивТипов.Найти(типрекв) <> Неопределено Тогда
				    ХМЛРеквизит(ЗаписьXML,ТекОбъект,Реквизит2,типрекв); 
				//  Ссылочный тип	
			Иначе
				
				Если НЕ ЗначениеЗаполнено(ТекОбъект[Реквизит2.Имя]) Тогда
					Продолжить;			
				КонецЕсли;
				
				ТекТипЗнач = ОпределитьТипСсылочногоРеквизита(ТекОбъект[Реквизит2.Имя]);
				
				Если Найти(ТекТипЗнач,"Перечисление") > 0 Тогда
					 ХМЛРеквизит(ЗаписьXML,ТекОбъект,Реквизит2,ТекТипЗнач);  						
				Иначе	
					
		  			//  ищем в глобальной таблице и ставим ссылку
					СтруктураПоиска = Новый Структура;
					СтруктураПоиска.Вставить("Ссылка",ТекОбъект[Реквизит2.Имя]);
					
					МассивСсылок = НовТаблицаСсылок.НайтиСтроки(СтруктураПоиска);
					Если МассивСсылок.Количество() > 0 Тогда
						ЗначениеСсылки = МассивСсылок[0].НомерСортировки; 						
					Иначе
						ЗначениеСсылки = "пусто";	
					КонецЕсли;
					    ХМЛРеквизитССылка(ЗаписьXML,Реквизит2,ЗначениеСсылки,ТекТипЗнач);						
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;

		Если ТипЗнч(ТекОбъект) = Тип("ДокументСсылка.СМ_ПозицияЛокальнойСметы")
			ИЛИ ТипЗнч(ТекОбъект) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			НомераОбъекта = СМ_СметаВызовСервера.ПолучитьНомерДокумента(ТекОбъект,ТекМетаданные2.Имя);
			ХМЛРеквизитНомер(ЗаписьXML,НомераОбъекта.НомерВДереве,"НомерВДереве");
			ХМЛРеквизитНомер(ЗаписьXML,НомераОбъекта.НомерВПределахСметы,"НомерВПределахСметы");
			ХМЛРеквизитНомер(ЗаписьXML,НомераОбъекта.ПорНомер,"ПорНомер");
		КонецЕсли;
		
		
		//  Выгрузка стандартных реквизитов
		Для Каждого Реквизит3 Из ТекМетаданные2.СтандартныеРеквизиты Цикл
			
			Если Реквизит3.Имя = "Ссылка" Тогда
				Продолжить;
			КонецЕсли;
			
			//  Примитивный тип
			типрекв = ТипЗнч(ТекОбъект[Реквизит3.Имя]);
			
			Если  МассивТипов.Найти(типрекв) <> Неопределено Тогда
				    ХМЛРеквизит(ЗаписьXML,ТекОбъект,Реквизит3,типрекв);					
			//  Ссылочный тип	
			Иначе
				
				Если НЕ ЗначениеЗаполнено(ТекОбъект[Реквизит3.Имя]) Тогда
					Продолжить;			
				КонецЕсли;
				
				ТекТипЗнач = ОпределитьТипСсылочногоРеквизита(ТекОбъект[Реквизит3.Имя]);
		
				Если Найти(ТекТипЗнач,"Перечисление") > 0 Тогда
					ХМЛРеквизит(ЗаписьXML,ТекОбъект,Реквизит3,ТекТипЗнач);							
				Иначе				
				
					//  ищем в глобальной таблице и ставим ссылку
					СтруктураПоиска = Новый Структура;
					СтруктураПоиска.Вставить("Ссылка",ТекОбъект[Реквизит3.Имя]);
					
					МассивСсылок = НовТаблицаСсылок.НайтиСтроки(СтруктураПоиска);
					Если МассивСсылок.Количество() > 0 Тогда
						ЗначениеСсылки = МассивСсылок[0].НомерСортировки; 						
					Иначе
						ЗначениеСсылки = "пусто";	
					КонецЕсли;
					
					 ХМЛРеквизитССылка(ЗаписьXML,Реквизит3,ЗначениеСсылки,ТекТипЗнач);	
					
				КонецЕсли;

			КонецЕсли;
			
		КонецЦикла;
		
    	// Выгрузка табличных частей.
    	// Цикл по табличным частям документа.
		
		Если ТекМетаданные2.ТабличныеЧасти.Количество() > 0 Тогда
		
	  		ЗаписьXML.ЗаписатьНачалоЭлемента("ТабличныеЧасти");  
	  		Для Каждого ТабЧасть Из ТекМетаданные2.ТабличныеЧасти Цикл
	   			ЗаписьXML.ЗаписатьНачалоЭлемента("ТабличнаяЧасть");
	    		ЗаписьXML.ЗаписатьАтрибут("Имя", ТабЧасть.Имя);
	   	
	  	      	//  Цикл по строкам ТЧ документа
	  	      	Для Каждого СтрокаТЧ Из ТекОбъект[ТабЧасть.Имя] Цикл
	  	      		ЗаписьXML.ЗаписатьНачалоЭлемента("СтрокаТабличнойЧасти");
	  	      		ЗаписьXML.ЗаписатьАтрибут("НомерСтроки", Строка(СтрокаТЧ.НомерСтроки));

	  	      		//  Цикл по реквизитам строки ТЧ документа
	    			Для Каждого РеквизитТЧ Из ТабЧасть.Реквизиты Цикл
	    				
	    				//  Примитивный тип
						типрекв = ТипЗнч(СтрокаТЧ[РеквизитТЧ.Имя]); 
						
	    				Если  МассивТипов.Найти(типрекв) <> Неопределено Тогда
							
							ХМЛРеквизитТЧ(ЗаписьXML,СтрокаТЧ,РеквизитТЧ,типрекв);		    					
	    				//  Ссылочный тип	
	    				Иначе
							
							Если НЕ ЗначениеЗаполнено(СтрокаТЧ[РеквизитТЧ.Имя]) Тогда
								Продолжить;			
							КонецЕсли;
							
	    					ТекТипЗнач = ОпределитьТипСсылочногоРеквизита(СтрокаТЧ[РеквизитТЧ.Имя]);

							Если Найти(ТекТипЗнач,"Перечисление") > 0 Тогда
								ХМЛРеквизитТЧ(ЗаписьXML,СтрокаТЧ,РеквизитТЧ,ТекТипЗнач);											
							Иначе							
								
		    					//  ищем в глобальной таблице и ставим ссылку
		    					СтруктураПоиска = Новый Структура;
		    					СтруктураПоиска.Вставить("Ссылка",СтрокаТЧ[РеквизитТЧ.Имя]);
		    					
		    					МассивСсылок = НовТаблицаСсылок.НайтиСтроки(СтруктураПоиска);
		    					Если МассивСсылок.Количество() > 0 Тогда
		    						ЗначениеСсылки = МассивСсылок[0].НомерСортировки; 						
		    					Иначе
		    						ЗначениеСсылки = "пусто";	
		    					КонецЕсли;
								
								ЗаписьXML.ЗаписатьНачалоЭлемента("РеквизитТЧ");
		    				    ЗаписьXML.ЗаписатьАтрибут("Ссылка",Строка(ЗначениеСсылки));
		    					ЗаписьXML.ЗаписатьАтрибут("Имя",Строка(РеквизитТЧ.Имя));
		    					ЗаписьXML.ЗаписатьАтрибут("Тип",ТекТипЗнач);
		    					ЗаписьXML.ЗаписатьКонецЭлемента();
								
							КонецЕсли;	
		   				КонецЕсли;
					КонецЦикла;
					
	   				ЗаписьXML.ЗаписатьКонецЭлемента();
	  		  	КонецЦикла;
	  		  	ЗаписьXML.ЗаписатьКонецЭлемента();
	 		КонецЦикла;
	    	ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЕсли;
    	ЗаписьXML.ЗаписатьКонецЭлемента();
    КонецЦикла;
		
				

	ЗаписьXML.ЗаписатьКонецЭлемента();
	ЗаписьXML.Закрыть();

	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Если Версионирование Тогда
		АдресФайлаВоВременномХранилище = ДвоичныеДанные;
	Иначе
		АдресФайлаВоВременномХранилище = Новый Соответствие;
		АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
		АдресФайлаВоВременномХранилище.Вставить(ФайлЗаписи,АдресФайла);
	КонецЕсли;
	
	
КонецПроцедуры

Процедура ВыгрузитьСсылочныйРеквизит(ТекОбъект, ТекРеквизит, ТаблицаСсылок, ДокументАрхива, МассивТипов,Порядок = -1)
	
	//  Примитивный тип
	
	Если  МассивТипов.Найти(ТипЗнч(ТекОбъект[ТекРеквизит.Имя])) <> Неопределено Тогда
	
	// Ссылочный тип	
	Иначе
		ЗначениеРеквизита = ТекОбъект[ТекРеквизит.Имя];

		// Ссылочный тип пишем в глобальную таблицу.
		Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			
			ТипЗначенияРеквизита = ОпределитьТипСсылочногоРеквизита(ЗначениеРеквизита);
			
			// Определение является ли ссылочный реквизит перечислением.
			// Перечисления пропускаются при добавлении ссылочных реквизитов в таблицу.
			Если НЕ (Найти(ТипЗначенияРеквизита,"Перечисление") > 0) Тогда
				
				// Если ссылка не найдена в таблице записываем ссылку в глобальную таблицу.  
				НайденнаяСтрока = ТаблицаСсылок.Найти(ЗначениеРеквизита,"Ссылка");
				Если НайденнаяСтрока = Неопределено Тогда
					
					НоваяСтрока 					= ТаблицаСсылок.Добавить();
					НоваяСтрока.Ссылка				= ЗначениеРеквизита;
					НоваяСтрока.НаименованиеОбъекта	= ТекРеквизит.Имя;
					НоваяСтрока.НаименованиеПолное	= "";		
					НоваяСтрока.ТипОбъекта			= ТипЗначенияРеквизита;	
					НоваяСтрока.НомерПоПорядку		= 0;	
					НоваяСтрока.Загружен			= Ложь;
					НоваяСтрока.ДокументАрхива		= ДокументАрхива;
					
					Если ТипЗнч(ДокументАрхива) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
						ПорядокДоп             = 5;
					ИначеЕсли ТипЗнч(ДокументАрхива) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
						ПорядокДоп             = 4;
					ИначеЕсли ТипЗнч(ДокументАрхива) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
						ПорядокДоп             = 3;
					ИначеЕсли ТипЗнч(ДокументАрхива) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
						ПорядокДоп             = 6;
					Иначе
						ПорядокДоп             = 0;
					КонецЕсли;

					НоваяСтрока.Порядок             = ?(СтрНайти(ВРег(ТипЗначенияРеквизита),"ДОКУМЕНТ")=0,Порядок,ПорядокДоп);
				// Если ссылка найдена в таблице, сдвигаем ее в самый конец.
				// Для того, чтобы при загрузке из файла она была загружена раньше.
				Иначе
					Если ТекРеквизит.Имя = "ВладелецФайла" ИЛИ ТекРеквизит.Имя = "СсылкаНаАкт" Тогда
						Возврат;
					КонецЕсли;
					ТекИндексСтроки = ТаблицаСсылок.Индекс(НайденнаяСтрока);
					КоличествоСтрок = ТаблицаСсылок.Количество();
					Смещение		= КоличествоСтрок - ТекИндексСтроки - 1;
					ТаблицаСсылок.Сдвинуть(НайденнаяСтрока, Смещение);
				КонецЕсли;
				
				// Ссылка уже выгружалась, пойдем дальше.
				Если Не НайденнаяСтрока = Неопределено Тогда 					
					Возврат;
				КонецЕсли;
				
				// Выгрузка реквизитов.
				Для Каждого Реквизит Из ЗначениеРеквизита.Метаданные().Реквизиты Цикл
					Если Реквизит.Имя = "ИДРодителя" ИЛИ Реквизит.Имя = "ИДСметы" ИЛИ (Реквизит.Имя = "ИДПозицииВладельца")Тогда
						Если ТаблицаСсылок.Найти(ЗначениеРеквизита,"Ссылка") = Неопределено Тогда
							ВыгрузитьСсылочныйРеквизит(ЗначениеРеквизита, Реквизит, ТаблицаСсылок, ДокументАрхива, МассивТипов,Порядок-1);				
						КонецЕсли;
					Иначе 
						ВыгрузитьСсылочныйРеквизит(ЗначениеРеквизита, Реквизит, ТаблицаСсылок, ДокументАрхива, МассивТипов,Порядок-1);
					КонецЕсли;
				КонецЦикла;
				
				// Выгрузка стандарнтых реквизитов. 
				Для Каждого СтандартныйРеквизит Из ЗначениеРеквизита.Метаданные().СтандартныеРеквизиты Цикл
					Если СтандартныйРеквизит.Имя = "Ссылка" ИЛИ СтандартныйРеквизит.Имя = "ТипЗначения" Тогда
						Продолжить;
					КонецЕсли;
					ВыгрузитьСсылочныйРеквизит(ЗначениеРеквизита, СтандартныйРеквизит, ТаблицаСсылок, ДокументАрхива, МассивТипов,Порядок-1);
				КонецЦикла;
				
				// Выгрузка табличных частей.
				Для Каждого ТабЧасть Из ЗначениеРеквизита.Метаданные().ТабличныеЧасти Цикл
					Если ТабЧасть.Имя = "ДополнительныеРеквизиты" Тогда
						Продолжить;
					КонецЕсли;
					// Цикл по строкам ТЧ документа.
					Для Каждого СтрокаТЧ Из ЗначениеРеквизита[ТабЧасть.Имя] Цикл
						// Цикл по реквизитам строки ТЧ документа.
						Для Каждого РеквизитСтроки Из ТабЧасть.Реквизиты Цикл
							ВыгрузитьСсылочныйРеквизит(СтрокаТЧ, РеквизитСтроки, ТаблицаСсылок, ДокументАрхива, МассивТипов,Порядок-1);
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Функция НоваяТС()
	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Колонки.Добавить("Ссылка");	
	ТаблицаСсылок.Колонки.Добавить("НаименованиеОбъекта");	
	ТаблицаСсылок.Колонки.Добавить("НаименованиеПолное");	
	ТаблицаСсылок.Колонки.Добавить("ТипОбъекта");	
	ТаблицаСсылок.Колонки.Добавить("НомерПоПорядку");		
	ТаблицаСсылок.Колонки.Добавить("НомерСортировки");
	ТаблицаСсылок.Колонки.Добавить("Загружен");
	ТаблицаСсылок.Колонки.Добавить("ИдРодителя");
	ТаблицаСсылок.Колонки.Добавить("ИдСметы");
	ТаблицаСсылок.Колонки.Добавить("ДокументАрхива");
	ТаблицаСсылок.Колонки.Добавить("Порядок");
	Возврат ТаблицаСсылок;
КонецФункции

