&НаКлиенте
Процедура ВыполнитьПослеПодключенияРасширенияРаботыСФайлами(Подключено, ДополнительныеПараметры) Экспорт
	
	Если Не Подключено Тогда
		АдресВременногоХранилищаФайла 	= "";
		ИмяФайла 						= "";
		Оповещение 						= Новый ОписаниеОповещения("ПродолжитьЗагрузкуВеб", ЭтаФорма);
		НачатьПомещениеФайла(Оповещение,АдресВременногоХранилищаФайла,ИмяФайла,Истина,ЭтаФорма.УникальныйИдентификатор); 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗагрузкуВеб(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьДокументыНаСервереВеб(Адрес);
	Если ЭтаФорма.ВладелецФормы<>Неопределено Тогда
		Если ЭтаФорма.ВладелецФормы.ИмяФормы = "Обработка.СМ_ДеревоСмет.Форма.ФормаУпр" Тогда
			ЭтаФорма.ВладелецФормы.Элементы.СписокОбъектыСтроительства.обновить()
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФайлЗагрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ФильтрДляДиалога = "Xml файл (*.xml)";
	Диалог.Фильтр = ФильтрДляДиалога;
	Если Диалог.Выбрать() Тогда
		ФайлЗагрузки = Диалог.ПолноеИмяФайла;
		ДвоичныеДанные = Новый ДвоичныеДанные(ФайлЗагрузки);
		АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанные,ЭтаФорма.УникальныйИдентификатор); 
		Загрузка_АдресВременногоХранилища = АдресВременногоХранилища;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	#Если ВебКлиент Тогда
		Элементы.КаталогВыгрузки.Видимость = Ложь;
		Элементы.ФайлЗагрузки.Видимость = Ложь;
	#КонецЕсли
	
	Если ЗначениеЗаполнено(Параметры.ИмяФайла) Тогда
		ФайлЗагрузки = Параметры.ИмяФайла;
		#Если Не ВебКлиент Тогда
			ДвоичныеДанные 						= Новый ДвоичныеДанные(ФайлЗагрузки);
			АдресВременногоХранилища 			= ПоместитьВоВременноеХранилище(ДвоичныеДанные,ЭтаФорма.УникальныйИдентификатор); 
			Загрузка_АдресВременногоХранилища 	= АдресВременногоХранилища;
		    ЗагрузитьДокументыНаСервере();
		#КонецЕсли
		#Если ВебКлиент Тогда
			АдресВременногоХранилищаФайла = "";
			Оповещение = Новый ОписаниеОповещения("ПродолжитьЗагрузкуВеб", ЭтаФорма);
			НачатьПомещениеФайла(Оповещение,АдресВременногоХранилищаФайла,Параметры.ИмяФайла,Ложь,ЭтаФорма.УникальныйИдентификатор); 
		#КонецЕсли
		Оповестить("ОбновитьДеревоСмет");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОписаниеОЗакрытииФормыВыбораЛС = Новый ОписаниеОповещения("ПриЗакрытииФормыПодбораЛС",ЭтаФорма);
	СтруктураПараметров = Новый Структура("ВключатьОС,ВключатьСС",Истина,Истина);
	ОткрытьФорму("Обработка.СМ_ДеревоСметПростое.Форма.ФормаУпр",СтруктураПараметров,ЭтаФорма,,,,ОписаниеОЗакрытииФормыВыбораЛС,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыПодбораЛС(ТекЛС,ТекПараметр) Экспорт
	Если ТекЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элементы.ТаблицаДокументов.ТекущиеДанные.Документ = ТекЛС;
КонецПроцедуры

