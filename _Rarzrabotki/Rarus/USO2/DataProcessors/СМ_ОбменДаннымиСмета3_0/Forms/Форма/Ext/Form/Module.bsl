#Область СлужебныеПроцедурыИФункции

Перем ТаблицаСсылок;

&НаКлиенте
Функция ЗаписатьАрхив()
	
	ИмяАрхива	= ЭтаФорма.КаталогВыгрузки + НСтр("ru='\Выгрузка данных.zip'"); 
	Архиватор 	= Новый ЗаписьZipФайла(ИмяАрхива,,Нстр("ru = 'Файл обмена данными'"));
	Для Каждого ФайлЗаписи Из ТаЗ Цикл 
		Архиватор.Добавить(ФайлЗаписи.Файл);
	КонецЦикла;
	
	Архиватор.Записать();
	
КонецФункции

&НаСервере
Процедура ВыгрузитьДокументыНаСервере(ДокументДляВыгрузки,АдресФайлаВоВременномХранилище)
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ТаблицаВыгрузкиВрем = РеквизитФормыВЗначение("ТаблицаВыгрузки",Тип("ТаблицаЗначений"));
	ТаЗВрем = РеквизитФормыВЗначение("ТаЗ",Тип("ТаблицаЗначений"));
	ОбъектВрем = РеквизитФормыВЗначение("Объект");
	ОбъектВрем.ВыгрузитьДокументы(ДокументДляВыгрузки,ТаблицаВыгрузкиВрем, ТаблицаСсылок, ТаЗВрем, КаталогВыгрузки,АдресФайлаВоВременномХранилище,ИмяВременногоФайла);
	
	ЗначениеВРеквизитФормы(ТаблицаВыгрузкиВрем,"ТаблицаВыгрузки");
	ЗначениеВРеквизитФормы(ТаЗВрем,"ТаЗ");
			
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьДокументы(Команда)
	ТаЗ.Очистить();	
	Если (ТаблицаДокументов.Количество() > 0) Тогда 
		Если НЕ ЗначениеЗаполнено(ЭтаФорма.КаталогВыгрузки) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не задан каталог выгрузки!'"));	
		Иначе 
			Для каждого стр Из ТаблицаДокументов Цикл 
				АдресФайлаВоВременномХранилище = "";
				ВыгрузитьДокументыНаСервере(стр.Документ,АдресФайлаВоВременномХранилище);
				Для Каждого ключ Из АдресФайлаВоВременномХранилище Цикл
					ПолучитьФайл(ключ.Значение,ключ.Ключ,Ложь);
				КонецЦикла;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Документ %1 Выгружен'"), стр.Документ));	
			КонецЦикла;
			ЗаписатьАрхив();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Архив сформирован'"));	
	  	КонецЕсли;
	Иначе 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не Выбраны документы для выгрузки!'"));	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КаталогВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	// Синхронный вызов
	//Если ДиалогВыбора.Выбрать() Тогда
	//	ЭтаФорма.КаталогВыгрузки = ДиалогВыбора.Каталог;
	//КонецЕсли;		
	
	// Замена на асинхронный вызов
	ОповещениеВыбора = Новый ОписаниеОповещения("ВыполнитьПослеВыбораФайла", ЭтотОбъект);
	ДиалогВыбора.Показать(ОповещениеВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПослеВыбораФайла(ВыбранныеФайлы,ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ВыбранныеФайлы Цикл
			ЭтаФорма.КаталогВыгрузки = ТекЭлемент;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Колонки.Добавить("Ссылка");	
	ТаблицаСсылок.Колонки.Добавить("НаименованиеОбъекта");	
	ТаблицаСсылок.Колонки.Добавить("НаименованиеПолное");	
	ТаблицаСсылок.Колонки.Добавить("ТипОбъекта");	
	ТаблицаСсылок.Колонки.Добавить("НомерПоПорядку");	
	
	Если Параметры.Свойство("Документ") Тогда
		Если ЗначениеЗаполнено(Параметры.Документ) Тогда
			НоваяСтрока 			= ЭтаФорма.ТаблицаДокументов.Добавить();
			НоваяСтрока.Документ	= Параметры.Документ;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("Загрузка") Тогда
		Если Параметры.Загрузка Тогда
			Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗагрузка;
		КонецЕсли;
	КонецЕсли;
	
	ВыводитьКомментарии = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДокументыНаСервере()
	
	Запись = РегистрыСведений.СМ_Файлы.СоздатьМенеджерЗаписи();
	Запись.ИмяФайла = ЭтаФорма.ФайлЗагрузки;
	Запись.Файл = Новый ХранилищеЗначения(ПолучитьИЗВременногоХранилища(ЭтаФорма.Загрузка_АдресВременногоХранилища));
	Запись.Записать();

	ТЗЗагрузки = Новый ТаблицаЗначений;
	ТЗЗагрузки.Колонки.Добавить("Ссылка");
	
	ОбъектВрем = РеквизитФормыВЗначение("Объект");
	ОбъектВрем.ЗагрузитьДокументы(ЭтаФорма.ФайлЗагрузки,ТЗЗагрузки);
	
	ТаблицаЗагрузки.Загрузить(ТЗЗагрузки);

	Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",ЭтаФорма.ФайлЗагрузки)); 
	Запись.Следующий();
	Запись.ПолучитьМенеджерЗаписи().Удалить();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДокументыНаСервереВеб(Адрес)
	ТЗЗагрузки = Новый ТаблицаЗначений;
	ТЗЗагрузки.Колонки.Добавить("Ссылка");
	
	ОбъектВрем = РеквизитФормыВЗначение("Объект");
	ОбъектВрем.ЗагрузитьДокументыВеб(Адрес,ТЗЗагрузки);
	ТаблицаЗагрузки.Загрузить(ТЗЗагрузки)
КонецПроцедуры

