
&НаКлиенте
Перем ФормаДлительнойОперации;
&НаКлиенте
Перем ПараметрыОбработчика;

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьСписокСмет();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокСмет()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СМ_СводнаяСмета.Ссылка КАК Смета,
	|	СМ_СводнаяСмета.Стройка КАК Стройка,
	|	СМ_СводнаяСмета.Стройка.Наименование КАК НаименованиеОбъекта
	|ИЗ
	|	Документ.СМ_СводнаяСмета КАК СМ_СводнаяСмета
	|ГДЕ
	|	СМ_СводнаяСмета.ПометкаУдаления
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ОбъектнаяСмета.Ссылка КАК Смета,
	|	СМ_ОбъектнаяСмета.Стройка,
	|	СМ_ОбъектнаяСмета.Стройка.Наименование
	|ИЗ
	|	Документ.СМ_ОбъектнаяСмета КАК СМ_ОбъектнаяСмета
	|ГДЕ
	|	СМ_ОбъектнаяСмета.ПометкаУдаления И 
	|   (СМ_ОбъектнаяСмета.ИДРодителя = Значение(Документ.СМ_СводнаяСмета.ПустаяСсылка) ИЛИ
	|    СМ_ОбъектнаяСмета.ИДРодителя = Неопределено)
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СМ_ЛокальнаяСмета.Ссылка КАК Смета,
	|	СМ_ЛокальнаяСмета.Стройка,
	|	СМ_ЛокальнаяСмета.Стройка.Наименование	
	|ИЗ
	|	Документ.СМ_ЛокальнаяСмета КАК СМ_ЛокальнаяСмета
	|ГДЕ
	|	СМ_ЛокальнаяСмета.ПометкаУдаления И
	|	(СМ_ЛокальнаяСмета.ИДРодителя = Значение(Документ.СМ_ОбъектнаяСмета.ПустаяСсылка) ИЛИ
	|	СМ_ЛокальнаяСмета.ИДРодителя = Значение(Документ.СМ_СводнаяСмета.ПустаяСсылка) ИЛИ
	|   СМ_ЛокальнаяСмета.ИДРодителя = Неопределено)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НаименованиеОбъекта	
	|";
	
	ТаблицаСмет.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
    
	Попытка
		Если ЗаданиеВыполнено(ИдентификаторЗадания) Тогда 
			РезультатВыполнения = ПолучитьИзВременногоХранилища(АдресХранилища);
		Иначе
			ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
			ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 
			ПараметрыОбработчика.ТекущийИнтервал, Истина);
		КонецЕсли;
	Исключение   
		
	КонецПопытки;
    
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)    
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания); 
	
КонецФункции
 
&НаКлиенте
Процедура Удалить(Команда)
    
  ОтключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания");
  
  ФоновоеЗадание = Ложь;
  ВыполнитьФоновоеЗаданиеНаСервере(АдресХранилища, ФоновоеЗадание);
  Если ФоновоеЗадание Тогда
	  ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
	  ПодключитьОбработчикОжидания("ФоновоеЗаданиеНаКлиенте", 1, Истина);
	  ПараметрыОбработчика.МаксимальныйИнтервал = 5;
	  ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект, ИдентификаторЗадания);
  Иначе
	  ТабДок = ПолучитьИзВременногоХранилища(АдресХранилища);
	  Если Не ТабДок = Неопределено Тогда
		  ТабДок.Защита = Истина;
		  ТабДок.ОтображатьЗаголовки = Ложь;
		  ТабДок.ОтображатьСетку = Ложь;
		  ТабДок.АвтоМасштаб = Истина;
		  ТабДок.Показать("Ошибки удаления смет.");
	  КонецЕсли;
  КонецЕсли;
  
КонецПроцедуры

&НаСервере
Процедура ВыполнитьФоновоеЗаданиеНаСервере(АдресХранилища,ФоновоеЗадание = Ложь)
	
	МассивСтрок = ТаблицаСмет.НайтиСтроки(Новый Структура("Пометка",Истина));
	ПомеченныеОбъекты = ТаблицаСмет.Выгрузить(МассивСтрок,"Смета").ВыгрузитьКолонку("Смета");

	СтруктураПараметров = Новый Структура;    
	СтруктураПараметров.Вставить("ТаблицаСмет", ПомеченныеОбъекты);

	// ***************************************************************
	//АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	//Обработки.СМ_УдалениеПомеченныхСмет.УдалениеПомеченныхОбъектов(СтруктураПараметров, АдресХранилища);
	// ****************************************************************
	
	РезультатФоновогоЗадания = ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор, 
	"Обработки.СМ_УдалениеПомеченныхСмет.УдалениеПомеченныхОбъектов", 
	СтруктураПараметров, 
	НСтр("ru = 'Удаление помеченных смет и связанных данных'"));
	
	Если РезультатФоновогоЗадания.ЗаданиеВыполнено Тогда
		АдресХранилища = РезультатФоновогоЗадания.АдресХранилища;
		ОбновитьСписокСмет();
	Иначе
		ФоновоеЗадание = Истина;
		ИдентификаторЗадания  = РезультатФоновогоЗадания.ИдентификаторЗадания;
		АдресХранилища = РезультатФоновогоЗадания.АдресХранилища;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФоновоеЗаданиеНаКлиенте()
	
	Результат = ФоновоеЗаданиеПолучитьРезультат();
	Если Результат.ФоновоеЗаданиеВыполнено Тогда
		Если ФормаДлительнойОперации.Открыта() 
			И ФормаДлительнойОперации.ИдентификаторЗадания = ИдентификаторЗадания Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		КонецЕсли;
		
		ОбновитьСписокСмет();
		ТабДок = ПолучитьИзВременногоХранилища(АдресХранилища);
		Если Не ТабДок = Неопределено Тогда
			ТабДок.Защита = Истина;
			ТабДок.ОтображатьЗаголовки = Ложь;
			ТабДок.ОтображатьСетку = Ложь;
			ТабДок.АвтоМасштаб = Истина;
			ТабДок.Показать("Ошибки удаления смет.");
		КонецЕсли;

	Иначе
		ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчика);
		ПодключитьОбработчикОжидания("ФоновоеЗаданиеНаКлиенте", ПараметрыОбработчика.ТекущийИнтервал, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ФоновоеЗаданиеПолучитьРезультат()
	
	Результат = Новый Структура;
	Результат.Вставить("ФоновоеЗаданиеВыполнено", Ложь);
	Результат.ФоновоеЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СнятьФлаги(Команда)
	СнятьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СнятьНаСервере()
	ТЗ = РеквизитФормыВЗначение("ТаблицаСмет");
	ТЗ.ЗаполнитьЗначения(Ложь,"Пометка");
	ЗначениеВРеквизитФормы(ТЗ,"ТаблицаСмет");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлаги(Команда)
	 УстановитьНаСервере()
КонецПроцедуры

&НаСервере
Процедура УстановитьНаСервере()
	ТЗ = РеквизитФормыВЗначение("ТаблицаСмет");
	ТЗ.ЗаполнитьЗначения(Истина,"Пометка");
	ЗначениеВРеквизитФормы(ТЗ,"ТаблицаСмет");
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСметВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		СтруктураПараметров = Новый Структура("Ключ", ТекДанные.Смета);
		Форма = ПолучитьФорму("Документ.СМ_ЛокальнаяСмета.ФормаОбъекта", СтруктураПараметров);
		Форма.Открыть();
	ИначеЕсли ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") Тогда
		СтруктураПараметров = Новый Структура("Ключ", ТекДанные.Смета);
		Форма = ПолучитьФорму("Документ.СМ_ОбъектнаяСмета.ФормаОбъекта", СтруктураПараметров);
		Форма.Открыть();
	ИначеЕсли ТипЗнч(ТекДанные.Смета) = Тип("ДокументСсылка.СМ_СводнаяСмета") Тогда
		СтруктураПараметров = Новый Структура("Ключ", ТекДанные.Смета);
		Форма = ПолучитьФорму("Документ.СМ_СводнаяСмета.ФормаОбъекта", СтруктураПараметров);
		Форма.Открыть();
	КонецЕсли;	
				
КонецПроцедуры

#КонецОбласти