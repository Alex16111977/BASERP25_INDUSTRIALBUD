
#Область Удаление

Процедура УдалениеПомеченныхОбъектов(СтруктураПараметров, АдресХранилища) Экспорт

    ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("Ссылка");
	ТаблицаОшибок.Колонки.Добавить("Наименование");
	ТаблицаОшибок.Колонки.Добавить("Описание");
	
    УстановитьПривилегированныйРежим(Истина);
    МассивКУдалению = Новый Массив;
	
	ПомеченныеОбъекты = СтруктураПараметров.ТаблицаСмет;
	
	Для Каждого эл из ПомеченныеОбъекты Цикл
		НайтиПоСсылкамРекурсия(эл,МассивКУдалению,ТаблицаОшибок);
	КонецЦикла;
	
	УдалитьОбъекты(МассивКУдалению,Ложь);
	
	УстановитьПривилегированныйРежим(Ложь);

	Если ТаблицаОшибок.Количество() = 0 Тогда
		ТабДок = Неопределено;
	Иначе
		ТабДок = Новый ТабличныйДокумент;
		Макет = Обработки.СМ_УдалениеПомеченныхСмет.ПолучитьМакет("ПФ_MXL_ОШИБКИ");
		
		ОбластьМакета = Макет.ПолучитьОбласть("Шапка");
		ТабДок.Вывести(ОбластьМакета);
		
		ОбластьМакета = Макет.ПолучитьОбласть("Строки");
		сч = 1;
		Для Каждого стр Из ТаблицаОшибок Цикл
			ОбластьМакета.Параметры.Номер = сч;
			ОбластьМакета.Параметры.Заполнить(стр);
			ТабДок.Вывести(ОбластьМакета);
			сч = сч+1;
		КонецЦикла;
		
		ОбластьМакета = Макет.ПолучитьОбласть("Подвал");
		ТабДок.Вывести(ОбластьМакета);
		ТабДок.Защита 				= Истина;
		ТабДок.ОтображатьЗаголовки 	= Ложь;
		ТабДок.ОтображатьСетку 		= Ложь;
		ТабДок.АвтоМасштаб 			= Истина;
	КонецЕсли;

	АдресХранилища = ПоместитьВоВременноеХранилище(ТабДок, АдресХранилища);
	
КонецПроцедуры

Процедура НайтиПоСсылкамРекурсия(Ссылка,МассивКУдалению,ТаблицаОшибок)
	
	МассивСсылок = Новый Массив;
	МассивСсылок.Добавить(Ссылка);
	ТабСсылок = НайтиПоСсылкам(МассивСсылок);
	
	Для Каждого СтрСсылка из ТабСсылок Цикл
		Если (ТипЗнч(СтрСсылка.Данные) = Тип("ДокументСсылка.СМ_ОбъектнаяСмета") ИЛИ 
			  ТипЗнч(СтрСсылка.Данные) = Тип("ДокументСсылка.СМ_СводнаяСмета"))	И 
			  Не СтрСсылка.Данные.ПометкаУдаления Тогда
			НовОшибка 				= ТаблицаОшибок.Добавить();
			НовОшибка.Ссылка 		= Ссылка;
			НовОшибка.Наименование 	= Строка(Ссылка);
			НовОшибка.Описание 		= "Данная смета входит в состав ОС или СС.";
			Возврат;
		ИначеЕсли ТипЗнч(СтрСсылка.Данные) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") И СтрСсылка.Данные <> СтрСсылка.Ссылка Тогда
			Если ЗначениеЗаполнено(СтрСсылка.Данные.КорректируетСмету) И Не СтрСсылка.Данные.ПометкаУдаления Тогда
				НовОшибка 				= ТаблицаОшибок.Добавить();
				НовОшибка.Ссылка 		= Ссылка;
				НовОшибка.Наименование 	= Строка(Ссылка);
				НовОшибка.Описание 		= "По данной смете существуют корректировки.";
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Если МассивКУдалению.Найти(Ссылка) = Неопределено Тогда
		МассивКУдалению.Добавить(Ссылка);
	КонецЕсли;
	
	Для Каждого СтрСсылка из ТабСсылок Цикл
		
		Если Лев(СтрСсылка.Метаданные.ПолноеИмя(),15) = "РегистрСведений" ИЛИ
			 Лев(СтрСсылка.Метаданные.ПолноеИмя(),10) = "ПланОбмена" Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрСсылка.Данные = СтрСсылка.Ссылка Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не МассивКУдалению.Найти(СтрСсылка.Данные) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Об = СтрСсылка.Данные.ПолучитьОбъект();
		Об.УстановитьПометкуУдаления(Истина);
		
		Событие = НСтр("ru = 'Удаление смет.'");
		ЗаписьЖурналаРегистрации(Событие,УровеньЖурналаРегистрации.Информация,,,Строка(СтрСсылка.Данные));

		МассивКУдалению.Добавить(СтрСсылка.Данные);
		НайтиПоСсылкамРекурсия(СтрСсылка.Данные,МассивКУдалению,ТаблицаОшибок);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

