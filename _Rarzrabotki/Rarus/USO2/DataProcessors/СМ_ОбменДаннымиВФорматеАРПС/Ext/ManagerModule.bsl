					НоваяСтрока.КоэффПЗ	= ТекСтрока.ПоправочныйКоэффициент;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	

	КонецЕсли;	
	
КонецПроцедуры

Процедура АнализДокументПозицияЛС(СтрокаПрограммы,Форма,ВерсияФормата,ТекСтрока,Определитель,ТНС)
	НоваяСтрокаПрефикс = Неопределено;
	ШифрРасценки = ТекСтрока.ШифрПозиции;
	Префикс = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксИзСтроки(ШифрРасценки);
	Если ЗначениеЗаполнено(Префикс) Тогда
		НоваяСтрокаПрефикс = Форма.СоответствияПрефиксов.Найти(Префикс,"СтрокаПрефикса");
		Если НоваяСтрокаПрефикс = Неопределено Тогда
			НоваяСтрокаПрефикс	= Форма.СоответствияПрефиксов.Добавить();
			НоваяСтрокаПрефикс.СтрокаПрефикса = Префикс;
		КонецЕсли;
		НоваяСтрокаПрефикс.СметнаяПрограмма = СтрокаПрограммы.Загрузка_СведенияОПрограмме;
	КонецЕсли;

	Если Не НоваяСтрокаПрефикс = Неопределено Тогда
		Если Определитель = Неопределено Тогда	
			Если ВерсияФормата = 1 Тогда
				Определитель = Справочники.СМ_Определители.НайтиПоКоду(ТекСтрока.ВидЗатрат);	
			Иначе	
				// Определение "Вид затрат" = "Определитель".
				// Принадлежность к видам затрат = 1 и тип позиции = (0,1,4,9,11) - определитель = 1.
				Если ТекСтрока.ВидЗатрат = "1" Тогда 
					Если (ТекСтрока.ТипПозиции = "0" ИЛИ ТекСтрока.ТипПозиции = "11"
						ИЛИ ТекСтрока.ТипПозиции = "9" ИЛИ ТекСтрока.ТипПозиции = "1" ИЛИ ТекСтрока.ТипПозиции = "4") Тогда
						Определитель = Справочники.СМ_Определители.НайтиПоКоду(1);
						// Принадлежность к видам затрат = 1 и тип позиции = 5 - определитель = 19.
					ИначеЕсли  ТекСтрока.ТипПозиции = "5" Тогда
						Определитель = Справочники.СМ_Определители.НайтиПоКоду(19);
					КонецЕсли;	
					// Принадлежность к видам затрат = 2 и тип позиции = (2 или 9) - определитель = 6.
				ИначеЕсли ТекСтрока.ВидЗатрат = "2" И (ТекСтрока.ТипПозиции = "2" ИЛИ ТекСтрока.ТипПозиции = "9") Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(6);
					// Принадлежность к видам затрат = 2 и тип позиции = 5 - определитель = 13.
				ИначеЕсли ТекСтрока.ВидЗатрат = "2" И ТекСтрока.ТипПозиции = "5" Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(13);
					// Принадлежность к видам затрат = 3 - определитель = 14.
				ИначеЕсли ТекСтрока.ВидЗатрат = "3" Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(14);
					// Принадлежность к видам затрат = 4 и тип позиции = (3 или 20) - определитель = 0.
				ИначеЕсли ТекСтрока.ВидЗатрат = "4" И (ТекСтрока.ТипПозиции = "3" ИЛИ ТекСтрока.ТипПозиции = "20") Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(0);
					// Принадлежность к видам затрат=4 и тип позиции = 4 - определитель = 12.
				ИначеЕсли ТекСтрока.ВидЗатрат = "4" И ТекСтрока.ТипПозиции = "4" Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду(12);
				Иначе
					Определитель = Справочники.СМ_Определители.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Опеределение "ТипПозиции" = "Тип нормативного сборника".
		Если ТНС = Неопределено Тогда 
			Если ТекСтрока.ТипПозиции = "0" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;	
			ИначеЕсли ТекСтрока.ТипПозиции = "1" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.РемонтноСтроительныеРаботы;
			ИначеЕсли ТекСтрока.ТипПозиции = "2" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы;
			ИначеЕсли ТекСтрока.ТипПозиции = "3" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.ПусконаладочныеРаботы;	
			ИначеЕсли ТекСтрока.ТипПозиции = "4" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка;	
			ИначеЕсли ТекСтрока.ТипПозиции = "5" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;	
			ИначеЕсли ТекСтрока.ТипПозиции = "6" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин;	
			ИначеЕсли ТекСтрока.ТипПозиции = "7" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция;	
			ИначеЕсли ТекСтрока.ТипПозиции = "8" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция;	
			ИначеЕсли ТекСтрока.ТипПозиции = "9" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.УкрупненныеСметныеНормы;
			ИначеЕсли ТекСтрока.ТипПозиции = "10" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.ПрейскурантОптовыхЦенНаМатериалыИОборудование;
			ИначеЕсли ТекСтрока.ТипПозиции = "11" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.РеставрационноВосстановительныеРаботы;	
			ИначеЕсли ТекСтрока.ТипПозиции = "20" Тогда
				ТНС = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция;	
			КонецЕсли;
		КонецЕсли;	
		НоваяСтрокаПрефикс.ТипНормативногоСборника = ТНС;
		НоваяСтрокаПрефикс.Определитель = Определитель;
	КонецЕсли;
	
КонецПроцедуры	

Функция ПолучитьСоздатьДокументПозицияЛС(ТекущаяПозицияВладелецЛС,ТекущаяСмета,ТекущийРаздел,Форма,ВерсияФормата,ТекСтрока,Определитель,ТНС,СметнаяПрограмма)
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	
	// Поиск существующей в базе позиции по реквизиту "Наименование".
	ТекНаименование = ТекСтрока.НаименованиеПозиции;
	Если НЕ ЗначениеЗаполнено(ТекНаименование) Тогда
		ТекНаименование = НСтр("ru='Позиция ЛС'");		
	КонецЕсли;
			
	Если ВерсияФормата = 1 Тогда
		ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(ТекСтрока.ВидЗатрат);	
	Иначе	
		// Определение "Вид затрат" = "Определитель".
		// Принадлежность к видам затрат = 1 и тип позиции = (0,1,4,9,11) - определитель = 1.
		Если ТекСтрока.ВидЗатрат = "1" Тогда 
			Если (ТекСтрока.ТипПозиции = "0" ИЛИ ТекСтрока.ТипПозиции = "11"
				ИЛИ ТекСтрока.ТипПозиции = "9" ИЛИ ТекСтрока.ТипПозиции = "1" ИЛИ ТекСтрока.ТипПозиции = "4") Тогда
				ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(1);
			
				// Принадлежность к видам затрат = 1 и тип позиции = 5 - определитель = 19.
	   		 ИначеЕсли  ТекСтрока.ТипПозиции = "5" Тогда
				ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(19);
			КонецЕсли;	
		// Принадлежность к видам затрат = 2 и тип позиции = (2 или 9) - определитель = 6.
	    ИначеЕсли ТекСтрока.ВидЗатрат = "2" И (ТекСтрока.ТипПозиции = "2" ИЛИ ТекСтрока.ТипПозиции = "9") Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(6);
		// Принадлежность к видам затрат = 2 и тип позиции = 5 - определитель = 13.
	    ИначеЕсли ТекСтрока.ВидЗатрат = "2" И ТекСтрока.ТипПозиции = "5" Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(13);
		// Принадлежность к видам затрат = 3 - определитель = 14.
	    ИначеЕсли ТекСтрока.ВидЗатрат = "3" Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(14);
		// Принадлежность к видам затрат = 4 и тип позиции = (3 или 20) - определитель = 0.
	    ИначеЕсли ТекСтрока.ВидЗатрат = "4" И (ТекСтрока.ТипПозиции = "3" ИЛИ ТекСтрока.ТипПозиции = "20") Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(0);
		// Принадлежность к видам затрат=4 и тип позиции = 4 - определитель = 12.
	    ИначеЕсли ТекСтрока.ВидЗатрат = "4" И ТекСтрока.ТипПозиции = "4" Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(12);
		Иначе
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Определитель не распознан, вид затрат: %1, тип позиции: %2'"), ТекСтрока.ВидЗатрат, ТекСтрока.ТипПозиции));
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Предупреждение'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Определитель не распознан, вид затрат: %1, тип позиции: %2'"), ТекСтрока.ВидЗатрат, ТекСтрока.ТипПозиции));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		КонецЕсли;
	КонецЕсли;

	// Создание нового документа "ПозицияЛС"
	НовДок					= СМ_СметаВызовСервера.СоздатьНовуюПозицию();
	НовДок.Наименование 	= ТекНаименование;
	НовДок.Дата				= ТекущаяДатаСеанса();
	
	Если ЗначениеЗаполнено(ТекущийРаздел) Тогда
		НовДок.ИДРодителя = ТекущийРаздел;	
	Иначе                    			
		ТекущийРаздел 	 	= ПолучитьСоздатьДокументРаздел(ТекущаяСмета,"",ТекущаяСмета.Наименование);
		НовДок.ИДРодителя 	= ТекущийРаздел;
	КонецЕсли;

	НовДок.ИДСметы 			= ТекущаяСмета;
	НовДок.ШифрРасценки 	= ТекСтрока.ШифрПозиции;
	НовДок.Расчет 			= Истина;
	
	//  Поиск / создание единицы измерения
	ТекЕдИзм = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(ТекСтрока.ЕдиницаИзмерения);
	НовДок.ЕдиницаИзмерения			= ТекЕдИзм;
	Если (Не ЗначениеЗаполнено(НовДок.ЕдиницаИзмерения)) Тогда
		НовДок.ЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(ТекСтрока.ЕдиницаИзмерения);
	КонецЕсли;
				
	НовДок.Измеритель				= ТекСтрока.ЕдиницаИзмерения;
	
	Если ТекСтрока.ВидЗатрат = "3" Тогда
		НовДок.Оборудование = ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);
	Иначе	
		НовДок.ПрямЗатраты = ПреобразоватьВЧисло(ТекСтрока.ПрямыеЗатраты);	
	КонецЕсли;

	НовДок.ОснЗарплата              = ПреобразоватьВЧисло(ТекСтрока.ОсновнаяЗП);
	НовДок.ЭксплМашин               = ПреобразоватьВЧисло(ТекСтрока.СтоимостьЭМиМех);
	НовДок.ЗарплМашинистов          = ПреобразоватьВЧисло(ТекСтрока.ЗарплатаМашинистов);
	НовДок.СтоимМатериалов          = ПреобразоватьВЧисло(ТекСтрока.СтоимостьМатериалов);
	НовДок.ВозвратМатер             = ПреобразоватьВЧисло(ТекСтрока.ВозвратМатериалов);
	НовДок.ЗатратыТрудаМашинистов   = ПреобразоватьВЧисло(ТекСтрока.ТрудозатратыРабочих);
	НовДок.ЗатратыТрудаРабочих      = ПреобразоватьВЧисло(ТекСтрока.ТрудозатратыМашинистов);
	НовДок.ОбъемРабот				= ПреобразоватьВЧисло(ТекСтрока.ОбъемРабот);
	НовДок.СпособСоздания			= Перечисления.СМ_ИсточникиДобавленияПозиций.Загружена;
	НовДок.ИсточникСоздания			= СметнаяПрограмма.Наименование + "#АРПС";	
	
	Если ТекСтрока.ПризнакПодчиненности Тогда
		Если ЗначениеЗаполнено(ТекущаяПозицияВладелецЛС) Тогда
			НовДок.ИДПозицииВладельца = ТекущаяПозицияВладелецЛС;
			// Ищем ресурсы неучтенные.
			ТекОбъект 						= ТекущаяПозицияВладелецЛС.ПолучитьОбъект();
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("СметныйКодРесурса", ТекСтрока.ШифрПозиции);
			ПараметрыОтбора.Вставить("ЕдиницаИзмеренияРесурса", ТекСтрока.ЕдиницаИзмерения);
			ПараметрыОтбора.Вставить("НаименованиеРесурса", ТекСтрока.НаименованиеПозиции);
			
			НайденныеСтроки = ТекОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаРесурс ИЗ НайденныеСтроки Цикл			
				СтрокаРесурс.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный;
			КонецЦикла;
			Если НайденныеСтроки.Количество()>0 Тогда
				ТекОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	НовДок.Определитель = ?(Определитель = Неопределено,ТекОпределитель,Определитель);
	
	// Если определитель еще не нашли - ищем по косвенным признакам
	Если Не ЗначениеЗаполнено(НовДок.Определитель) Тогда
		Если (НовДок.СтоимМатериалов<>0) И ((НовДок.ОснЗарплата+НовДок.ЭксплМашин+НовДок.СтоимМатериалов) = 0) Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(19);
		ИначеЕсли (НовДок.Оборудование<>0) Тогда
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(14);
		Иначе
			ТекОпределитель = Справочники.СМ_Определители.НайтиПоКоду(1);
		КонецЕсли;
	КонецЕсли;
	
	//  Определение сметно-нормативной базы
	Если ЗначениеЗаполнено(Форма.СметноНормативнаяБаза) Тогда
		НовДок.РегиональнаяБаза = Форма.СметноНормативнаяБаза;
	Иначе	
		НайденныйЭлемент 		= Справочники.СМ_СметноНормативныеБазы.НайтиПоНаименованию(Форма.НаименованиеСНБазы);
		НовДок.РегиональнаяБаза = НайденныйЭлемент;
	КонецЕсли;
	
	//  Опеределение "ТипПозиции" = "Тип нормативного сборника"
	Если ТНС = Неопределено Тогда 
		Если ТекСтрока.ТипПозиции = "0" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы;	
		ИначеЕсли ТекСтрока.ТипПозиции = "1" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.РемонтноСтроительныеРаботы;
		ИначеЕсли ТекСтрока.ТипПозиции = "2" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.МонтажныеРаботы;
		ИначеЕсли ТекСтрока.ТипПозиции = "3" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.ПусконаладочныеРаботы;	
		ИначеЕсли ТекСтрока.ТипПозиции = "4" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Транспортировка;	
		ИначеЕсли ТекСтрока.ТипПозиции = "5" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;	
		ИначеЕсли ТекСтрока.ТипПозиции = "6" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаЭксплуатациюМашин;	
		ИначеЕсли ТекСтрока.ТипПозиции = "7" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция;	
		ИначеЕсли ТекСтрока.ТипПозиции = "8" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция;	
		ИначеЕсли ТекСтрока.ТипПозиции = "9" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.УкрупненныеСметныеНормы;
		ИначеЕсли ТекСтрока.ТипПозиции = "10" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.ПрейскурантОптовыхЦенНаМатериалыИОборудование;
		ИначеЕсли ТекСтрока.ТипПозиции = "11" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.РеставрационноВосстановительныеРаботы;	
		ИначеЕсли ТекСтрока.ТипПозиции = "20" Тогда
			НовДок.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.Калькуляция;	
		КонецЕсли;
	Иначе
		НовДок.ТипНормативныхСборников = ТНС;
	КонецЕсли;	
	НовДок.Записать();
	ТекПозиция = НовДок.Ссылка;
	
	Если НЕ ТекСтрока.ПризнакПодчиненности Тогда
		ТекущаяПозицияВладелецЛС = ТекПозиция;
	КонецЕсли;	

	//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ позиция ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование));
	
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ позиция ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	
	// Запись сообщений в журнал регистрации
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	Возврат ТекПозиция;
	
КонецФункции	

Функция ПолучитьСоздатьКонтрагента(Форма,НаименованиеКонтрагента,ТипКонтрагента);
	
	НаименованиеКонтрагента = СокрЛП(НаименованиеКонтрагента);
	Если НЕ ЗначениеЗаполнено(НаименованиеКонтрагента) Тогда
		Если ТипКонтрагента = 1 Тогда
			НаименованиеКонтрагента	= НСтр("ru='Основной заказчик'");			
		ИначеЕсли ТипКонтрагента = 2 Тогда
			НаименованиеКонтрагента	= НСтр("ru='Основной подрядчик'");
		КонецЕсли;
	КонецЕсли;
	
	ТекКонтрагент = Справочники.Контрагенты.НайтиПоНаименованию(НаименованиеКонтрагента,Истина);
	Если ТекКонтрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда
		Если Форма.СоздаватьНовыеЭлементы Тогда
			НовыйОбъект 				= Справочники.Контрагенты.СоздатьЭлемент();
			НовыйОбъект.Наименование 	= НаименованиеКонтрагента;
			НовыйОбъект.Записать();
			
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый контрагент: %1, %2'"), НовыйОбъект.Код, НовыйОбъект.Наименование));
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый контрагент: %1, %2'"), НовыйОбъект.Код, НовыйОбъект.Наименование));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
			
			Возврат НовыйОбъект.Ссылка;
		Иначе
			
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден контрагент: %1'"), НаименованиеКонтрагента));
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Предупреждение'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден контрагент: %1'"), НаименованиеКонтрагента));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		КонецЕсли;
	Иначе
		Возврат ТекКонтрагент;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСоздатьДоговор(Форма,Контрагент,НаименованиеДоговора,НомерДоговора,ДатаДоговора);
	
	НаименованиеДоговора = СокрЛП(НаименованиеДоговора);
	Если НЕ ЗначениеЗаполнено(НаименованиеДоговора) Тогда
		НаименованиеДоговора = НСтр("ru='Основной договор'");			
	КонецЕсли;
	
	ТекДоговор = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(НаименованиеДоговора,Истина,Контрагент);
	Если ТекДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда
		Если Форма.СоздаватьНовыеЭлементы Тогда
			НовыйОбъект 				= Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			НовыйОбъект.Наименование 	= НаименованиеДоговора;
			НовыйОбъект.Контрагент		= Контрагент;
			НовыйОбъект.Записать();
			
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый договор: %1, %2'"), НовыйОбъект.Код, НовыйОбъект.Наименование));
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый договор: %1, %2'"), НовыйОбъект.Код, НовыйОбъект.Наименование));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
			
			Возврат НовыйОбъект.Ссылка;
		Иначе
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден договор: %1, %2'"), НомерДоговора, НаименованиеДоговора));
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Предупреждение'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найден договор: %1, %2'"), НомерДоговора, НаименованиеДоговора));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		КонецЕсли;
	Иначе
		Возврат ТекДоговор;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСоздатьДокументЛС(Организация,Район,Форма,ТекСтрока)

	ТекЗаказчик 	= ПолучитьСоздатьКонтрагента(Форма,ТекСтрока.Заказчик,1);
	ТекПодрядчик 	= ПолучитьСоздатьКонтрагента(Форма,ТекСтрока.Подрядчик,2);
	
	Если ЗначениеЗаполнено(ТекЗаказчик) И ТекЗаказчик <> Справочники.Контрагенты.ПустаяСсылка() Тогда
		ТекДоговор = ПолучитьСоздатьДоговор(Форма,ТекЗаказчик, ТекСтрока.НаименованиеДоговора, ТекСтрока.НомерДоговора, ТекСтрока.ДатаДоговора);	
	КонецЕсли;
	
	//  Создание нового документа "Локальная смета".
	НовДок 					= Документы.СМ_ЛокальнаяСмета.СоздатьДокумент();
	НовДок.Автор 			= ПользователиКлиентСервер.АвторизованныйПользователь();
	НовДок.Наименование 	= ТекСтрока.НаименованиеДокумента;
	НовДок.ДатаТекущихЦен	= ТекСтрока.ДатаЦен;
	НовДок.Основание		= ТекСтрока.ПроектнаяДокументация;
	НовДок.НомерСметы		= ТекСтрока.НомерДокумента;
	НовДок.Договор			= ТекДоговор;
	НовДок.Заказчик 		= ТекЗаказчик;
	НовДок.Подрядчик    	= ТекПодрядчик;
	НовДок.Дата				= ТекущаяДатаСеанса();
	НовДок.Организация		= Организация;
	НовДок.Район			= Район;
	
	Если Форма.СпособРасчета = "0" Тогда
		НовДок.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный;
	Иначе
		НовДок.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный
	КонецЕсли;
	
	СМ_АРПС_ОбменВызовСервера.ЗаполнитьИзНастроекПользователяПоУмолчанию(НовДок);
	
	Если ЗначениеЗаполнено(Форма.ТекСтройка) Тогда
		НовДок.Стройка = Форма.ТекСтройка;
	КонецЕсли;
	
	НовДок.Записать();
	
	ТекСмета = НовДок.Ссылка;
	//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование));
	
	// Запись сообщений в журнал регистрации
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ ЛС: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НовДок.Наименование));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		
	Возврат ТекСмета.Ссылка;
	
КонецФункции

Функция ПолучитьСоздатьДокументРаздел(ТекущаяСмета,НомерРаздела,ТекНаименованиеРаздела,ВерхнийРаздел = Неопределено)

	//  Поиск существующего документа раздел в базе по типовому номеру документа.
	Если ЗначениеЗаполнено(НомерРаздела) Тогда
		ДлинаСтроки	 	= СтрДлина(СокрЛП(НомерРаздела));
		ДлинаНомера  	= 9;
		ДлинаОстатка 	= ДлинаНомера-ДлинаСтроки;
		ТекНомерРаздела = "";
		Для Сч = 1 По ДлинаОстатка Цикл
			ТекНомерРаздела = ТекНомерРаздела + "0";	
		КонецЦикла;
		ТекНомерРаздела = ТекНомерРаздела + СокрЛП(НомерРаздела);
	КонецЕсли;
	
	
	Если НЕ ЗначениеЗаполнено(ТекНаименованиеРаздела) Тогда
		НаименованиеРаздела = ТекущаяСмета.Наименование;
	Иначе
		НаименованиеРаздела	= ТекНаименованиеРаздела;
	КонецЕсли;
	
	//// Поиск / создание элемента справочника "Разделы".
	//ТекСпрРаздел = Справочники.СМ_РазделыЛокальнойСметы.НайтиПоНаименованию(НаименованиеРаздела,Истина);
	//Если ТекСпрРаздел = Справочники.СМ_РазделыЛокальнойСметы.ПустаяСсылка() Тогда
	//	ТекСпрРаздел 				= Справочники.СМ_РазделыЛокальнойСметы.СоздатьЭлемент();	
	//	ТекСпрРаздел.Наименование 	= НаименованиеРаздела;
	//	ТекСпрРаздел.Записать();
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый элемент справочника разделы: %1'"), НаименованиеРаздела));
	//КонецЕсли;
	
	//  Создание нового документа "Раздел ЛС". 
	НовДок							= СМ_СметаВызовСервера.СоздатьНовыйРаздел();
	НовДок.НаименованиеДляПечати 	= НаименованиеРаздела;
	НовДок.Дата						= ТекущаяДатаСеанса();
	//НовДок.Раздел 				= ТекСпрРаздел.Ссылка; 
	НовДок.ИДРодителя   			= ?(ВерхнийРаздел = Неопределено,ТекущаяСмета.Ссылка,ВерхнийРаздел);
	НовДок.ИДСметы      			= ТекущаяСмета.Ссылка;
	НовДок.Расчет					= Истина;
	
	НовДок.Записать();
	ТекРаздел = НовДок.Ссылка;
	
	//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ раздел: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НаименованиеРаздела));

	// Запись сообщений в журнал регистрации
	СтруктураСообщения 	= Новый Структура;
	СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
	СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
	СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Создан новый документ раздел: %1, %2, %3'"), НовДок.Номер, НовДок.Дата, НаименованиеРаздела));
	СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	СообщенияДляЖурнала.Добавить(СтруктураСообщения);
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	Возврат ТекРаздел;
	
КонецФункции	

Функция ПреобразоватьВЧисло(ТекСтрока)
	
	Если ЗначениеЗаполнено(ТекСтрока) Тогда
		Попытка
			ТекЧисло = Число(ТекСтрока);
		Исключение
			ТекЧисло = 0;
		КонецПопытки;
	Иначе
		ТекЧисло = 0;
	КонецЕсли;
	
	Возврат ТекЧисло;
	
КонецФункции

Функция ДобавитьСтрокуПоправочногоКоэффициента(ТекОбъект,ТекСтрока)
	
	НоваяСтрока 			= ТекОбъект.ПоправкиПозиции.Добавить();	
	НоваяСтрока.Применить 	= Истина;
	НоваяСтрока.Обоснование = ТекСтрока.ОснованиеКоэффициента;
	НоваяСтрока.Справка		= ТекСтрока.НаименованиеКоэффициента;
	НоваяСтрока.ТипПоправки = Перечисления.СМ_ТипыПоправок.ТехчастиСборников;
	
	Возврат НоваяСтрока;
	
КонецФункции

Процедура ЗаполнитьНормативНРиСП(ТекОбъект,НаименованиеНорматива,ТекКоэффициент)
	
	//  При загрузке нормативов НР и СП преобразовываем их и коэффициентов в проценты. 
	//  При наличии нескольких коэффициентов перемножаем их.
	Если ЗначениеЗаполнено(ТекКоэффициент) Тогда
		ТекКоэффициент = Число(ТекКоэффициент);
	Иначе
		ТекКоэффициент = 0;			
	КонецЕсли;
	
	ТекОбъект[НаименованиеНорматива] = ТекКоэффициент * 100;	
	
КонецПроцедуры

