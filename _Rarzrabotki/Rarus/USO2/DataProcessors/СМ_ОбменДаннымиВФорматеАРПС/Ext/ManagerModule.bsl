Функция НайтиЕдиницуИзмеренияСметномуКоду(Код)
	
	//ЕдиницаИзмерения = Справочники.СМ_ЕдиницыИзмеренияСмета.НайтиПоНаименованию(Код);
	ЕдиницаИзмерения = СМ_СметаВызовСервера.НайтиЕдиницуИзмеренияПоСтроке(Код);
	Если ЕдиницаИзмерения.Пустая() Тогда
		Единица = Справочники.СМ_ЕдиницыИзмеренияСмета.СоздатьЭлемент();
		Единица.Наименование = Код;
		Единица.ОбменДанными.Загрузка = Истина;;
		Единица.Записать();
		ЕдиницаИзмерения = Единица.Ссылка;
	КонецЕсли;
	Возврат(ЕдиницаИзмерения);  
	
КонецФункции

