
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПроцедурыИФункцииАРПС

Функция ЗапуститьЗагрузкаАРПС(СведенияФайлов,Организация,Район,ТекФорма, ТабДокументов, ТабРазделов, ТабПозиций, ТабКоэффициентов, ТабРесурсов, ТабЛимЗатраты, ТабКомментарии) Экспорт
	СтруктураТекФорма = Новый Структура();
	СтруктураТекФорма.Вставить("АнализФайла",ТекФорма.АнализФайла);
	СтруктураТекФорма.Вставить("СоответствияРесурсов",ТекФорма.СоответствияРесурсов.Выгрузить());
	СтруктураТекФорма.Вставить("СоответствияПрефиксов",ТекФорма.СоответствияПрефиксов.Выгрузить());
	СтруктураТекФорма.Вставить("СоответствияЛЗ",ТекФорма.СоответствияЛЗ.Выгрузить());
	СтруктураТекФорма.Вставить("СметнаяПрограмма",ТекФорма.СметнаяПрограмма);
	СтруктураТекФорма.Вставить("КаталогЗагрузки",ТекФорма.КаталогЗагрузки);
	СтруктураТекФорма.Вставить("ИзФайла",ТекФорма.ИзФайла);
	СтруктураТекФорма.Вставить("Стройка",ТекФорма.Стройка);
	СтруктураТекФорма.Вставить("ОбъектСтроительства",ТекФорма.ОбъектСтроительства);
	СтруктураТекФорма.Вставить("НаименованиеСНБазы",ТекФорма.НаименованиеСНБазы);
	СтруктураТекФорма.Вставить("НомерРегиона",ТекФорма.НомерРегиона);
	СтруктураТекФорма.Вставить("НомерРайона",ТекФорма.НомерРайона);
	СтруктураТекФорма.Вставить("ДатаУровняЦен",ТекФорма.ДатаУровняЦен);
	СтруктураТекФорма.Вставить("ТипНСБазы",ТекФорма.ТипНСБазы);
	СтруктураТекФорма.Вставить("СпособРасчета",ТекФорма.СпособРасчета);
	СтруктураТекФорма.Вставить("СоздаватьНовыеЭлементы",ТекФорма.СоздаватьНовыеЭлементы);
	СтруктураТекФорма.Вставить("СметноНормативнаяБаза",ТекФорма.СметноНормативнаяБаза);
	СтруктураТекФорма.Вставить("ТекСтройка",ТекФорма.ТекСтройка);

                          
	ПараметрыЗадания = Новый Структура();
	ПараметрыЗадания.Вставить("СведенияФайлов",СведенияФайлов);
	ПараметрыЗадания.Вставить("ТекФорма",СтруктураТекФорма);
	ПараметрыЗадания.Вставить("ТабДокументов",ТабДокументов);
	ПараметрыЗадания.Вставить("ТабРазделов",ТабРазделов);
	ПараметрыЗадания.Вставить("ТабПозиций",ТабПозиций);
	ПараметрыЗадания.Вставить("ТабКоэффициентов",ТабКоэффициентов);
	ПараметрыЗадания.Вставить("ТабРесурсов",ТабРесурсов);
	ПараметрыЗадания.Вставить("ТабЛимЗатраты",ТабЛимЗатраты);
	ПараметрыЗадания.Вставить("ТабКомментарии",ТабКомментарии);
	ПараметрыЗадания.Вставить("Организация",Организация);
	ПараметрыЗадания.Вставить("Район",Район);
	
	Для Каждого ТекФайл Из СведенияФайлов Цикл
		Запись = РегистрыСведений.СМ_Файлы.СоздатьМенеджерЗаписи();
		Запись.ИмяФайла = ТекФайл.Загрузка_ПолныйПуть;
		Запись.Файл = Новый ХранилищеЗначения(ПолучитьИЗВременногоХранилища(ТекФайл.Загрузка_АдресВременногоХранилища));
		Запись.Записать();
	КонецЦикла;
	
	Попытка
		Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		ТекФорма.УникальныйИдентификатор,
		"Обработки.СМ_ОбменДаннымиВФорматеАРПС.ЗагрузитьАРПС",
		ПараметрыЗадания, 
		НСтр("ru = 'Загрузка АРПС'"));
		
	Исключение
		ПредставлениеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Событие = НСтр("ru = 'Загрузка АРПС'");
		ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , , ПредставлениеОшибки);
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;

КонецФункции

Процедура ЗагрузитьАРПС(СтруктураПараметровЗадания,АдресХранилища) Экспорт
	Перем ДокСсылка;
	Перем СметнаяПрограмма;
	Перем ФорматВыгрузки;
	Перем ТекущаяСмета;
	Перем ТекущийРаздел;
	Перем ТекущаяПозицияЛС;
	Перем ТекКонтрагент;
	Перем Форма;
	Перем ПрефиксыПрограммы;

	Форма = СтруктураПараметровЗадания.ТекФорма;
	ТабДокументов = СтруктураПараметровЗадания.ТабДокументов;
	ТабРазделов = СтруктураПараметровЗадания.ТабРазделов;
	ТабПозиций = СтруктураПараметровЗадания.ТабПозиций;
	ТабКоэффициентов = СтруктураПараметровЗадания.ТабКоэффициентов;
	ТабРесурсов = СтруктураПараметровЗадания.ТабРесурсов;
	ТабЛимЗатраты = СтруктураПараметровЗадания.ТабЛимЗатраты;
	ТабКомментарии = СтруктураПараметровЗадания.ТабКомментарии;
	Организация = СтруктураПараметровЗадания.Организация;
	Район = СтруктураПараметровЗадания.Район;
    СведенияФайлов = СтруктураПараметровЗадания.СведенияФайлов;
	Если Не Форма.АнализФайла Тогда
		Если Форма.СоответствияПрефиксов.Количество()>0 Тогда
			Для Каждого стр Из Форма.СоответствияПрефиксов Цикл
				РС_Шифр = РегистрыСведений.СМ_АРПС_ПрефиксыОбъектов.СоздатьМенеджерЗаписи();
				РС_Шифр.СметнаяПрограмма = стр.СметнаяПрограмма;
				РС_Шифр.СтрокаПрефикса = стр.СтрокаПрефикса;
				РС_Шифр.ТипНормативногоСборника = стр.ТипНормативногоСборника;
				РС_Шифр.Определитель = стр.Определитель;
				РС_Шифр.ВидРесурса = стр.ВидРесурса;
				РС_Шифр.СоздаватьЗаписиВСправочнике = стр.СоздаватьЗаписиВСправочнике;
				РС_Шифр.НеОтбрасыватьПрефикс = стр.НеОтбрасыватьПрефикс;
				РС_Шифр.РедактироваласьПользователем = Истина;
				РС_Шифр.Записать(Ложь);
			КонецЦикла;
		КонецЕсли;
		Если Форма.СоответствияРесурсов.Количество()>0 Тогда
			Для Каждого стр Из Форма.СоответствияРесурсов Цикл
				Если стр.СсылкаВБазе.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				РС_Шифр = РегистрыСведений.СМ_АРПС_СоответствияШифров.СоздатьМенеджерЗаписи();
				РС_Шифр.СметнаяПрограмма = стр.СметнаяПрограмма;
				РС_Шифр.ШифрАРПС = стр.КодРесурса;
				РС_Шифр.Шифр = стр.СсылкаВБазе.Код;
				РС_Шифр.Ресурс = стр.СсылкаВБазе;
				РС_Шифр.РедактироваласьПользователем = Истина;
				РС_Шифр.Записать(Ложь);
			КонецЦикла;
		КонецЕсли;
		Если Форма.СоответствияЛЗ.Количество()>0 Тогда		
			Для Каждого стр Из Форма.СоответствияЛЗ Цикл
				Если стр.НеЯвляетсяЛимЗатратой Тогда
					РС_ЛимЗатрат = РегистрыСведений.СМ_АРПС_Итоги.СоздатьМенеджерЗаписи();
					РС_ЛимЗатрат.НаименованиеЛимзатратыАРПС = стр.НаименованиеЛЗ;
					РС_ЛимЗатрат.РедактироваласьПользователем = Истина;
					РС_ЛимЗатрат.Записать(Ложь);
					Продолжить;
				КонецЕсли;
				Если стр.СсылкаВБазе.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				РС_ЛимЗатрат = РегистрыСведений.СМ_АРПС_СоответствияЛимЗатрат.СоздатьМенеджерЗаписи();
				РС_ЛимЗатрат.СметнаяПрограмма = стр.СметнаяПрограмма;
				РС_ЛимЗатрат.НаименованиеЛимзатратыАРПС = стр.НаименованиеЛЗ;
				РС_ЛимЗатрат.ИдентификаторЛимЗатраты = стр.СсылкаВБазе.Идентификатор;
				РС_ЛимЗатрат.ЛимЗатрата =  стр.СсылкаВБазе;
				РС_ЛимЗатрат.НаименованиеЛимзатраты = стр.СсылкаВБазе.Наименование;
				РС_ЛимЗатрат.РедактироваласьПользователем = Истина;
				РС_ЛимЗатрат.Записать(Ложь);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

    СметнаяПрограмма = Справочники.СМ_СметныеПрограммы.ПустаяСсылка();
	
	//  ******************************************
	
	Если НЕ ЗначениеЗаполнено(Форма.КаталогЗагрузки) Тогда
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Каталог / файл загрузки не указан!'"));
		
		// Запись сообщений в журнал регистрации
		СтруктураСообщения 	= Новый Структура;
		СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
		СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
		СтруктураСообщения.Вставить("Комментарий",НСтр("ru='Каталог / файл загрузки не указан!'"));
		СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
		
		СообщенияДляЖурнала	= Новый СписокЗначений();
		СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		Возврат;
	КонецЕсли;
	
	ТекстОшибки = "";
	НачатьТранзакцию();
	Если Форма.ИзФайла Тогда
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",СведенияФайлов[0].Загрузка_ПолныйПуть)); 
		Запись.Следующий();
		ДвоичныеДанные = Запись.Файл.Получить();
		ДвоичныеДанные.Записать(ИмяВременногоФайла);

		//  Определяем версию формата по первым строка
		ВерсияФормата = УстановитьВерсиюФормата(Форма,ИмяВременногоФайла);
		

		//  Кодировка файла устанавливается в зависимости от версии формата
		Если ВерсияФормата = 1 Тогда
			Текст = Новый ЧтениеТекста(ИмяВременногоФайла,"cp866");
		Иначе
			Текст = Новый ЧтениеТекста(ИмяВременногоФайла);
		КонецЕсли;
		
		//  Чтение файла
		Стр 		= "пустая";
		сч=1;
		КодВерхнейСтроки = "";
		ВерхнийРаздел = Неопределено;
		ТекущаяПозицияВладелецЛС = Неопределено;
		Пока Стр <> Неопределено Цикл
			Стр 			= Текст.ПрочитатьСтроку();
			МассивЭлементов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Стр,"#");
			Если МассивЭлементов.Количество() > 0 Тогда
				Если сч = 1 Тогда
					Попытка
						НаименованиеПрограммы = МассивЭлементов[2];
					Исключение
						НаименованиеПрограммы = "";	
					КонецПопытки;
					СтрокаПрограммы = СведенияФайлов[0];
					Если Не СтрокаПрограммы = Неопределено И ЗначениеЗаполнено(СтрокаПрограммы.Загрузка_СведенияОПрограмме) Тогда
						СметнаяПрограмма = СтрокаПрограммы.Загрузка_СведенияОПрограмме;
					Иначе
						СметнаяПрограмма = СМ_АРПС_ОбменВызовСервера.ПолучитьПрограмму(НаименованиеПрограммы);
					КонецЕсли;
					ПрефиксыПрограммы = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксы(СметнаяПрограмма);
				КонецЕсли;
				ЗагрузитьЭлементМассива(СтрокаПрограммы,Организация,Район,ТекущаяСмета,ТекущийРаздел,ТекущаяПозицияЛС,ТекКонтрагент,Форма,ВерсияФормата,ПрефиксыПрограммы,СметнаяПрограмма,МассивЭлементов,Стр,ТабПозиций,ТабДокументов,ТабРазделов,ТабКоэффициентов,ТабРесурсов,ТабКомментарии,ТабЛимЗатраты,КодВерхнейСтроки,ВерхнийРаздел,ТекущаяПозицияВладелецЛС,ТекстОшибки);
			КонецЕсли;
			сч=сч+1;
		КонецЦикла;
		
		Если Не Форма.АнализФайла Тогда
			Попытка
				СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(ТекущаяСмета);
				Документы.СМ_ЛокальнаяСмета.Перерасчет(ТекущаяСмета, Ложь);
			Исключение
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), ТекущаяСмета.Номер, ТекущаяСмета.Дата, ТекущаяСмета.Наименование));
				
				// Запись сообщений в журнал регистрации
				СтруктураСообщения 	= Новый Структура;
				СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
				СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
				СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), ТекущаяСмета.Номер, ТекущаяСмета.Дата, ТекущаяСмета.Наименование));
				СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
				
				СообщенияДляЖурнала	= Новый СписокЗначений();
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
				ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
			КонецПопытки;
		КонецЕсли;
	Иначе
	
		Для Каждого ТекФайл Из СведенияФайлов Цикл

			ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
			Запись = РегистрыСведений.СМ_Файлы.Выбрать(Новый Структура("ИмяФайла",ТекФайл.Загрузка_ПолныйПуть)); 
			Запись.Следующий();
			ДвоичныеДанные = Запись.Файл.Получить();
			ДвоичныеДанные.Записать(ИмяВременногоФайла);

			//  Определяем версию формата по первым строка
			ВерсияФормата = УстановитьВерсиюФормата(Форма,ИмяВременногоФайла);
			
			//  Кодировка файла устанавливается в зависимости от версии формата
			Если ВерсияФормата = 1 Тогда
				Текст = Новый ЧтениеТекста(ИмяВременногоФайла,"cp866");	
			Иначе
				Текст = Новый ЧтениеТекста(ИмяВременногоФайла);
			КонецЕсли;

			//  Чтение файла
			Стр = "пустая";
			сч=1;
			КодВерхнейСтроки = "";
			ВерхнийРаздел = Неопределено;
			ТекущаяПозицияВладелецЛС = Неопределено;
			Пока Стр <> Неопределено Цикл
				Стр 			= Текст.ПрочитатьСтроку();
				МассивЭлементов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Стр,"#");
				Если МассивЭлементов.Количество() > 0 Тогда
					Если сч = 1 Тогда
						Попытка
							НаименованиеПрограммы = МассивЭлементов[2];
						Исключение
							НаименованиеПрограммы = "";	
						КонецПопытки;
						СтрокаПрограммы = СведенияФайлов.Найти(ТекФайл.Загрузка_ПолныйПуть,"Загрузка_ПолныйПуть");
						Если Не СтрокаПрограммы = Неопределено И ЗначениеЗаполнено(СтрокаПрограммы.Загрузка_СведенияОПрограмме) Тогда
							СметнаяПрограмма = СтрокаПрограммы.Загрузка_СведенияОПрограмме;
						Иначе
							СметнаяПрограмма = СМ_АРПС_ОбменВызовСервера.ПолучитьПрограмму(НаименованиеПрограммы);
						КонецЕсли;
						ПрефиксыПрограммы = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксы(СметнаяПрограмма);
					КонецЕсли;
					ЗагрузитьЭлементМассива(СтрокаПрограммы,Организация,Район,ТекущаяСмета,ТекущийРаздел,ТекущаяПозицияЛС,ТекКонтрагент,Форма,ВерсияФормата,ПрефиксыПрограммы,СметнаяПрограмма,МассивЭлементов,Стр,ТабПозиций,ТабДокументов,ТабРазделов,ТабКоэффициентов,ТабРесурсов,ТабКомментарии,ТабЛимЗатраты,КодВерхнейСтроки,ВерхнийРаздел,ТекущаяПозицияВладелецЛС,ТекстОшибки);
				КонецЕсли;
				сч=сч+1;
			КонецЦикла;
			
			Если Не Форма.АнализФайла Тогда
				Попытка
					СМ_СметныйСоставВызовСервера.ПеренумероватьДерево(ТекущаяСмета);
					Документы.СМ_ЛокальнаяСмета.Перерасчет(ТекущаяСмета, Ложь);
				Исключение
					//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), Форма.ТекущаяСмета.Номер, Форма.ТекущаяСмета.Дата, Форма.ТекущаяСмета.Наименование));
					
					// Запись сообщений в журнал регистрации
					СтруктураСообщения 	= Новый Структура;
					СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
					СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
					СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='ЛС не рассчитана: %1, %2, %3'"), Форма.ТекущаяСмета.Номер, Форма.ТекущаяСмета.Дата, Форма.ТекущаяСмета.Наименование));
					СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
					
					СообщенияДляЖурнала	= Новый СписокЗначений();
					СообщенияДляЖурнала.Добавить(СтруктураСообщения);
					ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТекстОшибки = "" Тогда
		ЗафиксироватьТранзакцию();
	Иначе
		Для Каждого ТекСтрока Из СведенияФайлов Цикл
			ТекСтрока.Загрузка_СозданныйДокумент = "";
		КонецЦикла;
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		// Запись сообщений в журнал регистрации
		СтруктураСообщения 	= Новый Структура;
		СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
		СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
		СтруктураСообщения.Вставить("Комментарий",ТекстОшибки);
		СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
		
		СообщенияДляЖурнала	= Новый СписокЗначений();
		СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		
		ОтменитьТранзакцию();
	КонецЕсли;
		     
	СтруктураПараметровЗадания.ТекФорма = Форма;
	СтруктураПараметровЗадания.ТабДокументов = ТабДокументов;
	СтруктураПараметровЗадания.ТабРазделов = ТабРазделов;
	СтруктураПараметровЗадания.ТабПозиций = ТабПозиций;
	СтруктураПараметровЗадания.ТабКоэффициентов = ТабКоэффициентов;
	СтруктураПараметровЗадания.ТабРесурсов = ТабРесурсов;
	СтруктураПараметровЗадания.ТабЛимЗатраты = ТабЛимЗатраты;
	СтруктураПараметровЗадания.ТабКомментарии = ТабКомментарии;
	СтруктураПараметровЗадания.СведенияФайлов = СведенияФайлов;
	ПоместитьВоВременноеХранилище(СтруктураПараметровЗадания, АдресХранилища); 
	
КонецПроцедуры

Процедура ЗагрузитьЭлементМассива(СтрокаПрограммы,Организация,Район,ТекущаяСмета,ТекущийРаздел,ТекущаяПозицияЛС,ТекКонтрагент,Форма,ВерсияФормата,ПрефиксыПрограммы,СметнаяПрограмма,МассивЭлементов,Стр,ТабПозиций,ТабДокументов,ТабРазделов,ТабКоэффициентов,ТабРесурсов,ТабКомментарии,ТабЛимЗатраты,КодВерхнейСтроки,ВерхнийРаздел,ТекущаяПозицияВладелецЛС,ТекстОшибки)
	
	Комментарий = "";
	КодБлока  	= МассивЭлементов[0];
	
	Если МассивЭлементов.Количество() > 1 Тогда
		КодСтроки = МассивЭлементов[1];
	Иначе
		Комментарий = Комментарий + МассивЭлементов[0];	
	КонецЕсли;
	
	// Блок описание формата (v 2.0) / Комментарий (v 1.1).
	Если КодБлока = "0" Тогда
		
		// Комментарий
		Если ВерсияФормата = 1 Тогда
			Комментарий = МассивЭлементов[1];		
		// Описание формата	 	
		Иначе
			Если КодСтроки = "1" Тогда
				ВерсияСтандарта					= МассивЭлементов[1];
				НаименованиеПрограммы			= МассивЭлементов[2];
			ИначеЕсли КодСтроки = "2" Тогда
				НаименованиеПрограммыИсточника	= МассивЭлементов[1];
				НомерВерсииПрограммыИсточника 	= МассивЭлементов[2];
				РегНомерПрограммыИсточника 		= МассивЭлементов[3];
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Блок стройка (v 2.0) / Описание формата (v 1.1).
	Если КодБлока = "1" Тогда
		
		Если ВерсияФормата = 1 Тогда
			// Описание формата		
			Попытка
				ВерсияСтандарта = МассивЭлементов[1];
			Исключение
				ВерсияСтандарта = "";	
			КонецПопытки;

			Попытка
				НаименованиеПрограммы = МассивЭлементов[2];
			Исключение
				НаименованиеПрограммы = "";	
			КонецПопытки;
			
			Попытка
				НомерВерсииПрограммы = МассивЭлементов[3];
			Исключение
				НомерВерсииПрограммы = "";	
			КонецПопытки
		Иначе
			// Описание стройки	
			НаименованиеСтройки = МассивЭлементов[1];
			АдресСтройки		= МассивЭлементов[2];
			КодСтройки          = МассивЭлементов[3];
			Форма.Стройка 	= НаименованиеСтройки;
		КонецЕсли;
	КонецЕсли;	
	
	// ***************************	
	// Блок объект строительства 
	// ***************************

	// Описание объекта 
	Если КодБлока = "2" Тогда	
		НаименованиеОбъекта 			= МассивЭлементов[1];
		АдресОбъекта					= МассивЭлементов[2];
		КодОбъекта          			= МассивЭлементов[3];
		Форма.ОбъектСтроительства 	= НаименованиеОбъекта;
	КонецЕсли;	
	
	// ***************************	
	// Блок документов 
	// ***************************
	
	// Описание документа 
	Если КодБлока = "3" Тогда	
		Если Не ПолучитьФункциональнуюОпцию("СМ_ИспользованиеУчетаВыполненныхРабот") И МассивЭлементов[5] = "АКТ" Тогда
			Возврат;
		КонецЕсли;
		Сч = 1;
		НоваяСтрока = ТабДокументов.Добавить();
		Для Каждого ТекКолонка Из ТабДокументов.Колонки Цикл
			Попытка 
				НоваяСтрока[ТекКолонка.Имя] = МассивЭлементов[Сч];
			Исключение
				НоваяСтрока[ТекКолонка.Имя] = "";	
			КонецПопытки;
			Сч = Сч + 1;
		КонецЦикла;
		
		Если ВерсияФормата = 1 Тогда
			НоваяСтрока.ПредставительЗаказчика 		= ЗаполнитьЭлементМассива(МассивЭлементов,7);
			НоваяСтрока.Подрядчик					= ЗаполнитьЭлементМассива(МассивЭлементов,8);
			НоваяСтрока.ПредставительПодрядчика 	= ЗаполнитьЭлементМассива(МассивЭлементов,9);
			НоваяСтрока.Субподрядчик				= ЗаполнитьЭлементМассива(МассивЭлементов,10);
			НоваяСтрока.ПредставительСубподрядчика 	= ЗаполнитьЭлементМассива(МассивЭлементов,11);
			НоваяСтрока.Составил					= ЗаполнитьЭлементМассива(МассивЭлементов,12);
			НоваяСтрока.Контролер	                = ЗаполнитьЭлементМассива(МассивЭлементов,13);
			НоваяСтрока.ОбщаяСтоимость				= ЗаполнитьЭлементМассива(МассивЭлементов,14);
			НоваяСтрока.ДатаЦен                  	= ЗаполнитьЭлементМассива(МассивЭлементов,15);
			НоваяСтрока.ПериодДокумента          	= ЗаполнитьЭлементМассива(МассивЭлементов,16);
			КодСтройки                              = ЗаполнитьЭлементМассива(МассивЭлементов,17);
			Форма.Стройка 						= ЗаполнитьЭлементМассива(МассивЭлементов,18);
			НоваяСтрока.ПроектнаяДокументация	    = ЗаполнитьЭлементМассива(МассивЭлементов,19);
			Форма.НаименованиеСНБазы             = ЗаполнитьЭлементМассива(МассивЭлементов,20);
		КонецЕсли;
		
		Если НЕ Форма.АнализФайла Тогда
			ТекущаяСмета = ПолучитьСоздатьДокументЛС(Организация,Район,Форма,НоваяСтрока);
			Если Не ЗначениеЗаполнено(СтрокаПрограммы.Загрузка_СозданныйДокумент) Тогда
				СтрокаПрограммы.Загрузка_СозданныйДокумент = ТекущаяСмета;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//  ***************************
	//  Описание сметно-нормативной базы
	Если КодБлока = "5" Тогда		
		
		// 1) Номер региона, для которого разработана база (число). 
		// Список регионов и их номеров приведен в приложении к настоящему документу.
		// Для федеральных (общероссийских) баз поле не заполняется. 
		// Ведомственные нормативные базы имеют номера от 100 до 9999. 
		// Расценки, не относящиеся к какой-либо нормативной базе, имеют номер 10000.
		// 2) Номер зоны (района), для которого разработана база (текст). 
		// Если для данной базы нет деления на зоны (районы), поле не заполняется.
		// 3) Дата, которой соответствует уровень цен в базе (дата). 
		// Для баз, не содержащих расценок, поле не заполняется.
		// 4) Тип базы: 0 - элементные сметные нормы (ГЭСН), 1 - единичные расценки (ФЕР, ТЕР и т.п.),
		// 2 - Московские территориальные сметные нормы (МТСН 81-98, ТСН 2001).
		// 5) Способ расчета: 0 - ресурсный, 1 - базисно-индексный.
		// 6) Наименование базы.

		Форма.НомерРегиона 		= МассивЭлементов[1];
		Форма.НомерРайона		= МассивЭлементов[2];
		Форма.ДатаУровняЦен		= МассивЭлементов[3];
		Форма.ТипНСБазы			= МассивЭлементов[4];
		Форма.СпособРасчета		= МассивЭлементов[5];
		Форма.НаименованиеСНБазы = МассивЭлементов[6];

	КонецЕсли;	
	
	// ***************************
	// Описание раздела документа.
	// Для версий формата 1.1 и 2.0 отличий нет.
	Если КодБлока = "10" Тогда	
		Сч = 1;
		НоваяСтрока = ТабРазделов.Добавить();
		Для Каждого ТекКолонка Из ТабРазделов.Колонки Цикл
			Попытка 
				НоваяСтрока[ТекКолонка.Имя] = МассивЭлементов[Сч];
			Исключение
				НоваяСтрока[ТекКолонка.Имя] = "";
			КонецПопытки;
			Сч = Сч + 1;
		КонецЦикла;
		
		Если НЕ Форма.АнализФайла Тогда
			ТекущийРаздел = ПолучитьСоздатьДокументРаздел(ТекущаяСмета,НоваяСтрока.НомерРаздела,НоваяСтрока.НаименованиеРаздела,?(НоваяСтрока.УровеньЗаголовка <> "0",ВерхнийРаздел,Неопределено));
		КонецЕсли;
	КонецЕсли;	
	
	// ***************************
	// Описание расценки (позиции ЛС)
	Если КодБлока = "20" Тогда	
				
		НоваяСтрока = ТабПозиций.Добавить();
		Сч = 1;
		Для Каждого ТекКолонка Из ТабПозиций.Колонки Цикл
			Попытка 
				НоваяСтрока[ТекКолонка.Имя] = МассивЭлементов[Сч];
			Исключение
				НоваяСтрока[ТекКолонка.Имя] = "";
			КонецПопытки;
			Сч = Сч + 1;
		КонецЦикла;
		
		Если ВерсияФормата = 1 Тогда
			Если МассивЭлементов.Количество() < 30 Тогда 
				// ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Версия формата не соответствует данным в файле. Данные могут быть загружены неверно.'")); 
				
				// Запись сообщений в журнал регистрации
				СтруктураСообщения 	= Новый Структура;
				СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
				СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Предупреждение'"));
				СтруктураСообщения.Вставить("Комментарий",НСтр("ru='Версия формата не соответствует данным в файле. Данные могут быть загружены неверно.'"));
				СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
				
				СообщенияДляЖурнала	= Новый СписокЗначений();
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
				ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
				
				НоваяСтрока.НормаРасхода 		= "";
				НоваяСтрока.ТипПозиции			= "";
				НоваяСтрока.НомерПозицииВСмете 	= 0;
				НоваяСтрока.НомерСметы 			= 0;
			Иначе
				НоваяСтрока.НормаРасхода 		= "";
				НоваяСтрока.ТипПозиции			= "";
				НоваяСтрока.НомерПозицииВСмете 	= МассивЭлементов[28];
				НоваяСтрока.НомерСметы 			= МассивЭлементов[29];
			КонецЕсли;
		КонецЕсли;
		МассивПодстроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НоваяСтрока.НомерСтроки,",");
		Если МассивПодстроки.Количество()>1 И НЕ МассивПодстроки[1] = "0" Тогда
			НоваяСтрока.ПризнакПодчиненности = Истина;
		Иначе
			НоваяСтрока.ПризнакПодчиненности = Ложь;
		КонецЕсли;
		Определитель = Неопределено;
		ТСН = Неопределено; 
		НужнаяСтрока = Неопределено;
		Если ПрефиксыПрограммы<>Неопределено И ПрефиксыПрограммы.Количество()>0 Тогда
			НужнаяСтрока = СМ_АРПС_ОбменВызовСервера.НайтиСтрокуПоПрефиксу(НоваяСтрока.ШифрПозиции,ПрефиксыПрограммы);
			Если НЕ НужнаяСтрока = Неопределено Тогда
				НоваяСтрока.ШифрПозиции = ?(НужнаяСтрока.НеОтбрасыватьПрефикс,НоваяСтрока.ШифрПозиции,НужнаяСтрока.ШифрБезПрефикса);
				Определитель = НужнаяСтрока.Определитель;
				ТНС = НужнаяСтрока.ТНС; 
			КонецЕсли;
		КонецЕсли;

		
		Если ВерсияФормата = 1 Тогда
			
			Если НужнаяСтрока = Неопределено Тогда
				ПрефиксШифра = ПолучитьПрефиксШифра(НоваяСтрока.ШифрПозиции);
			Иначе
				ПрефиксШифра = НужнаяСтрока.Префикс;
			КонецЕсли;
			ШифрПозиции = СтрЗаменить(НоваяСтрока.ШифрПозиции,ШифрПозиции,"");
			
			Если ПрефиксШифра = "" Тогда
				
				ПозДефис = СтрНайти(ШифрПозиции,"-");
				Проверка = Лев(ШифрПозиции,ПозДефис-1);
				СтроительныеРаботы = Ложь;
				РемонтноСтроительныеРаботы = Ложь;
				
				Если Лев(Проверка,1)="0" Тогда
					Попытка
						ПроверкаЧисло = Число(Проверка);
						Если ПроверкаЧисло>=1 И ПроверкаЧисло<=47 Тогда
							СтроительныеРаботы = Истина;
						КонецЕсли;
					Исключение
						СтроительныеРаботы = Ложь;
					КонецПопытки;
				Иначе
					Попытка
						ПроверкаЧисло = Число(Проверка);
						Если ПроверкаЧисло>=51 И ПроверкаЧисло<=69 Тогда
							РемонтноСтроительныеРаботы = Истина;
						КонецЕсли;
					Исключение
						РемонтноСтроительныеРаботы = Ложь;
					КонецПопытки;
				КонецЕсли;
				
				Если СтроительныеРаботы Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду("1");
					ТНС = Перечисления.СМ_ТипыНормативныхСборников.СтроительныеРаботы; 
				ИначеЕсли РемонтноСтроительныеРаботы Тогда	
					Определитель = Справочники.СМ_Определители.НайтиПоКоду("1");
					ТНС = Перечисления.СМ_ТипыНормативныхСборников.РемонтноСтроительныеРаботы; 
				ИначеЕсли Число(?(НоваяСтрока.ПрямыеЗатраты="",0,НоваяСтрока.ПрямыеЗатраты))>0 ИЛИ Число(?(НоваяСтрока.СтоимостьМатериалов="",0,НоваяСтрока.СтоимостьМатериалов))>0 Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду("19");
					ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы; 
				ИначеЕсли Число(?(НоваяСтрока.ПрямыеЗатраты="",0,НоваяСтрока.ПрямыеЗатраты))>0 И НоваяСтрока.ПрямыеЗатраты = НоваяСтрока.СтоимостьМатериалов Тогда
					Определитель = Справочники.СМ_Определители.НайтиПоКоду("19");
					ТНС = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы;
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЕсли;
		
		Если НЕ Форма.АнализФайла Тогда
			ТекущаяПозицияЛС = ПолучитьСоздатьДокументПозицияЛС(ТекущаяПозицияВладелецЛС,ТекущаяСмета,ТекущийРаздел,Форма,ВерсияФормата,НоваяСтрока,Определитель,ТНС,СметнаяПрограмма);
			ПолучитьСоздатьПоправочныйКоэффициент(ВерсияФормата,Неопределено,ТекущаяПозицияЛС,ТабКоэффициентов);
		Иначе
			Если НужнаяСтрока = Неопределено Тогда
				АнализДокументПозицияЛС(СтрокаПрограммы,Форма,ВерсияФормата,НоваяСтрока,Определитель,ТНС);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;	
	
	// ***************************
	// Описание поправочных коэффициентов.
	// Для версий формата 1.1 и 2.0 отличий нет.
	Если КодБлока = "25" Тогда	
			
		НоваяСтрока = ТабКоэффициентов.Добавить();
		Сч = 1;
		Для Каждого ТекКолонка Из ТабКоэффициентов.Колонки Цикл
			Если ТекКолонка.Имя = "ДляВсех" Тогда
				Продолжить;
		    КонецЕсли;
			Попытка 
				НоваяСтрока[ТекКолонка.Имя] = СокрЛП(МассивЭлементов[Сч]);
			Исключение
				НоваяСтрока[ТекКолонка.Имя] = "";
			КонецПопытки;
			Сч = Сч + 1;
		КонецЦикла;
		
		Если КодВерхнейСтроки = "10" Тогда
			НоваяСтрока.ДляВсех = Истина;
		Иначе
			НоваяСтрока.ДляВсех = Ложь;
		КонецЕсли;
		
		Если НЕ Форма.АнализФайла И ЗначениеЗаполнено(ТекущаяПозицияЛС) Тогда
			ПолучитьСоздатьПоправочныйКоэффициент(ВерсияФормата,НоваяСтрока,ТекущаяПозицияЛС,Неопределено);
		КонецЕсли;
		
	КонецЕсли;	
		
	//  Описание ресурсов	
	Если КодБлока = "30" Тогда		
		
		НоваяСтрока = ТабРесурсов.Добавить();
		Сч = 1;
		Для Каждого ТекКолонка Из ТабРесурсов.Колонки Цикл
			Попытка 
				НоваяСтрока[ТекКолонка.Имя] = МассивЭлементов[Сч];
			Исключение
				НоваяСтрока[ТекКолонка.Имя] = "";
			КонецПопытки;
			
			Если ВерсияФормата = 1 И Сч > 8 Тогда
				НоваяСтрока[ТекКолонка.Имя] = "";
			КонецЕсли;	
			
			Сч = Сч + 1;
					
		КонецЦикла;
		ВидРесурса = Неопределено; 
		РесурсРС = Неопределено;
		НужнаяСтрока = Неопределено;
		Если ПрефиксыПрограммы<>Неопределено И ПрефиксыПрограммы.Количество()>0 Тогда
			НужнаяСтрока = СМ_АРПС_ОбменВызовСервера.НайтиСтрокуПоПрефиксу(НоваяСтрока.КодРесурса,ПрефиксыПрограммы);
			Если НЕ НужнаяСтрока = Неопределено Тогда
				НоваяСтрока.КодРесурса = ?(НужнаяСтрока.НеОтбрасыватьПрефикс,НоваяСтрока.КодРесурса,НужнаяСтрока.ШифрБезПрефикса);
				ВидРесурса = ?(ЗначениеЗаполнено(НужнаяСтрока.ВидРесурса),НужнаяСтрока.ВидРесурса,Неопределено);
			    РесурсРС = СМ_АРПС_ОбменВызовСервера.НайтиРесурсАРПС(СметнаяПрограмма,НоваяСтрока);
			КонецЕсли;
		КонецЕсли;
        
		ПолучитьСоздатьРесурс(НужнаяСтрока,СтрокаПрограммы,ТекущаяПозицияЛС,Форма,НоваяСтрока,ВидРесурса,РесурсРС,ТекстОшибки);
	
	КонецЕсли;	
		
	// Описание комментариев в документе.
	// Только для формата 2.0.
	Если КодБлока = "40" Тогда		
		НоваяСтрока 					= ТабКомментарии.Добавить();
		НоваяСтрока.ТекстКомментария 	= МассивЭлементов[1];
	КонецЕсли;	
		
	// Описание лимитированных затрат.
	// Для версий формата 1.1 и 2.0 отличий нет.
	Если КодБлока = "50" Тогда
		ЛимЗатрата = Неопределено;
		ПропуститьСроку = СМ_АРПС_ОбменВызовСервера.ПолучитьПропускаемуюЛимЗатрату(СокрЛП(МассивЭлементов[1])); 
		Если Не ПропуститьСроку Тогда
			НоваяСтрока = ТабЛимЗатраты.Добавить();
			Сч = 1;
			Для Каждого ТекКолонка Из ТабЛимЗатраты.Колонки Цикл
				Попытка 
					НоваяСтрока[ТекКолонка.Имя] = СокрЛП(МассивЭлементов[Сч]);
				Исключение
					НоваяСтрока[ТекКолонка.Имя] = "";
				КонецПопытки;
				Сч = Сч + 1;
			КонецЦикла;
			Если ЗначениеЗаполнено(СметнаяПрограмма) Тогда
				ЛимЗатрата = СМ_АРПС_ОбменВызовСервера.ПолучитьЛимЗатрату(СметнаяПрограмма,НоваяСтрока.Наименование);
			КонецЕсли;
			ПолучитьСоздатьЛимЗатрата(СтрокаПрограммы,ТекущаяСмета,Форма,НоваяСтрока,ЛимЗатрата);
		КонецЕсли;
	КонецЕсли;
	
	Если КодБлока = "10" ИЛИ КодБлока = "20" Тогда
		КодВерхнейСтроки = КодБлока;
	КонецЕсли;
	
	Если НЕ Форма.АнализФайла Тогда
		Если КодБлока = "10" Тогда
			Если НоваяСтрока.УровеньЗаголовка = "0" Тогда
				ВерхнийРаздел = ТекущийРаздел;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьПрефиксШифра(ШифрПозиции)
	Префикс = "";
	
	КолСиволов = СтрДлина(ШифрПозиции);
	сч = 1;
	Пока сч <= КолСиволов Цикл
		Символ = Сред(ШифрПозиции,сч,1);
		Если СтрНайти("0123456789",Символ)>0 Тогда
			Прервать;
		КонецЕсли;
		Префикс = Префикс + Строка(Символ);
		сч = сч+1;
	КонецЦикла;	
	Возврат Префикс;
КонецФункции

Функция ЗаполнитьЭлементМассива(МассивЭлементов,Сч)
	
	Если (МассивЭлементов.Количество()-1) >= Сч Тогда
		Возврат МассивЭлементов[Сч];	
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция УстановитьВерсиюФормата(Форма,ИмяФайла="") 
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		ТекстДок = Новый ЧтениеТекста(ИмяФайла);
	Иначе
		ТекстДок = Новый ЧтениеТекста(Форма.КаталогЗагрузки);
	КонецЕсли;
	
	ТекСтрока1 	 	= ТекстДок.ПрочитатьСтроку();
	ТекСтрока2 	 	= ТекстДок.ПрочитатьСтроку();
	
	ВерсияФормата = 0;
	
	//  По первой строке файла 
	Загрузка_Формат = НСтр("ru = 'Не определен'");
	Позиция1 = Найти(ТекСтрока1,"1.");
	Позиция2 = Найти(ТекСтрока1,"2.");
	Если Позиция1 > 0 Тогда
		ВерсияФормата = 1;
		Загрузка_Формат = НСтр("ru = 'АРПС 1.10'");
	ИначеЕсли Позиция2 > 0 Тогда
		ВерсияФормата = 2;
		Загрузка_Формат = НСтр("ru = 'АРПС 2.0'");
	КонецЕсли;
	
	//  По второй строке файла 
	Если ВерсияФормата = 0 Тогда
		Позиция1 = Найти(ТекСтрока2,"1.");
		Позиция2 = Найти(ТекСтрока2,"2.");
		Если Позиция1 > 0 Тогда
			ВерсияФормата = 1;
			Загрузка_Формат = НСтр("ru = 'АРПС 1.10'");
		ИначеЕсли Позиция2 > 0 Тогда
			ВерсияФормата = 2;
			Загрузка_Формат = НСтр("ru = 'АРПС 2.0'");
		КонецЕсли;
	КонецЕсли;
	Возврат ВерсияФормата;	
КонецФункции 

Процедура ПолучитьСоздатьЛимЗатрата(СтрокаПрограммы,ТекущаяСмета,Форма,ТекСтрока,ЛимЗатрата)
	
	Если ЛимЗатрата = Неопределено Тогда
		ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.НайтиПоНаименованию(ТекСтрока.Наименование);
	Иначе
		ТекЛимЗатрата = ЛимЗатрата;
	КонецЕсли;
	
	Если Форма.АнализФайла Тогда
		Если ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() Тогда
			НоваяСтрока 				= Форма.СоответствияЛЗ.Добавить();
			НоваяСтрока.НаименованиеЛЗ 	= ТекСтрока.Наименование;
			НоваяСтрока.СметнаяПрограмма = СтрокаПрограммы.Загрузка_СведенияОПрограмме;
			
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Лимитированная затрата: %1 не найдена в справочнике.'"), ТекСтрока.Наименование));
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Лимитированная затрата: %1 не найдена в справочнике.'"), ТекСтрока.Наименование));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		КонецЕсли;
	Иначе	
		Если ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() Тогда
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("НаименованиеЛЗ",ТекСтрока.Наименование);
			МассивСтрок = Форма.СоответствияЛЗ.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 Тогда
				ТекЛимЗатрата = МассивСтрок[0].СсылкаВБазе;			
			КонецЕсли;
		КонецЕсли;
		
		Если ТекЛимЗатрата = Справочники.СМ_ЛимитированныеЗатраты.ПустаяСсылка() Тогда
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Лимитированная затрата: %1, не загружена - не задано соответствие в таблице'"), ТекСтрока.Наименование));		
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Лимитированная затрата: %1, не загружена - не задано соответствие в таблице'"), ТекСтрока.Наименование));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);

			Возврат;
		КонецЕсли;
		
		ТекОбъект 										= ТекущаяСмета.ПолучитьОбъект();
		НоваяСтрока 									= ТекОбъект.ЛимитированныеЗатраты.Добавить();
		НоваяСтрока.ЛимитированнаяЗатрата               = ТекЛимЗатрата;
		НоваяСтрока.КоэффициентСметнойЗарплаты 	    	= ТекЛимЗатрата.КоэффициентСметнойЗарплаты;
		НоваяСтрока.КоэффициентТрудоемкости     		= ТекЛимЗатрата.КоэффициентТрудоемкости;
		НоваяСтрока.Примечание                          = ТекЛимЗатрата.Обоснование;
		НоваяСтрока.Расчет 								= Истина;
		
		Попытка
			ТекКоэффициент = Число(?(ТекСтрока.Коэффициент="",0,ТекСтрока.Коэффициент));
		Исключение
			ТекКоэффициент = 0;
		КонецПопытки;
		
		Если ТекЛимЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Индекс
			ИЛИ ТекЛимЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Коэффициент Тогда
			НоваяСтрока.ЗначениеЛимЗатраты = ТекКоэффициент;
		ИначеЕсли ТекЛимЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент Тогда	
			Если ТекКоэффициент < 1 Тогда
				НоваяСтрока.ЗначениеЛимЗатраты = ТекКоэффициент * 100;
			Иначе
			 	НоваяСтрока.ЗначениеЛимЗатраты = (ТекКоэффициент - 1) * 100;
			КонецЕсли;
	    ИначеЕсли ТекЛимЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Сумма Тогда	
			НоваяСтрока.ЗначениеЛимЗатраты = ТекСтрока.СуммаЗатрат;
		КонецЕсли;
		
		НоваяСтрока.БазисноеЗначениеЛимЗатраты = НоваяСтрока.ЗначениеЛимЗатраты;

		ТекОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьСоздатьРесурс(НужнаяСтрока,СтрокаПрограммы,ТекущаяПозицияЛС,Форма,ТекСтрока,ВидРесурса,РесурсРС,ТекстОшибки)
	НоваяСтрокаПрефикс = Неопределено;
	СоздаватьРесурсы = Ложь;
	Если НужнаяСтрока <> Неопределено И НужнаяСтрока.СоздаватьЗаписиВСправочнике Тогда
		СоздаватьРесурсы = Истина;
	КонецЕсли;
	Если РесурсРС = Неопределено Тогда
		Если НужнаяСтрока = Неопределено Тогда
			Префикс = СМ_АРПС_ОбменВызовСервера.ПолучитьПрефиксИзСтроки(ТекСтрока.КодРесурса);
			Если ЗначениеЗаполнено(Префикс) Тогда
				НоваяСтрокаПрефикс = Форма.СоответствияПрефиксов.Найти(Префикс,"СтрокаПрефикса");
				Если НоваяСтрокаПрефикс = Неопределено Тогда
					НоваяСтрокаПрефикс	= Форма.СоответствияПрефиксов.Добавить();
					НоваяСтрокаПрефикс.СтрокаПрефикса = Префикс;
				КонецЕсли;
				НоваяСтрокаПрефикс.СметнаяПрограмма = СтрокаПрограммы.Загрузка_СведенияОПрограмме;
			КонецЕсли;
		КонецЕсли;
		ТекРесурс = Справочники.СМ_Ресурсы.НайтиПоКоду(ТекСтрока.КодРесурса);	
	Иначе
		ТекРесурс = РесурсРС;
	КонецЕсли;
	Каталог = Справочники.СМ_Ресурсы[Форма.СметноНормативнаяБаза.ГруппаРесурсов.ИмяПредопределенныхДанных];
	Если ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() Тогда
		МассивРодителей = Новый СписокЗначений;
		СМ_СметаЗагрузкаВызовСервера.ПолучитьВсехРодителей(Каталог,МассивРодителей);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Ресурсы.Ссылка
		|ИЗ
		|	Справочник.СМ_Ресурсы КАК Ресурсы
		|ГДЕ
		|	Ресурсы.Ссылка В (&Каталог)
		|	И Ресурсы.Наименование = &Наименование
		|	И Ресурсы.ЭтоГруппа = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("Наименование", ТекСтрока.Наименование);
		Запрос.УстановитьПараметр("Каталог", МассивРодителей);
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			ТекРесурс = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	Если Не Форма.АнализФайла И СоздаватьРесурсы И Форма.СоздаватьНовыеЭлементы И ТекРесурс.Пустая() Тогда
		Если СМ_СметаВызовСервера.НедоступнаРаботаСПрайсами() Тогда
			ТекстОшибки = ТекстОшибки + "Не найден ресурс: " + ТекСтрока.Наименование + ". Загрузка отменена." + Символы.ПС;
			Возврат;
		КонецЕсли;
		ТекРесурсОб = Справочники.СМ_Ресурсы.СоздатьЭлемент();
		Если ТекСтрока.ПризнакТипа = "0" Тогда
			ТекРесурсОб.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;		
		ИначеЕсли ТекСтрока.ПризнакТипа = "1" Тогда
			ТекРесурсОб.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
		ИначеЕсли ТекСтрока.ПризнакТипа = "2" Тогда
			ТекРесурсОб.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
		ИначеЕсли ТекСтрока.ПризнакТипа = "3" Тогда
			ТекРесурсОб.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов;
		КонецЕсли;	
		Если НЕ ВидРесурса = Неопределено Тогда
			ТекРесурсОб.ВидРесурса = ВидРесурса;
		КонецЕсли;
		ТекРесурсОб.Код = ТекСтрока.КодРесурса;
		ТекРесурсОб.Наименование = ТекСтрока.Наименование;
		ТекРесурсОб.ДлинноеНаименование = ТекСтрока.Наименование;
		ТекРесурсОб.Родитель = СМ_СметаЗагрузкаВызовСервера.СоздатьПолучитьПапкуРесурсов(""+ТекРесурсОб.ВидРесурса,Каталог);
		ТекРесурсОб.ЕдиницаИзмерения = НайтиЕдиницуИзмеренияСметномуКоду(ТекСтрока.ЕдиницаИзмерения);
		ТекРесурсОб.ГодВыпуска = ?(ЗначениеЗаполнено(Форма.СметноНормативнаяБаза.ГодВыпуска),Форма.СметноНормативнаяБаза.ГодВыпуска,Перечисления.СМ_ГодыВыпускаБазы.г2009);
		ТекРесурсОб.ВводитьСтоимостьНаОбъем = Ложь;
		ТекРесурсОб.Записать();
		ТекРесурс = ТекРесурсОб.Ссылка;
	КонецЕсли;
	Если Форма.АнализФайла Тогда
		Если ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() И СоздаватьРесурсы Тогда
			НоваяСтрока 					= Форма.СоответствияРесурсов.Добавить();
			НоваяСтрока.НаименованиеРесурса = ТекСтрока.Наименование;
			НоваяСтрока.КодРесурса          = ТекСтрока.КодРесурса;
			НоваяСтрока.СметнаяПрограмма 	= СтрокаПрограммы.Загрузка_СведенияОПрограмме;
			
			//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ресурс не найден в справочнике: %1, %2'"), ТекСтрока.КодРесурса, ТекСтрока.Наименование));
			
			// Запись сообщений в журнал регистрации
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ресурс не найден в справочнике: %1, %2'"), ТекСтрока.КодРесурса, ТекСтрока.Наименование));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			
			СообщенияДляЖурнала	= Новый СписокЗначений();
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
		КонецЕсли;
	Иначе	
		Если ТекРесурс = Справочники.СМ_Ресурсы.ПустаяСсылка() И СоздаватьРесурсы Тогда
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("НаименованиеРесурса",ТекСтрока.Наименование);
	    	МассивСтрок = Форма.СоответствияРесурсов.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 Тогда
				ТекРесурс = МассивСтрок[0].СсылкаВБазе;
			Иначе
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ресурс: %1, %2 - не задано соответствие в таблице'"), ТекСтрока.КодРесурса, ТекСтрока.Наименование));	
				
				// Запись сообщений в журнал регистрации
				СтруктураСообщения 	= Новый Структура;
				СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
				СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
				СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Ресурс: %1, %2 - не задано соответствие в таблице'"), ТекСтрока.КодРесурса, ТекСтрока.Наименование));
				СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
				
				СообщенияДляЖурнала	= Новый СписокЗначений();
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
				ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		//  Создаем новую строку ресурса в ТЧ
		ТекОбъект 						= ТекущаяПозицияЛС.ПолучитьОбъект();
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("СметныйКодРесурса", ?(ЗначениеЗаполнено(ТекРесурс),ТекРесурс.Код,ТекСтрока.КодРесурса));
		ПараметрыОтбора.Вставить("ЕдиницаИзмеренияРесурса", ТекСтрока.ЕдиницаИзмерения);
		ПараметрыОтбора.Вставить("НаименованиеРесурса", ТекСтрока.Наименование);

		НайденныеСтроки = ТекОбъект.РесурсыПозицииЛокальнойСметы.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()=0 Тогда
			НоваяСтрока 					= ТекОбъект.РесурсыПозицииЛокальнойСметы.Добавить();
			НоваяСтрока.Ресурс              = ТекРесурс.Ссылка;
			НоваяСтрока.СметныйКодРесурса	= ?(ЗначениеЗаполнено(НоваяСтрока.Ресурс),ТекРесурс.Код,ТекСтрока.КодРесурса);
			НоваяСтрока.НаименованиеРесурса = ТекСтрока.Наименование;
			НоваяСтрока.ЕдиницаИзмеренияРесурса = ТекСтрока.ЕдиницаИзмерения;
			
			
			Если ТекСтрока.ПризнакТипа = "0" Тогда
				НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих;		
			ИначеЕсли ТекСтрока.ПризнакТипа = "1" Тогда
				НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы;
			ИначеЕсли ТекСтрока.ПризнакТипа = "2" Тогда
				НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы;
			ИначеЕсли ТекСтрока.ПризнакТипа = "3" Тогда
				НоваяСтрока.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов;
			КонецЕсли;	
			Если НЕ ВидРесурса = Неопределено Тогда
				НоваяСтрока.ВидРесурса = ВидРесурса;
			КонецЕсли;
			
			НоваяСтрока.НормаРасхода                    = ТекСтрока.НормаРасхода;
			НоваяСтрока.БазиснаяЦена                    = ТекСтрока.ЦенаЕдиницыБазовая;
			НоваяСтрока.БазиснаяЗарплатаМашинистов	  	= ТекСтрока.ЗПМашинистовБазовая;
			НоваяСтрока.ТекущаяЦена                     = ТекСтрока.ЦенаЕдиницыТекущая;
			Если НоваяСтрока.ТекущаяЦена = 0 Тогда
				НоваяСтрока.ТекущаяЦена                     = ТекСтрока.ЦенаЕдиницыФактическая;
			КонецЕсли;
			НоваяСтрока.ТекущаяЗарплатаМашинистов       = ТекСтрока.ЗПМашинистовТекущая;
			НоваяСтрока.ТипМатериала                  	= Перечисления.СМ_ТипыМатериалов.Учтенный;
		Иначе
			НоваяСтрока 					            = НайденныеСтроки[0];
			НоваяСтрока.НормаРасхода                    = НоваяСтрока.НормаРасхода+ТекСтрока.НормаРасхода;
		КонецЕсли;

		ТекОбъект.Записать();
		
	КонецЕсли;
	Если Не НоваяСтрокаПрефикс = Неопределено Тогда 
		НоваяСтрокаПрефикс.ВидРесурса = ВидРесурса;
	КонецЕсли;
КонецПроцедуры

Процедура ПолучитьСоздатьПоправочныйКоэффициент(ВерсияФормата,НовСтрока,ТекущаяПозицияЛС,ТабКоэффициентов)
	ТекОбъект = ТекущаяПозицияЛС.ПолучитьОбъект();
	
	Если Не ТабКоэффициентов = Неопределено Тогда
		МассивКоэффициентов = ТабКоэффициентов.НайтиСтроки(Новый Структура("ДляВсех",Истина));
		Для Каждого ТекСтрока Из МассивКоэффициентов Цикл
			ПолучитьСоздатьПоправочныйКоэффициентПоВсем(ВерсияФормата,ТекСтрока,ТекущаяПозицияЛС,ТекОбъект);
		КонецЦикла;	
	КонецЕсли;

	Если Не НовСтрока = Неопределено Тогда
		ПолучитьСоздатьПоправочныйКоэффициентПоВсем(ВерсияФормата,НовСтрока,ТекущаяПозицияЛС,ТекОбъект);
	КонецЕсли;
	

	// перемножаем.
	Если ТекОбъект.ПоправкиПозиции.количество() > 0 Тогда
		ТаблицаСтрок = ТекОбъект.ПоправкиПозиции.Выгрузить(,"Применить,УсловияПрименения,Обоснование,ВариантРасчета,Справка,ТипПоправки,ДобавПЗ,ДобавОЗ,ДобавЭМ,ДобавЗМ,ДобавСМ,ДобавТР,ДобавТ");
		ТаблицаСтрок.Свернуть("Применить,УсловияПрименения,Обоснование,ВариантРасчета,Справка,ТипПоправки","ДобавПЗ,ДобавОЗ,ДобавЭМ,ДобавЗМ,ДобавСМ,ДобавТР,ДобавТ");
		
		Итоговая = ТекОбъект.ПоправкиПозиции.Выгрузить().СкопироватьКолонки();
		
		Для Каждого Поправка Из ТаблицаСтрок Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("Применить",Поправка.Применить);
			Отбор.Вставить("УсловияПрименения",Поправка.УсловияПрименения);
			Отбор.Вставить("Обоснование",Поправка.Обоснование);
			Отбор.Вставить("ВариантРасчета",Поправка.ВариантРасчета);
			Отбор.Вставить("Справка",Поправка.Справка);
			Отбор.Вставить("ТипПоправки",Поправка.ТипПоправки);
			МассивПоправок = ТекОбъект.ПоправкиПозиции.НайтиСтроки(Отбор);
			
			НовСтр = Итоговая.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Поправка);
			
			КоэффПЗ = 0 ; 
			КоэффОЗ = 0 ; 
			КоэффЭМ = 0 ;
			КоэффЗМ = 0 ; 
			КоэффСМ = 0 ; 
			КоэффТР = 0 ; 
			КоэффТМ = 0 ;
	
			Для каждого Поп Из МассивПоправок Цикл
				КоэффПЗ = ?(КоэффПЗ=0,Поп.КоэффПЗ, КоэффПЗ * ?(Поп.КоэффПЗ=0,1,Поп.КоэффПЗ)); 
				КоэффОЗ = ?(КоэффОЗ=0,Поп.КоэффОЗ, КоэффОЗ * ?(Поп.КоэффОЗ=0,1,Поп.КоэффОЗ)); 
				КоэффЭМ = ?(КоэффЭМ=0,Поп.КоэффЭМ, КоэффЭМ * ?(Поп.КоэффЭМ=0,1,Поп.КоэффЭМ)); 
				КоэффЗМ = ?(КоэффЗМ=0,Поп.КоэффЗМ, КоэффЗМ * ?(Поп.КоэффЗМ=0,1,Поп.КоэффЗМ)); 
				КоэффСМ = ?(КоэффСМ=0,Поп.КоэффСМ, КоэффСМ * ?(Поп.КоэффСМ=0,1,Поп.КоэффСМ)); 
				КоэффТР = ?(КоэффТР=0,Поп.КоэффТР, КоэффТР * ?(Поп.КоэффТР=0,1,Поп.КоэффТР)); 
				КоэффТМ = ?(КоэффТМ=0,Поп.КоэффТМ, КоэффТМ * ?(Поп.КоэффТМ=0,1,Поп.КоэффТМ)); 
				
			КонецЦикла;
			
			НовСтр.КоэффПЗ = КоэффПЗ ;
			НовСтр.КоэффОЗ = КоэффОЗ ;
			НовСтр.КоэффЭМ = КоэффЭМ ;
			НовСтр.КоэффЗМ = КоэффЗМ ;
			НовСтр.КоэффСМ = КоэффСМ ; 
			НовСтр.КоэффТР = КоэффТР ; 
			НовСтр.КоэффТМ = КоэффТМ ;
			
		КонецЦикла;
		ТекОбъект.ПоправкиПозиции.Загрузить(Итоговая);
	КонецЕсли;
	// перемножаем.
	
	//ТекОбъект.ПоправкиПозиции.Свернуть("Применить,УсловияПрименения,Обоснование,ВариантРасчета,Справка,ТипПоправки","КоэффПЗ,КоэффОЗ,КоэффЭМ,КоэффЗМ,КоэффСМ,КоэффТР,КоэффТМ,ДобавПЗ,ДобавОЗ,ДобавЭМ,ДобавЗМ,ДобавСМ,ДобавТР,ДобавТ");
	ТекОбъект.Записать();
	
КонецПроцедуры

Процедура ПолучитьСоздатьПоправочныйКоэффициентПоВсем(ВерсияФормата,ТекСтрока,ТекущаяПозицияЛС,ТекОбъект)

 	//  Тип поправки 1.0
	//  0 - коэффициент учета инфляции (коэффициент пересчета сметных цен), 
	//  1 - коэффициент зимнего удорожания, 
	//  2 - норматив накладных расходов, 
	//  3 - норматив сметной прибыли, 
	//  4 - коэффициент учета условий работ, 
	//  10 - прочие коэффициенты. 
		
	//  Тип поправки 2.0
	// 0 - коэффициент учета инфляции (коэффициент пересчета сметных цен) - это в ТЧ КоэффициентыПересчета (одна строка!).
	// 1 - коэффициент зимнего удорожания, - в реквизиты позиции. 
	// 2 - норматив накладных расходов в базовых и текущих ценах, 
	// 3 - норматив сметной прибыли в базовых и текущих ценах, 
	// 4 - норматив накладных расходов в базовых ценах, 
	// 5 - норматив сметной прибыли в базовых ценах, 
	// 6 - норматив накладных расходов в текущих ценах, 
	// 7 - норматив сметной прибыли в текущих ценах, 
	// 8 - коэффициент учета условий работ,  - в ТЧ Поправки.
	// 10 - прочие коэффициенты. - в реквизиты позиции, ПоправочныйКоэффициентКНР.
	// Параллельно вычисляя, что это могут быть коэффциенты на Ремонт (К НР) - это отдельный реквизит, на АЭС, на УСН.
		
	//  К чему относится 2.0
	// 	0 - заработная плата основных рабочих, 
	// 	1 - эксплуатация машин и механизмов, 
	// 	2 - стоимость материалов,
	// 	3 - заработная плата механизаторов, 
	// 	4 - трудозатраты основных рабочих, 
	// 	5 - трудозатраты механизаторов, 
	// 	6 - норматив накладных расходов в базовых и текущих ценах,
	// 	7 - норматив сметной прибыли в базовых и текущих ценах,
	// 	10 - прямые затраты,
	// 	20 - норматив накладных расходов в базовых ценах,
	// 	21 - норматив накладных расходов в текущих ценах,
	// 	22 - норматив сметной прибыли в базовых ценах,
	// 	23 - норматив сметной прибыли в текущих ценах,
	// 	50 - количество машино-часов используемых машин и механизмов,
	// 	51 - расход материалов. - не обрабатывать, но выводить в протокол!
	
	
	Если ВерсияФормата = 1 Тогда
		
		Если ТекСтрока.ТипПоправки = "4" Тогда
			
			//  Поправки вставляем в одну строку
			Если Не Число(ТекСтрока.ПоправочныйКоэффициент) = 1 Тогда
				НоваяСтрока 			= ТекОбъект.ПоправкиПозиции.Добавить();	
				НоваяСтрока.Применить 	= Истина;
				НоваяСтрока.Обоснование = ТекСтрока.ОснованиеКоэффициента;
				НоваяСтрока.Справка		= ТекСтрока.НаименованиеКоэффициента;
				НоваяСтрока.ТипПоправки	= Перечисления.СМ_ТипыПоправок.ТехчастиСборников;
				
				Если ТекСтрока.КЧемуОтносится = "0" Тогда
					НоваяСтрока.КоэффОЗ	= ТекСтрока.ПоправочныйКоэффициент;
				ИначеЕсли ТекСтрока.КЧемуОтносится = "1" Тогда	
					НоваяСтрока.КоэффЭМ	= ТекСтрока.ПоправочныйКоэффициент;	
				ИначеЕсли ТекСтрока.КЧемуОтносится = "2" Тогда	
					НоваяСтрока.КоэффСМ	= ТекСтрока.ПоправочныйКоэффициент;	
				ИначеЕсли ТекСтрока.КЧемуОтносится = "3" Тогда	
					НоваяСтрока.КоэффЗМ	= ТекСтрока.ПоправочныйКоэффициент;	
				ИначеЕсли ТекСтрока.КЧемуОтносится = "4" Тогда	
					НоваяСтрока.КоэффТР	= ТекСтрока.ПоправочныйКоэффициент;	
				ИначеЕсли ТекСтрока.КЧемуОтносится = "5" Тогда	
					НоваяСтрока.КоэффТМ = ТекСтрока.ПоправочныйКоэффициент;	
				ИначеЕсли ТекСтрока.КЧемуОтносится = "10" Тогда	
					НоваяСтрока.КоэффПЗ = ТекСтрока.ПоправочныйКоэффициент;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТекСтрока.ТипПоправки = "1" Тогда
		Если ТекСтрока.КЧемуОтносится = "0"
			ИЛИ ТекСтрока.КЧемуОтносится = "1"
			ИЛИ ТекСтрока.КЧемуОтносится = "3"
			ИЛИ ТекСтрока.КЧемуОтносится = "4" Тогда
			ТекОбъект.ЗимнееУдорож	= ТекСтрока.ПоправочныйКоэффициент;
			ТекОбъект.ЗимнееУдорожРемонт	= ТекСтрока.ПоправочныйКоэффициент;
		ИначеЕсли ТекСтрока.КЧемуОтносится = "2" Тогда	
			ТекОбъект.ЗимнееУдорожМатериал	= ТекСтрока.ПоправочныйКоэффициент;	
			ТекОбъект.ЗимнееУдорожМатериалРемонт	= ТекСтрока.ПоправочныйКоэффициент;	
		КонецЕсли;	
	КонецЕсли;

	// ***************************
	// Загрузка нормативов НР и СП.
	// Случай КЧемуОтносится = "3" - не обрабатываем пока.
	Если ТекСтрока.КЧемуОтносится = "0" И ТекСтрока.Действие = "0" Тогда  		
		
		ТекКоэффициент = ТекСтрока.ПоправочныйКоэффициент;
			
		// Норматив накладных расходов в базовых ценах.
		Если ТекСтрока.ТипПоправки = "2" Тогда
			ЗаполнитьНормативНРиСП(ТекОбъект,"НакладныеРасходыБазисные",ТекКоэффициент);
			ЗаполнитьНормативНРиСП(ТекОбъект,"НакладныеРасходыТекущие",ТекКоэффициент);
		КонецЕсли;
		
		// Норматив накладных расходов в текущих ценах.
		Если ТекСтрока.ТипПоправки = "3" Тогда
			ЗаполнитьНормативНРиСП(ТекОбъект,"СметнаяПрибыльБазисные",ТекКоэффициент);
			ЗаполнитьНормативНРиСП(ТекОбъект,"СметнаяПрибыльТекущие",ТекКоэффициент);
		КонецЕсли;

		// Норматив накладных расходов в базовых ценах.
		Если ТекСтрока.ТипПоправки = "4" И ВерсияФормата <> 1 Тогда
			ЗаполнитьНормативНРиСП(ТекОбъект,"НакладныеРасходыБазисные",ТекКоэффициент);
		КонецЕсли;
		
		// Норматив сметной прибыли в базовых ценах.
		Если ТекСтрока.ТипПоправки = "5" Тогда
			ЗаполнитьНормативНРиСП(ТекОбъект,"СметнаяПрибыльБазисные",ТекКоэффициент);
		КонецЕсли;

		// Норматив накладных расходов в текущих ценах.
		Если ТекСтрока.ТипПоправки = "6" Тогда
			ЗаполнитьНормативНРиСП(ТекОбъект,"НакладныеРасходыТекущие",ТекКоэффициент);
		КонецЕсли;
		
		// Норматив сметной прибыли в текущих ценах.
		Если ТекСтрока.ТипПоправки = "7" Тогда
			ЗаполнитьНормативНРиСП(ТекОбъект,"СметнаяПрибыльТекущие",ТекКоэффициент);
		КонецЕсли;

		Если ТекОбъект.ТипНормативныхСборников = Перечисления.СМ_ТипыНормативныхСборников.СметныеЦеныНаМатериалы Тогда
			ЗаполнитьНормативНРиСП(ТекОбъект,"НРТСНБазисРемонт",ТекКоэффициент);
			ЗаполнитьНормативНРиСП(ТекОбъект,"НРТСНТекущиеРемонт",ТекКоэффициент);
			ЗаполнитьНормативНРиСП(ТекОбъект,"СПТСНБазисРемонт",ТекКоэффициент);
			ЗаполнитьНормативНРиСП(ТекОбъект,"СПТСНТекущиеРемонт",ТекКоэффициент);
		КонецЕсли;
		
	КонецЕсли;
	
	СообщенияДляЖурнала	= Новый СписокЗначений();
	
	// *************************************
	// Поправки позиции и начисления позиции.
	// Все грузим в ТЧ "Поправки позиции".
	Если ТекСтрока.ТипПоправки = "8" Тогда
		
		// Поправки вставляем в одну строку
		Если Не Число(ТекСтрока.ПоправочныйКоэффициент) = 1 Тогда
			НоваяСтрока 			= ТекОбъект.ПоправкиПозиции.Добавить();	
			НоваяСтрока.Применить 	= Истина;
			НоваяСтрока.Обоснование = ТекСтрока.ОснованиеКоэффициента;
			НоваяСтрока.Справка		= ТекСтрока.НаименованиеКоэффициента;
			НоваяСтрока.ТипПоправки	= Перечисления.СМ_ТипыПоправок.ТехчастиСборников;
			
			Если ТекСтрока.КЧемуОтносится = "0" Тогда
				НоваяСтрока.КоэффОЗ	= ТекСтрока.ПоправочныйКоэффициент;
			ИначеЕсли ТекСтрока.КЧемуОтносится = "1" Тогда	
				НоваяСтрока.КоэффЭМ	= ТекСтрока.ПоправочныйКоэффициент;	
			ИначеЕсли ТекСтрока.КЧемуОтносится = "2" Тогда	
				НоваяСтрока.КоэффСМ	= ТекСтрока.ПоправочныйКоэффициент;	
			ИначеЕсли ТекСтрока.КЧемуОтносится = "3" Тогда	
				НоваяСтрока.КоэффЗМ	= ТекСтрока.ПоправочныйКоэффициент;	
			ИначеЕсли ТекСтрока.КЧемуОтносится = "4" Тогда	
				НоваяСтрока.КоэффТР	= ТекСтрока.ПоправочныйКоэффициент;	
			ИначеЕсли ТекСтрока.КЧемуОтносится = "5" Тогда	
				НоваяСтрока.КоэффТМ = ТекСтрока.ПоправочныйКоэффициент;	
			ИначеЕсли ТекСтрока.КЧемуОтносится = "10" Тогда	
				НоваяСтрока.КоэффПЗ = ТекСтрока.ПоправочныйКоэффициент;
			ИначеЕсли ТекСтрока.КЧемуОтносится = "6" Тогда
				ТекОбъект.ПоправочныйКоэффициентКНРБазисный	= ТекСтрока.ПоправочныйКоэффициент;
				ТекОбъект.ПоправочныйКоэффициентКНРТекущий  = ТекСтрока.ПоправочныйКоэффициент;
			ИначеЕсли ТекСтрока.КЧемуОтносится = "7" Тогда
				ТекОбъект.ПоправочныйКоэффициентКСПБазисный = ТекСтрока.ПоправочныйКоэффициент; 
				ТекОбъект.ПоправочныйКоэффициентКСПТекущий  = ТекСтрока.ПоправочныйКоэффициент;
			ИначеЕсли ТекСтрока.КЧемуОтносится = "20"
				ИЛИ ТекСтрока.КЧемуОтносится = "21" ИЛИ ТекСтрока.КЧемуОтносится = "23"
				ИЛИ ТекСтрока.КЧемуОтносится = "50" ИЛИ ТекСтрока.КЧемуОтносится = "51" Тогда	
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Поправка: %1, не попала в документ'"), ТекСтрока.НаименованиеКоэффициента));	
				СтруктураСообщения 	= Новый Структура;
				СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
				СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
				СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Поправка: %1, не попала в документ'"), ТекСтрока.НаименованиеКоэффициента));
				СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
				СообщенияДляЖурнала.Добавить(СтруктураСообщения);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	//  **************************************************
	//  Числовые коэффициенты пересчета
	
	Если ТекСтрока.ТипПоправки = "0" И Число(СокрЛП(ТекСтрока.КЧемуОтносится)) < 20 Тогда
		
		Если ТекОбъект.КоэффициентыПересчета.Количество() = 0 Тогда
			СтрокаКП 	= ТекОбъект.КоэффициентыПересчета.Добавить();
			ТекКоэффОЗ  = 0;
			ТекКоэффЗМ  = 0;
 		Иначе
			СтрокаКП = ТекОбъект.КоэффициентыПересчета[0];	
		КонецЕсли;
				
		Если ТекСтрока.КЧемуОтносится = "0" Тогда
			СтрокаКП.КоэффОснЗарплаты = ТекСтрока.ПоправочныйКоэффициент;
			ТекКоэффОЗ = ТекСтрока.ПоправочныйКоэффициент;
		ИначеЕсли ТекСтрока.КЧемуОтносится = "1" Тогда	
			СтрокаКП.КоэффСтоимЭксплМашин = ТекСтрока.ПоправочныйКоэффициент;	
		ИначеЕсли ТекСтрока.КЧемуОтносится = "2" Тогда	
			СтрокаКП.КоэффСтоимМатериалов = ТекСтрока.ПоправочныйКоэффициент;	
		ИначеЕсли ТекСтрока.КЧемуОтносится = "3" Тогда	
			
			// Кзм заполняется в зависимости от ВариантаПересчетаЭММ. 
			// Сравниваем значения строк 25#0#3#0 и 25#0#0#0.
			// Если совпадают, то вариант пересчета = разные, иначе одинаковые.
			ТекКоэффЗМ = ТекСтрока.ПоправочныйКоэффициент;
			Если ТекКоэффОЗ = ТекКоэффЗМ Тогда
				СтрокаКП.ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Одинаковые;
			Иначе	
				СтрокаКП.ВариантПересчетаЭММ = Перечисления.СМ_ВариантыПересчетаЭММ.Разные;
 			КонецЕсли;
			СтрокаКП.КоэффСтоимЗарплатеМашин = ТекСтрока.ПоправочныйКоэффициент;
		ИначеЕсли ТекСтрока.КЧемуОтносится = "10" Тогда	
			СтрокаКП.КоэффОборуд = ТекСтрока.ПоправочныйКоэффициент;	
		Иначе	
			// ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Коэфф. пересчета: %1, не попала в документ'"), ТекСтрока.НаименованиеКоэффициента));			
			СтруктураСообщения 	= Новый Структура;
			СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
			СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Информация'"));
			СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Коэфф. пересчета: %1, не попал в документ'"), ТекСтрока.НаименованиеКоэффициента));
			СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
			СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		КонецЕсли;	
		
	КонецЕсли;	
	
	// Запись сообщений в журнал регистрации
	ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	
	//  **************************************************
	//  Коэффициентов к НР и СП в реквизитах позиции ЛС.

	//  1. В наименовании коэффициента идет поиск по ключевым словам "ремонт", "УСН", "АЭС".
	//  2. Значения коэффициентов сравниваются со значениями коэффициентов из общих настроек.
	//  3. Если в наименовании коэффициента не найдено ключевое слово и значение коэффициента
	//  	  не совпадает со значениями из общих настроек, то коэффицент сохраняется как поправочный.
	//  4. Если значение поправочного коэффициента уже заполнено, то они перемножаются.
	
	//  Коэффициент 6 - сравнивается с базисными и текущими коэффициентами к НР.
	//  Коэффициент 7 - сравнивается с базисными и текущими коэффициентами к СП.

	Если ТекСтрока.ТипПоправки = "10" Тогда
		
		ПозицияАЭС = Найти(ТекСтрока.НаименованиеКоэффициента,"АЭС"); 
		ПозицияУСН = Найти(ТекСтрока.НаименованиеКоэффициента,"УСН"); 
		ПозицияРем = Найти(ТекСтрока.НаименованиеКоэффициента,"ремонт"); 
		
		КоэффициентНРбазисныйРемонт = Константы.СМ_КоэффициентНРбазисныйРемонт.Получить();
		КоэффициентНРбазисныйАЭС	= Константы.СМ_КоэффициентНРбазисныйАЭС.Получить();
		КоэффициентНРбазисныйУСН	= Константы.СМ_КоэффициентНРбазисныйУСН.Получить();
		
		КоэффициентНРтекущийРемонт	= Константы.СМ_КоэффициентНРтекущийРемонт.Получить();
		КоэффициентНРтекущийАЭС		= Константы.СМ_КоэффициентНРтекущийАЭС.Получить();
		КоэффициентНРтекущийУСН		= Константы.СМ_КоэффициентНРтекущийУСН.Получить();
		
		КоэффициентСПбазисныйРемонт	= Константы.СМ_КоэффициентСПбазисныйРемонт.Получить();
		КоэффициентСПбазисныйАЭС	= Константы.СМ_КоэффициентСПбазисныйАЭС.Получить();
		КоэффициентСПбазисныйУСН	= Константы.СМ_КоэффициентСПбазисныйУСН.Получить();
		
		КоэффициентСПтекущийРемонт	= Константы.СМ_КоэффициентСПтекущийРемонт.Получить();
		КоэффициентСПтекущийАЭС		= Константы.СМ_КоэффициентСПтекущийАЭС.Получить();
		КоэффициентСПтекущийУСН		= Константы.СМ_КоэффициентСПтекущийУСН.Получить();
		
		Если ТекСтрока.КЧемуОтносится = "20" Тогда
			
			Если ПозицияАЭС > 0 ИЛИ ТекСтрока.ПоправочныйКоэффициент = КоэффициентНРбазисныйАЭС Тогда
				ТекОбъект.КоэффициентКНРАЭСБазисный = ТекСтрока.ПоправочныйКоэффициент;		
			ИначеЕсли ПозицияУСН > 0 ИЛИ ТекСтрока.ПоправочныйКоэффициент = КоэффициентНРбазисныйУСН Тогда 
				ТекОбъект.КоэффициентКНРУСНБазисный = ТекСтрока.ПоправочныйКоэффициент;	
			ИначеЕсли ПозицияРем > 0 ИЛИ ТекСтрока.ПоправочныйКоэффициент = КоэффициентНРбазисныйРемонт Тогда
				ТекОбъект.КоэффициентКНРНаРемонтБазисный = ТекСтрока.ПоправочныйКоэффициент;	
			Иначе
				//  Если коэффициент заполнен, то произведение коэффициентов
				Если ЗначениеЗаполнено(ТекОбъект.ПоправочныйКоэффициентКНРБазисный) Тогда
					ТекОбъект.ПоправочныйКоэффициентКНРБазисный = ТекОбъект.ПоправочныйКоэффициентКНРБазисный * ТекСтрока.ПоправочныйКоэффициент;	 	
				Иначе
					ТекОбъект.ПоправочныйКоэффициентКНРБазисный = ТекСтрока.ПоправочныйКоэффициент;	
				КонецЕсли;
			КонецЕсли;	
				
		ИначеЕсли ТекСтрока.КЧемуОтносится = "21" Тогда
			
			Если ПозицияАЭС > 0 ИЛИ ТекСтрока.ПоправочныйКоэффициент = КоэффициентНРтекущийАЭС Тогда
				ТекОбъект.КоэффициентКНРАЭСТекущий = ТекСтрока.ПоправочныйКоэффициент;		
			ИначеЕсли ПозицияУСН > 0 ИЛИ ТекСтрока.ПоправочныйКоэффициент = КоэффициентНРтекущийУСН	Тогда 
				ТекОбъект.КоэффициентКНРУСНТекущий = ТекСтрока.ПоправочныйКоэффициент;	
			ИначеЕсли ПозицияРем > 0 ИЛИ ТекСтрока.ПоправочныйКоэффициент = КоэффициентНРтекущийРемонт Тогда
