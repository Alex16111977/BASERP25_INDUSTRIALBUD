
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ДокСсылка;
Перем СметнаяПрограмма;
Перем ФорматВыгрузки;
Перем ТекущаяСмета;
Перем ТекущийРаздел;
Перем ТекущаяПозицияЛС;
Перем ТекКонтрагент;
Перем Форма;
Перем ПрефиксыПрограммы;

#КонецОбласти

#Область ПроцедурыИФункцииЭкспорта

// Основная процедура выгрузки документов в файл в формате АРПС. 
// Вызывается из модуля формы обработки по кнопке "Выгрузить".
// 
// Параметры:
//   ФорматВыгрузки		- Формат выгрузки указанный на форме.
//   ДокументВыгрузки	- Строка таблицы смет.
// 
Процедура ВыгрузитьВФайлАРПС(ФорматВыгрузки, ДокументВыгрузки,АдресФайлаВоВременномХранилище,ИмяВременногоФайла) Экспорт 
	
	
	СметнаяПрограмма = ?(СметнаяПрограммаВыбор.Пустая(),Справочники.СМ_СметныеПрограммы.Смета30,СметнаяПрограммаВыбор);
		
	ФайлВыгрузки = ДокументВыгрузки.Файл;
	
	АдресФайлаВоВременномХранилище = Новый Соответствие;
	
	ТекстВыгрузки 		= Новый ТекстовыйДокумент();
	
	ИдентификацияСтандарта(ТекстВыгрузки, ФорматВыгрузки);
	ИдентификацияДокумента(ТекстВыгрузки, ДокументВыгрузки.Смета, ФорматВыгрузки);// 3
	
	ДеревоРасценок = Новый ДеревоЗначений;
	ДеревоРасценок.Колонки.Добавить("НомерПозиции");
	ДеревоРасценок.Колонки.Добавить("Позиция");
	ДеревоРасценок.Колонки.Добавить("ЕдИзм");
	ДеревоРасценок.Колонки.Добавить("Объем");
	ДеревоРасценок.Колонки.Добавить("ТипПозиции");
	ДеревоРасценок.Колонки.Добавить("Ид");
	ДеревоРасценок.Колонки.Добавить("ИдРодителя");
	ДеревоРасценок.Колонки.Добавить("Расчет");	
	
	Если ДокументВыгрузки.Смета.Метаданные().Имя  = "АктВыполненныхРабот" Тогда
		ДеревоРасценок.Колонки.Добавить("НомерПоСмете");	
	КонецЕсли; 
			
	ПараметрыДокумента 	= Новый Структура("ВыводитьЗаголовокСметы,ЗаполнитьАктСметой,ВыводитьРесурсы,Документ",истина, ложь, ложь, истина);
	ДокСсылка 			= СоберемТаблицыДокумента(ДокументВыгрузки.Смета);
	
	ДокЗаполнитьДеревоДокумента(ДокументВыгрузки.Смета, ДеревоРасценок, ПодготовитьТаблицуРеквизитов(ДокументВыгрузки.Смета, ДеревоРасценок), ПараметрыДокумента, ДокСсылка);
	ОбходСтрокДереваДокументов(ТекстВыгрузки,ДокументВыгрузки.Смета,ДеревоРасценок.Строки, ДокСсылка, ФорматВыгрузки); // 10  // 20 // 30
	ИдентификацияЛимитированныхЗатрат(ТекстВыгрузки,ДокументВыгрузки.Смета); //  50

	Попытка
		Если ФорматВыгрузки = 1 Тогда
			ТекстВыгрузки.Записать(ИмяВременногоФайла,"cp866");
		Иначе
			ТекстВыгрузки.Записать(ИмяВременногоФайла,КодировкаТекста.ANSI);
		КонецЕсли;
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		АдресФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
		АдресФайлаВоВременномХранилище.Вставить(ФайлВыгрузки,АдресФайла);

	Исключение
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось записать в файл: %1'"), ФайлВыгрузки));
		
		// Запись сообщений в журнал регистрации
		СтруктураСообщения 	= Новый Структура;
		СтруктураСообщения.Вставить("ИмяСобытия",НСтр("ru='Обмен данными в формате АРПС'"));
		СтруктураСообщения.Вставить("ПредставлениеУровня",НСтр("ru='Ошибка'"));
		СтруктураСообщения.Вставить("Комментарий",СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось записать в файл: %1'"), ФайлВыгрузки));
		СтруктураСообщения.Вставить("ДатаСобытия",ТекущаяДатаСеанса());
		
		СообщенияДляЖурнала	= Новый СписокЗначений();
		СообщенияДляЖурнала.Добавить(СтруктураСообщения);
		ЖурналРегистрации.ЗаписатьСобытияВЖурналРегистрации(СообщенияДляЖурнала);
	КонецПопытки;
		
КонецПроцедуры //  ВыгрузитьВФайлАРПС()

// Процедура формирует строку лимитированных затрат.
//  В АРПС 1.10 - Тип 50 - лимитированные затраты.
//  Используется для идентификации загружаемого документа.
//  Записи содержат информацию о лимитированных затратах, включенных в документ.
// 
//  Параметры:
//   ТекстВыгрузки 	- ТекстовыйДокумент - формируемый текст выгрузки.
//   Документ 		- ДокументСсылка,ДокументОбъект - документ Локальная смета или Акт выполненных работ.
// 
Процедура ИдентификацияЛимитированныхЗатрат(ТекстВыгрузки,Документ)
	
	Если Документ.ЛимитированныеЗатраты.Количество() > 0 Тогда
		ТабИтоговЛЗ = ИтогиПоЛимЗатратам(Документ);
	КонецЕсли;
		
	Для Каждого СтрокаЛЗ Из Документ.ЛимитированныеЗатраты Цикл
		
		Если СтрокаЛЗ.ЛимитированнаяЗатрата.ТипЗначенияЗатраты = Перечисления.СМ_ТипыЗначенийЛимитированныхЗатрат.Процент Тогда
			ТекЗначение = (100 + СтрокаЛЗ.ЗначениеЛимЗатраты)/100;
		Иначе
			ТекЗначение = СтрокаЛЗ.ЗначениеЛимЗатраты; 
		КонецЕсли;
		
		СуммаЗатрат 	= 0;
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("ЛимЗатрата",СтрокаЛЗ.ЛимитированнаяЗатрата);
		МассивИтогов = ТабИтоговЛЗ.НайтиСтроки(СтруктураОтбора);
		Если МассивИтогов.Количество() > 0 Тогда
			СуммаЗатрат = МассивИтогов[0].ТекПрямЗатраты;	
		КонецЕсли;
		Если Не СметнаяПрограммаВыбор.Пустая() Тогда
			ЛимитированнаяЗатрата = ПолучитьЛимЗатратуСметы(СтрокаЛЗ.ЛимитированнаяЗатрата);
		Иначе
			ЛимитированнаяЗатрата = Неопределено;
		КонецЕсли;
		Идентификатор = Новый СписокЗначений();
		Идентификатор.Добавить(50);
		Идентификатор.Добавить(Строка(?(ЛимитированнаяЗатрата = Неопределено,СтрокаЛЗ.ЛимитированнаяЗатрата,ЛимитированнаяЗатрата)));
		Идентификатор.Добавить(ТекЗначение);
		Идентификатор.Добавить(СуммаЗатрат);
		Идентификатор.Добавить(СуммаЗатрат + ИтогиПоСмете(Документ));
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		
	КонецЦикла;
	
КонецПроцедуры //  ИдентификацияЛимитированныхЗатрат()

// Возвращает строку - значения списка значений, разделенные символом #.
// Требование формата АРПС 1.10.
// 
// Параметры:
//   Идентификатор - СписокЗначений - список, преобразуемый в строку с разделителями.
// 
// Возвращаемое значение:
//   Строка - Строка с разделителями.
//  
Функция СформироватьСтрокуСРазделителями(Идентификатор)
	
	СтрокаСРазделителями = "";
	Итератор = 0;
	
	Для Каждого Элемент Из Идентификатор Цикл
		Итератор = Итератор + 1;
		
		Если ТипЗнч(Элемент.Значение)  = Тип("Строка") Тогда
			Элемент.Значение = СтрЗаменить(Элемент.Значение,"#"," ");
			Элемент.Значение = СокрЛП(Элемент.Значение);
		ИначеЕсли ТипЗнч(Элемент.Значение)  = Тип("Число") Тогда
			Элемент.Значение = Формат(Элемент.Значение,"ЧГ=;ЧН=0");
		КонецЕсли;
		
		СтрокаСРазделителями = СтрокаСРазделителями+Элемент.Значение;
		
		Если Итератор < Идентификатор.Количество() Тогда
			СтрокаСРазделителями = СтрокаСРазделителями+"#";
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрокаСРазделителями;
	
КонецФункции //  СформироватьСтрокуСРазделителями()

Функция ИтогиПоСмете(Документ)
	
	Если Документ.ЛимитированныеЗатраты.Количество() > 0 Тогда
		ТекРег 	= "СМ_ИтогиПоГлавам";
		ТекИтог = Справочники.СМ_ИтогиПоГлавам.НайтиПоРеквизиту("Идентификатор","ИП4");
	Иначе
		ТекРег 	= "СМ_ИтогиПоСмете";
		ТекИтог = Справочники.СМ_ИтогиПоСмете.ВсегоПоСмете;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТекРегистр.Смета,
	|	ТекРегистр.Итог,
	|	ТекРегистр.ПрямЗатраты,
	|	ТекРегистр.ОснЗарплата,
	|	ТекРегистр.ЭксплМашин,
	|	ТекРегистр.ЗарплМашин,
	|	ТекРегистр.СтоимМатер,
	|	ТекРегистр.Оборуд,
	|	ТекРегистр.ВозвратМатер,
	|	ТекРегистр.ЗатратыТрудаРабочих,
	|	ТекРегистр.ЗатратыТрудаМашин,
	|	ТекРегистр.ТекПрямЗатраты,
	|	ТекРегистр.ТекОснЗарплата,
	|	ТекРегистр.ТекЭксплМашин,
	|	ТекРегистр.ТекЗарплМашин,
	|	ТекРегистр.ТекСтоимМатер,
	|	ТекРегистр.ТекОборуд,
	|	ТекРегистр.ТекВозвратМатер
	|ИЗ
	|	РегистрСведений."+ТекРег+" КАК ТекРегистр
	|ГДЕ
	|	ТекРегистр.Смета = &Смета
	|	И ТекРегистр.Итог = &Итог";
					
	Запрос.УстановитьПараметр("Смета",Документ.Ссылка);
	Запрос.УстановитьПараметр("Итог",ТекИтог);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	Если ТабРезультат.Количество() > 0 Тогда
		Возврат ТабРезультат[0].ТекПрямЗатраты;
	Иначе
		Возврат 0;	
	КонецЕсли;
		
КонецФункции	

Функция ИтогиПоЛимЗатратам(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СМ_ИтогиПоГлавам.Смета,
	               |	СМ_ИтогиПоГлавам.Итог КАК ЛимЗатрата,
	               |	СУММА(СМ_ИтогиПоГлавам.ТекПрямЗатраты) КАК ТекПрямЗатраты
	               |ИЗ
	               |	РегистрСведений.СМ_ИтогиПоГлавам КАК СМ_ИтогиПоГлавам
	               |ГДЕ
	               |	СМ_ИтогиПоГлавам.Смета = &Смета
	               |	И СМ_ИтогиПоГлавам.Итог.Ссылка ССЫЛКА Справочник.СМ_ЛимитированныеЗатраты
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СМ_ИтогиПоГлавам.Смета,
	               |	СМ_ИтогиПоГлавам.Итог";
	
	
	Запрос.УстановитьПараметр("Смета",Документ.Ссылка);
	
	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТабРезультат;

КонецФункции

Функция ПолучитьЛимЗатратуСметы(ЛимЗатрата)
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СМ_АРПС_СоответствияЛимЗатрат.НаименованиеЛимзатратыАРПС
	               |ИЗ
	               |	РегистрСведений.СМ_АРПС_СоответствияЛимЗатрат КАК СМ_АРПС_СоответствияЛимЗатрат
	               |ГДЕ
	               |	СМ_АРПС_СоответствияЛимЗатрат.СметнаяПрограмма = &СметнаяПрограмма
	               |	И СМ_АРПС_СоответствияЛимЗатрат.ЛимЗатрата = &ЛимЗатрата";
	Запрос.УстановитьПараметр("ЛимЗатрата",ЛимЗатрата);
	Запрос.УстановитьПараметр("СметнаяПрограмма",СметнаяПрограмма);
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат  Выборка.НаименованиеЛимзатратыАРПС;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// Процедура формирует строку информации о разделах, позициях и поправках.
// В АРПС 1.10 - Тип 10 - Заголовок раздела документа, Тип 20 - Позиция документа,
// Тип 25 - поправочные коэффициенты.
// Записи раздела используются для задания структуры документа. 
// Записи позиций задают состав работ документа.
// Записи поправок задают состав и значения поправочных коэффициентов, 
// примененных к ближайшей предшествующей позиции документа.
// 
// Параметры:
//   ТекстВыгрузки 			 - ТекстовыйДокумент - формируемый текст выгрузки.
//   Документ 				 - ДокументСсылка,ДокументОбъект - документ Локальная смета или Акт выполненных работ.
//   СтрокиДерева 			 - КоллекцияСтрокДереваЗначений - строки дерева документов,
//   						   по которым будет формироваться рекурсивно записи о структуре.
//   ТЗРазделыЛС  			 - ТаблицаЗначений - таблица разделов локальной сметы.
//   ТЗПозицииЛС  			 - ТаблицаЗначений - таблица позиций локальной сметы.
//   ТЗВидСтоимостиНаЕдиницу - ТаблицаЗначений - таблица информации о стоимостных показателях
//   						   позиций локальной сметы.
//   ТаблицаПоправок 		 - ТаблицаЗначений - таблица поправочных коэффициентов.
//   РазрешеныПоправки 		 - Булево - определяет формирование поправочных коэффициентов.
// 
Процедура ОбходСтрокДереваДокументов(ТекстВыгрузки,ДокументСсылка,СтрокиДерева, ДокСсылка, ФорматВыгрузки)
	
	МетодРасчета = ДокументСсылка.МетодРасчета;
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		
		//  Выгрузка раздела
		Если СтрокаДерева.ТипПозиции = "Раздел" И СтрокаДерева.Расчет Тогда
			
			НомерРаздела 		= СтрокаДерева.НомерПозиции;
			НаименованиеРаздела = СтрокаДерева.Позиция.НаименованиеДляПечати;
			ТекущийРаздел		= СтрокаДерева.Позиция; 
			ТекУровень 			= СтрокаДерева.Уровень();
					
			Идентификатор = Новый СписокЗначений();
			Идентификатор.Добавить(10);
			Идентификатор.Добавить(ТекУровень);
			Идентификатор.Добавить(НомерРаздела);
			Идентификатор.Добавить(НаименованиеРаздела);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
						
			мСтрокиРасценок = Новый ТаблицаЗначений();
			Если НЕ СтрокаДерева.Строки.Количество() = 0 Тогда
				мСтрокиРасценок = МассивРасценок(СтрокаДерева.Строки[0].ИДРодителя);
			Иначе
				мСтрокиРасценок.Очистить();
			КонецЕсли;	
			
			Для Каждого СтрокаРасценки Из мСтрокиРасценок Цикл
				
				КодПозиции				= СтрокаРасценки.Шифр;						// строкаРасценки.Позиция.Ид;
				НомерСтрокиВДокументе	= СтрокаРасценки.НомерВПределахСметы;
				ЕдИзм					= Строка(СтрокаРасценки.ЕдИзм);
				КомментарийРасценки     = СокрЛП(СтрокаРасценки.Комментарий);
				ОбъемРабот        		= СтрокаРасценки.Объем;
				ТекПозицияЛС 			= СтрокаРасценки.Позиция;

				Если ЗначениеЗаполнено(СтрокаРасценки.СобственноеНаименование) Тогда
					НаименованиеПозиции = СтрокаРасценки.СобственноеНаименование; 
				Иначе
					НаименованиеПозиции = СтрокаРасценки.Позиция.ПолноеНаименование;
				КонецЕсли;
			
				//  Вид затрат
				ТекВидРабот	= ТекПозицияЛС.Определитель.ВидРабот;
				Если ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.МонтажныеРаботы Тогда
					ВидЗатрат = 2;
				ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.ОбщестроительныеРаботы Тогда
					ВидЗатрат = 1;	
				ИначеЕсли ТекВидРабот = Перечисления.СМ_ВидыЗатратСмета.Оборудование Тогда
					ВидЗатрат = 3;	
				Иначе
					ВидЗатрат = 4;	
				КонецЕсли;
				
				Идентификатор = Новый Массив;
				Идентификатор.Добавить(20);
				Идентификатор.Добавить(НомерСтрокиВДокументе);
				Идентификатор.Добавить(КодПозиции);
