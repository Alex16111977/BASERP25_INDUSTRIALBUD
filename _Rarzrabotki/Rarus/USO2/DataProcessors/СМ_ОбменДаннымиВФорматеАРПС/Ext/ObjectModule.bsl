	               |	Начисления.Ссылка КАК Позиция,
	               |	Начисления.НомерСтроки КАК НомерПозиции,
	               |	Начисления.ЧисловойПараметр,
	               |	Начисления.Значение,
	               |	Начисления.Формула
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы.НачисленияПозиции КАК Начисления
	               |ГДЕ
	               |	Начисления.Ссылка.ИДСметы = &ИДРодителя
	               |;
	               |
	               |// // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // // 
	               |ВЫБРАТЬ
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.Ссылка КАК Позиция,
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.НомерСтроки,
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.ВидРабот,
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОснЗарплаты,
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЭксплМашин,
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.ВариантПересчетаЭММ,
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимЗарплатеМашин,
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффСтоимМатериалов,
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффОборуд,
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.КоэффПолнСтоимРабот
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы.КоэффициентыПересчета КАК ПозицияЛокальнойСметыКоэффициентыПересчета
	               |ГДЕ
	               |	ПозицияЛокальнойСметыКоэффициентыПересчета.Ссылка.ИДСметы = &ИДРодителя";
				   
	Запрос.УстановитьПараметр("ИДРодителя", Документ.Ссылка);
	
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции	

// Процедура формирует строку идентификации документа.
// В АРПС 2.0 - Тип 3 - идентификация документа.
// Используется для идентификации загружаемого документа.
// Запись этого типа обязательно должна быть в файле, причем только одна. 
// Она должна располагаться после идентификации стандарта (тип 1).
// 
// Параметры:
//   ТекстВыгрузки 	- ТекстовыйДокумент - формируемый текст выгрузки.
//   Документ 		- ДокументСсылка,ДокументОбъект - документ Локальная смета или Акт выполненных работ.
// 
Процедура ИдентификацияДокумента(ТекстВыгрузки, Документ, ФорматВыгрузки)
	
	// Определение номера документа.
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_АктВыполненныхРабот") Тогда
		ТекНомер 		= Документ.НомерАкта;	
		ТекНаименование = Документ.ЛокальнаяСмета.Наименование;
		ТекНомерСметы	= Документ.ЛокальнаяСмета.НомерСметы;
	ИначеЕсли ТипЗнч(Документ) = Тип("ДокументСсылка.СМ_ЛокальнаяСмета") Тогда
		ТекНомер 		= Документ.НомерСметы;		
		ТекНаименование = Документ.Наименование;
		ТекНомерСметы	= "";
	КонецЕсли;
	
	ОбщаяСтроимостьРабот = Формат(ИтогиПоСмете(Документ),"ЧЦ=20; ЧДЦ=2; ЧГ=0"); 

	Если ФорматВыгрузки = 2 Тогда

		// Блок 1 Описание стройки,
		// только для формата 2.0.
		Идентификатор = Новый СписокЗначений();
		Идентификатор.Добавить(1);
		Идентификатор.Добавить(СокрЛП(Документ.Стройка.Наименование));
		Идентификатор.Добавить("");
		Идентификатор.Добавить(СокрЛП(Документ.Стройка.Код));
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		
		// Блок 2 Описание объекта,
		// только для формата 2.0.
		Идентификатор = Новый СписокЗначений();
		Идентификатор.Добавить(2);
		Идентификатор.Добавить("");
		Идентификатор.Добавить("");
		Идентификатор.Добавить("");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		
		// Блок 3 описание документа.
		Идентификатор = Новый Массив;
		Идентификатор.Добавить(3); 										//  0. Код блока / записи.
		Идентификатор.Добавить(СокрЛП(Документ.Договор.Код));       	//  1. Номер договора (текст).
		Идентификатор.Добавить(СокрЛП(Документ.Договор.Наименование));  //  2. Наименование договора (текст). 
		Идентификатор.Добавить(""); 									//  3. Дата договора.
		Идентификатор.Добавить(ТекНомер);                         		//  4. Номер документа (текст).
		Идентификатор.Добавить(СокрЛП(ТекНаименование));  				//  5. Наименование документа (текст).
		Идентификатор.Добавить(СокрЛП(Документ.Заказчик.Наименование)); //  6. Наименование организации-заказчика (текст). 
		Идентификатор.Добавить(""); 									//  7. ИНН заказчика.
		Идентификатор.Добавить(""); 									//  8. ФИО представителя организации-заказчика.
		
		// 9. Наименование организации-подрядчика.
		// Идентификатор.Добавить(СокрЛП(Документ.Подрядчик.Наименование));
		Если ЗначениеЗаполнено(Документ.Подрядчик) Тогда
			Идентификатор.Добавить(СокрЛП(Документ.Подрядчик.Наименование));	
		Иначе
			Идентификатор.Добавить("");
		КонецЕсли;
		
		Идентификатор.Добавить(""); 									//  10.ИНН организации-подрядчика.
		Идентификатор.Добавить(""); 									//  11.ФИО представителя организации-подрядчика.
		Идентификатор.Добавить(""); 									//  12.Наименование организации - субподрядчика.
		Идентификатор.Добавить(""); 									//  13.ИНН организации - субподрядчика.
		Идентификатор.Добавить(""); 									//  14.ФИО представителя организации - субподрядчика.
		Идентификатор.Добавить(СокрЛП(Документ.Автор.Наименование));    //  15.ФИО составителя документа.
		Идентификатор.Добавить(""); 									//  16.ФИО контролера документа.
		Идентификатор.Добавить(ОбщаяСтроимостьРабот); 					//  17.Общая стоимость работ по передаваемому документу. 
		Идентификатор.Добавить(?(Документ.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный, Документ.ДатаТекущихЦен, "")); //  18. В каких ценах составлен документ.
		Идентификатор.Добавить(СокрЛП(Документ.Основание));				//  19. Проектная документация, основание.
		Идентификатор.Добавить(0); 										//  20. Период составления документа. Для сметы - 0, для акта год и месяц.
		Идентификатор.Добавить(ТекНомерСметы);							//  21. Номер сметы. Заполняется для акта.
		Идентификатор.Добавить("");                         			//  22. Идентификационный номер документа. 
		Идентификатор.Добавить(""); 									//  23. Идентификационный номер документа - сметы, заполняется для акта.
		ТекстВыгрузки.ДобавитьСтроку(СтрСоединить(Идентификатор,"#"));
		
		// Блок 5 описание СНБ.
		ИдентификаторСНБ = ИдентификацияСНБ(Документ);
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(ИдентификаторСНБ));
		
	Иначе
		
		// Блок 3 описание документа.
		Идентификатор = Новый Массив;
		Идентификатор.Добавить(3); 										//  0. Код блока / записи.
		Идентификатор.Добавить(СокрЛП(Документ.Договор.Код));       	//  1. Номер договора (текст).
		Идентификатор.Добавить(СокрЛП(Документ.Договор.Наименование));  //  2. Наименование договора (текст).
		Идентификатор.Добавить(""); 									//  3. Дата договора.
		Идентификатор.Добавить(ТекНомер);                         		//  4. Номер документа (текст).
		Идентификатор.Добавить(СокрЛП(ТекНаименование));  				//  5. Наименование документа (текст).
		Идентификатор.Добавить(СокрЛП(Документ.Заказчик.Наименование)); //  6. Наименование организации-заказчика (текст).
		Идентификатор.Добавить(""); 									//  7. ФИО представителя организации-заказчика.
	
		// 8. Наименование организации-подрядчика. 
		// Идентификатор.Добавить(СокрЛП(Документ.Подрядчик.Наименование));
		Если ЗначениеЗаполнено(Документ.Подрядчик) Тогда
			Идентификатор.Добавить(СокрЛП(Документ.Подрядчик.Наименование));	
		Иначе
			Идентификатор.Добавить("");
		КонецЕсли;

		Идентификатор.Добавить(""); 									//  9. ФИО представителя организации-подрядчика.
		Идентификатор.Добавить(""); 									//  10.Наименование организации - субподрядчика.
		Идентификатор.Добавить(""); 									//  11.ФИО представителя организации - субподрядчика.
		Идентификатор.Добавить(СокрЛП(Документ.Автор.Наименование));    //  12.ФИО составителя документа.
		Идентификатор.Добавить(""); 									//  13.ФИО контролера документа.
		Идентификатор.Добавить(ОбщаяСтроимостьРабот); 					//  14.Общая стоимость работ по передаваемому документу. 
		Идентификатор.Добавить(?(Документ.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.Ресурсный, Документ.ДатаТекущихЦен, "")); //  15. В каких ценах составлен документ.
		Идентификатор.Добавить(0); 										//  16. Период составления документа. Для сметы - 0, для акта год и месяц.
		Идентификатор.Добавить(СокрЛП(Документ.Стройка.Код));           //  17. Код стройки (текст). 
		Идентификатор.Добавить(СокрЛП(Документ.Стройка));               //  18. Наименование стройки (текст). 
		Идентификатор.Добавить(СокрЛП(Документ.Основание));				//  19. Проектная документация, основание.
		ИдентификаторСНБ = ИдентификацияСНБ(Документ);
		Идентификатор.Добавить(СокрЛП(ИдентификаторСНБ[6]));            //  20. Обозначение нормативной базы, на основании которой составлен документ (текст). 
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(ИдентификаторСНБ));
		
	КонецЕсли;
		
КонецПроцедуры //  ИдентификацияДокумента()

//  Процедура формирует строку идентификации стандарта.
//  В АРПС 1.10 - Тип 1 - идентификация стандарта.
// 
//  Параметры:
//   ТекстВыгрузки - ТекстовыйДокумент - формируемый текст выгрузки.
// 
Процедура ИдентификацияСтандарта(ТекстВыгрузки, ФорматВыгрузки)
	
	Если ФорматВыгрузки = 1 Тогда
		Идентификатор = Новый СписокЗначений();
		Идентификатор.Добавить(1);
		Идентификатор.Добавить("АРПС 1.10");
		Идентификатор.Добавить("1С:Смета 3");
		Идентификатор.Добавить(Метаданные.Версия);
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	Иначе
		Идентификатор = Новый СписокЗначений();
		Идентификатор.Добавить(0);
		Идентификатор.Добавить(1);
		Идентификатор.Добавить("Формат АРПС 2.0 разработан Некоммерческой Организацией ""Ассоциация разработчиков программного обеспечения для строительства"". Формат является открытым и может использоваться без ограничений.");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		
		Идентификатор = Новый СписокЗначений();
		Идентификатор.Добавить(0);
		Идентификатор.Добавить(2);
		Идентификатор.Добавить("АРПС 2.0");
		Идентификатор.Добавить("1С:Смета 3");
		Идентификатор.Добавить("Версия " + Метаданные.Версия);
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
КонецПроцедуры //  ИдентификацияСтандарта()

Функция ИдентификацияСНБ(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПозицияЛокальнойСметы.Ссылка
	               |ИЗ
	               |	Документ.СМ_ПозицияЛокальнойСметы КАК ПозицияЛокальнойСметы
	               |ГДЕ
	               |	ПозицияЛокальнойСметы.ИДСметы = &ИДСметы";
				   
	Запрос.УстановитьПараметр("ИДСметы", Документ.Ссылка);
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Идентификатор = Новый СписокЗначений();
	Идентификатор.Добавить(5);

	Если Результат.Следующий() Тогда
		
		ИнформацияПоСНБ = Результат;
		
		РБ = ИнформацияПоСНБ.Ссылка.РегиональнаяБаза;
		Если РБ = Справочники.СМ_СметноНормативныеБазы.ПустаяСсылка() Тогда
			Идентификатор.Добавить("");
			Идентификатор.Добавить(?(ЗначениеЗаполнено(Документ.Район), Документ.Район.Код, ""));
			Идентификатор.Добавить("");
			Идентификатор.Добавить("");
			Идентификатор.Добавить("");
			Идентификатор.Добавить("");
		Иначе
			// для федеральных ничего не заполняем
			Если РБ.УровеньБазы = Перечисления.СМ_УровниБазы.Федеральный Тогда
				Идентификатор.Добавить(""); 
			Иначе
				Идентификатор.Добавить(РБ.КодРегиона);
			КонецЕсли;	
			Идентификатор.Добавить(?(ЗначениеЗаполнено(Документ.Район), Документ.Район.Код, ""));
			Идентификатор.Добавить(?(ЗначениеЗаполнено(РБ.ГодВыпуска), РБ.ГодВыпуска, ""));
			
			ТипБазы = 1;
			//  Элементные сметные нормы  
			Если Найти(РБ.Наименование, "ЭСН") > 0 Тогда
				ТипБазы = 0;
			//  Единичные расценки  	
			ИначеЕсли Найти(РБ.Наименование, "ФЕР") > 0 ИЛИ Найти(РБ.Наименование, "ТЕР") > 0 Тогда
				ТипБазы = 1;
			//  Московские территориальные сметные нормы	
			ИначеЕсли Найти(РБ.Наименование, "ТСН") > 0 Тогда
				ТипБазы = 2;	
			КонецЕсли;
				
			Идентификатор.Добавить(ТипБазы);
			Идентификатор.Добавить(?(Найти(РБ.Наименование, "ЭСН") > 0, 0, 1));
			Идентификатор.Добавить(СокрЛП(РБ.Наименование));
		КонецЕсли;
		
	// для федеральных ничего не заполняем
	Иначе
		Идентификатор.Добавить(""); 
		Идентификатор.Добавить("");
		Идентификатор.Добавить("");
		Идентификатор.Добавить("");
		Идентификатор.Добавить("");
		Идентификатор.Добавить("");
	КонецЕсли;	
	
	Возврат Идентификатор;
	
КонецФункции	

// Реверсивная функция заполнения
Процедура ДокДобавитьСтрокиВДеревоРеверс(Документ, Позиция, СтрокаДерева, Дерево, ТабРазделов, ТабПозиции, ТабРесурсы, ТабДопЗатрат, РеквизитыТаблиц,Параметры, ДокСсылка)
	
	ЮК_ИмяДокумента	= Документ.Метаданные().Имя;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("ИДСметы",Позиция);
	МасСтрокПозиций = ТабРазделов.НайтиСтроки(СтруктураОтбора);
	Для Каждого Эл Из масСтрокПозиций Цикл
		
		Если ТипЗнч(Эл.ИДРодителя) = Тип("ДокументСсылка.СМ_РазделЛокальнойСметы") Тогда
			НайденнаяСтрока = СтрокаДерева.Строки.Найти(Эл.ИДРодителя,"Позиция");	
			Если НайденнаяСтрока <> Неопределено Тогда
				НоваяПодСтрока = НайденнаяСтрока.Строки.Добавить();
			Иначе
				НоваяПодСтрока = СтрокаДерева.Строки.Добавить();
			КонецЕсли;
		Иначе
			НоваяПодСтрока = СтрокаДерева.Строки.Добавить();
		КонецЕсли;
		
		Если Параметры = Неопределено  Тогда
			ЗаполнитьРеквизиты(НоваяПодСтрока, эл, РеквизитыТаблиц, Параметры, "Раздел");
		Иначе
			Если Параметры["ВыводитьЗаголовокСметы"] Тогда
				ЗаполнитьРеквизиты(НоваяПодСтрока, эл, РеквизитыТаблиц, Параметры,"Раздел");
			Иначе
				НоваяПодСтрока 						= СтрокаДерева;
				СтрокаДерева.Ид 					= эл.Ид;
				Параметры["ВыводитьЗаголовокСметы"] = истина;
			КонецЕсли; 
		КонецЕсли;
		
		Если Не Параметры = Неопределено Тогда
			Если Параметры.Свойство("ЗаполнитьАктСметой") Тогда
				Если Параметры.ЗаполнитьАктСметой Тогда
					НоваяПодСтрока.НомерПоСмете = эл.НомерПозиции;
				ИначеЕсли ЮК_ИмяДокумента = "СМ_АктВыполненныхРабот" Тогда
					НоваяПодСтрока.НомерПоСмете = эл.НомерПоСмете;			 
				КонецЕсли; 
			КонецЕсли; 
		КонецЕсли; 
		
		//  Добавляем расценки по разделам
		Если ТабПозиции <> неопределено И ТабПозиции.Количество() Тогда
			масСтрокРасценок = ТабПозиции.НайтиСтроки(Новый Структура("ИдРодителя",эл.Ссылка));
			Для каждого элРасценки Из масСтрокРасценок Цикл
				НоваяСтрокаРасценки = НоваяПодСтрока.Строки.Добавить();
				ЗаполнитьРеквизиты(НоваяСтрокаРасценки, элРасценки, РеквизитыТаблиц, Параметры, "Расценка");
				Если Не Параметры = Неопределено Тогда
					Если Параметры.Свойство("ЗаполнитьАктСметой") Тогда
						Если Параметры.ЗаполнитьАктСметой Тогда
							НоваяСтрокаРасценки.НомерПоСмете = элРасценки.НомерПозиции;			 
						ИначеЕсли ЮК_ИмяДокумента="СМ_АктВыполненныхРабот" Тогда
							НоваяСтрокаРасценки.НомерПоСмете = элРасценки.НомерПоСмете;			 
						КонецЕсли; 
					КонецЕсли; 
				КонецЕсли; 
				ДокДобавитьСтрокуРесурсов(НоваяСтрокаРасценки, ТабРесурсы, РеквизитыТаблиц, элРасценки.Позиция,  Параметры) ; 
				ДобавитьСтрокуДопЗатрат(Документ, НоваяСтрокаРасценки,ТабДопЗатрат,РеквизитыТаблиц,Параметры);
			КонецЦикла; 
		КонецЕсли;
		ДобавитьСтрокуДопЗатрат(Документ, НоваяПодСтрока,ТабДопЗатрат,РеквизитыТаблиц,Параметры);
	КонецЦикла; 
			   
КонецПроцедуры

//  Функция возвращает список параметров поправки.
// 
//  Параметры:
//   Код 			- Число - тип строки.
//   Тип 			- Число - тип поправки.
//   КЧемуОтносится 	- Число - к чему относится поправка .
//   Действие 	 	- Число - 
//  				  		0 - умножение,
// 				  		1 - деление,
// 				  		2 - сложение,
// 				  		3 - вычитание.
//   Значение 	 	- Число - значение поправочного коэффициента .
//   Наименование 	- Число - наименование поправочного коэффициента .
//   Обоснование  	- Число - обоснование поправочного коэффициента .
// 
//  Возвращаемое значение:
//   СписокЗначений - список параметров поправки.
// 
Функция СформироватьИдентификаторПоправки(Код,Тип,КЧемуОтносится,Действие,Значение,Наименование,Обоснование)
	
	Идентификатор = Новый СписокЗначений();
	Идентификатор.Добавить(Код);
	Идентификатор.Добавить(Тип);
	Идентификатор.Добавить(КЧемуОтносится);
	Идентификатор.Добавить(Действие);
	Идентификатор.Добавить(Значение);
	Идентификатор.Добавить(Наименование);
	Идентификатор.Добавить(Обоснование);
	
	Возврат Идентификатор;
КонецФункции 

Процедура ДобавитьСтрокуДопЗатрат(Документ, СтрокаДерева,ТабДопЗатрат,РеквизитыТаблиц, Параметры)
	
	ВыводитьДЗ = истина;
	 Если Параметры<> неопределено И Параметры.свойство("ВыводитьДЗ") Тогда
	     ВыводитьДЗ = Параметры["ВыводитьДЗ"];
	 КонецЕсли; ;
	 Если ТабДопЗатрат <> неопределено И ТабДопЗатрат.Количество() И  ВыводитьДЗ  Тогда
		МассивДопЗатрат = ТабДопЗатрат.НайтиСтроки(Новый Структура("ИдРодителя",СтрокаДерева.Ид));
		Для каждого элЗатраты Из МассивДопЗатрат Цикл
			СуммаБазисная = 0;

			Если ТипЗнч(Документ) = Тип("ДокументОбъект.СМ_ЛокальнаяСмета") ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.СМ_АктВыполненныхРабот") Тогда
				НоваяСтрокаЗатраты = СтрокаДерева.Строки.Добавить();
				Если НЕ Параметры.Свойство("Документ") Тогда
					НоваяСтрокаЗатраты.ВсегоНаОбъем = СуммаБазисная;
				КонецЕсли;
			КонецЕсли;
			Если ТипЗнч(Документ) = Тип("ДокументОбъект.СМ_ОбъектнаяСмета") ИЛИ ТипЗнч(Документ) = Тип("ДокументОбъект.СМ_СводнаяСмета") Тогда
				НоваяСтрокаЗатраты = СтрокаДерева.Строки.Добавить();
				НоваяСтрокаЗатраты.Всего = СуммаБазисная;
			КонецЕсли;
			
			Если НЕ НоваяСтрокаЗатраты = Неопределено Тогда
				// Был последний параметр ПланыВидовХарактеристик.Разделы.ДопЗатрата.
				//	Такого в смете 3 нет. Поставил Неопределено.
				ЗаполнитьРеквизиты(НоваяСтрокаЗатраты, элЗатраты, РеквизитыТаблиц, Параметры, Неопределено);
			КонецЕсли;	
			
		КонецЦикла; 
	 КонецЕсли; 

КонецПроцедуры

Процедура ДокДобавитьСтрокуРесурсов(НоваяСтрокаРасценки, ТабРесурсов,РеквизитыТаблиц, ИдРодителя, Параметры)  
	 
	Если ТабРесурсов <> неопределено И ТабРесурсов.Количество() Тогда
		масСтрокРесурсов = ТабРесурсов.НайтиСтроки(Новый Структура("Объект", ИдРодителя));
		Для каждого элРесурса Из масСтрокРесурсов Цикл
			Если (НЕ элРесурса.ТипМатериала  = Перечисления.СМ_ТипыМатериалов.НеУчтенный ИЛИ элРесурса.ТипМатериала  = Перечисления.СМ_ТипыМатериалов.ПоПроекту) Тогда 
				НоваяСтрокаРесурса = НоваяСтрокаРасценки.Строки.Добавить();
				ЗаполнитьРеквизиты(НоваяСтрокаРесурса, элРесурса, РеквизитыТаблиц, Параметры, "Ресурс");
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
КонецПроцедуры

// Заполняет колонки реквизитами дерева
//
// Параметры:
//  НоваяСтрока - СтрокаДереваЗначений - заполняемая строка дерева значений.
//  СтрокаТаблицы - СтрокаТаблицыЗначений - текущая строка таблицы с данными.
//  РеквизитыТаблиц - Массив - имена реквизитов дерева.
//	Параметры - Структура - содержит дополнительные параметры.
//	ТипПозиции - Строка - тип позиции (позиция, ресурс).
Процедура ЗаполнитьРеквизиты(НоваяСтрока, СтрокаТаблицы, РеквизитыТаблиц, Параметры, ТипПозиции) 
	
	Если Параметры <> неопределено И (Параметры.Свойство("ЗаполнитьАктСметой") И Параметры["ЗаполнитьАктСметой"]) Тогда
		
		НоваяСтрока.СметнаяСтоимость 	= СтрокаТаблицы.ВсегоНаОбъем;
		НоваяСтрока.ИдСтрокиЛС      	= СтрокаТаблицы.Ид; 
		НоваяСтрока.НомерПоСмете    	= СтрокаТаблицы.НомерПозиции;			
		НоваяСтрока.КодСтроки 			= Параметры.Документ.ИндексПоследнейСтроки + 1;

		Если ТипПозиции = "Ресурс" Тогда
		   НоваяСтрока.СметныйОбъем = СтрокаТаблицы.Количество;
        Иначе
		   НоваяСтрока.СметныйОбъем = СтрокаТаблицы.Объем;
		КонецЕсли; 
		 
		Для Каждого Реквизит Из Параметры["РеквизитыСметыДляАкта"] Цикл
			НоваяСтрока[Реквизит] =  СтрокаТаблицы[Реквизит];
		КонецЦикла;
		
		Параметры.Документ.ИндексПоследнейСтроки = НоваяСтрока.КодСтроки;
		 
	ИначеЕсли Параметры <> неопределено И (Параметры.Свойство("ЗаполнитьМ29Актом") И Параметры["ЗаполнитьМ29Актом"]) Тогда
		
		НоваяСтрока.СметныйОбъем = СтрокаТаблицы.Объем;
		Для Каждого Реквизит Из Параметры["РеквизитыСметыДляАкта"] Цикл
			НоваяСтрока[Реквизит] = СтрокаТаблицы[Реквизит];
		КонецЦикла;

	Иначе
		
		Для каждого Реквизит Из РеквизитыТаблиц Цикл
			Если ТипПозиции = "Ресурс" Тогда
				Если Параметры.Свойство("ПоляРесурсов") И Параметры["ПоляРесурсов"].Найти(Реквизит) <> Неопределено  Тогда
					Если  Реквизит  = "МатериалыНаОбъем"  И (СтрокаТаблицы.ТипМатериала  = Перечисления.СМ_ТипыМатериалов.НеУчтенный ИЛИ СтрокаТаблицы.ТипМатериала  = Перечисления.СМ_ТипыМатериалов.ПоПроекту ) Тогда
						Если Параметры.РасчетДокументаВБазисныхЦенах Тогда
						    НоваяСтрока[Реквизит] =  СтрокаТаблицы["СтоимостьБазис"];
						Иначе	
						    НоваяСтрока[Реквизит] =  СтрокаТаблицы["Стоимость"];
						КонецЕсли; 
					ИначеЕсли Реквизит  = "Объем" Тогда
						НоваяСтрока[Реквизит] =  СтрокаТаблицы["Количество"];
					ИначеЕсли Реквизит  = "СметныйОбъем" Тогда
						НоваяСтрока[Реквизит] =  СтрокаТаблицы["СметноеКоличество"];
					Иначе
						НоваяСтрока[Реквизит] =  СтрокаТаблицы[Реквизит];
					КонецЕсли;
				КонецЕсли; 
			Иначе
				НоваяСтрока[Реквизит] = СтрокаТаблицы[Реквизит];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
   	Если ТипПозиции = "Раздел" Тогда
		НоваяСтрока.Позиция = СтрокаТаблицы.Ссылка;  
	КонецЕсли;

КонецПроцедуры

Функция НайтиРесурсСметы(КодРесурса,Ресурс)
    Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СМ_АРПС_СоответствияШифров.ШифрАРПС
	               |ИЗ
	               |	РегистрСведений.СМ_АРПС_СоответствияШифров КАК СМ_АРПС_СоответствияШифров
	               |ГДЕ
	               |	СМ_АРПС_СоответствияШифров.СметнаяПрограмма = &СметнаяПрограмма
	               |	И (СМ_АРПС_СоответствияШифров.Ресурс = &Ресурс
	               |			ИЛИ СМ_АРПС_СоответствияШифров.Шифр = &КодРесурса)";
	Запрос.УстановитьПараметр("КодРесурса",КодРесурса);
	Запрос.УстановитьПараметр("Ресурс",Ресурс);
	Запрос.УстановитьПараметр("СметнаяПрограмма",СметнаяПрограмма);
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ШифрАРПС;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

#КонецОбласти

#КонецЕсли
