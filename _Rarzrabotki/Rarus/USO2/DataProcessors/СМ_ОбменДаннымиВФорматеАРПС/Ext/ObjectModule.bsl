//  Процедура формирует строку информации о ресурсе.
//  В АРПС 1.10 - Тип 30 - Ресурс.
//  Записи задают состав и количество ресурсов, необходимых для выполнения 
//  позиций документа. 
// 
//  Параметры:
//   ТекстВыгрузки 	- ТекстовыйДокумент - формируемый текст выгрузки.
//   Документ 		- ДокументСсылка,ДокументОбъект - документ Локальная смета или Акт выполненных работ.
//   Позиция  		- ДокументСсылка.ПозицияЛокальнойСметы - ссылка на позицию локальной сметы. 
// 
Процедура ИдентификацияРесурсов(ТекстВыгрузки, Документ, СтрокаРасценки, ФорматВыгрузки)
	
	мРесурсов = ДокСсылка[2].Выгрузить();
	мРесурсов = мРесурсов.НайтиСтроки(Новый Структура("Ссылка, Расчет", СтрокаРасценки.Позиция, Истина));

	Для Каждого СтрокаРесурса Из мРесурсов Цикл
		
		//  Не выгружать ресурсы с признаком «не учтенный» и «по проекту»
		Если СтрокаРесурса.ТипМатериала = Перечисления.СМ_ТипыМатериалов.НеУчтенный
			ИЛИ СтрокаРесурса.ТипМатериала = Перечисления.СМ_ТипыМатериалов.ПоПроекту Тогда
			 Продолжить;
		КонецЕсли;
		
		ПризнакТипаРесурса = 0;
		Если СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаРабочих Тогда
			ПризнакТипаРесурса = 0;
		ИначеЕсли строкаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.МашиныИМеханизмы Тогда
			ПризнакТипаРесурса = 1;
		ИначеЕсли строкаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.Материалы Тогда
			ПризнакТипаРесурса = 2;
		ИначеЕсли СтрокаРесурса.ВидРесурса = Перечисления.СМ_ВидыРесурсов.ЗатратыТрудаМашинистов Тогда
			ПризнакТипаРесурса = 3;
		КонецЕсли;
		
		Если ПризнакТипаРесурса = 1 Тогда
			БазиснаяЗарплатаМашинистов	= СтрокаРесурса.БазиснаяЗарплатаМашинистов;	
			ТекущаяЗарплатаМашинистов   = СтрокаРесурса.ТекущаяЗарплатаМашинистов;
		Иначе	
			БазиснаяЗарплатаМашинистов	= 0;	
			ТекущаяЗарплатаМашинистов   = 0;
		КонецЕсли;
		Если Не СметнаяПрограммаВыбор.Пустая() Тогда
			КодРесурса = НайтиРесурсСметы(СтрокаРесурса.Позиция.Код,СтрокаРесурса.Позиция);
		Иначе
			КодРесурса = Неопределено;
		КонецЕсли;
		Идентификатор = Новый СписокЗначений();
		Идентификатор.Добавить(30);
		Идентификатор.Добавить(?(КодРесурса = Неопределено,СтрокаРесурса.Позиция.Код,КодРесурса));
		Идентификатор.Добавить(СтрокаРесурса.ЕдИзм);
		Идентификатор.Добавить(СтрокаРесурса.Позиция.ДлинноеНаименование);
		Идентификатор.Добавить(ПризнакТипаРесурса);
		Идентификатор.Добавить(СтрокаРесурса.Количество);
		Идентификатор.Добавить(СтрокаРесурса.БазиснаяЦена); //  6
		Идентификатор.Добавить(0);                          //  7
		Идентификатор.Добавить(0);                          //  8
		
		Если ФорматВыгрузки = 2 Тогда
			Идентификатор.Добавить(СтрокаРесурса.ТекущаяЦена);  //  9
			Идентификатор.Добавить(0);                          //  10
			Идентификатор.Добавить(БазиснаяЗарплатаМашинистов); //  11
			Идентификатор.Добавить(0);                          //  12
			Идентификатор.Добавить(0);                          //  13
			Идентификатор.Добавить(ТекущаяЗарплатаМашинистов);  //  14
			Идентификатор.Добавить(0);                          //  15
		КонецЕсли;
		
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		
	КонецЦикла;
	
КонецПроцедуры //  ИдентификацияРесурсов()

