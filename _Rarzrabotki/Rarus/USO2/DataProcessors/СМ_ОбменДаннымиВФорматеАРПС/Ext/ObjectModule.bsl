	// ******************************
	// Заполнение поправок позиции ЛС
	Поправки = ДокСсылка[4].Выгрузить();
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",СтрокаРасценки.Позиция);
	СтруктураОтбора.Вставить("Применить",Истина);
	
	// Заполнение поправок позиции ЛС
	мПоправки = Поправки.НайтиСтроки(СтруктураОтбора);
	Для Каждого Поправка Из мПоправки Цикл
		
		Если Поправка.КоэффПЗ Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,10,0,Поправка.КоэффПЗ,Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
			
		Если Поправка.КоэффОЗ Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,0,0,Поправка.КоэффОЗ,Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
			
		Если Поправка.КоэффЭМ  Тогда                                                     
			Идентификатор = СформироватьИдентификаторПоправки(25,8,1,0,Поправка.КоэффЭМ,Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
		
		Если Поправка.КоэффЗМ  Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,3,0,Поправка.КоэффЗМ,Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
		
		Если Поправка.КоэффСМ  Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,2,0,Поправка.КоэффСМ,Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
		
		Если Поправка.КоэффТМ Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,5,0,Поправка.КоэффТМ,Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
		
		Если Поправка.КоэффТР  Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,4,0,Поправка.КоэффТР,Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
		
		Если Поправка.ДобавПЗ Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,10,?(Поправка.ДобавПЗ > 0, 2, 3),Поправка.ДобавПЗ ,Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
		
		Если Поправка.ДобавОЗ Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,0,?(Поправка.ДобавОЗ > 0, 2, 3),Поправка.ДобавОЗ, Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
			
		Если Поправка.ДобавЭМ Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,1,?(Поправка.ДобавЭМ > 0, 2, 3),Поправка.ДобавЭМ, Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
			
		Если Поправка.ДобавЗМ  Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,3,?(Поправка.ДобавЗМ > 0, 2, 3),Поправка.ДобавЗМ, Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
			
		Если Поправка.ДобавСМ Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,2,?(Поправка.ДобавСМ > 0, 2, 3),Поправка.ДобавСМ, Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;	
		
		Если Поправка.ДобавТР  Тогда
			Идентификатор = СформироватьИдентификаторПоправки(25,8,4,?(Поправка.ДобавТР > 0, 2, 3),Поправка.ДобавТР, Поправка.УсловияПрименения,Поправка.Основание);
			ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		КонецЕсли;						
			
	КонецЦикла;

	//  *************************************************************
	//  Заполнение начислений позиции ЛС (Числовые параметры позиции)
	ВидРабот = "";

	ТабЧисловыеПараметры = ДокСсылка[5].Выгрузить();
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Позиция",СтрокаРасценки.Позиция);
	
	// Заполнение поправок позиции ЛС
	МассивЧисловыхПарамеров = ТабЧисловыеПараметры.НайтиСтроки(СтруктураОтбора);
	Для Каждого ТекСтрока Из МассивЧисловыхПарамеров Цикл
		
		// Выгружаем только числовые параметры, у которых значение в ТЧ "Начисления" отличается от стандартного значения.
		Если ТекСтрока.Значение = ТекСтрока.ЧисловойПараметр.СтандартноеЗначение Тогда
			Продолжить;
		КонецЕсли;
		
		// 0 - заработная плата основных рабочих. 
		// 1 - эксплуатация машин и механизмов. 
		// 2 - стоимость материалов. 
		// 3 - заработная плата механизаторов.
		// 4 - трудозатраты основных рабочих. 
		// 5 - трудозатраты механизаторов.
		// 10 - прямые затраты.
		
		Для Каждого СтрокаЧП Из ТекСтрока.ЧисловойПараметр.Источник Цикл
			
			ТекЗначение = ТекСтрока.Значение;
			Если ТекСтрока.ЧисловойПараметр.ТипЗначения = Перечисления.СМ_ТипыЗначенийЧисловыхПараметров.Процент Тогда
				ТекЗначение = (100 + ТекСтрока.Значение)/100;
			КонецЕсли;
			
			Если СтрокаЧП.ПрямЗатраты Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25,8,10,0,ТекЗначение,ТекСтрока.ЧисловойПараметр.Наименование,"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;
			
			Если СтрокаЧП.ОснЗарплата Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25,8,0,0,ТекЗначение,ТекСтрока.ЧисловойПараметр.Наименование,"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;
			
			Если СтрокаЧП.ЭксплМашин Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25,8,1,0,ТекЗначение,ТекСтрока.ЧисловойПараметр.Наименование,"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;
	
			Если СтрокаЧП.ЗарплМашинистов Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25,8,3,0,ТекЗначение,ТекСтрока.ЧисловойПараметр.Наименование,"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;
	
			Если СтрокаЧП.СтоимМатериалов Тогда	
				Идентификатор = СформироватьИдентификаторПоправки(25,8,2,0,ТекЗначение,ТекСтрока.ЧисловойПараметр.Наименование,"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;

			Если СтрокаЧП.Оборудование Тогда	
				Идентификатор = СформироватьИдентификаторПоправки(25,8,10,0,ТекЗначение,ТекСтрока.ЧисловойПараметр.Наименование,"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;

			Если СтрокаЧП.ЗатратыТрудаРабочих Тогда	
				Идентификатор = СформироватьИдентификаторПоправки(25,8,4,0,ТекЗначение,ТекСтрока.ЧисловойПараметр.Наименование,"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;

			Если СтрокаЧП.ЗатратыТрудаМашинистов Тогда		
				Идентификатор = СформироватьИдентификаторПоправки(25,8,5,0,ТекЗначение,ТекСтрока.ЧисловойПараметр.Наименование,"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;	
			
		КонецЦикла;

	КонецЦикла;
		
	//  *************************************************************
	//  Заполнение коэффициентов пересчета по позиции ЛС
	Если Документ.МетодРасчета = Перечисления.СМ_МетодыРасчетаЛС.БазисноИндексный Тогда
		
		ТабКоэффициенты = ДокСсылка[6].Выгрузить();
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Позиция",СтрокаРасценки.Позиция);
		МассивСтрокКП = ТабКоэффициенты.НайтиСтроки(СтруктураОтбора);
		
		Для Каждого КоэфПересчета Из МассивСтрокКП Цикл
			
			Если КоэфПересчета.КоэффОснЗарплаты  Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25, 0, 0, 0, КоэфПересчета.КоэффОснЗарплаты, НСтр("ru='Коэффициент пересчета к основной зарплате'"),"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;						
			
			Если КоэфПересчета.КоэффСтоимЭксплМашин  Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25, 0, 1, 0, КоэфПересчета.КоэффСтоимЭксплМашин, НСтр("ru='Коэффициент пересчета к стоимости эклсплуатации машин'"),"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;						
			
			Если КоэфПересчета.КоэффСтоимЗарплатеМашин  Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25, 0, 3, 0, КоэфПересчета.КоэффСтоимЗарплатеМашин, НСтр("ru='Коэффициент пересчета к зарплате машинистов'"),"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;						
			
			Если КоэфПересчета.КоэффСтоимМатериалов Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25, 0, 2, 0, КоэфПересчета.КоэффСтоимМатериалов, НСтр("ru='Коэффициент пересчета к стоимости материалов'"),"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;	
			
			Если КоэфПересчета.КоэффОборуд Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25, 10, 10, 0, КоэфПересчета.КоэффСтоимМатериалов, НСтр("ru='Коэффициент пересчета к стоимости оборудования'"),"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;
			
			Если КоэфПересчета.КоэффПолнСтоимРабот Тогда
				Идентификатор = СформироватьИдентификаторПоправки(25, 10, 10, 0, КоэфПересчета.КоэффСтоимМатериалов, НСтр("ru='Коэффициент пересчета к полной стоимости работ'"),"");
				ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// *************************************************************
	// Выгрузка коэффициентов из реквизитов позиции ЛС
	
	ТекПозиция = СтрокаРасценки.Позиция;
	
	// КоэффициентКНРАЭСБазисный
	// КоэффициентКНРНаРемонтБазисный	
	// КоэффициентКНРУСНБазисный
	// ПоправочныйКоэффициентКНРБазисный	
	// Тип поправки -10, к чему относится - 20, действие - 0 (умножение).

	Если ТекПозиция.КоэффициентКНРАЭСБазисный > 0 И ТекПозиция.КоэффициентКНРАЭСБазисный <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 20, 0, ТекПозиция.КоэффициентКНРАЭСБазисный, НСтр("ru='Коэффициент пересчета к  нормативу накладных расходов АЭС (базисный)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКНРНаРемонтБазисный > 0 И ТекПозиция.КоэффициентКНРНаРемонтБазисный <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 20, 0, ТекПозиция.КоэффициентКНРНаРемонтБазисный, НСтр("ru='Коэффициент пересчета к  нормативу накладных расходов на ремонт (базисный)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;		
	
	Если ТекПозиция.КоэффициентКНРУСНБазисный > 0 И ТекПозиция.КоэффициентКНРУСНБазисный <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 20, 0, ТекПозиция.КоэффициентКНРУСНБазисный, НСтр("ru='Коэффициент пересчета к нормативу накладных расходов УСН (базисный)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;		
	
	Если ТекПозиция.ПоправочныйКоэффициентКНРБазисный > 0 И ТекПозиция.ПоправочныйКоэффициентКНРБазисный <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 20, 0, ТекПозиция.ПоправочныйКоэффициентКНРБазисный, НСтр("ru='Поправочный коэффициент к  нормативу накладных расходов (базисный)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	// ПоправочныйКоэффициентКНРТекущий	
	// КоэффициентКНРАЭСТекущий
	// КоэффициентКНРНаРемонтТекущий
	// КоэффициентКНРУСНТекущий	
	// Тип поправки -10, к чему -21, действие - 0.
	
	Если ТекПозиция.ПоправочныйКоэффициентКНРТекущий > 0 И ТекПозиция.ПоправочныйКоэффициентКНРТекущий <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 21, 0, ТекПозиция.ПоправочныйКоэффициентКНРТекущий, НСтр("ru='Поправочный коэффициент к  нормативу накладных расходов (текущий)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКНРАЭСТекущий > 0 И ТекПозиция.КоэффициентКНРАЭСТекущий <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 21, 0, ТекПозиция.КоэффициентКНРАЭСТекущий, НСтр("ru='Коэффициент пересчета к  нормативу накладных расходов АЭС (текущий)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКНРНаРемонтТекущий > 0 И ТекПозиция.КоэффициентКНРНаРемонтТекущий <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 21, 0, ТекПозиция.КоэффициентКНРНаРемонтТекущий, НСтр("ru='Коэффициент пересчета к  нормативу накладных расходов на ремонт (текущий)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКНРУСНТекущий > 0 И ТекПозиция.КоэффициентКНРУСНТекущий <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 21, 0, ТекПозиция.КоэффициентКНРУСНТекущий, НСтр("ru='Коэффициент пересчета к  нормативу накладных расходов УСН (текущий)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;		
	
	// ПоправочныйКоэффициентКСПБазисный
	// КоэффициентКСПАЭСБазисный
	// КоэффициентКСПНаРемонтБазисный
	// КоэффициентКСПУСНБазисный	
	// Тип-10, к чему - 22, действие - 0.
	
	Если ТекПозиция.ПоправочныйКоэффициентКСПБазисный > 0 И ТекПозиция.ПоправочныйКоэффициентКСПБазисный <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 22, 0, ТекПозиция.ПоправочныйКоэффициентКСПБазисный, НСтр("ru='Поправочный коэффициент к сметной прибыли (базисный)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКСПАЭСБазисный > 0 И ТекПозиция.КоэффициентКСПАЭСБазисный <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 22, 0, ТекПозиция.КоэффициентКСПАЭСБазисный, НСтр("ru='Коэффициент пересчета к сметной прибыли АЭС (базисный)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКСПНаРемонтБазисный > 0 И ТекПозиция.КоэффициентКСПНаРемонтБазисный <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 22, 0, ТекПозиция.КоэффициентКСПНаРемонтБазисный, НСтр("ru='Коэффициент пересчета к сметной прибыли на ремонт (базисный)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКСПУСНБазисный > 0 И ТекПозиция.КоэффициентКСПУСНБазисный <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 22, 0, ТекПозиция.КоэффициентКСПУСНБазисный, НСтр("ru='Коэффициент пересчета к сметной прибыли УСН (базисный)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;		
	
	// ПоправочныйКоэффициентКСПТекущий
	// КоэффициентКСПАЭСТекущий
	// КоэффициентКСПНаРемонтТекущий
	// КоэффициентКСПУСНТекущий
	// Тип -10, к чему -23, действие - 0.

	Если ТекПозиция.ПоправочныйКоэффициентКСПТекущий > 0 И ТекПозиция.ПоправочныйКоэффициентКСПТекущий <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 23, 0, ТекПозиция.ПоправочныйКоэффициентКСПТекущий, НСтр("ru='Поправочный коэффициент пересчета к сметной прибыли (текущий)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКСПАЭСТекущий > 0 И ТекПозиция.КоэффициентКСПАЭСТекущий <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 23, 0, ТекПозиция.КоэффициентКСПАЭСТекущий, НСтр("ru='Коэффициент пересчета к сметной АЭС оборудовани (текущий)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКСПНаРемонтТекущий > 0 И ТекПозиция.КоэффициентКСПНаРемонтТекущий <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 23, 0, ТекПозиция.КоэффициентКСПНаРемонтТекущий, НСтр("ru='Коэффициент пересчета к сметной прибыли на ремонт (текущий)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.КоэффициентКСПУСНТекущий > 0 И ТекПозиция.КоэффициентКСПУСНТекущий <> 1 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 10, 23, 0, ТекПозиция.КоэффициентКСПУСНТекущий, НСтр("ru='Коэффициент пересчета к сметной прибыли УСН (текущий)'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;		
	
	
	//  *************************************************************
	//  Выгрузка нормативов НР И СП.
	
	//  4 - норматив накладных расходов в базовых ценах (реквизит позиции «НакладныеРасходыБазисные»). 
	//  5 - норматив сметной прибыли в базовых ценах (реквизит позиции «СметнаяПрибыльБазисные»). 
	//  6 - норматив накладных расходов в текущих ценах  (реквизит позиции «НакладныеРасходыТекущие»). 
	//  7 - норматив сметной прибыли в текущих ценах (реквизит позиции «СметнаяПрибыльТекущие»).
	
	//  Для каждого типа поправки - к чему относится поправка.
	//  0 - основная зарплата.
	//  3 - зарплата механизаторов.
	//  Для НР 2 записи - к 0 и к 3, для СП - тоже 2 записи - к 0 и к 3
	//  т.к. НР и СП считаются от ФОТ (зарплата рабочих+зарплата машинистов).
	
	Если ТекПозиция.НакладныеРасходыБазисные > 0 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 4, 0, 0,ТекПозиция.НакладныеРасходыБазисные/100, НСтр("ru='Норматив накладных расходов в базовых ценах'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		Идентификатор = СформироватьИдентификаторПоправки(25, 4, 3, 0,ТекПозиция.НакладныеРасходыБазисные/100, НСтр("ru='Норматив накладных расходов в базовых ценах'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.СметнаяПрибыльБазисные > 0 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 5, 0, 0, ТекПозиция.СметнаяПрибыльБазисные/100, НСтр("ru='Норматив сметной прибыли в базовых ценах'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		Идентификатор = СформироватьИдентификаторПоправки(25, 5, 3, 0, ТекПозиция.СметнаяПрибыльБазисные/100, НСтр("ru='Норматив сметной прибыли в базовых ценах'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
	
	Если ТекПозиция.НакладныеРасходыТекущие > 0 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 6, 0, 0, ТекПозиция.НакладныеРасходыТекущие/100, НСтр("ru='Норматив накладных расходов в текущих ценах'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		Идентификатор = СформироватьИдентификаторПоправки(25, 6, 3, 0, ТекПозиция.НакладныеРасходыТекущие/100, НСтр("ru='Норматив накладных расходов в текущих ценах'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;
	
	Если ТекПозиция.СметнаяПрибыльТекущие > 0 Тогда
		Идентификатор = СформироватьИдентификаторПоправки(25, 7, 0, 0, ТекПозиция.СметнаяПрибыльТекущие/100, НСтр("ru='Норматив сметной прибыли в текущих ценах'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
		Идентификатор = СформироватьИдентификаторПоправки(25, 7, 3, 0, ТекПозиция.СметнаяПрибыльТекущие/100, НСтр("ru='Норматив сметной прибыли в текущих ценах'"),"");
		ТекстВыгрузки.ДобавитьСтроку(СформироватьСтрокуСРазделителями(Идентификатор));
	КонецЕсли;	
			
КонецПроцедуры //  ЗаполнитьКоэффициентыВыгрузки(ИспользоватьПоправки,РазрешеныПоправки,Документ,ПараметрыПозиции = неопределено);¶()

