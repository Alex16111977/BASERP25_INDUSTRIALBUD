Функция ПодготовитьТаблицуРеквизитов(ДокументСсылка, Дерево)

	СтруктураРеквизитов  	= Новый Соответствие;
	ТЧ			    	 	= Новый Соответствие;
    мРеквизитов = Новый Массив;
	Для каждого Колонка Из  Дерево.Колонки Цикл
	
		мРеквизитов.Добавить(Колонка.Имя);

	
	КонецЦикла; 

	ТЧ.Вставить("Разделы",мРеквизитов);
    СтруктураРеквизитов.Вставить(ДокументСсылка.Метаданные().Имя,ТЧ);
    Возврат СтруктураРеквизитов;
	
КонецФункции

// Заполняет дерево документов полным фаршем при открытии.
// Выводит необходимые таблицы на форму. 
// Параметры:
//   Документ - ДокументСсылка - ссылка на документ в системе.
//   Дерево - ДеревоЗначений - формируемое ДеревоЗначений.
//   ТаблицаРеквизитов - ТаблицаЗначений - таблица содержащая значения реквизитов документов.
//   Параметры - Струткура - содержит дополнительные параметры.
//   ДокСсылка - ДокументСсылка - ссылка на документ.
Процедура докЗаполнитьДеревоДокумента(Документ, Дерево, ТаблицаРеквизитов, Параметры, ДокСсылка)  
	
	Если ТипЗнч(Документ.Метаданные().Реквизиты.Найти("МетодРасчета")) = Тип("неопределено") Тогда
	   РасчетДокументаВБазисныхЦенах = Документ.МетодРасчета;
	Иначе
	   РасчетДокументаВБазисныхЦенах = ложь;
	КонецЕсли; 
	
	Параметры.Вставить("РасчетДокументаВБазисныхЦенах", РасчетДокументаВБазисныхЦенах);
	
	СтруктураТаблиц = ТаблицаРеквизитов[Документ.Метаданные().Имя];	
	РеквизитыТаблиц = СтруктураТаблиц["Разделы"];
	
	Если Документ.Метаданные().ТабличныеЧасти.Найти("Разделы") <> Неопределено Тогда
		ТабРазделов = Документ["Разделы"];
	Иначе
		ТабРазделов = ДокСсылка[0].Выгрузить();
	КонецЕсли; 
	
	Если Документ.Метаданные().ТабличныеЧасти.Найти("Позиции") <> Неопределено Тогда
		ТабПозиции = Документ["Позиции"];
	Иначе
		ТабПозиции = ДокСсылка[1].Выгрузить();
	КонецЕсли; 
	
	Если Документ.Метаданные().ТабличныеЧасти.Найти("РесурсыПозицийАкта") <> Неопределено И Параметры["ВыводитьРесурсы"] Тогда
		ТабРесурсов = Документ["РесурсыПозцийАкта"];
	Иначе
 		ТабРесурсов = ДокСсылка[2].Выгрузить();
	КонецЕсли;
	
	//  Во 2-й смете была отдельная ТЧ. 
	//  Возможно будет добавлено и в 3-ей. Пока не будем убирать функционал.
	ТабДопЗатрат = Неопределено; 
	// Дерево.Строки.Очистить();
	Если ТабРазделов.Количество() > 0 Тогда
		ДокДобавитьСтрокиВДеревоРеверс(Документ, Документ.Ссылка, Дерево, Дерево, ТабРазделов, ТабПозиции, ТабРесурсов, ТабДопЗатрат, РеквизитыТаблиц, Параметры, ДокСсылка);
	КонецЕсли;
	
	Если РеквизитыТаблиц.Найти("КодСтрокиСортировки") <> Неопределено Тогда
	   Дерево.Строки.Сортировать("КодСтрокиСортировки",истина);
    КонецЕсли;
   
КонецПроцедуры

