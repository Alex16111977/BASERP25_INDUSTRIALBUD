
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КоличествоСтраниц = 1;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сформировать(Команда)
	ТабДок = СформироватьСправку();
	
	ИдентификаторПечатнойФормы = "ПФ_MXL_Справка";
	НазваниеПечатнойФормы = НСтр("ru = 'Справка о выполненных работах (шаблон)'");
	
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("СтандартныеПодсистемы.Печать") Тогда
		ТабДок.Показать(НазваниеПечатнойФормы);
		Возврат;
	КонецЕсли;     
	МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");     
	КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм(ИдентификаторПечатнойФормы);
	ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, ИдентификаторПечатнойФормы);
	ПечатнаяФорма.СинонимМакета = НазваниеПечатнойФормы;
	ПечатнаяФорма.ТабличныйДокумент = ТабДок;
	ПечатнаяФорма.ИмяФайлаПечатнойФормы = НазваниеПечатнойФормы;
	
	ОбластиОбъектов = Новый СписокЗначений;
	МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм, ОбластиОбъектов);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СформироватьСправку()
	
	ОбОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбОбъект.ПолучитьМакет("ПФ_MXL_Справка");
	ТабДок = Новый ТабличныйДокумент;
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьПодписи = Макет.ПолучитьОбласть("Подписи");
	ОбластьПустая = Макет.ПолучитьОбласть("ПустаяОбласть");
	ОбластьПроверка = Макет.ПолучитьОбласть("Проверка");

	ТабДок.Вывести(ОбластьЗаголовок);
	
	МассивПроверки = Новый Массив;
	МассивПроверки.Добавить(ОбластьПроверка);
	
	Для сч = 1 По КоличествоСтраниц Цикл
		
		Если ШапкаНаКаждой Тогда
			ТабДок.Вывести(ОбластьШапка);
		Иначе
			Если сч = 1 Тогда
				ТабДок.Вывести(ОбластьШапка);
			Иначе
				ТабДок.Вывести(ОбластьПустая);
			КонецЕсли;
		КонецЕсли;
		
		Если ПодписьВКонце Тогда
			Если КоличествоСтраниц>1 И Не сч = КоличествоСтраниц Тогда
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		
		Пока ТабДок.ПроверитьВывод(МассивПроверки) Цикл
			ТабДок.Вывести(ОбластьПустая);
		КонецЦикла;
		
		Если Не сч = КоличествоСтраниц Тогда
			ТабДок.Вывести(ОбластьПодписи);
		КонецЕсли;
		
		Если Не сч = КоличествоСтраниц Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
	КонецЦикла;
	
	ТабДок.Вывести(ОбластьПодписи);
	ТабДок.НижнийКолонтитул.Выводить = Истина;
	ТабДок.НижнийКолонтитул.Шрифт = Новый Шрифт(ТабДок.НижнийКолонтитул.Шрифт, , , , Истина);
	ТабДок.НижнийКолонтитул.ТекстВЦентре = НСтр("ru='Стр. [&НомерСтраницы] из [&СтраницВсего]'");
	ТабДок.АвтоМасштаб = Истина;
	Возврат ТабДок;
КонецФункции

#КонецОбласти

