
#Область ОбработчикиСобытий

&НаСервере
Процедура 	ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПериодФормирования.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
   
	ЗаполнитьАналитикаДвиженияПоДоговору(ПериодФормирования.ДатаНачала, ПериодФормирования.ДатаОкончания, ОбъектСтроительства);
	
КонецПроцедуры

&НаКлиенте
Процедура 	ПериодФормированияПриИзменении(Элемент)															
	ЗаполнитьАналитикаДвиженияПоДоговору(ПериодФормирования.ДатаНачала, ПериодФормирования.ДатаОкончания, ОбъектСтроительства);
КонецПроцедуры

&НаКлиенте
Процедура 	ЗаявкиНаРасходованиеДСЗаявкаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)			
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура 	Обновить(Команда)																				
	ЗаполнитьАналитикаДвиженияПоДоговору(ПериодФормирования.ДатаНачала, ПериодФормирования.ДатаОкончания, ОбъектСтроительства);
КонецПроцедуры

&НаКлиенте
Процедура 	ОбъектСтроительстваПриИзменении(Элемент)														
	ЗаполнитьАналитикаДвиженияПоДоговору(ПериодФормирования.ДатаНачала, ПериодФормирования.ДатаОкончания, ОбъектСтроительства);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЗаполненияФормы

&НаСервере
Процедура 	ЗаполнитьАналитикаДвиженияПоДоговору(ДатаНачала, ДатаОкончания, ОбъектСтроительства)			
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               	|	ГрафикДвиженийПоДоговору.Договор КАК Договор,
	               	|	ГрафикДвиженийПоДоговору.Контрагент КАК Контрагент,
	               	|	ГрафикДвиженийПоДоговору.ФинансированиеПланПриход КАК СуммаПлан,
	               	|	0 КАК СуммаФакт
	               	|ПОМЕСТИТЬ ДвиженияПоДоговору
	               	|ИЗ
	               	|	РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору.ОстаткиИОбороты(
	               	|			&ДатаНачала,
	               	|			&ДатаОкончания,
	               	|			Регистратор,
	               	|			,
	               	|			(Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПоставщиком)
	               	|				ИЛИ Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПереработчиком))
	               	|				И ПорядокОплаты В (ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.АвансДоОбеспечения), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.КредитПослеОтгрузки), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.АвансДоПодтверждения), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.КредитПослеПоступления), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание))
	               	|				И ОбъектСтроительства = &ОбъектСтроительства) КАК ГрафикДвиженийПоДоговору
	               	|ГДЕ
	               	|	(ГрафикДвиженийПоДоговору.Регистратор ССЫЛКА Документ.УСОERP_ГрафикДвиженийПоДоговору
	               	|			ИЛИ ГрафикДвиженийПоДоговору.Регистратор ССЫЛКА Документ.УСОERP_ДоговорССубподрядчиком)
	               	|
	               	|ОБЪЕДИНИТЬ ВСЕ
	               	|
	               	|ВЫБРАТЬ
	               	|	ГрафикДвиженийПоДоговору.Договор,
	               	|	ГрафикДвиженийПоДоговору.Контрагент,
	               	|	0,
	               	|	ГрафикДвиженийПоДоговору.ФинансированиеПланРасход
	               	|ИЗ
	               	|	РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору.ОстаткиИОбороты(
	               	|			&ДатаНачала,
	               	|			&ДатаОкончания,
	               	|			Регистратор,
	               	|			,
	               	|			(Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПоставщиком)
	               	|				ИЛИ Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПереработчиком))
	               	|				И ПорядокОплаты В (ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.АвансДоОбеспечения), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.КредитПослеОтгрузки), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.АвансДоПодтверждения), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.КредитПослеПоступления), ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание))
	               	|				И ОбъектСтроительства = &ОбъектСтроительства) КАК ГрафикДвиженийПоДоговору
	               	|ГДЕ
	               	|	(ГрафикДвиженийПоДоговору.Регистратор ССЫЛКА Документ.УСОERP_РаспределениеПоАналитикеГрафикаДоговоров
	               	|			ИЛИ ГрафикДвиженийПоДоговору.Регистратор ССЫЛКА Документ.УСОERP_ДоговорССубподрядчиком
	               	|			ИЛИ ГрафикДвиженийПоДоговору.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	               	|			ИЛИ ГрафикДвиженийПоДоговору.Регистратор ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств)
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
	               	|	ДвиженияПоДоговору.Договор КАК Договор,
	               	|	ДвиженияПоДоговору.Контрагент КАК Контрагент,
	               	|	СУММА(ДвиженияПоДоговору.СуммаПлан) КАК СуммаПлан,
	               	|	СУММА(ДвиженияПоДоговору.СуммаФакт) КАК СуммаФакт
	               	|ИЗ
	               	|	ДвиженияПоДоговору КАК ДвиженияПоДоговору
	               	|
	               	|СГРУППИРОВАТЬ ПО
	               	|	ДвиженияПоДоговору.Договор,
	               	|	ДвиженияПоДоговору.Контрагент";
		
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		Запрос.УстановитьПараметр("ДатаНачала", 			ДатаНачала);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаНачала", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		Запрос.УстановитьПараметр("ДатаОкончания", 			ДатаОкончания);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаОкончания", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектСтроительства) Тогда
		Запрос.УстановитьПараметр("ОбъектСтроительства",	ОбъектСтроительства);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ОбъектСтроительства = &ОбъектСтроительства", "");
	КонецЕсли;
		
	ТЗ_Результат = Запрос.Выполнить().Выгрузить();
	
	АналитикаДвиженияПоДоговору.Загрузить(ТЗ_Результат);	
	
КонецПроцедуры

&НаКлиенте
Процедура 	ПровестиВсе(Команда)																			
	
	ПровестиВсеНаСервере();

КонецПроцедуры

&НаСервере
Процедура 	ПровестиВсеНаСервере()																			
	
	Для Каждого ТекСтрока Из ЗаявкиНаРасходованиеДС Цикл
		Попытка
			ЗаявкаОбъект = ТекСтрока.Заявка.ПолучитьОбъект();
			ЗаявкаОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Исключение
			ЗаписьЖурналаРегистрации("Ошибка! Не удалось провести документ: " + ТекСтрока.Заявка, 
									УровеньЖурналаРегистрации.Ошибка, 
									Метаданные.Документы.ЗаявкаНаРасходованиеДенежныхСредств);
									Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура 	СоздатьЗаявки(Команда)																			
	СоздатьЗаявкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура 	СоздатьЗаявкиНаСервере()																		
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЗ_ДвиженияПоДоговору.Договор,
		|	ТЗ_ДвиженияПоДоговору.Контрагент
		|ПОМЕСТИТЬ ТЗ_ДвиженияПоДоговору
		|ИЗ
		|	&ТЗ_ДвиженияПоДоговору КАК ТЗ_ДвиженияПоДоговору
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЗ_ДвиженияПоДоговору.Договор,
		|	ГрафикДвиженийПоДоговору.Ссылка КАК График,
		|	МАКСИМУМ(ГрафикДвиженийПоДоговору.Дата) КАК Дата
		|ПОМЕСТИТЬ ДанныеПоДоговору
		|ИЗ
		|	ТЗ_ДвиженияПоДоговору КАК ТЗ_ДвиженияПоДоговору
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УСОERP_ГрафикДвиженийПоДоговору КАК ГрафикДвиженийПоДоговору
		|		ПО ТЗ_ДвиженияПоДоговору.Договор = ГрафикДвиженийПоДоговору.Договор
		|ГДЕ
		|	НЕ ГрафикДвиженийПоДоговору.ПометкаУдаления
		|	И ГрафикДвиженийПоДоговору.Дата >= &ДатаНачала И ГрафикДвиженийПоДоговору.Дата <= &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	ТЗ_ДвиженияПоДоговору.Договор,
		|	ГрафикДвиженийПоДоговору.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыКонтрагентов.Ссылка КАК Договор,
		|	ТЗ_ДвиженияПоДоговору.Контрагент,
		|	ДанныеПоДоговору.График
		|ПОМЕСТИТЬ ДанныеЗаявки
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЗ_ДвиженияПоДоговору КАК ТЗ_ДвиженияПоДоговору
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеПоДоговору КАК ДанныеПоДоговору
		|			ПО ТЗ_ДвиженияПоДоговору.Договор = ДанныеПоДоговору.Договор
		|		ПО ДоговорыКонтрагентов.Ссылка = ТЗ_ДвиженияПоДоговору.Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеЗаявки.Договор,
		|	ДанныеЗаявки.Контрагент,
		|	ДанныеЗаявки.График,
		|	ГрафикДвиженийПоДоговоруОбороты.ДатаСобытияПоДоговору КАК ДатаПлатежа,
		|	ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты,
		|	ГрафикДвиженийПоДоговоруОбороты.ФинансированиеПланОборот КАК СуммаДокумента
		|ПОМЕСТИТЬ ДанныеРегистра
		|ИЗ
		|	ДанныеЗаявки КАК ДанныеЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору.Обороты(
		|				&ДатаНачала,
		|				&ДатаОкончания,
		|				Регистратор,
		|				ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.АвансДоОбеспечения)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.АвансДоПодтверждения)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.КредитПослеОтгрузки)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.КредитПослеПоступления)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание)) КАК ГрафикДвиженийПоДоговоруОбороты
		|		ПО ДанныеЗаявки.График = ГрафикДвиженийПоДоговоруОбороты.Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеРегистра.Договор,
		|	ДанныеРегистра.Контрагент,
		|	ДанныеРегистра.График,
		|	ДанныеРегистра.ДатаПлатежа,
		|	ДанныеРегистра.ПорядокОплаты,
		|	ДанныеРегистра.СуммаДокумента,
		|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка КАК Заявка
		|ИЗ
		|	ДанныеРегистра КАК ДанныеРегистра
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
		|		ПО ДанныеРегистра.Контрагент = ЗаявкаНаРасходованиеДенежныхСредств.Контрагент
		|			И ДанныеРегистра.Договор = ЗаявкаНаРасходованиеДенежныхСредств.ДокументОснование
		|			И (НЕ ЗаявкаНаРасходованиеДенежныхСредств.ПометкаУдаления)
		|			И ДанныеРегистра.СуммаДокумента = ЗаявкаНаРасходованиеДенежныхСредств.СуммаДокумента
		|			И ДанныеРегистра.ДатаПлатежа = ЗаявкаНаРасходованиеДенежныхСредств.ЖелательнаяДатаПлатежа
		|			И ДанныеРегистра.Договор.Организация = ЗаявкаНаРасходованиеДенежныхСредств.Организация
		|			И ДанныеРегистра.Договор.Подразделение = ЗаявкаНаРасходованиеДенежныхСредств.Подразделение";
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЗ_ДвиженияПоДоговору.Договор КАК Договор,
		|	ТЗ_ДвиженияПоДоговору.Контрагент КАК Контрагент
		|ПОМЕСТИТЬ ТЗ_ДвиженияПоДоговору
		|ИЗ
		|	&ТЗ_ДвиженияПоДоговору КАК ТЗ_ДвиженияПоДоговору
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТЗ_ДвиженияПоДоговору.Договор КАК Договор,
		|	ГрафикДвиженийПоДоговору.Ссылка КАК График,
		|	МАКСИМУМ(ГрафикДвиженийПоДоговору.Дата) КАК Дата
		|ПОМЕСТИТЬ ДанныеПоДоговору
		|ИЗ
		|	ТЗ_ДвиженияПоДоговору КАК ТЗ_ДвиженияПоДоговору
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ГрафикДвиженийПоДоговору КАК ГрафикДвиженийПоДоговору
		|		ПО ТЗ_ДвиженияПоДоговору.Договор = ГрафикДвиженийПоДоговору.Договор
		|ГДЕ
		|	НЕ ГрафикДвиженийПоДоговору.ПометкаУдаления
		|	И ГрафикДвиженийПоДоговору.Дата >= &ДатаНачала
		|	И ГрафикДвиженийПоДоговору.Дата <= &ДатаОкончания
		|
		|СГРУППИРОВАТЬ ПО
		|	ТЗ_ДвиженияПоДоговору.Договор,
		|	ГрафикДвиженийПоДоговору.Ссылка
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТЗ_ДвиженияПоДоговору.Договор,
		|	УСОERP_ДоговорСЗаказчиком.Ссылка,
		|	УСОERP_ДоговорСЗаказчиком.Дата
		|ИЗ
		|	ТЗ_ДвиженияПоДоговору КАК ТЗ_ДвиженияПоДоговору
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УСОERP_ДоговорССубподрядчиком КАК УСОERP_ДоговорСЗаказчиком
		|		ПО ТЗ_ДвиженияПоДоговору.Договор = УСОERP_ДоговорСЗаказчиком.Договор
		|			И ТЗ_ДвиженияПоДоговору.Контрагент = УСОERP_ДоговорСЗаказчиком.Контрагент
		|ГДЕ
		|	УСОERP_ДоговорСЗаказчиком.Проведен
		|	И УСОERP_ДоговорСЗаказчиком.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПланов.Утвержден)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДоговорыКонтрагентов.Ссылка КАК Договор,
		|	ТЗ_ДвиженияПоДоговору.Контрагент КАК Контрагент,
		|	ДанныеПоДоговору.График КАК График
		|ПОМЕСТИТЬ ДанныеЗаявки
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТЗ_ДвиженияПоДоговору КАК ТЗ_ДвиженияПоДоговору
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеПоДоговору КАК ДанныеПоДоговору
		|			ПО ТЗ_ДвиженияПоДоговору.Договор = ДанныеПоДоговору.Договор
		|		ПО ДоговорыКонтрагентов.Ссылка = ТЗ_ДвиженияПоДоговору.Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеЗаявки.Договор КАК Договор,
		|	ДанныеЗаявки.Контрагент КАК Контрагент,
		|	ДанныеЗаявки.График КАК График,
		|	ГрафикДвиженийПоДоговоруОбороты.ДатаСобытияПоДоговору КАК ДатаПлатежа,
		|	ГрафикДвиженийПоДоговоруОбороты.ПорядокОплаты КАК ПорядокОплаты,
		|	ГрафикДвиженийПоДоговоруОбороты.ФинансированиеПланОборот КАК СуммаДокумента
		|ПОМЕСТИТЬ ДанныеРегистра
		|ИЗ
		|	ДанныеЗаявки КАК ДанныеЗаявки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УСОERP_ГрафикДвиженийПоДоговору.Обороты(
		|				&ДатаНачала,
		|				&ДатаОкончания,
		|				Регистратор,
		|				ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.АвансДоОбеспечения)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.АвансДоПодтверждения)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.КредитПослеОтгрузки)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.КредитПослеПоступления)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.УСОERP_ГарантийноеУдержание)
		|					ИЛИ ПорядокОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыПоставщику.УСОERP_ГарантийноеУдержание)) КАК ГрафикДвиженийПоДоговоруОбороты
		|		ПО ДанныеЗаявки.График = ГрафикДвиженийПоДоговоруОбороты.Регистратор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ДанныеРегистра.Договор КАК Договор,
		|	ДанныеРегистра.Контрагент КАК Контрагент,
		|	ДанныеРегистра.График КАК График,
		|	ДанныеРегистра.ДатаПлатежа КАК ДатаПлатежа,
		|	ДанныеРегистра.ПорядокОплаты КАК ПорядокОплаты,
		|	ДанныеРегистра.СуммаДокумента КАК СуммаДокумента,
		|	ЗаявкаНаРасходованиеДенежныхСредств.Ссылка КАК Заявка
		|ИЗ
		|	ДанныеРегистра КАК ДанныеРегистра
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаРасходованиеДенежныхСредств КАК ЗаявкаНаРасходованиеДенежныхСредств
		|		ПО ДанныеРегистра.Контрагент = ЗаявкаНаРасходованиеДенежныхСредств.Контрагент
		|			И ДанныеРегистра.Договор = ЗаявкаНаРасходованиеДенежныхСредств.ДокументОснование
		|			И (НЕ ЗаявкаНаРасходованиеДенежныхСредств.ПометкаУдаления)
		|			И ДанныеРегистра.СуммаДокумента = ЗаявкаНаРасходованиеДенежныхСредств.СуммаДокумента
		|			И ДанныеРегистра.ДатаПлатежа = ЗаявкаНаРасходованиеДенежныхСредств.ЖелательнаяДатаПлатежа
		|			И ДанныеРегистра.Договор.Организация = ЗаявкаНаРасходованиеДенежныхСредств.Организация
		|			И ДанныеРегистра.Договор.Подразделение = ЗаявкаНаРасходованиеДенежныхСредств.Подразделение";

		
	Запрос.УстановитьПараметр("ТЗ_ДвиженияПоДоговору", 	АналитикаДвиженияПоДоговору.Выгрузить());
	Если ЗначениеЗаполнено(ПериодФормирования.ДатаНачала) Тогда
		Запрос.УстановитьПараметр("ДатаНачала", 		ПериодФормирования.ДатаНачала);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ГрафикДвиженийПоДоговору.Дата >= &ДатаНачала", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаНачала", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(ПериодФормирования.ДатаОкончания) Тогда
		Запрос.УстановитьПараметр("ДатаОкончания", 		ПериодФормирования.ДатаОкончания);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ГрафикДвиженийПоДоговору.Дата <= &ДатаОкончания", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДатаОкончания", "");
	КонецЕсли;

	ТЗ_Результат = Запрос.Выполнить().Выгрузить();
		
	Для Каждого ТекСтрока Из ТЗ_Результат Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.Заявка) Тогда
			
			НоваяЗаявка = Документы.ЗаявкаНаРасходованиеДенежныхСредств.СоздатьДокумент();
			НоваяЗаявка.Дата 					= ТекущаяДата();               
			НоваяЗаявка.Контрагент 				= ТекСтрока.Контрагент;
			НоваяЗаявка.ДокументОснование 		= ТекСтрока.Договор;
			НоваяЗаявка.Организация 			= ТекСтрока.Договор.Организация;
			НоваяЗаявка.Подразделение 			= ТекСтрока.Договор.Подразделение;
			НоваяЗаявка.БанковскийСчет 			= ?(ЗначениеЗаполнено(ТекСтрока.Договор.БанковскийСчет),ТекСтрока.Договор.БанковскийСчет,Справочники.БанковскиеСчетаОрганизаций.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(ТекСтрока.Договор.Организация,ТекСтрока.Договор.ВалютаВзаиморасчетов));
			НоваяЗаявка.БанковскийСчетКонтрагента = ?(ЗначениеЗаполнено(ТекСтрока.Договор.БанковскийСчетКонтрагента),ТекСтрока.Договор.БанковскийСчетКонтрагента,Справочники.БанковскиеСчетаКонтрагентов.ПолучитьБанковскийСчетПоУмолчанию(ТекСтрока.Контрагент,ТекСтрока.Договор.ВалютаВзаиморасчетов));;
			НоваяЗаявка.Статус					= Перечисления.СтатусыЗаявокНаРасходованиеДенежныхСредств.НеСогласована;
			НоваяЗаявка.КтоЗаявил				= ПараметрыСеанса.ТекущийПользователь;
			НоваяЗаявка.Валюта					= ТекСтрока.Договор.ВалютаВзаиморасчетов;
			НоваяЗаявка.ПланированиеСуммы 		= Перечисления.СпособыПланированияОплатыЗаявок.ВВалютеВзаиморасчетов;
			НоваяЗаявка.ФормаОплатыНаличная 	= Ложь;
			НоваяЗаявка.ФормаОплатыБезналичная 	= Истина;
			НоваяЗаявка.ХозяйственнаяОперация	= Перечисления.ХозяйственныеОперации.ОплатаПоставщику; 		
			НоваяЗаявка.ПриоритетОплаты         = Справочники.ПриоритетыОплаты.НайтиПоНаименованию("Средний");
			НоваяЗаявка.ФормаОплатыЗаявки		= Перечисления.ФормыОплаты.Безналичная; 			
			НоваяЗаявка.ЖелательнаяДатаПлатежа	= ТекСтрока.ДатаПлатежа;
			НоваяЗаявка.СуммаДокумента			= ТекСтрока.СуммаДокумента;
			
			НоваяСтрокаЗаявки = НоваяЗаявка.РасшифровкаПлатежа.Добавить();
			НоваяСтрокаЗаявки.Заказ 						= ТекСтрока.Договор;
			НоваяСтрокаЗаявки.Партнер 						= ТекСтрока.Договор.Партнер;
			НоваяСтрокаЗаявки.СтатьяДвиженияДенежныхСредств = ?(ЗначениеЗаполнено(ТекСтрока.Договор.СтатьяДвиженияДенежныхСредств),ТекСтрока.Договор.СтатьяДвиженияДенежныхСредств,Справочники.СтатьиДвиженияДенежныхСредств.ОплатаПоставщику);
			НоваяСтрокаЗаявки.Сумма							= ТекСтрока.СуммаДокумента;
			НоваяСтрокаЗаявки.СуммаВзаиморасчетов           = НоваяСтрокаЗаявки.Сумма;
			НоваяСтрокаЗаявки.СтавкаНДС = ?(ЗначениеЗаполнено(ТекСтрока.Договор.СтавкаНДС),ТекСтрока.Договор.СтавкаНДС,Перечисления.СтавкиНДС.БезНДС);
			НоваяСтрокаЗаявки.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(НоваяСтрокаЗаявки.Сумма,Истина,УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(НоваяСтрокаЗаявки.СтавкаНДС));
			НоваяСтрокаЗаявки.УСОERP_ОбъектСтроительства = ?(ЗначениеЗаполнено(ОбъектСтроительства),ОбъектСтроительства,Документы.УСОERP_ДополнительныеПараметрыПоДоговору.НайтиПоРеквизиту("Договор",ТекСтрока.Договор).ОбъектСтроительства);
			
			Попытка
				НоваяЗаявка.Записать();
			Исключение
				ЗаписьЖурналаРегистрации("Ошибка! Не удалось записать новую заявку на расходование ДС!", 
										УровеньЖурналаРегистрации.Ошибка, 
										Метаданные.Документы.ЗаявкаНаРасходованиеДенежныхСредств);
										Сообщить(ОписаниеОшибки());
			КонецПопытки;
			ТекСтрока.Заявка = НоваяЗаявка.Ссылка;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗаявкиНаРасходованиеДС.Загрузить(ТЗ_Результат);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗаявкиНаРасходованиеДСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.ЗаявкиНаРасходованиеДС.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		ПоказатьЗначение(,ТекСтрока.Заявка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти