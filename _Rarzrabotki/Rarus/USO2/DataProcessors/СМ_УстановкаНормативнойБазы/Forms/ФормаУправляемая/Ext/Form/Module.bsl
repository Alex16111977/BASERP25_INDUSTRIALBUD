#Область СлужебныеПроцедурыИФункции

// БАЗОВЫЕ ФУНКЦИИ

&НаКлиенте
Процедура ДоступностьЭлементов()
	
	Элементы.НадписьСсылка.Доступность = Истина;
	
	Если ЗначениеЗаполнено(Объект.Ид) Тогда
		Элементы.НадписьСсылка.Заголовок = НСтр("ru='Вы можете перейти к настройкам внешней нормативной базы'");
	Иначе
		Элементы.НадписьСсылка.Заголовок = НСтр("ru='Ключ не найден! Настройте параметры внешней нормативной базы'");
	КонецЕсли;
	
КонецПроцедуры

// ОБРАБОТКИ СОБЫТИЙ

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Попытка
		ВерсияКомпоненты = Число(СметнаяКомпонента.Version);
	Исключение
		ВерсияКомпоненты = 1;
	КонецПопытки;
	
	Если СметнаяКомпонента = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru='Внешняя нормативная база не установлена'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ВерсияКомпоненты > 1 Тогда
		ПоказатьПредупреждение(,НСтр("ru='Для данной версии нормативной базы существует отдельная программа установки в дистрибутиве'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Объект.Ид = СметнаяКомпонента.ПолучитьИдентификаторКлюча();
	
	ДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	Попытка
		// Открытие из сохраненных значений.
		// Восстанавливаем значения параметров из базы.
		ПараметрыСвойств = СМ_СметаВызовСервера.ПараметрыСвойствСметнойКомпоненты();
	
		Объект.ДиректорияНормативнойБазы = ПараметрыСвойств.ДиректорияНорм;
	Исключение
		Событие = НСтр("ru = 'Исключение Установка нормативной базы'");
		СМ_СметаЗагрузкаВызовСервера.ЗаписатьВЖурналаРегистрации(Событие);
	КонецПопытки;
	
КонецПроцедуры

