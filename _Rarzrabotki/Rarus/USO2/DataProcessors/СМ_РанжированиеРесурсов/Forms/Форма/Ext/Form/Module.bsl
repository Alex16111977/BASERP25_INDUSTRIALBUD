&НаСервере
Функция ОбновитьЦеныРесурсыСметы(ТаблицаСводная, Смета, МассивПозиций)

	Для Каждого ТекПозиция Из МассивПозиций Цикл

		Если ТекПозиция.РесурсыПозицииЛокальнойСметы.Количество() = 0 И 
			(ТекПозиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Материал ИЛИ 
			ТекПозиция.Определитель.ВидРасценки = Перечисления.СМ_ВидыРасценки.Оборудование) Тогда
			
			Отбор 				= Новый Структура("ЭтоНеучтенный, КодРесурса, НаименованиеРесурса, ЕдиницаИзмеренияРесурса", Истина,ТекПозиция.ШифрРасценки,ТекПозиция.Наименование,ТекПозиция.ЕдиницаИзмерения);
			МассивРесурсов 		= ТаблицаСводная.НайтиСтроки(Отбор);
						
			Если МассивРесурсов.Количество() > 0 Тогда
				ПозицияОбъект 		= ТекПозиция.ПолучитьОбъект();
				ТекСтрокаРесурса 	= МассивРесурсов[0];

				Если ТекСтрокаРесурса.ЦенаТекущая > 0 Тогда
					ПозицияОбъект.ТекущаяЦена = ТекСтрокаРесурса.ЦенаТекущая;	
				КонецЕсли;     
				
				Если ТекСтрокаРесурса.ЦенаТекущаяЗМ > 0 Тогда			
					ПозицияОбъект.ТекущаяЗарплМашинистов = ТекСтрокаРесурса.ЦенаТекущаяЗМ;
				КонецЕсли;
				ПозицияОбъект.Записать();
				Модифицировано = Истина;
				
			КонецЕсли;
		
		Иначе 		
			
			ПозицияОбъект = ТекПозиция.ПолучитьОбъект();
		
			// Позиция с ресурсами.
			Для Каждого СтрокаТЧ Из ПозицияОбъект.РесурсыПОзицииЛокальнойСметы Цикл
				
				Отбор = Новый Структура("ЭтоНеучтенный, Ресурс", Ложь, СтрокаТЧ.Ресурс);
				МассивРесурсов = ТаблицаСводная.НайтиСтроки(Отбор);
				
				Если МассивРесурсов.Количество() > 0 Тогда
					
					ТекСтрокаРесурса = МассивРесурсов[0];
					
				    Если ТекСтрокаРесурса.ЦенаТекущая > 0 Тогда
						СтрокаТЧ.ТекущаяЦена = ТекСтрокаРесурса.ЦенаТекущая;	
					КонецЕсли;    
	
				    Если ТекСтрокаРесурса.ЦенаТекущаяЗМ > 0 Тогда
						СтрокаТЧ.ТекущаяЗарплатаМашинистов = ТекСтрокаРесурса.ЦенаТекущаяЗМ ;	
					КонецЕсли;
					Записать 		= Истина;
					Модифицировано 	= Истина;
				КонецЕсли;				

			КонецЦикла;
		
			Если Записать Тогда
				ПозицияОбъект.Записать();
			КонецЕсли;   		
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат Модифицировано;
	
КонецФункции

&НаСервере
Процедура ПоказатьТолькоПредставителиСервер()
	
	ТекДерево = РеквизитФормыВЗначение("ДеревоРесурсов");
	ПоказатьТолькоПредставители(ТекДерево);
	ЗначениеВРеквизитФормы(ТекДерево,"ДеревоРесурсов");

КонецПроцедуры

&НаСервере
Процедура ПоказатьТолькоПредставители(ТекДерево)
	
	СуммаОтбора = 0;
	Для Каждого ТекСтрока Из ТекДерево.Строки Цикл
		Если ТекСтрока.ЭтоРесурс Тогда
			Если НЕ ТекСтрока.ЭтоПредставитель Тогда
				ТекСтрока.Видимость = Ложь;
			КонецЕсли;
		Иначе
			ПоказатьТолькоПредставители(ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
