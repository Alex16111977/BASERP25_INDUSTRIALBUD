
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЛокальнаяСмета") Тогда
		ЗаполнитьРесурсыСметы(Параметры.ЛокальнаяСмета);
		ЭтаФорма.ЛокальнаяСмета = Параметры.ЛокальнаяСмета;
		
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("Использовать",Истина);
		ТабРанжирования = Параметры.ЛокальнаяСмета.Ранжирование.Выгрузить(СтруктураОтбора);
		ЭтаФорма.ТаблицаРанжирования.Загрузить(ТабРанжирования);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоРесурсов

&НаКлиенте
Процедура ДеревоРесурсовЦенаНоваяПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДеревоРесурсов.ТекущиеДанные;
	ТекСтрока = Элементы.ДеревоРесурсов.ТекущаяСтрока;
	
	Если ТекДанные.ЦенаНовая > 0 Тогда
		
		ТекРодитель 		= ДеревоРесурсов.НайтиПоИдентификатору(ТекСтрока).ПолучитьРодителя();
		ПодчиненныеСтроки	= ТекРодитель.ПолучитьЭлементы();
		СуммаКоэффициентов 	= 0;
		ЧислоОпределителей 	= 0;
		
		Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
			Если ПодчиненнаяСтрока.ЭтоПредставитель Тогда
				ТекКоэффициент = 0;
				Если ПодчиненнаяСтрока.ЦенаТекущая > 0 Тогда
					ТекКоэффициент 						= ПодчиненнаяСтрока.ЦенаНовая / ПодчиненнаяСтрока.ЦенаТекущая;
					ПодчиненнаяСтрока.СтоимостьНовая	= ПодчиненнаяСтрока.Стоимость * ТекКоэффициент;
					СуммаКоэффициентов 					= СуммаКоэффициентов + ТекКоэффициент;
					ЧислоОпределителей 					= ЧислоОпределителей + 1;
				КонецЕсли;
			Иначе
				Если ЧислоОпределителей > 0 Тогда
					СреднийКоэффициент = СуммаКоэффициентов / ЧислоОпределителей;
				КонецЕсли;
				ПодчиненнаяСтрока.ЦенаНовая 		= ПодчиненнаяСтрока.ЦенаТекущая * СреднийКоэффициент;
				ПодчиненнаяСтрока.СтоимостьНовая    = ПодчиненнаяСтрока.Стоимость * СреднийКоэффициент;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоРесурсовЦенаНоваяЗМПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДеревоРесурсов.ТекущиеДанные;
	ТекСтрока = Элементы.ДеревоРесурсов.ТекущаяСтрока;
	
	Если ТекДанные.ЦенаНоваяЗМ > 0 Тогда
		
		ТекРодитель 		= ДеревоРесурсов.НайтиПоИдентификатору(ТекСтрока).ПолучитьРодителя();
		ПодчиненныеСтроки	= ТекРодитель.ПолучитьЭлементы();
		СуммаКоэффициентов 	= 0;
		ЧислоОпределителей 	= 0;
		
		Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
			
			Если ПодчиненнаяСтрока.ЭтоПредставитель Тогда
				ТекКоэффициент = 0;
				Если ПодчиненнаяСтрока.ЦенаТекущаяЗМ > 0 Тогда       
					ТекКоэффициент 						= ПодчиненнаяСтрока.ЦенаНоваяЗМ / ПодчиненнаяСтрока.ЦенаТекущаяЗМ;
					ПодчиненнаяСтрока.СтоимостьНоваяЗМ	= ПодчиненнаяСтрока.СтоимостьЗМ * ТекКоэффициент;
					СуммаКоэффициентов 					= СуммаКоэффициентов + ТекКоэффициент;
					ЧислоОпределителей 					= ЧислоОпределителей + 1;
				КонецЕсли;
			Иначе
				Если ЧислоОпределителей > 0 Тогда
					СреднийКоэффициент = СуммаКоэффициентов / ЧислоОпределителей;
				КонецЕсли;
				
				ПодчиненнаяСтрока.ЦенаНоваяЗМ 		= ПодчиненнаяСтрока.ЦенаТекущаяЗМ * СреднийКоэффициент;
				ПодчиненнаяСтрока.СтоимостьНоваяЗМ  = ПодчиненнаяСтрока.СтоимостьЗМ * СреднийКоэффициент;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Группировать(Команда)
	
	Группировать = Истина;
	ЗаполнитьРесурсыСметы(ЭтаФорма.ЛокальнаяСмета, Группировать);

КонецПроцедуры

&НаКлиенте
Процедура Ранжировать(Команда)
	
	РанжироватьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьВСмету(Команда)
	
	РедактироватьЦеныНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ТолькоПредставители(Команда)

	ПоказатьТолькоПредставителиСервер();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура РанжироватьНаСервере()
	
	ТекПроцент 		= 0;
	СуммаРесурсов 	= 0;
	СуммаГруппыВида = 0;
	ТекДерево 		= РеквизитФормыВЗначение("ДеревоРесурсов");
	ОбработкаДерева(ТекДерево,ТекПроцент,СуммаРесурсов,СуммаГруппыВида);
	ЗначениеВРеквизитФормы(ТекДерево,"ДеревоРесурсов");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРесурсыСметы(ТекЛокальнаяСмета,Группировать = Ложь)

	Запрос 			= Новый Запрос;
	Запрос.Текст 	= " 
	|ВЫБРАТЬ
	|	СМ_ПозицияЛокальнойСметы.Ссылка КАК Позиция
	|ИЗ
	|	Документ.СМ_ПозицияЛокальнойСметы КАК СМ_ПозицияЛокальнойСметы
	|ГДЕ
	|	СМ_ПозицияЛокальнойСметы.ИДСметы = &ИДСметы И
	|	СМ_ПозицияЛокальнойСметы.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ИДСметы",ТекЛокальнаяСмета);
	
	ТабРезультат 	= Запрос.Выполнить().Выгрузить();
	МассивПозиций 	= ТабРезультат.ВыгрузитьКолонку("Позиция");
	СписокПозиций.ЗагрузитьЗначения(МассивПозиций);
	
	ТолькоФактическиеРесурсы 	= Ложь;
	ГруппироватьСтатусы			= Ложь;
	ТаблицаРесурсов 			= СМ_СметаРасчетВызовСервера.ПолучитьТаблицуСтоимостиРесурсовСметы(СписокПозиций,Истина,Ложь,,ТолькоФактическиеРесурсы,Истина,,ГруппироватьСтатусы);

	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.СМ_Ресурсы"));
	МассивТипов.Добавить(Тип("Строка"));

	ДопустимыеТипы = Новый ОписаниеТипов(МассивТипов);
	ТаблицаРесурсов.Колонки.Добавить("Группа",ДопустимыеТипы);

	// Добавляем группу ресурса
	Для Каждого ТекСтрока Из ТаблицаРесурсов Цикл
		Если ЗначениеЗаполнено(ТекСтрока.Ресурс) Тогда
			ТекСтрока.Группа = ТекСтрока.Ресурс.Родитель.Наименование;	
		Иначе
			ТекСтрока.Группа = "Не найден в классификаторе";
		КонецЕсли;
	КонецЦикла;
	
	Если Группировать Тогда
		ТаблицаРесурсов.Сортировать("ВидРесурса Возр, Группа Возр, СтоимостьТекущая Убыв");
	Иначе
		ТаблицаРесурсов.Сортировать("ВидРесурса Возр, СтоимостьТекущая Убыв");
	КонецЕсли;
	
	// *********************************************************************
	Запрос 			= Новый Запрос;
	Запрос.Текст 	= "
	|ВЫБРАТЬ
	|	ТаблицаРесурсов.ВидРесурса КАК ВидРесурса,
	|	ВЫРАЗИТЬ(ТаблицаРесурсов.Группа КАК СТРОКА(120)) КАК Группа,
	|	ТаблицаРесурсов.Ресурс КАК Ресурс,
	|	ТаблицаРесурсов.КодРесурса КАК КодРесурса,	
	|	ТаблицаРесурсов.НаименованиеРесурса КАК НаименованиеРесурса,
	|	ТаблицаРесурсов.Количество КАК Количество,
	|	ТаблицаРесурсов.ЦенаТекущая КАК ЦенаТекущая,
	|	ТаблицаРесурсов.ЦенаТекущаяЗМ КАК ЦенаТекущаяЗМ,
	|	ТаблицаРесурсов.СтоимостьТекущая КАК СтоимостьТекущая,
	|	ТаблицаРесурсов.СтоимостьТекущаяЗМ КАК СтоимостьТекущаяЗМ,
	|	ТаблицаРесурсов.ЭтоНеучтенный КАК ЭтоНеучтенный,
	|	ТаблицаРесурсов.ЕдиницаИзмеренияРесурса КАК ЕдиницаИзмеренияРесурса 
	|ПОМЕСТИТЬ ТабРесурсов
	|ИЗ
	|	&ТаблицаРесурсов КАК ТаблицаРесурсов;
	|
	|ВЫБРАТЬ
	|	ТабРесурсов.ВидРесурса КАК ВидРесурса,
	|	ТабРесурсов.Группа КАК Группа,
	|	ТабРесурсов.Ресурс КАК Ресурс,
	|	ТабРесурсов.КодРесурса КАК КодРесурса,	
	|	ТабРесурсов.НаименованиеРесурса КАК НаименованиеРесурса,
	|	ТабРесурсов.Количество КАК Количество,
	|	СРЕДНЕЕ(ТабРесурсов.ЦенаТекущая) КАК ЦенаТекущая,
	|	СРЕДНЕЕ(ТабРесурсов.ЦенаТекущаяЗМ) КАК ЦенаТекущаяЗМ,
	|	Сумма(ТабРесурсов.СтоимостьТекущая) КАК СтоимостьТекущая,
	|	Сумма(ТабРесурсов.СтоимостьТекущаяЗМ) КАК СтоимостьТекущаяЗМ,
	|	ТабРесурсов.ЭтоНеучтенный КАК ЭтоНеучтенный,
	|	ТабРесурсов.ЕдиницаИзмеренияРесурса КАК ЕдиницаИзмеренияРесурса 
	|ИЗ
	|	ТабРесурсов КАК ТабРесурсов
	|СГРУППИРОВАТЬ ПО
	|	ТабРесурсов.ВидРесурса,
	|   ТабРесурсов.Группа,
	|	ТабРесурсов.Ресурс,
	|	ТабРесурсов.КодРесурса,
	|	ТабРесурсов.НаименованиеРесурса,
	|	ТабРесурсов.ЦенаТекущая,
	|	ТабРесурсов.ЦенаТекущаяЗМ,
	|	ТабРесурсов.Количество,
	|	ТабРесурсов.ЭтоНеучтенный,
	|	ТабРесурсов.ЕдиницаИзмеренияРесурса
	|ИТОГИ ПО 
	|	ТабРесурсов.ВидРесурса";

	Если Группировать Тогда
		Запрос.Текст = Запрос.Текст + ", ТабРесурсов.Группа";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ТаблицаРесурсов",ТаблицаРесурсов);
	
	ДеревоЗначений = РеквизитФормыВЗначение("ДеревоРесурсов");
	ДеревоЗначений.Строки.Очистить();
	
	ВыборкаВидРесурса = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ВидРесурса");
	Пока ВыборкаВидРесурса.Следующий() Цикл
		
		СтрокаРодитель 					= ДеревоЗначений.Строки.Добавить();
		СтрокаРодитель.Группировка 		= ВыборкаВидРесурса.ВидРесурса;
		СтрокаРодитель.ВидРесурса 		= ВыборкаВидРесурса.ВидРесурса;
		СтрокаРодитель.ЦенаТекущая		= ВыборкаВидРесурса.ЦенаТекущая;
		СтрокаРодитель.ЦенаТекущаяЗМ	= ВыборкаВидРесурса.ЦенаТекущаяЗМ;
		СтрокаРодитель.Стоимость		= ВыборкаВидРесурса.СтоимостьТекущая;
		СтрокаРодитель.СтоимостьЗМ		= ВыборкаВидРесурса.СтоимостьТекущаяЗМ;
		СтрокаРодитель.ЭтоВидРесурса	= Истина;
		СтрокаРодитель.Видимость		= Истина;
		
		Если Группировать Тогда
		
			ВыборкаГруппа = ВыборкаВидРесурса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"Группа");
			Пока ВыборкаГруппа.Следующий() Цикл
				
				СтрокаРодительГруппа 				= СтрокаРодитель.Строки.Добавить();
				СтрокаРодительГруппа.Группировка 	= СокрЛП(ВыборкаГруппа.Группа);
				СтрокаРодительГруппа.ГруппаРесурса	= СокрЛП(ВыборкаГруппа.Группа);
				СтрокаРодительГруппа.ЦенаТекущая	= ВыборкаГруппа.ЦенаТекущая;
				СтрокаРодительГруппа.ЦенаТекущаяЗМ	= ВыборкаГруппа.ЦенаТекущаяЗМ;
				СтрокаРодительГруппа.Стоимость		= ВыборкаГруппа.СтоимостьТекущая;
				СтрокаРодительГруппа.СтоимостьЗМ	= ВыборкаГруппа.СтоимостьТекущаяЗМ;
				СтрокаРодительГруппа.ЭтоГруппа		= Истина;
				СтрокаРодительГруппа.Видимость		= Истина;

				ВыборкаРесурс = ВыборкаГруппа.Выбрать();
				Пока ВыборкаРесурс.Следующий() Цикл
				
					СтрокаДерева 							= СтрокаРодительГруппа.Строки.Добавить();
					СтрокаДерева.ВидРесурса 				= ВыборкаВидРесурса.ВидРесурса;
					СтрокаДерева.ГруппаРесурса				= СокрЛП(ВыборкаГруппа.Группа);
					СтрокаДерева.ЦенаТекущая				= ВыборкаРесурс.ЦенаТекущая;
					СтрокаДерева.ЦенаТекущаяЗМ				= ВыборкаРесурс.ЦенаТекущаяЗМ;
					СтрокаДерева.Стоимость					= ВыборкаРесурс.СтоимостьТекущая;
					СтрокаДерева.СтоимостьЗМ				= ВыборкаРесурс.СтоимостьТекущаяЗМ;
					СтрокаДерева.Количество					= ВыборкаРесурс.Количество;
					СтрокаДерева.Шифр						= ВыборкаРесурс.КодРесурса;
					СтрокаДерева.ЭтоНеучтенный				= ВыборкаРесурс.ЭтоНеучтенный;
					СтрокаДерева.ЭтоРесурс					= Истина;
					СтрокаДерева.Группировка 				= ВыборкаРесурс.НаименованиеРесурса;
					СтрокаДерева.Ресурс 					= ВыборкаРесурс.Ресурс;
					СтрокаДерева.ЕдиницаИзмеренияРесурса 	= ВыборкаРесурс.ЕдиницаИзмеренияРесурса;
					СтрокаДерева.Видимость				 	= Истина;
					
				КонецЦикла;
			КонецЦикла;
		
		Иначе
			
			ВыборкаРесурс = ВыборкаВидРесурса.Выбрать();
			Пока ВыборкаРесурс.Следующий() Цикл
				
				СтрокаДерева 							= СтрокаРодитель.Строки.Добавить();
				СтрокаДерева.ВидРесурса 				= ВыборкаВидРесурса.ВидРесурса;
				СтрокаДерева.ЦенаТекущая				= ВыборкаРесурс.ЦенаТекущая;
				СтрокаДерева.ЦенаТекущаяЗМ				= ВыборкаРесурс.ЦенаТекущаяЗМ;
				СтрокаДерева.Стоимость					= ВыборкаРесурс.СтоимостьТекущая;
				СтрокаДерева.СтоимостьЗМ				= ВыборкаРесурс.СтоимостьТекущаяЗМ;
				СтрокаДерева.Количество					= ВыборкаРесурс.Количество;
				СтрокаДерева.Шифр						= ВыборкаРесурс.КодРесурса;
				СтрокаДерева.ЭтоНеучтенный				= ВыборкаРесурс.ЭтоНеучтенный;
				СтрокаДерева.ЭтоРесурс					= Истина;
				СтрокаДерева.Группировка 				= ВыборкаРесурс.НаименованиеРесурса;
				СтрокаДерева.Ресурс 					= ВыборкаРесурс.Ресурс;
				СтрокаДерева.ЕдиницаИзмеренияРесурса 	= ВыборкаРесурс.ЕдиницаИзмеренияРесурса;
				СтрокаДерева.Видимость				 	= Истина;
				
			КонецЦикла;
	
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоЗначений,"ДеревоРесурсов");
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаДерева(ТекДерево,ТекПроцент,СуммаРесурсов,СуммаГруппыВида)
	
	СуммаОтбора = 0;
	Для Каждого ТекСтрока Из ТекДерево.Строки Цикл
		Если ТекСтрока.ЭтоВидРесурса Тогда
			
			СтруктураОтбора = Новый Структура;
			СтруктураОтбора.Вставить("ВидРесурса",ТекСтрока.ВидРесурса);
			МассивСтрок = ЭтаФорма.ТаблицаРанжирования.НайтиСтроки(СтруктураОтбора);
			Если МассивСтрок.Количество() > 0 Тогда
				ТекПроцент = МассивСтрок[0].Процент;	
			КонецЕсли;
			
			СуммаГруппыВида	= ТекСтрока.Стоимость;
			СуммаРесурсов 	= ТекСтрока.Стоимость * ТекПроцент / 100; 
			ОбработкаДерева(ТекСтрока,ТекПроцент,СуммаРесурсов,СуммаГруппыВида);
		ИначеЕсли ТекСтрока.ЭтоГруппа Тогда
			СуммаГруппыВида	= ТекСтрока.Стоимость;
			СуммаРесурсов 	= ТекСтрока.Стоимость * ТекПроцент / 100;
			ОбработкаДерева(ТекСтрока,ТекПроцент,СуммаРесурсов,СуммаГруппыВида);
		ИначеЕсли ТекСтрока.ЭтоРесурс Тогда
			Если СуммаРесурсов > 0 Тогда
				Если СуммаОтбора < СуммаРесурсов Тогда
					ТекСтрока.ЭтоПредставитель = Истина;
					СуммаОтбора = СуммаОтбора + ТекСтрока.Стоимость;
				КонецЕсли;
			КонецЕсли;
			
			Если СуммаГруппыВида > 0 Тогда
				ТекСтрока.ПроцентРанжирования = ТекСтрока.Стоимость / СуммаГруппыВида * 100;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция РедактироватьЦеныНаСервере()
	
	МассивПозиций 	= СписокПозиций.ВыгрузитьЗначения(); 
	ТекДерево 		= РеквизитФормыВЗначение("ДеревоРесурсов");
	
	ТаблицаЗначенийРесурсы = Новый ТаблицаЗначений;
	ТаблицаЗначенийРесурсы.Колонки.Добавить("Ресурс");
	ТаблицаЗначенийРесурсы.Колонки.Добавить("НаименованиеРесурса");
	ТаблицаЗначенийРесурсы.Колонки.Добавить("КодРесурса");
	ТаблицаЗначенийРесурсы.Колонки.Добавить("ЦенаТекущая");
	ТаблицаЗначенийРесурсы.Колонки.Добавить("ЦенаТекущаяЗМ");
	ТаблицаЗначенийРесурсы.Колонки.Добавить("ЭтоНеучтенный");
	ТаблицаЗначенийРесурсы.Колонки.Добавить("ЕдиницаИзмеренияРесурса");

	ЗаполнитьТаблицуРесурсов(ТекДерево,ТаблицаЗначенийРесурсы);
		
	НачатьТранзакцию();

	// Записываем в документы.
	ОбновитьЦеныРесурсыСметы(ТаблицаЗначенийРесурсы,ЭтаФорма.ЛокальнаяСмета,МассивПозиций); 

	ЗафиксироватьТранзакцию(); 
	
	// Перерасчет документов.
	ДокументПерерасчетНаСервере(ЭтаФорма.ЛокальнаяСмета);

КонецФункции	

&НаСервере
Процедура ЗаполнитьТаблицуРесурсов(ТекДерево,ТаблицаЗначенийРесурсы)
	
	СуммаОтбора = 0;
	Для Каждого ТекСтрока Из ТекДерево.Строки Цикл
		Если ТекСтрока.ЭтоРесурс Тогда
			НоваяСтрока 						= ТаблицаЗначенийРесурсы.Добавить();
			НоваяСтрока.Ресурс 					= ТекСтрока.Ресурс;
			НоваяСтрока.НаименованиеРесурса 	= ТекСтрока.Группировка;
			НоваяСтрока.КодРесурса 				= ТекСтрока.Шифр;
			НоваяСтрока.ЦенаТекущая				= ТекСтрока.ЦенаНовая;
			НоваяСтрока.ЦенаТекущаяЗМ			= ТекСтрока.ЦенаНоваяЗМ;
			НоваяСтрока.ЭтоНеучтенный			= ТекСтрока.ЭтоНеучтенный;
			НоваяСтрока.ЕдиницаИзмеренияРесурса = ТекСтрока.ЕдиницаИзмеренияРесурса;
		Иначе	
			ЗаполнитьТаблицуРесурсов(ТекСтрока,ТаблицаЗначенийРесурсы);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

