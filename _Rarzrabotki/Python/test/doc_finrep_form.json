{
  "title": "Фінансовий звіт виробництва",
  "properties": { "autoTitle": false, "commandBarLocation": "Top" },
  "events": { "OnCreateAtServer": "ПриСозданииНаСервере", "OnOpen": "ПриОткрытии",
              "OnReadAtServer": "ПриЧтенииНаСервере" },
  "elements": [
    { "cmdBar": "ПанельДействий", "children": [
      { "button": "КнопкаРассчитать", "command": "Рассчитать", "title": "Розрахувати",
        "defaultButton": true, "representation": "Text" },
      { "button": "КнопкаЗаполнитьПодразделения", "command": "ЗаполнитьПодразделения",
        "title": "Заповнити підрозділи", "representation": "Text" },
      { "popup": "ПодменюПечать", "title": "Друк", "children": [
        { "button": "КнопкаПечатьОтчет", "command": "ПечатьОтчет", "title": "Фінансовий звіт" },
        { "button": "КнопкаПечатьОтчетРасш", "command": "ПечатьОтчетРасшифровка",
          "title": "Фінансовий звіт з розшифровкою" },
        { "button": "КнопкаПечатьДоклад", "command": "ПечатьДоклад", "title": "Доповідь" },
        { "button": "КнопкаПечатьДинамика", "command": "ПечатьДинамика", "title": "Динаміка" },
        { "button": "КнопкаСохранитьДоклад", "command": "СохранитьДокладHTML",
          "title": "Зберегти доповідь у HTML" },
        { "button": "КнопкаСохранитьДинамику", "command": "СохранитьДинамикуHTML",
          "title": "Зберегти динаміку в HTML" }
      ]}
    ]},

    { "group": "horizontal", "name": "ГруппаШапка", "children": [
      { "group": "vertical", "name": "ГруппаШапкаЛево", "children": [
        { "input": "ПолеНомер", "path": "Объект.Номер" },
        { "input": "ПолеДата", "path": "Объект.Дата" },
        { "input": "ПолеДатаРасчета", "path": "Объект.ДатаРасчета", "markIncomplete": true },
        { "input": "ПолеНачалоПериода", "path": "Объект.НачалоПериода" }
      ]},
      { "group": "vertical", "name": "ГруппаШапкаЦентр", "children": [
        { "input": "ПолеНаправление", "path": "Объект.Направление" },
        { "check": "ПолеЗаполнятьТолькоСДвижениями", "path": "Объект.ЗаполнятьТолькоСДвижениями" },
        { "input": "ПолеОрганизация", "path": "Объект.Организация" },
        { "input": "ПолеСтавкаНДС", "path": "Объект.СтавкаНДС" },
        { "check": "ПолеВключатьНепроведенные", "path": "Объект.ВключатьНепроведенные" },
        { "input": "ПолеСтатус", "path": "Объект.Статус", "readOnly": true }
      ]},
      { "group": "vertical", "name": "ГруппаШапкаПраво", "children": [
        { "input": "ПолеЗаголовокОтчета", "path": "Объект.ЗаголовокОтчета",
          "inputHint": "Заголовок друкованої форми (необов'язково)" },
        { "input": "ПолеОтветственный", "path": "Объект.Ответственный" },
        { "input": "ПолеДокументСравнения", "path": "Объект.ДокументСравнения",
          "inputHint": "Порожньо — підбереться автоматично при розрахунку" },
        { "labelField": "ПолеСостояние", "path": "СостояниеРасчета", "titleLocation": "none",
          "readOnly": true, "horizontalStretch": true }
      ]}
    ]},

    { "pages": "Страницы", "pagesRepresentation": "TabsOnTop", "children": [

      { "page": "СтраницаРасчет", "title": "Розрахунок", "children": [
        { "group": "horizontal", "name": "ГруппаКомандыПодразделений", "children": [
          { "button": "КнопкаЗаполнитьИзКазны", "command": "ЗаполнитьИзКазны",
            "title": "Заповнити", "type": "hyperlink" }
        ]},
        { "table": "Подразделения", "path": "Объект.Подразделения", "changeRowSet": true,
          "changeRowOrder": true, "height": 10, "columns": [
          { "check": "ПодразделенияВключать", "path": "Объект.Подразделения.Включать" },
          { "input": "ПодразделенияПодразделение", "path": "Объект.Подразделения.Подразделение" }
        ]},
        { "group": "vertical", "name": "ГруппаУточнения", "title": "Уточнення розрахунку",
          "showTitle": true, "representation": "weak", "children": [
          { "table": "ДоговорыДополнительно", "path": "Объект.ДоговорыДополнительно",
            "changeRowSet": true, "height": 4, "columns": [
            { "input": "ДопДогПодразделение", "path": "Объект.ДоговорыДополнительно.Подразделение" },
            { "input": "ДопДогДоговор", "path": "Объект.ДоговорыДополнительно.Договор" },
            { "input": "ДопДогКомментарий", "path": "Объект.ДоговорыДополнительно.Комментарий" }
          ]},
          { "table": "СчетаРасчетов", "path": "Объект.СчетаРасчетов", "changeRowSet": true,
            "height": 3, "columns": [
            { "input": "СчетаРасчетовСчет", "path": "Объект.СчетаРасчетов.Счет" }
          ]}
        ]}
      ]},

      { "page": "СтраницаКазна", "title": "Казна", "children": [
        { "table": "Казна", "path": "Объект.Казна", "readOnly": true, "height": 12, "columns": [
          { "input": "КазнаПодразделение", "path": "Объект.Казна.Подразделение" },
          { "input": "КазнаИмяВКазне", "path": "Объект.Казна.ИмяВКазне" },
          { "input": "КазнаПоступленияПлан", "path": "Объект.Казна.ПоступленияПлан" },
          { "input": "КазнаПоступленияФакт", "path": "Объект.Казна.ПоступленияФакт" },
          { "input": "КазнаЗатратыПлан", "path": "Объект.Казна.ЗатратыПлан" },
          { "input": "КазнаЗатратыФакт", "path": "Объект.Казна.ЗатратыФакт" },
          { "input": "КазнаМаржаПлан", "path": "Объект.Казна.МаржаПлан" },
          { "input": "КазнаМаржаФакт", "path": "Объект.Казна.МаржаФакт" }
        ]},
        { "group": "vertical", "name": "ГруппаИсключенияКазны",
          "title": "Статті-виключення (за найменуванням у казні)", "showTitle": true,
          "representation": "weak", "children": [
          { "table": "СтатьиИсключенияКазны", "path": "Объект.СтатьиИсключенияКазны",
            "changeRowSet": true, "height": 5, "columns": [
            { "input": "ИсключенияСтатья", "path": "Объект.СтатьиИсключенияКазны.Статья",
              "horizontalStretch": true }
          ]}
        ]}
      ]},

      { "page": "СтраницаРезультат", "title": "Результат", "children": [
        { "table": "Расчет", "path": "Объект.Расчет", "readOnly": true, "height": 16,
          "on": ["OnActivateRow"], "columns": [
          { "input": "РасчетПодразделение", "path": "Объект.Расчет.Подразделение" },
          { "input": "РасчетКонтрагент", "path": "Объект.Расчет.Контрагент" },
          { "input": "РасчетДоговор", "path": "Объект.Расчет.Договор" },
          { "input": "РасчетПримечание", "path": "Объект.Расчет.Примечание" },
          { "input": "РасчетВыполненныеРаботы", "path": "Объект.Расчет.ВыполненныеРаботы" },
          { "input": "РасчетОплачено", "path": "Объект.Расчет.Оплачено" },
          { "input": "РасчетЗадолженность", "path": "Объект.Расчет.Задолженность" },
          { "input": "РасчетАктыПоданные", "path": "Объект.Расчет.АктыПоданные" },
          { "input": "РасчетАктыНепроведенные", "path": "Объект.Расчет.АктыПоданныеНепроведенные" },
          { "input": "РасчетГарантийныеПлатежи", "path": "Объект.Расчет.ГарантийныеПлатежи" },
          { "input": "РасчетНДС", "path": "Объект.Расчет.НДСНезарегистрированный" },
          { "input": "РасчетИтогоКПолучению", "path": "Объект.Расчет.ИтогоКПолучению" },
          { "input": "РасчетСальдо361", "path": "Объект.Расчет.Сальдо361" }
        ]}
      ]},

      { "page": "СтраницаРасшифровка", "title": "Розшифровка", "children": [
        { "group": "horizontal", "name": "ГруппаФильтрРасшифровки", "children": [
          { "input": "ПолеФильтрПодразделение", "path": "ФильтрПодразделениеРасшифровки",
            "on": ["OnChange"], "title": "Підрозділ" },
          { "button": "КнопкаСбросФильтра", "command": "СбросФильтраРасшифровки",
            "title": "Показати всі", "type": "hyperlink" }
        ]},
        { "table": "РасшифровкаДокументов", "path": "Объект.РасшифровкаДокументов",
          "readOnly": true, "height": 16, "on": ["Selection"], "columns": [
          { "input": "РасшПодразделение", "path": "Объект.РасшифровкаДокументов.Подразделение" },
          { "input": "РасшКонтрагент", "path": "Объект.РасшифровкаДокументов.Контрагент" },
          { "input": "РасшДоговор", "path": "Объект.РасшифровкаДокументов.Договор" },
          { "input": "РасшДокумент", "path": "Объект.РасшифровкаДокументов.Документ" },
          { "input": "РасшДатаДокумента", "path": "Объект.РасшифровкаДокументов.ДатаДокумента" },
          { "input": "РасшВид", "path": "Объект.РасшифровкаДокументов.Вид" },
          { "check": "РасшПроведен", "path": "Объект.РасшифровкаДокументов.ДокументПроведен" },
          { "check": "РасшОригинал", "path": "Объект.РасшифровкаДокументов.Оригинал" },
          { "input": "РасшСуммаДт", "path": "Объект.РасшифровкаДокументов.СуммаДт" },
          { "input": "РасшСуммаКт", "path": "Объект.РасшифровкаДокументов.СуммаКт" }
        ]}
      ]},

      { "page": "СтраницаКонтроль", "title": "Контроль", "children": [
        { "table": "Контроль", "path": "Объект.Контроль", "readOnly": true, "height": 18,
          "columns": [
          { "input": "КонтрольУровень", "path": "Объект.Контроль.Уровень" },
          { "input": "КонтрольКод", "path": "Объект.Контроль.КодЗамечания" },
          { "input": "КонтрольПодразделение", "path": "Объект.Контроль.Подразделение" },
          { "input": "КонтрольТекст", "path": "Объект.Контроль.Текст", "horizontalStretch": true }
        ]}
      ]},

      { "page": "СтраницаКомментарий", "title": "Коментар", "children": [
        { "input": "ПолеКомментарий", "path": "Объект.Комментарий", "multiLine": true,
          "height": 6, "titleLocation": "none", "horizontalStretch": true }
      ]}
    ]}
  ],

  "attributes": [
    { "name": "Объект", "type": "DocumentObject.А_ФинансовыйОтчетПроизводства", "main": true },
    { "name": "СостояниеРасчета", "type": "string(300)" },
    { "name": "ФильтрПодразделениеРасшифровки", "type": "CatalogRef.Подразделения" }
  ],

  "commands": [
    { "name": "Рассчитать", "action": "Рассчитать", "title": "Розрахувати" },
    { "name": "ЗаполнитьПодразделения", "action": "ЗаполнитьПодразделения",
      "title": "Заповнити підрозділи" },
    { "name": "ПечатьОтчет", "action": "ПечатьОтчет", "title": "Фінансовий звіт" },
    { "name": "ПечатьОтчетРасшифровка", "action": "ПечатьОтчетРасшифровка",
      "title": "Фінансовий звіт з розшифровкою" },
    { "name": "ПечатьДоклад", "action": "ПечатьДоклад", "title": "Доповідь" },
    { "name": "ПечатьДинамика", "action": "ПечатьДинамика", "title": "Динаміка" },
    { "name": "СохранитьДокладHTML", "action": "СохранитьДокладHTML",
      "title": "Зберегти доповідь у HTML" },
    { "name": "СохранитьДинамикуHTML", "action": "СохранитьДинамикуHTML",
      "title": "Зберегти динаміку в HTML" },
    { "name": "СбросФильтраРасшифровки", "action": "СбросФильтраРасшифровки",
      "title": "Показати всі" },
    { "name": "ЗаполнитьИзКазны", "action": "ЗаполнитьИзКазны", "title": "Заповнити" }
  ]
}
