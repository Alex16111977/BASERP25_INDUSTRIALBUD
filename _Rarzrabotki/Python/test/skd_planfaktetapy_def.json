{
  "dataSets": [{
    "name": "Данные",
    "objectName": "Данные",
    "fields": [
      "Этап: CatalogRef.ЭтапыРабот @dimension",
      "ОбщееНазвание: CatalogRef.ОбщиеНазванияНоменклатуры @dimension",
      "Номенклатура: CatalogRef.Номенклатура @dimension",
      "ЕдиницаЕдина: string",
      "Остаток: decimal(15,3)",
      "НормаНоменкл: decimal(15,3)",
      "ВНорме: decimal(15,3)",
      "ПонадНорму: decimal(15,3)",
      "Экономия: decimal(15,3)",
      "ВНормеСумма: decimal(15,2)",
      "ПонадНормуСумма: decimal(15,2)",
      "ЕкономіяСума: decimal(15,2)",
      "НормаСуммаНоменкл: decimal(15,2)",
      "СуммаОстатка: decimal(15,2)"
    ]
  }],
  "calculatedFields": [
    {"field": "РизницяСС", "title": "Різниця ( + економія, - перевитрата )", "expression": "НормаСуммаНоменкл - СуммаОстатка"},
    {"field": "ПроцВиконанняСС", "title": "% вик. СС", "expression": "Окр(ВЫБОР КОГДА НормаСуммаНоменкл = 0 ТОГДА 0 ИНАЧЕ СуммаОстатка / НормаСуммаНоменкл * 100 КОНЕЦ, 1)"}
  ],
  "totalFields": [
    {"dataPath": "ЕдиницаЕдина", "expression": "Максимум(ЕдиницаЕдина)"},
    {"dataPath": "Остаток", "expression": "Сумма(Остаток)"},
    {"dataPath": "НормаНоменкл", "expression": "Сумма(НормаНоменкл)"},
    {"dataPath": "ВНорме", "expression": "Сумма(ВНорме)"},
    {"dataPath": "ПонадНорму", "expression": "Сумма(ПонадНорму)"},
    {"dataPath": "Экономия", "expression": "Сумма(Экономия)"},
    {"dataPath": "ВНормеСумма", "expression": "Сумма(ВНормеСумма)"},
    {"dataPath": "ПонадНормуСумма", "expression": "Сумма(ПонадНормуСумма)"},
    {"dataPath": "ЕкономіяСума", "expression": "Сумма(ЕкономіяСума)"},
    {"dataPath": "НормаСуммаНоменкл", "expression": "Сумма(НормаСуммаНоменкл)"},
    {"dataPath": "СуммаОстатка", "expression": "Сумма(СуммаОстатка)"},
    {"dataPath": "РизницяСС", "expression": "Сумма(НормаСуммаНоменкл) - Сумма(СуммаОстатка)"},
    {"dataPath": "ПроцВиконанняСС", "expression": "Окр(ВЫБОР КОГДА Сумма(НормаСуммаНоменкл) = 0 ТОГДА 0 ИНАЧЕ Сумма(СуммаОстатка) / Сумма(НормаСуммаНоменкл) * 100 КОНЕЦ, 1)"}
  ],
  "settingsVariants": [{
    "name": "Основной",
    "title": "Аналіз залишків для списання за СС з етапами",
    "settings": {
      "selection": ["Остаток", "ЕдиницаЕдина", "НормаНоменкл", "ВНорме", "ПонадНорму", "Экономия", "ВНормеСумма", "ПонадНормуСумма", "ЕкономіяСума", "НормаСуммаНоменкл", "СуммаОстатка", "РизницяСС", "ПроцВиконанняСС"],
      "outputParameters": {"Заголовок": "Аналіз залишків для списання за СС з етапами"},
      "conditionalAppearance": [
        {"filter": ["СуммаОстатка > 0"], "appearance": {"ЦветФона": "#E2EFDA"}, "presentation": "В межах норми"},
        {"filter": ["ПонадНормуСумма > 0"], "appearance": {"ЦветФона": "#FFE699", "ЦветТекста": "#843C0C"}, "presentation": "Перевитрата (понад норму)"}
      ],
      "structure": [
        {"groupFields": ["Этап"], "children": [
          {"groupFields": ["ОбщееНазвание"], "children": [
            {"groupFields": ["Номенклатура"]}
          ]}
        ]}
      ]
    }
  }]
}
