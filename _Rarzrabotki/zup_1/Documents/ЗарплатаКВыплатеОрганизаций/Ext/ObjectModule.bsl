		|                           ТОГДА  Окончания.Период
		|                       ИНАЧЕ  КОНЕЦПЕРИОДА(&парамНачало, МЕСЯЦ)							// непоняная ситуация, но поставим конец месяца
		|				КОНЕЦ";
		ТекстЗапроса = "
		|	ВЫБРАТЬ РАЗРЕШЕННЫЕ
