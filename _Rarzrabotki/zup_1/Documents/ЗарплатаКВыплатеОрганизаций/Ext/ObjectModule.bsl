			Строка.ПериодВзаиморасчетов	= Выборка.ПериодВзаиморасчетов;
			Строка.СчетУчета			= Выборка.СчетУчета;
			Строка.Сумма			= Выборка.Сумма - тСуммаОкругления;
			Строка.СуммаОкругления	= 0;
			
		КонецЦикла;
		
	КонецЦикла;
	
