		|		ПлановыеУдержания.Показатель3,
		|		ПлановыеУдержания.Показатель4,
		|		ПлановыеУдержания.Показатель5,
		|		ПлановыеУдержания.Показатель6,
		|		ПлановыеУдержания.Валюта1,
