		СтрокаРаботники.СуммаОкругления	= 0;
		СтрокаРаботники.СуммаГрязными	= ВыборкаСотрудник.Сумма;
		
		СтрокаРаботники.ВыплаченностьЗарплаты = Перечисления.ВыплаченностьЗарплаты.Выплачено;
