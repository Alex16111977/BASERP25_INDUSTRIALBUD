		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			СоздатьСтрокуРасчетСреднегоДляПособия(ПланыВидовРасчета.СреднийЗаработок.ПоЗаработку, 1, Выборка.БазовыйПериодНачало, Выборка.БазовыйПериодКонец);
			Если мЕстьПремии  Тогда
				СоздатьСтрокуРасчетСреднегоДляПособия(ПланыВидовРасчета.СреднийЗаработок.ПоПремиям, 0, Выборка.БазовыйПериодНачало, Выборка.БазовыйПериодКонец);
				СоздатьСтрокуРасчетСреднегоДляПособия(ПланыВидовРасчета.СреднийЗаработок.ПоФиксПремиям, 0, Выборка.БазовыйПериодНачало, Выборка.БазовыйПериодКонец);
			КонецЕсли;
			Если мЕстьГодоваяПремия Тогда
				СоздатьСтрокуРасчетСреднегоДляПособия(ПланыВидовРасчета.СреднийЗаработок.ПоГодовойПремии, 0, Выборка.БазовыйПериодНачало, Выборка.БазовыйПериодКонец);
			КонецЕсли;
			
		КонецЦикла;

	КонецЕсли;
	
	Записать();
	
КонецФункции  // АвтозаполнениеРасчетСреднегоДляПособия()

Функция РассчитатьРасчетСреднегоДляПособия(КомментироватьРасчет = Ложь) Экспорт
	
	// очистить расчитываемые поля в ТЧ РасчетСреднего
	Для каждого ТекущаяСтрока Из РасчетСреднегоДляПособия Цикл
		
		Если ТекущаяСтрока.Авторасчет Тогда
			ТекущаяСтрока.Результат = 0;
			ТекущаяСтрока.РезультатПолный = 0;
			
			ТекущаяСтрока.ОтработаноДней = 0;
			ТекущаяСтрока.ОтработаноЧасов = 0;
			ТекущаяСтрока.КалендарныеДни = 0;
			ТекущаяСтрока.НормаДней = 0;
			ТекущаяСтрока.НормаЧасов = 0;
		КонецЕсли;
		
	КонецЦикла;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПревышениеПремии", Ложь);
	КопияРасчетСреднего = РасчетСреднегоДляПособия.Выгрузить();
	ИзмКопияРасчетСреднего = КопияРасчетСреднего.Скопировать(Отбор);
	РасчетСреднегоДляПособия.Загрузить(ИзмКопияРасчетСреднего);
	
	Записать();
	Если ДатаУвольнения < ПроведениеРасчетов.ДатаИзмененияПорядка100() Тогда

		// 1. Если расчет по Окладу
		//
		Если  РасчетСреднегоДляПособия.Количество() > 0 И РасчетСреднегоДляПособия[0].ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоОкладу Тогда
			
			ПараметрыОклада = ПроведениеРасчетов.ПолучитьПараметыОклада(ПериодРасчетаСреднегоКонец, Сотрудник);
			РасчетСреднегоДляПособия[0].Результат			= ПараметрыОклада["Оклад"];
			РасчетСреднегоДляПособия[0].ОтработаноДней	= ПараметрыОклада["НормаДней"];
			РасчетСреднегоДляПособия[0].ОтработаноЧасов	= ПараметрыОклада["НормаЧасов"];
			РасчетСреднегоДляПособия[0].КалендарныеДни	= ПараметрыОклада["КалендарныеДни"];
			
			РасчитатьСреднююДляПособия();
			Записать();
			Возврат Истина;
			
		КонецЕсли;
		
		// 2. Стандартный расчет
	    //
		НачатьТранзакцию();
		Прочитать();
		ВыборкаПоСредним = СформироватьЗапросПоРасчетСреднегоДляПособия().Выбрать();
		ЗафиксироватьТранзакцию();
		
		// Создадим рабочие наборы записей
		Отказ = Ложь;
		НаборСредних = РегистрыРасчета.РасчетСреднегоЗаработка.СоздатьНаборЗаписей();
		НаборСредних.Отбор.Регистратор.Значение = Ссылка;
		Пока ВыборкаПоСредним.Следующий() Цикл
			
			ПроверитьЗаполнениеСтрокиРасчетСреднегоДляПособия(ВыборкаПоСредним, Отказ);
			Если НЕ Отказ Тогда
				// Заполним записи в наборах записей регистров
				ДобавитьСтрокуРасчетаСреднегоДляПособия(ВыборкаПоСредним, НаборСредних);
			КонецЕсли;
			
		КонецЦикла;
		НаборСредних.Записать();
		
		Если Отказ Тогда
			
			// Если есть какие-то проблемы - удаляем движения (тут нет транзакции) 
			// Удаляем движения
			НаборСредних.Очистить();
			НаборСредних.Записать();
			
			Возврат Не Отказ;
			
		КонецЕсли;
		
		
		ОсновнойВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоЗаработку;
		КоэфПовышенияОкладов = 1;
		тКоэффициентПовышенияОкладов = 1;
		
		ДанныеДляСредней = ПроведениеРасчетов.РассчитатьСреднююПорядок100(Ссылка,КомментироватьРасчет); 
		Выборка = ДанныеДляСредней.Выборка.Выбрать();  
		
		Если КомментироватьРасчет Тогда
			
			табБазаСКомментариями = Новый ТаблицаЗначений;
			табБазаСКомментариями.Колонки.Добавить("НомерСтроки",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("Авторасчет",Новый ОписаниеТипов("Булево"));
			табБазаСКомментариями.Колонки.Добавить("ВидРасчета",Новый ОписаниеТипов("ПланВидовРасчетаСсылка.СреднийЗаработок"));
			табБазаСКомментариями.Колонки.Добавить("ВидРасчетаРазрез",Новый ОписаниеТипов("ПланВидовРасчетаСсылка.ОсновныеНачисленияОрганизаций"));
			табБазаСКомментариями.Колонки.Добавить("БазовыйПериодНачало",Новый ОписаниеТипов("Дата"));
			табБазаСКомментариями.Колонки.Добавить("БазовыйПериодКонец",Новый ОписаниеТипов("Дата"));
			табБазаСКомментариями.Колонки.Добавить("КоэффициентПовышенияОкладов",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("УсловиеБольшеНуля",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("Результат",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("Результат1",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("РезультатПолный",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("ОтработаноДней",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("ОтработаноЧасов",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("ОтработаноДнейБаза",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("ОтработаноЧасовБаза",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("НормаДней",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("НормаЧасов",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("НормаДнейБаза",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("НормаЧасовБаза",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("КалендарныеДни",Новый ОписаниеТипов("Число"));
			
			Пока Выборка.Следующий() Цикл
				
				табНоваяСтрока = табБазаСКомментариями.Добавить();
				табНоваяСтрока.НомерСтроки = Выборка.НомерСтроки;
				табНоваяСтрока.Авторасчет = Выборка.Авторасчет;
				табНоваяСтрока.ВидРасчета = Выборка.ВидРасчета;
				табНоваяСтрока.ВидРасчетаРазрез = Выборка.ВидРасчетаРазрез;
	    		табНоваяСтрока.БазовыйПериодНачало = Выборка.БазовыйПериодНачало;
				табНоваяСтрока.БазовыйПериодКонец = Выборка.БазовыйПериодКонец;
				табНоваяСтрока.КоэффициентПовышенияОкладов = Выборка.КоэффициентПовышенияОкладов;
				табНоваяСтрока.УсловиеБольшеНуля = Выборка.УсловиеБольшеНуля;
				табНоваяСтрока.Результат = Выборка.Результат;
				табНоваяСтрока.Результат1 = Выборка.Результат1;
				табНоваяСтрока.РезультатПолный = Выборка.РезультатПолный;
				табНоваяСтрока.ОтработаноДней = Выборка.ОтработаноДней;
				табНоваяСтрока.ОтработаноЧасов = Выборка.ОтработаноЧасов;
				табНоваяСтрока.ОтработаноДнейБаза = Выборка.ОтработаноДнейБаза;
				табНоваяСтрока.ОтработаноЧасовБаза = Выборка.ОтработаноЧасовБаза;
				табНоваяСтрока.НормаДней = Выборка.НормаДней;
				табНоваяСтрока.НормаЧасов = Выборка.НормаЧасов;
				табНоваяСтрока.НормаДнейБаза = Выборка.НормаДнейБаза;
				табНоваяСтрока.НормаЧасовБаза = Выборка.НормаЧасовБаза;
				табНоваяСтрока.КалендарныеДни = Выборка.КалендарныеДни;
				
			КонецЦикла;	
			
			Выборка.Сбросить();
			
			Запрос = Новый Запрос;
			МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			
			ТекстЗапроса = "ВЫБРАТЬ
			|	БазаСКомментариями.НомерСтроки КАК НомерСтроки,
			|	БазаСКомментариями.Авторасчет КАК Авторасчет,
			|	БазаСКомментариями.ВидРасчета КАК ВидРасчета,
			|	БазаСКомментариями.БазовыйПериодНачало КАК БазовыйПериодНачало,
			|	БазаСКомментариями.БазовыйПериодКонец КАК БазовыйПериодКонец,
			|	БазаСКомментариями.КоэффициентПовышенияОкладов КАК КоэффициентПовышенияОкладов,
			|	БазаСКомментариями.УсловиеБольшеНуля КАК УсловиеБольшеНуля,
			|	БазаСКомментариями.Результат КАК Результат,
			|	БазаСКомментариями.Результат1 КАК Результат1,
			|	БазаСКомментариями.РезультатПолный КАК РезультатПолный,
			|	БазаСКомментариями.ОтработаноДней КАК ОтработаноДней,
			|	БазаСКомментариями.ОтработаноЧасов КАК ОтработаноЧасов,
			|	БазаСКомментариями.ОтработаноДнейБаза КАК ОтработаноДнейБаза,
			|	БазаСКомментариями.ОтработаноЧасовБаза КАК ОтработаноЧасовБаза,
			|	БазаСКомментариями.НормаДней КАК НормаДней,
			|	БазаСКомментариями.НормаЧасов КАК НормаЧасов,
			|	БазаСКомментариями.НормаДнейБаза КАК НормаДнейБаза,
			|	БазаСКомментариями.НормаЧасовБаза КАК НормаЧасовБаза,
			|	БазаСКомментариями.КалендарныеДни КАК КалендарныеДни
			|ПОМЕСТИТЬ ВТБазаСреднего
			|ИЗ
			|	&табБазаСКомментариями КАК БазаСКомментариями
			|
			|ИНДЕКСИРОВАТЬ ПО НомерСтроки
			|";
			
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("табБазаСКомментариями",табБазаСКомментариями);
			Запрос.Выполнить();
			
			ТекстЗапроса = "ВЫБРАТЬ
			|	БазаСКомментариями.НомерСтроки КАК НомерСтроки,
			|	БазаСКомментариями.Авторасчет КАК Авторасчет,
			|	БазаСКомментариями.ВидРасчета КАК ВидРасчета,
			|	БазаСКомментариями.БазовыйПериодНачало КАК БазовыйПериодНачало,
			|	БазаСКомментариями.БазовыйПериодКонец КАК БазовыйПериодКонец,
			|	БазаСКомментариями.КоэффициентПовышенияОкладов КАК КоэффициентПовышенияОкладов,
			|	БазаСКомментариями.УсловиеБольшеНуля КАК УсловиеБольшеНуля,
			|	СУММА(БазаСКомментариями.Результат) КАК Результат,
			|	БазаСКомментариями.Результат1 КАК Результат1,
			|	СУММА(БазаСКомментариями.РезультатПолный) КАК РезультатПолный,
			|	МАКСИМУМ(БазаСКомментариями.ОтработаноДней) КАК ОтработаноДней,
			|	МАКСИМУМ(БазаСКомментариями.ОтработаноЧасов) КАК ОтработаноЧасов,
			|	МАКСИМУМ(БазаСКомментариями.НормаДней) КАК НормаДней,
			|	МАКСИМУМ(БазаСКомментариями.НормаЧасов) КАК НормаЧасов,
			|	МАКСИМУМ(БазаСКомментариями.КалендарныеДни) КАК КалендарныеДни
			|ИЗ
			|	ВТБазаСреднего КАК БазаСКомментариями
			|
			|СГРУППИРОВАТЬ ПО
			|	БазаСКомментариями.НомерСтроки,
			|	БазаСКомментариями.Авторасчет,
			|	БазаСКомментариями.ВидРасчета,
			|	БазаСКомментариями.БазовыйПериодНачало,
			|	БазаСКомментариями.БазовыйПериодКонец,
			|	БазаСКомментариями.КоэффициентПовышенияОкладов,
			|	БазаСКомментариями.УсловиеБольшеНуля,
			|	БазаСКомментариями.Результат1
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки УБЫВ";
			
			Запрос.Текст = ТекстЗапроса;
			Выборка = Запрос.Выполнить().Выбрать();
			
			КомментарийРасчетаСредней = ОбщегоНазначения.КомментарийРасчета(НСтр("ru='Расчет средней с ';uk='Розрахунок середньої з '") + Формат(ПериодРасчетаСреднегоНачало,"ДФ='МММ гггг'")+ НСтр("ru=' по ';uk='до '") + Формат(ПериодРасчетаСреднегоКонец,"ДФ='МММ гггг'"));
			
			мКоэффициентПовышенияОкладов = 1;
			ПериодИзмененияКоэффициента = Формат(ПериодРасчетаСреднегоКонец,"ДФ='МММ гггг'"); 
			ТаблицаКомментариев = Новый ТаблицаЗначений;
			ТаблицаКомментариев.Колонки.Добавить("НомерСтроки");
			ТаблицаКомментариев.Колонки.Добавить("ВидРасчета");
			ТаблицаКомментариев.Колонки.Добавить("БазовыйПериод");
			ТаблицаКомментариев.Колонки.Добавить("БазовыеНачисления");
			ТаблицаКомментариев.Колонки.Добавить("МассивРасшифровок");
			ТаблицаКомментариев.Колонки.Добавить("ОтработаноДней");
			ТаблицаКомментариев.Колонки.Добавить("мКоэффициентПовышенияОкладов");
			ТаблицаКомментариев.Колонки.Добавить("Коэффициент");
			ТаблицаКомментариев.Колонки.Добавить("ФормулаСКоэффициентом");
			ТаблицаКомментариев.Колонки.Добавить("ФормулаПропорционально");
			ТаблицаКомментариев.Колонки.Добавить("ПериодИзмененияКоэффициента");
		КонецЕсли;	
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ВидРасчета = ОсновнойВидРасчета Тогда
				КоэфПовышенияОкладов = КоэфПовышенияОкладов * тКоэффициентПовышенияОкладов;
				тКоэффициентПовышенияОкладов = Выборка.КоэффициентПовышенияОкладов;
				Если КомментироватьРасчет Тогда
					Если тКоэффициентПовышенияОкладов <> 1 И мКоэффициентПовышенияОкладов = 1 Тогда
						мКоэффициентПовышенияОкладов = тКоэффициентПовышенияОкладов;
						ПериодИзмененияКоэффициента = Выборка.БазовыйПериодНачало;
						ТекстКомментарияКоэффициента = НСтр("ru='Коэффициент повышения оклада = ';uk='Коефіцієнт підвищення окладу = '") + мКоэффициентПовышенияОкладов;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТабличнойЧасти = РасчетСреднегоДляПособия.Получить( Выборка.НомерСтроки - 1 );
			
			Если НЕ СтрокаТабличнойЧасти.Авторасчет Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТабличнойЧасти.Результат				= Выборка.Результат * КоэфПовышенияОкладов;
			СтрокаТабличнойЧасти.РезультатПолный		= Выборка.РезультатПолный;
			
			СтрокаТабличнойЧасти.ОтработаноДней			= Выборка.ОтработаноДней;
			СтрокаТабличнойЧасти.ОтработаноЧасов		= Выборка.ОтработаноЧасов;
			Если ВидУчетаВремениДляСредней = Перечисления.ВидыУчетаВремениДляСредней.ПоКалендарнымДнямСПраздниками
				И СтрокаТабличнойЧасти.ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоЗаработку Тогда
				СтрокаТабличнойЧасти.КалендарныеДни		= 1 + День(Выборка.БазовыйПериодКонец) - День(Выборка.БазовыйПериодНачало);
			Иначе
				СтрокаТабличнойЧасти.КалендарныеДни		= Выборка.КалендарныеДни;
			КонецЕсли;
			СтрокаТабличнойЧасти.НормаДней				= Выборка.НормаДней;
			СтрокаТабличнойЧасти.НормаЧасов				= Выборка.НормаЧасов;
			Если КомментироватьРасчет Тогда
				СтруктураПоиска = Новый Структура("НомерСтроки,ВидРасчета");
				СтруктураПоиска.ВидРасчета = СтрокаТабличнойЧасти.ВидРасчета;
				СтруктураПоиска.НомерСтроки = СтрокаТабличнойЧасти.НомерСтроки;
				
				МассивРасшифровок = Новый Массив;
				
				ТекстКомментарийБазовыеНачисления = НСтр("ru='	Базовые начисления составили: ';uk='	Базові нарахування склали: '") + ОКР(Выборка.Результат,2,0);
				МассивКомментарии = табБазаСКомментариями.НайтиСтроки(СтруктураПоиска);
				
				Для Каждого СтрокаМассиваКомментарии из МассивКомментарии Цикл
					ТекстКомментария = ""; 
					ТекстКомментарияОтработанноеВремя = "";
					ТекстКомментарияФормулаПропорционально = "";
					Если СтрокаМассиваКомментарии.ОтработаноДней <> 0 Тогда
						ТекстКомментарияОтработанноеВремя = НСтр("ru='Отработано: дней - ';uk='Відпрацьовано: днів - '") +  СтрокаМассиваКомментарии.ОтработаноДней + НСтр("ru=', часов - ';uk=', годин - '") + СтрокаМассиваКомментарии.ОтработаноЧасов
					КонецЕсли;	
					Если Выборка.Результат <> 0 и СтрокаМассиваКомментарии.Результат <> 0 Тогда
						Если Выборка.ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоГодовойПремии Тогда
							ТекстКомментария = НСтр("ru='Годовая премия';uk='Річна премія'") + ": " + ОКР(СтрокаМассиваКомментарии.Результат,2,0);
						Иначе	
							ТекстКомментария = СтрокаМассиваКомментарии.ВидРасчетаРазрез.Наименование + ": " + ОКР(СтрокаМассиваКомментарии.Результат,2,0)
						КонецЕсли;	
						МассивРасшифровок.Добавить(ТекстКомментария);
					КонецЕсли;
					Если (Выборка.Результат <> Выборка.РезультатПолный) И (Выборка.ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоФиксПремиямОтпуска) И 
						(СтрокаМассиваКомментарии.Результат1 = 2 ИЛИ СтрокаМассиваКомментарии.Результат1 = 1) И (СтрокаМассиваКомментарии.УсловиеБольшеНуля = 1)
						Тогда
						Если ВидУчетаВремениДляСредней  = Перечисления.ВидыУчетаВремениДляСредней.ПоРабочимЧасам Тогда 
							ТекстКомментарияФормулаПропорционально = "" + СтрокаМассиваКомментарии.РезультатПолный + "*" + "(" + СтрокаМассиваКомментарии.ОтработаноЧасовБаза + "/" + СтрокаМассиваКомментарии.НормаЧасовБаза + ")"; 	
						Иначе
							ТекстКомментарияФормулаПропорционально = "" + СтрокаМассиваКомментарии.РезультатПолный + "*" + "(" + СтрокаМассиваКомментарии.ОтработаноДнейБаза + "/" + СтрокаМассиваКомментарии.НормаДнейБаза + ")"; 	
						КонецЕсли;	
					КонецЕсли	
				КонецЦикла;
				Если мКоэффициентПовышенияОкладов <> 1 И Выборка.БазовыйПериодНачало < ПериодИзмененияКоэффициента Тогда
					ТекстКомментарияФормулаСКоэффициентом = НСтр("ru='Результат: ';uk='Результат: '") + Выборка.РезультатПолный + "*" + мКоэффициентПовышенияОкладов + " = " + ОКР(мКоэффициентПовышенияОкладов * Выборка.Результат,2,0);
				КонецЕсли;
				
				Если Выборка.Результат <> 0 Тогда
					НоваяСтрока = ТаблицаКомментариев.Добавить();
					НоваяСтрока.НомерСтроки = Выборка.НомерСтроки;
					НоваяСтрока.ВидРасчета = Выборка.ВидРасчета;
					НоваяСтрока.БазовыйПериод = Выборка.БазовыйПериодНачало;
					НоваяСтрока.БазовыеНачисления = ТекстКомментарийБазовыеНачисления;
					НоваяСтрока.МассивРасшифровок = МассивРасшифровок;
					НоваяСтрока.ОтработаноДней = ТекстКомментарияОтработанноеВремя;
					НоваяСтрока.мКоэффициентПовышенияОкладов = мКоэффициентПовышенияОкладов;
					Если мКоэффициентПовышенияОкладов <> 1 И Выборка.БазовыйПериодНачало < ПериодИзмененияКоэффициента Тогда
	               		НоваяСтрока.Коэффициент = ТекстКомментарияКоэффициента;
						НоваяСтрока.ФормулаСКоэффициентом = ТекстКомментарияФормулаСКоэффициентом;
						НоваяСтрока.ПериодИзмененияКоэффициента = ПериодИзмененияКоэффициента;
					КонецЕсли;
					НоваяСтрока.ФормулаПропорционально = ТекстКомментарияФормулаПропорционально;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		Если КомментироватьРасчет Тогда
			
			ТаблицаКомментариев.Сортировать("НомерСтроки Возр");
			
			Для Каждого СтрокаКомментария из ТаблицаКомментариев Цикл
				КомментарийНомерСтроки = ОбщегоНазначения.КомментарийРасчета(НСтр("ru='Номер строки: ';uk='Номер рядка: '") + СтрокаКомментария.НомерСтроки, КомментарийРасчетаСредней);
				КомментарийВидаРасчета = ОбщегоНазначения.КомментарийРасчета(НСтр("ru='	Вид расчета: ';uk='	Вид розрахунку: '") +  СтрокаКомментария.ВидРасчета, КомментарийНомерСтроки);
				ОбщегоНазначения.КомментарийРасчета(НСтр("ru='	Базовый период: ';uk='	Базовий період: '") + Формат(СтрокаКомментария.БазовыйПериод,"ДФ='МММ гггг'"), КомментарийВидаРасчета);
				КомментарийБазовыеНачисления = ОбщегоНазначения.КомментарийРасчета(СтрокаКомментария.БазовыеНачисления, КомментарийВидаРасчета,,,,Ложь);
				Если СтрокаКомментария.МассивРасшифровок.Количество() > 0 Тогда
					Для Каждого СтрокаМассива из СтрокаКомментария.МассивРасшифровок Цикл
						КомментарийВидаРасчетаРазрез = ОбщегоНазначения.КомментарийРасчета(СтрокаМассива,КомментарийБазовыеНачисления,,,,Ложь)	
					КонецЦикла;	
				КонецЕсли;
				Если СтрокаКомментария.мКоэффициентПовышенияОкладов <> 1 Тогда
					Если СтрокаКомментария.ПериодИзмененияКоэффициента <> Неопределено И СтрокаКомментария.ПериодИзмененияКоэффициента > СтрокаКомментария.БазовыйПериод Тогда
						КомментарийКоэффициент = ОбщегоНазначения.КомментарийРасчета(СтрокаКомментария.Коэффициент,КомментарийВидаРасчета,,,,Ложь);
						ОбщегоНазначения.КомментарийРасчета(СтрокаКомментария.ФормулаСКоэффициентом,КомментарийКоэффициент);
					КонецЕсли;
				КонецЕсли;
				Если СтрокаКомментария.ВидРасчета = ОсновнойВидРасчета и СтрокаКомментария.ОтработаноДней <> "" Тогда
					ОбщегоНазначения.КомментарийРасчета(СтрокаКомментария.ОтработаноДней,КомментарийВидаРасчета);		
				КонецЕсли;
				Если СтрокаКомментария.ФормулаПропорционально <> "" Тогда
					ОбщегоНазначения.КомментарийРасчета(СтрокаКомментария.ФормулаПропорционально,КомментарийВидаРасчетаРазрез);		
				КонецЕсли;
			КонецЦикла;	
			
		КонецЕсли;
	Иначе
		// 1. Если расчет по Окладу
		//
		Если  РасчетСреднегоДляПособия.Количество() > 0 И РасчетСреднегоДляПособия[0].ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоОкладу Тогда
			
			ПараметрыОклада = ПроведениеРасчетов.ПолучитьПараметыОклада1213(ДатаУвольнения, Сотрудник);
			РасчетСреднегоДляПособия[0].Результат			= ПараметрыОклада["Оклад"];
			РасчетСреднегоДляПособия[0].ОтработаноДней	= ПараметрыОклада["НормаДней"];
			РасчетСреднегоДляПособия[0].ОтработаноЧасов	= ПараметрыОклада["НормаЧасов"];
			РасчетСреднегоДляПособия[0].КалендарныеДни	= ПараметрыОклада["КалендарныеДни"];
			
			РасчитатьСреднююДляПособия();
			Записать();
			Возврат Истина;
			
		КонецЕсли;
		
		// 2. Стандартный расчет
		//
		НачатьТранзакцию();
		Прочитать();
		ВыборкаПоСредним = СформироватьЗапросПоРасчетСреднегоДляПособия().Выбрать();
		ЗафиксироватьТранзакцию();
		
		// Создадим рабочие наборы записей
		Отказ = Ложь;
		НаборСредних = РегистрыРасчета.РасчетСреднегоЗаработка.СоздатьНаборЗаписей();
		НаборСредних.Отбор.Регистратор.Значение = Ссылка;
		Пока ВыборкаПоСредним.Следующий() Цикл
			
			ПроверитьЗаполнениеСтрокиРасчетСреднегоДляПособия(ВыборкаПоСредним, Отказ);
			Если НЕ Отказ Тогда
				// Заполним записи в наборах записей регистров
				ДобавитьСтрокуРасчетаСреднегоДляПособия(ВыборкаПоСредним, НаборСредних);
			КонецЕсли;
			
		КонецЦикла;
		НаборСредних.Записать();
		
		Если Отказ Тогда
			
			// Если есть какие-то проблемы - удаляем движения (тут нет транзакции) 
			// Удаляем движения
			НаборСредних.Очистить();
			НаборСредних.Записать();
			
			Возврат Не Отказ;
			
		КонецЕсли;
		
		
		ОсновнойВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоЗаработку;
		
		ДанныеДляСредней = ПроведениеРасчетов.РассчитатьСреднююПорядок100(Ссылка,КомментироватьРасчет); 
		ТаблицаПревышений = ДанныеДляСредней.ТаблицаПревышений;
		Выборка = ДанныеДляСредней.Выборка.Выбрать();  
		
		Если КомментироватьРасчет Тогда
			
			табБазаСКомментариями = Новый ТаблицаЗначений;
			табБазаСКомментариями.Колонки.Добавить("НомерСтроки",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("Авторасчет",Новый ОписаниеТипов("Булево"));
			табБазаСКомментариями.Колонки.Добавить("ВидРасчета",Новый ОписаниеТипов("ПланВидовРасчетаСсылка.СреднийЗаработок"));
			табБазаСКомментариями.Колонки.Добавить("ВидРасчетаРазрез",Новый ОписаниеТипов("ПланВидовРасчетаСсылка.ОсновныеНачисленияОрганизаций"));
			табБазаСКомментариями.Колонки.Добавить("БазовыйПериодНачало",Новый ОписаниеТипов("Дата"));
			табБазаСКомментариями.Колонки.Добавить("БазовыйПериодКонец",Новый ОписаниеТипов("Дата"));
			табБазаСКомментариями.Колонки.Добавить("УсловиеБольшеНуля",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("Результат",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("Результат1",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("РезультатПолный",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("ОтработаноДней",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("ОтработаноЧасов",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("ОтработаноДнейБаза",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("ОтработаноЧасовБаза",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("НормаДней",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("НормаЧасов",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("НормаДнейБаза",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("НормаЧасовБаза",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("КалендарныеДни",Новый ОписаниеТипов("Число"));
			табБазаСКомментариями.Колонки.Добавить("ОтработаноВБазовомПериодеПремии",Новый ОписаниеТипов("Число"));
			
			Пока Выборка.Следующий() Цикл
				
				табНоваяСтрока = табБазаСКомментариями.Добавить();
				табНоваяСтрока.НомерСтроки = Выборка.НомерСтроки;
				табНоваяСтрока.Авторасчет = Выборка.Авторасчет;
				табНоваяСтрока.ВидРасчета = Выборка.ВидРасчета;
				табНоваяСтрока.ВидРасчетаРазрез = Выборка.ВидРасчетаРазрез;
				табНоваяСтрока.БазовыйПериодНачало = Выборка.БазовыйПериодНачало;
				табНоваяСтрока.БазовыйПериодКонец = Выборка.БазовыйПериодКонец;
				табНоваяСтрока.УсловиеБольшеНуля = Выборка.УсловиеБольшеНуля;
				табНоваяСтрока.Результат = Выборка.Результат;
				табНоваяСтрока.Результат1 = Выборка.Результат1;
				табНоваяСтрока.РезультатПолный = Выборка.РезультатПолный;
				табНоваяСтрока.ОтработаноДней = Выборка.ОтработаноДней;
				табНоваяСтрока.ОтработаноЧасов = Выборка.ОтработаноЧасов;
				табНоваяСтрока.ОтработаноДнейБаза = Выборка.ОтработаноДнейБаза;
				табНоваяСтрока.ОтработаноЧасовБаза = Выборка.ОтработаноЧасовБаза;
				табНоваяСтрока.НормаДней = Выборка.НормаДней;
				табНоваяСтрока.НормаЧасов = Выборка.НормаЧасов;
				табНоваяСтрока.НормаДнейБаза = Выборка.НормаДнейБаза;
				табНоваяСтрока.НормаЧасовБаза = Выборка.НормаЧасовБаза;
				табНоваяСтрока.КалендарныеДни = Выборка.КалендарныеДни;
				табНоваяСтрока.ОтработаноВБазовомПериодеПремии = Выборка.ОтработаноВБазовомПериодеПремии;
				
			КонецЦикла;	
			
			Выборка.Сбросить();
			
			Запрос = Новый Запрос;
			МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
			
			ТекстЗапроса = "ВЫБРАТЬ
			|	БазаСКомментариями.НомерСтроки КАК НомерСтроки,
			|	БазаСКомментариями.Авторасчет КАК Авторасчет,
			|	БазаСКомментариями.ВидРасчета КАК ВидРасчета,
			|	БазаСКомментариями.БазовыйПериодНачало КАК БазовыйПериодНачало,
			|	БазаСКомментариями.БазовыйПериодКонец КАК БазовыйПериодКонец,
			|	БазаСКомментариями.УсловиеБольшеНуля КАК УсловиеБольшеНуля,
			|	БазаСКомментариями.Результат КАК Результат,
			|	БазаСКомментариями.Результат1 КАК Результат1,
			|	БазаСКомментариями.РезультатПолный КАК РезультатПолный,
			|	БазаСКомментариями.ОтработаноДней КАК ОтработаноДней,
			|	БазаСКомментариями.ОтработаноЧасов КАК ОтработаноЧасов,
			|	БазаСКомментариями.ОтработаноДнейБаза КАК ОтработаноДнейБаза,
			|	БазаСКомментариями.ОтработаноЧасовБаза КАК ОтработаноЧасовБаза,
			|	БазаСКомментариями.НормаДней КАК НормаДней,
			|	БазаСКомментариями.НормаЧасов КАК НормаЧасов,
			|	БазаСКомментариями.НормаДнейБаза КАК НормаДнейБаза,
			|	БазаСКомментариями.НормаЧасовБаза КАК НормаЧасовБаза,
			|	БазаСКомментариями.КалендарныеДни КАК КалендарныеДни,
			|	БазаСКомментариями.ОтработаноВБазовомПериодеПремии КАК ОтработаноВБазовомПериодеПремии
			|ПОМЕСТИТЬ ВТБазаСреднего
			|ИЗ
			|	&табБазаСКомментариями КАК БазаСКомментариями
			|
			|ИНДЕКСИРОВАТЬ ПО НомерСтроки
			|";
			
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("табБазаСКомментариями",табБазаСКомментариями);
			Запрос.Выполнить();
			
			ТекстЗапроса = "ВЫБРАТЬ
			|	БазаСКомментариями.НомерСтроки КАК НомерСтроки,
			|	БазаСКомментариями.Авторасчет КАК Авторасчет,
			|	БазаСКомментариями.ВидРасчета КАК ВидРасчета,
			|	БазаСКомментариями.БазовыйПериодНачало КАК БазовыйПериодНачало,
			|	БазаСКомментариями.БазовыйПериодКонец КАК БазовыйПериодКонец,
			|	БазаСКомментариями.УсловиеБольшеНуля КАК УсловиеБольшеНуля,
			|	СУММА(БазаСКомментариями.Результат) КАК Результат,
			|	БазаСКомментариями.Результат1 КАК Результат1,
			|	СУММА(БазаСКомментариями.РезультатПолный) КАК РезультатПолный,
			|	МАКСИМУМ(БазаСКомментариями.ОтработаноДней) КАК ОтработаноДней,
			|	МАКСИМУМ(БазаСКомментариями.ОтработаноЧасов) КАК ОтработаноЧасов,
			|	МАКСИМУМ(БазаСКомментариями.НормаДней) КАК НормаДней,
			|	МАКСИМУМ(БазаСКомментариями.НормаЧасов) КАК НормаЧасов,
			|	МАКСИМУМ(БазаСКомментариями.КалендарныеДни) КАК КалендарныеДни,
			|	МАКСИМУМ(БазаСКомментариями.ОтработаноВБазовомПериодеПремии) КАК ОтработаноВБазовомПериодеПремии
			|ИЗ
			|	ВТБазаСреднего КАК БазаСКомментариями
			|
			|СГРУППИРОВАТЬ ПО
			|	БазаСКомментариями.НомерСтроки,
			|	БазаСКомментариями.Авторасчет,
			|	БазаСКомментариями.ВидРасчета,
			|	БазаСКомментариями.БазовыйПериодНачало,
			|	БазаСКомментариями.БазовыйПериодКонец,
			|	БазаСКомментариями.УсловиеБольшеНуля,
			|	БазаСКомментариями.Результат1
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки УБЫВ";
			
			Запрос.Текст = ТекстЗапроса;
			Выборка = Запрос.Выполнить().Выбрать();
			
			КомментарийРасчетаСредней = ОбщегоНазначения.КомментарийРасчета(НСтр("ru='Расчет средней с ';uk='Розрахунок середньої з '") + Формат(ПериодРасчетаСреднегоНачало,"ДФ='МММ гггг'")+ НСтр("ru=' по ';uk='до '") + Формат(ПериодРасчетаСреднегоКонец,"ДФ='МММ гггг'"));
			
			ТаблицаКомментариев = Новый ТаблицаЗначений;
			ТаблицаКомментариев.Колонки.Добавить("НомерСтроки");
			ТаблицаКомментариев.Колонки.Добавить("ВидРасчета");
			ТаблицаКомментариев.Колонки.Добавить("БазовыйПериод");
			ТаблицаКомментариев.Колонки.Добавить("БазовыеНачисления");
			ТаблицаКомментариев.Колонки.Добавить("МассивРасшифровок");
			ТаблицаКомментариев.Колонки.Добавить("ОтработаноДней");
			ТаблицаКомментариев.Колонки.Добавить("ФормулаПропорционально");
		КонецЕсли;	
		Пока Выборка.Следующий() Цикл
			
			СтрокаТабличнойЧасти = РасчетСреднегоДляПособия.Получить( Выборка.НомерСтроки - 1 );
			
			Если НЕ СтрокаТабличнойЧасти.Авторасчет И НЕ СтрокаТабличнойЧасти.ПревышениеПремии Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТабличнойЧасти.Результат				= Выборка.Результат;
			СтрокаТабличнойЧасти.РезультатПолный		= Выборка.РезультатПолный;
			
			СтрокаТабличнойЧасти.ОтработаноДней			= Выборка.ОтработаноДней;
			СтрокаТабличнойЧасти.ОтработаноЧасов		= Выборка.ОтработаноЧасов;
			Если ВидУчетаВремениДляСредней = Перечисления.ВидыУчетаВремениДляСредней.ПоКалендарнымДнямСПраздниками
				И СтрокаТабличнойЧасти.ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоЗаработку Тогда
				СтрокаТабличнойЧасти.КалендарныеДни		= 1 + День(Выборка.БазовыйПериодКонец) - День(Выборка.БазовыйПериодНачало);
			Иначе
				СтрокаТабличнойЧасти.КалендарныеДни		= Выборка.КалендарныеДни;
			КонецЕсли;
			СтрокаТабличнойЧасти.НормаДней				= Выборка.НормаДней;
			СтрокаТабличнойЧасти.НормаЧасов				= Выборка.НормаЧасов;
			Если КомментироватьРасчет Тогда
				СтруктураПоиска = Новый Структура("НомерСтроки,ВидРасчета");
				СтруктураПоиска.ВидРасчета = СтрокаТабличнойЧасти.ВидРасчета;
				СтруктураПоиска.НомерСтроки = СтрокаТабличнойЧасти.НомерСтроки;
				
				МассивРасшифровок = Новый Массив;
				
				ТекстКомментарийБазовыеНачисления = НСтр("ru='	Базовые начисления составили: ';uk='	Базові нарахування склали: '") + ОКР(Выборка.Результат,2,0);
				МассивКомментарии = табБазаСКомментариями.НайтиСтроки(СтруктураПоиска);
				
				Для Каждого СтрокаМассиваКомментарии из МассивКомментарии Цикл
					ТекстКомментария = ""; 
					ТекстКомментарияОтработанноеВремя = "";
					ТекстКомментарияФормулаПропорционально = "";
					Если СтрокаМассиваКомментарии.ОтработаноДней <> 0 Тогда
						ТекстКомментарияОтработанноеВремя = НСтр("ru='Отработано: дней - ';uk='Відпрацьовано: днів - '") +  СтрокаМассиваКомментарии.ОтработаноДней + НСтр("ru=', часов - ';uk=', годин - '") + СтрокаМассиваКомментарии.ОтработаноЧасов
					КонецЕсли;	
					Если Выборка.Результат <> 0 и СтрокаМассиваКомментарии.Результат <> 0 Тогда
						ТекстКомментария = СтрокаМассиваКомментарии.ВидРасчетаРазрез.Наименование + ": " + ОКР(СтрокаМассиваКомментарии.Результат,2,0);
						МассивРасшифровок.Добавить(ТекстКомментария);
					КонецЕсли;
				Если (Выборка.Результат <> Выборка.РезультатПолный) И 
						(Выборка.ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоФиксПремиямОтпуска ИЛИ Выборка.ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоФиксПремиям
						ИЛИ Выборка.ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоПремиям ИЛИ Выборка.ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоПремиямОтпуска
						ИЛИ Выборка.ВидРасчета = ПланыВидовРасчета.СреднийЗаработок.ПоГодовойПремии) И 
						(СтрокаМассиваКомментарии.Результат1 = 2 ИЛИ СтрокаМассиваКомментарии.Результат1 = 1) И (СтрокаМассиваКомментарии.УсловиеБольшеНуля = 1)
						Тогда
						ТекстКомментарияФормулаПропорционально = "" + СтрокаМассиваКомментарии.РезультатПолный + "*" + "(" + СтрокаМассиваКомментарии.ОтработаноДнейБаза + "/" + СтрокаМассиваКомментарии.ОтработаноВБазовомПериодеПремии + ")"; 	
					КонецЕсли	
				КонецЦикла;
				
				Если Выборка.Результат <> 0 Тогда
					НоваяСтрока = ТаблицаКомментариев.Добавить();
					НоваяСтрока.НомерСтроки = Выборка.НомерСтроки;
					НоваяСтрока.ВидРасчета = Выборка.ВидРасчета;
					НоваяСтрока.БазовыйПериод = Выборка.БазовыйПериодНачало;
					НоваяСтрока.БазовыеНачисления = ТекстКомментарийБазовыеНачисления;
					НоваяСтрока.МассивРасшифровок = МассивРасшифровок;
					НоваяСтрока.ОтработаноДней = ТекстКомментарияОтработанноеВремя;
					НоваяСтрока.ФормулаПропорционально = ТекстКомментарияФормулаПропорционально;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		Если КомментироватьРасчет Тогда
			
			ТаблицаКомментариев.Сортировать("НомерСтроки Возр");
			
			Для Каждого СтрокаКомментария из ТаблицаКомментариев Цикл
				КомментарийНомерСтроки = ОбщегоНазначения.КомментарийРасчета(НСтр("ru='Номер строки: ';uk='Номер рядка: '") + СтрокаКомментария.НомерСтроки, КомментарийРасчетаСредней);
				КомментарийВидаРасчета = ОбщегоНазначения.КомментарийРасчета(НСтр("ru='	Вид расчета: ';uk='	Вид розрахунку: '") +  СтрокаКомментария.ВидРасчета, КомментарийНомерСтроки);
				ОбщегоНазначения.КомментарийРасчета(НСтр("ru='	Базовый период: ';uk='	Базовий період: '") + Формат(СтрокаКомментария.БазовыйПериод,"ДФ='МММ гггг'"), КомментарийВидаРасчета);
				КомментарийБазовыеНачисления = ОбщегоНазначения.КомментарийРасчета(СтрокаКомментария.БазовыеНачисления, КомментарийВидаРасчета,,,,Ложь);
				Если СтрокаКомментария.МассивРасшифровок.Количество() > 0 Тогда
					Для Каждого СтрокаМассива из СтрокаКомментария.МассивРасшифровок Цикл
						КомментарийВидаРасчетаРазрез = ОбщегоНазначения.КомментарийРасчета(СтрокаМассива,КомментарийБазовыеНачисления,,,,Ложь)	
					КонецЦикла;	
				КонецЕсли;
				Если СтрокаКомментария.ВидРасчета = ОсновнойВидРасчета и СтрокаКомментария.ОтработаноДней <> "" Тогда
					ОбщегоНазначения.КомментарийРасчета(СтрокаКомментария.ОтработаноДней,КомментарийВидаРасчета);		
				КонецЕсли;
				Если СтрокаКомментария.ФормулаПропорционально <> "" Тогда
					ОбщегоНазначения.КомментарийРасчета(СтрокаКомментария.ФормулаПропорционально,КомментарийВидаРасчетаРазрез);		
				КонецЕсли;
			КонецЦикла;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДатаУвольнения >= ПроведениеРасчетов.ДатаИзмененияПорядка100_486() Тогда
		Если ТаблицаПревышений.Количество() > 0 Тогда
			Для НомерСтрокиПремии = 0 По ТаблицаПревышений.Количество() - 1 Цикл 
				ДополнительнаяСтрока = РасчетСреднегоДляПособия.Добавить();
				ДополнительнаяСтрока.Авторасчет = Истина;
				ДополнительнаяСтрока.ПревышениеПремии = Истина;
				ДополнительнаяСтрока.БазовыйПериодНачало = ТаблицаПревышений[НомерСтрокиПремии].БазовыйПериодПремииНачало;
				ДополнительнаяСтрока.БазовыйПериодКонец = ТаблицаПревышений[НомерСтрокиПремии].БазовыйПериодПремииКонец;
				ДополнительнаяСтрока.Результат = ТаблицаПревышений[НомерСтрокиПремии].РезультатПолный - ТаблицаПревышений[НомерСтрокиПремии].Результат;
				ДополнительнаяСтрока.ВидРасчета = ТаблицаПревышений[НомерСтрокиПремии].ВидРасчета; 
				Если КомментироватьРасчет Тогда
					КомментарийНомерСтроки = ОбщегоНазначения.КомментарийРасчета(НСтр("ru='Номер строки (ограничение суммы премии): ';uk='Номер рядка (обмеження суми премії): '") + ДополнительнаяСтрока.НомерСтроки, КомментарийРасчетаСредней);
					КомментарийВидаРасчета = ОбщегоНазначения.КомментарийРасчета(НСтр("ru='	Вид расчета: ';uk='	Вид розрахунку: '") +  ТаблицаПревышений[НомерСтрокиПремии].ВидРасчета, КомментарийНомерСтроки);
				    ОбщегоНазначения.КомментарийРасчета(НСтр("ru='	Базовый период премии: ';uk='	Базовий період премії: '") + Формат(ТаблицаПревышений[НомерСтрокиПремии].БазовыйПериодПремииНачало,"ДФ='МММ гггг'")+" - " + Формат(ТаблицаПревышений[НомерСтрокиПремии].БазовыйПериодПремииКонец,"ДФ='МММ гггг'"), КомментарийВидаРасчета);
					ОбщегоНазначения.КомментарийРасчета(НСтр("ru='	Сумма премии без ограничения: ';uk='  Сума премії без обмеження: '") + ТаблицаПревышений[НомерСтрокиПремии].Результат, КомментарийВидаРасчета);
					ОбщегоНазначения.КомментарийРасчета(НСтр("ru='	Фактическая сумма премии: ';uk='  Фактична сума премії: '") +  ТаблицаПревышений[НомерСтрокиПремии].РезультатПолный, КомментарийВидаРасчета);
					ОбщегоНазначения.КомментарийРасчета(НСтр("ru='  При расчете средней премия уменьшена на ';uk='  При розрахунку середньої премію зменшено на '") +  -ДополнительнаяСтрока.Результат, КомментарийВидаРасчета);
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	
	НаборСредних.Очистить();
	НаборСредних.Записать();
	
	РасчитатьСреднююДляПособия();
	Записать();
	
КонецФункции  // РассчитатьРасчетСреднегоДляПособия()

Функция СоздатьСтрокуРасчетСреднегоДляПособия( ВидРасч, Коэффициент, БазовыйПериодНачало, БазовыйПериодКонец) 
	
	// строку втавляем на первую позицию, потому что коэффициент считали в обратном порядке
	СтрокаТабличнойЧасти =  РасчетСреднегоДляПособия.Вставить(0);
	
	СтрокаТабличнойЧасти.Авторасчет 			= Истина;
	СтрокаТабличнойЧасти.ВидРасчета 			= ВидРасч;
	СтрокаТабличнойЧасти.БазовыйПериодНачало 	= БазовыйПериодНачало;
	СтрокаТабличнойЧасти.БазовыйПериодКонец 	= БазовыйПериодКонец;
	СтрокаТабличнойЧасти.КоэффициентПовышенияОкладов = Коэффициент;
	
КонецФункции  // СоздатьСтрокуРасчетСреднегоДляПособия()

Функция ПолучитьПериодПоРаботникуДляПособия() Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачалаСобытия",	ДатаУвольнения );
	Запрос.УстановитьПараметр("ЧислоМесяцев",		ЧислоМесяцевДляПособия );
	Запрос.УстановитьПараметр("парамСотрудник",		Сотрудник );
	
	ТекстЗапроса = "
	|	ВЫБРАТЬ
	|		АктуальныйГрафик.ГрафикРаботы			КАК ГрафикРаботы,   
	|
	|		// -1- работает дольше 2-х месяцев
	|		// -2- работает меньше 2 месяцев, но дольше 1-го месяца
	|		// -3- работает меньше целого месяца, но заболел не в первый рабочий день, пока считаем как -4-
	|		// -4- заболел в первый рабочий день
	|   	ВЫБОР
	|		// -1-
	|		КОГДА		ДОБАВИТЬКДАТЕ( НАЧАЛОПЕРИОДА(&ДатаНачалаСобытия, МЕСЯЦ), МЕСЯЦ, ВЫБОР КОГДА &ЧислоМесяцев = 0 ТОГДА 0 ИНАЧЕ -&ЧислоМесяцев КОНЕЦ) >= ПриказОприеме.ДатаПриема
	|   		ТОГДА	ДОБАВИТЬКДАТЕ( НАЧАЛОПЕРИОДА(&ДатаНачалаСобытия, МЕСЯЦ), МЕСЯЦ, ВЫБОР КОГДА &ЧислоМесяцев = 0 ТОГДА 0 ИНАЧЕ -&ЧислоМесяцев КОНЕЦ) 
	|		// -2-
	|   	КОГДА		ПриказОприеме.ДатаПриема < ДОБАВИТЬКДАТЕ( НАЧАЛОПЕРИОДА(&ДатаНачалаСобытия, МЕСЯЦ), МЕСЯЦ, -1)
	|	   		ТОГДА	ВЫБОР	КОГДА ПриказОприеме.ДатаПриема = НАЧАЛОПЕРИОДА(ПриказОприеме.ДатаПриема, МЕСЯЦ)
	|	            	 	ТОГДА ПриказОприеме.ДатаПриема 				// принят в первый день месяца
	|	            		ИНАЧЕ ДОБАВИТЬКДАТЕ( КОНЕЦПЕРИОДА(ПриказОприеме.ДатаПриема, МЕСЯЦ), СЕКУНДА, 1 ) // иначе это не полный месяц и берем первое число следующего
	|	            КОНЕЦ
	|		// -3-
	|		// -4-
	|		ИНАЧЕ	ПриказОприеме.ДатаПриема	
	|   	КОНЕЦ                                                 КАК ПериодРасчетаСреднегоНачало,
	|	
	|   	ВЫБОР
	|		// -1-
	|   	КОГДА		ДОБАВИТЬКДАТЕ( НАЧАЛОПЕРИОДА(&ДатаНачалаСобытия, МЕСЯЦ), МЕСЯЦ, ВЫБОР КОГДА &ЧислоМесяцев = 0 ТОГДА 0 ИНАЧЕ -&ЧислоМесяцев КОНЕЦ) >= ПриказОприеме.ДатаПриема
	|   		ТОГДА	КОНЕЦПЕРИОДА( ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ДатаНачалаСобытия, МЕСЯЦ), СЕКУНДА, -(1)), МЕСЯЦ ) 
	|		// -2-
	|   	КОГДА		ПриказОприеме.ДатаПриема < ДОБАВИТЬКДАТЕ( НАЧАЛОПЕРИОДА(&ДатаНачалаСобытия, МЕСЯЦ), МЕСЯЦ, -1)
	|	   		ТОГДА	КОНЕЦПЕРИОДА(  ДОБАВИТЬКДАТЕ( НАЧАЛОПЕРИОДА(&ДатаНачалаСобытия, МЕСЯЦ), СЕКУНДА, -1 ), МЕСЯЦ )  
	|		// -3-
	|		// -4-
	|		ИНАЧЕ	КОНЕЦПЕРИОДА( ПриказОприеме.ДатаПриема, МЕСЯЦ )	
	|   	КОНЕЦ                                                 КАК ПериодРасчетаСреднегоКонец
	|
	|	ИЗ ( 
	|		ВЫБРАТЬ 
	|          	МИНИМУМ(Работники.Период) КАК ДатаПриема
	|		ИЗ РегистрСведений.РаботникиОрганизаций КАК Работники
	|   	ГДЕ Работники.Сотрудник = &парамСотрудник
	|     ) КАК ПриказОприеме
	|
	|
	|//-----------------------
	|// данные для расчета
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаботникиОрганизаций.СрезПоследних(&ДатаНачалаСобытия, Сотрудник = &парамСотрудник) КАК АктуальныйГрафик
	|ПО ИСТИНА
	|
	|";
	
	Запрос.Текст = ТекстЗапроса;

	Возврат Запрос.Выполнить();

КонецФункции // ПолучитьПериодПоРаботникуДляПособия()


