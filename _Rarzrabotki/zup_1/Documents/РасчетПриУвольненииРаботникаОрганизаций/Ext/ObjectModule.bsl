			ПолучитьДанныеОбОтработанномВремени(ОтработаноЗа2Мес, ОтработаноЗа4Мес, ОсновнойВидРасчета);
			ДатаПриема = ПолучитьДанныеОПриеме(ДатаПриемаПервыйРабочийДень);
			Если ((ОтработаноЗа2Мес = 0 И ОтработаноЗа4Мес = 0) ИЛИ НачалоМесяца(ДатаУвольнения) = НачалоМесяца(ДатаПриема))
				ИЛИ (ОтработаноЗа2Мес = 0 И ОтработаноЗа4Мес = 0 И НачалоМесяца(ДобавитьМесяц(ДатаУвольнения,-1)) = НачалоМесяца(ДатаПриема)) Тогда
				// проработал меньше целого месяца
				// проработал меньше целого месяца
				// если есть за что платить, пользователю прийдется заполнить эти суммы вручную
				//
				СоздатьСтрокуРасчетСреднегоДляПособия( ПланыВидовРасчета.СреднийЗаработок.ПоОкладу, 1, НачалоМесяца(ДатаУвольнения), КонецМесяца(ДатаУвольнения));
			
				Записать();
			
