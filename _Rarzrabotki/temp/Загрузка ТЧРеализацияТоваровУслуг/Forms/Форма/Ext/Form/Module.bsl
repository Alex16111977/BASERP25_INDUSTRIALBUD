КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СпособСнято()
	Возврат "Знято бухгалтером";
КонецФункции

// Підсумки під таблицею (усього в накладній / готово до завантаження / не підтверджено), контроль з рядком «Разом»
// накладної, рядок-резюме і стан рядків для перемикача-фільтра. Викликається і з клієнта, і з сервера (Форма — ЭтотОбъект).
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьИтогиФормы(Форма)

	ФайлСтрок = 0;
	ФайлКоличество = 0;
	ФайлСумма = 0;
	ГотовоСтрок = 0;
	ГотовоКоличество = 0;
	ГотовоСумма = 0;
	НеНайдено = 0;
	Для Каждого СтрокаТаблицы Из Форма.Распознавание Цикл
		СуммаСтроки = ?(СтрокаТаблицы.Сумма <> 0, СтрокаТаблицы.Сумма, Окр(СтрокаТаблицы.Количество * СтрокаТаблицы.Цена, 2));
		ФайлСтрок = ФайлСтрок + 1;
		ФайлКоличество = ФайлКоличество + СтрокаТаблицы.Количество;
		ФайлСумма = ФайлСумма + СуммаСтроки;
		Если СтрокаТаблицы.Подтверждено Тогда
			Группа = "Подтверждено";
			ГотовоСтрок = ГотовоСтрок + 1;
			ГотовоКоличество = ГотовоКоличество + СтрокаТаблицы.Количество;
			ГотовоСумма = ГотовоСумма + СуммаСтроки;
		ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура) Тогда
			Группа = "Решение";
		Иначе
			Группа = "НеНайдено";
			НеНайдено = НеНайдено + 1;
		КонецЕсли;
		Если СтрокаТаблицы.Группа <> Группа Тогда
			СтрокаТаблицы.Группа = Группа;
		КонецЕсли;
	КонецЦикла;
	Форма.ФайлСтрок = ФайлСтрок;
	Форма.ФайлКоличество = ФайлКоличество;
	Форма.ФайлСумма = ФайлСумма;
	Форма.ГотовоСтрок = ГотовоСтрок;
	Форма.ГотовоКоличество = ГотовоКоличество;
	Форма.ГотовоСумма = ГотовоСумма;
	Форма.ОсталосьСтрок = ФайлСтрок - ГотовоСтрок;
	Форма.ОсталосьКоличество = ФайлКоличество - ГотовоКоличество;
	Форма.ОсталосьСумма = ФайлСумма - ГотовоСумма;

	ЭлементКонтроля = Форма.Элементы.КонтрольИтога;
	Если ФайлСтрок = 0 Тогда
		Форма.КонтрольИтога = "";
	ИначеЕсли Форма.ФайлРазом = 0 Тогда
		Форма.КонтрольИтога = "У накладній немає рядка «Разом» — звірте суму вручну";
		ЭлементКонтроля.ЦветТекста = Новый Цвет(150, 110, 0);
	ИначеЕсли Форма.ФайлРазом = ФайлСумма Тогда
		Форма.КонтрольИтога = "✓ Сума рядків = «Разом»";
		ЭлементКонтроля.ЦветТекста = Новый Цвет(30, 130, 60);
	Иначе
		Форма.КонтрольИтога = "⚠ Різниця з «Разом»: " + Формат(Форма.ФайлРазом - ФайлСумма, "ЧДЦ=2; ЧРГ=' '")
			+ " — перевірте пропущені рядки";
		ЭлементКонтроля.ЦветТекста = Новый Цвет(200, 40, 40);
	КонецЕсли;

	Если ФайлСтрок = 0 Тогда
		Форма.НадписьРезюме = "Виберіть документ і файл накладної, натисніть «1. Прочитати і зіставити». Як "
			+ "користуватися — закладка «Інструкція».";
	ИначеЕсли ГотовоСтрок = ФайлСтрок Тогда
		Форма.НадписьРезюме = СтрШаблон("Усі %1 рядків підтверджено — натисніть «2. Завантажити в документ».", ФайлСтрок);
	Иначе
		Форма.НадписьРезюме = СтрШаблон("Підтверджено %1 з %2 рядків. Потребують рішення: %3 (жовті й помаранчеві), не "
			+ "знайдено: %4 (червоні). Завантажуються лише рядки з ✓.", ГотовоСтрок, ФайлСтрок,
			ФайлСтрок - ГотовоСтрок - НеНайдено, НеНайдено);
	КонецЕсли;
	ПрименитьФильтр(Форма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПрименитьФильтр(Форма)

	Если ПустаяСтрока(Форма.Показать) Или Форма.Показать = "Все" Тогда
		Форма.Элементы.Распознавание.ОтборСтрок = Неопределено;
	Иначе
		Форма.Элементы.Распознавание.ОтборСтрок = Новый ФиксированнаяСтруктура("Группа", Форма.Показать);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОформитьСпособ(Способ, ЦветФона, ЭлементЛегенды)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Распознавание.Способ");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Способ;
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Распознавание.Подтверждено");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	ДобавитьПоляОформления(ЭлементОформления);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементЛегенды.ЦветФона = ЦветФона;

КонецПроцедуры

&НаСервере
Процедура ОформитьПодтвержденные(ЦветФона, ЭлементЛегенды)

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОтбора = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Распознавание.Подтверждено");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Истина;
	ДобавитьПоляОформления(ЭлементОформления);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветФона);
	ЭлементЛегенды.ЦветФона = ЦветФона;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПоляОформления(ЭлементОформления)

	Для Каждого ИмяПоля Из СтрРазделить("РаспознаваниеПодтверждено,РаспознаваниеНоменклатура,РаспознаваниеСходство,"
		+ "РаспознаваниеСпособ", ",") Цикл
		ЭлементОформления.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;

КонецПроцедуры

// Кольори рядків — ті самі, що в легенді над таблицею й в інструкції.
