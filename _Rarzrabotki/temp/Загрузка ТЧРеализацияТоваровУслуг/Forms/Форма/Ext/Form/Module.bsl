#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// відкрито з документа (команда додаткової обробки «Заполнение объекта», ОткрытиеФормы) — документ з параметрів
	ДокументРеализации = Неопределено;
	Если Параметры.Свойство("ОбъектыНазначения") И ТипЗнч(Параметры.ОбъектыНазначения) = Тип("Массив")
		И Параметры.ОбъектыНазначения.Количество() > 0 Тогда
		ДокументРеализации = Параметры.ОбъектыНазначения[0];
	КонецЕсли;

	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ЗаполнитьНастройки(ДокументРеализации);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ТекстИнструкции = Обработка.ПолучитьМакет("Инструкция").ПолучитьТекст();
	Элементы.РаспознаваниеКод.Видимость = Объект.КолонкаКод > 0;
	Показать = "Все";

	// кольори рядків і легенда над таблицею — однакові
	ОформитьСпособ(Обработка.СпособНеНайдено(), ЦветНеНайдено(), Элементы.ЛегендаНеНайдено);
	ОформитьСпособ(Обработка.СпособПохоже(), ЦветПохоже(), Элементы.ЛегендаПохоже);
	ОформитьСпособ(Обработка.СпособВнеОстатков(), ЦветВнеОстатков(), Элементы.ЛегендаВнеОстатков);
	ОформитьСпособ(СпособСнято(), ЦветСнято(), Элементы.ЛегендаСнято);
	ОформитьПодтвержденные(ЦветПодтверждено(), Элементы.ЛегендаПодтверждено);

	ЖирныйШрифт = Новый Шрифт(, , Истина);
	Элементы.ГотовоСумма.Шрифт = ЖирныйШрифт;
	Элементы.ФайлСумма.Шрифт = ЖирныйШрифт;
	Элементы.КонтрольИтога.Шрифт = ЖирныйШрифт;
	Элементы.ПодсказкаВарианты.ЦветТекста = ЦветаСтиля.ПоясняющийТекст;
	Элементы.ПодсказкаСклады.ЦветТекста = ЦветаСтиля.ПоясняющийТекст;
	ОбновитьИтогиФормы(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайл();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПриИзменении(Элемент)

	ПрименитьФильтр(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРаспознавание

&НаКлиенте
Процедура РаспознаваниеПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("ПоказатьВарианты", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура РаспознаваниеНоменклатураПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Распознавание.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеКарточки = ДанныеКарточкиНаСервере(ТекущиеДанные.Номенклатура, ТекущиеДанные.Единица);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеКарточки);
	ТекущиеДанные.Подтверждено = ЗначениеЗаполнено(ТекущиеДанные.Номенклатура);
	ТекущиеДанные.Способ = ?(ТекущиеДанные.Подтверждено, СпособВручную(), "");
	ТекущиеДанные.Сходство = ?(ТекущиеДанные.Подтверждено, 100, 0);
	ОбновитьИтогиФормы(ЭтотОбъект);

КонецПроцедуры

// Зняли ✓ — рядок «Знято» (кнопка «Підтвердити схожі» його не чіпає); поставили знову — «Вибрано вручну».
&НаКлиенте
Процедура РаспознаваниеПодтвержденоПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Распознавание.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.Подтверждено И Не ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		ТекущиеДанные.Подтверждено = Ложь;
		ПоказатьПредупреждение(, "Спершу виберіть картку в колонці «Номенклатура 1С».");
	ИначеЕсли Не ТекущиеДанные.Подтверждено Тогда
		ТекущиеДанные.Способ = СпособСнято();
	ИначеЕсли ТекущиеДанные.Способ = СпособСнято() Тогда
		ТекущиеДанные.Способ = СпособВручную();
	КонецЕсли;
	ОбновитьИтогиФормы(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыКандидаты

&НаКлиенте
Процедура КандидатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Вариант = Кандидаты.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ТекущиеДанные = Элементы.Распознавание.ТекущиеДанные;
	Если Вариант = Неопределено Или ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Номенклатура = Вариант.Номенклатура;
	ДанныеКарточки = ДанныеКарточкиНаСервере(Вариант.Номенклатура, ТекущиеДанные.Единица);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеКарточки);
	ТекущиеДанные.Сходство = Вариант.Сходство;
	ТекущиеДанные.Пояснение = Вариант.Пояснение;
	ТекущиеДанные.Подтверждено = Истина;
	ТекущиеДанные.Способ = СпособВручную();
	ОбновитьИтогиФормы(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьФайл(Команда)

	Если ЗначениеЗаполнено(АдресФайла) Тогда
		ПрочитатьФайлНаСервере();
		ПоказатьВарианты();
	Иначе
		ВыбратьФайл();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьСхожие(Команда)

	Подтверждено = ПодтвердитьСхожиеНаСервере();
	ПоказатьОповещениеПользователя("Підтверджено рядків: " + Подтверждено);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВДокумент(Команда)

	Если Не ЗначениеЗаполнено(Объект.Документ) Тогда
		ПоказатьПредупреждение(, "Виберіть документ реалізації.");
		Возврат;
	ИначеЕсли Распознавание.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Спершу прочитайте і зіставте файл (кнопка «1. Прочитати і зіставити»).");
		Возврат;
	ИначеЕсли ГотовоСтрок = 0 Тогда
		ПоказатьПредупреждение(, "Немає рядків з ✓ — підтвердіть картки в таблиці.");
		Возврат;
	КонецЕсли;

	Результат = ЗагрузитьВДокументНаСервере();
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
		Возврат;
	КонецЕсли;

	ОповеститьОбИзменении(Объект.Документ);
	Текст = СтрШаблон("Завантажено в документ рядків: %1 на суму %2 без ПДВ.", Результат.Строк,
		Формат(Результат.Сумма, "ЧДЦ=2; ЧРГ=' '; ЧН=0,00"));
	Если Результат.Пропущено > 0 Тогда
		Текст = Текст + СтрШаблон(" Не завантажено (без ✓): %1.", Результат.Пропущено);
	КонецЕсли;
	Если Объект.ОчиститьТовары Тогда
		Текст = Текст + " Попередні товари документа замінено.";
	КонецЕсли;
	Если Не ПустаяСтрока(Результат.Предупреждения) Тогда
		Текст = Текст + Символы.ПС + Символы.ПС + Результат.Предупреждения;
	КонецЕсли;
	Текст = Текст + Символы.ПС + Символы.ПС + "Вибір запам'ятовано. Файл накладної і журнал зіставлення — у «Приєднаних "
		+ "файлах» документа. Якщо документ відкрито — закрийте і відкрийте його знову.";
	ПоказатьПредупреждение(, Текст);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВExcel(Команда)

	Если Распознавание.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Немає рядків для вивантаження — спершу прочитайте файл.");
		Возврат;
	КонецЕсли;
	ОписаниеФайла = Новый ОписаниеПередаваемогоФайла("Накладна з кодами 1С.xlsx", АдресExcelСКодами());
	ФайлыДляПолучения = Новый Массив;
	ФайлыДляПолучения.Добавить(ОписаниеФайла);
	НачатьПолучениеФайлов(Новый ОписаниеОповещения("ВыгрузитьВExcelЗавершение", ЭтотОбъект), ФайлыДляПолучения, , Истина);

КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВExcelЗавершение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт

	Если ПолученныеФайлы <> Неопределено Тогда
		ПоказатьОповещениеПользователя("Файл збережено. Код 1С — лише для рядків з ✓. Для завантаження за кодом: назва 2, "
			+ "кількість 3, од. 4, ціна 5, код 1С 6, сума 7.");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗабытьСоответствие(Команда)

	ТекущиеДанные = Элементы.Распознавание.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗабытьСоответствиеНаСервере(ТекущиеДанные.Наименование);
	ТекущиеДанные.Подтверждено = Ложь;
	ТекущиеДанные.Способ = СпособСнято();
	ОбновитьИтогиФормы(ЭтотОбъект);
	ПоказатьОповещениеПользователя("Вибір для «" + Лев(ТекущиеДанные.Наименование, 40) + "» забуто");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьФайл()

	НачатьПомещениеФайла(Новый ОписаниеОповещения("ВыбратьФайлЗавершение", ЭтотОбъект), , , Истина,
		УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФайлЗавершение(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	АдресФайла = Адрес;
	ИмяФайла = ВыбранноеИмяФайла;
	ПрочитатьФайлНаСервере();
	ПоказатьВарианты();

КонецПроцедуры

// Аналіз: читання файлу і зіставлення. Ручний вибір по рядках, ще не завантажений, переноситься в новий аналіз.
&НаСервере
Процедура ПрочитатьФайлНаСервере()

	РучнойВыбор = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Распознавание Цикл
		Если СтрокаТаблицы.Способ = СпособВручную() Тогда
			РучнойВыбор.Вставить(Формат(СтрокаТаблицы.НомерСтроки, "ЧГ=0") + "|" + СтрокаТаблицы.Наименование,
				СтрокаТаблицы.Номенклатура);
		КонецЕсли;
	КонецЦикла;

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ПрочитатьИСопоставить(АдресФайла, ИмяФайла);
	Для Каждого СтрокаТаблицы Из Результат.Таблица Цикл
		Номенклатура = РучнойВыбор.Получить(Формат(СтрокаТаблицы.НомерСтроки, "ЧГ=0") + "|" + СтрокаТаблицы.Наименование);
		Если Номенклатура <> Неопределено Тогда
			СтрокаТаблицы.Номенклатура = Номенклатура;
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеКарточкиНаСервере(Номенклатура, СтрокаТаблицы.Единица));
			СтрокаТаблицы.Подтверждено = Истина;
			СтрокаТаблицы.Способ = СпособВручную();
			СтрокаТаблицы.Сходство = 100;
		КонецЕсли;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Результат.Таблица, "Распознавание");
	ЗначениеВРеквизитФормы(Результат.Варианты, "Варианты");
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ФайлРазом = ?(Результат.ИтогФайла = Неопределено, 0, Результат.ИтогФайла);
	Элементы.РаспознаваниеКод.Видимость = Объект.КолонкаКод > 0; // код з накладної — лише коли задано колонку коду

	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Сообщить(Результат.Ошибка);
	КонецЕсли;
	Если Не ПустаяСтрока(Результат.Предупреждения) Тогда
		Сообщить(Результат.Предупреждения);
	КонецЕсли;
	ОбновитьИтогиФормы(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВарианты() Экспорт

	Кандидаты.Очистить();
	ТекущиеДанные = Элементы.Распознавание.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Вариант Из Варианты Цикл
		Если Вариант.НомерСтроки = ТекущиеДанные.НомерСтроки Тогда
			ЗаполнитьЗначенияСвойств(Кандидаты.Добавить(), Вариант);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// «Підтвердити схожі ≥ 85 %» — лише рядки-підказки серед залишків (не зняті бухгалтером, не «забуті», не поза
// залишками).
&НаСервере
Функция ПодтвердитьСхожиеНаСервере()

	Похоже = РеквизитФормыВЗначение("Объект").СпособПохоже();
	Подтверждено = 0;
	Для Каждого СтрокаТаблицы Из Распознавание Цикл
		Если Не СтрокаТаблицы.Подтверждено И СтрокаТаблицы.Способ = Похоже И ЗначениеЗаполнено(СтрокаТаблицы.Номенклатура)
			И СтрокаТаблицы.Сходство >= 85 Тогда
			СтрокаТаблицы.Подтверждено = Истина;
			Подтверждено = Подтверждено + 1;
		КонецЕсли;
	КонецЦикла;
	ОбновитьИтогиФормы(ЭтотОбъект);
	Возврат Подтверждено;

КонецФункции

&НаСервере
Функция ЗагрузитьВДокументНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ЗагрузитьВДокумент(РеквизитФормыВЗначение("Распознавание"), АдресФайла, ИмяФайла);
	Если ПустаяСтрока(Результат.Ошибка) Тогда
		Для Каждого СтрокаТаблицы Из Распознавание Цикл
			Если СтрокаТаблицы.Подтверждено И СтрокаТаблицы.Способ <> Обработка.СпособКод() Тогда
				СтрокаТаблицы.Способ = Обработка.СпособЗапомнено();
			КонецЕсли;
		КонецЦикла;
		ОбновитьИтогиФормы(ЭтотОбъект);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Код і одиниця картки, залишок і склади залишку для рядка таблиці; пояснення про різні одиниці.
&НаСервере
Функция ДанныеКарточкиНаСервере(Номенклатура, ЕдиницаФайла)

	Результат = Новый Структура("КодКарточки, ЕдиницаКарточки, Остаток, СкладОстатка, Пояснение", "", "", 0, "", "");
	Если Не ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.КодКарточки = Номенклатура.Код;
	Обработка = РеквизитФормыВЗначение("Объект");
	Остаток = Обработка.ДанныеОстатка(Номенклатура);
	Результат.ЕдиницаКарточки = Строка(Номенклатура.БазоваяЕдиницаИзмерения);
	Результат.Остаток = Остаток.Количество;
	Результат.СкладОстатка = Остаток.Склады;
	Если Остаток.Количество = 0 Тогда
		Результат.Пояснение = "немає залишку на складах пошуку";
	КонецЕсли;
	Если Не ПустаяСтрока(ЕдиницаФайла) И НРег(СокрЛП(ЕдиницаФайла)) <> НРег(Результат.ЕдиницаКарточки) Тогда
		Результат.Пояснение = СокрЛП(Результат.Пояснение + "; одиниця файлу «" + ЕдиницаФайла + "», картки «"
			+ Результат.ЕдиницаКарточки + "» (т ↔ кг перераховується)");
	КонецЕсли;
	Возврат Результат;

КонецФункции

