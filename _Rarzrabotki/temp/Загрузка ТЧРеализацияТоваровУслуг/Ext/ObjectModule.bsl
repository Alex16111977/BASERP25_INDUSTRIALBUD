Функция ЭтоБуква(Символ)

	Возврат СтрНайти("abcdefghijklmnopqrstuvwxyzабвгґдеєжзиіїйклмнопрстуфхцчшщьюяёъыэ", Символ) > 0;

КонецФункции

// Скелет рядка: латинські літери-двійники -> кириличні (Unicode TR39), «ё» -> «е», «ø» -> пробіл,
// «г/к» -> «гк», «х/к» -> «хк».
Функция ЕдиныеБуквы(Знач Текст)

	Латиница = "aceiopxykmtbh";
	Кириллица = "асеіорхукмтвн";
	Для Позиция = 1 По СтрДлина(Латиница) Цикл
		Текст = СтрЗаменить(Текст, Сред(Латиница, Позиция, 1), Сред(Кириллица, Позиция, 1));
	КонецЦикла;
	Текст = СтрЗаменить(Текст, "ё", "е");
	Текст = СтрЗаменить(Текст, "ø", " ");
	Текст = СтрЗаменить(Текст, "г/к", "гк");
	Текст = СтрЗаменить(Текст, "х/к", "хк");
	Возврат Текст;

КонецФункции

// Коефіцієнт «кількість файлу -> одиниця картки»; Неопределено — одиниці не порівнянні.
Функция КоэффициентПересчета(ЕдиницаФайла, ЕдиницаКарточки)

	Файл = КлючЕдиницы(ЕдиницаФайла);
	Карточка = КлючЕдиницы(ЕдиницаКарточки);
	Если Файл = "" Или Файл = Карточка Тогда
		Возврат 1;
	ИначеЕсли Файл = "т" И Карточка = "кг" Тогда
		Возврат 1000;
	ИначеЕсли Файл = "кг" И Карточка = "т" Тогда
		Возврат 0.001;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция КлючЕдиницы(Знач Единица)

	Единица = НРег(СокрЛП(Единица));
	Для Каждого Символ Из СтрРазделить(" |.|,", "|") Цикл
		Единица = СтрЗаменить(Единица, Символ, "");
	КонецЦикла;
	Если Единица = "тн" Или Единица = "тонн" Или Единица = "тона" Тогда
		Возврат "т";
	ИначеЕсли Единица = "штук" Или Единица = "штука" Тогда
		Возврат "шт";
	ИначеЕсли Единица = "м²" Или Единица = "квм" Или Единица = "мкв" Тогда
		Возврат "м2";
	ИначеЕсли Единица = "м³" Или Единица = "кубм" Тогда
		Возврат "м3";
	ИначеЕсли Единица = "літр" Или Единица = "литр" Тогда
		Возврат "л";
	ИначеЕсли Единица = "пм" Или Единица = "погм" Или Единица = "мп" Тогда
		Возврат "м";
	КонецЕсли;
	Возврат Единица;

КонецФункции

