// Організація документа в умові віртуальної таблиці; без документа умова прибирається з тексту запиту.
Процедура УстановитьОтборОрганизации(Запрос)

	Если ЗначениеЗаполнено(Документ) И ЗначениеЗаполнено(Документ.Организация) Тогда
		Запрос.УстановитьПараметр("Организация", Документ.Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, " И Организация = &Организация", "");
	КонецЕсли;

КонецПроцедуры

Функция ПериодОстатков()

	Если ЗначениеЗаполнено(Документ) Тогда
		Возврат Новый Граница(КонецДня(Документ.Дата), ВидГраницы.Включая);
	КонецЕсли;
	Возврат Новый Граница(КонецДня(ТекущаяДатаСеанса()), ВидГраницы.Включая);

