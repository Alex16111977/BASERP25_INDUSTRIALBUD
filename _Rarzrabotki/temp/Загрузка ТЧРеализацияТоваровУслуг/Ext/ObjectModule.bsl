	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК С
	|ГДЕ
	|	НЕ С.ПометкаУдаления
	|	И С.Наименование В (""Чорноморськ"", ""Чорноморськ Списання"")";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция СохраненноеСопоставление()

	// спільні для всіх користувачів (окреме ім'я в сховищі) — читання/запис чужих налаштувань потребує привілеїв
	УстановитьПривилегированныйРежим(Истина);
	Сопоставление = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Сопоставление", , ПользовательНастроек());
	УстановитьПривилегированныйРежим(Ложь);
	Если ТипЗнч(Сопоставление) <> Тип("Соответствие") Тогда
		Сопоставление = Новый Соответствие;
	КонецЕсли;
	Возврат Сопоставление;

КонецФункции

Процедура СохранитьСопоставление(Таблица)

	Сопоставление = СохраненноеСопоставление();
	Для Каждого СтрокаФайла Из Таблица Цикл
		Если СтрокаФайла.Подтверждено И ЗначениеЗаполнено(СтрокаФайла.Номенклатура) Тогда
			Сопоставление.Вставить(КлючНазвания(СтрокаФайла.Наименование), СтрокаФайла.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Сопоставление", Сопоставление, , ПользовательНастроек());
	Исключение
		// не критично: наступного разу картки доведеться підтвердити знову
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура СохранитьНастройки()

	Колонки = Новый Структура("ПерваяСтрока, КолонкаНаименование, КолонкаКоличество, КолонкаЕдиница, КолонкаЦена,
		|КолонкаСумма, КолонкаКод, ИскатьВнеОстатков");
	ЗаполнитьЗначенияСвойств(Колонки, ЭтотОбъект);
	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Колонки", Колонки);
		ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Склады", Склады.ВыгрузитьКолонку("Склад"));
	Исключение
		// не критично
	КонецПопытки;

КонецПроцедуры

Функция КлючНастроек()
	Возврат "ВнешняяОбработка.ЗагрузкаТЧРеализацияТоваровУслуг";
КонецФункции

// Відповідності «назва з файлу -> картка» — спільні для всіх бухгалтерів.
Функция ПользовательНастроек()
	Возврат "ОбщиеНастройкиЗагрузкиРеализации";
КонецФункции

Функция ЧислоИзТекста(Знач Текст)

	Текст = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, " ", ""), Символы.НПП, ""), ",", ".");
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ТекстЯчейки(Таб, НомерСтроки, НомерКолонки)
	Возврат Таб.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст;
КонецФункции

// Кладе двійкові дані у тимчасовий файл і читає табличним документом (формат — за розширенням: xls, xlsx).
Функция ПрочитатьТабличныйДокумент(АдресФайла, ИмяФайла, ТекстОшибки)

	Если Не ЭтоАдресВременногоХранилища(АдресФайла) Тогда
		ТекстОшибки = "Файл не вибрано.";
		Возврат Неопределено;
	КонецЕсли;

	Расширение = "xlsx";
	Точка = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Если Точка > 0 Тогда
		Расширение = НРег(Сред(ИмяФайла, Точка + 1));
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	Таб = Новый ТабличныйДокумент;
	Попытка
		ПолучитьИзВременногоХранилища(АдресФайла).Записать(ИмяВременногоФайла);
		Таб.Прочитать(ИмяВременногоФайла);
	Исключение
		ТекстОшибки = "Не вдалося прочитати файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ ". Якщо файл відкритий в Excel — закрийте його і повторіть.";
		Таб = Неопределено;
	КонецПопытки;

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// тимчасовий файл прибере платформа
	КонецПопытки;

	Возврат Таб;

КонецФункции

#КонецОбласти

#КонецЕсли
