// Рахунок залишку номенклатури: спершу на складі документа, інакше на будь-якому складі пошуку.
Функция СчетаОстатковНоменклатуры(МассивНоменклатуры, СкладДокумента)

	Результат = Новый Соответствие;
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ост.Субконто1 КАК Номенклатура,
	|	Ост.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА Ост.Субконто3 = &СкладДокумента
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Приоритет,
	|	Ост.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&Период, , , Субконто3 В (&Склады) И Организация = &Организация) КАК Ост
	|ГДЕ
	|	Ост.Субконто1 В (&Номенклатура)
	|	И Ост.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Количество УБЫВ";
	УстановитьОтборОрганизации(Запрос);
	Запрос.УстановитьПараметр("Период", ПериодОстатков());
	Запрос.УстановитьПараметр("Склады", Склады.ВыгрузитьКолонку("Склад"));
	Запрос.УстановитьПараметр("СкладДокумента", СкладДокумента);
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Получить(Выборка.Номенклатура) = Неопределено Тогда
			Результат.Вставить(Выборка.Номенклатура, Выборка.Счет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НоменклатураПоКоду(Знач Код)

	Найденная = Справочники.Номенклатура.НайтиПоКоду(Код);
	Если Не ЗначениеЗаполнено(Найденная) И СтрДлина(Код) < 11 Тогда
		Найденная = Справочники.Номенклатура.НайтиПоКоду(Прав("00000000000" + Код, 11));
	КонецЕсли;
	Возврат Найденная;

