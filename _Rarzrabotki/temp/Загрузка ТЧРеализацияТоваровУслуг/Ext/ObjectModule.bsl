#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Завантаження накладної Excel у ТЧ «Товари» документа РеализацияТоваровУслуг (BAS Бухгалтерія).
// Два кроки, як у «Загрузка лимитов»: 1) ПрочитатьИСопоставить — аналіз зіставлення рядків файлу з карточками
// номенклатури (код 1С -> запам'ятований вибір -> точна назва -> схожість серед залишків обраних складів -> схожість
// поза залишками); 2) ЗагрузитьВДокумент — лише підтверджені рядки, вибір запам'ятовується.

#Область ОписаниеДляБСП

Функция СведенияОВнешнейОбработке() Экспорт

	Назначения = Новый Массив;
	Назначения.Добавить("Документ.РеализацияТоваровУслуг");

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ЗаполнениеОбъекта");
	ПараметрыРегистрации.Вставить("Назначение", Назначения);
	ПараметрыРегистрации.Вставить("Наименование", "Завантаження з Excel ТЧ Реалізація (зіставлення з залишками)");
	ПараметрыРегистрации.Вставить("Версия", "1.0");
	ПараметрыРегистрации.Вставить("Информация", "Аналіз зіставлення рядків накладної з номенклатурою за залишками "
		+ "складів і завантаження підтверджених рядків у товари реалізації");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	Команда = Команды.Добавить();
	Команда.Представление = "Завантажити з Excel (зіставлення з залишками)";
	Команда.Идентификатор = "ЗагрузкаИзExcel";
	Команда.Использование = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Ложь;
	ПараметрыРегистрации.Вставить("Команды", Команды);

	Возврат ПараметрыРегистрации;

КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Налаштування за замовчуванням і збережені налаштування (колонки, склади). Склад документа додається до складів пошуку.
Процедура ЗаполнитьНастройки(ДокументРеализации = Неопределено) Экспорт

	Если ЗначениеЗаполнено(ДокументРеализации) Тогда
		Документ = ДокументРеализации;
	КонецЕсли;
	ПерваяСтрока = 2;
	КолонкаНаименование = 2;
	КолонкаКоличество = 3;
	КолонкаЕдиница = 4;
	КолонкаЦена = 5;
	КолонкаСумма = 7;
	КолонкаКод = 0;
	ИскатьВнеОстатков = Истина;

	Сохраненные = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Колонки");
	Если ТипЗнч(Сохраненные) = Тип("Структура") Тогда
		// лише збережені поля: старі налаштування можуть не мати нових колонок
		Для Каждого ИмяНастройки Из СтрРазделить("ПерваяСтрока,КолонкаНаименование,КолонкаКоличество,КолонкаЕдиница,КолонкаЦена,КолонкаСумма,КолонкаКод,ИскатьВнеОстатков", ",") Цикл
			Если Сохраненные.Свойство(ИмяНастройки) Тогда
				ЭтотОбъект[ИмяНастройки] = Сохраненные[ИмяНастройки];
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Склады.Очистить();
	СписокСкладов = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Склады");
	Если ТипЗнч(СписокСкладов) <> Тип("Массив") Или СписокСкладов.Количество() = 0 Тогда
		СписокСкладов = СкладыПоУмолчанию();
	КонецЕсли;
	Для Каждого Склад Из СписокСкладов Цикл
		Если ЗначениеЗаполнено(Склад) И Склады.Найти(Склад, "Склад") = Неопределено Тогда
			Склады.Добавить().Склад = Склад;
		КонецЕсли;
	КонецЦикла;
	Если ЗначениеЗаполнено(Документ) И ЗначениеЗаполнено(Документ.Склад)
		И Склады.Найти(Документ.Склад, "Склад") = Неопределено Тогда
		Склады.Добавить().Склад = Документ.Склад;
	КонецЕсли;

КонецПроцедуры

// Крок 1. Читає файл і зіставляє кожен рядок з номенклатурою.
//
// Повертає Структура: Таблица (див. НоваяТаблицаРаспознавания), Варианты (до 5 кандидатів на рядок),
//   Ошибка (Строка), Предупреждения (Строка).
Функция ПрочитатьИСопоставить(АдресФайла, ИмяФайла) Экспорт

	Результат = Новый Структура("Таблица, Варианты, Ошибка, Предупреждения",
		НоваяТаблицаРаспознавания(), НоваяТаблицаВариантов(), "", "");
	ТекстОшибки = "";
	Таб = ПрочитатьТабличныйДокумент(АдресФайла, ИмяФайла, ТекстОшибки);
	Если Таб = Неопределено Тогда
		Результат.Ошибка = ТекстОшибки;
		Возврат Результат;
	ИначеЕсли КолонкаНаименование <= 0 Или КолонкаКоличество <= 0 Тогда
		Результат.Ошибка = "Вкажіть номери колонок назви і кількості.";
		Возврат Результат;
	КонецЕсли;

	Пропущенные = Новый Массив;
	Для НомерСтрокиФайла = Макс(1, ПерваяСтрока) По Таб.ВысотаТаблицы Цикл
		Наименование = СокрЛП(ТекстЯчейки(Таб, НомерСтрокиФайла, КолонкаНаименование));
		ТекстКоличества = СокрЛП(ТекстЯчейки(Таб, НомерСтрокиФайла, КолонкаКоличество));
		Если ПустаяСтрока(Наименование) И ПустаяСтрока(ТекстКоличества) Тогда
			Продолжить;
		КонецЕсли;
		КоличествоФайла = ЧислоИзТекста(ТекстКоличества);
		Если ПустаяСтрока(Наименование) Или КоличествоФайла = Неопределено Или КоличествоФайла = 0 Тогда
			Пропущенные.Добавить(СтрШаблон("рядок %1 (""%2"", кількість ""%3"")", НомерСтрокиФайла,
				Лев(Наименование, 40), ТекстКоличества));
			Продолжить;
		КонецЕсли;
		СтрокаФайла = Результат.Таблица.Добавить();
		СтрокаФайла.НомерСтроки = НомерСтрокиФайла;
		СтрокаФайла.Наименование = Наименование;
		СтрокаФайла.Количество = КоличествоФайла;
		Если КолонкаЕдиница > 0 Тогда
			СтрокаФайла.Единица = СокрЛП(ТекстЯчейки(Таб, НомерСтрокиФайла, КолонкаЕдиница));
		КонецЕсли;
		Если КолонкаЦена > 0 Тогда
			Цена = ЧислоИзТекста(ТекстЯчейки(Таб, НомерСтрокиФайла, КолонкаЦена));
			СтрокаФайла.Цена = ?(Цена = Неопределено, 0, Цена);
		КонецЕсли;
		Если КолонкаСумма > 0 Тогда
			СуммаФайла = ЧислоИзТекста(ТекстЯчейки(Таб, НомерСтрокиФайла, КолонкаСумма));
			СтрокаФайла.Сумма = ?(СуммаФайла = Неопределено, 0, СуммаФайла);
		КонецЕсли;
		Если КолонкаКод > 0 Тогда
			СтрокаФайла.Код = СокрЛП(ТекстЯчейки(Таб, НомерСтрокиФайла, КолонкаКод));
		КонецЕсли;
	КонецЦикла;

	Если Результат.Таблица.Количество() = 0 Тогда
		Результат.Ошибка = "У файлі не знайдено рядків з назвою і кількістю — перевірте номери колонок і першого рядка.";
		Возврат Результат;
	КонецЕсли;
	Если Пропущенные.Количество() > 0 Тогда
		Результат.Предупреждения = "Пропущено рядки файлу без назви або кількості: " + СтрСоединить(Пропущенные, "; ") + ".";
	КонецЕсли;

	Сопоставить(Результат.Таблица, Результат.Варианты);
	Для Каждого СтрокаФайла Из Результат.Таблица Цикл
		СтрокаФайла.АвтоНоменклатура = СтрокаФайла.Номенклатура;
		СтрокаФайла.АвтоСпособ = СтрокаФайла.Способ;
		СтрокаФайла.АвтоСходство = СтрокаФайла.Сходство;
	КонецЦикла;
	СохранитьНастройки();
	Возврат Результат;

КонецФункции

// Крок 2. Заповнює товари документа підтвердженими рядками і записує документ (без проведення); прикріплює до
// документа вихідний файл і журнал зіставлення (історія: що запропоновано автоматично, що вибрав бухгалтер).
// Повертає Структура: Строк, Сумма, Пропущено (непідтверджені), Ошибка, Предупреждения.
Функция ЗагрузитьВДокумент(Таблица, АдресФайла = "", ИмяФайла = "") Экспорт

	Результат = Новый Структура("Строк, Сумма, Пропущено, Ошибка, Предупреждения", 0, 0, 0, "", "");
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Результат.Ошибка = "Не вибрано документ реалізації.";
		Возврат Результат;
	ИначеЕсли Документ.Проведен Тогда
		Результат.Ошибка = "Документ проведено — скасуйте проведення і повторіть завантаження.";
		Возврат Результат;
	КонецЕсли;

	Попытка
		ДокОбъект = Документ.ПолучитьОбъект();
		ДокОбъект.Заблокировать();
	Исключение
		Результат.Ошибка = "Документ заблоковано іншим користувачем або відкрито зі змінами: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Заполнение = ЗаполнитьТоварыДокумента(ДокОбъект, Таблица);
	Если Заполнение.Строк = 0 Тогда
		Результат.Ошибка = "Немає підтверджених рядків з номенклатурою — позначте «✓» у таблиці.";
		Возврат Результат;
	КонецЕсли;

	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Результат.Ошибка = "Документ не записано: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	СохранитьСопоставление(Таблица);
	ЗаполнитьЗначенияСвойств(Результат, Заполнение, "Строк, Сумма, Пропущено, Предупреждения");
	ОшибкаПрикрепления = ПрикрепитьФайлыЗагрузки(Документ, Таблица, АдресФайла, ИмяФайла);
	Если Не ПустаяСтрока(ОшибкаПрикрепления) Тогда
		Результат.Предупреждения = СокрЛП(Результат.Предупреждения + Символы.ПС
			+ "Файли до документа не прикріплено: " + ОшибкаПрикрепления);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Прикріплює до документа (БСП «Приєднані файли») вихідний файл і журнал зіставлення xlsx. Повертає текст помилки.
Функция ПрикрепитьФайлыЗагрузки(ДокументСсылка, Таблица, АдресФайла, ИмяФайла)

	Попытка
		Момент = ТекущаяДатаСеанса();
		Автор = Пользователи.ТекущийПользователь();
		Подтверждено = 0;
		Вручную = 0;
		Для Каждого СтрокаФайла Из Таблица Цикл
			Если СтрокаФайла.Подтверждено И ЗначениеЗаполнено(СтрокаФайла.Номенклатура) Тогда
				Подтверждено = Подтверждено + 1;
				Если СтрокаФайла.Номенклатура <> СтрокаФайла.АвтоНоменклатура Тогда
					Вручную = Вручную + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Описание = СтрШаблон("Завантаження з Excel %1 (%2): рядків %3, завантажено %4, виправлено бухгалтером %5",
			Формат(Момент, "ДФ='dd.MM.yyyy HH:mm'"), Строка(Автор), Таблица.Количество(), Подтверждено, Вручную);

		ИмяБезРасширения = ИмяФайла;
		Расширение = "xlsx";
		Точка = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
		Если Точка > 0 Тогда
			ИмяБезРасширения = Лев(ИмяФайла, Точка - 1);
			Расширение = НРег(Сред(ИмяФайла, Точка + 1));
		КонецЕсли;
		Слеш = Макс(СтрНайти(ИмяБезРасширения, "\", НаправлениеПоиска.СКонца), СтрНайти(ИмяБезРасширения, "/", НаправлениеПоиска.СКонца));
		Если Слеш > 0 Тогда
			ИмяБезРасширения = Сред(ИмяБезРасширения, Слеш + 1);
		КонецЕсли;

		Если ЭтоАдресВременногоХранилища(АдресФайла) Тогда
			ДобавитьПрисоединенныйФайл(ДокументСсылка, Автор, ИмяБезРасширения, Расширение, АдресФайла,
				"Вихідний файл. " + Описание);
		КонецЕсли;
		АдресЖурнала = ПоместитьВоВременноеХранилище(ДвоичныеДанныеЖурнала(Таблица, Автор, Момент, ДокументСсылка));
		ДобавитьПрисоединенныйФайл(ДокументСсылка, Автор, "Журнал зіставлення " + ИмяБезРасширения + " "
			+ Формат(Момент, "ДФ='yyyy-MM-dd HH-mm'"), "xlsx", АдресЖурнала, Описание);
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат "";

КонецФункции

Процедура ДобавитьПрисоединенныйФайл(Владелец, Автор, ИмяБезРасширения, Расширение, Адрес, Описание)

	ПараметрыФайла = Новый Структура;
	ПараметрыФайла.Вставить("Автор", Автор);
	ПараметрыФайла.Вставить("ВладелецФайлов", Владелец);
	ПараметрыФайла.Вставить("ИмяБезРасширения", ИмяБезРасширения);
	ПараметрыФайла.Вставить("РасширениеБезТочки", Расширение);
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", ТекущаяУниверсальнаяДата()); // БСП читає без перевірки
	РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Адрес, , Описание);

КонецПроцедуры

// Журнал зіставлення (дані для навчання): по рядку файлу — автопідбір обробки і остаточний вибір бухгалтера.
Функция ДвоичныеДанныеЖурнала(Таблица, Автор, Момент, ДокументСсылка)

	Таб = Новый ТабличныйДокумент;
	Заголовки = СтрРазделить("Рядок файлу|Назва з файлу|Кількість|Од.|Ціна без ПДВ|Сума без ПДВ|"
		+ "Автопідбір: номенклатура|Автопідбір: код|Автопідбір: спосіб|Автопідбір: схожість, %|"
		+ "Обрано: номенклатура|Обрано: код|Обрано: спосіб|Завантажено|Виправлено бухгалтером|Пояснення|"
		+ "Користувач|Дата|Документ", "|");
	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Таб.Область(1, Индекс + 1, 1, Индекс + 1).Текст = Заголовки[Индекс];
	КонецЦикла;
	НомерСтрокиТаб = 1;
	Для Каждого СтрокаФайла Из Таблица Цикл
		НомерСтрокиТаб = НомерСтрокиТаб + 1;
		Загружено = СтрокаФайла.Подтверждено И ЗначениеЗаполнено(СтрокаФайла.Номенклатура);
		Исправлено = Загружено И СтрокаФайла.Номенклатура <> СтрокаФайла.АвтоНоменклатура;
		Значения = Новый Массив;
		Значения.Добавить(Формат(СтрокаФайла.НомерСтроки, "ЧГ=0"));
		Значения.Добавить(СтрокаФайла.Наименование);
		Значения.Добавить(Формат(СтрокаФайла.Количество, "ЧРД=,; ЧГ=0"));
		Значения.Добавить(СтрокаФайла.Единица);
		Значения.Добавить(Формат(СтрокаФайла.Цена, "ЧРД=,; ЧГ=0"));
		Значения.Добавить(Формат(СтрокаФайла.Сумма, "ЧРД=,; ЧГ=0"));
		Значения.Добавить(?(ЗначениеЗаполнено(СтрокаФайла.АвтоНоменклатура), Строка(СтрокаФайла.АвтоНоменклатура), ""));
		Значения.Добавить(?(ЗначениеЗаполнено(СтрокаФайла.АвтоНоменклатура), СтрокаФайла.АвтоНоменклатура.Код, ""));
		Значения.Добавить(СтрокаФайла.АвтоСпособ);
		Значения.Добавить(Формат(СтрокаФайла.АвтоСходство, "ЧГ=0"));
		Значения.Добавить(?(ЗначениеЗаполнено(СтрокаФайла.Номенклатура), Строка(СтрокаФайла.Номенклатура), ""));
		Значения.Добавить(?(ЗначениеЗаполнено(СтрокаФайла.Номенклатура), СтрокаФайла.Номенклатура.Код, ""));
		Значения.Добавить(СтрокаФайла.Способ);
		Значения.Добавить(?(Загружено, "так", "ні"));
		Значения.Добавить(?(Исправлено, "так", "ні"));
		Значения.Добавить(СтрокаФайла.Пояснение);
		Значения.Добавить(Строка(Автор));
		Значения.Добавить(Формат(Момент, "ДФ='dd.MM.yyyy HH:mm'"));
		Значения.Добавить(Строка(ДокументСсылка));
		Для Индекс = 0 По Значения.ВГраница() Цикл
			Таб.Область(НомерСтрокиТаб, Индекс + 1, НомерСтрокиТаб, Индекс + 1).Текст = Значения[Индекс];
		КонецЦикла;
	КонецЦикла;
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	Таб.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
	Данные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// тимчасовий файл прибере платформа
	КонецПопытки;
	Возврат Данные;

КонецФункции

// Заповнює ТЧ «Товари» об'єкта документа (без запису) — типовим обробником вибору номенклатури (рахунки, ставка
// ПДВ, одиниця), далі кількість у одиниці картки, ціна з файлу, суми; рахунок обліку — рахунок залишку на складах.
Функция ЗаполнитьТоварыДокумента(ДокОбъект, Таблица) Экспорт

	Результат = Новый Структура("Строк, Сумма, Пропущено, Предупреждения", 0, 0, 0, "");
	Предупреждения = Новый Массив;
	Если ОчиститьТовары Тогда
		ДокОбъект.Товары.Очистить();
	КонецЕсли;

	ДанныеОбъекта = Новый Структура("Дата, ВидОперации, Организация, Склад, ТипЦен, ВалютаДокумента,
		|КурсВзаиморасчетов, КратностьВзаиморасчетов, СуммаВключаетНДС, ДоговорКонтрагента, ЭтоКомиссия, Реализация");
	ЗаполнитьЗначенияСвойств(ДанныеОбъекта, ДокОбъект);
	ДанныеОбъекта.ЭтоКомиссия = ЗначениеЗаполнено(ДокОбъект.ДоговорКонтрагента)
		И ДокОбъект.ДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером;
	ДанныеОбъекта.Реализация = Истина;

	МассивНоменклатуры = Новый Массив;
	Для Каждого СтрокаФайла Из Таблица Цикл
		Если СтрокаФайла.Подтверждено И ЗначениеЗаполнено(СтрокаФайла.Номенклатура) Тогда
			МассивНоменклатуры.Добавить(СтрокаФайла.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	СчетаОстатков = СчетаОстатковНоменклатуры(МассивНоменклатуры, ДокОбъект.Склад);

	Для Каждого СтрокаФайла Из Таблица Цикл
		Если Не СтрокаФайла.Подтверждено Или Не ЗначениеЗаполнено(СтрокаФайла.Номенклатура) Тогда
			Результат.Пропущено = Результат.Пропущено + 1;
			Продолжить;
		КонецЕсли;
		СтрокаТоваров = ДокОбъект.Товары.Добавить();
		СтрокаТоваров.Номенклатура = СтрокаФайла.Номенклатура;
		РеализацияТоваровУслугФормы.ТоварыНоменклатураПриИзмененииНаСервере(СтрокаТоваров, ДанныеОбъекта);

		КоэффициентЕдиниц = КоэффициентПересчета(СтрокаФайла.Единица, Строка(СтрокаФайла.Номенклатура.БазоваяЕдиницаИзмерения));
		Если КоэффициентЕдиниц = Неопределено Тогда
			КоэффициентЕдиниц = 1;
			Предупреждения.Добавить(СтрШаблон("рядок %1: одиниця файлу «%2» ≠ одиниці картки «%3» — кількість перенесено "
				+ "без перерахунку", СтрокаФайла.НомерСтроки, СтрокаФайла.Единица,
				СтрокаФайла.Номенклатура.БазоваяЕдиницаИзмерения));
		КонецЕсли;
		СтрокаТоваров.Количество = СтрокаФайла.Количество * КоэффициентЕдиниц;
		Если СтрокаФайла.Цена > 0 Тогда
			ЦенаБезНДС = СтрокаФайла.Цена / КоэффициентЕдиниц;
			Если ДокОбъект.СуммаВключаетНДС Тогда
				СтрокаТоваров.Цена = Окр(ЦенаБезНДС * (100 + УчетНДС.ПолучитьСтавкуНДС(СтрокаТоваров.СтавкаНДС)) / 100, 2);
			Иначе
				СтрокаТоваров.Цена = Окр(ЦенаБезНДС, 2);
			КонецЕсли;
		КонецЕсли;
		СчетОстатка = СчетаОстатков.Получить(СтрокаФайла.Номенклатура);
		Если СчетОстатка <> Неопределено И СчетОстатка <> СтрокаТоваров.СчетУчетаБУ Тогда
			СтрокаТоваров.СчетУчетаБУ = СчетОстатка;
		КонецЕсли;
		Если СтрокаФайла.Сумма > 0 И СтрокаТоваров.Количество <> 0 Тогда
			// сума рядка — як у накладній (кількість у документі округлюється до 3 знаків): ціна = сума / кількість
			СуммаСтроки = СтрокаФайла.Сумма;
			Если ДокОбъект.СуммаВключаетНДС Тогда
				СуммаСтроки = Окр(СуммаСтроки * (100 + УчетНДС.ПолучитьСтавкуНДС(СтрокаТоваров.СтавкаНДС)) / 100, 2);
			КонецЕсли;
			СтрокаТоваров.Цена = Окр(СуммаСтроки / СтрокаТоваров.Количество, 2);
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуТабЧасти(СтрокаТоваров);
			СтрокаТоваров.Сумма = СуммаСтроки;
			СтрокаТоваров.СуммаБезСкидки = СуммаСтроки + СтрокаТоваров.СуммаСкидки;
		Иначе
			ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуТабЧасти(СтрокаТоваров);
		КонецЕсли;
		ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаТоваров, ДокОбъект.СуммаВключаетНДС);
		Результат.Строк = Результат.Строк + 1;
		Результат.Сумма = Результат.Сумма + СтрокаТоваров.Сумма;
	КонецЦикла;

	Результат.Предупреждения = СтрСоединить(Предупреждения, Символы.ПС);
	Возврат Результат;

КонецФункции

// Залишок номенклатури на складах пошуку: Структура(Количество, Склады — текст «склад кількість; …»).
Функция ДанныеОстатка(Номенклатура) Экспорт

	Массив = Новый Массив;
	Массив.Добавить(Номенклатура);
	Кандидаты = КандидатыИзОстатков(Массив);
	Если Кандидаты.Количество() = 0 Тогда
		Возврат Новый Структура("Количество, Склады", 0, "");
	КонецЕсли;
	Возврат Новый Структура("Количество, Склады", Кандидаты[0].Остаток, Кандидаты[0].Склады);

КонецФункции

// Табличний документ для вивантаження: рядки файлу з кодом і назвою картки (наступне завантаження — за кодом).
Функция ДвоичныеДанныеExcelСКодами(Таблица) Экспорт

	Таб = Новый ТабличныйДокумент;
	Заголовки = СтрРазделить("N|Назва з файлу|Кількість|Од.вим.|Ціна без ПДВ|Код 1С|Сума без ПДВ|Номенклатура 1С|Спосіб", "|");
	Для Индекс = 0 По Заголовки.ВГраница() Цикл
		Таб.Область(1, Индекс + 1, 1, Индекс + 1).Текст = Заголовки[Индекс];
	КонецЦикла;
	НомерСтрокиТаб = 1;
	Для Каждого СтрокаФайла Из Таблица Цикл
		НомерСтрокиТаб = НомерСтрокиТаб + 1;
		Таб.Область(НомерСтрокиТаб, 1, НомерСтрокиТаб, 1).Текст = Формат(НомерСтрокиТаб - 1, "ЧГ=0");
		Таб.Область(НомерСтрокиТаб, 2, НомерСтрокиТаб, 2).Текст = СтрокаФайла.Наименование;
		Таб.Область(НомерСтрокиТаб, 3, НомерСтрокиТаб, 3).Текст = Формат(СтрокаФайла.Количество, "ЧРД=,; ЧГ=0");
		Таб.Область(НомерСтрокиТаб, 4, НомерСтрокиТаб, 4).Текст = СтрокаФайла.Единица;
		Таб.Область(НомерСтрокиТаб, 5, НомерСтрокиТаб, 5).Текст = Формат(СтрокаФайла.Цена, "ЧРД=,; ЧГ=0");
		Если ЗначениеЗаполнено(СтрокаФайла.Номенклатура) Тогда
			Таб.Область(НомерСтрокиТаб, 6, НомерСтрокиТаб, 6).Текст = СтрокаФайла.Номенклатура.Код;
			Таб.Область(НомерСтрокиТаб, 8, НомерСтрокиТаб, 8).Текст = Строка(СтрокаФайла.Номенклатура);
		КонецЕсли;
		Таб.Область(НомерСтрокиТаб, 7, НомерСтрокиТаб, 7).Текст = Формат(СтрокаФайла.Сумма, "ЧРД=,; ЧГ=0");
		Таб.Область(НомерСтрокиТаб, 9, НомерСтрокиТаб, 9).Текст = СтрокаФайла.Способ;
	КонецЦикла;
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	Таб.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
	Данные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// тимчасовий файл прибере платформа
	КонецПопытки;
	Возврат Данные;

КонецФункции

Процедура ЗабытьСоответствие(Наименование) Экспорт

	Сопоставление = СохраненноеСопоставление();
	Сопоставление.Удалить(КлючНазвания(Наименование));
	УстановитьПривилегированныйРежим(Истина);
	ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Сопоставление", Сопоставление, , ПользовательНастроек());
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция СпособКод() Экспорт
	Возврат "За кодом 1С";
КонецФункции

Функция СпособЗапомнено() Экспорт
	Возврат "Вибрано раніше";
КонецФункции

Функция СпособТочно() Экспорт
	Возврат "Точна назва";
КонецФункции

Функция СпособПохоже() Экспорт
	Возврат "Схоже — перевірте";
КонецФункции

Функция СпособВнеОстатков() Экспорт
	Возврат "Поза залишками — перевірте";
КонецФункции

Функция СпособНеНайдено() Экспорт
	Возврат "Не знайдено — виберіть";
КонецФункции

Функция ПорогПодсказки() Экспорт
	Возврат 60;
КонецФункции

#КонецОбласти

#Область Сопоставление

// Порядок: код 1С -> запам'ятований вибір -> точна назва (залишки, потім довідник) -> схожість серед залишків ->
// схожість поза залишками (якщо дозволено). Автопідтвердження — лише для коду, запам'ятованого і точної назви.
Процедура Сопоставить(Таблица, Варианты)

	Кандидаты = КандидатыИзОстатков();
	Индекс = ИндексКандидатов(Кандидаты);
	Сопоставление = СохраненноеСопоставление();
	ПоТочномуКлючу = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		ПоТочномуКлючу.Вставить(Кандидат.Ключ, Кандидат);
	КонецЦикла;

	Для Каждого СтрокаФайла Из Таблица Цикл
		Ключ = КлючНазвания(СтрокаФайла.Наименование);
		Признаки = ПризнакиНазвания(СтрокаФайла.Наименование);

		// 1. код 1С
		Если Не ПустаяСтрока(СтрокаФайла.Код) Тогда
			ПоКоду = НоменклатураПоКоду(СтрокаФайла.Код);
			Если ЗначениеЗаполнено(ПоКоду) Тогда
				УстановитьВыбор(СтрокаФайла, ПоКоду, СпособКод(), 100, Истина, Кандидаты);
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		// 2. запам'ятований вибір
		Запомненное = Сопоставление.Получить(Ключ);
		Если ЗначениеЗаполнено(Запомненное) И Не Запомненное.ПометкаУдаления Тогда
			УстановитьВыбор(СтрокаФайла, Запомненное, СпособЗапомнено(), 100, Истина, Кандидаты);
			Продолжить;
		КонецЕсли;

		// 3. точна назва
		Точный = ПоТочномуКлючу.Получить(Ключ);
		Если Точный <> Неопределено Тогда
			УстановитьВыбор(СтрокаФайла, Точный.Ссылка, СпособТочно(), 100, Истина, Кандидаты);
			Продолжить;
		КонецЕсли;

		// 4. схожість серед залишків
		Лучшие = ЛучшиеКандидаты(Признаки, Кандидаты, Индекс, 5);
		Если ИскатьВнеОстатков И (Лучшие.Количество() = 0 Или Лучшие[0].Сходство < ПорогПодсказки()) Тогда
			ПоказатьВнеОстатков = Истина;
			Точный = ТочнаяНоменклатураВСправочнике(СтрокаФайла.Наименование);
			Если ЗначениеЗаполнено(Точный) Тогда
				УстановитьВыбор(СтрокаФайла, Точный, СпособТочно(), 100, Истина, Кандидаты);
				ПоказатьВнеОстатков = Ложь;
			КонецЕсли;
			Если ПоказатьВнеОстатков Тогда
				КандидатыСправочника = КандидатыИзСправочника(Признаки);
				ЛучшиеСправочника = ЛучшиеКандидаты(Признаки, КандидатыСправочника, ИндексКандидатов(КандидатыСправочника), 5);
				Для Каждого Вариант Из ЛучшиеСправочника Цикл
					Вариант.Пояснение = "без залишку; " + Вариант.Пояснение;
				КонецЦикла;
				Лучшие = ОбъединитьЛучшие(Лучшие, ЛучшиеСправочника, 5);
			КонецЕсли;
		КонецЕсли;
		Для Каждого Вариант Из Лучшие Цикл
			НовыйВариант = Варианты.Добавить();
			НовыйВариант.НомерСтроки = СтрокаФайла.НомерСтроки;
			ЗаполнитьЗначенияСвойств(НовыйВариант, Вариант, "Номенклатура, Сходство, Остаток, Склад, Пояснение");
		КонецЦикла;
		Если ЗначениеЗаполнено(СтрокаФайла.Номенклатура) Тогда
			Продолжить; // точна назва в довіднику
		КонецЕсли;
		Если Лучшие.Количество() > 0 И Лучшие[0].Сходство >= ПорогПодсказки() Тогда
			Способ = ?(Лучшие[0].Остаток > 0, СпособПохоже(), СпособВнеОстатков());
			УстановитьВыбор(СтрокаФайла, Лучшие[0].Номенклатура, Способ, Лучшие[0].Сходство, Ложь, Кандидаты);
			СтрокаФайла.Пояснение = Лучшие[0].Пояснение;
		Иначе
			СтрокаФайла.Способ = СпособНеНайдено();
			СтрокаФайла.Пояснение = ?(Лучшие.Количество() = 0, "кандидатів немає",
				"найкращий " + Формат(Лучшие[0].Сходство, "ЧН=0") + " %: " + Лучшие[0].Пояснение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьВыбор(СтрокаФайла, Номенклатура, Способ, Сходство, Подтверждено, Кандидаты)

	СтрокаФайла.Номенклатура = Номенклатура;
	СтрокаФайла.Способ = Способ;
	СтрокаФайла.Сходство = Сходство;
	СтрокаФайла.Подтверждено = Подтверждено;
	СтрокаФайла.ЕдиницаКарточки = Строка(Номенклатура.БазоваяЕдиницаИзмерения);
	Для Каждого Кандидат Из Кандидаты Цикл
		Если Кандидат.Ссылка = Номенклатура Тогда
			СтрокаФайла.Остаток = Кандидат.Остаток;
			СтрокаФайла.СкладОстатка = Кандидат.Склады;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если КоэффициентПересчета(СтрокаФайла.Единица, СтрокаФайла.ЕдиницаКарточки) = Неопределено Тогда
		СтрокаФайла.Пояснение = "одиниці різні: файл «" + СтрокаФайла.Единица + "», картка «"
			+ СтрокаФайла.ЕдиницаКарточки + "» — перевірте кількість";
	КонецЕсли;

КонецПроцедуры

// Кандидати: номенклатура з залишком на складах пошуку. Масив Структура(Ссылка, Наименование, Ключ, Остаток,
// Склады + ознаки назви: Размеры, Марки, Стандарты, Слова, Триграммы, Тип, Сторона).
Функция КандидатыИзОстатков(ОтборНоменклатуры = Неопределено)

	МассивСкладов = Склады.ВыгрузитьКолонку("Склад");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ост.Субконто1 КАК Номенклатура,
	|	Ост.Субконто3 КАК Склад,
	|	СУММА(Ост.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ВТОстатки
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&Период, , , Субконто3 В (&Склады)) КАК Ост
	|ГДЕ
	|	Ост.Субконто1 ССЫЛКА Справочник.Номенклатура
	|	И (&БезОтбора
	|			ИЛИ Ост.Субконто1 В (&Номенклатура))
	|
	|СГРУППИРОВАТЬ ПО
	|	Ост.Субконто1,
	|	Ост.Субконто3
	|
	|ИМЕЮЩИЕ
	|	СУММА(Ост.КоличествоОстаток) > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Номенклатура КАК Номенклатура,
	|	ВТ.Номенклатура.Наименование КАК Наименование,
	|	ВТ.Склад.Наименование КАК ИмяСклада,
	|	ВТ.Количество КАК Количество
	|ИЗ
	|	ВТОстатки КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование,
	|	ИмяСклада";
	Запрос.УстановитьПараметр("Период", ПериодОстатков());
	Запрос.УстановитьПараметр("Склады", МассивСкладов);
	Запрос.УстановитьПараметр("БезОтбора", ОтборНоменклатуры = Неопределено);
	Запрос.УстановитьПараметр("Номенклатура", ?(ОтборНоменклатуры = Неопределено, Новый Массив, ОтборНоменклатуры));

	Кандидаты = Новый Массив;
	ПоСсылке = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кандидат = ПоСсылке.Получить(Выборка.Номенклатура);
		Если Кандидат = Неопределено Тогда
			Кандидат = НовыйКандидат(Выборка.Номенклатура, Выборка.Наименование);
			ПоСсылке.Вставить(Выборка.Номенклатура, Кандидат);
			Кандидаты.Добавить(Кандидат);
		КонецЕсли;
		Кандидат.Остаток = Кандидат.Остаток + Выборка.Количество;
		Кандидат.Склады = Кандидат.Склады + ?(ПустаяСтрока(Кандидат.Склады), "", "; ") + СокрЛП(Выборка.ИмяСклада) + " "
			+ Формат(Выборка.Количество, "ЧДЦ=3; ЧРГ=' '; ЧН=0");
	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

// Кандидати поза залишками: картки довідника, у назві яких є тип виробу (основа 4 літери першого слова файлу).
Функция КандидатыИзСправочника(Признаки)

	Кандидаты = Новый Массив;
	Если Признаки.Тип = "" Тогда
		Возврат Кандидаты;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 500
	|	Н.Ссылка КАК Ссылка,
	|	Н.Наименование КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И Н.Наименование ПОДОБНО &Шаблон";
	Запрос.УстановитьПараметр("Шаблон", "%" + Признаки.Тип + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Кандидаты.Добавить(НовыйКандидат(Выборка.Ссылка, Выборка.Наименование));
	КонецЦикла;
	Возврат Кандидаты;

КонецФункции

Функция НовыйКандидат(Ссылка, Наименование)

	Кандидат = Новый Структура("Ссылка, Наименование, Ключ, Остаток, Склады",
		Ссылка, Наименование, КлючНазвания(Наименование), 0, "");
	Признаки = ПризнакиНазвания(Наименование);
	Для Каждого Элемент Из Признаки Цикл
		Кандидат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	Возврат Кандидат;

КонецФункции

// Обернена частота триграм серед кандидатів (IDF) для косинусної міри.
Функция ИндексКандидатов(Кандидаты)

	ДокументовСТриграммой = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		Для Каждого Элемент Из Кандидат.Триграммы Цикл
			Счетчик = ДокументовСТриграммой.Получить(Элемент.Ключ);
			ДокументовСТриграммой.Вставить(Элемент.Ключ, ?(Счетчик = Неопределено, 1, Счетчик + 1));
		КонецЦикла;
	КонецЦикла;
	Всего = Макс(1, Кандидаты.Количество());
	IDF = Новый Соответствие;
	Для Каждого Элемент Из ДокументовСТриграммой Цикл
		IDF.Вставить(Элемент.Ключ, Log((1 + Всего) / (1 + Элемент.Значение)) + 1);
	КонецЦикла;
	Возврат IDF;

КонецФункции

// До N кандидатів з найбільшою схожістю (≥ 20 %), за спаданням. Елемент: Структура(Номенклатура, Сходство, Остаток,
// Склад, Пояснение).
Функция ЛучшиеКандидаты(Признаки, Кандидаты, IDF, Количество)

	Оценки = Новый ТаблицаЗначений;
	Оценки.Колонки.Добавить("Индекс", Новый ОписаниеТипов("Число"));
	Оценки.Колонки.Добавить("Сходство", Новый ОписаниеТипов("Число"));
	Оценки.Колонки.Добавить("Пояснение", Новый ОписаниеТипов("Строка"));
	Для Индекс = 0 По Кандидаты.ВГраница() Цикл
		Оценка = ОценкаСходства(Признаки, Кандидаты[Индекс], IDF);
		Если Оценка.Сходство >= 20 Тогда
			НоваяОценка = Оценки.Добавить();
			НоваяОценка.Индекс = Индекс;
			НоваяОценка.Сходство = Оценка.Сходство;
			НоваяОценка.Пояснение = Оценка.Пояснение;
		КонецЕсли;
	КонецЦикла;
	Оценки.Сортировать("Сходство Убыв");

	Лучшие = Новый Массив;
	Для Каждого СтрокаОценки Из Оценки Цикл
		Кандидат = Кандидаты[СтрокаОценки.Индекс];
		Лучшие.Добавить(Новый Структура("Номенклатура, Сходство, Остаток, Склад, Пояснение", Кандидат.Ссылка,
			СтрокаОценки.Сходство, Кандидат.Остаток, Кандидат.Склады, СтрокаОценки.Пояснение));
		Если Лучшие.Количество() >= Количество Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Лучшие;

КонецФункции

Функция ОбъединитьЛучшие(Первые, Вторые, Количество)

	Все = Новый ТаблицаЗначений;
	Все.Колонки.Добавить("Вариант");
	Все.Колонки.Добавить("Сходство", Новый ОписаниеТипов("Число"));
	Для Каждого Вариант Из Первые Цикл
		НоваяСтрока = Все.Добавить();
		НоваяСтрока.Вариант = Вариант;
		НоваяСтрока.Сходство = Вариант.Сходство;
	КонецЦикла;
	Для Каждого Вариант Из Вторые Цикл
		НоваяСтрока = Все.Добавить();
		НоваяСтрока.Вариант = Вариант;
		НоваяСтрока.Сходство = Вариант.Сходство;
	КонецЦикла;
	Все.Сортировать("Сходство Убыв");
	Результат = Новый Массив;
	Добавленные = Новый Соответствие;
	Для Каждого СтрокаВсех Из Все Цикл
		Если Добавленные.Получить(СтрокаВсех.Вариант.Номенклатура) = Неопределено Тогда
			Добавленные.Вставить(СтрокаВсех.Вариант.Номенклатура, Истина);
			Результат.Добавить(СтрокаВсех.Вариант);
		КонецЕсли;
		Если Результат.Количество() >= Количество Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Схожість 0–100 (гібрид за дослідженням string_grouper/rapidfuzz/splink, 09.10.2026):
//  T — косинус TF-IDF символьних триграм слів (стійкий до відмінків, порядку слів, регістру, латиниці/кирилиці);
//  N — частка розмірів файлу, знайдених у картці (мультимножина), з легким штрафом за зайві розміри картки;
//  Сходство = 100 × (0,5·T + 0,5·N) × множники (інший стандарт ×0,8; інша марка ×0,9), далі «судді»-стелі:
//   розмір файлу відсутній у картці — не вище 49; тип виробу (перше слово, двобічно) не збігся — не вище 40;
//   праві/ліві — не вище 49; розміри лише у файлі — не вище 70. Зони: ≥ 85 — підтвердити, 60–84 — перевірити.
Функция ОценкаСходства(Признаки, Кандидат, IDF)

	T = КосинусТриграмм(Признаки.Триграммы, Кандидат.Триграммы, IDF);

	// розміри: мультимножинний перетин
	Остаток = Новый Массив;
	Для Каждого Размер Из Кандидат.Размеры Цикл
		Остаток.Добавить(Размер);
	КонецЦикла;
	Совпали = Новый Массив;
	Нет = Новый Массив;
	Для Каждого Размер Из Признаки.Размеры Цикл
		Позиция = Остаток.Найти(Размер);
		Если Позиция <> Неопределено Тогда
			Совпали.Добавить(Размер);
			Остаток.Удалить(Позиция);
		Иначе
			Нет.Добавить(Размер);
		КонецЕсли;
	КонецЦикла;
	Если Признаки.Размеры.Количество() = 0 Тогда
		N = ?(Кандидат.Размеры.Количество() = 0, T, 0.7);
	Иначе
		N = Совпали.Количество() / Признаки.Размеры.Количество() * (1 - 0.05 * Мин(Остаток.Количество(), 4));
	КонецЕсли;

	Множитель = 1;
	Примечания = Новый Массив;
	Если Признаки.Стандарты.Количество() > 0 И Кандидат.Стандарты.Количество() > 0
		И Не ЕстьПересечение(Признаки.Стандарты, Кандидат.Стандарты) Тогда
		Множитель = Множитель * 0.8;
		Примечания.Добавить("інший стандарт (" + СтрСоединить(Кандидат.Стандарты, ", ") + ")");
	КонецЕсли;
	Если Признаки.Марки.Количество() > 0 И Кандидат.Марки.Количество() > 0
		И Не ЕстьПересечение(Признаки.Марки, Кандидат.Марки) Тогда
		Множитель = Множитель * 0.9;
		Примечания.Добавить("інша марка (" + СтрСоединить(Кандидат.Марки, ", ") + ")");
	КонецЕсли;
	Сходство = Окр(100 * (0.5 * T + 0.5 * N) * Множитель);

	Если Нет.Количество() > 0 И Кандидат.Размеры.Количество() > 0 Тогда
		Сходство = Мин(Сходство, 49);
	ИначеЕсли Признаки.Размеры.Количество() > 0 И Кандидат.Размеры.Количество() = 0 Тогда
		Сходство = Мин(Сходство, 70);
		Примечания.Добавить("у картці немає розмірів");
	КонецЕсли;
	// тип виробу: однаковий, або кожен тип є серед слів іншої назви («Настил решітковий» = «Решітковий настил»;
	// «Швелер …» ≠ «Кріплення … до швелера»)
	ТипЗбігся = Признаки.Тип = "" Или Кандидат.Тип = "" Или Признаки.Тип = Кандидат.Тип
		Или (ЕстьСловоСОсновой(Кандидат.Слова, Признаки.Тип) И ЕстьСловоСОсновой(Признаки.Слова, Кандидат.Тип));
	Если Не ТипЗбігся Тогда
		Сходство = Мин(Сходство, 40);
		Примечания.Добавить("інший тип виробу");
	КонецЕсли;
	Если Признаки.Сторона <> "" И Кандидат.Сторона <> "" И Признаки.Сторона <> Кандидат.Сторона Тогда
		Сходство = Мин(Сходство, 49);
		Примечания.Добавить("інша сторона (праві/ліві)");
	КонецЕсли;

	Пояснение = "слова " + Формат(Окр(100 * T), "ЧН=0") + " %";
	Если Совпали.Количество() > 0 Тогда
		Пояснение = Пояснение + "; розміри збіглися: " + СтрСоединить(Совпали, ", ");
	КонецЕсли;
	Если Нет.Количество() > 0 Тогда
		Пояснение = Пояснение + "; НЕМАЄ розмірів: " + СтрСоединить(Нет, ", ");
	КонецЕсли;
	Если Примечания.Количество() > 0 Тогда
		Пояснение = Пояснение + "; " + СтрСоединить(Примечания, "; ");
	КонецЕсли;
	Возврат Новый Структура("Сходство, Пояснение", Сходство, Пояснение);

КонецФункции

Функция ЕстьПересечение(Первые, Вторые)

	Для Каждого Значение Из Первые Цикл
		Если Вторые.Найти(Значение) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЕстьСловоСОсновой(Слова, Основа)

	Для Каждого Слово Из Слова Цикл
		Если СтрНачинаетсяС(Слово, Основа) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция КосинусТриграмм(Первые, Вторые, IDF)

	Скалярное = 0;
	НормаПервых = 0;
	НормаВторых = 0;
	Для Каждого Элемент Из Первые Цикл
		Вес = IDF.Получить(Элемент.Ключ);
		Вес = ?(Вес = Неопределено, 1, Вес) * Элемент.Значение;
		НормаПервых = НормаПервых + Вес * Вес;
		Второй = Вторые.Получить(Элемент.Ключ);
		Если Второй <> Неопределено Тогда
			ВесВторого = IDF.Получить(Элемент.Ключ);
			Скалярное = Скалярное + Вес * ?(ВесВторого = Неопределено, 1, ВесВторого) * Второй;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Вторые Цикл
		Вес = IDF.Получить(Элемент.Ключ);
		Вес = ?(Вес = Неопределено, 1, Вес) * Элемент.Значение;
		НормаВторых = НормаВторых + Вес * Вес;
	КонецЦикла;
	Если НормаПервых = 0 Или НормаВторых = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Скалярное / Sqrt(НормаПервых * НормаВторых);

КонецФункции

#КонецОбласти

#Область Нормализация

// Ключ точного збігу: нижній регістр, схожі латинські літери -> кириличні, без пробілів і розділювачів.
Функция КлючНазвания(Знач Текст)

	Текст = ЕдиныеБуквы(НРег(СокрЛП(Текст)));
	Для Каждого Символ Из СтрРазделить(" |№|-|(|)|""|'|.|,|«|»|_|/|*|×|ø|:|;", "|") Цикл
		Текст = СтрЗаменить(Текст, Символ, "");
	КонецЦикла;
	Текст = СтрЗаменить(Текст, Символы.НПП, "");
	Возврат СтрЗаменить(Текст, Символы.Таб, "");

КонецФункции

// Ознаки назви для оцінки схожості:
//  Размеры — числа-розміри (ланцюжки через «*»/«х», «№», «Ø», окремі числа), різьба «м16», ключ «s24»;
//  Марки — марка/клас (ст.245, 3пс, А500, 8.8, S235, UN3295); Стандарты — номер після DIN/ISO/ДСТУ/ГОСТ;
//  Слова — значущі слова (без стоп-слів); Триграммы — символьні триграми слів (для косинуса TF-IDF);
//  Тип — основа (4 літери) першого значущого кириличного слова — тип виробу; Сторона — «п»/«л» (праві/ліві).
Функция ПризнакиНазвания(Знач Текст)

	Текст = ЕдиныеБуквы(НРег(Текст));
	Признаки = Новый Структура("Размеры, Марки, Стандарты, Слова, Триграммы, Тип, Сторона",
		Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Соответствие, "", "");
	СтопСлова = СтопСлова();
	СловаСтандартов = СловаСтандартов();
	СловаМарок = СловаМарок();
	Лексемы = ЛексемыНазвания(Текст);
	Последняя = Лексемы.ВГраница();
	КлассПредЧисла = ""; // клас попереднього числа: «р» розмір / «м» марка / «с» стандарт

	Для Индекс = 0 По Последняя Цикл
		Лексема = Лексемы[Индекс];
		Пред = ?(Индекс > 0, Лексемы[Индекс - 1], Неопределено);
		След = ?(Индекс < Последняя, Лексемы[Индекс + 1], Неопределено);

		Если Лексема.Вид = "с" Тогда
			Значение = Лексема.Значение;
			Если Значение = "х" И Пред <> Неопределено И След <> Неопределено И Пред.Вид = "ч" И След.Вид = "ч" Тогда
				Продолжить; // «34х38» — знак множення
			КонецЕсли;
			Если СтрНачинаетсяС(Значение, "прав") Тогда
				Признаки.Сторона = "п";
			ИначеЕсли СтрНачинаетсяС(Значение, "лів") Или СтрНачинаетсяС(Значение, "лев") Тогда
				Признаки.Сторона = "л";
			КонецЕсли;
			Если СтрДлина(Значение) < 2 Или СтопСлова.Получить(Значение) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Признаки.Слова.Добавить(Значение);
			ДобавитьТриграммы(Значение, Признаки.Триграммы);
			Если Признаки.Тип = "" И СтрДлина(Значение) >= 3 И СловаСтандартов.Получить(Значение) = Неопределено
				И СловаМарок.Получить(Значение) = Неопределено И ЕстьКириллица(Значение) Тогда
				Признаки.Тип = Лев(Значение, 4);
			КонецЕсли;
			Продолжить;
		КонецЕсли;

		Число = НормализованноеЧисло(Лексема.Значение);
		ЗначениеЧисла = ЧислоИзТекста(Число);
		Префикс = ?(Пред <> Неопределено И Пред.Вид = "с" И Лексема.Слитно, Пред.Значение, "");
		Если Префикс = "х" И Индекс > 1 И Лексемы[Индекс - 2].Вид = "ч" Тогда
			Префикс = ""; // «960х2050», «м16х100» — знак множення, не префікс
		КонецЕсли;
		СловоПеред = НайтиСловоПеред(Лексемы, Индекс);
		ЧерезДефис = Пред <> Неопределено И Пред.Вид = "ч" И Лексема.Разделитель = "-" И КлассПредЧисла <> "";
		СуффиксМарки = След <> Неопределено И След.Вид = "с" И След.Слитно И СловаМарок.Получить(След.Значение) <> Неопределено;
		Если ЧерезДефис И КлассПредЧисла <> "р" Тогда
			Класс = КлассПредЧисла; // «ДСТУ 10704-91» — стандарт, «А2-70», «ст1-3» — марка
		ИначеЕсли Префикс = "м" Тогда
			Класс = "р";
			Число = "м" + Число;
		ИначеЕсли (Префикс = "s" Или Префикс = "с") И ЗначениеЧисла <> Неопределено И ЗначениеЧисла < 100 Тогда
			Класс = "р";
			Число = "s" + Число;
		ИначеЕсли СловаСтандартов.Получить(Префикс) <> Неопределено
			Или (Префикс = "" И СловаСтандартов.Получить(СловоПеред) <> Неопределено) Тогда
			Класс = "с";
		ИначеЕсли Префикс <> "" Или СловаМарок.Получить(СловоПеред) <> Неопределено Или СуффиксМарки
			Или КлассыМицности().Получить(Число) <> Неопределено Тогда
			Класс = "м";
			Число = Префикс + Число;
		Иначе
			Класс = "р";
		КонецЕсли;
		Если Класс = "р" Тогда
			Признаки.Размеры.Добавить(Число);
		ИначеЕсли Класс = "с" Тогда
			ДобавитьУникально(Признаки.Стандарты, Число);
		Иначе
			ДобавитьУникально(Признаки.Марки, Число);
		КонецЕсли;
		КлассПредЧисла = Класс;
	КонецЦикла;

	Возврат Признаки;

КонецФункции

// Лексеми рядка: Масив Структура(Вид — «с» слово / «ч» число, Значение, Слитно — впритул до попередньої лексеми,
// Разделитель — символи між попередньою лексемою і цією, без пробілів).
Функция ЛексемыНазвания(Текст)

	Лексемы = Новый Массив;
	Лексема = "";
	ВидЛексемы = "";
	Разделитель = "";
	СлитноТекущей = Ложь;
	РазделительТекущей = "";
	Длина = СтрДлина(Текст);
	Для Позиция = 1 По Длина + 1 Цикл
		Символ = ?(Позиция <= Длина, Сред(Текст, Позиция, 1), " ");
		Дробь = ВидЛексемы = "ч" И (Символ = "," Или Символ = ".") И Позиция < Длина
			И СтрНайти("0123456789", Сред(Текст, Позиция + 1, 1)) > 0;
		Если СтрНайти("0123456789", Символ) > 0 Или Дробь Тогда
			НовыйВид = "ч";
		ИначеЕсли ЭтоБуква(Символ) Тогда
			НовыйВид = "с";
		Иначе
			НовыйВид = "";
		КонецЕсли;
		Если НовыйВид <> "" И НовыйВид = ВидЛексемы Тогда
			Лексема = Лексема + ?(Дробь, ".", Символ);
			Продолжить;
		КонецЕсли;
		// вид змінився — закриваємо поточну лексему
		Если Лексема <> "" Тогда
			Лексемы.Добавить(Новый Структура("Вид, Значение, Слитно, Разделитель", ВидЛексемы, Лексема,
				СлитноТекущей, РазделительТекущей));
		КонецЕсли;
		Если НовыйВид = "" Тогда
			Если Символ <> " " Тогда
				Разделитель = Разделитель + Символ;
			КонецЕсли;
			Лексема = "";
		Иначе
			СлитноТекущей = Лексема <> ""; // попередня лексема щойно закрилась без роздільника
			РазделительТекущей = Разделитель;
			Разделитель = "";
			Лексема = Символ;
		КонецЕсли;
		ВидЛексемы = НовыйВид;
	КонецЦикла;
	Возврат Лексемы;

КонецФункции

// Найближче попереднє слово (не далі 2 лексем) — для «DIN 933», «ст. 8.0», «кл 3».
Функция НайтиСловоПеред(Лексемы, Индекс)

	Для Шаг = 1 По 2 Цикл
		Если Индекс - Шаг < 0 Тогда
			Прервать;
		КонецЕсли;
		Кандидат = Лексемы[Индекс - Шаг];
		Если Кандидат.Вид = "с" Тогда
			Возврат Кандидат.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// «4,0» / «12.00» -> «4» / «12»; «8.8» лишається; провідні нулі прибираються.
Функция НормализованноеЧисло(Знач Лексема)

	Если СтрНайти(Лексема, ".") > 0 Тогда
		Пока СтрЗаканчиваетсяНа(Лексема, "0") Цикл
			Лексема = Лев(Лексема, СтрДлина(Лексема) - 1);
		КонецЦикла;
		Если СтрЗаканчиваетсяНа(Лексема, ".") Тогда
			Лексема = Лев(Лексема, СтрДлина(Лексема) - 1);
		КонецЕсли;
	КонецЕсли;
	Пока СтрДлина(Лексема) > 1 И СтрНачинаетсяС(Лексема, "0") И Не СтрНачинаетсяС(Лексема, "0.") Цикл
		Лексема = Сред(Лексема, 2);
	КонецЦикла;
	Возврат Лексема;

КонецФункции

Процедура ДобавитьУникально(Массив, Значение)

	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьТриграммы(Слово, Триграммы)

	Обрамленное = " " + Слово + " ";
	Для Позиция = 1 По СтрДлина(Обрамленное) - 2 Цикл
		Триграмма = Сред(Обрамленное, Позиция, 3);
		Счетчик = Триграммы.Получить(Триграмма);
		Триграммы.Вставить(Триграмма, ?(Счетчик = Неопределено, 1, Счетчик + 1));
	КонецЦикла;

КонецПроцедуры

Функция СтопСлова()

	Результат = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить("мм|ст|см|кг|шт|та|для|на|до|из|із|за|згідно|по|вид|тип|марка|з|і|й|в|у|ос", "|") Цикл
		Результат.Вставить(Слово, Истина);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Слова перед номером стандарту (у формі після ЕдиныеБуквы).
Функция СловаСтандартов()

	Результат = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить("din|iso|дсту|гост|en|ту|ост", "|") Цикл
		Результат.Вставить(ЕдиныеБуквы(Слово), Истина);
