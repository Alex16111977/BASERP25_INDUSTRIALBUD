// Рахунок залишку номенклатури: спершу на складі документа, інакше на будь-якому складі пошуку.
Функция СчетаОстатковНоменклатуры(МассивНоменклатуры, СкладДокумента)

	Результат = Новый Соответствие;
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ост.Субконто1 КАК Номенклатура,
	|	Ост.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА Ост.Субконто3 = &СкладДокумента
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Приоритет,
	|	Ост.КоличествоОстаток КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&Период, , , Субконто3 В (&Склады)) КАК Ост
	|ГДЕ
	|	Ост.Субконто1 В (&Номенклатура)
	|	И Ост.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Количество УБЫВ";
	Запрос.УстановитьПараметр("Период", ПериодОстатков());
	Запрос.УстановитьПараметр("Склады", Склады.ВыгрузитьКолонку("Склад"));
	Запрос.УстановитьПараметр("СкладДокумента", СкладДокумента);
	Запрос.УстановитьПараметр("Номенклатура", МассивНоменклатуры);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Получить(Выборка.Номенклатура) = Неопределено Тогда
			Результат.Вставить(Выборка.Номенклатура, Выборка.Счет);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция НоменклатураПоКоду(Знач Код)

	Найденная = Справочники.Номенклатура.НайтиПоКоду(Код);
	Если Не ЗначениеЗаполнено(Найденная) И СтрДлина(Код) < 11 Тогда
		Найденная = Справочники.Номенклатура.НайтиПоКоду(Прав("00000000000" + Код, 11));
	КонецЕсли;
	Возврат Найденная;

КонецФункции

Функция ТочнаяНоменклатураВСправочнике(Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	Н.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Н
	|ГДЕ
	|	НЕ Н.ЭтоГруппа
	|	И НЕ Н.ПометкаУдаления
	|	И Н.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Возврат ?(Выгрузка.Количество() = 1, Выгрузка[0].Ссылка, Справочники.Номенклатура.ПустаяСсылка());

КонецФункции

Функция СкладыПоУмолчанию()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК С
	|ГДЕ
	|	НЕ С.ПометкаУдаления
	|	И С.Наименование В (""Чорноморськ"", ""Чорноморськ Списання"")";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

Функция СохраненноеСопоставление()

	// спільні для всіх користувачів (окреме ім'я в сховищі) — читання/запис чужих налаштувань потребує привілеїв
	УстановитьПривилегированныйРежим(Истина);
	Сопоставление = ХранилищеОбщихНастроек.Загрузить(КлючНастроек(), "Сопоставление", , ПользовательНастроек());
	УстановитьПривилегированныйРежим(Ложь);
	Если ТипЗнч(Сопоставление) <> Тип("Соответствие") Тогда
		Сопоставление = Новый Соответствие;
	КонецЕсли;
	Возврат Сопоставление;

КонецФункции

Процедура СохранитьСопоставление(Таблица)

	Сопоставление = СохраненноеСопоставление();
	Для Каждого СтрокаФайла Из Таблица Цикл
		Если СтрокаФайла.Подтверждено И ЗначениеЗаполнено(СтрокаФайла.Номенклатура) Тогда
			Сопоставление.Вставить(КлючНазвания(СтрокаФайла.Наименование), СтрокаФайла.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Сопоставление", Сопоставление, , ПользовательНастроек());
	Исключение
		// не критично: наступного разу картки доведеться підтвердити знову
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Процедура СохранитьНастройки()

	Колонки = Новый Структура("ПерваяСтрока, КолонкаНаименование, КолонкаКоличество, КолонкаЕдиница, КолонкаЦена,
		|КолонкаСумма, КолонкаКод, ИскатьВнеОстатков");
	ЗаполнитьЗначенияСвойств(Колонки, ЭтотОбъект);
	Попытка
		ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Колонки", Колонки);
		ХранилищеОбщихНастроек.Сохранить(КлючНастроек(), "Склады", Склады.ВыгрузитьКолонку("Склад"));
	Исключение
		// не критично
	КонецПопытки;

КонецПроцедуры

Функция КлючНастроек()
	Возврат "ВнешняяОбработка.ЗагрузкаТЧРеализацияТоваровУслуг";
