КонецФункции

// Слова перед/після марки (ст.245, кл 3, 3пс, 1-3сп).
Функция СловаМарок()

	Результат = Новый Соответствие;
	Для Каждого Слово Из СтрРазделить("ст|кл|клас|сталь|марка|пс|сп|кп|пс5|сп5|кат", "|") Цикл
