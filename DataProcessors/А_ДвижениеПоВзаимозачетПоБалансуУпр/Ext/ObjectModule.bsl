// ============================================================================
// А_ДвижениеПоВзаимозачетПоБалансуУпр — Модуль объекта
// ============================================================================
//
// НАЗНАЧЕНИЕ:
//   Создание/обновление документа "Взаимозачет задолженности" для компенсации
//   разрыва управленческого баланса между подразделениями.
//
// КОГДА ИСПОЛЬЗОВАТЬ:
//   Вызывается из формы документа-источника дисбаланса (ПеремещениеТоваров,
//   СписаниеНедостачТоваров, ПриобретениеТоваровУслуг, СписаниеБезналичныхДС
//   и других). Работает ПОСЛЕ закрытия месяца (когда в регистре
//   ПрочиеАктивыПассивы уже есть движения по документу).
//
// ПРИНЦИП РАБОТЫ:
//   Управленческий баланс построен на двойной записи по подразделениям.
//   Баланс по организации в целом сходится (Дебет = Кредит),
//   но в разрезе подразделений — нет. Взаимозачет создает встречные
//   записи между подразделениями для устранения дисбаланса.
//
// ОПРЕДЕЛЕНИЕ СТОРОН:
//   Подразделение с Контроль > 0 (больше дебета) = ДЕБИТОР (получил актив)
//   Подразделение с Контроль < 0 (больше кредита) = КРЕДИТОР (отдал актив)
//
//   ТипДебитора = Поставщик  (дебитор "задолжал" — как покупатель товара)
//   ТипКредитора = Клиент    (кредитору "задолжали" — как продавцу товара)
//
//   Принцип: кто получил (+) — тот "задолжал" (поставщик),
//            кому отдали (-) — тому "задолжали" (клиент).
//
// ПРИМЕРЫ ДИСБАЛАНСА:
//   1. ПеремещениеТоваров (КМД-2 -> Глобино-2):
//      Глобино-2: +5810 (Товары на складах)  — ДЕБИТОР
//      КМД-2:     -5810 (Товары на складах)  — КРЕДИТОР
//      Статья: "Товары на оптовых складах - Товары на оптовых складах"
//
//   2. СписаниеНедостачТоваров (Астарта.Тищенки):
//      Астарта:   +47382 (Расходы текущего периода) — ДЕБИТОР
//      ЦО:        -47382 (Товары на складах)        — КРЕДИТОР
//      Статья: "Расходы текущего периода - Товары на оптовых складах"
//
//   3. ПриобретениеТоваровУслуг (Логистика):
//      ЦО:         +58404 (Товары на складах)  — ДЕБИТОР
//      Логистика:  -58404 (Выданные авансы)     — КРЕДИТОР
//      Статья: "Товары на оптовых складах - Выданные авансы"
//
//   4. СписаниеБезналичныхДС:
//      Логистика:     +30000 (Выданные авансы)       — ДЕБИТОР
//      Администрация: -30000 (ДС безналичные)        — КРЕДИТОР
//      Статья: "Выданные авансы - Денежные средства (безналичные)"
//
// УСЛОВИЯ СОЗДАНИЯ ВЗАИМОЗАЧЕТА:
//   1. Есть движения в ПрочиеАктивыПассивы по документу
//   2. Баланс по организации сходится (сумма Контроль = 0)
//   3. Минимум 2 подразделения с дисбалансом
//
// ИДЕМПОТЕНТНОСТЬ:
//   Поиск существующего документа по А_ДокументОснованиеДляБаланса.
//   Если найден — распроводится, очищается, перезаполняется, проводится.
//   Если не найден — создается новый.
//
// АНАЛИТИКА ДИСБАЛАНСА (А_СтатьяДисбалансаПоПодразделению):
//   Для каждого взаимозачета определяется главная статья дисбаланса
//   по каждой стороне (дебитор/кредитор) и ищется/создается элемент
//   справочника А_ДисбалансПоПодразделению с ТЧ СтатьиБаланса.
//   Это позволяет анализировать — на каких статьях актива/пассива
//   рвется баланс по подразделениям.
//
// ============================================================================

Процедура СформироватьВзаимозачетНаСервере() Экспорт

	ДокОснование = ДокументОснование;

	Если НЕ ЗначениеЗаполнено(ДокОснование) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не заполнен документ основание!");
		Возврат;
	КонецЕсли;

	// === 1. Запит дисбалансу по підрозділах ===

	// Використовуємо віртуальну таблицю Обороты (як звіт УправленческийБалансКонтроль)
	// бо рухи можуть створюватись через РасчетСебестоимостиТоваров, а не самим документом
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Об.Подразделение КАК Подразделение,
	|	Об.Организация КАК Организация,
	|	Об.СуммаПриход КАК Дебет,
	|	Об.СуммаРасход КАК Кредит,
	|	Об.СуммаПриход - Об.СуммаРасход КАК Контроль
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы.Обороты(, , Регистратор, ) КАК Об
	|ГДЕ
	|	Об.Регистратор = &Регистратор
	|	И НЕ Об.Статья В (
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВложенияСобственныхСредств),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВыводСобственныхСредств))";

	Запрос.УстановитьПараметр("Регистратор", ДокОснование);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Баланс в порядке — дисбаланс по подразделениям не обнаружен для документа: " + ДокОснование);
		Возврат;
	КонецЕсли;

	ТаблицаДисбаланса = РезультатЗапроса.Выгрузить();

	// === 1.5. Перевірка: баланс по організації має сходитись (Дб = Кр) ===
	// Взаємозалік — тільки для міжпідрозділового дисбалансу в межах однієї організації

	ИтогоКонтроль = 0;
	Для Каждого Строка Из ТаблицаДисбаланса Цикл
		ИтогоКонтроль = ИтогоКонтроль + Строка.Контроль;
	КонецЦикла;

	Если Окр(ИтогоКонтроль, 2) <> 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Баланс по организации НЕ сходится (Дебет <> Кредит, разница: "
			+ Формат(ИтогоКонтроль, "ЧДЦ=2")
			+ "). Взаимозачет между подразделениями не применим. Документ: " + ДокОснование);
		Возврат;
	КонецЕсли;

	// === 2. Підсумувати Контроль по підрозділу ===
	// Обороты повертає окремі рядки по Статтях — потрібно згрупувати по підрозділу

	СуммыПоПодразделениям = Новый Соответствие;
	Для Каждого Строка Из ТаблицаДисбаланса Цикл
		Ключ = XMLСтрока(Строка.Подразделение);
		Текущая = СуммыПоПодразделениям.Получить(Ключ);
		Если Текущая = Неопределено Тогда
			СуммыПоПодразделениям.Вставить(Ключ, Новый Структура(
				"Подразделение, Организация, Контроль",
				Строка.Подразделение, Строка.Организация, Строка.Контроль));
		Иначе
			Текущая.Контроль = Текущая.Контроль + Строка.Контроль;
		КонецЕсли;
	КонецЦикла;

	// Перевірка: мінімум 2 підрозділи
	Если СуммыПоПодразделениям.Количество() < 2 Тогда
		Для Каждого КЗ Из СуммыПоПодразделениям Цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				"Только 1 подразделение с дисбалансом — взаимозачет не создается. Подразделение: "
				+ Строка(КЗ.Значение.Подразделение)
				+ ", контроль: " + Формат(КЗ.Значение.Контроль, "ЧДЦ=2"));
			Прервать;
		КонецЦикла;
		Возврат;
	КонецЕсли;

	// === 3. Визначити дебітора і кредитора (по підсумованих значеннях) ===

	ПодразделениеДебитор = Неопределено;
	ПодразделениеКредитор = Неопределено;
	ОрганизацияДок = Неопределено;
	СуммаВзаимозачета = 0;

	Для Каждого КлючЗнач Из СуммыПоПодразделениям Цикл
		Данные = КлючЗнач.Значение;
		Если Данные.Контроль > СуммаВзаимозачета Тогда
			ПодразделениеДебитор = Данные.Подразделение;
			СуммаВзаимозачета = Данные.Контроль;
			ОрганизацияДок = Данные.Организация;
		КонецЕсли;
		Если Данные.Контроль < 0 Тогда
			Если ПодразделениеКредитор = Неопределено ИЛИ Данные.Контроль < 0 Тогда
				ПодразделениеКредитор = Данные.Подразделение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ПодразделениеДебитор = Неопределено ИЛИ ПодразделениеКредитор = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не удалось определить дебитора и кредитора из дисбаланса!");
		Возврат;
	КонецЕсли;

	// === 4. Знайти Партнерів і Контрагентів по підрозділах ===

	ПартнерДебитор = НайтиПартнераПоПодразделению(ПодразделениеДебитор);
	Если НЕ ЗначениеЗаполнено(ПартнерДебитор) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не найден Партнер для подразделения дебитора: " + ПодразделениеДебитор);
		Возврат;
	КонецЕсли;

	КонтрагентДебитор = НайтиКонтрагентаПоПартнеру(ПартнерДебитор);
	Если НЕ ЗначениеЗаполнено(КонтрагентДебитор) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не найден Контрагент для Партнера дебитора: " + ПартнерДебитор);
		Возврат;
	КонецЕсли;

	ПартнерКредитор = НайтиПартнераПоПодразделению(ПодразделениеКредитор);
	Если НЕ ЗначениеЗаполнено(ПартнерКредитор) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не найден Партнер для подразделения кредитора: " + ПодразделениеКредитор);
		Возврат;
	КонецЕсли;

	КонтрагентКредитор = НайтиКонтрагентаПоПартнеру(ПартнерКредитор);
	Если НЕ ЗначениеЗаполнено(КонтрагентКредитор) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не найден Контрагент для Партнера кредитора: " + ПартнерКредитор);
		Возврат;
	КонецЕсли;

	// === 5. Знайти Договори і ОбъектыРасчетов ===

	// Дебітор: А_ПодрОказанияУслуг = Кредитор (протилежна сторона)
	ДоговорДебитора = НайтиИлиСоздатьДоговор(КонтрагентДебитор, ПодразделениеДебитор,
		Перечисления.ТипыДоговоров.СПоставщиком, ОрганизацияДок, ПодразделениеКредитор);
	// Кредитор: А_ПодрОказанияУслуг = Дебітор (протилежна сторона)
	ДоговорКредитора = НайтиИлиСоздатьДоговор(КонтрагентКредитор, ПодразделениеКредитор,
		Перечисления.ТипыДоговоров.СПокупателем, ОрганизацияДок, ПодразделениеДебитор);

	ОбъектРасчетовДебитор = НайтиОбъектРасчетов(КонтрагентДебитор,
		Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком, ДоговорДебитора);
	ОбъектРасчетовКредитор = НайтиОбъектРасчетов(КонтрагентКредитор,
		Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом, ДоговорКредитора);

	// === 5.5. Визначити статті дисбалансу і знайти/створити А_ДисбалансПоПодразделению ===

	// Стаття дебітора: стаття з максимальним Контроль > 0 по підрозділу дебітора
	ЗапросСтДеб = Новый Запрос;
	ЗапросСтДеб.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Об.Статья КАК Статья,
	|	Об.СуммаПриход - Об.СуммаРасход КАК Контроль
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы.Обороты(, , Регистратор, ) КАК Об
	|ГДЕ
	|	Об.Регистратор = &Регистратор
	|	И Об.Подразделение = &Подразделение
	|	И НЕ Об.Статья В (
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВложенияСобственныхСредств),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВыводСобственныхСредств))
	|УПОРЯДОЧИТЬ ПО
	|	Об.СуммаПриход - Об.СуммаРасход УБЫВ";
	ЗапросСтДеб.УстановитьПараметр("Регистратор", ДокОснование);
	ЗапросСтДеб.УстановитьПараметр("Подразделение", ПодразделениеДебитор);

	СтатьяДебитора = Неопределено;
	РезСтДеб = ЗапросСтДеб.Выполнить();
	ВыбСтДеб = РезСтДеб.Выбрать();
	Если ВыбСтДеб.Следующий() Тогда
		СтатьяДебитора = ВыбСтДеб.Статья;
	КонецЕсли;

	// Стаття кредитора: стаття з максимальним |Контроль| < 0 по підрозділу кредитора
	ЗапросСтКред = Новый Запрос;
	ЗапросСтКред.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Об.Статья КАК Статья,
	|	Об.СуммаПриход - Об.СуммаРасход КАК Контроль
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы.Обороты(, , Регистратор, ) КАК Об
	|ГДЕ
	|	Об.Регистратор = &Регистратор
	|	И Об.Подразделение = &Подразделение
	|	И НЕ Об.Статья В (
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВложенияСобственныхСредств),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ВыводСобственныхСредств))
	|УПОРЯДОЧИТЬ ПО
	|	Об.СуммаПриход - Об.СуммаРасход ВОЗР";
	ЗапросСтКред.УстановитьПараметр("Регистратор", ДокОснование);
	ЗапросСтКред.УстановитьПараметр("Подразделение", ПодразделениеКредитор);

	СтатьяКредитора = Неопределено;
	РезСтКред = ЗапросСтКред.Выполнить();
	ВыбСтКред = РезСтКред.Выбрать();
	Если ВыбСтКред.Следующий() Тогда
		СтатьяКредитора = ВыбСтКред.Статья;
	КонецЕсли;

	ЭлементДисбаланса = Неопределено;
	Если ЗначениеЗаполнено(СтатьяДебитора) И ЗначениеЗаполнено(СтатьяКредитора) Тогда
		ЭлементДисбаланса = НайтиИлиСоздатьДисбалансПоПодразделению(СтатьяДебитора, СтатьяКредитора);
	КонецЕсли;

	// === 6. Знайти існуючий або створити новий ВзаимозачетЗадолженности ===

	ДокОбъект = Неопределено;

	ЗапросСущ = Новый Запрос;
	ЗапросСущ.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВзаимозачетЗадолженности КАК Док
	|ГДЕ
	|	Док.А_ДокументОснованиеДляБаланса = &ДокОснование
	|	И НЕ Док.ПометкаУдаления";
	ЗапросСущ.УстановитьПараметр("ДокОснование", ДокОснование);

	РезСущ = ЗапросСущ.Выполнить();
	Если НЕ РезСущ.Пустой() Тогда
		ВыбСущ = РезСущ.Выбрать();
		ВыбСущ.Следующий();
		ДокОбъект = ВыбСущ.Ссылка.ПолучитьОбъект();

		// Распровести если проведен
		Если ДокОбъект.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;

		// Очистити ТЧ
		ДокОбъект.ДебиторскаяЗадолженность.Очистить();
		ДокОбъект.КредиторскаяЗадолженность.Очистить();

		Сообщить("Обновляем существующий документ: " + ВыбСущ.Ссылка);
	Иначе
		ДокОбъект = Документы.ВзаимозачетЗадолженности.СоздатьДокумент();
		Сообщить("Создаем новый документ ВзаимозачетЗадолженности");
	КонецЕсли;

	// === 7. Заповнити шапку ===

	ДокОбъект.Дата = ДокОснование.Дата;
	ДокОбъект.Организация = ОрганизацияДок;
	ДокОбъект.ВидОперации = Перечисления.ВидыОперацийВзаимозачетаЗадолженности.Произвольный;
	ДокОбъект.КонтрагентДебитор = КонтрагентДебитор;
	ДокОбъект.КонтрагентКредитор = КонтрагентКредитор;
	ДокОбъект.ТипДебитора = Перечисления.ТипыУчастниковВзаимозачета.Поставщик;
	ДокОбъект.ТипКредитора = Перечисления.ТипыУчастниковВзаимозачета.Клиент;
	ДокОбъект.СуммаРегл = СуммаВзаимозачета;
	ДокОбъект.СуммаУпр = СуммаВзаимозачета;
	ДокОбъект.А_ДокументОснованиеДляБаланса = ДокОснование;
	ДокОбъект.А_ВведенВЕРП = Истина;
	Если ЗначениеЗаполнено(ЭлементДисбаланса) Тогда
		ДокОбъект.А_СтатьяДисбалансаПоПодразделению = ЭлементДисбаланса;
	КонецЕсли;

        
	// Валюта UAH
	ВалютаUAH = Справочники.Валюты.НайтиПоКоду("980");
	Если НЕ ЗначениеЗаполнено(ВалютаUAH) Тогда
		ВалютаUAH = Справочники.Валюты.НайтиПоНаименованию("UAH");
	КонецЕсли;

	// === 8. Заповнити ДебиторскаяЗадолженность ===

	СтрокаДеб = ДокОбъект.ДебиторскаяЗадолженность.Добавить();
	СтрокаДеб.Партнер = ПартнерДебитор;
	СтрокаДеб.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком;
	СтрокаДеб.СуммаВзаиморасчетов = СуммаВзаимозачета;
	СтрокаДеб.СуммаРегл = СуммаВзаимозачета;
	СтрокаДеб.СуммаУпр = СуммаВзаимозачета;
	СтрокаДеб.ВалютаВзаиморасчетов = ВалютаUAH;
	СтрокаДеб.Организация = ОрганизацияДок;
	Если ЗначениеЗаполнено(ОбъектРасчетовДебитор) Тогда
		СтрокаДеб.ОбъектРасчетов = ОбъектРасчетовДебитор;
	КонецЕсли;

	// === 9. Заповнити КредиторскаяЗадолженность ===

	СтрокаКред = ДокОбъект.КредиторскаяЗадолженность.Добавить();
	СтрокаКред.Партнер = ПартнерКредитор;
	СтрокаКред.ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
	СтрокаКред.СуммаВзаиморасчетов = СуммаВзаимозачета;
	СтрокаКред.СуммаРегл = СуммаВзаимозачета;
	СтрокаКред.СуммаУпр = СуммаВзаимозачета;
	СтрокаКред.ВалютаВзаиморасчетов = ВалютаUAH;
	СтрокаКред.Организация = ОрганизацияДок;
	Если ЗначениеЗаполнено(ОбъектРасчетовКредитор) Тогда
		СтрокаКред.ОбъектРасчетов = ОбъектРасчетовКредитор;
	КонецЕсли;

	// === 10. Провести ===

	Попытка
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("Документ успешно проведен: " + ДокОбъект.Ссылка
			+ " | Сумма: " + Формат(СуммаВзаимозачета, "ЧДЦ=2")
			+ " | Дебитор: " + Строка(ПодразделениеДебитор)
			+ " | Кредитор: " + Строка(ПодразделениеКредитор));
	Исключение
		Сообщить("ОШИБКА проведения: " + ОписаниеОшибки());
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			Сообщить("Документ записан без проведения: " + ДокОбъект.Ссылка);
		Исключение
			Сообщить("ОШИБКА записи: " + ОписаниеОшибки());
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры


