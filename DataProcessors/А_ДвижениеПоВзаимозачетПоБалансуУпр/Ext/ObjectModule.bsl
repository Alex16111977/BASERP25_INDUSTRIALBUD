Функция НайтиПартнераПоПодразделению(Подразделение)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	П.Ссылка КАК Партнер
	|ИЗ
	|	Справочник.Партнеры КАК П
	|ГДЕ
	|	П.А_Подразделение = &Подразделение
	|	И НЕ П.ПометкаУдаления";
	Запрос.УстановитьПараметр("Подразделение", Подразделение);

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Запрос2 = Новый Запрос;
		Запрос2.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Партнер
		|ИЗ
		|	Справочник.Партнеры КАК П
		|ГДЕ
		|	П.Наименование = &Наименование
		|	И НЕ П.ПометкаУдаления";
		Запрос2.УстановитьПараметр("Наименование", Строка(Подразделение));
		Результат = Запрос2.Выполнить();
		Если Результат.Пустой() Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Выб = Результат.Выбрать();
	Выб.Следующий();
	Возврат Выб.Партнер;

КонецФункции

