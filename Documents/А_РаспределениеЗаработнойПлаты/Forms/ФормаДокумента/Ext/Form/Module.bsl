// Распределение зарплаты по подразделениям
// TODO: Требуется регистр накопления ДанныеТабелирования для полноценной работы
&НаСервере
Процедура РаспределитьНаСервере()

	// Упрощенный вариант распределения без регистра ДанныеТабелирования
	// Распределяем всю сумму на основное подразделение сотрудника

	Объект.Распределение.Очистить();

	Для Каждого СтрокаСотрудник Из Объект.Сотрудники Цикл

		Если Не ЗначениеЗаполнено(СтрокаСотрудник.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Объект.Распределение.Добавить();
		НоваяСтрока.Сотрудник = СтрокаСотрудник.Сотрудник;
		НоваяСтрока.СуммаНачисления = СтрокаСотрудник.СуммаНачисления;
		НоваяСтрока.СуммаФОТ = СтрокаСотрудник.СуммаФОТ;
		НоваяСтрока.СуммаНалогов = СтрокаСотрудник.СуммаНалогов;

		// Подразделение берем из карточки сотрудника
		Если ЗначениеЗаполнено(СтрокаСотрудник.Сотрудник.ОсновноеПодразделение) Тогда
			НоваяСтрока.Подразделение = СтрокаСотрудник.Сотрудник.ОсновноеПодразделение;
		ИначеЕсли ЗначениеЗаполнено(СтрокаСотрудник.Сотрудник.Родитель)
			И ЗначениеЗаполнено(СтрокаСотрудник.Сотрудник.Родитель.ОсновноеПодразделение) Тогда
			НоваяСтрока.Подразделение = СтрокаСотрудник.Сотрудник.Родитель.ОсновноеПодразделение;
		КонецЕсли;

		// Направление берем из карточки сотрудника
		Если ЗначениеЗаполнено(СтрокаСотрудник.Сотрудник.ОсновноеНаправление) Тогда
			НоваяСтрока.Направление = СтрокаСотрудник.Сотрудник.ОсновноеНаправление;
		КонецЕсли;

		// Часы не заполняем - требуется регистр ДанныеТабелирования
		НоваяСтрока.ОтработаноЧасов = 0;

	КонецЦикла;

	Если Объект.Распределение.Количество() = 0 Тогда
		Сообщить("Нет данных для распределения. Добавьте сотрудников в таблицу.");
	Иначе
		Сообщить("Распределено по " + Объект.Распределение.Количество() + " записям (упрощенный режим без табеля).");
	КонецЕсли;

	// -------------------------------------------------------------------------
	// ОРИГИНАЛЬНЫЙ КОД С ЗАПРОСОМ К РЕГИСТРУ ДанныеТабелирования (закомментирован):
	// -------------------------------------------------------------------------
	// Для полноценной работы необходимо добавить регистр накопления ДанныеТабелирования
	// с измерениями: Сотрудник, Подразделение, Состояние, Организация, Направление
	// и ресурсами: ЧасыФакт, ЧасыПлан
	// -------------------------------------------------------------------------

КонецПроцедуры

&НаКлиенте
Процедура Распределить(Команда)
	РаспределитьНаСервере();
КонецПроцедуры

