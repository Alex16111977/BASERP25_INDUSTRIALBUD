#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	Если Параметры.Свойство("Заголовок") И ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		Заголовок = Параметры.Заголовок;
	КонецЕсли;

	Если Параметры.Свойство("ФизическоеЛицо") Тогда
		ФизическоеЛицо = Параметры.ФизическоеЛицо;
	КонецЕсли;

	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	КонецЕсли;

	Если Параметры.Свойство("АдресВХранилище") И ЗначениеЗаполнено(Параметры.АдресВХранилище) Тогда
		ТЗ = ПолучитьИзВременногоХранилища(Параметры.АдресВХранилище);
		А_РасшифровкаВыплатыЗарплатаПоФизлицам.Загрузить(ТЗ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если Модифицированность Тогда
		Отказ = Истина;
		Текст = НСтр("ru='Данные были изменены. Сохранить изменения?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПередЗакрытием", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗакрытием(РезВопрос, ДопПарам) Экспорт

	Если РезВопрос = КодВозвратаДиалога.Да Тогда
		ВыбратьИЗакрыть();
	ИначеЕсли РезВопрос = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура А_РасшифровкаВыплатыЗарплатаПоФизлицамПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока И НЕ Копирование Тогда
		Элемент.ТекущиеДанные.ФизическоеЛицо    = ФизическоеЛицо;
		Элемент.ТекущиеДанные.ИдентификаторСтроки = Новый УникальныйИдентификатор();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	ВыбратьИЗакрыть();
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Модифицированность = Ложь;
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьИЗакрыть()

	Результат = Новый Структура;
	Результат.Вставить("Модифицированность", Модифицированность);
	Результат.Вставить("ФизическоеЛицо",     ФизическоеЛицо);
	Результат.Вставить("АдресВХранилище",    А_АдресВХранилище());

	Модифицированность = Ложь;
	Закрыть(Результат);

КонецПроцедуры

&НаСервере
Функция А_АдресВХранилище()
	ТЗ = А_РасшифровкаВыплатыЗарплатаПоФизлицам.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТЗ, УникальныйИдентификатор);
КонецФункции

#КонецОбласти
