
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	// Вставить содержимое обработчика.
КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	// Защита от рекурсии при импорте через ConvertERP или при записи обратной ссылки
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	//// Триггер: создать/обновить ведомость в кассу
	//// Не блокируем Отказ при ошибке создания ведомости — пишем в Сообщить
	//Попытка
	//	СоздатьВедомостьНаВыплатуВКассуПоРаспределениюФ2();
	//Исключение
	//	Сообщить("ПриЗаписи: ошибка создания ВКассу: " + ОписаниеОшибки());
	//КонецПопытки;

КонецПроцедуры

#Область ЕРП_СоздатьВедомостьНаВыплатуВКассу

// Утилита: Сотрудник → ФизическоеЛицо (один запрос на массив сотрудников).
// Возвращает Соответствие.
Функция _ВЫК_ПостроитьКешСотрудникФЛ(МасСотрудников)

	Результат = Новый Соответствие;
	Если МасСотрудников.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Ссылка КАК Сотрудник,
	|	С.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ Справочник.Сотрудники КАК С
	|ГДЕ С.Ссылка В (&МасСотрудников)";
	Запрос.УстановитьПараметр("МасСотрудников", МасСотрудников);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ФизическоеЛицо) Тогда
			Результат.Вставить(Выборка.Сотрудник, Выборка.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Утилита: СтруктураПредприятия → ПодразделенияОрганизаций (через А_Привилегированный).
// Возвращает Соответствие.
Функция _ВЫК_ПостроитьКешПодрОрг(МасСтрПредпр)

	Результат = Новый Соответствие;
	Для Каждого СтрПредпр Из МасСтрПредпр Цикл
		Если НЕ ЗначениеЗаполнено(СтрПредпр) Тогда Продолжить; КонецЕсли;
		Если Результат[СтрПредпр] <> Неопределено Тогда Продолжить; КонецЕсли;
		Попытка
			ПодрОрг = А_Привилегированный.ОбеспечитьПодразделенияОрганизацийПоПодразделению(СтрПредпр);
		Исключение
			ПодрОрг = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
		КонецПопытки;
		Результат.Вставить(СтрПредпр, ПодрОрг);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Утилита: определение кассы для шапки ведомости.
// Порядок поиска: Орг.А_ОсновнаяКасса → первая активная касса организации → НайтиПоНаименованию("Касса ЗП") → ПустаяСсылка.
Функция _ВЫК_ОпределитьКассу(ОрганизацияСсылка)

	// 1. По реквизиту организации (если есть в проекте)
	Попытка
		КассаОсн = ОрганизацияСсылка.А_ОсновнаяКасса;
		Если ЗначениеЗаполнено(КассаОсн) Тогда
			Возврат КассаОсн;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// 2. Первая активная касса организации
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	К.Ссылка КАК Ссылка
	|ИЗ Справочник.Кассы КАК К
	|ГДЕ К.Владелец = &Орг И НЕ К.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО К.Наименование";
	Запрос.УстановитьПараметр("Орг", ОрганизацияСсылка);
	Рез = Запрос.Выполнить();
	Если НЕ Рез.Пустой() Тогда
		Выб = Рез.Выбрать(); Выб.Следующий();
		Возврат Выб.Ссылка;
	КонецЕсли;

	// 3. По наименованию "Касса ЗП"
	КассаЗП = Справочники.Кассы.НайтиПоНаименованию("Касса ЗП", Истина);
	Если ЗначениеЗаполнено(КассаЗП) Тогда
		Возврат КассаЗП;
	КонецЕсли;

	// 4. Fallback — пусто
	Возврат Справочники.Кассы.ПустаяСсылка();

КонецФункции

// Главная экспортная процедура: создаёт/обновляет ВедомостьНаВыплатуЗарплатыВКассу
// на основании текущего документа РаспределениеФ2.
// Паттерн: Find-Or-Create + Cleanup + Заполнение + Запись.Проведение.
// Образец: Documents/А_ОтгрузкаПродукции/Ext/ObjectModule.bsl процедура
// СоздатьДокументОказанияУслугМеждуПодразделениямиПоОтгрузкаПродукции.
Процедура СоздатьВедомостьНаВыплатуВКассуПоРаспределениюФ2(
	СтатьиДДСПоКлючу = Неопределено,
	СсылкаНаОтражениеЗП = Неопределено) Экспорт

	// === 1. Find existing ведомость по обратной ссылке ===
	ЗапросСущ = Новый Запрос;
	ЗапросСущ.УстановитьПараметр("Основание", Ссылка);
	ЗапросСущ.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка,
	|	Д.Проведен КАК Проведен,
	|	Д.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ Документ.ВедомостьНаВыплатуЗарплатыВКассу КАК Д
	|ГДЕ Д.А_РаспределениеФ2 = &Основание";
	Результат = ЗапросСущ.Выполнить();

	// === 2. Cleanup существующей: распровести + снять пометку + очистить ТЧ ===
	Если НЕ Результат.Пустой() Тогда
		Выб = Результат.Выбрать(); Выб.Следующий();
		ВыкВКассу = Выб.Ссылка.ПолучитьОбъект();
		Если Выб.ПометкаУдаления Тогда
			ВыкВКассу.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
		Если Выб.Проведен Тогда
			Попытка
				ВыкВКассу.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение
				Сообщить("Не удалось распровести существующую ВКассу: " + ОписаниеОшибки());
				Возврат;
			КонецПопытки;
		КонецЕсли;
		ВыкВКассу.Зарплата.Очистить();
		ВыкВКассу.А_РасшифровкаВыплатыЗарплатаПоФизлицам.Очистить();
		ВыкВКассу.Состав.Очистить();
	Иначе
		ВыкВКассу = Документы.ВедомостьНаВыплатуЗарплатыВКассу.СоздатьДокумент();
	КонецЕсли;

	// === 3. Guard: документ Ф2 должен быть проведён ===
	Если НЕ Проведен Тогда
		Сообщить("РаспределениеФ2 не проведено — ВКассу не создаётся.");
		Возврат;
	КонецЕсли;

	// === 4. Шапка ведомости (по образцу типовой ВКассу 000Ц-000001 от 31.01.2026) ===
	КассаЗП = _ВЫК_ОпределитьКассу(Организация);
	Если НЕ ЗначениеЗаполнено(КассаЗП) Тогда
		Сообщить("ВНИМАНИЕ: касса для ВКассу не определена — поле останется пустым.");
	КонецЕсли;

	// Организация шапки = Касса.Владелец (явное требование) — если касса найдена.
	// Иначе fallback на Организация исходного Ф2.
	ОрганизацияВКассу = ?(ЗначениеЗаполнено(КассаЗП) И ЗначениеЗаполнено(КассаЗП.Владелец),
		КассаЗП.Владелец, Организация);

	ВыкВКассу.Дата                     = Дата;
	ВыкВКассу.ПериодРегистрации        = НачалоМесяца(КассаДатаС);
	ВыкВКассу.Организация              = ОрганизацияВКассу;
	ВыкВКассу.Подразделение            = Справочники.ПодразделенияОрганизаций.ПустаяСсылка(); // ПУСТО (как в эталоне)
	ВыкВКассу.Касса                    = КассаЗП;
	// СпособВыплаты — предопределённый "Зарплата" (Наименование="Зарплата за месяц").
	ВыкВКассу.СпособВыплаты            = Справочники.СпособыВыплатыЗарплаты.Зарплата;
	ВыкВКассу.ПроцентВыплаты           = 100;
	ВыкВКассу.ПорядокЗаполненияНалогов = Перечисления.ПорядокЗаполненияНалогов.БезНалогов; // НДФЛ не заполняем
	ВыкВКассу.А_РаспределениеФ2        = Ссылка;
	ВыкВКассу.Ответственный            = Ответственный;
	ВыкВКассу.Комментарий              = "Сформировано из РаспределениеФ2 №" + Номер
									   + " от " + Формат(Дата, "ДЛФ=DD")
									   + " (Направление: " + Строка(Направление) + ")";

	// Опциональная связь с А_ОтражениеЗПпоКазне (если процедура вызвана из новой кнопки)
	Если СсылкаНаОтражениеЗП <> Неопределено И ЗначениеЗаполнено(СсылкаНаОтражениеЗП) Тогда
		ВыкВКассу.А_ОтражениеЗПпоКазне = СсылкаНаОтражениеЗП;
	КонецЕсли;

	// === 5. Кеши ===
	МасСотр = Новый Массив;
	Для Каждого СтрС Из Сотрудники Цикл
		Если ЗначениеЗаполнено(СтрС.Сотрудник) И МасСотр.Найти(СтрС.Сотрудник) = Неопределено Тогда
			МасСотр.Добавить(СтрС.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрР Из Распределение Цикл
		Если ЗначениеЗаполнено(СтрР.Сотрудник) И МасСотр.Найти(СтрР.Сотрудник) = Неопределено Тогда
			МасСотр.Добавить(СтрР.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	МасПодр = Новый Массив;
	Для Каждого СтрР Из Распределение Цикл
		Если ЗначениеЗаполнено(СтрР.Подразделение) И МасПодр.Найти(СтрР.Подразделение) = Неопределено Тогда
			МасПодр.Добавить(СтрР.Подразделение);
		КонецЕсли;
	КонецЦикла;

	КешФЛ      = _ВЫК_ПостроитьКешСотрудникФЛ(МасСотр);
	КешПодрОрг = _ВЫК_ПостроитьКешПодрОрг(МасПодр);

	// === 6. ТЧ Состав СНАЧАЛА — карта ФЛ→UID, чтобы ТЧ Зарплата могла унаследовать ИдентификаторСтроки.
	// Платформа в ВзаиморасчетыССотрудникамиБазовый.ВедомостьПередЗаписью (стр. 1135-1154)
	// удаляет строки Зарплата без матча по ИдентификаторСтроки в ТЧ Состав.
	КартаФЛкUID = Новый Соответствие;
	Для Каждого СтрР Из Распределение Цикл
		Если НЕ ЗначениеЗаполнено(СтрР.Сотрудник) Тогда Продолжить; КонецЕсли;
		Если СтрР.СуммаНачисления = 0 Тогда Продолжить; КонецЕсли;
		ФЛ = КешФЛ[СтрР.Сотрудник];
		Если НЕ ЗначениеЗаполнено(ФЛ) Тогда Продолжить; КонецЕсли;
		Если КартаФЛкUID.Получить(ФЛ) = Неопределено Тогда
			НовойUID = Новый УникальныйИдентификатор();
			КартаФЛкUID.Вставить(ФЛ, НовойUID);
			НовСтрСостав = ВыкВКассу.Состав.Добавить();
			НовСтрСостав.ФизическоеЛицо      = ФЛ;
			НовСтрСостав.ИдентификаторСтроки = НовойUID;
		КонецЕсли;
	КонецЦикла;

	// === 7. ТЧ Зарплата ← ТЧ Распределение Ф2 (UID берётся из карты Состав по ФЛ) ===
	// Эталон 000Ц-000001 от 31.01.2026: N строк на ФЛ, у каждой — реальное Подразделение,
	// ПериодВзаиморасчетов, ГруппаУчётаНачислений="Зарплата (661)".
	// Источник = ТЧ Распределение Ф2 (Сотр × Подр × ОтработаноЧасов × СуммаНачисления).
	ГруппаЗарплата = Справочники.ГруппыУчетаНачисленийИУдержаний.НайтиПоНаименованию("Зарплата (661)", Истина);
	Если НЕ ЗначениеЗаполнено(ГруппаЗарплата) Тогда
		ГруппаЗарплата = Справочники.ГруппыУчетаНачисленийИУдержаний.НайтиПоКоду("661");
	КонецЕсли;

	КолПропусковФЛ = 0;
	Для Каждого СтрР Из Распределение Цикл
		Если НЕ ЗначениеЗаполнено(СтрР.Сотрудник) Тогда Продолжить; КонецЕсли;
		Если СтрР.СуммаНачисления = 0 Тогда Продолжить; КонецЕсли;

		ФЛ = КешФЛ[СтрР.Сотрудник];
		Если НЕ ЗначениеЗаполнено(ФЛ) Тогда
			КолПропусковФЛ = КолПропусковФЛ + 1;
			Продолжить;
		КонецЕсли;

		UIDСостава = КартаФЛкUID.Получить(ФЛ);
		Если UIDСостава = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ПодрОрг = КешПодрОрг[СтрР.Подразделение];

		НовСтр = ВыкВКассу.Зарплата.Добавить();
		НовСтр.Сотрудник              = СтрР.Сотрудник;
		НовСтр.ФизическоеЛицо         = ФЛ;
		НовСтр.Подразделение          = ?(ЗначениеЗаполнено(ПодрОрг), ПодрОрг, Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
		НовСтр.ПериодВзаиморасчетов   = НачалоМесяца(КассаДатаС);
		НовСтр.КВыплате               = СтрР.СуммаНачисления;
		НовСтр.ГруппаУчетаНачислений  = ГруппаЗарплата;
		НовСтр.ИдентификаторСтроки    = UIDСостава;
		// ДокументОснование оставляем пустым — composite-тип реквизита не включает РаспределениеФ2.
		// Связь с родительским Ф2 — через шапку ВКассу.А_РаспределениеФ2.
	КонецЦикла;
	Если КолПропусковФЛ > 0 Тогда
		Сообщить("ТЧ Зарплата: пропущено " + КолПропусковФЛ + " строк без ФизЛица.");
	КонецЕсли;

	// === 8. ТЧ А_Расшифровка — зеркало ТЧ.Зарплата 1:1 + СтатьяДДС + Направление ===
	// Поля 1-11 копируются из строки Зарплата через ЗаполнитьЗначенияСвойств
	// (ИдентификаторСтроки, Сотрудник, ФизическоеЛицо, Подразделение,
	// ПериодВзаиморасчетов, СтатьяФинансирования, СтатьяРасходов,
	// ДокументОснование, КВыплате, КомпенсацияЗаЗадержкуЗарплаты,
	// ГруппаУчетаНачислений).
	// Поля 12-13 (НаправлениеДеятельности, СтатьяДвиженияДенежныхСредств) — наши специфичные.
	ПоляЗеркала = "ИдентификаторСтроки, Сотрудник, ФизическоеЛицо, Подразделение,"
		+ " ПериодВзаиморасчетов, СтатьяФинансирования, СтатьяРасходов,"
		+ " ДокументОснование, КВыплате, КомпенсацияЗаЗадержкуЗарплаты, ГруппаУчетаНачислений";

	Для Каждого СтрЗ Из ВыкВКассу.Зарплата Цикл
		НовСтр = ВыкВКассу.А_РасшифровкаВыплатыЗарплатаПоФизлицам.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, СтрЗ, ПоляЗеркала);

		// НаправлениеДеятельности из шапки Ф2.Направление
		НовСтр.НаправлениеДеятельности = Направление;

		// СтатьяДДС: 1) из словаря СтатьиДДСПоКлючу (новая кнопка ОтражениеЗПпоКазне),
		//             2) иначе fallback на Сотрудник.СтатьяЗарплата → Родитель.СтатьяЗарплата.
		Если СтатьиДДСПоКлючу <> Неопределено Тогда
			Ключ_СтД = ?(ЗначениеЗаполнено(СтрЗ.Сотрудник),
						Строка(СтрЗ.Сотрудник.УникальныйИдентификатор()), "")
				+ "|"
				+ ?(ЗначениеЗаполнено(СтрЗ.Подразделение),
						Строка(СтрЗ.Подразделение.УникальныйИдентификатор()), "");
			СтатьяДДС = СтатьиДДСПоКлючу.Получить(Ключ_СтД);
			Если СтатьяДДС = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтатьяДДС) Тогда
				СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
				Сообщить("WARN: СтатьяДДС не найдена в ОтражениеЗПпоКазне для "
					+ Строка(СтрЗ.Сотрудник) + " / " + Строка(СтрЗ.Подразделение));
			КонецЕсли;
		Иначе
			// Существующий fallback (Ф2-кнопка без параметров)
			СтатьяДДС = СтрЗ.Сотрудник.СтатьяЗарплата;
			Если НЕ ЗначениеЗаполнено(СтатьяДДС) Тогда
				Попытка
					СтатьяДДС = СтрЗ.Сотрудник.Родитель.СтатьяЗарплата;
				Исключение
					СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		НовСтр.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
	КонецЦикла;


	// === 9. Сумма по документу ===
	ВыкВКассу.СуммаПоДокументу = ВыкВКассу.Зарплата.Итог("КВыплате");

	// === 10. Запись С ПРОВЕДЕНИЕМ ===
	// ИдентификаторСтроки в ТЧ Зарплата = ИдентификаторСтроки в ТЧ Состав (по ФЛ),
	// поэтому типовая ВедомостьПередЗаписью не удалит наши строки.
	Попытка
		ВыкВКассу.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить("Ошибка проведения ВКассу: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// === 11. Обратная ссылка в шапку Ф2 (без рекурсии) ===
	Если А_ВедомостьВКассу <> ВыкВКассу.Ссылка Тогда
		ОбъектДляЗаписи = Ссылка.ПолучитьОбъект();
		ОбъектДляЗаписи.А_ВедомостьВКассу = ВыкВКассу.Ссылка;
		ОбъектДляЗаписи.ОбменДанными.Загрузка = Истина;
		ОбъектДляЗаписи.Записать();
	КонецЕсли;

	Сообщить("ВКассу создана/обновлена и проведена: " + Строка(ВыкВКассу.Ссылка)
		+ " | Зарплата=" + ВыкВКассу.Зарплата.Количество()
		+ " | Расшифровка=" + ВыкВКассу.А_РасшифровкаВыплатыЗарплатаПоФизлицам.Количество()
		+ " | Состав=" + ВыкВКассу.Состав.Количество()
		+ " | Σ=" + Формат(ВыкВКассу.СуммаПоДокументу, "ЧДЦ=2")
		+ " | Проведён=" + Строка(ВыкВКассу.Проведен));

КонецПроцедуры

#КонецОбласти
