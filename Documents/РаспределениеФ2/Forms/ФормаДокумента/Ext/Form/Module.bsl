&НаКлиенте
Процедура СоздатьВедомостьВКассу(Команда)

	// Защита от незаписанного документа
	Если Объект.Ссылка.Пустая() Тогда
		ПоказатьПредупреждение(, "Сначала запишите документ.");
		Возврат;
	КонецЕсли;

	// Записать (если есть изменения) + проверить проведённость
	Записать();
	Если Модифицированность Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Объект.Проведен Тогда
		ПоказатьПредупреждение(, "Документ должен быть проведён для создания ведомости.");
		Возврат;
	КонецЕсли;

	СоздатьВедомостьВКассуНаСервере();

КонецПроцедуры

&НаСервере
Процедура СоздатьВедомостьВКассуНаСервере()
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	ДокОбъект.СоздатьВедомостьНаВыплатуВКассуПоРаспределениюФ2();
	ЗначениеВРеквизитФормы(ДокОбъект, "Объект");
КонецПроцедуры
