#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Подсистема "Управление доступом".

// Процедура ЗаполнитьНаборыЗначенийДоступа по свойствам объекта заполняет наборы значений доступа
// в таблице с полями:
//    НомерНабора     - Число                                     (необязательно, если набор один),
//    ВидДоступа      - ПланВидовХарактеристикСсылка.ВидыДоступа, (обязательно),
//    ЗначениеДоступа - Неопределено, СправочникСсылка или др.    (обязательно),
//    Чтение          - Булево (необязательно, если набор для всех прав) устанавливается для одной строки набора,
//    Добавление      - Булево (необязательно, если набор для всех прав) устанавливается для одной строки набора,
//    Изменение       - Булево (необязательно, если набор для всех прав) устанавливается для одной строки набора,
//    Удаление        - Булево (необязательно, если набор для всех прав) устанавливается для одной строки набора,
//
//  Вызывается из процедуры УправлениеДоступомСлужебный.ЗаписатьНаборыЗначенийДоступа(),
// если объект зарегистрирован в "ПодпискаНаСобытие.ЗаписатьНаборыЗначенийДоступа" и
// из таких же процедур объектов, у которых наборы значений доступа зависят от наборов этого
// объекта (в этом случае объект зарегистрирован в "ПодпискаНаСобытие.ЗаписатьЗависимыеНаборыЗначенийДоступа").
//
// Параметры:
//  Таблица      - ТабличнаяЧасть,
//                 РегистрСведенийНаборЗаписей.НаборыЗначенийДоступа,
//                 ТаблицаЗначений, возвращаемая УправлениеДоступом.ТаблицаНаборыЗначенийДоступа().
//
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	ЗарплатаКадры.ЗаполнитьНаборыПоОрганизацииИФизическимЛицам(ЭтотОбъект, Таблица, "Организация", "ФизическиеЛица.ФизическоеЛицо");
	
КонецПроцедуры
// Подсистема "Управление доступом".

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ДанныеПроведения = ДанныеДляПроведения();
	
	ВзаиморасчетыССотрудниками.ЗарегистрироватьНачальныеОстатки(
		Движения, Отказ, Организация, Месяц, ДанныеПроведения.ЗадолженностьПоЗарплате);

	// Кастомное наполнение А_ВзаиморасчетыССотрудниками (начальный долг работодателя
	// перед ФЛ в разрезе ФизЛицо+Подразделение+ФормаPL+ОрганизацияБухгалтерия для упр.баланса).
	РегистрыНакопления.А_ВзаиморасчетыССотрудниками.ЗаполнитьИзНачальнойЗадолженности(ЭтотОбъект);

	// Управленческий баланс: входящий долг по ЗП в ПрочиеАктивыПассивы (Фаза 1, 2026-06-19).
	ЗаписатьВходящийДолгВПАП();

	// Бухучёт: входящий долг по ЗП в Хозрасчетный (Дт 00 / Кт 661, Фаза 2, 2026-06-19).
	ЗаписатьВходящийДолгВХозрасчетный();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеДляПроведения()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ПериодВзаиморасчетов", Месяц);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	ЗадолженностьПоЗарплате.Сотрудник,
	|	ЗадолженностьПоЗарплате.Сотрудник.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ЗадолженностьПоЗарплате.Подразделение,
	|	ЗадолженностьПоЗарплате.СтатьяФинансирования,
	|	ЗадолженностьПоЗарплате.СтатьяРасходов,
	|	ЗадолженностьПоЗарплате.ГруппаУчетаНачислений,
	|	ЗадолженностьПоЗарплате.Сумма
	|ИЗ
	|	Документ.НачальнаяЗадолженностьПоЗарплате.ЗадолженностьПоЗарплате КАК ЗадолженностьПоЗарплате
	|ГДЕ
	|	ЗадолженностьПоЗарплате.Ссылка = &Ссылка";
	
	РезультатыЗапроса = Запрос.Выполнить();
	
	ДанныеДляПроведения = Новый Структура;
	ДанныеДляПроведения.Вставить("ЗадолженностьПоЗарплате", РезультатыЗапроса.Выгрузить());

	Возврат ДанныеДляПроведения;

КонецФункции

// Управленческий баланс: входящий долг по ЗП в РегистрНакопления.ПрочиеАктивыПассивы (ПАП).
// ОДНОНОГАЯ запись, как штатный ВводОстатков: ТОЛЬКО «Оплата труда» (signed = −Сумма,
// зеркало А_ВзСС → плуг свёртки А_ФинРез_Баланс = 0). Встречная нога (капитал) НЕ пишется —
// уходит в «Собственные средства» отдельным вводом остатков → Σ ПАП документа ≠ 0 (by-design,
// управленческий «Итого» уедет на сумму долга — штатное поведение ввода остатков).
// Разрез: подразделение (Подразделение.А_Подразделение). Источник = ПустаяСсылка.
// Период = КонецМесяца (как ВводОстатков). Решение финансиста 2026-06-19.
Процедура ЗаписатьВходящийДолгВПАП()

	Движения.ПрочиеАктивыПассивы.Записывать = Истина;

	СтатьяОТ = ПланыВидовХарактеристик.СтатьиАктивовПассивов.НайтиПоНаименованию("Оплата труда");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Орг",    Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Орг КАК Организация,
	|	З.Подразделение.А_Подразделение КАК Подразделение,
	|	СУММА(З.Сумма) КАК Сумма
	|ИЗ
	|	Документ.НачальнаяЗадолженностьПоЗарплате.ЗадолженностьПоЗарплате КАК З
	|ГДЕ
	|	З.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	З.Подразделение.А_Подразделение
	|ИМЕЮЩИЕ
	|	СУММА(З.Сумма) <> 0";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Сумма    = Выборка.Сумма;
		АбсСумма = ?(Сумма > 0, Сумма, -Сумма);

		// «Оплата труда»: signed = −Сумма (Сумма>0 → Расход; Сумма<0 → Приход) → зеркало А_ВзСС
		_ПАП_ДобавитьДолг(СтатьяОТ, Выборка.Подразделение,
			?(Сумма > 0, ВидДвиженияНакопления.Расход, ВидДвиженияНакопления.Приход), АбсСумма);
	КонецЦикла;

КонецПроцедуры

// Одна запись движения ПрочиеАктивыПассивы (паттерн А_ПередачаНачисленийМеждуПодразделениями).
// Источник/ВидИсточника = ПустаяСсылка() (МЕТОД, не свойство!); Аналитика/НаправлениеДеятельности
// остаются пустыми (статья «без аналитики», как штатные ПАП(ОТ) от ОЗФУ).
Процедура _ПАП_ДобавитьДолг(Статья, Подразделение, ВидДв, Сумма)

	Запись = Движения.ПрочиеАктивыПассивы.Добавить();
	Запись.Период        = КонецМесяца(Месяц);
	Запись.ВидДвижения   = ВидДв;
	Запись.Организация   = Организация;
	Запись.Подразделение = Подразделение;
	Запись.Статья        = Статья;
	Запись.Источник      = Перечисления.ИсточникиУправленческогоБаланса.ПустаяСсылка();
	Запись.ВидИсточника  = Перечисления.ВидыИсточниковДвижений.ПустаяСсылка();
	Запись.Сумма         = Сумма;

КонецПроцедуры

// Бухгалтерский учёт: входящий долг по ЗП в РегистрБухгалтерии.Хозрасчетный.
// Дт 00 «Вспомогательный» / Кт 661 «Розрахунки за договорами ЦПХ» (субконто Кт = ФизическоеЛицо),
// per строку ТЧ. Только БУ (Сумма) — как все штатные движения 661 (СуммаУУ/НУ=0, НалНазн пусто).
// Переплата (Сумма<0) → обратная проводка Дт 661 / Кт 00. Контр-счёт 00 — решение финансиста 2026-06-19.
Процедура ЗаписатьВходящийДолгВХозрасчетный()

	Движения.Хозрасчетный.Записывать = Истина;
	Движения.Хозрасчетный.ДополнительныеСвойства.Вставить("ПроверкаИзмененияРегистра", Истина);

	Счет00  = ПланыСчетов.Хозрасчетный.НайтиПоКоду("00");
	Счет661 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("661");
	Если Счет00 = Неопределено ИЛИ Счет661 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВидСубРаботники = Счет661.ВидыСубконто[0].ВидСубконто;

	Для Каждого СтрТЧ Из ЗадолженностьПоЗарплате Цикл
		Если СтрТЧ.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запись = Движения.Хозрасчетный.Добавить();
		Запись.Период      = Месяц;
		Запись.Организация = Организация;
		Запись.Содержание  = "Входящий долг по заробітній платі";
		Если СтрТЧ.Сумма > 0 Тогда
			// долг работодателя перед ФЛ: Дт 00 / Кт 661 (субконто на Кт)
			Запись.СчетДт          = Счет00;
			Запись.СчетКт          = Счет661;
			Запись.ПодразделениеКт = СтрТЧ.Подразделение;
			Запись.СубконтоКт[ВидСубРаботники] = СтрТЧ.Сотрудник.ФизическоеЛицо;
			Запись.Сумма           = СтрТЧ.Сумма;
		Иначе
			// переплата: Дт 661 / Кт 00 (субконто на Дт)
			Запись.СчетДт          = Счет661;
			Запись.СчетКт          = Счет00;
			Запись.ПодразделениеДт = СтрТЧ.Подразделение;
			Запись.СубконтоДт[ВидСубРаботники] = СтрТЧ.Сотрудник.ФизическоеЛицо;
			Запись.Сумма           = -СтрТЧ.Сумма;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
