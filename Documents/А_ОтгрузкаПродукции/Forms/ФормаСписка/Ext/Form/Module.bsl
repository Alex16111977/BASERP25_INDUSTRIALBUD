#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура А_ПодобратьАктыЗаПериод(Команда)

	// Конструктор ДиалогРедактированияСтандартногоПериода параметров НЕ принимает,
	// период задается свойством (паттерн обработок СинхронизироватьДеньги и др.).
	Период = Новый СтандартныйПериод;
	Период.ДатаНачала = НачалоМесяца(ОбщегоНазначенияКлиент.ДатаСеанса());
	Период.ДатаОкончания = КонецМесяца(ОбщегоНазначенияКлиент.ДатаСеанса());

	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период = Период;

	ОписаниеОповещения = Новый ОписаниеОповещения("А_ПодобратьАктыЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура А_ПодобратьАктыЗавершение(ВыбранныйПериод, ДополнительныеПараметры) Экспорт

	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПоказатьПредупреждение(,
		А_ПодобратьАктыНаСервере(ВыбранныйПериод.ДатаНачала, ВыбранныйПериод.ДатаОкончания));

	Элементы.Список.Обновить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция А_ПодобратьАктыНаСервере(НачалоПериода, КонецПериода)

	Результат = А_ОтгрузкаПродукцииСервер.ПодобратьАктыЗаПериод(НачалоПериода, КонецПериода);

	Свод = Новый Соответствие;
	Для Каждого СтрокаРезультата Из Результат Цикл
		Ключ = Строка(СтрокаРезультата.Статус);
		Свод.Вставить(Ключ, ?(Свод.Получить(Ключ) = Неопределено, 0, Свод.Получить(Ключ)) + 1);
	КонецЦикла;

	Текст = "Обработано документов: " + Результат.Количество();
	Для Каждого ЭлементСвода Из Свод Цикл
		Текст = Текст + Символы.ПС + ЭлементСвода.Ключ + ": " + ЭлементСвода.Значение;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Элементы.Список);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти
