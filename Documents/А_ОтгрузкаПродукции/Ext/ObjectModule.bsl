
Процедура СоздатьДокументОказанияУслугМеждуПодразделениямиПоОтгрузкаПродукции() Экспорт

	// === 1. Знайти всі існуючі А_ОказаниеУслуг для цього відвантаження ===
	ЗапросСуществующий = Новый Запрос;
	ЗапросСуществующий.УстановитьПараметр("ОтгрузкаПродукции", Ссылка);
	ЗапросСуществующий.Текст =
	"ВЫБРАТЬ
	|	Д.Ссылка КАК Ссылка,
	|	Д.Проведен КАК Проведен
	|ИЗ
	|	Документ.А_ОказаниеУслугМеждуПодразделениями КАК Д
	|ГДЕ
	|	Д.ОтгрузкаПродукции = &ОтгрузкаПродукции";

	// === 2. Відмінити проведення + помітити на видалення батька і всіх дочірніх ===
	ЗапросДочерних = Новый Запрос;
	ЗапросДочерних.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Док
	|ГДЕ
	|	Док.А_РеализацияТоваровУслуг В
	|		(ВЫБРАТЬ Р.Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Р
	|		 ГДЕ Р.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование)
	|	И НЕ Док.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка,
	|	Док.Проведен
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Док
	|ГДЕ
	|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
	|	И НЕ Док.ПометкаУдаления";

	Выборка = ЗапросСуществующий.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОказание = Выборка.Ссылка.ПолучитьОбъект();
		Если Выборка.Проведен Тогда
			ДокОказание.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокОказание.УстановитьПометкуУдаления(Истина);

		ЗапросДочерних.УстановитьПараметр("ДокОснование", Выборка.Ссылка);
		ВыборкаДочерних = ЗапросДочерних.Выполнить().Выбрать();
		Пока ВыборкаДочерних.Следующий() Цикл
			ДокЦепочка = ВыборкаДочерних.Ссылка.ПолучитьОбъект();
			Если ВыборкаДочерних.Проведен Тогда
				ДокЦепочка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			ДокЦепочка.УстановитьПометкуУдаления(Истина);
		КонецЦикла;
	КонецЦикла;

	// === 4. Якщо не треба нараховувати або джерело не проведено — виходимо ===
	Если НЕ А_НачислятьУслуги Тогда
		Возврат;
	КонецЕсли;

	Если НЕ Проведен Тогда
		Возврат;
	КонецЕсли;

	// === 5. Переиспользати помічений або створити новий ===
	Результат = ЗапросСуществующий.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		ВыборкаДок = Результат.Выбрать();
		ВыборкаДок.Следующий();
		ДокОказание = ВыборкаДок.Ссылка.ПолучитьОбъект();
		ДокОказание.УстановитьПометкуУдаления(Ложь);
		ДокОказание.Услуги.Очистить();
	Иначе
		ДокОказание = Документы.А_ОказаниеУслугМеждуПодразделениями.СоздатьДокумент();
	КонецЕсли;

	// === 6. Заповнення шапки ===
	ДокОказание.Дата                  = Дата;
	ДокОказание.Организация           = Организация;
	ДокОказание.ОтгрузкаПродукции     = Ссылка;
	ДокОказание.А_Обработан           = Истина;
	ДокОказание.А_ВведенВЕРП          = Истина;
	ДокОказание.Комментарий           = "Отгрузка продукции " + СокрЛП(НазваниеЗаказа);

	// === 7. Довідкові значення ===
	СДД = СтатьяДенежныхСредств;
	Если НЕ ЗначениеЗаполнено(СДД) Тогда
		Сообщить("Не вказано Статтю Денежных Средств у відвантаженні " + Ссылка);
		Возврат;
	КонецЕсли;

	НоменклатураУслуг      = СДД.А_Номенклатура;
	СтатьяРасходовДляУслуг = СДД.А_СтатьяРасходов;
	ФормаОплатыБезнал      = Перечисления.ФормыОплаты.Безналичная;

	// === 8. Заповнення ТЧ Услуги ===
	КодСтроки         = 0;
	СуммаДокументаЛок = 0;

	Для каждого СтрокаСостав Из Состав Цикл

		Если СтрокаСостав.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		КодСтроки    = КодСтроки + 1;
		НоваяСтрока  = ДокОказание.Услуги.Добавить();
		НоваяСтрока.КодСтроки = КодСтроки;

		НаправлДохода = ?(ЗначениеЗаполнено(СтрокаСостав.НаправлениеДохода), СтрокаСостав.НаправлениеДохода, НаправлениеДохода);
		НаправлРасхода = ?(ЗначениеЗаполнено(СтрокаСостав.НаправлениеРасхода), СтрокаСостав.НаправлениеРасхода, НаправлениеРасхода);

		НоваяСтрока.ПодразделениеПродавец                      = ПодразделениеДохода;
		НоваяСтрока.ПодразделениеПокупатель                    = ПодразделениеРасхода;
		НоваяСтрока.Сумма                                      = СтрокаСостав.Сумма;
		НоваяСтрока.Номенклатура                               = НоменклатураУслуг;
		НоваяСтрока.СтатьяЗатрат                               = СтатьяРасходовДляУслуг;
		НоваяСтрока.СтатьяДвиженияДенежныхСредствПродавец     = СДД;
		НоваяСтрока.СтатьяДвиженияДенежныхСредствПокупатель   = СДД;
		НоваяСтрока.ФормаОплаты                                = ФормаОплатыБезнал;
		НоваяСтрока.Комментарий = СокрЛП(СтрокаСостав.Номенклатура)
			+ ?(ПустаяСтрока(СтрокаСостав.Примечание), "", " " + СокрЛП(СтрокаСостав.Примечание));

		СуммаДокументаЛок = СуммаДокументаЛок + СтрокаСостав.Сумма;

	КонецЦикла;

	ДокОказание.СуммаДокумента = СуммаДокументаЛок;

	// === 9. Запис, проведення, створення реалізацій ===
	Если КодСтроки > 0 Тогда
		ДокОказание.Записать(РежимЗаписиДокумента.Проведение);
		ДокОказание.СоздатьРеализацииПоОказанииУслугНаСервере();
		Сообщить("Створено/оновлено А_ОказаниеУслуг: " + ДокОказание.Ссылка
			+ ", сума: " + Формат(СуммаДокументаЛок, "ЧЦ=15; ЧДЦ=2"));

		// === 10. Зворотна ссилка у шапці А_ОтгрузкаПродукции ===
		Если ДокОказаниеУслугМеждуПодразделениями <> ДокОказание.Ссылка Тогда
			ОбъектДляЗаписи = Ссылка.ПолучитьОбъект();
			ОбъектДляЗаписи.ДокОказаниеУслугМеждуПодразделениями = ДокОказание.Ссылка;
			ОбъектДляЗаписи.ОбменДанными.Загрузка = Истина;
			ОбъектДляЗаписи.Записать();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура А_ОтгрузкаПродукцииПослеОбмена() Экспорт

	Если А_Обработан Тогда
		Возврат;
	КонецЕсли;

	Если А_Необновлять Тогда
		А_Обработан = Истина;
		Возврат;
	КонецЕсли;
    Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	ПодразделениеДохода      = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(НаправлениеДохода, Подразделение);
	СтатьяДенежныхСредств   = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду("УТ-001066"); // Транспортные расходы
	ПодразделениеРасхода     = Справочники.СтруктураПредприятия.НайтиПоНаименованию(СокрЛП(Заказчик));
	СуммаДокумента = Состав.Итог("Сумма");
	А_Обработан              = Истина;
    
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	А_ОтгрузкаПродукцииПослеОбмена();

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СуммаДокумента = Состав.Итог("Сумма");
КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	СоздатьДокументОказанияУслугМеждуПодразделениямиПоОтгрузкаПродукции();

КонецПроцедуры
