#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПровестиИЗакрыть(Команда)
	Если ЗаписатьВРежиме(РежимЗаписиДокумента.Проведение) Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДокумент(Команда)
	ЗаписатьВРежиме(РежимЗаписиДокумента.Запись);
КонецПроцедуры

&НаКлиенте
Процедура ПровестиДокумент(Команда)
	ЗаписатьВРежиме(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзДокументовPL(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
		ПоказатьПредупреждение(, "Сначала укажите дату документа — это дата остатков.");
		Возврат;
	КонецЕсли;
	Если Объект.Остатки.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьИзДокументовPLЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			"Табличная часть будет перезаполнена из документов А_ОтчетPL. Продолжить?",
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьИзДокументовPLЗавершение(КодВозвратаДиалога.Да, Неопределено);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзДокументовPLЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьИзДокументовPLНаСервере();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЗаписатьВРежиме(РежимЗаписи)
	Возврат Записать(Новый Структура("РежимЗаписи", РежимЗаписи));
КонецФункции

&НаСервере
Процедура ЗаполнитьИзДокументовPLНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьИзДокументовPL();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");

КонецПроцедуры

#КонецОбласти
