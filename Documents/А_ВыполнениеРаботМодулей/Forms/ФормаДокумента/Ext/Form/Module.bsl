// Форма документа А_ВыполнениеРаботМодулей.
// Матрица «работа x модули»: колонки М1..М_N создаются ПРОГРАММНО по КоличествуМодулей
// (эталон паттерна — УстановкаЗначенийНефинансовыхПоказателей: ИзменитьРеквизиты ->
// Элементы.Добавить -> УстановитьДействие). Хранение нормализовано в ТЧ Работы
// (строка = Работа x НомерМодуля), pivot/unpivot — при чтении/записи формы.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(Объект.СтруктураСебестоимости) Тогда
		ОбновитьПараметрыСтруктуры();
	КонецЕсли;

	Если Объект.КоличествоМодулей > 0 Тогда
		СоздатьКолонкиМатрицы();
		ЗаполнитьМатрицуИзРабот(Объект.Работы);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	// Матрица -> нормализованная ТЧ (писать в ТекущийОбъект, не в Объект!).
	ТекущийОбъект.Работы.Очистить();
	КоличествоМодулей = Макс(Объект.КоличествоМодулей, 1);
	Для Каждого СтрокаМатрицы Из Матрица Цикл
		ПланМодуля = СтрокаМатрицы.ПланЧасы / КоличествоМодулей;
		Для Н = 1 По КоличествоМодулей Цикл
			НоваяСтрока = ТекущийОбъект.Работы.Добавить();
			НоваяСтрока.Работа         = СтрокаМатрицы.Работа;
			НоваяСтрока.Этап           = СтрокаМатрицы.Этап;
			НоваяСтрока.НомерМодуля    = Н;
			НоваяСтрока.ПланЧасыМодуля = ПланМодуля;
			НоваяСтрока.Процент        = СтрокаМатрицы["М" + Н];
			НоваяСтрока.ЧасыВыполнение = ПланМодуля * НоваяСтрока.Процент / 100;
			НоваяСтрока.Комментарий    = СтрокаМатрицы.Комментарий;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// Платформа перечитала объект — восстановить матрицу из актуальной ТЧ.
	ЗаполнитьМатрицуИзРабот(ТекущийОбъект.Работы);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура СтруктураСебестоимостиПриИзменении(Элемент)

	СтруктураСебестоимостиПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура МатрицаПриИзменении(Элемент)

	ПересчитатьИтоги();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьДокумент(Команда)
	ОбщегоНазначенияУТКлиент.Записать(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПровестиДокумент(Команда)
	ОбщегоНазначенияУТКлиент.Провести(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПровестиИЗакрыть(Команда)
