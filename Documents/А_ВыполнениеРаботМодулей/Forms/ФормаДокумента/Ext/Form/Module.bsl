КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзСтруктуры(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.СтруктураСебестоимости) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите структуру себестоимости'"));
		Возврат;
	КонецЕсли;
	ЗаполнитьИзСтруктурыНаСервере();
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоПредыдущему(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.СтруктураСебестоимости) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Укажите структуру себестоимости'"));
		Возврат;
	КонецЕсли;
	ЗаполнитьПоПредыдущемуНаСервере();
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура Процентовать(Команда)

	Оповещение = Новый ОписаниеОповещения("ПроцентоватьЗавершение", ЭтотОбъект);
	ПоказатьВводЧисла(Оповещение, 100, НСтр("ru = 'Процент для выделенных работ (все модули)'"), 5, 2);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_МатрицаМодульПриИзменении(Элемент)

	ТекущиеДанные = Элементы.Матрица.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПересчитатьСтрокуМатрицы(ТекущиеДанные);
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ПроцентоватьЗавершение(Значение, ДополнительныеПараметры) Экспорт

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыделенныеСтроки = Элементы.Матрица.ВыделенныеСтроки;
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		СтрокаМатрицы = Матрица.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если СтрокаМатрицы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Н = 1 По Объект.КоличествоМодулей Цикл
			СтрокаМатрицы["М" + Н] = Значение;
		КонецЦикла;
		ПересчитатьСтрокуМатрицы(СтрокаМатрицы);
	КонецЦикла;
	ПересчитатьИтоги();

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСтрокуМатрицы(СтрокаМатрицы)

	КоличествоМодулей = Макс(Объект.КоличествоМодулей, 1);
	СуммаПроцентов = 0;
	Для Н = 1 По КоличествоМодулей Цикл
		СуммаПроцентов = СуммаПроцентов + СтрокаМатрицы["М" + Н];
	КонецЦикла;
	СтрокаМатрицы.ЧасыВыполнение = СтрокаМатрицы.ПланЧасы / КоличествоМодулей * СуммаПроцентов / 100;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтоги()

	ИтогоПлан = 0;
	ИтогоВыполнение = 0;
	Для Каждого СтрокаМатрицы Из Матрица Цикл
		ИтогоПлан = ИтогоПлан + СтрокаМатрицы.ПланЧасы;
		ИтогоВыполнение = ИтогоВыполнение + СтрокаМатрицы.ЧасыВыполнение;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура СтруктураСебестоимостиПриИзмененииНаСервере()

	ОбновитьПараметрыСтруктуры();
	// Пересоздание колонок: сохранить нечего при смене СС — матрица перезаполняется.
	СоздатьКолонкиМатрицы();
	Матрица.Очистить();
	ЗаполнитьИзСтруктурыНаСервере();

КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыСтруктуры()

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.СтруктураСебестоимости,
		"Подразделение, А_КоличествоМодулей");
	Объект.Подразделение = Реквизиты.Подразделение;
	Объект.КоличествоМодулей = Макс(Реквизиты.А_КоличествоМодулей, 1);

КонецПроцедуры

// Динамические колонки матрицы: снос старых по реестру + создание М1..М_N.
// Порядок строгий: элементы удаляются ДО реквизитов, реквизиты добавляются ДО элементов.
&НаСервере
Процедура СоздатьКолонкиМатрицы()

	// 1. Снос старых элементов и реквизитов (по реестру ДобавленныеКолонки).
	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого ЭлементСписка Из ДобавленныеКолонки Цикл
		ИмяКолонки = ЭлементСписка.Значение;
		ЭлементФормы = Элементы.Найти("Матрица" + ИмяКолонки);
		Если ЭлементФормы <> Неопределено Тогда
			Элементы.Удалить(ЭлементФормы);
		КонецЕсли;
		УдаляемыеРеквизиты.Добавить("Матрица." + ИмяКолонки);
	КонецЦикла;
	ДобавленныеКолонки.Очистить();

	// 2. Новые реквизиты-колонки — ОДНИМ вызовом ИзменитьРеквизиты.
	КоличествоМодулей = Макс(Объект.КоличествоМодулей, 1);
	НовыеРеквизиты = Новый Массив;
	КвалификаторыПроцента = Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Неотрицательный);
	ОписаниеТипаПроцент = Новый ОписаниеТипов("Число", КвалификаторыПроцента);
	Для Н = 1 По КоличествоМодулей Цикл
		НовыеРеквизиты.Добавить(Новый РеквизитФормы("М" + Н, ОписаниеТипаПроцент, "Матрица", "М" + Н));
	КонецЦикла;
	ИзменитьРеквизиты(НовыеРеквизиты, УдаляемыеРеквизиты);

	// 3. Элементы-колонки (после ИзменитьРеквизиты) + обработчик.
	Для Н = 1 По КоличествоМодулей Цикл
		НовыйЭлемент = Элементы.Добавить("МатрицаМ" + Н, Тип("ПолеФормы"), Элементы.Матрица);
		НовыйЭлемент.ПутьКДанным = "Матрица.М" + Н;
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.Заголовок = "М" + Н;
		НовыйЭлемент.Ширина = 5;
		НовыйЭлемент.РастягиватьПоГоризонтали = Ложь;
		НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_МатрицаМодульПриИзменении");
		ДобавленныеКолонки.Добавить("М" + Н);
	КонецЦикла;

	// Порядок: М-колонки между «План, год» и «Виконання, год».
	Для Н = 1 По КоличествоМодулей Цикл
		Элементы.Переместить(Элементы["МатрицаМ" + Н], Элементы.Матрица, Элементы.МатрицаЧасыВыполнение);
	КонецЦикла;

КонецПроцедуры

// ТЧ Работы (нормализованная) -> матрица формы. Колонки уже созданы.
&НаСервере
Процедура ЗаполнитьМатрицуИзРабот(КоллекцияРабот)

	Матрица.Очистить();
	СоответствиеСтрок = Новый Соответствие;
	Для Каждого СтрокаРабот Из КоллекцияРабот Цикл
		СтрокаМатрицы = СоответствиеСтрок.Получить(СтрокаРабот.Работа);
		Если СтрокаМатрицы = Неопределено Тогда
			СтрокаМатрицы = Матрица.Добавить();
			СтрокаМатрицы.Работа = СтрокаРабот.Работа;
			СтрокаМатрицы.Этап = СтрокаРабот.Этап;
			СтрокаМатрицы.Комментарий = СтрокаРабот.Комментарий;
			СоответствиеСтрок.Вставить(СтрокаРабот.Работа, СтрокаМатрицы);
		КонецЕсли;
		СтрокаМатрицы.ПланЧасы = СтрокаМатрицы.ПланЧасы + СтрокаРабот.ПланЧасыМодуля;
		СтрокаМатрицы.ЧасыВыполнение = СтрокаМатрицы.ЧасыВыполнение + СтрокаРабот.ЧасыВыполнение;
		Если СтрокаРабот.НомерМодуля >= 1 И СтрокаРабот.НомерМодуля <= Объект.КоличествоМодулей Тогда
			СтрокаМатрицы["М" + СтрокаРабот.НомерМодуля] = СтрокаРабот.Процент;
		КонецЕсли;
	КонецЦикла;
	ПересчитатьИтогиНаСервере();

КонецПроцедуры

// Работы и план из А_СтруктураСебестоимости.Работы (свертка по работе; введённые проценты сохраняются).
&НаСервере
Процедура ЗаполнитьИзСтруктурыНаСервере()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", Объект.СтруктураСебестоимости);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.Работа КАК Работа,
	|	МАКСИМУМ(Р.Этап) КАК Этап,
	|	СУММА(Р.Количество) КАК ПланЧасы
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Работы КАК Р
	|ГДЕ
	|	Р.Ссылка = &СС
	|СГРУППИРОВАТЬ ПО
	|	Р.Работа";

	СтарыеПроценты = Новый Соответствие;
	Для Каждого СтрокаМатрицы Из Матрица Цикл
		Проценты = Новый Массив;
		Для Н = 1 По Объект.КоличествоМодулей Цикл
			Проценты.Добавить(СтрокаМатрицы["М" + Н]);
		КонецЦикла;
		СтарыеПроценты.Вставить(СтрокаМатрицы.Работа, Проценты);
	КонецЦикла;

	Матрица.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаМатрицы = Матрица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаМатрицы, Выборка);
		Проценты = СтарыеПроценты.Получить(Выборка.Работа);
		Если Проценты <> Неопределено Тогда
			Для Н = 1 По Объект.КоличествоМодулей Цикл
				СтрокаМатрицы["М" + Н] = Проценты[Н - 1];
			КонецЦикла;
		КонецЕсли;
		ПересчитатьСтрокуМатрицыНаСервере(СтрокаМатрицы);
	КонецЦикла;
	ПересчитатьИтогиНаСервере();

КонецПроцедуры

// Перенос процентов из предыдущего снимка (срез РС, исключая сам документ).
&НаСервере
Процедура ЗаполнитьПоПредыдущемуНаСервере()

	Если Матрица.Количество() = 0 Тогда
		ЗаполнитьИзСтруктурыНаСервере();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", Объект.СтруктураСебестоимости);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент", Объект.Дата);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Работа КАК Работа,
	|	П.НомерМодуля КАК НомерМодуля,
	|	МАКСИМУМ(П.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_МаксПериод
	|ИЗ
	|	РегистрСведений.А_ПроцентыВыполненияМодулей КАК П
	|ГДЕ
	|	П.СтруктураСебестоимости = &СС
	|	И П.Регистратор <> &Ссылка
	|	И П.Период <= &Момент
	|СГРУППИРОВАТЬ ПО
	|	П.Работа,
	|	П.НомерМодуля
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Работа КАК Работа,
	|	П.НомерМодуля КАК НомерМодуля,
	|	МАКСИМУМ(П.Процент) КАК Процент
	|ИЗ
	|	РегистрСведений.А_ПроцентыВыполненияМодулей КАК П
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксПериод КАК М
	|		ПО П.Работа = М.Работа
	|			И П.НомерМодуля = М.НомерМодуля
	|			И П.Период = М.Период
	|ГДЕ
	|	П.СтруктураСебестоимости = &СС
	|	И П.Регистратор <> &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	П.Работа,
	|	П.НомерМодуля";

	СтрокиПоРаботе = Новый Соответствие;
	Для Каждого СтрокаМатрицы Из Матрица Цикл
		СтрокиПоРаботе.Вставить(СтрокаМатрицы.Работа, СтрокаМатрицы);
	КонецЦикла;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаМатрицы = СтрокиПоРаботе.Получить(Выборка.Работа);
		Если СтрокаМатрицы = Неопределено
			ИЛИ Выборка.НомерМодуля < 1
			ИЛИ Выборка.НомерМодуля > Объект.КоличествоМодулей Тогда
			Продолжить;
		КонецЕсли;
		СтрокаМатрицы["М" + Выборка.НомерМодуля] = Выборка.Процент;
	КонецЦикла;

	Для Каждого СтрокаМатрицы Из Матрица Цикл
		ПересчитатьСтрокуМатрицыНаСервере(СтрокаМатрицы);
	КонецЦикла;
	ПересчитатьИтогиНаСервере();

КонецПроцедуры

&НаСервере
Процедура ПересчитатьСтрокуМатрицыНаСервере(СтрокаМатрицы)

	КоличествоМодулей = Макс(Объект.КоличествоМодулей, 1);
	СуммаПроцентов = 0;
	Для Н = 1 По КоличествоМодулей Цикл
		СуммаПроцентов = СуммаПроцентов + СтрокаМатрицы["М" + Н];
	КонецЦикла;
	СтрокаМатрицы.ЧасыВыполнение = СтрокаМатрицы.ПланЧасы / КоличествоМодулей * СуммаПроцентов / 100;

КонецПроцедуры

&НаСервере
Процедура ПересчитатьИтогиНаСервере()

	ИтогоПлан = 0;
	ИтогоВыполнение = 0;
	Для Каждого СтрокаМатрицы Из Матрица Цикл
		ИтогоПлан = ИтогоПлан + СтрокаМатрицы.ПланЧасы;
		ИтогоВыполнение = ИтогоВыполнение + СтрокаМатрицы.ЧасыВыполнение;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
