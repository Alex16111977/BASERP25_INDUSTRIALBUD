#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Документ А_ВыполнениеРаботМодулей.
// Снимок НАКОПЛЕННЫХ процентов выполнения работ по модулям на дату документа
// (модель «снимок в документе + дельта в регистре», по образцу Rarus УСОERP_УчетВыполненныхРабот).
// ТЧ Работы нормализована: строка = Работа x НомерМодуля; матрицу «работа x модули»
// рисует форма (динамические колонки, эталон УстановкаЗначенийНефинансовыхПоказателей).
// Движения:
//  - РН.А_ВыполнениеРаботМодулей (обороты): ЧасыВыполнение = ПланЧасыМодуля x (Процент - ПроцентПред)/100 — ДЕЛЬТА;
//  - РС.А_ПроцентыВыполненияМодулей (по позиции регистратора): Процент — снимок для среза последних.
// Спец: docs/superpowers/specs/2026-07-06-выполнение-работ-модулей-design.md

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(СтруктураСебестоимости) Тогда
		Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
			Подразделение = СтруктураСебестоимости.Подразделение;
		КонецЕсли;
		Если КоличествоМодулей = 0 Тогда
			КоличествоМодулей = Макс(СтруктураСебестоимости.А_КоличествоМодулей, 1);
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	// Процент в допустимых границах и номер модуля в пределах шапки.
	Для Каждого СтрокаРабот Из Работы Цикл
		ИндексСтроки = Работы.Индекс(СтрокаРабот);
		Если СтрокаРабот.Процент < 0 ИЛИ СтрокаРабот.Процент > 100 Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Работа ""%1"", модуль %2: процент %3 вне диапазона 0..100'"),
					СтрокаРабот.Работа, СтрокаРабот.НомерМодуля, СтрокаРабот.Процент),
				ЭтотОбъект, "Работы[" + ИндексСтроки + "].Процент",, Отказ);
		КонецЕсли;
		Если СтрокаРабот.НомерМодуля < 1 ИЛИ СтрокаРабот.НомерМодуля > КоличествоМодулей Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Работа ""%1"": номер модуля %2 вне диапазона 1..%3'"),
					СтрокаРабот.Работа, СтрокаРабот.НомерМодуля, КоличествоМодулей),
				ЭтотОбъект, "Работы[" + ИндексСтроки + "].НомерМодуля",, Отказ);
		КонецЕсли;
	КонецЦикла;

	// Неубывание против предыдущего снимка (исключая сам документ).
	ПредыдущиеПроценты = ПредыдущиеПроцентыМодулей();
	Для Каждого СтрокаРабот Из Работы Цикл
		КлючСтроки = КлючРаботаМодуль(СтрокаРабот.Работа, СтрокаРабот.НомерМодуля);
		ПроцентПред = ПредыдущиеПроценты.Получить(КлючСтроки);
		Если ПроцентПред <> Неопределено И СтрокаРабот.Процент < ПроцентПред Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Работа ""%1"", модуль %2: процент %3 меньше зафиксированного ранее %4 (снижение выполнения)'"),
					СтрокаРабот.Работа, СтрокаРабот.НомерМодуля, СтрокаРабот.Процент, ПроцентПред),
				ЭтотОбъект, "Работы[" + Работы.Индекс(СтрокаРабот) + "].Процент");
			// Предупреждение без Отказа: корректировка вниз допустима осознанно (дельта уйдёт минусом).
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.А_ВыполнениеРаботМодулей.Записывать = Истина;
	Движения.А_ВыполнениеРаботМодулей.Очистить();
	Движения.А_ПроцентыВыполненияМодулей.Записывать = Истина;
	Движения.А_ПроцентыВыполненияМодулей.Очистить();

	ПредыдущиеПроценты = ПредыдущиеПроцентыМодулей();

	Для Каждого СтрокаРабот Из Работы Цикл

		КлючСтроки = КлючРаботаМодуль(СтрокаРабот.Работа, СтрокаРабот.НомерМодуля);
		ПроцентПред = ПредыдущиеПроценты.Получить(КлючСтроки);
		Если ПроцентПред = Неопределено Тогда
			ПроцентПред = 0;
		КонецЕсли;

		ДельтаПроцент = СтрокаРабот.Процент - ПроцентПред;
		ЧасыДельта = СтрокаРабот.ПланЧасыМодуля * ДельтаПроцент / 100;

		Если ЧасыДельта <> 0 Тогда
			Движение = Движения.А_ВыполнениеРаботМодулей.Добавить();
			Движение.Период                 = Дата;
			Движение.СтруктураСебестоимости = СтруктураСебестоимости;
			Движение.Подразделение          = Подразделение;
			Движение.Работа                 = СтрокаРабот.Работа;
			Движение.НомерМодуля            = СтрокаРабот.НомерМодуля;
			Движение.Этап                   = СтрокаРабот.Этап;
			Движение.ЧасыВыполнение         = ЧасыДельта;
		КонецЕсли;

		// Снимок процента пишем всегда (в т.ч. 0 после корректировки вниз) — срез последних должен видеть актуальное.
		ЗаписьСреза = Движения.А_ПроцентыВыполненияМодулей.Добавить();
		ЗаписьСреза.Период                 = Дата;
		ЗаписьСреза.СтруктураСебестоимости = СтруктураСебестоимости;
		ЗаписьСреза.Работа                 = СтрокаРабот.Работа;
		ЗаписьСреза.НомерМодуля            = СтрокаРабот.НомерМодуля;
		ЗаписьСреза.Процент                = СтрокаРабот.Процент;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Предыдущий снимок процентов по СС: последняя запись РС на момент документа,
// ИСКЛЮЧАЯ сам документ (иначе при перепроведении дельта обнулится).
//
// Возвращаемое значение:
//  Соответствие - ключ "УИДРаботы|НомерМодуля" -> Процент (Число).
Функция ПредыдущиеПроцентыМодулей()

	Результат = Новый Соответствие;
	Если НЕ ЗначениеЗаполнено(СтруктураСебестоимости) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СС", СтруктураСебестоимости);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Момент", Дата);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	П.Работа КАК Работа,
	|	П.НомерМодуля КАК НомерМодуля,
	|	МАКСИМУМ(П.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_МаксПериод
	|ИЗ
	|	РегистрСведений.А_ПроцентыВыполненияМодулей КАК П
	|ГДЕ
	|	П.СтруктураСебестоимости = &СС
	|	И П.Регистратор <> &Ссылка
	|	И П.Период <= &Момент
	|СГРУППИРОВАТЬ ПО
	|	П.Работа,
	|	П.НомерМодуля
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	П.Работа КАК Работа,
	|	П.НомерМодуля КАК НомерМодуля,
	|	МАКСИМУМ(П.Процент) КАК Процент
	|ИЗ
	|	РегистрСведений.А_ПроцентыВыполненияМодулей КАК П
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_МаксПериод КАК М
	|		ПО П.Работа = М.Работа
	|			И П.НомерМодуля = М.НомерМодуля
	|			И П.Период = М.Период
	|ГДЕ
	|	П.СтруктураСебестоимости = &СС
	|	И П.Регистратор <> &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	П.Работа,
	|	П.НомерМодуля";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(КлючРаботаМодуль(Выборка.Работа, Выборка.НомерМодуля), Выборка.Процент);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция КлючРаботаМодуль(Работа, НомерМодуля)
	Возврат Строка(Работа.УникальныйИдентификатор()) + "|" + Формат(НомерМодуля, "ЧГ=0");
КонецФункции

#КонецОбласти

#КонецЕсли
