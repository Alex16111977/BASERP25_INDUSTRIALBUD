КонецПроцедуры



Процедура НачислитьУслугиНаСервере() Экспорт

    Услуги.Очистить();
    Деньги.Очистить();
	
    НоменклатураУслуга = Справочники.Номенклатура.НайтиПоКоду("0Ц-00000002");

    НаправлениеПриход = Перечисления.ТипыЗначенийПоказателейБюджетногоОтчета.Приход;
    НаправлениеРасход = Перечисления.ТипыЗначенийПоказателейБюджетногоОтчета.Расход;

    КоличествоСтрок = СоставБДДС.Количество();

    // ============================================================
    // ПРОХОД 1: Разбивка на группы (комментарий + позиция + баланс)
    // ============================================================
    МассивГрупп = Новый Массив;

    ТекГруппа = НоваяГруппа();

    Для Индекс = 0 По КоличествоСтрок - 1 Цикл

        ТекСтрока = СоставБДДС[Индекс];
        Направление = ТекСтрока.НаправлениеДДС;

        Если Направление <> НаправлениеПриход И Направление <> НаправлениеРасход Тогда
            Продолжить;
        КонецЕсли;

        КоммСтроки = ОчиститьКомментарий(ТекСтрока.Комментарий);
        ЭтоПриход = (Направление = НаправлениеПриход);

        // Решаем: добавить в текущую группу или начать новую
        НачатьНовую = Ложь;

        Если ТекГруппа.МассивПриход.Количество() = 0 И ТекГруппа.МассивРасход.Количество() = 0 Тогда
            // Группа пустая — добавляем
        Иначе
            ЕстьПриход = ТекГруппа.МассивПриход.Количество() > 0;
            ЕстьРасход = ТекГруппа.МассивРасход.Количество() > 0;
            КоммСовпадает = КомментарийСовпадает(КоммСтроки, ТекГруппа.Комментарии);

            // Смена направления: текущая строка Приход, а в группе уже есть Расходы
            СменаНаправления = ЭтоПриход И ЕстьРасход;

            Если СменаНаправления И ЕстьПриход И НЕ КоммСовпадает Тогда
                НачатьНовую = Истина;
            КонецЕсли;
        КонецЕсли;

        Если НачатьНовую Тогда
            МассивГрупп.Добавить(ТекГруппа);
            ТекГруппа = НоваяГруппа();
        КонецЕсли;

        // Добавляем строку в текущую группу
        Если ЭтоПриход Тогда
            ТекГруппа.МассивПриход.Добавить(Индекс);
            ТекГруппа.ИтогоПриход = ТекГруппа.ИтогоПриход + ТекСтрока.Сумма;
        Иначе
            ТекГруппа.МассивРасход.Добавить(Индекс);
            ТекГруппа.ИтогоРасход = ТекГруппа.ИтогоРасход + ТекСтрока.Сумма;
        КонецЕсли;

        Если ЗначениеЗаполнено(КоммСтроки) Тогда
            ТекГруппа.Комментарии.Вставить(КоммСтроки, Истина);
        КонецЕсли;

        // Проверяем баланс: если сошёлся и следующая строка с другим комментарием — закрываем
        Если ТекГруппа.МассивПриход.Количество() > 0
            И ТекГруппа.МассивРасход.Количество() > 0
            И ТекГруппа.ИтогоПриход > 0
            И Окр(ТекГруппа.ИтогоПриход - ТекГруппа.ИтогоРасход, 2) = 0 Тогда

            ЗакрытьГруппу = Истина;
            Если Индекс < КоличествоСтрок - 1 Тогда
                СледСтрока = СоставБДДС[Индекс + 1];
                КоммСлед = ОчиститьКомментарий(СледСтрока.Комментарий);
                Если КомментарийСовпадает(КоммСлед, ТекГруппа.Комментарии) Тогда
                    ЗакрытьГруппу = Ложь;
                КонецЕсли;
            КонецЕсли;

            Если ЗакрытьГруппу Тогда
                МассивГрупп.Добавить(ТекГруппа);
                ТекГруппа = НоваяГруппа();
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    // Добавляем последнюю группу если непустая
    Если ТекГруппа.МассивПриход.Количество() > 0 ИЛИ ТекГруппа.МассивРасход.Количество() > 0 Тогда
        МассивГрупп.Добавить(ТекГруппа);
    КонецЕсли;

    // ============================================================
    // ПРОХОД 2: Склейка сирот по комментарию
    // ============================================================
    МассивСирот = Новый Массив;

    Для Каждого Группа Из МассивГрупп Цикл
        ЭтоСирота = (Группа.МассивПриход.Количество() = 0) ИЛИ (Группа.МассивРасход.Количество() = 0);
        Если ЭтоСирота Тогда
            МассивСирот.Добавить(Группа);
        КонецЕсли;
    КонецЦикла;

    Для Каждого Сирота Из МассивСирот Цикл

        Найдена = Ложь;
        Для Каждого Группа Из МассивГрупп Цикл
            Если Группа = Сирота Тогда
                Продолжить;
            КонецЕсли;

            КоммСовпал = Ложь;
            Для Каждого КлючЗнач Из Сирота.Комментарии Цикл
                Если Группа.Комментарии.Получить(КлючЗнач.Ключ) <> Неопределено Тогда
                    КоммСовпал = Истина;
                    Прервать;
                КонецЕсли;
            КонецЦикла;

            Если НЕ КоммСовпал Тогда
                Продолжить;
            КонецЕсли;

            Баланс = Окр(Группа.ИтогоПриход - Группа.ИтогоРасход, 2);
            Если Баланс = 0 И Группа.ИтогоПриход > 0 Тогда
                Продолжить;
            КонецЕсли;

            Для Каждого Инд Из Сирота.МассивПриход Цикл
                Группа.МассивПриход.Добавить(Инд);
            КонецЦикла;
            Группа.ИтогоПриход = Группа.ИтогоПриход + Сирота.ИтогоПриход;

            Для Каждого Инд Из Сирота.МассивРасход Цикл
                Группа.МассивРасход.Добавить(Инд);
            КонецЦикла;
            Группа.ИтогоРасход = Группа.ИтогоРасход + Сирота.ИтогоРасход;

            Для Каждого КлючЗнач Из Сирота.Комментарии Цикл
                Группа.Комментарии.Вставить(КлючЗнач.Ключ, Истина);
            КонецЦикла;

            Сирота.МассивПриход = Новый Массив;
            Сирота.МассивРасход = Новый Массив;

            Найдена = Истина;
            Прервать;
        КонецЦикла;

        Если НЕ Найдена Тогда
            Сообщить("ВНИМАНИЕ: Группа-сирота не найдена для склейки. Комментарии: "
                + КомментарииВСтроку(Сирота.Комментарии));
        КонецЕсли;

    КонецЦикла;

    // ============================================================
    // ПРОХОД 3: Генерация строк Услуги
    // ============================================================
    НомерГруппы = 0;

    Для Каждого Группа Из МассивГрупп Цикл

        Если Группа.МассивПриход.Количество() = 0 И Группа.МассивРасход.Количество() = 0 Тогда
            Продолжить;
        КонецЕсли;

        НомерГруппы = НомерГруппы + 1;

        Баланс = Окр(Группа.ИтогоПриход - Группа.ИтогоРасход, 2);
        Если Баланс <> 0 ИЛИ Группа.ИтогоПриход = 0 Тогда
            Сообщить("ВНИМАНИЕ: Группа №" + НомерГруппы + " не сбалансирована! "
                + "Приход = " + Формат(Группа.ИтогоПриход, "ЧДЦ=2")
                + ", Расход = " + Формат(Группа.ИтогоРасход, "ЧДЦ=2")
                + ", Разница = " + Формат(Баланс, "ЧДЦ=2")
                + " [" + КомментарииВСтроку(Группа.Комментарии) + "]");
        КонецЕсли;

        Если Группа.МассивПриход.Количество() > 0 И Группа.МассивРасход.Количество() > 0 Тогда
            СоздатьСтрокиУслугИзГруппы(Группа.МассивПриход, Группа.МассивРасход, НоменклатураУслуга, НомерГруппы);
        Иначе
            Сообщить("Группа №" + НомерГруппы + " содержит только "
                + ?(Группа.МассивПриход.Количество() > 0, "приходы", "расходы")
                + " — невозможно создать строки услуг."
                + " [" + КомментарииВСтроку(Группа.Комментарии) + "]");
        КонецЕсли;

    КонецЦикла;

    Сообщить("Заполнено строк Услуги: " + Услуги.Количество()
        + " из " + КоличествоСтрок + " строк БДДС, "
        + НомерГруппы + " групп.");

    А_ОтметитьКредитованиеПоСтатьям();
    Если Кредитование Тогда
        Услуги.Очистить();
    КонецЕсли;

КонецПроцедуры

Функция НоваяГруппа() Экспорт
    Группа = Новый Структура;
    Группа.Вставить("МассивПриход", Новый Массив);
    Группа.Вставить("МассивРасход", Новый Массив);
    Группа.Вставить("ИтогоПриход", 0);
    Группа.Вставить("ИтогоРасход", 0);
    Группа.Вставить("Комментарии", Новый Соответствие);
    Возврат Группа;
КонецФункции

Функция ОчиститьКомментарий(Комментарий) Экспорт
    Результат = СокрЛП(Комментарий);
    Результат = СтрЗаменить(Результат, Символы.Таб, " ");
    Результат = СтрЗаменить(Результат, "¶", "");
    Возврат СокрЛП(Результат);
КонецФункции

Функция КомментарийСовпадает(КоммСтроки, СоответствиеКомментариев) Экспорт
    Если НЕ ЗначениеЗаполнено(КоммСтроки) Тогда
        Возврат Ложь;
    КонецЕсли;
    Возврат СоответствиеКомментариев.Получить(КоммСтроки) <> Неопределено;
КонецФункции

Функция КомментарииВСтроку(СоответствиеКомментариев) Экспорт
    Результат = "";
    Для Каждого КлючЗнач Из СоответствиеКомментариев Цикл
        Если ЗначениеЗаполнено(Результат) Тогда
            Результат = Результат + ", ";
        КонецЕсли;
        Результат = Результат + КлючЗнач.Ключ;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура СоздатьСтрокиУслугИзГруппы(МассивПриход, МассивРасход, НоменклатураУслуга, НомерГруппы) Экспорт

    ПерваяСтрокаПриход = СоставБДДС[МассивПриход[0]];

    ПодразделениеПродавец = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(
        ПерваяСтрокаПриход.Направление, ПерваяСтрокаПриход.Подразделение);

    СтатьяДДСПродавец = ПерваяСтрокаПриход.СтатьяДвиженияДенежныхСредств;

    КомментарийПриход = "";
    Для Каждого ИндексПриход Из МассивПриход Цикл
        СтрокаПриход = СоставБДДС[ИндексПриход];
        ТекКомментарий = СокрЛП(СтрокаПриход.Комментарий);
        Если ЗначениеЗаполнено(ТекКомментарий) И Найти(КомментарийПриход, ТекКомментарий) = 0 Тогда
            Если ЗначениеЗаполнено(КомментарийПриход) Тогда
                КомментарийПриход = КомментарийПриход + ", ";
            КонецЕсли;
            КомментарийПриход = КомментарийПриход + ТекКомментарий;
        КонецЕсли;
    КонецЦикла;

    Для Каждого ИндексРасход Из МассивРасход Цикл

        СтрокаРасход = СоставБДДС[ИндексРасход];

        Если СтрокаРасход.Сумма = 0 Тогда
            Продолжить;
        КонецЕсли;
		
		ПодразделениеПокупатель = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(
            СтрокаРасход.Направление, СтрокаРасход.Подразделение);

        НоваяСтрока = Услуги.Добавить();

        НоваяСтрока.Сумма = СтрокаРасход.Сумма;

        НоваяСтрока.ПодразделениеПокупатель = ПодразделениеПокупатель;

        НоваяСтрока.ПодразделениеПродавец = ПодразделениеПродавец;

        КомментарийРасход = СокрЛП(СтрокаРасход.Комментарий);
        НоваяСтрока.Комментарий = Лев(КомментарийПриход + " /" + КомментарийРасход, 50);

        НоваяСтрока.Номенклатура = НоменклатураУслуга;

        НоваяСтрока.СтатьяЗатрат = СтрокаРасход.СтатьяДвиженияДенежныхСредств.А_СтатьяРасходов;

        НоваяСтрока.СтатьяДвиженияДенежныхСредствПродавец = СтатьяДДСПродавец;
        НоваяСтрока.СтатьяДвиженияДенежныхСредствПокупатель = СтрокаРасход.СтатьяДвиженияДенежныхСредств;  
		НоваяСтрока.ФормаОплаты     = СтрокаРасход.ВидОплаты;	
          
		
		
		НоваяСтрокаДеньги = Деньги.Добавить();
		НоваяСтрокаДеньги.Сумма = СтрокаРасход.Сумма;
		НоваяСтрокаДеньги.ПодразделениеРасход = ПодразделениеПокупатель;
		НоваяСтрокаДеньги.ПодразделениеПриход = ПодразделениеПродавец;
		НоваяСтрокаДеньги.Сумма = СтрокаРасход.Сумма;
	    НоваяСтрокаДеньги.ФормаОплаты     = СтрокаРасход.ВидОплаты;
		НоваяСтрокаДеньги.Комментарий = Лев(КомментарийПриход + " /" + КомментарийРасход, 50);
        НоваяСтрокаДеньги.СтатьяДвиженияДенежныхСредствРасход = СтрокаРасход.СтатьяДвиженияДенежныхСредств;
		НоваяСтрокаДеньги.СтатьяДвиженияДенежныхСредствПриход = СтатьяДДСПродавец;
        НоваяСтрокаДеньги.ТипыРасчетаДенежнымиСредствами =  Перечисления.ТипыРасчетаДенежнымиСредствами.РасходДенежныхСредств;
		
		Если ЗначениеЗаполнено(НоваяСтрокаДеньги.ПодразделениеРасход.Родитель) Тогда
		   СчетКассаРасход = НоваяСтрокаДеньги.ПодразделениеРасход.Родитель.А_ОсновнойБанковскийСчет;
		Иначе	
		   СчетКассаРасход = НоваяСтрокаДеньги.ПодразделениеРасход.А_ОсновнойБанковскийСчет;
	   КонецЕсли;  
	   
	   Если ЗначениеЗаполнено(НоваяСтрокаДеньги.ПодразделениеПриход.Родитель) Тогда
		   СчетКассаПриход = НоваяСтрокаДеньги.ПодразделениеПриход.Родитель.А_ОсновнойБанковскийСчет;
		Иначе	
		   СчетКассаПриход = НоваяСтрокаДеньги.ПодразделениеПриход.А_ОсновнойБанковскийСчет;
	   КонецЕсли;
	   
	   НоваяСтрокаДеньги.СчетКассаРасход = СчетКассаРасход;
	   НоваяСтрокаДеньги.СчетКассаПриход = СчетКассаПриход;
		
    КонецЦикла;

КонецПроцедуры

Процедура ПеренестиРаспределениевУслуги() Экспорт
	
	Услуги.Очистить();
	Деньги.Очистить();

	Если Не ЗначениеЗаполнено(ДенежныйДокумент)
		ИЛИ НЕ ДенежныйДокумент.Проведен Тогда
		Возврат; 
	КонецЕсли;   
	НоменклатураУслуга = Справочники.Номенклатура.НайтиПоКоду("0Ц-00000002");
	Если ТипЗнч(ДенежныйДокумент) = Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств") 
		 Тогда
		//Если ДенежныйДокумент.ХозяйственнаяОперация  = Перечисления.ХозяйственныеОперации.ОплатаПоставщику  Тогда
		//	
		//	
		//	
		//КонецЕсли;
		
		ПодразделениеПродавец = ДенежныйДокумент.Подразделение; 
		ФормаОплаты = Перечисления.ФормыОплаты.Безналичная;    
		СчетКассаРасход = ДенежныйДокумент.БанковскийСчет;
	ИначеЕсли ТипЗнч(ДенежныйДокумент) = Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда
		ПодразделениеПродавец = ДенежныйДокумент.Подразделение; 
		ФормаОплаты = Перечисления.ФормыОплаты.Безналичная; 
		СчетКассаРасход = ДенежныйДокумент.БанковскийСчет;
	ИначеЕсли ТипЗнч(ДенежныйДокумент) = Тип("ДокументСсылка.РасходныйКассовыйОрдер") Тогда
		ПодразделениеПродавец = ДенежныйДокумент.Подразделение; 
		ФормаОплаты = Перечисления.ФормыОплаты.Наличная;
		СчетКассаРасход = ДенежныйДокумент.Касса;
	КонецЕсли;
	
	Для каждого СтрокаРасход Из А_Распределение Цикл
	 
	    НоваяСтрока = Услуги.Добавить();
        НоваяСтрока.Сумма = СтрокаРасход.Сумма;
        НоваяСтрока.ПодразделениеПокупатель =  СтрокаРасход.Подразделение;
        НоваяСтрока.ПодразделениеПродавец = ПодразделениеПродавец;
        НоваяСтрока.Номенклатура = НоменклатураУслуга;
        НоваяСтрока.СтатьяЗатрат = СтрокаРасход.СтатьяДвиженияДенежныхСредств.А_СтатьяРасходов;
        НоваяСтрока.СтатьяДвиженияДенежныхСредствПродавец = СтрокаРасход.СтатьяДвиженияДенежныхСредств;
        НоваяСтрока.СтатьяДвиженияДенежныхСредствПокупатель = СтрокаРасход.СтатьяДвиженияДенежныхСредств;
        НоваяСтрока.ФормаОплаты     = ФормаОплаты;  
		
		
		НоваяСтрокаДеньги = Деньги.Добавить();
		НоваяСтрокаДеньги.Сумма = СтрокаРасход.Сумма;
		НоваяСтрокаДеньги.ПодразделениеРасход = СтрокаРасход.Подразделение;
		НоваяСтрокаДеньги.ПодразделениеПриход = ПодразделениеПродавец;
		НоваяСтрокаДеньги.Сумма = СтрокаРасход.Сумма;
	    НоваяСтрокаДеньги.ФормаОплаты     = ФормаОплаты;
        НоваяСтрокаДеньги.СтатьяДвиженияДенежныхСредствРасход = СтрокаРасход.СтатьяДвиженияДенежныхСредств;
		НоваяСтрокаДеньги.СтатьяДвиженияДенежныхСредствПриход = СтрокаРасход.СтатьяДвиженияДенежныхСредств;
        НоваяСтрокаДеньги.ТипыРасчетаДенежнымиСредствами =  Перечисления.ТипыРасчетаДенежнымиСредствами.РасходДенежныхСредств;
        НоваяСтрокаДеньги.СчетКассаРасход     = СчетКассаРасход;
		НоваяСтрокаДеньги.СчетКассаПриход     = СчетКассаРасход;
	КонецЦикла;	
КонецПроцедуры

Процедура ОбновитьОказаниеУслугМеждуПодразделениямиПослеОбмена() Экспорт
	
	
	Если А_ВведенВЕРП ИЛИ Закрытый ИЛИ Проверил Тогда
		Возврат;
	КонецЕсли; 
	
	Если А_Обработан Тогда
		Возврат;
	КонецЕсли;  
	
	Если А_Необновлять Тогда
		А_Обработан = Истина;	
		Возврат;
	КонецЕсли; 
	
	 НачислитьУслугиНаСервере();	
	  ПеренестиРаспределениевУслуги();
	ПодобратьПриобретениеТоваровАвтоматически();
    А_Обработан = Истина; 
	
КонецПроцедуры

 Процедура ПроверитьСтатьюДенежныхСредств(СтатьяДДС)
	
	Если СтатьяДДС.А_ЗапрещеноВыбиратьВУслугиМеждуПодразделениями
		И ЗначениеЗаполнено(СтатьяДДС.А_СтатьяДенегДляВыбора) Тогда
		
		СтатьяДДС = СтатьяДДС.А_СтатьяДенегДляВыбора;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
		//***ERP
	ОбновитьОказаниеУслугМеждуПодразделениямиПослеОбмена(); 
	//***ERP
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;  
	
	// Кредитный документ услуг не начисляет: таблица «Услуги» сбивает с толку и чистится.
	Если Кредитование Тогда
		Услуги.Очистить();
	КонецЕсли;
	
	Если Услуги.Итог("Сумма")<>0 Тогда
		СуммаДокумента = Услуги.Итог("Сумма");
	Иначе
		СуммаДокумента = Деньги.Итог("Сумма");
	КонецЕсли;  
	
       Если ЗначениеЗаполнено(ДенежныйДокумент) Тогда
	 Контрагент = ДенежныйДокумент.Контрагент;
 КонецЕсли;  
 
 КодСтроки = 0;
Для Каждого СтрокаТЗ Из Услуги Цикл
	
	КодСтроки = КодСтроки + 1;
	СтрокаТЗ.КодСтроки = КодСтроки;
	
	ПроверитьСтатьюДенежныхСредств(СтрокаТЗ.СтатьяДвиженияДенежныхСредствПродавец);
	ПроверитьСтатьюДенежныхСредств(СтрокаТЗ.СтатьяДвиженияДенежныхСредствПокупатель);
	
КонецЦикла;
 
 КодСтроки=0;
 Для каждого СтрокаТЗ Из Деньги Цикл
	 КодСтроки=КодСтроки+1;
	 СтрокаТЗ.КодСтроки	 = КодСтроки;  
	 ПроверитьСтатьюДенежныхСредств(СтрокаТЗ.СтатьяДвиженияДенежныхСредствРасход);
	ПроверитьСтатьюДенежныхСредств(СтрокаТЗ.СтатьяДвиженияДенежныхСредствПриход);
 КонецЦикла;

 А_ЗаполнитьКредитныеКолонкиДеньги();

КонецПроцедуры

Процедура УдалитьРеализацииПоОказанииУслуг() Экспорт

	
	// Один запрос: сначала Приобретения (зависят от Реализаций), потом Реализации
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Док
	|ГДЕ
	|	Док.А_РеализацияТоваровУслуг В
	|			(ВЫБРАТЬ
	|				Р.Ссылка
	|			ИЗ
	|				Документ.РеализацияТоваровУслуг КАК Р
	|			ГДЕ
	|				Р.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование)
	|	И НЕ Док.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка,
	|	Док.Проведен
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Док
	|ГДЕ
	|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
	|	И НЕ Док.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДокОснование", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если Выборка.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

КонецПроцедуры


Процедура УдалитьОплаты() Экспорт


	// Один запрос: сначала Поступления, потом Списания
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен
	|ИЗ
	|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК Док
	|ГДЕ
	|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
	|	И НЕ Док.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка,
	|	Док.Проведен
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Док
	|ГДЕ
	|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
	|	И НЕ Док.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДокОснование", Ссылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если Выборка.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

КонецПроцедуры

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Организация               = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	ИнициализироватьДокумент(ДанныеЗаполнения);

КонецПроцедуры


Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	// Полный цикл по приобретению, подобранному автоматически в этой же записи.
	Если А_ТребуетсяОбработатьПриобретение = Истина Тогда
		А_ТребуетсяОбработатьПриобретение = Ложь;
		ОбработатьПриобретениеПоПодбору(ПриобретениеТоваров, Истина);
	КонецЕсли;

КонецПроцедуры



#Область ПодборПриобретенияТоваров

// Допуск сравнения суммы документа и суммы приобретения, грн.
Функция ДопускСуммыПодбораПриобретения() Экспорт
	Возврат 1.00;
КонецФункции

// Полуширина окна поиска приобретения по дате, дней.
Функция ОкноПодбораПриобретенияВДнях() Экспорт
	Возврат 45;
КонецФункции

// Возвращает договор денежного документа и признак автоподбора по нему.
//
// Возвращаемое значение:
//  Структура - Договор (СправочникСсылка.ДоговорыКонтрагентов), ПодбиратьАвтоматически (Булево).
//
Функция ДоговорДенежногоДокументаПодбора() Экспорт

	Результат = Новый Структура("Договор, ПодбиратьАвтоматически",
		Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), Ложь);

	Если НЕ ЗначениеЗаполнено(ДенежныйДокумент) Тогда
		Возврат Результат;
	КонецЕсли;

	// Реквизит А_Договор есть только в расшифровке платежа безналичных документов.
	Если ТипЗнч(ДенежныйДокумент) <> Тип("ДокументСсылка.СписаниеБезналичныхДенежныхСредств")
		И ТипЗнч(ДенежныйДокумент) <> Тип("ДокументСсылка.ПоступлениеБезналичныхДенежныхСредств") Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РП.А_Договор КАК Договор,
	|	РП.А_Договор.А_ПодбиратьДокументПриобретениеВБюджетнойОперации КАК ПодбиратьПриобретение
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК РП
	|ГДЕ
	|	РП.Ссылка = &ДенежныйДокумент
	|	И РП.А_Договор <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РП2.А_Договор,
	|	РП2.А_Договор.А_ПодбиратьДокументПриобретениеВБюджетнойОперации
	|ИЗ
	|	Документ.ПоступлениеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК РП2
	|ГДЕ
	|	РП2.Ссылка = &ДенежныйДокумент
	|	И РП2.А_Договор <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)";
	Запрос.УстановитьПараметр("ДенежныйДокумент", ДенежныйДокумент);

	Договоры = Запрос.Выполнить().Выгрузить();

	// Ровно один договор — берём его. Ноль или несколько разных — подбирать не по чему.
	Если Договоры.Количество() = 1 Тогда
		Результат.Договор = Договоры[0].Договор;
		Результат.ПодбиратьАвтоматически = Договоры[0].ПодбиратьПриобретение;
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Собирает ключ подбора по текущим данным документа.
//
// ВАЖНО: ПередЗаписью пересчитывает СуммаДокумента из табличных частей и подтягивает Контрагент
// из денежного документа УЖЕ ПОСЛЕ вызова ОбновитьОказаниеУслугМеждуПодразделениямиПослеОбмена().
// Поэтому ключ строится здесь по той же логике, а не читается из реквизитов "как есть" —
// иначе на несохранённом документе и в автоподборе ключ окажется пустым.
//
Функция КлючПодбораПриобретения() Экспорт

	Ключ = Новый Структура("Контрагент, Организация, ДатаДокумента, Сумма, Договор, ПодбиратьАвтоматически");
	Ключ.Организация = Организация;
	Ключ.ДатаДокумента = Дата;

	КонтрагентКлюча = Контрагент;
	Если НЕ ЗначениеЗаполнено(КонтрагентКлюча) И ЗначениеЗаполнено(ДенежныйДокумент) Тогда
		КонтрагентКлюча = ДенежныйДокумент.Контрагент;
	КонецЕсли;
	Ключ.Контрагент = КонтрагентКлюча;

	// Повтор логики ПередЗаписью.
	Если Услуги.Итог("Сумма") <> 0 Тогда
		СуммаКлюча = Услуги.Итог("Сумма");
	Иначе
		СуммаКлюча = Деньги.Итог("Сумма");
	КонецЕсли;
	Если СуммаКлюча = 0 Тогда
		СуммаКлюча = СуммаДокумента;
	КонецЕсли;
	Ключ.Сумма = СуммаКлюча;

	ДанныеДоговора = ДоговорДенежногоДокументаПодбора();
	Ключ.Договор = ДанныеДоговора.Договор;
	Ключ.ПодбиратьАвтоматически = ДанныеДоговора.ПодбиратьАвтоматически;

	Возврат Ключ;

КонецФункции

// Возвращает таблицу кандидатов на заполнение реквизита ПриобретениеТоваров,
// отсортированную "лучший — первый": договор, затем тот же месяц, затем ближайшая дата.
//
// Параметры:
//  Ключ - Структура - результат КлючПодбораПриобретения(); Неопределено — собрать самостоятельно.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Приобретение, Номер, ДатаПриобретения, СуммаПриобретения, Договор,
//                    ПриоритетДоговора, ПриоритетМесяца, ОтклонениеДней.
//
Функция НайтиКандидатовПриобретенияТоваров(Ключ = Неопределено) Экспорт

	Если Ключ = Неопределено Тогда
		Ключ = КлючПодбораПриобретения();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	ПТУ.Ссылка КАК Приобретение,
	|	ПТУ.Номер КАК Номер,
	|	ПТУ.Дата КАК ДатаПриобретения,
	|	ПТУ.СуммаДокумента КАК СуммаПриобретения,
	|	ПТУ.Договор КАК Договор,
	|	ВЫБОР
	|		КОГДА &Договор <> ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|				И ПТУ.Договор = &Договор
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПриоритетДоговора,
	|	ВЫБОР
	|		КОГДА НАЧАЛОПЕРИОДА(ПТУ.Дата, МЕСЯЦ) = НАЧАЛОПЕРИОДА(&ДатаДокумента, МЕСЯЦ)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПриоритетМесяца,
	|	ВЫБОР
	|		КОГДА ПТУ.Дата >= &ДатаДокумента
	|			ТОГДА РАЗНОСТЬДАТ(&ДатаДокумента, ПТУ.Дата, ДЕНЬ)
	|		ИНАЧЕ РАЗНОСТЬДАТ(ПТУ.Дата, &ДатаДокумента, ДЕНЬ)
	|	КОНЕЦ КАК ОтклонениеДней
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПТУ
	|ГДЕ
	|	&КлючЗаполнен
	|	И ПТУ.Контрагент = &Контрагент
	|	И ПТУ.Организация = &Организация
	|	И ПТУ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И ПТУ.СуммаДокумента МЕЖДУ &СуммаМинимум И &СуммаМаксимум
	|	И НЕ ПТУ.ПометкаУдаления
	|	И ПТУ.Проведен
	|	И ПТУ.А_РеализацияТоваровУслуг = ЗНАЧЕНИЕ(Документ.РеализацияТоваровУслуг.ПустаяСсылка)
	|	И НЕ ПТУ.Ссылка В
	|			(ВЫБРАТЬ
	|				Оказание.ПриобретениеТоваров
	|			ИЗ
	|				Документ.А_ОказаниеУслугМеждуПодразделениями КАК Оказание
	|			ГДЕ
	|				Оказание.ПриобретениеТоваров <> ЗНАЧЕНИЕ(Документ.ПриобретениеТоваровУслуг.ПустаяСсылка)
	|				И Оказание.Ссылка <> &ТекущийДокумент
	|				И НЕ Оказание.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриоритетДоговора,
	|	ПриоритетМесяца,
	|	ОтклонениеДней,
	|	ДатаПриобретения";

	Допуск = ДопускСуммыПодбораПриобретения();
	Окно = ОкноПодбораПриобретенияВДнях();

	// Пустой контрагент или нулевая сумма — ключа нет. Булев параметр в условии гасит выборку,
	// но таблица возвращается с правильными колонками.
	Запрос.УстановитьПараметр("КлючЗаполнен", ЗначениеЗаполнено(Ключ.Контрагент) И Ключ.Сумма <> 0);
	Запрос.УстановитьПараметр("Контрагент", Ключ.Контрагент);
	Запрос.УстановитьПараметр("Организация", Ключ.Организация);
	Запрос.УстановитьПараметр("Договор", Ключ.Договор);
	Запрос.УстановитьПараметр("ДатаДокумента", Ключ.ДатаДокумента);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Ключ.ДатаДокумента - Окно * 86400));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Ключ.ДатаДокумента + Окно * 86400));
	Запрос.УстановитьПараметр("СуммаМинимум", Ключ.Сумма - Допуск);
	Запрос.УстановитьПараметр("СуммаМаксимум", Ключ.Сумма + Допуск);
	Запрос.УстановитьПараметр("ТекущийДокумент", Ссылка);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Автоподбор для фонового сценария (после обмена). Без диалогов и сообщений.
// Заполняет реквизит ТОЛЬКО при единственном кандидате и ТОЛЬКО если в договоре платежа
// взведён флаг А_ПодбиратьДокументПриобретениеВБюджетнойОперации.
//
// Вместе с приобретением взводится Закрытый — документ фиксируется и перестаёт переобновляться
// обменом (гард в начале ОбновитьОказаниеУслугМеждуПодразделениямиПослеОбмена).
// Проверил НЕ трогаем: этот флаг ставит пользователь.
//
Процедура ПодобратьПриобретениеТоваровАвтоматически() Экспорт

	Если ЗначениеЗаполнено(ПриобретениеТоваров) Тогда
		Возврат;
	КонецЕсли;

	Ключ = КлючПодбораПриобретения();
	Если НЕ Ключ.ПодбиратьАвтоматически Тогда
		Возврат;
	КонецЕсли;

	Кандидаты = НайтиКандидатовПриобретенияТоваров(Ключ);
	Если Кандидаты.Количество() = 1 Тогда
		ПриобретениеТоваров = Кандидаты[0].Приобретение;
		Закрытый = Истина;
		// Полный цикл выполняется в ПриЗаписи: там уже известна ссылка документа.
		А_ТребуетсяОбработатьПриобретение = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область ОбработкаПодобранногоПриобретения

// Проводит найденное приобретение через полный цикл: обратная ссылка, распределение,
// разнесение товаров по подразделениям и перепроведение.
//
// Документ приобретения НЕ изменяется, если он закреплён за другим оказанием услуг,
// если изменение запрещено датой запрета или если в нём есть складские строки
// (не списываемые на расходы — такую закупку делить по подразделениям нельзя).
//
// Параметры:
//  ПриобретениеСсылка - ДокументСсылка.ПриобретениеТоваровУслуг - что обрабатываем.
//  ПереписыватьТовары - Булево - разрешено ли трогать табличную часть Товары
//                       (в договоре взведён А_ПодбиратьДокументПриобретениеВБюджетнойОперации).
//
// Возвращаемое значение:
//  Строка - что сделано или почему не сделано; пригодно для показа пользователю.
//
Функция ОбработатьПриобретениеПоПодбору(ПриобретениеСсылка, ПереписыватьТовары) Экспорт

	Если НЕ ЗначениеЗаполнено(ПриобретениеСсылка) Тогда
		Возврат "Приобретение не указано — обрабатывать нечего.";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "Документ не записан — обратную ссылку в приобретение поставить некуда.";
	КонецЕсли;

	ПриобретениеОбъект = ПриобретениеСсылка.ПолучитьОбъект();
	Если ПриобретениеОбъект = Неопределено Тогда
		Возврат "Документ приобретения не найден в базе.";
	КонецЕсли;

	Если ЗначениеЗаполнено(ПриобретениеОбъект.А_ОказаниеУслугМеждуПодразделениями)
		И ПриобретениеОбъект.А_ОказаниеУслугМеждуПодразделениями <> Ссылка Тогда
		Возврат "Приобретение " + Строка(ПриобретениеСсылка) + " уже закреплено за документом "
			+ Строка(ПриобретениеОбъект.А_ОказаниеУслугМеждуПодразделениями) + " — не изменяем.";
	КонецЕсли;

	Если ДатыЗапретаИзменения.ИзменениеЗапрещено(ПриобретениеОбъект) Тогда
		Возврат "Изменение приобретения " + Строка(ПриобретениеСсылка)
			+ " запрещено датой запрета изменения — документ не тронут.";
	КонецЕсли;

	Если ПриобретениеОбъект.А_ЭтоРеальнаяЗакупкаТоваров() Тогда
		Возврат "В приобретении " + Строка(ПриобретениеСсылка)
			+ " есть строки, которые приходуются на склад, а не списываются на расходы."
			+ " Такую закупку делить по подразделениям нельзя — документ не изменяем,"
			+ " распределите его вручную, если это действительно нужно.";
	КонецЕсли;

	// Для ПУСТОЙ табличной части ставку НДС взять неоткуда без строк А_Услуги — получится
	// "Без НДС" и потеря налогового кредита. Для заполненной ставки берутся из её же строк.
	ТоварыПусты = ПриобретениеОбъект.Товары.Количество() = 0;
	ПереписыватьТоварыФакт = ПереписыватьТовары
		И НЕ (ТоварыПусты И ПриобретениеОбъект.А_Услуги.Количество() = 0);

	СуммаДоОбработки = ПриобретениеОбъект.СуммаДокумента;

	ПриобретениеОбъект.А_ОказаниеУслугМеждуПодразделениями = Ссылка;
	ПриобретениеОбъект.А_ЗаполнитьРаспределениеПоОказаниюУслуг();

	Если ПереписыватьТоварыФакт Тогда
		ПриобретениеОбъект.А_ЗаполнитьТоварыИзРаспределения();
	КонецЕсли;

	БылПроведен = ПриобретениеОбъект.Проведен;
	Если БылПроведен Тогда
		ПриобретениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
		ПриобретениеОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;

	Результат = "Приобретение " + Строка(ПриобретениеСсылка) + ": ссылка на документ проставлена, "
		+ "распределение " + Строка(ПриобретениеОбъект.А_Распределение.Количество()) + " стр.";
	Если ПереписыватьТоварыФакт Тогда
		Результат = Результат + ", товары " + Строка(ПриобретениеОбъект.Товары.Количество()) + " стр."
			+ ?(ТоварыПусты, " (построены из распределения)", " (разнесены по подразделениям)");
	ИначеЕсли НЕ ПереписыватьТовары Тогда
		Результат = Результат + "; товары не тронуты: в договоре не включён автоподбор";
	Иначе
		Результат = Результат + "; товары не тронуты: табличная часть пуста и нет строк услуг,"
			+ " ставку НДС взять неоткуда";
	КонецЕсли;
	Результат = Результат + ?(БылПроведен, "; документ перепроведён.", "; документ записан без проведения.");

	Если НЕ ТоварыПусты И ПриобретениеОбъект.СуммаДокумента <> СуммаДоОбработки Тогда
		Результат = Результат + " ВНИМАНИЕ: сумма документа изменилась с "
			+ Формат(СуммаДоОбработки, "ЧДЦ=2") + " на "
			+ Формат(ПриобретениеОбъект.СуммаДокумента, "ЧДЦ=2") + "!";
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти


#Область КассаПоУмолчанию

// Касса, в которую попадают наличные операции, если в строке Деньги касса не указана.
// Используется прежде всего для кредитования директором: физически деньги лежат в кассе ЦО.
// Имя ищется ТОЧНО: в базе есть ещё «2 Касса ЦО» и «Касса ЦО Строительство».
//
Функция А_КассаПоУмолчаниюДляНаличных() Экспорт

	Возврат Справочники.Кассы.НайтиПоНаименованию("Касса ЦО", Истина);

КонецФункции

#КонецОбласти


#Область ОбъектыРасчетовПлатежныхДокументов

// Заполняет ОбъектРасчетов в строках расшифровки платежа любого платёжного документа:
// списания и поступления безналичных, расходного и приходного кассового ордера.
//
// Тип расчётов выводится из хозяйственной операции документа. Договор берётся из строки
// расшифровки (реквизит А_Договор), а если такого реквизита в документе нет — из шапки:
// у кассовых ордеров расшифровка договора не хранит.
//
// Параметры:
//  ПлатежныйДокумент - ДокументОбъект - документ с табличной частью РасшифровкаПлатежа.
//
Процедура А_ЗаполнитьОбъектыРасчетовВРасшифровке(ПлатежныйДокумент) Экспорт

	ХозОперация = ПлатежныйДокумент.ХозяйственнаяОперация;

	Если ХозОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику
		ИЛИ ХозОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПоставщика Тогда
		ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком;
	ИначеЕсли ХозОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента
		ИЛИ ХозОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту Тогда
		ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
	Иначе
		// Прочие операции объектов расчётов не требуют.
		Возврат;
	КонецЕсли;

	// У кассовых ордеров в расшифровке нет ни договора, ни заказов — проверяем состав по метаданным.
	РеквизитыРасшифровки = ПлатежныйДокумент.Метаданные().ТабличныеЧасти.РасшифровкаПлатежа.Реквизиты;
	ЕстьДоговорВСтроке   = РеквизитыРасшифровки.Найти("А_Договор") <> Неопределено;
	ЕстьЗаказКлиента     = РеквизитыРасшифровки.Найти("А_ЗаказКлиента") <> Неопределено;
	ЕстьЗаказПоставщику  = РеквизитыРасшифровки.Найти("А_ЗаказПоставщику") <> Неопределено;

	Для Каждого СтрокаРасшифровки Из ПлатежныйДокумент.РасшифровкаПлатежа Цикл

		Договор = ?(ЕстьДоговорВСтроке, СтрокаРасшифровки.А_Договор, ПлатежныйДокумент.Договор);
		Если НЕ ЗначениеЗаполнено(Договор) Тогда
			Продолжить;
		КонецЕсли;

		ПараметрыОР = ОбъектыРасчетовСервер.ПолучитьПараметрыОбъектаРасчетов();
		ПараметрыОР.Организация = ПлатежныйДокумент.Организация;
		ПараметрыОР.Партнер     = СтрокаРасшифровки.Партнер;
		ПараметрыОР.Контрагент  = ПлатежныйДокумент.Контрагент;
		ПараметрыОР.Вставить("ПометкаУдаления", Ложь);

		Источник = Договор;
		ТипОР    = Перечисления.ТипыОбъектовРасчетов.Договор;

		Если Договор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным Тогда

			ЗаказКлиента    = ?(ЕстьЗаказКлиента, СтрокаРасшифровки.А_ЗаказКлиента, Неопределено);
			ЗаказПоставщику = ?(ЕстьЗаказПоставщику, СтрокаРасшифровки.А_ЗаказПоставщику, Неопределено);

			Если ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом
				И ЗначениеЗаполнено(ЗаказКлиента) Тогда
				Источник = ЗаказКлиента;
				ТипОР    = Перечисления.ТипыОбъектовРасчетов.Заказ;
			ИначеЕсли ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком
				И ЗначениеЗаполнено(ЗаказПоставщику) Тогда
				Источник = ЗаказПоставщику;
				ТипОР    = Перечисления.ТипыОбъектовРасчетов.Заказ;
			КонецЕсли;

			Если ТипОР = Перечисления.ТипыОбъектовРасчетов.Заказ Тогда
				ПлатежныйДокумент.Договор = Договор;
				ПлатежныйДокумент.ГруппаФинансовогоУчета = Договор.ГруппаФинансовогоУчета;
			КонецЕсли;

		КонецЕсли;

		ПараметрыОР.Объект      = Источник;
		ПараметрыОР.ТипРасчетов = ТипРасчетов;
		ПараметрыОР.Договор     = Договор;
		ПараметрыОР.Вставить("ТипОбъектаРасчетов", ТипОР);

		СтрокаРасшифровки.ОбъектРасчетов =
			ОбъектыРасчетовСервер.ПроверитьСоздатьОбъектРасчетов(ПараметрыОР);

	КонецЦикла;

КонецПроцедуры

#КонецОбласти


#Область ПартнерРасчетовПоСтатье

// Возвращает партнёра, с которым ведутся расчёты по стороне платежа.
//
// Приоритет у реквизита статьи ДДС `А_ПартнерРасчетов`: он заполняется для статей кредитования,
// возврата кредита, уплаты процентов и дивидендов, чтобы расчёты попадали на кредитора
// (например, на собственника), а не на партнёра подразделения.
//
// Если реквизит не заполнен — работает прежняя логика: партнёр ищется по подразделению.
//
// Параметры:
//  СтатьяДДС     - СправочникСсылка.СтатьиДвиженияДенежныхСредств - статья стороны платежа.
//  Подразделение - СправочникСсылка.СтруктураПредприятия - подразделение стороны платежа.
//
// Возвращаемое значение:
//  СправочникСсылка.Партнеры - найденный партнёр; пустая ссылка, если не найден.
//
Функция А_ПартнерРасчетовПоСтатье(СтатьяДДС, Подразделение) Экспорт

	Если ЗначениеЗаполнено(СтатьяДДС)
		И ЗначениеЗаполнено(СтатьяДДС.А_ПартнерРасчетов) Тогда
		Возврат СтатьяДДС.А_ПартнерРасчетов;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	П.Ссылка КАК Партнер
	|ИЗ
	|	Справочник.Партнеры КАК П
	|ГДЕ
	|	П.А_Подразделение = &Подразделение
	|	И НЕ П.ПометкаУдаления";
	Запрос.УстановитьПараметр("Подразделение", Подразделение);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Партнер;
	КонецЕсли;

	Возврат Справочники.Партнеры.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область КредитныеДоговоры

// Кредитные договоры собственника ведутся цепочкой на каждое подразделение:
// тело кредита, проценты, нераспределённая прибыль. Строка «Деньги» с заданным видом
// договора стороны идёт по этой цепочке, без вида — прежним подбором по подразделению.
// Дизайн: docs/superpowers/specs/2026-10-14-oump-kreditnye-dogovory-design.md.

// Заполняет пустые колонки вида договора и контрагента по настройкам статей ДДС
// (А_ВидКредитногоДоговора, А_ПартнерРасчетов). Заполненное пользователем не трогает.
Процедура А_ЗаполнитьКредитныеКолонкиДеньги() Экспорт

	Если НЕ Кредитование Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаТЗ Из Деньги Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЗ.ВидДоговораРасход)
			И ЗначениеЗаполнено(СтрокаТЗ.СтатьяДвиженияДенежныхСредствРасход) Тогда
			СтрокаТЗ.ВидДоговораРасход = СтрокаТЗ.СтатьяДвиженияДенежныхСредствРасход.А_ВидКредитногоДоговора;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.ВидДоговораРасход) И НЕ ЗначениеЗаполнено(СтрокаТЗ.КонтрагентРасход) Тогда
			СтрокаТЗ.КонтрагентРасход = А_КонтрагентСтороныКредита(СтрокаТЗ.ВидДоговораРасход,
				СтрокаТЗ.СтатьяДвиженияДенежныхСредствРасход, СтрокаТЗ.ПодразделениеРасход);
		КонецЕсли;
		// Кредитор на стороне прихода, заёмщик на стороне расхода — заёмщик отдаёт тело: это возврат,
		// а не новая оплата. Заполнение по Казне ставит всем строкам «Расход денежных средств».
		Если ЗначениеЗаполнено(СтрокаТЗ.ВидДоговораРасход)
			И А_ЭтоСтатьяКредитора(СтрокаТЗ.СтатьяДвиженияДенежныхСредствПриход)
			И НЕ А_ЭтоСтатьяКредитора(СтрокаТЗ.СтатьяДвиженияДенежныхСредствРасход) Тогда
			СтрокаТЗ.ТипыРасчетаДенежнымиСредствами = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТЗ.ВидДоговораПриход)
			И ЗначениеЗаполнено(СтрокаТЗ.СтатьяДвиженияДенежныхСредствПриход) Тогда
			СтрокаТЗ.ВидДоговораПриход = СтрокаТЗ.СтатьяДвиженияДенежныхСредствПриход.А_ВидКредитногоДоговора;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаТЗ.ВидДоговораПриход) И НЕ ЗначениеЗаполнено(СтрокаТЗ.КонтрагентПриход) Тогда
			СтрокаТЗ.КонтрагентПриход = А_КонтрагентСтороныКредита(СтрокаТЗ.ВидДоговораПриход,
				СтрокаТЗ.СтатьяДвиженияДенежныхСредствПриход, СтрокаТЗ.ПодразделениеПриход);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Ставит «Кредитование», если в «Деньгах» есть строка с кредитной статьёй ДДС. Только включает:
// снятую пользователем отметку при записи не возвращает — вызывается из заполнения по Казне.
Процедура А_ОтметитьКредитованиеПоСтатьям() Экспорт

	Для Каждого СтрокаТЗ Из Деньги Цикл
		Если ЗначениеЗаполнено(СтрокаТЗ.СтатьяДвиженияДенежныхСредствРасход)
				И ЗначениеЗаполнено(СтрокаТЗ.СтатьяДвиженияДенежныхСредствРасход.А_ВидКредитногоДоговора)
			ИЛИ ЗначениеЗаполнено(СтрокаТЗ.СтатьяДвиженияДенежныхСредствПриход)
				И ЗначениеЗаполнено(СтрокаТЗ.СтатьяДвиженияДенежныхСредствПриход.А_ВидКредитногоДоговора) Тогда
			Кредитование = Истина;
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Контрагент стороны кредитной строки. Сторона кредитора — та, у статьи ДДС которой задан
// А_ПартнерРасчетов (Воронцов): контрагент кредитора. Сторона заёмщика (у статьи партнёра нет) —
// контрагент самого подразделения, как плательщик во входящей платёжке. Вид договора обеих сторон —
// «Тело кредита» (решение пользователя 14.10.2026: через нераспределённую прибыль не ведём).
Функция А_КонтрагентСтороныКредита(ВидДоговора, СтатьяДДС, Подразделение) Экспорт

	Если А_ЭтоСтатьяКредитора(СтатьяДДС) Тогда
		Возврат А_КонтрагентКредитаПоСтатье(СтатьяДДС);
	КонецЕсли;
	Возврат А_КонтрагентПодразделения(Подразделение);

КонецФункции

// Статья стороны кредитора: у неё задан А_ПартнерРасчетов.
Функция А_ЭтоСтатьяКредитора(СтатьяДДС) Экспорт

	Возврат ЗначениеЗаполнено(СтатьяДДС) И ЗначениеЗаполнено(СтатьяДДС.А_ПартнерРасчетов);

КонецФункции

// Контрагент подразделения: партнёр с А_Подразделение = подразделение.
Функция А_КонтрагентПодразделения(Подразделение) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контр.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контр
	|ГДЕ
	|	Контр.Партнер.А_Подразделение = &Подразделение
	|	И НЕ Контр.ПометкаУдаления
	|	И НЕ Контр.Партнер.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контр.Ссылка";
	Запрос.УстановитьПараметр("Подразделение", Подразделение);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Контрагент;
	КонецЕсли;
	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Имя договора по существующим сериям. Если операция требует тип договора, отличный от
// типа серии (возврат), к имени добавляется тип — иначе два договора были бы неразличимы.
Функция А_ИмяКредитногоДоговора(ВидДоговора, Подразделение, ТипДоговора) Экспорт

	Подр = СокрЛП(Подразделение);
	Если ВидДоговора = Перечисления.А_ВидыКредитныхДоговоров.ТелоКредита Тогда
		Имя = "Кредитование от кредитора -- " + Подр;
		ТипСерии = Перечисления.ТипыДоговоров.СПокупателем;
	ИначеЕсли ВидДоговора = Перечисления.А_ВидыКредитныхДоговоров.Проценты Тогда
		Имя = "%% за использование от кредитора -- " + Подр;
		ТипСерии = Перечисления.ТипыДоговоров.СПоставщиком;
	Иначе
		Имя = "Нераспределенная прибыль -- " + Подр;
		ТипСерии = Перечисления.ТипыДоговоров.СПоставщиком;
	КонецЕсли;

	Если ТипДоговора <> ТипСерии Тогда
		Имя = Имя + ?(ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем, " (Реализация)", " (Закупка)");
	КонецЕсли;

	Возврат Лев(Имя, 150);

КонецФункции

// Ищет кредитный договор контрагента по ключу «организация + подразделение + вид + тип»,
// не находит — создаёт. Несколько договоров одного ключа — берётся первый по дате и наименованию.
Функция А_НайтиИлиСоздатьКредитныйДоговор(Контрагент, Организация, Подразделение, ВидДоговора, ТипДоговора) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Дог.Ссылка КАК Договор
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Дог
	|ГДЕ
	|	Дог.Контрагент = &Контрагент
	|	И Дог.Организация = &Организация
	|	И Дог.Подразделение = &Подразделение
	|	И Дог.А_ВидКредитногоДоговора = &ВидДоговора
	|	И Дог.ТипДоговора = &ТипДоговора
	|	И НЕ Дог.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дог.Дата,
	|	Дог.Наименование";
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Запрос.УстановитьПараметр("ТипДоговора", ТипДоговора);

	Выгрузка = Запрос.Выполнить().Выгрузить();
	Если Выгрузка.Количество() > 1 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Несколько кредитных договоров «"
			+ ВидДоговора + "» по подразделению " + Подразделение + ", взят «" + Выгрузка[0].Договор + "».");
	КонецЕсли;
	Если Выгрузка.Количество() > 0 Тогда
		Возврат Выгрузка[0].Договор;
	КонецЕсли;

	НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	НовыйДоговор.Наименование = А_ИмяКредитногоДоговора(ВидДоговора, Подразделение, ТипДоговора);
	НовыйДоговор.Контрагент = Контрагент;
	НовыйДоговор.Партнер = Контрагент.Партнер;
	НовыйДоговор.Организация = Организация;
	НовыйДоговор.Подразделение = Подразделение;
	НовыйДоговор.Дата = ТекущаяДатаСеанса();
	НовыйДоговор.ТипДоговора = ТипДоговора;
	НовыйДоговор.А_ВидКредитногоДоговора = ВидДоговора;
	НовыйДоговор.А_ВидКонтрагента = Справочники.А_ВидыКонтрагентовДляБаланса.Собственники;
	Если ВидДоговора <> Перечисления.А_ВидыКредитныхДоговоров.НераспределеннаяПрибыль Тогда
		НовыйДоговор.А_СтатьяБаланса = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ЗадолженностьПоКредитам;
	КонецЕсли;
	НовыйДоговор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("980"); // грн
	НовыйДоговор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	Если ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем Тогда
		НовыйДоговор.ГруппаФинансовогоУчета = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с покупателями в национальной валюте");
	Иначе
		НовыйДоговор.ГруппаФинансовогоУчета = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с поставщиками в национальной валюте");
	КонецЕсли;
	НовыйДоговор.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	НовыйДоговор.Согласован = Истина;
	НовыйДоговор.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОсвобожденаОтНДС;
	НовыйДоговор.ВариантОформленияЗакупок = Перечисления.ВариантыОформленияЗакупок.НеРазделять;
	НовыйДоговор.МоментОпределенияБазыНДС = Перечисления.МоментыОпределенияНалоговойБазы.ПоОтгрузке;
	НовыйДоговор.СпособДоставки = Перечисления.СпособыДоставки.ОпределяетсяВРаспоряжении;
	НовыйДоговор.Записать();

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан кредитный договор: " + НовыйДоговор.Наименование);
	Возврат НовыйДоговор.Ссылка;

КонецФункции

// Контрагент кредитора по статье ДДС (её А_ПартнерРасчетов). У партнёра бывает несколько
// карточек-тёзок — предпочитаем ту, у которой уже есть кредитные договоры.
Функция А_КонтрагентКредитаПоСтатье(СтатьяДДС) Экспорт

	Если НЕ ЗначениеЗаполнено(СтатьяДДС) ИЛИ НЕ ЗначениеЗаполнено(СтатьяДДС.А_ПартнерРасчетов) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контр.Ссылка КАК Контрагент
	|ИЗ
	|	Справочник.Контрагенты КАК Контр
	|ГДЕ
	|	Контр.Партнер = &Партнер
	|	И НЕ Контр.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Контр.Ссылка В
	|				(ВЫБРАТЬ
	|					Дог.Контрагент
	|				ИЗ
	|					Справочник.ДоговорыКонтрагентов КАК Дог
	|				ГДЕ
	|					Дог.А_ВидКредитногоДоговора <> ЗНАЧЕНИЕ(Перечисление.А_ВидыКредитныхДоговоров.ПустаяСсылка))
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	Контр.Ссылка";
	Запрос.УстановитьПараметр("Партнер", СтатьяДДС.А_ПартнерРасчетов);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Контрагент;
	КонецЕсли;
	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Кредитная сторона строки «Деньги». Неопределено — документ без отметки «Кредитование»
// или вид договора стороны не задан, работает прежний подбор. Иначе структура с контрагентом и договором стороны;
// Ошибка = Истина — строку пропустить (сообщение уже выведено).
Функция А_КредитнаяСторона(СтрокаДеньги, ЭтоРасход, ТипДоговора) Экспорт

	ВидДоговора = ?(ЭтоРасход, СтрокаДеньги.ВидДоговораРасход, СтрокаДеньги.ВидДоговораПриход);
	Если НЕ Кредитование ИЛИ НЕ ЗначениеЗаполнено(ВидДоговора) Тогда
		Возврат Неопределено;
	КонецЕсли;
	КонтрагентСтороны = ?(ЭтоРасход, СтрокаДеньги.КонтрагентРасход, СтрокаДеньги.КонтрагентПриход);
	ПодразделениеСтороны = ?(ЭтоРасход, СтрокаДеньги.ПодразделениеРасход, СтрокаДеньги.ПодразделениеПриход);

	Результат = Новый Структура("Ошибка, Контрагент, Партнер, Договор, ГруппаФинансовогоУчета, НаправлениеДеятельности, ВалютаВзаиморасчетов", Ложь);
	Если НЕ ЗначениеЗаполнено(КонтрагентСтороны) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Строка " + Строка(СтрокаДеньги.КодСтроки)
			+ ": не задан контрагент для кредитного договора «" + ВидДоговора + "» (" + ПодразделениеСтороны
			+ ") — документы оплат по строке не созданы.");
		Результат.Ошибка = Истина;
		Возврат Результат;
	КонецЕсли;

	Договор = А_НайтиИлиСоздатьКредитныйДоговор(КонтрагентСтороны, Организация, ПодразделениеСтороны, ВидДоговора, ТипДоговора);
	Результат.Контрагент              = КонтрагентСтороны;
	Результат.Партнер                 = Договор.Партнер;
	Результат.Договор                 = Договор;
	Результат.ГруппаФинансовогоУчета  = Договор.ГруппаФинансовогоУчета;
	Результат.НаправлениеДеятельности = Договор.НаправлениеДеятельности;
	Результат.ВалютаВзаиморасчетов    = Договор.ВалютаВзаиморасчетов;
	Возврат Результат;

КонецФункции

#КонецОбласти
