
&НаСервере
Процедура ЗаполнитьЕРПНаСервере()

	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.НачислитьУслугиНаСервере();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЕРП(Команда)
	ЗаполнитьЕРПНаСервере();
КонецПроцедуры

&НаСервере
Процедура УслугиСтатьяДвиженияДенежныхСредствПокупательПриИзмененииНаСервере(ТекущаяСтрока)
	НоменклатураУслуга = Справочники.Номенклатура.НайтиПоКоду("0Ц-00000002");
	ТекущаяСтрока.Номенклатура = НоменклатураУслуга;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСтатьяДвиженияДенежныхСредствПокупательПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Услуги.ТекущиеДанные;

	УслугиСтатьяДвиженияДенежныхСредствПокупательПриИзмененииНаСервере(ТекущаяСтрока);
КонецПроцедуры


&НаСервере
Функция СоздатьДоговорПокупателя(Контрагент, Организация, Подразделение, ПодрОказаниеУслуг, СтатьяДДС)

	// Создаем договор покупателя по образцу
	НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();

	НовыйДоговор.Наименование = Строка(Подразделение);
	НовыйДоговор.Контрагент = Контрагент;
	НовыйДоговор.Партнер = Контрагент.Партнер;
	НовыйДоговор.Организация = Организация;
	НовыйДоговор.Подразделение = Подразделение;
	НовыйДоговор.А_ПодразделениеОказаниеУслугПодразделению = ПодрОказаниеУслуг;
	НовыйДоговор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = СтатьяДДС;
	НовыйДоговор.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
	НовыйДоговор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("980"); // грн
	НовыйДоговор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	НовыйДоговор.ГруппаФинансовогоУчета = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с покупателями в национальной валюте");
	НовыйДоговор.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	НовыйДоговор.Согласован = Истина;
    НовыйДоговор.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОсвобожденаОтНДС;  
	НовыйДоговор.ВариантОформленияЗакупок = Перечисления.ВариантыОформленияЗакупок.НеРазделять;
	НовыйДоговор.МоментОпределенияБазыНДС = Перечисления.МоментыОпределенияНалоговойБазы.ПоОтгрузке;  
	НовыйДоговор.СпособДоставки = Перечисления.СпособыДоставки.ОпределяетсяВРаспоряжении;

	НовыйДоговор.Записать();
          
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан договор покупателя: " + НовыйДоговор.Наименование);

	Возврат НовыйДоговор.Ссылка;

КонецФункции

&НаСервере
Функция СоздатьДоговорПоставщика(Контрагент, Организация, Подразделение, ПодрОказаниеУслуг, СтатьяДДС)

	// Создаем договор поставщика по образцу
	НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();

	НовыйДоговор.Наименование = Строка(Подразделение);
	НовыйДоговор.Контрагент = Контрагент;
	НовыйДоговор.Партнер = Контрагент.Партнер;
	НовыйДоговор.Организация = Организация;
	НовыйДоговор.Подразделение = Подразделение;
	НовыйДоговор.А_ПодразделениеОказаниеУслугПодразделению = ПодрОказаниеУслуг;
	НовыйДоговор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = СтатьяДДС;
	НовыйДоговор.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком;
	НовыйДоговор.ВалютаВзаиморасчетов = Справочники.Валюты.НайтиПоКоду("980"); // грн
	НовыйДоговор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	НовыйДоговор.ГруппаФинансовогоУчета = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с поставщиками в национальной валюте");
	НовыйДоговор.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	НовыйДоговор.Согласован = Истина;                      
    НовыйДоговор.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОсвобожденаОтНДС;  
	НовыйДоговор.ВариантОформленияЗакупок = Перечисления.ВариантыОформленияЗакупок.НеРазделять;
	НовыйДоговор.МоментОпределенияБазыНДС = Перечисления.МоментыОпределенияНалоговойБазы.ПоОтгрузке; 
	НовыйДоговор.СпособДоставки = Перечисления.СпособыДоставки.ОпределяетсяВРаспоряжении;

	НовыйДоговор.Записать();

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создан договор поставщика: " + НовыйДоговор.Наименование);

	Возврат НовыйДоговор.Ссылка;

КонецФункции



&НаСервере
Процедура СоздатьРеализацииПоОказанииУслугНаСервере()


	// Получаем данные шапки из формы
	ДатаДокумента = Объект.Дата;
	Организация = Объект.Организация;

	// Получаем строки ТЧ Услуги из формы (актуальные данные после записи на клиенте)
	Если Объект.Услуги.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе нет строк в табличной части Услуги!");
		Возврат;
	КонецЕсли;

	// ========== ФАЗА 1: ОЧИСТКА ПОДЧИНЁННЫХ ДОКУМЕНТОВ ==========

	ДокОснование = Объект.Ссылка;

	// 1) Сначала Приобретения (зависят от Реализаций → удаляем первыми)
	// У ПриобретениеТоваровУслуг нет прямой ссылки на А_ОказаниеУслугМеждуПодразделениями,
	// поэтому ищем через А_РеализацияТоваровУслуг → Реализации, привязанные к нашему документу
	ЗапросПриобретения = Новый Запрос;
	ЗапросПриобретения.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК Док
	|ГДЕ
	|	Док.А_РеализацияТоваровУслуг В
	|		(ВЫБРАТЬ Р.Ссылка ИЗ Документ.РеализацияТоваровУслуг КАК Р
	|		 ГДЕ Р.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование)
	|	И НЕ Док.ПометкаУдаления";
	ЗапросПриобретения.УстановитьПараметр("ДокОснование", ДокОснование);

	ВыборкаПриобретений = ЗапросПриобретения.Выполнить().Выбрать();
	Пока ВыборкаПриобретений.Следующий() Цикл
		ДокОбъект = ВыборкаПриобретений.Ссылка.ПолучитьОбъект();
		Если ВыборкаПриобретений.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

	// 2) Затем Реализации
	ЗапросРеализации = Новый Запрос;
	ЗапросРеализации.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Док
	|ГДЕ
	|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
	|	И НЕ Док.ПометкаУдаления";
	ЗапросРеализации.УстановитьПараметр("ДокОснование", ДокОснование);

	ВыборкаРеализаций = ЗапросРеализации.Выполнить().Выбрать();
	Пока ВыборкаРеализаций.Следующий() Цикл
		ДокОбъект = ВыборкаРеализаций.Ссылка.ПолучитьОбъект();
		Если ВыборкаРеализаций.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

	Сообщить("Фаза 1: старые подчинённые реализации и приобретения помечены на удаление.");

	// ========== ФАЗА 2: СОЗДАНИЕ/ОБНОВЛЕНИЕ ДОКУМЕНТОВ ==========

	Для Каждого СтрокаУслуги Из Объект.Услуги Цикл

		ПодразделениеПродавец = СтрокаУслуги.ПодразделениеПродавец;
		ПодразделениеПокупатель = СтрокаУслуги.ПодразделениеПокупатель;
		Номенклатура = СтрокаУслуги.Номенклатура;
		Сумма = СтрокаУслуги.Сумма;
		СтатьяЗатрат = СтрокаУслуги.СтатьяЗатрат;
		Комментарий = СтрокаУслуги.Комментарий + " (" + СокрЛП(Объект.Комментарий) + ")";
		СтатьяДДСПродавец = СтрокаУслуги.СтатьяДвиженияДенежныхСредствПродавец;
		СтатьяДДСПокупатель = СтрокаУслуги.СтатьяДвиженияДенежныхСредствПокупатель;
        КодСтроки = СтрокаУслуги.КодСтроки;

		// Найти Партнёра продавца по подразделению (А_Подразделение = ПодразделениеПродавец)
		ЗапросПартнерПродавец = Новый Запрос;
		ЗапросПартнерПродавец.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Партнер
		|ИЗ
		|	Справочник.Партнеры КАК П
		|ГДЕ
		|	П.А_Подразделение = &Подразделение
		|	И НЕ П.ПометкаУдаления";
		ЗапросПартнерПродавец.УстановитьПараметр("Подразделение", ПодразделениеПродавец);
		РезПартнерПродавец = ЗапросПартнерПродавец.Выполнить();
		Если РезПартнерПродавец.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден Партнёр для подразделения продавца: " + ПодразделениеПродавец);
			Продолжить;
		КонецЕсли;
		ВыбПартнерПродавец = РезПартнерПродавец.Выбрать();
		ВыбПартнерПродавец.Следующий();
		ПартнерПродавец = ВыбПартнерПродавец.Партнер;

		// Найти Контрагента по Партнёру продавца
		ЗапросКонтрПродавец = Новый Запрос;
		ЗапросКонтрПродавец.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	К.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	К.Партнер = &Партнер
		|	И НЕ К.ПометкаУдаления";
		ЗапросКонтрПродавец.УстановитьПараметр("Партнер", ПартнерПродавец);
		РезКонтрПродавец = ЗапросКонтрПродавец.Выполнить();
		Если РезКонтрПродавец.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден Контрагент для Партнёра продавца: " + ПартнерПродавец);
			Продолжить;
		КонецЕсли;
		ВыбКонтрПродавец = РезКонтрПродавец.Выбрать();
		ВыбКонтрПродавец.Следующий();
		КонтрагентПродавец = ВыбКонтрПродавец.Контрагент;

		// Найти Партнёра покупателя по подразделению (А_Подразделение = ПодразделениеПокупатель)
		ЗапросПартнерПокупатель = Новый Запрос;
		ЗапросПартнерПокупатель.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Партнер
		|ИЗ
		|	Справочник.Партнеры КАК П
		|ГДЕ
		|	П.А_Подразделение = &Подразделение
		|	И НЕ П.ПометкаУдаления";
		ЗапросПартнерПокупатель.УстановитьПараметр("Подразделение", ПодразделениеПокупатель);
		РезПартнерПокупатель = ЗапросПартнерПокупатель.Выполнить();
		Если РезПартнерПокупатель.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден Партнёр для подразделения покупателя: " + ПодразделениеПокупатель);
			Продолжить;
		КонецЕсли;
		ВыбПартнерПокупатель = РезПартнерПокупатель.Выбрать();
		ВыбПартнерПокупатель.Следующий();
		ПартнерПокупатель = ВыбПартнерПокупатель.Партнер;

		// Найти Контрагента по Партнёру покупателя
		ЗапросКонтрПокупатель = Новый Запрос;
		ЗапросКонтрПокупатель.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	К.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	К.Партнер = &Партнер
		|	И НЕ К.ПометкаУдаления";
		ЗапросКонтрПокупатель.УстановитьПараметр("Партнер", ПартнерПокупатель);
		РезКонтрПокупатель = ЗапросКонтрПокупатель.Выполнить();
		Если РезКонтрПокупатель.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден Контрагент для Партнёра покупателя: " + ПартнерПокупатель);
			Продолжить;
		КонецЕсли;
		ВыбКонтрПокупатель = РезКонтрПокупатель.Выбрать();
		ВыбКонтрПокупатель.Следующий();
		КонтрагентПокупатель = ВыбКонтрПокупатель.Контрагент;

		// ========== СОЗДАНИЕ РЕАЛИЗАЦИИ ==========

		// Ищем договор покупателя по подразделению продавца
		ЗапросДоговорПокупателя = Новый Запрос;
		ЗапросДоговорПокупателя.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договор.Ссылка КАК Договор,
		|	Договор.Партнер,
		|	Договор.ВалютаВзаиморасчетов,
		|	Договор.ПорядокРасчетов,
		|	Договор.ГруппаФинансовогоУчета,
		|	Договор.НаправлениеДеятельности
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договор
		|ГДЕ
		|	Договор.Контрагент = &Контрагент
		|	И Договор.Подразделение = &Подразделение
		|	И Договор.А_ПодразделениеОказаниеУслугПодразделению = &ПодрОказаниеУслуг
		|	И Договор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = &СтатьяДДС
		|	И Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
		|	И НЕ Договор.ПометкаУдаления";

		ЗапросДоговорПокупателя.УстановитьПараметр("Контрагент", КонтрагентПродавец);
		ЗапросДоговорПокупателя.УстановитьПараметр("Подразделение", ПодразделениеПродавец);
		ЗапросДоговорПокупателя.УстановитьПараметр("ПодрОказаниеУслуг", ПодразделениеПокупатель);
		ЗапросДоговорПокупателя.УстановитьПараметр("СтатьяДДС", СтатьяДДСПродавец);

		РезультатДоговор = ЗапросДоговорПокупателя.Выполнить();
		Если РезультатДоговор.Пустой() Тогда
			// Договор не найден - создаем автоматически
			ДоговорПокупателя = СоздатьДоговорПокупателя(КонтрагентПродавец, Организация, ПодразделениеПродавец, ПодразделениеПокупатель, СтатьяДДСПродавец);
			Партнер = ПартнерПродавец;
			ВалютаДоговора = Справочники.Валюты.НайтиПоКоду("980");
			ПорядокРасчетовДоговора = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
			ГруппаФинУчетаДоговора = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с покупателями в национальной валюте");
			НаправлениеДеятельностиДоговора = Справочники.НаправленияДеятельности.ПустаяСсылка();
		Иначе
			ВыборкаДоговор = РезультатДоговор.Выбрать();
			ВыборкаДоговор.Следующий();
			ДоговорПокупателя = ВыборкаДоговор.Договор;
			Партнер = ВыборкаДоговор.Партнер;
			ВалютаДоговора = ВыборкаДоговор.ВалютаВзаиморасчетов;
			ПорядокРасчетовДоговора = ВыборкаДоговор.ПорядокРасчетов;
			ГруппаФинУчетаДоговора = ВыборкаДоговор.ГруппаФинансовогоУчета;
			НаправлениеДеятельностиДоговора = ВыборкаДоговор.НаправлениеДеятельности;
		КонецЕсли;

		// Проверяем, есть ли уже реализация с такими реквизитами
		ЗапросСуществующая = Новый Запрос;
		ЗапросСуществующая.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка,
		|	Док.Проведен КАК Проведен,
		|	Док.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК Док
		|ГДЕ
		|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
		|	И Док.А_КодСтрокиДокументаОказаниеУслугМеждуПодразделениями = &КодСтроки
		|	";

		ЗапросСуществующая.УстановитьПараметр("ДокОснование", Объект.Ссылка);
		ЗапросСуществующая.УстановитьПараметр("ПодрПокупатель", ПодразделениеПокупатель);
		ЗапросСуществующая.УстановитьПараметр("ПодрПродавец", ПодразделениеПродавец);
		ЗапросСуществующая.УстановитьПараметр("Договор", ДоговорПокупателя);
        ЗапросСуществующая.УстановитьПараметр("КодСтроки", КодСтроки);
		
		РезультатСуществующая = ЗапросСуществующая.Выполнить();
		ЭтоОбновлениеРеализации = НЕ РезультатСуществующая.Пустой();

		Если ЭтоОбновлениеРеализации Тогда
			ВыборкаСуществующая = РезультатСуществующая.Выбрать();
			ВыборкаСуществующая.Следующий();
			ДокРеализация = ВыборкаСуществующая.Ссылка.ПолучитьОбъект();
			Если ВыборкаСуществующая.Проведен Тогда
				ДокРеализация.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Если ВыборкаСуществующая.ПометкаУдаления Тогда
				ДокРеализация.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
			ДокРеализация.Товары.Очистить();
		Иначе
			ДокРеализация = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
		КонецЕсли;

		// Заполняем шапку реализации
		ДокРеализация.Дата = ДатаДокумента;
		ДокРеализация.Организация = Организация;
		ДокРеализация.Контрагент = КонтрагентПродавец;
		ДокРеализация.Партнер = ПартнерПродавец;
		ДокРеализация.Договор = ДоговорПокупателя; 
		ДокРеализация.А_КодСтрокиДокументаОказаниеУслугМеждуПодразделениями = КодСтроки;
		ДокРеализация.Валюта = ВалютаДоговора;
		ДокРеализация.ВалютаВзаиморасчетов = ВалютаДоговора;
		ДокРеализация.Подразделение = ПодразделениеПродавец;
		ДокРеализация.ПорядокРасчетов = ПорядокРасчетовДоговора;
		ДокРеализация.ГруппаФинансовогоУчета = ГруппаФинУчетаДоговора;
		ДокРеализация.НаправлениеДеятельности = НаправлениеДеятельностиДоговора;
		ДокРеализация.СуммаДокумента = Сумма;
		ДокРеализация.Комментарий = Комментарий;
		ДокРеализация.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту;
		ДокРеализация.ЦенаВключаетНДС = Истина;
        ДокРеализация.А_Обработан = Истина;
		ДокРеализация.Курс = 1;
		ДокРеализация.Кратность = 1;
		ДокРеализация.СуммаВзаиморасчетов = Сумма;
		ДокРеализация.ФормаОплаты = Перечисления.ФормыОплаты.Безналичная;
		ДокРеализация.Статус = Перечисления.СтатусыРеализацийТоваровУслуг.Отгружено;

		// Специальные реквизиты связи
		ДокРеализация.А_ОказаниеУслугМеждуПодразделениями = Объект.Ссылка;
		ДокРеализация.А_ОказаниеУслуг_ПодразделениеПокупатель = ПодразделениеПокупатель;
		ДокРеализация.А_ОказаниеУслуг_ПодразделениеПродавец = ПодразделениеПродавец;

		// Добавляем строку в ТЧ Товары (не А_Услуги!)
		СтрокаТовары = ДокРеализация.Товары.Добавить();
		СтрокаТовары.Номенклатура = Номенклатура;
		СтрокаТовары.Количество = 1;
		СтрокаТовары.КоличествоУпаковок = 1;
		СтрокаТовары.Цена = Сумма;
		СтрокаТовары.Сумма = Сумма;
		СтрокаТовары.СуммаСНДС = Сумма;
		СтрокаТовары.СуммаВзаиморасчетов = Сумма;
		СтрокаТовары.СтавкаНДС =  НДСКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.БезНДС);
		СтрокаТовары.СуммаНДС = 0;
		СтрокаТовары.КодСтроки = 1;
		СтрокаТовары.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);

		// Записываем реализацию
		ДокРеализация.Записать(РежимЗаписиДокумента.Проведение);

		Если ЭтоОбновлениеРеализации Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обновлена реализация: " + ДокРеализация.Номер + " от " + Формат(ДокРеализация.Дата, "ДФ=dd.MM.yyyy") + " на сумму " + Формат(Сумма, "ЧДЦ=2") + " грн");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создана реализация: " + ДокРеализация.Номер + " от " + Формат(ДокРеализация.Дата, "ДФ=dd.MM.yyyy") + " на сумму " + Формат(Сумма, "ЧДЦ=2") + " грн");
		КонецЕсли;

		// ========== СОЗДАНИЕ ПРИОБРЕТЕНИЯ ==========

		// Ищем договор поставщика по подразделению покупателя
		ЗапросДоговорПоставщика = Новый Запрос;
		ЗапросДоговорПоставщика.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договор.Ссылка КАК Договор,
		|	Договор.Партнер,
		|	Договор.ВалютаВзаиморасчетов,
		|	Договор.ПорядокРасчетов,
		|	Договор.ГруппаФинансовогоУчета,
		|	Договор.НаправлениеДеятельности,
		|	Договор.Подразделение
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договор
		|ГДЕ
		|	Договор.Контрагент = &Контрагент
		|	И Договор.Подразделение = &Подразделение
		|	И Договор.А_ПодразделениеОказаниеУслугПодразделению = &ПодрОказаниеУслуг
		|	И Договор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = &СтатьяДДС
		|	И Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПоставщиком)
		|	И НЕ Договор.ПометкаУдаления";

		ЗапросДоговорПоставщика.УстановитьПараметр("Контрагент", КонтрагентПокупатель);
		ЗапросДоговорПоставщика.УстановитьПараметр("Подразделение", ПодразделениеПокупатель);
		ЗапросДоговорПоставщика.УстановитьПараметр("ПодрОказаниеУслуг", ПодразделениеПродавец);
		ЗапросДоговорПоставщика.УстановитьПараметр("СтатьяДДС", СтатьяДДСПокупатель);

		РезультатДоговорПоставщика = ЗапросДоговорПоставщика.Выполнить();
		Если РезультатДоговорПоставщика.Пустой() Тогда
			// Договор не найден - создаем автоматически
			ДоговорПоставщика = СоздатьДоговорПоставщика(КонтрагентПокупатель, Организация, ПодразделениеПокупатель, ПодразделениеПродавец, СтатьяДДСПокупатель);
			ПартнерПоставщик = ПартнерПокупатель;
			ПодразделениеДоговора = ПодразделениеПокупатель;
			ВалютаДоговораПоставщика = Справочники.Валюты.НайтиПоКоду("980");
			ПорядокРасчетовДоговораПоставщика = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
			ГруппаФинУчетаДоговораПоставщика = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с поставщиками в национальной валюте");
			НаправлениеДеятельностиДоговораПоставщика = Справочники.НаправленияДеятельности.ПустаяСсылка();
		Иначе
			ВыборкаДоговорПоставщика = РезультатДоговорПоставщика.Выбрать();
			ВыборкаДоговорПоставщика.Следующий();
			ДоговорПоставщика = ВыборкаДоговорПоставщика.Договор;
			ПартнерПоставщик = ВыборкаДоговорПоставщика.Партнер;
			ПодразделениеДоговора = ВыборкаДоговорПоставщика.Подразделение;
			ВалютаДоговораПоставщика = ВыборкаДоговорПоставщика.ВалютаВзаиморасчетов;
			ПорядокРасчетовДоговораПоставщика = ВыборкаДоговорПоставщика.ПорядокРасчетов;
			ГруппаФинУчетаДоговораПоставщика = ВыборкаДоговорПоставщика.ГруппаФинансовогоУчета;
			НаправлениеДеятельностиДоговораПоставщика = ВыборкаДоговорПоставщика.НаправлениеДеятельности;
		КонецЕсли;

		// Проверяем, есть ли уже приобретение по этой реализации
		ЗапросСуществующееПриобретение = Новый Запрос;
		ЗапросСуществующееПриобретение.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка,
		|	Док.Проведен КАК Проведен,
		|	Док.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК Док
		|ГДЕ
		|	Док.А_РеализацияТоваровУслуг = &Реализация";

		ЗапросСуществующееПриобретение.УстановитьПараметр("Реализация", ДокРеализация.Ссылка);

		РезультатСуществующееПриобретение = ЗапросСуществующееПриобретение.Выполнить();
		ЭтоОбновлениеПриобретения = НЕ РезультатСуществующееПриобретение.Пустой();

		Если ЭтоОбновлениеПриобретения Тогда
			ВыборкаСуществующееПриобретение = РезультатСуществующееПриобретение.Выбрать();
			ВыборкаСуществующееПриобретение.Следующий();
			ДокПриобретение = ВыборкаСуществующееПриобретение.Ссылка.ПолучитьОбъект();
			Если ВыборкаСуществующееПриобретение.Проведен Тогда
				ДокПриобретение.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Если ВыборкаСуществующееПриобретение.ПометкаУдаления Тогда
				ДокПриобретение.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
			ДокПриобретение.Товары.Очистить();
		Иначе
			ДокПриобретение = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
		КонецЕсли;

		// Заполняем шапку приобретения
		ДокПриобретение.Дата = ДатаДокумента;
		ДокПриобретение.Организация = Организация;
		ДокПриобретение.Контрагент = КонтрагентПокупатель;
		ДокПриобретение.Партнер = ПартнерПокупатель;
		ДокПриобретение.Договор = ДоговорПоставщика;
		ДокПриобретение.Валюта = ВалютаДоговораПоставщика;
		ДокПриобретение.ВалютаВзаиморасчетов = ВалютаДоговораПоставщика;
		ДокПриобретение.Подразделение = ПодразделениеДоговора;
		ДокПриобретение.ПорядокРасчетов = ПорядокРасчетовДоговораПоставщика;
		ДокПриобретение.ГруппаФинансовогоУчета = ГруппаФинУчетаДоговораПоставщика;
		ДокПриобретение.НаправлениеДеятельности = НаправлениеДеятельностиДоговораПоставщика;
		ДокПриобретение.СуммаДокумента = Сумма;
		ДокПриобретение.Комментарий = Комментарий;
		ДокПриобретение.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
		ДокПриобретение.ЦенаВключаетНДС = Истина;
        ДокПриобретение.А_Обработан = Истина;
		ДокПриобретение.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным;
		ДокПриобретение.СпособДоставки = Перечисления.СпособыДоставки.СиламиПоставщикаДоНашегоСклада;
		ДокПриобретение.Курс = 1;
		ДокПриобретение.Кратность = 1;
		ДокПриобретение.СуммаВзаиморасчетов = Сумма;
		ДокПриобретение.ФормаОплаты = Перечисления.ФормыОплаты.Безналичная;

		// Связь с реализацией
		ДокПриобретение.А_РеализацияТоваровУслуг = ДокРеализация.Ссылка;

		// Добавляем строку в ТЧ Товары (номенклатура из Номенклатура, статья расходов из СтатьяЗатрат)
		НоваяСтрокаТовары = ДокПриобретение.Товары.Добавить();
		НоваяСтрокаТовары.Номенклатура = Номенклатура;
		НоваяСтрокаТовары.Количество = 1;
		НоваяСтрокаТовары.КоличествоУпаковок = 1;
		НоваяСтрокаТовары.Цена = Сумма;
		НоваяСтрокаТовары.Сумма = Сумма;
		НоваяСтрокаТовары.СуммаСНДС = Сумма;
		НоваяСтрокаТовары.СтавкаНДС = НДСКлиентСерверПовтИсп.СтавкаНДСПоЗначениюПеречисления(Перечисления.СтавкиНДС.БезНДС);
		НоваяСтрокаТовары.СуммаНДС = 0;
		НоваяСтрокаТовары.СуммаВзаиморасчетов = Сумма;
		НоваяСтрокаТовары.КодСтроки = 1;
		НоваяСтрокаТовары.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
		НоваяСтрокаТовары.Подразделение = ПодразделениеДоговора;
		НоваяСтрокаТовары.СписатьНаРасходы = Истина;
		НоваяСтрокаТовары.СтатьяРасходов = СтатьяЗатрат;

		// Записываем приобретение
		ДокПриобретение.Записать(РежимЗаписиДокумента.Проведение);

		Если ЭтоОбновлениеПриобретения Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обновлено приобретение: " + ДокПриобретение.Номер + " от " + Формат(ДокПриобретение.Дата, "ДФ=dd.MM.yyyy") + " на сумму " + Формат(Сумма, "ЧДЦ=2") + " грн");
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создано приобретение: " + ДокПриобретение.Номер + " от " + Формат(ДокПриобретение.Дата, "ДФ=dd.MM.yyyy") + " на сумму " + Формат(Сумма, "ЧДЦ=2") + " грн");
		КонецЕсли;

	КонецЦикла;

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обработка завершена.");

КонецПроцедуры



&НаКлиенте
Процедура НачислитьУслуги(Команда)
	Записать();
	Если Модифицированность Тогда
		Возврат;
	КонецЕсли;
	СоздатьРеализацииПоОказанииУслугНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.А_ВведенВЕРП = Истина;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДоговорыЕРПНаСервере()

	Организация = Объект.Организация;

	СчетчикДоговоровПокупателя = 0;
	СчетчикДоговоровПоставщика = 0;
	СчетчикСуществующих = 0;

	// Получаем строки ТЧ Услуги из формы (актуальные данные)
	Если Объект.Услуги.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В документе нет строк в табличной части Услуги!");
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаУслуги Из Объект.Услуги Цикл

		ПодразделениеПродавец = СтрокаУслуги.ПодразделениеПродавец;
		ПодразделениеПокупатель = СтрокаУслуги.ПодразделениеПокупатель;
		СтатьяДДСПродавец = СтрокаУслуги.СтатьяДвиженияДенежныхСредствПродавец;
		СтатьяДДСПокупатель = СтрокаУслуги.СтатьяДвиженияДенежныхСредствПокупатель;

		// Найти Партнёра продавца по подразделению
		ЗапросПартнерПродавец = Новый Запрос;
		ЗапросПартнерПродавец.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Партнер
		|ИЗ
		|	Справочник.Партнеры КАК П
		|ГДЕ
		|	П.А_Подразделение = &Подразделение
		|	И НЕ П.ПометкаУдаления";
		ЗапросПартнерПродавец.УстановитьПараметр("Подразделение", ПодразделениеПродавец);
		РезПартнерПродавец = ЗапросПартнерПродавец.Выполнить();
		Если РезПартнерПродавец.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден Партнёр для подразделения продавца: " + ПодразделениеПродавец);
			Продолжить;
		КонецЕсли;
		ВыбПартнерПродавец = РезПартнерПродавец.Выбрать();
		ВыбПартнерПродавец.Следующий();
		ПартнерПродавец = ВыбПартнерПродавец.Партнер;

		// Найти Контрагента по Партнёру продавца
		ЗапросКонтрПродавец = Новый Запрос;
		ЗапросКонтрПродавец.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	К.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	К.Партнер = &Партнер
		|	И НЕ К.ПометкаУдаления";
		ЗапросКонтрПродавец.УстановитьПараметр("Партнер", ПартнерПродавец);
		РезКонтрПродавец = ЗапросКонтрПродавец.Выполнить();
		Если РезКонтрПродавец.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден Контрагент для Партнёра продавца: " + ПартнерПродавец);
			Продолжить;
		КонецЕсли;
		ВыбКонтрПродавец = РезКонтрПродавец.Выбрать();
		ВыбКонтрПродавец.Следующий();
		КонтрагентПродавец = ВыбКонтрПродавец.Контрагент;

		// Найти Партнёра покупателя по подразделению
		ЗапросПартнерПокупатель = Новый Запрос;
		ЗапросПартнерПокупатель.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Партнер
		|ИЗ
		|	Справочник.Партнеры КАК П
		|ГДЕ
		|	П.А_Подразделение = &Подразделение
		|	И НЕ П.ПометкаУдаления";
		ЗапросПартнерПокупатель.УстановитьПараметр("Подразделение", ПодразделениеПокупатель);
		РезПартнерПокупатель = ЗапросПартнерПокупатель.Выполнить();
		Если РезПартнерПокупатель.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден Партнёр для подразделения покупателя: " + ПодразделениеПокупатель);
			Продолжить;
		КонецЕсли;
		ВыбПартнерПокупатель = РезПартнерПокупатель.Выбрать();
		ВыбПартнерПокупатель.Следующий();
		ПартнерПокупатель = ВыбПартнерПокупатель.Партнер;

		// Найти Контрагента по Партнёру покупателя
		ЗапросКонтрПокупатель = Новый Запрос;
		ЗапросКонтрПокупатель.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	К.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	К.Партнер = &Партнер
		|	И НЕ К.ПометкаУдаления";
		ЗапросКонтрПокупатель.УстановитьПараметр("Партнер", ПартнерПокупатель);
		РезКонтрПокупатель = ЗапросКонтрПокупатель.Выполнить();
		Если РезКонтрПокупатель.Пустой() Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найден Контрагент для Партнёра покупателя: " + ПартнерПокупатель);
			Продолжить;
		КонецЕсли;
		ВыбКонтрПокупатель = РезКонтрПокупатель.Выбрать();
		ВыбКонтрПокупатель.Следующий();
		КонтрагентПокупатель = ВыбКонтрПокупатель.Контрагент;

		// ========== ДОГОВОР ПОКУПАТЕЛЯ ==========

		ЗапросДоговорПокупателя = Новый Запрос;
		ЗапросДоговорПокупателя.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договор.Ссылка КАК Договор
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договор
		|ГДЕ
		|	Договор.Контрагент = &Контрагент
		|	И Договор.Подразделение = &Подразделение
		|	И Договор.А_ПодразделениеОказаниеУслугПодразделению = &ПодрОказаниеУслуг
		|	И Договор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = &СтатьяДДС
		|	И Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
		|	И НЕ Договор.ПометкаУдаления";

		ЗапросДоговорПокупателя.УстановитьПараметр("Контрагент", КонтрагентПродавец);
		ЗапросДоговорПокупателя.УстановитьПараметр("Подразделение", ПодразделениеПродавец);
		ЗапросДоговорПокупателя.УстановитьПараметр("ПодрОказаниеУслуг", ПодразделениеПокупатель);
		ЗапросДоговорПокупателя.УстановитьПараметр("СтатьяДДС", СтатьяДДСПродавец);

		РезультатДоговорПокупателя = ЗапросДоговорПокупателя.Выполнить();
		Если РезультатДоговорПокупателя.Пустой() Тогда
			СоздатьДоговорПокупателя(КонтрагентПродавец, Организация, ПодразделениеПродавец, ПодразделениеПокупатель, СтатьяДДСПродавец);
			СчетчикДоговоровПокупателя = СчетчикДоговоровПокупателя + 1;
		Иначе
			СчетчикСуществующих = СчетчикСуществующих + 1;
		КонецЕсли;

		// ========== ДОГОВОР ПОСТАВЩИКА ==========

		ЗапросДоговорПоставщика = Новый Запрос;
		ЗапросДоговорПоставщика.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договор.Ссылка КАК Договор
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договор
		|ГДЕ
		|	Договор.Контрагент = &Контрагент
		|	И Договор.Подразделение = &Подразделение
		|	И Договор.А_ПодразделениеОказаниеУслугПодразделению = &ПодрОказаниеУслуг
		|	И Договор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = &СтатьяДДС
		|	И Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПоставщиком)
		|	И НЕ Договор.ПометкаУдаления";

		ЗапросДоговорПоставщика.УстановитьПараметр("Контрагент", КонтрагентПокупатель);
		ЗапросДоговорПоставщика.УстановитьПараметр("Подразделение", ПодразделениеПокупатель);
		ЗапросДоговорПоставщика.УстановитьПараметр("ПодрОказаниеУслуг", ПодразделениеПродавец);
		ЗапросДоговорПоставщика.УстановитьПараметр("СтатьяДДС", СтатьяДДСПокупатель);

		РезультатДоговорПоставщика = ЗапросДоговорПоставщика.Выполнить();
		Если РезультатДоговорПоставщика.Пустой() Тогда
			СоздатьДоговорПоставщика(КонтрагентПокупатель, Организация, ПодразделениеПокупатель, ПодразделениеПродавец, СтатьяДДСПокупатель);
			СчетчикДоговоровПоставщика = СчетчикДоговоровПоставщика + 1;
		Иначе
			СчетчикСуществующих = СчетчикСуществующих + 1;
		КонецЕсли;

	КонецЦикла;

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создание договоров завершено. Создано договоров покупателя: " + СчетчикДоговоровПокупателя
		+ ", поставщика: " + СчетчикДоговоровПоставщика
		+ ". Уже существовало: " + СчетчикСуществующих);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоговорыЕРП(Команда)
	Записать();
	Если Модифицированность Тогда
		Возврат;
	КонецЕсли;
	СоздатьДоговорыЕРПНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаспределениеНаСервере()
	
	мОбъект = РеквизитФормыВЗначение("Объект");
	мОбъект.ПеренестиРаспределениевУслуги();
	ЗначениеВРеквизитФормы(мОбъект, "Объект");


КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаспределение(Команда)
	ЗаполнитьРаспределениеНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьОплатыНаСервере()

	ДатаДокумента = Объект.Дата;
	Организация   = Объект.Организация;
	ДокОснование  = Объект.Ссылка;
	Валюта        = Справочники.Валюты.НайтиПоКоду("980"); // грн

	Если Объект.Деньги.Количество() = 0 Тогда
		Сообщить("В документе нет строк в табличной части Деньги!");
		Возврат;
	КонецЕсли;

	// ========== ФАЗА 1: ОЧИСТКА ПОДЧИНЁННЫХ ДОКУМЕНТОВ ==========

	// 1) Сначала Поступления (зависят от Списаний → удаляем первыми)
	ЗапросПоступления = Новый Запрос;
	ЗапросПоступления.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен
	|ИЗ
	|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК Док
	|ГДЕ
	|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
	|	И НЕ Док.ПометкаУдаления";
	ЗапросПоступления.УстановитьПараметр("ДокОснование", ДокОснование);

	ВыборкаПоступлений = ЗапросПоступления.Выполнить().Выбрать();
	Пока ВыборкаПоступлений.Следующий() Цикл
		ДокОбъект = ВыборкаПоступлений.Ссылка.ПолучитьОбъект();
		Если ВыборкаПоступлений.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

	// 2) Затем Списания
	ЗапросСписания = Новый Запрос;
	ЗапросСписания.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен
	|ИЗ
	|	Документ.СписаниеБезналичныхДенежныхСредств КАК Док
	|ГДЕ
	|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
	|	И НЕ Док.ПометкаУдаления";
	ЗапросСписания.УстановитьПараметр("ДокОснование", ДокОснование);

	ВыборкаСписаний = ЗапросСписания.Выполнить().Выбрать();
	Пока ВыборкаСписаний.Следующий() Цикл
		ДокОбъект = ВыборкаСписаний.Ссылка.ПолучитьОбъект();
		Если ВыборкаСписаний.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

	Сообщить("Фаза 1: старые подчинённые документы помечены на удаление.");

	// ========== ФАЗА 2: СОЗДАНИЕ НОВЫХ ДОКУМЕНТОВ ==========

	Для Каждого СтрокаДеньги Из Объект.Деньги Цикл

		ПодразделениеРасход = СтрокаДеньги.ПодразделениеРасход;
		ПодразделениеПриход = СтрокаДеньги.ПодразделениеПриход;
		СчетКассаРасход     = СтрокаДеньги.СчетКассаРасход;
		СчетКассаПриход     = СтрокаДеньги.СчетКассаПриход;
		СтатьяДДСРасход     = СтрокаДеньги.СтатьяДвиженияДенежныхСредствРасход;
		СтатьяДДСПриход     = СтрокаДеньги.СтатьяДвиженияДенежныхСредствПриход;
		Сумма               = СтрокаДеньги.Сумма;
		Комментарий         = СтрокаДеньги.Комментарий;
		КодСтроки           = СтрокаДеньги.КодСтроки;
		ТипРасчетаДС        = СтрокаДеньги.ТипыРасчетаДенежнымиСредствами;
		ФормаОплаты         = СтрокаДеньги.ФормаОплаты;

		Если Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Платёжки создаются только для безналичной формы оплаты
		Если ФормаОплаты <> Перечисления.ФормыОплаты.Безналичная Тогда
			Продолжить;
		КонецЕсли;

		// ========== ПОИСК ПАРТНЁРА/КОНТРАГЕНТА ПОКУПАТЕЛЯ (ПодразделениеРасход) ==========

		ЗапросПартнерПокупатель = Новый Запрос;
		ЗапросПартнерПокупатель.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Партнер
		|ИЗ
		|	Справочник.Партнеры КАК П
		|ГДЕ
		|	П.А_Подразделение = &Подразделение
		|	И НЕ П.ПометкаУдаления";
		ЗапросПартнерПокупатель.УстановитьПараметр("Подразделение", ПодразделениеРасход);
		РезПартнерПокупатель = ЗапросПартнерПокупатель.Выполнить();
		Если РезПартнерПокупатель.Пустой() Тогда
			Сообщить("Не найден Партнёр для подразделения покупателя: " + ПодразделениеРасход);
			Продолжить;
		КонецЕсли;
		ВыбПартнерПокупатель = РезПартнерПокупатель.Выбрать();
		ВыбПартнерПокупатель.Следующий();
		ПартнерПокупатель = ВыбПартнерПокупатель.Партнер;

		ЗапросКонтрПокупатель = Новый Запрос;
		ЗапросКонтрПокупатель.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	К.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	К.Партнер = &Партнер
		|	И НЕ К.ПометкаУдаления";
		ЗапросКонтрПокупатель.УстановитьПараметр("Партнер", ПартнерПокупатель);
		РезКонтрПокупатель = ЗапросКонтрПокупатель.Выполнить();
		Если РезКонтрПокупатель.Пустой() Тогда
			Сообщить("Не найден Контрагент для Партнёра покупателя: " + ПартнерПокупатель);
			Продолжить;
		КонецЕсли;
		ВыбКонтрПокупатель = РезКонтрПокупатель.Выбрать();
		ВыбКонтрПокупатель.Следующий();
		КонтрагентПокупатель = ВыбКонтрПокупатель.Контрагент;

		// ========== ПОИСК ПАРТНЁРА/КОНТРАГЕНТА ПРОДАВЦА (ПодразделениеПриход) ==========

		ЗапросПартнерПродавец = Новый Запрос;
		ЗапросПартнерПродавец.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Партнер
		|ИЗ
		|	Справочник.Партнеры КАК П
		|ГДЕ
		|	П.А_Подразделение = &Подразделение
		|	И НЕ П.ПометкаУдаления";
		ЗапросПартнерПродавец.УстановитьПараметр("Подразделение", ПодразделениеПриход);
		РезПартнерПродавец = ЗапросПартнерПродавец.Выполнить();
		Если РезПартнерПродавец.Пустой() Тогда
			Сообщить("Не найден Партнёр для подразделения продавца: " + ПодразделениеПриход);
			Продолжить;
		КонецЕсли;
		ВыбПартнерПродавец = РезПартнерПродавец.Выбрать();
		ВыбПартнерПродавец.Следующий();
		ПартнерПродавец = ВыбПартнерПродавец.Партнер;

		ЗапросКонтрПродавец = Новый Запрос;
		ЗапросКонтрПродавец.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	К.Ссылка КАК Контрагент
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	К.Партнер = &Партнер
		|	И НЕ К.ПометкаУдаления";
		ЗапросКонтрПродавец.УстановитьПараметр("Партнер", ПартнерПродавец);
		РезКонтрПродавец = ЗапросКонтрПродавец.Выполнить();
		Если РезКонтрПродавец.Пустой() Тогда
			Сообщить("Не найден Контрагент для Партнёра продавца: " + ПартнерПродавец);
			Продолжить;
		КонецЕсли;
		ВыбКонтрПродавец = РезКонтрПродавец.Выбрать();
		ВыбКонтрПродавец.Следующий();
		КонтрагентПродавец = ВыбКонтрПродавец.Контрагент;

		// ========== ПОИСК ДОГОВОРА ПОСТАВЩИКА (для Списания — ОплатаПоставщику) ==========
		// Покупатель (ПодразделениеРасход) платит за услуги от продавца (ПодразделениеПриход)

		ЗапросДоговорПоставщика = Новый Запрос;
		ЗапросДоговорПоставщика.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договор.Ссылка КАК Договор,
		|	Договор.Партнер,
		|	Договор.ВалютаВзаиморасчетов,
		|	Договор.ПорядокРасчетов,
		|	Договор.ГруппаФинансовогоУчета,
		|	Договор.НаправлениеДеятельности
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договор
		|ГДЕ
		|	Договор.Контрагент = &Контрагент
		|	И Договор.Подразделение = &Подразделение
		|	И Договор.А_ПодразделениеОказаниеУслугПодразделению = &ПодрОказаниеУслуг
		|	И Договор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = &СтатьяДДС
		|	И Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПоставщиком)
		|	И НЕ Договор.ПометкаУдаления";
		ЗапросДоговорПоставщика.УстановитьПараметр("Контрагент", КонтрагентПокупатель);
		ЗапросДоговорПоставщика.УстановитьПараметр("Подразделение", ПодразделениеРасход);
		ЗапросДоговорПоставщика.УстановитьПараметр("ПодрОказаниеУслуг", ПодразделениеПриход);
		ЗапросДоговорПоставщика.УстановитьПараметр("СтатьяДДС", СтатьяДДСРасход);

		РезДоговорПоставщика = ЗапросДоговорПоставщика.Выполнить();
		Если РезДоговорПоставщика.Пустой() Тогда
			ДоговорПоставщика = СоздатьДоговорПоставщика(КонтрагентПокупатель, Организация, ПодразделениеРасход, ПодразделениеПриход, СтатьяДДСРасход);
			ВалютаДоговораПоставщика = Валюта;
			ГруппаФинУчетаПоставщика = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с поставщиками в национальной валюте");
			НаправлениеДеятельностиПоставщика = Справочники.НаправленияДеятельности.ПустаяСсылка();
		Иначе
			ВыбДоговор = РезДоговорПоставщика.Выбрать();
			ВыбДоговор.Следующий();
			ДоговорПоставщика = ВыбДоговор.Договор;
			ВалютаДоговораПоставщика = ВыбДоговор.ВалютаВзаиморасчетов;
			ГруппаФинУчетаПоставщика = ВыбДоговор.ГруппаФинансовогоУчета;
			НаправлениеДеятельностиПоставщика = ВыбДоговор.НаправлениеДеятельности;
		КонецЕсли;

		// ========== ПОИСК ДОГОВОРА ПОКУПАТЕЛЯ (для Поступления — ПоступлениеОплатыОтКлиента) ==========
		// Продавец (ПодразделениеПриход) получает оплату от покупателя (ПодразделениеРасход)

		ЗапросДоговорПокупателя = Новый Запрос;
		ЗапросДоговорПокупателя.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договор.Ссылка КАК Договор,
		|	Договор.Партнер,
		|	Договор.ВалютаВзаиморасчетов,
		|	Договор.ПорядокРасчетов,
		|	Договор.ГруппаФинансовогоУчета,
		|	Договор.НаправлениеДеятельности
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК Договор
		|ГДЕ
		|	Договор.Контрагент = &Контрагент
		|	И Договор.Подразделение = &Подразделение
		|	И Договор.А_ПодразделениеОказаниеУслугПодразделению = &ПодрОказаниеУслуг
		|	И Договор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = &СтатьяДДС
		|	И Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
		|	И НЕ Договор.ПометкаУдаления";
		ЗапросДоговорПокупателя.УстановитьПараметр("Контрагент", КонтрагентПродавец);
		ЗапросДоговорПокупателя.УстановитьПараметр("Подразделение", ПодразделениеПриход);
		ЗапросДоговорПокупателя.УстановитьПараметр("ПодрОказаниеУслуг", ПодразделениеРасход);
		ЗапросДоговорПокупателя.УстановитьПараметр("СтатьяДДС", СтатьяДДСПриход);

		РезДоговорПокупателя = ЗапросДоговорПокупателя.Выполнить();
		Если РезДоговорПокупателя.Пустой() Тогда
			ДоговорПокупателя = СоздатьДоговорПокупателя(КонтрагентПродавец, Организация, ПодразделениеПриход, ПодразделениеРасход, СтатьяДДСПриход);
			ВалютаДоговораПокупателя = Валюта;
			ГруппаФинУчетаПокупателя = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с покупателями в национальной валюте");
			НаправлениеДеятельностиПокупателя = Справочники.НаправленияДеятельности.ПустаяСсылка();
		Иначе
			ВыбДоговорПокуп = РезДоговорПокупателя.Выбрать();
			ВыбДоговорПокуп.Следующий();
			ДоговорПокупателя = ВыбДоговорПокуп.Договор;
			ВалютаДоговораПокупателя = ВыбДоговорПокуп.ВалютаВзаиморасчетов;
			ГруппаФинУчетаПокупателя = ВыбДоговорПокуп.ГруппаФинансовогоУчета;
			НаправлениеДеятельностиПокупателя = ВыбДоговорПокуп.НаправлениеДеятельности;
		КонецЕсли;

		// ========== ПОИСК ДОГОВОРОВ ДЛЯ ВОЗВРАТА ==========
		ЭтоВозврат = (ТипРасчетаДС = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств);

		Если ЭтоВозврат Тогда

			// --- Договор для Списания при Возврате ---
			// Тип ПЕРЕВЁРНУТ: СПокупателем (вместо СПоставщиком)
			// СтатьяДДС НЕ МЕНЯЕТСЯ: СтатьяДДСРасход (как в обычном Расходе)
			ЗапросДоговорВозвратаСписания = Новый Запрос;
			ЗапросДоговорВозвратаСписания.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Договор.Ссылка КАК Договор,
			|	Договор.ВалютаВзаиморасчетов,
			|	Договор.ГруппаФинансовогоУчета,
			|	Договор.НаправлениеДеятельности
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК Договор
			|ГДЕ
			|	Договор.Контрагент = &Контрагент
			|	И Договор.Подразделение = &Подразделение
			|	И Договор.А_ПодразделениеОказаниеУслугПодразделению = &ПодрОказаниеУслуг
			|	И Договор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = &СтатьяДДС
			|	И Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПокупателем)
			|	И НЕ Договор.ПометкаУдаления";
			ЗапросДоговорВозвратаСписания.УстановитьПараметр("Контрагент", КонтрагентПокупатель);
			ЗапросДоговорВозвратаСписания.УстановитьПараметр("Подразделение", ПодразделениеРасход);
			ЗапросДоговорВозвратаСписания.УстановитьПараметр("ПодрОказаниеУслуг", ПодразделениеПриход);
			ЗапросДоговорВозвратаСписания.УстановитьПараметр("СтатьяДДС", СтатьяДДСРасход);

			РезДоговорВозвратаСписания = ЗапросДоговорВозвратаСписания.Выполнить();
			Если РезДоговорВозвратаСписания.Пустой() Тогда
				ДоговорВозвратаСписания = СоздатьДоговорПокупателя(КонтрагентПокупатель, Организация, ПодразделениеРасход, ПодразделениеПриход, СтатьяДДСРасход);
				ВалютаДоговораВозвратаСписания = Валюта;
				ГруппаФинУчетаВозвратаСписания = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с покупателями в национальной валюте");
				НаправлениеВозвратаСписания = Справочники.НаправленияДеятельности.ПустаяСсылка();
			Иначе
				ВыбДогВС = РезДоговорВозвратаСписания.Выбрать();
				ВыбДогВС.Следующий();
				ДоговорВозвратаСписания = ВыбДогВС.Договор;
				ВалютаДоговораВозвратаСписания = ВыбДогВС.ВалютаВзаиморасчетов;
				ГруппаФинУчетаВозвратаСписания = ВыбДогВС.ГруппаФинансовогоУчета;
				НаправлениеВозвратаСписания = ВыбДогВС.НаправлениеДеятельности;
			КонецЕсли;

			// --- Договор для Поступления при Возврате ---
			// Тип ПЕРЕВЁРНУТ: СПоставщиком (вместо СПокупателем)
			// СтатьяДДС НЕ МЕНЯЕТСЯ: СтатьяДДСПриход (как в обычном Расходе)
			ЗапросДоговорВозвратаПоступления = Новый Запрос;
			ЗапросДоговорВозвратаПоступления.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Договор.Ссылка КАК Договор,
			|	Договор.ВалютаВзаиморасчетов,
			|	Договор.ГруппаФинансовогоУчета,
			|	Договор.НаправлениеДеятельности
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК Договор
			|ГДЕ
			|	Договор.Контрагент = &Контрагент
			|	И Договор.Подразделение = &Подразделение
			|	И Договор.А_ПодразделениеОказаниеУслугПодразделению = &ПодрОказаниеУслуг
			|	И Договор.А_СтатьяДвиженияДенежныхСредствОказаниеУслугПодразделению = &СтатьяДДС
			|	И Договор.ТипДоговора = ЗНАЧЕНИЕ(Перечисление.ТипыДоговоров.СПоставщиком)
			|	И НЕ Договор.ПометкаУдаления";
			ЗапросДоговорВозвратаПоступления.УстановитьПараметр("Контрагент", КонтрагентПродавец);
			ЗапросДоговорВозвратаПоступления.УстановитьПараметр("Подразделение", ПодразделениеПриход);
			ЗапросДоговорВозвратаПоступления.УстановитьПараметр("ПодрОказаниеУслуг", ПодразделениеРасход);
			ЗапросДоговорВозвратаПоступления.УстановитьПараметр("СтатьяДДС", СтатьяДДСПриход);

			РезДоговорВозвратаПоступления = ЗапросДоговорВозвратаПоступления.Выполнить();
			Если РезДоговорВозвратаПоступления.Пустой() Тогда
				ДоговорВозвратаПоступления = СоздатьДоговорПоставщика(КонтрагентПродавец, Организация, ПодразделениеПриход, ПодразделениеРасход, СтатьяДДСПриход);
				ВалютаДоговораВозвратаПоступления = Валюта;
				ГруппаФинУчетаВозвратаПоступления = Справочники.ГруппыФинансовогоУчетаРасчетов.НайтиПоНаименованию("Расчеты с поставщиками в национальной валюте");
				НаправлениеВозвратаПоступления = Справочники.НаправленияДеятельности.ПустаяСсылка();
			Иначе
				ВыбДогВП = РезДоговорВозвратаПоступления.Выбрать();
				ВыбДогВП.Следующий();
				ДоговорВозвратаПоступления = ВыбДогВП.Договор;
				ВалютаДоговораВозвратаПоступления = ВыбДогВП.ВалютаВзаиморасчетов;
				ГруппаФинУчетаВозвратаПоступления = ВыбДогВП.ГруппаФинансовогоУчета;
				НаправлениеВозвратаПоступления = ВыбДогВП.НаправлениеДеятельности;
			КонецЕсли;

		КонецЕсли;

		// ========== МАППИНГ ПО ТИПУ РАСЧЁТА ==========
		// Контрагент/Партнёр ВСЕГДА одинаковые (НЕ зависят от типа расчёта)
		КонтрагентСписания    = КонтрагентПокупатель;
		ПартнерСписания       = ПартнерПокупатель;
		КонтрагентПоступления = КонтрагентПродавец;
		ПартнерПоступления    = ПартнерПродавец;

		Если ЭтоВозврат Тогда
			// Возврат: ХозОп меняется, Договоры — из отдельных поисков (перевёрнутый тип + перекрёстная СтатьяДДС)
			ХозОпСписания          = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту;
			ДоговорСписания        = ДоговорВозвратаСписания;
			ГруппаФинУчетаСписания = ГруппаФинУчетаВозвратаСписания;
			НаправленностьСписания = НаправлениеВозвратаСписания;
			ВалютаДоговораСписания = ВалютаДоговораВозвратаСписания;

			ХозОпПоступления          = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПоставщика;
			ДоговорПоступления        = ДоговорВозвратаПоступления;
			ГруппаФинУчетаПоступления = ГруппаФинУчетаВозвратаПоступления;
			НаправленностьПоступления = НаправлениеВозвратаПоступления;
			ВалютаДоговораПоступления = ВалютаДоговораВозвратаПоступления;
		Иначе
			// Расход: стандартные операции и договоры
			ХозОпСписания          = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
			ДоговорСписания        = ДоговорПоставщика;
			ГруппаФинУчетаСписания = ГруппаФинУчетаПоставщика;
			НаправленностьСписания = НаправлениеДеятельностиПоставщика;
			ВалютаДоговораСписания = ВалютаДоговораПоставщика;

			ХозОпПоступления          = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента;
			ДоговорПоступления        = ДоговорПокупателя;
			ГруппаФинУчетаПоступления = ГруппаФинУчетаПокупателя;
			НаправленностьПоступления = НаправлениеДеятельностиПокупателя;
			ВалютаДоговораПоступления = ВалютаДоговораПокупателя;
		КонецЕсли;

		// ===== ПОИСК СУЩЕСТВУЮЩЕГО СПИСАНИЯ =====
		ЗапросСуществующееСписание = Новый Запрос;
		ЗапросСуществующееСписание.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка,
		|	Док.Проведен КАК Проведен,
		|	Док.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.СписаниеБезналичныхДенежныхСредств КАК Док
		|ГДЕ
		|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
		|	И Док.А_КодСтрокиДокументаОказаниеУслугМеждуПодразделениями = &КодСтроки";
		ЗапросСуществующееСписание.УстановитьПараметр("ДокОснование", ДокОснование);
		ЗапросСуществующееСписание.УстановитьПараметр("КодСтроки", КодСтроки);

		РезСуществующееСписание = ЗапросСуществующееСписание.Выполнить();
		ЭтоОбновлениеСписания = НЕ РезСуществующееСписание.Пустой();

		Если ЭтоОбновлениеСписания Тогда
			ВыбСуществующееСписание = РезСуществующееСписание.Выбрать();
			ВыбСуществующееСписание.Следующий();
			ДокСписание = ВыбСуществующееСписание.Ссылка.ПолучитьОбъект();
			Если ВыбСуществующееСписание.Проведен Тогда
				ДокСписание.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Если ВыбСуществующееСписание.ПометкаУдаления Тогда
				ДокСписание.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
			ДокСписание.РасшифровкаПлатежа.Очистить();
		Иначе
			ДокСписание = Документы.СписаниеБезналичныхДенежныхСредств.СоздатьДокумент();
		КонецЕсли;

		// ===== 2.1 СПИСАНИЕ =====
		ДокСписание.Дата                            = ДатаДокумента;
		ДокСписание.Организация                     = Организация;
		ДокСписание.ХозяйственнаяОперация           = ХозОпСписания;
		ДокСписание.Контрагент                       = КонтрагентСписания;
		ДокСписание.Партнер                          = ПартнерСписания;
		//ДокСписание.Договор                          = ДоговорСписания;
		ДокСписание.Подразделение                    = ПодразделениеРасход;
		ДокСписание.БанковскийСчет                   = СчетКассаРасход;
		ДокСписание.СтатьяДвиженияДенежныхСредств    = СтатьяДДСРасход;
		ДокСписание.СуммаДокумента                   = Сумма;
		ДокСписание.Валюта                           = Валюта;
		ДокСписание.ГруппаФинансовогоУчета           = ГруппаФинУчетаСписания;
		ДокСписание.НаправлениеДеятельности          = НаправленностьСписания;
		ДокСписание.Комментарий                      = Комментарий;
		ДокСписание.А_Необновлять                    = Истина;
		ДокСписание.А_Обработан                      = Истина;  
		ДокСписание.А_ВведенВЕРП                     = Истина;  
		ДокСписание.А_ОбработанКазна                     = Истина;
		
		
		ДокСписание.А_ОказаниеУслугМеждуПодразделениями = ДокОснование;
		ДокСписание.А_КодСтрокиДокументаОказаниеУслугМеждуПодразделениями = КодСтроки;
		ДокСписание.ТипПлатежногоДокумента           = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
		ДокСписание.ПроведеноБанком                   = Истина;
		ДокСписание.ДатаПроведенияБанком              = ДатаДокумента;

		ДокСписание.РасшифровкаПлатежа.Очистить();
		СтрокаРП = ДокСписание.РасшифровкаПлатежа.Добавить();
		СтрокаРП.Партнер                         = ПартнерСписания;
		СтрокаРП.СтатьяДвиженияДенежныхСредств   = СтатьяДДСРасход;
		СтрокаРП.Сумма                           = Сумма;
		СтрокаРП.СуммаВзаиморасчетов             = Сумма;
		СтрокаРП.ВалютаВзаиморасчетов            = ВалютаДоговораСписания;
		СтрокаРП.Подразделение                    = ПодразделениеРасход;
		СтрокаРП.Организация                      = Организация;
		СтрокаРП.А_Договор                        = ДоговорСписания;

		// === Заполнение ОбъектРасчетов в РасшифровкаПлатежа ===
		Для Каждого СтрокаРасшифровки Из ДокСписание.РасшифровкаПлатежа Цикл
			Если ДокСписание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику
				ИЛИ ДокСписание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту Тогда

				ПараметрыОР = ОбъектыРасчетовСервер.ПолучитьПараметрыОбъектаРасчетов();
				ПараметрыОР.Организация = ДокСписание.Организация;
				ПараметрыОР.Партнер     = СтрокаРасшифровки.Партнер;
				ПараметрыОР.Контрагент  = ДокСписание.Контрагент;
				ПараметрыОР.Вставить("ПометкаУдаления", Ложь);

				Источник = Неопределено;
				ТипРасчетов = Неопределено;
				ТипОР = Неопределено;
				Договор = СтрокаРасшифровки.А_Договор;

				Если ДокСписание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаПоставщику Тогда
					ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком;
				ИначеЕсли ДокСписание.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратОплатыКлиенту Тогда
					ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
				КонецЕсли;

				Если ЗначениеЗаполнено(Договор) Тогда
					ПорядокРасчетов = Договор.ПорядокРасчетов;
				Иначе
					ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПустаяСсылка();
				КонецЕсли;

				Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным Тогда
					Если ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом
						И ЗначениеЗаполнено(СтрокаРасшифровки.А_ЗаказКлиента) Тогда
						Источник = СтрокаРасшифровки.А_ЗаказКлиента;
						ТипОР = Перечисления.ТипыОбъектовРасчетов.Заказ;
						ДокСписание.Договор = Договор;
						ДокСписание.ГруппаФинансовогоУчета = Договор.ГруппаФинансовогоУчета;
					ИначеЕсли ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком
						И ЗначениеЗаполнено(СтрокаРасшифровки.А_ЗаказПоставщику) Тогда
						Источник = СтрокаРасшифровки.А_ЗаказПоставщику;
						ТипОР = Перечисления.ТипыОбъектовРасчетов.Заказ;
						ДокСписание.Договор = Договор;
						ДокСписание.ГруппаФинансовогоУчета = Договор.ГруппаФинансовогоУчета;
					Иначе
						Источник = Договор;
						ТипОР = Перечисления.ТипыОбъектовРасчетов.Договор;
					КонецЕсли;
				ИначеЕсли ЗначениеЗаполнено(Договор) Тогда
					Источник = Договор;
					ТипОР = Перечисления.ТипыОбъектовРасчетов.Договор;
				Иначе
					Продолжить;
				КонецЕсли;

				ПараметрыОР.Объект = Источник;
				ПараметрыОР.ТипРасчетов = ТипРасчетов;
				ПараметрыОР.Договор = Договор;
				ПараметрыОР.Вставить("ТипОбъектаРасчетов", ТипОР);

				СтрокаРасшифровки.ОбъектРасчетов =
					ОбъектыРасчетовСервер.ПроверитьСоздатьОбъектРасчетов(ПараметрыОР);

			КонецЕсли;
		КонецЦикла;

		ДокСписание.Записать(РежимЗаписиДокумента.Проведение);

		// ===== ПОИСК СУЩЕСТВУЮЩЕГО ПОСТУПЛЕНИЯ =====
		ЗапросСуществующееПоступление = Новый Запрос;
		ЗапросСуществующееПоступление.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка,
		|	Док.Проведен КАК Проведен,
		|	Док.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.ПоступлениеБезналичныхДенежныхСредств КАК Док
		|ГДЕ
		|	Док.А_ОказаниеУслугМеждуПодразделениями = &ДокОснование
		|	И Док.А_СписаниеБезналичныхДенежныхСредствУслугиМеждуПодразделениями = &СписаниеСсылка";
		ЗапросСуществующееПоступление.УстановитьПараметр("ДокОснование", ДокОснование);
		ЗапросСуществующееПоступление.УстановитьПараметр("СписаниеСсылка", ДокСписание.Ссылка);

		РезСуществующееПоступление = ЗапросСуществующееПоступление.Выполнить();
		ЭтоОбновлениеПоступления = НЕ РезСуществующееПоступление.Пустой();

		Если ЭтоОбновлениеПоступления Тогда
			ВыбСуществующееПоступление = РезСуществующееПоступление.Выбрать();
			ВыбСуществующееПоступление.Следующий();
			ДокПоступление = ВыбСуществующееПоступление.Ссылка.ПолучитьОбъект();
			Если ВыбСуществующееПоступление.Проведен Тогда
				ДокПоступление.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			Если ВыбСуществующееПоступление.ПометкаУдаления Тогда
				ДокПоступление.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
			ДокПоступление.РасшифровкаПлатежа.Очистить();
		Иначе
			ДокПоступление = Документы.ПоступлениеБезналичныхДенежныхСредств.СоздатьДокумент();
		КонецЕсли;

		// ===== 2.2 ПОСТУПЛЕНИЕ =====
		ДокПоступление.Дата                          = ДатаДокумента;
		ДокПоступление.Организация                   = Организация;
		ДокПоступление.ХозяйственнаяОперация         = ХозОпПоступления;
		ДокПоступление.Контрагент                     = КонтрагентПоступления;
		ДокПоступление.Партнер                        = ПартнерПоступления;
		//ДокПоступление.Договор                        = ДоговорПоступления;
		ДокПоступление.Подразделение                  = ПодразделениеПриход;
		ДокПоступление.БанковскийСчет                 = СчетКассаПриход;
		ДокПоступление.СтатьяДвиженияДенежныхСредств  = СтатьяДДСПриход;
		ДокПоступление.СуммаДокумента                 = Сумма;
		ДокПоступление.Валюта                         = Валюта;
		ДокПоступление.ГруппаФинансовогоУчета         = ГруппаФинУчетаПоступления;
		ДокПоступление.НаправлениеДеятельности        = НаправленностьПоступления;
		ДокПоступление.Комментарий                    = Комментарий;
		ДокПоступление.А_Необновлять                  = Истина;
		ДокПоступление.А_Обработан                    = Истина;  
		ДокПоступление.А_ВведенВЕРП                     = Истина;  
		ДокПоступление.А_ОбработанКазна                     = Истина;
		ДокПоступление.А_ОказаниеУслугМеждуПодразделениями = ДокОснование;
		ДокПоступление.А_СписаниеБезналичныхДенежныхСредствУслугиМеждуПодразделениями = ДокСписание.Ссылка;
		ДокПоступление.ТипПлатежногоДокумента        = Перечисления.ТипыПлатежныхДокументов.ПлатежноеПоручение;
		ДокПоступление.ПроведеноБанком                = Истина;
		ДокПоступление.ДатаПроведенияБанком           = ДатаДокумента;

		ДокПоступление.РасшифровкаПлатежа.Очистить();
		СтрокаРП = ДокПоступление.РасшифровкаПлатежа.Добавить();
		СтрокаРП.Партнер                         = ПартнерПоступления;
		СтрокаРП.СтатьяДвиженияДенежныхСредств   = СтатьяДДСПриход;
		СтрокаРП.Сумма                           = Сумма;
		СтрокаРП.СуммаВзаиморасчетов             = Сумма;
		СтрокаРП.ВалютаВзаиморасчетов            = ВалютаДоговораПоступления;
		СтрокаРП.Подразделение                    = ПодразделениеПриход;
		СтрокаРП.Организация                      = Организация;
		СтрокаРП.А_Договор                        = ДоговорПоступления;

		// === Заполнение ОбъектРасчетов в РасшифровкаПлатежа ===
		Для Каждого СтрокаРасшифровки Из ДокПоступление.РасшифровкаПлатежа Цикл
			Если ДокПоступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента
				ИЛИ ДокПоступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПоставщика Тогда

				ПараметрыОР = ОбъектыРасчетовСервер.ПолучитьПараметрыОбъектаРасчетов();
				ПараметрыОР.Организация = ДокПоступление.Организация;
				ПараметрыОР.Партнер     = СтрокаРасшифровки.Партнер;
				ПараметрыОР.Контрагент  = ДокПоступление.Контрагент;
				ПараметрыОР.Вставить("ПометкаУдаления", Ложь);

				Источник = Неопределено;
				ТипРасчетов = Неопределено;
				ТипОР = Неопределено;
				Договор = СтрокаРасшифровки.А_Договор;

				Если ДокПоступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента Тогда
					ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом;
				ИначеЕсли ДокПоступление.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПоставщика Тогда
					ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком;
				КонецЕсли;

				Если ЗначениеЗаполнено(Договор) Тогда
					ПорядокРасчетов = Договор.ПорядокРасчетов;
				Иначе
					ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПустаяСсылка();
				КонецЕсли;

				Если ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказамНакладным Тогда
					Если ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом
						И ЗначениеЗаполнено(СтрокаРасшифровки.А_ЗаказКлиента) Тогда
						Источник = СтрокаРасшифровки.А_ЗаказКлиента;
						ТипОР = Перечисления.ТипыОбъектовРасчетов.Заказ;
						ДокПоступление.Договор = Договор;
						ДокПоступление.ГруппаФинансовогоУчета = Договор.ГруппаФинансовогоУчета;
					ИначеЕсли ТипРасчетов = Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком
						И ЗначениеЗаполнено(СтрокаРасшифровки.А_ЗаказПоставщику) Тогда
						Источник = СтрокаРасшифровки.А_ЗаказПоставщику;
						ТипОР = Перечисления.ТипыОбъектовРасчетов.Заказ;
						ДокПоступление.Договор = Договор;
						ДокПоступление.ГруппаФинансовогоУчета = Договор.ГруппаФинансовогоУчета;
					Иначе
						Источник = Договор;
						ТипОР = Перечисления.ТипыОбъектовРасчетов.Договор;
					КонецЕсли;
				ИначеЕсли ЗначениеЗаполнено(Договор) Тогда
					Источник = Договор;
					ТипОР = Перечисления.ТипыОбъектовРасчетов.Договор;
				Иначе
					Продолжить;
				КонецЕсли;

				ПараметрыОР.Объект = Источник;
				ПараметрыОР.ТипРасчетов = ТипРасчетов;
				ПараметрыОР.Договор = Договор;
				ПараметрыОР.Вставить("ТипОбъектаРасчетов", ТипОР);

				СтрокаРасшифровки.ОбъектРасчетов =
					ОбъектыРасчетовСервер.ПроверитьСоздатьОбъектРасчетов(ПараметрыОР);

			КонецЕсли;
		КонецЦикла;

		ДокПоступление.Записать(РежимЗаписиДокумента.Проведение);

		// Сообщение пользователю
		Сообщить("Создано Списание №" + ДокСписание.Номер + " (ОплатаПоставщику)"
			+ " → Поступление №" + ДокПоступление.Номер + " (ОплатаОтКлиента)"
			+ " на сумму " + Формат(Сумма, "ЧДЦ=2"));

	КонецЦикла;

	Сообщить("Обработка завершена.");

КонецПроцедуры

&НаКлиенте
Процедура СоздатьОплаты(Команда)
	СоздатьОплатыНаСервере();
КонецПроцедуры
