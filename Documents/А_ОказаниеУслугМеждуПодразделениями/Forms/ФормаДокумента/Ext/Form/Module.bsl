&НаКлиенте
Процедура ПодобратьПриобретение(Команда)

	Если ЗначениеЗаполнено(Объект.ПриобретениеТоваров) Тогда
		Оповещение = Новый ОписаниеОповещения("ПодобратьПриобретениеПослеВопроса", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Приобретение уже заполнено. Подобрать заново?",
			РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	ПодобратьПриобретениеПродолжить();

КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПриобретениеПослеВопроса(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ПодобратьПриобретениеПродолжить();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПриобретениеПродолжить()

	РезультатПодбора = ПодобратьПриобретениеНаСервере();

	Если РезультатПодбора.Действие = "Заполнено" Тогда
		Модифицированность = Истина;
		ЗавершитьПодборПриобретения();
		Возврат;
	КонецЕсли;

	Если РезультатПодбора.Действие = "Выбор" Тогда
		Оповещение = Новый ОписаниеОповещения("ПодобратьПриобретениеПослеВыбора", ЭтотОбъект);
		ПоказатьВыборИзСписка(Оповещение, РезультатПодбора.Кандидаты, Элементы.ПриобретениеТоваров);
		Возврат;
	КонецЕсли;

	// Кандидатов нет — объясняем почему и открываем типовой выбор с отбором по контрагенту.
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(РезультатПодбора.Сообщение);

	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(РезультатПодбора.Контрагент) Тогда
		ПараметрыФормы.Вставить("Отбор", Новый Структура("Контрагент", РезультатПодбора.Контрагент));
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПодобратьПриобретениеПослеВыбора", ЭтотОбъект);
	ОткрытьФорму("Документ.ПриобретениеТоваровУслуг.ФормаВыбора", ПараметрыФормы,
		Элементы.ПриобретениеТоваров, , , , Оповещение,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПодобратьПриобретениеПослеВыбора(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// ПоказатьВыборИзСписка возвращает ЭлементСпискаЗначений, форма выбора — ссылку.
	Если ТипЗнч(ВыбранноеЗначение) = Тип("ЭлементСпискаЗначений") Тогда
		Объект.ПриобретениеТоваров = ВыбранноеЗначение.Значение;
	Иначе
		Объект.ПриобретениеТоваров = ВыбранноеЗначение;
	КонецЕсли;

	// Приобретение найдено — закрываем документ. Проверил не трогаем.
	Объект.Закрытый = Истина;
	Модифицированность = Истина;

	ЗавершитьПодборПриобретения();

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПодборПриобретения()

	// Цикл требует записанного документа: пока у документа нет ссылки,
	// обратную ссылку в приобретение поставить некуда.
	Записать();
	Если Модифицированность Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Документ не записан — приобретение осталось необработанным.");
		Возврат;
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОбработатьПриобретениеНаСервере());

КонецПроцедуры

&НаСервере
Функция ОбработатьПриобретениеНаСервере()

	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Ключ = ДокОбъект.КлючПодбораПриобретения();

	Возврат ДокОбъект.ОбработатьПриобретениеПоПодбору(
		Объект.ПриобретениеТоваров, Ключ.ПодбиратьАвтоматически);

КонецФункции

&НаСервере
Функция ПодобратьПриобретениеНаСервере()

	Результат = Новый Структура("Действие, Кандидаты, Сообщение, Контрагент");
	Результат.Действие = "НеНайдено";
	Результат.Кандидаты = Новый СписокЗначений;
	Результат.Сообщение = "";

	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Ключ = ДокОбъект.КлючПодбораПриобретения();
	Результат.Контрагент = Ключ.Контрагент;

	Кандидаты = ДокОбъект.НайтиКандидатовПриобретенияТоваров(Ключ);

	Если Кандидаты.Количество() = 1 Тогда
		Объект.ПриобретениеТоваров = Кандидаты[0].Приобретение;
		// Приобретение найдено — закрываем документ. Проверил не трогаем.
		Объект.Закрытый = Истина;
		Результат.Действие = "Заполнено";
		Возврат Результат;
	КонецЕсли;

	Если Кандидаты.Количество() > 1 Тогда
		Для Каждого Кандидат Из Кандидаты Цикл
			Результат.Кандидаты.Добавить(Кандидат.Приобретение,
				"" + Кандидат.Номер + " от " + Формат(Кандидат.ДатаПриобретения, "ДЛФ=D")
					+ ", " + Формат(Кандидат.СуммаПриобретения, "ЧДЦ=2; ЧРГ=' '"));
		КонецЦикла;
		Результат.Действие = "Выбор";
		Возврат Результат;
	КонецЕсли;

	Результат.Сообщение = "Подходящее приобретение не найдено: контрагент """
		+ Строка(Ключ.Контрагент) + """, сумма "
		+ Формат(Ключ.Сумма, "ЧДЦ=2; ЧРГ=' '") + " +/- "
		+ Формат(ДокОбъект.ДопускСуммыПодбораПриобретения(), "ЧДЦ=2") + ", окно +/- "
		+ Формат(ДокОбъект.ОкноПодбораПриобретенияВДнях(), "ЧГ=0") + " дн."
		+ " Учитываются только проведённые и не помеченные на удаление приобретения,"
		+ " ещё не занятые другим документом.";

	Возврат Результат;

КонецФункции
