Процедура СоздатьДокументОказанияУслугМеждуПодразделениямиПоАрендеТехники() Экспорт

	// Статья затрат "Оренда техніки" (код 00-000024)
	// СДД продавец/покупатель — "Оренда технiки" (код УТ-001130)
	// Номенклатура — "Фінансова послуга для звіту P&L" (код 0Ц-00000002)
	// Форма оплаты — Безналичная

	// === 1. Знайти ВСІ існуючі підлеглі — відмінити проведення + помітка на видалення ===
	ЗапросСуществующий = Новый Запрос;
	ЗапросСуществующий.УстановитьПараметр("АрендаТехники", Ссылка);
	ЗапросСуществующий.Текст = "ВЫБРАТЬ
		|	А_ОказаниеУслугМеждуПодразделениями.Ссылка КАК Ссылка,
		|	А_ОказаниеУслугМеждуПодразделениями.Проведен КАК Проведен
		|ИЗ
		|	Документ.А_ОказаниеУслугМеждуПодразделениями КАК А_ОказаниеУслугМеждуПодразделениями
		|ГДЕ
		|	А_ОказаниеУслугМеждуПодразделениями.АрендаТехники = &АрендаТехники";

	Выборка = ЗапросСуществующий.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если Выборка.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		ДокОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;

	// === 2. Якщо Аренда НЕ проведена — підлеглі вже помічені, виходимо ===
	Если НЕ Проведен Тогда
		Возврат;
	КонецЕсли;

	// === 3. Знайти помічений на видалення (переиспользовать) або створити новий ===
	Результат = ЗапросСуществующий.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		ВыборкаДок = Результат.Выбрать();
		ВыборкаДок.Следующий();
		ДокОказание = ВыборкаДок.Ссылка.ПолучитьОбъект();
		ДокОказание.УстановитьПометкуУдаления(Ложь);
		ДокОказание.Услуги.Очистить();
	Иначе
		ДокОказание = Документы.А_ОказаниеУслугМеждуПодразделениями.СоздатьДокумент();
	КонецЕсли;

	// === 4. Заповнення шапки ===
	ДокОказание.Дата = Дата;
	ДокОказание.Организация = Организация;
	ДокОказание.АрендаТехники = Ссылка;
	ДокОказание.А_Обработан = Истина;
	ДокОказание.А_ВведенВЕРП = Истина;
	ДокОказание.Комментарий = "Оренда технiки " + Формат(Дата, "ДФ=ММММ yyyy");

	// === 5. Довідкові дані ===
	СтатьяЗатрат = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоКоду("00-000024");
	СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду("УТ-001130");
	НоменклатураУслуга = Справочники.Номенклатура.НайтиПоКоду("0Ц-00000002");
	ФормаОплатыБезнал = Перечисления.ФормыОплаты.Безналичная;

	// === 6. Заповнення ТЧ Услуги ===
	КодСтроки = 0;
	СуммаДокумента = 0;

	Для каждого СтрокаСостав Из Состав Цикл

		Если СтрокаСостав.СтороннийЗаказчик ИЛИ СтрокаСостав.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		КодСтроки = КодСтроки + 1;
		НоваяСтрока = ДокОказание.Услуги.Добавить();
		НоваяСтрока.КодСтроки = КодСтроки;
		НоваяСтрока.ПодразделениеПродавец = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(СтрокаСостав.НаправлениеДохода, СтрокаСостав.Подразделение);
		НоваяСтрока.ПодразделениеПокупатель = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(СтрокаСостав.НаправлениеРасхода, СтрокаСостав.ПодразделениеЗаказчик);
		НоваяСтрока.Сумма = СтрокаСостав.Сумма;
		НоваяСтрока.Номенклатура = НоменклатураУслуга;
		НоваяСтрока.СтатьяЗатрат = СтатьяЗатрат;
		НоваяСтрока.СтатьяДвиженияДенежныхСредствПродавец = СтатьяДДС;
		НоваяСтрока.СтатьяДвиженияДенежныхСредствПокупатель = СтатьяДДС;
		НоваяСтрока.ФормаОплаты = ФормаОплатыБезнал;
		НоваяСтрока.Комментарий = СокрЛП(СтрокаСостав.Номенклатура) + " " + СокрЛП(СтрокаСостав.ФИО);
		СуммаДокумента = СуммаДокумента + СтрокаСостав.Сумма;

	КонецЦикла;

	ДокОказание.СуммаДокумента = СуммаДокумента;

	// === 7. Запис, проведення, створення реалізацій ===
	Если КодСтроки > 0 Тогда
		ДокОказание.Записать(РежимЗаписиДокумента.Проведение);
		ДокОказание.СоздатьРеализацииПоОказанииУслугНаСервере();
		Сообщить("Створено/оновлено оказание послуг: " + ДокОказание.Ссылка + " сума: " + Формат(СуммаДокумента, "ЧЦ=15; ЧДЦ=2"));
	КонецЕсли;

КонецПроцедуры

Процедура А_АрендаТехникиПослеОбмена() Экспорт

	Если А_Обработан Тогда
		Возврат;
	КонецЕсли;

	Если А_Необновлять Тогда
		А_Обработан = Истина;
		Возврат;
	КонецЕсли;

	А_Обработан = Истина;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	А_АрендаТехникиПослеОбмена();

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	СоздатьДокументОказанияУслугМеждуПодразделениямиПоАрендеТехники();

КонецПроцедуры
