////////////////////////////////////////////////////////////////////////////////
// Модуль формы документа А_ОтражениеЗарплатыВУчете
// Обработка субконто в табличной части ОтражениеВУчете

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	// Инициализация заголовков субконто для первой строки, если она есть
	Если Объект.ОтражениеВУчете.Количество() > 0 Тогда
		ИдСтроки = Объект.ОтражениеВУчете[0].ПолучитьИдентификатор();
		Элементы.ОтражениеВУчете.ТекущаяСтрока = ИдСтроки;
		УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма, Объект.ОтражениеВУчете[0].СчетДт, "Дт");
		УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма, Объект.ОтражениеВУчете[0].СчетКт, "Кт");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	// Обработчик перед записью
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// Обработчик при чтении на сервере
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	// Обработчик после записи
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	// Обработчик после записи на сервере
КонецПроцедуры

#КонецОбласти

