КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтражениеВУчете

// Обработчик перед началом изменения строки таблицы
//
&НаКлиенте
Процедура ОтражениеВУчетеПередНачаломИзменения(Элемент, Отказ)

	УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма, Элемент.ТекущиеДанные.СчетДт, "Дт");
	УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма, Элемент.ТекущиеДанные.СчетКт, "Кт");

КонецПроцедуры

// Обработчик при начале редактирования строки
//
&НаКлиенте
Процедура ОтражениеВУчетеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НоваяСтрока Тогда
		УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма, Элемент.ТекущиеДанные.СчетДт, "Дт");
		УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма, Элемент.ТекущиеДанные.СчетКт, "Кт");
	КонецЕсли;

КонецПроцедуры

// Обработчик при изменении данных в таблице
//
&НаКлиенте
Процедура ОтражениеВУчетеПриИзменении(Элемент)

	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма, Элемент.ТекущиеДанные.СчетДт, "Дт");
		УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма, Элемент.ТекущиеДанные.СчетКт, "Кт");
	КонецЕсли;

КонецПроцедуры

// Обработчик изменения счета дебета
//
&НаКлиенте
Процедура ОтражениеВУчетеСчетДтПриИзменении(Элемент)

	ОбработатьИзменениеСчета("Дт");

КонецПроцедуры

// Обработчик изменения счета кредита
//
&НаКлиенте
Процедура ОтражениеВУчетеСчетКтПриИзменении(Элемент)

	ОбработатьИзменениеСчета("Кт");

КонецПроцедуры

// Обработчик изменения субконто дебета
//
&НаКлиенте
Процедура ОтражениеВУчетеСубконтоДтПриИзменении(Элемент)

	ИзменитьПараметрыВыбораПолейСубконто(ЭтаФорма, "Дт");

КонецПроцедуры

// Обработчик изменения субконто кредита
//
&НаКлиенте
Процедура ОтражениеВУчетеСубконтоКтПриИзменении(Элемент)

	ИзменитьПараметрыВыбораПолейСубконто(ЭтаФорма, "Кт");

КонецПроцедуры

// Обработчик начала выбора субконто дебета
//
&НаКлиенте
Процедура ОтражениеВУчетеСубконтоДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СписокПараметров = ПолучитьСписокПараметров(ЭтаФорма, Элементы.ОтражениеВУчете.ТекущиеДанные, "СубконтоДт%Индекс%", "СчетДт");
	ОбщегоНазначенияБПКлиент.НачалоВыбораЗначенияСубконто(ЭтаФорма, Элемент, СтандартнаяОбработка, СписокПараметров);

КонецПроцедуры

// Обработчик начала выбора субконто кредита
//
&НаКлиенте
Процедура ОтражениеВУчетеСубконтоКтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СписокПараметров = ПолучитьСписокПараметров(ЭтаФорма, Элементы.ОтражениеВУчете.ТекущиеДанные, "СубконтоКт%Индекс%", "СчетКт");
	ОбщегоНазначенияБПКлиент.НачалоВыбораЗначенияСубконто(ЭтаФорма, Элемент, СтандартнаяОбработка, СписокПараметров);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Изменяет параметры выбора полей субконто
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа
//  ДтКт  - Строка - "Дт" или "Кт"
//
&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьПараметрыВыбораПолейСубконто(Форма, ДтКт)

	ИдСтроки = Форма.Элементы.ОтражениеВУчете.ТекущаяСтрока;
	Если ИдСтроки <> Неопределено Тогда
		СтрокаТаблицы = Форма.Объект.ОтражениеВУчете.НайтиПоИдентификатору(ИдСтроки);
		ПараметрыДокумента = ПолучитьСписокПараметров(Форма, СтрокаТаблицы, "Субконто" + ДтКт + "%Индекс%", "Счет" + ДтКт);
		НастройкаСчетовУчетаКлиентСервер.ИзменитьПараметрыВыбораПолейСубконто(
			Форма, СтрокаТаблицы, "Субконто" + ДтКт + "%Индекс%", "ОтражениеВУчетеСубконто" + ДтКт + "%Индекс%", ПараметрыДокумента);
	КонецЕсли;

КонецПроцедуры

// Устанавливает заголовки и доступность субконто в зависимости от выбранного счета
//
// Параметры:
//  Форма    - ФормаКлиентскогоПриложения - форма документа
//  Счет     - ПланСчетовСсылка.Хозрасчетный - выбранный счет
//  ДтКт     - Строка - "Дт" или "Кт"
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма, Счет, ДтКт)

	ПоляФормы = Новый Структура("Субконто1, Субконто2, Субконто3",
		"ОтражениеВУчетеСубконто" + ДтКт + "1",
		"ОтражениеВУчетеСубконто" + ДтКт + "2",
		"ОтражениеВУчетеСубконто" + ДтКт + "3");

	БухгалтерскийУчетКлиентСервер.ПриВыбореСчета(Счет, Форма, ПоляФормы, Неопределено, Истина);

КонецПроцедуры

// Обрабатывает изменение счета (дебет или кредит)
//
// Параметры:
//  ДтКт - Строка - "Дт" или "Кт"
//
&НаКлиенте
Процедура ОбработатьИзменениеСчета(ДтКт)

	ТекущиеДанные = Элементы.ОтражениеВУчете.ТекущиеДанные;

	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Настройка полей формы для отображения субконто
	ПоляФормы = Новый Структура("Субконто1, Субконто2, Субконто3");
	ПоляФормы.Субконто1 = "ОтражениеВУчетеСубконто" + ДтКт + "1";
	ПоляФормы.Субконто2 = "ОтражениеВУчетеСубконто" + ДтКт + "2";
	ПоляФормы.Субконто3 = "ОтражениеВУчетеСубконто" + ДтКт + "3";
	БухгалтерскийУчетКлиентСервер.ПриВыбореСчета(ТекущиеДанные["Счет" + ДтКт], ЭтаФорма, ПоляФормы, Неопределено, Истина);

	// Настройка полей объекта для очистки/приведения значений субконто
	ПоляОбъекта = Новый Структура("Субконто1, Субконто2, Субконто3, Организация");
	ПоляОбъекта.Субконто1   = "Субконто" + ДтКт + "1";
	ПоляОбъекта.Субконто2   = "Субконто" + ДтКт + "2";
	ПоляОбъекта.Субконто3   = "Субконто" + ДтКт + "3";
	ПоляОбъекта.Организация = Объект.Организация;
	БухгалтерскийУчетКлиентСервер.ПриИзмененииСчета(ТекущиеДанные["Счет" + ДтКт], ТекущиеДанные, ПоляОбъекта, Истина);

	// Изменить параметры выбора для связанных субконто
	ИзменитьПараметрыВыбораПолейСубконто(ЭтаФорма, ДтКт);

КонецПроцедуры

// Формирует список параметров для выбора субконто
//
// Параметры:
//  Форма                - ФормаКлиентскогоПриложения - форма документа
//  СтрокаТаблицы        - ДанныеФормыЭлементКоллекции - текущая строка таблицы
//  ШаблонИмяПоляОбъекта - Строка - шаблон имени поля объекта
//  ИмяПоляСчетУчета     - Строка - имя поля счета учета
//
// Возвращаемое значение:
//  Структура - список параметров для выбора
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСписокПараметров(Форма, СтрокаТаблицы, ШаблонИмяПоляОбъекта, ИмяПоляСчетУчета)

	Возврат НастройкаСчетовУчетаКлиентСервер.ПараметрыВыбораСубконто(
		Форма.Объект.Организация,
		СтрокаТаблицы,
		ШаблонИмяПоляОбъекта,
		ИмяПоляСчетУчета);

КонецФункции

#КонецОбласти
