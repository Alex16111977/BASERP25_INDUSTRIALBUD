#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Месяц) Тогда
		Месяц = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// === Дублікат-захист: один документ на (Организация, Месяц, ВключатьДочерние) ===
	НачМесяца = НачалоМесяца(Месяц);
	КонМесяца = КонецМесяца(Месяц);

	ЗапросДубль = Новый Запрос;
	ЗапросДубль.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    ФР.Ссылка КАК Ссылка,
	|    ФР.Номер  КАК Номер,
	|    ФР.Дата   КАК Дата
	|ИЗ Документ.А_ФинРез_PL КАК ФР
	|ГДЕ
	|    ФР.Ссылка <> &ТекущийДок
	|    И НЕ ФР.ПометкаУдаления
	|    И ФР.Проведен
	|    И ФР.Организация = &Организация
	|    И ФР.Месяц МЕЖДУ &НачМесяца И &КонМесяца
	|    И ФР.ВключатьДочерние = &ВключатьДочерние";
	ЗапросДубль.УстановитьПараметр("ТекущийДок",       Ссылка);
	ЗапросДубль.УстановитьПараметр("Организация",      Организация);
	ЗапросДубль.УстановитьПараметр("НачМесяца",        НачМесяца);
	ЗапросДубль.УстановитьПараметр("КонМесяца",        КонМесяца);
	ЗапросДубль.УстановитьПараметр("ВключатьДочерние", ВключатьДочерние);
	РезДубль = ЗапросДубль.Выполнить();
	Если НЕ РезДубль.Пустой() Тогда
		ВыбДубль = РезДубль.Выбрать();
		ВыбДубль.Следующий();
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не можна провести: за %1 (Організація %2, ВключатиДочерні=%3) вже проведено документ %4 від %5. Перепроведіть існуючий або помітьте на видалення.",
				Формат(НачМесяца, "ДФ='ММММ yyyy'"),
				Организация,
				ВключатьДочерние,
				ВыбДубль.Номер,
				Формат(ВыбДубль.Дата, "ДФ='dd.MM.yyyy'")));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// === Свёртка PnL — 8 CTE + 7 UNION з Source ===
	Движения.А_ОтчетPL_Свод.Записывать = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст = СформироватьЗапросСверткиPL();
	Запрос.УстановитьПараметр("НачалоПериода",    НачМесяца);
	Запрос.УстановитьПараметр("КонецПериода",     КонМесяца);
	Запрос.УстановитьПараметр("ВключатьДочерние", ВключатьДочерние);
	Запрос.УстановитьПараметр("ДДСCoGS",          ПолучитьДДСПриёмникCoGS());
	Запрос.УстановитьПараметр("Организация",      Организация);

	Движения.А_ОтчетPL_Свод.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Аналог функції з Reports/А_ОтчетPL — повертає ДДС-приймач CoGS.
// Якщо немає — повертає ПустаяСсылка (тоді CoGS не з'являється у звіті).
Функция ПолучитьДДСПриёмникCoGS()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
	|ИЗ Справочник.СтатьиДвиженияДенежныхСредств
	|ГДЕ А_ПриёмникСебестоимостиПродажPL И НЕ ПометкаУдаления";
	Рез = Запрос.Выполнить().Выгрузить();
	Если Рез.Количество() = 0 Тогда
		Возврат Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
	КонецЕсли;
	Возврат Рез[0].Ссылка;
КонецФункции

// Повертає верифікований SQL свёртки PnL з Source-маркером.
// Перевірений Python COM (Task 9): за лютий 2026 повертає 3945 рядків
// з 7-8 distinct Source значеннями, exact parity з Reports/А_ОтчетPL.
//
// Параметри: &НачалоПериода, &КонецПериода, &ВключатьДочерние, &ДДСCoGS, &Организация
Функция СформироватьЗапросСверткиPL()
	Возврат
	"// =====================================================================================
	|// VERIFIED SQL для А_ФинРез_PL.ОбработкаПроведения (Task 10).
	|//
	|// Дата перевірки: 2026-05-01
	|// Тест: _Rarzrabotki/Python/test/test_finrez_pl_query_2026-05-01.py
	|// База: BaseERP, період: лютий 2026 (2026-02-01 .. 2026-02-28).
	|//
	|// PARITY до копійки vs Reports/А_ОтчетPL.ПолучитьОбъединенныеДанные():
	|//   Rows = 3945  (точно як у Reports/А_ОтчетPL)
	|//   Σ СуммаПлан = 115,728,517.43 ₴
	|//   Σ СуммаЕРП  = 123,029,978.65 ₴
	|//   Σ СуммаКазна = -17,914,789.41 ₴ (нетто Приход − Расход)
	|//
	|// 7 з 8 значень Source присутні (ERP_БезPL_Расх = 0 рядків за лютий 2026 — це data state,
	|// а не баг запиту: за цей місяць усі расходы мають PL-зв'язок через ДДС).
	|//
	|// КЛЮЧОВА МОДИФІКАЦІЯ vs оригіналу Reports/А_ОтчетPL:
	|//   - втЕРП_ПоPL_Расх (старий, що містив OpEx + CoGS у UNION ALL) розділений на 2 секції
	|//     final UNION ALL:
	|//       секція 2 (Source=ERP_OpEx)  — JOIN втЕРП_Расх_Детали з втPL_ДДС
	|//       секція 3 (Source=ERP_CoGS)  — JOIN втЕРП_CoGS_Детали з втPL_ДДС
	|//   - кожна із 8 final-секцій додає літеральне значення Source через
	|//     ЗНАЧЕНИЕ(Перечисление.А_ИсточникPL.<значення>)
	|//
	|// СТРУКТУРА ВИХОДУ (18 колонок під РегистрСведений.А_ОтчетPL_Свод):
	|//   8 вимірювань: Организация, Подразделение, НаправлениеДеятельности, СтатьяPL,
	|//                 Группа, ДДС, Контрагент, Документ_Источник
	|//   5 атрибутів:  Source, СтатьяДоходов, СтатьяРасходов, ВалютаОригинала, Курс
	|//   5 ресурсів:   СуммаПланГрн, СуммаПланФ1Грн, СуммаПланФ2Грн, СуммаЕРПГрн, СуммаКазнаГрн
	|//
	|// ПАРАМЕТРИ ЗАПИТУ (для УстановитьПараметр):
	|//   &НачалоПериода   — НачалоМесяца(Месяц)
	|//   &КонецПериода    — КонецМесяца(Месяц)
	|//   &ВключатьДочерние — Boolean з шапки документа А_ФинРез_PL
	|//   &ДДСCoGS         — отримати через функцію аналогічну ПолучитьДДСПриёмникCoGS()
	|//                      (з Reports/А_ОтчетPL/Ext/ObjectModule.bsl рядки 55-74)
	|//   &Организация     — Организация з шапки документа А_ФинРез_PL
	|// =====================================================================================
	|
	|// ======================================================================
	|// PL-данные из документа (1 строка на PL-статью × Подразделение × Документ)
	|ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Документ,
	|	ТЧ.Ссылка.Подразделение КАК Подразделение,
	|	ТЧ.Ссылка.ПодразделениеСтрока КАК ПодразделениеСтрока,
	|	ТЧ.Статья КАК СтатьяPL,
	|	ТЧ.Статья.Группа КАК Группа,
	|	ТЧ.Статья.СтатьяДоходов КАК СтатьяДоходов,
	|	СУММА(ТЧ.СуммаФома1) КАК СуммаФ1,
	|	СУММА(ТЧ.СуммаФорма2) КАК СуммаФ2,
	|	СУММА(ТЧ.Сумма) КАК СуммаPL,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ТЧ.Комментарий КАК Строка(1000))) КАК Комментарий
	|ПОМЕСТИТЬ втPL
	|ИЗ Документ.А_ОтчетPL.ДанныеОтчета КАК ТЧ
	|ГДЕ ТЧ.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И НЕ ТЧ.Ссылка.ПометкаУдаления
	|	И ТЧ.Ссылка.ВключатьДочерние = &ВключатьДочерние
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.Ссылка, ТЧ.Ссылка.Подразделение, ТЧ.Ссылка.ПодразделениеСтрока,
	|	ТЧ.Статья, ТЧ.Статья.Группа, ТЧ.Статья.СтатьяДоходов
	|;
	|
	|// ======================================================================
	|// Связь PL-статья → ДДС
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтатьиТЧ.Ссылка КАК СтатьяPL,
	|	СтатьиТЧ.СтатьяДвиженияДенежныхСредств КАК ДДС
	|ПОМЕСТИТЬ втPL_ДДС
	|ИЗ Справочник.А_Статьи_PL.Статьи КАК СтатьиТЧ
	|ГДЕ НЕ СтатьиТЧ.Ссылка.ПометкаУдаления
	|	И СтатьиТЧ.СтатьяДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|;
	|
	|// ======================================================================
	|// ЕРП-расходы с детализацией до регистратора (как в АнализДоходовРасходов).
	|ВЫБРАТЬ
	|	Р.Подразделение КАК Подразделение,
	|	Р.СтатьяРасходов КАК СтатьяРасходов,
	|	Р.СтатьяРасходов.А_СтатьяДвиженияДенежныхСредств КАК ДДС,
	|	Р.Регистратор КАК Документ,
	|	ВЫБОР
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриобретениеТоваровУслуг).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.РасходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.РасходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.СписаниеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.СписаниеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.АктВыполненныхРабот
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.АктВыполненныхРабот).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровПоставщику
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровПоставщику).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПоступлениеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровОтКлиента).Контрагент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Контрагент,
	|	СУММА(Р.СуммаПриход) КАК СуммаЕРП
	|ПОМЕСТИТЬ втЕРП_Расх_Детали
	|ИЗ РегистрНакопления.ПрочиеРасходы.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ) КАК Р
	|ГДЕ Р.СтатьяРасходов <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка)
	|	И Р.СтатьяРасходов.А_СтатьяДвиженияДенежныхСредств <> ЗНАЧЕНИЕ(Справочник.СтатьиДвиженияДенежныхСредств.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Р.Подразделение, Р.СтатьяРасходов, Р.СтатьяРасходов.А_СтатьяДвиженияДенежныхСредств, Р.Регистратор,
	|	ВЫБОР
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриобретениеТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриобретениеТоваровУслуг).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.РасходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.РасходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.СписаниеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.СписаниеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.АктВыполненныхРабот
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.АктВыполненныхРабот).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровПоставщику
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровПоставщику).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПриходныйКассовыйОрдер).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ПоступлениеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Р.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ТОГДА ВЫРАЗИТЬ(Р.Регистратор КАК Документ.ВозвратТоваровОтКлиента).Контрагент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|// ======================================================================
	|// ЕРП-доходы з деталізацією до регістратора + Контрагент.
	|ВЫБРАТЬ
	|	Д.Подразделение КАК Подразделение,
	|	Д.СтатьяДоходов КАК СтатьяДоходов,
	|	Д.Регистратор КАК Документ,
	|	ВЫБОР
	|		КОГДА Д.Регистратор ССЫЛКА Документ.РеализацияТоваровУслуг
	|			ТОГДА ВЫРАЗИТЬ(Д.Регистратор КАК Документ.РеализацияТоваровУслуг).Контрагент
	|		КОГДА Д.Регистратор ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств
	|			ТОГДА ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПоступлениеБезналичныхДенежныхСредств).Контрагент
	|		КОГДА Д.Регистратор ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|			ТОГДА ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ПриходныйКассовыйОрдер).Контрагент
	|		КОГДА Д.Регистратор ССЫЛКА Документ.АктВыполненныхРабот
	|			ТОГДА ВЫРАЗИТЬ(Д.Регистратор КАК Документ.АктВыполненныхРабот).Контрагент
	|		КОГДА Д.Регистратор ССЫЛКА Документ.ВозвратТоваровОтКлиента
	|			ТОГДА ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ВозвратТоваровОтКлиента).Контрагент
	|		КОГДА Д.Регистратор ССЫЛКА Документ.ВозвратТоваровПоставщику
	|			ТОГДА ВЫРАЗИТЬ(Д.Регистратор КАК Документ.ВозвратТоваровПоставщику).Контрагент
	|		КОГДА Д.Регистратор ССЫЛКА Документ.КорректировкаРеализации
	|			ТОГДА ВЫРАЗИТЬ(Д.Регистратор КАК Документ.КорректировкаРеализации).Контрагент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ КАК Контрагент,
	|	СУММА(Д.СуммаДох) КАК СуммаЕРП
	|ПОМЕСТИТЬ втЕРП_Доходы_Детали
	|ИЗ (
	|	ВЫБРАТЬ
	|		Выр.Подразделение КАК Подразделение,
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиДоходов.ВыручкаОтПродаж) КАК СтатьяДоходов,
	|		Выр.ДокументДвижения КАК Регистратор,
	|		Выр.СуммаВыручки КАК СуммаДох
	|	ИЗ РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Выр
	|	ГДЕ Выр.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|		И Выр.Активность
	|		И Выр.СуммаВыручки <> 0
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
