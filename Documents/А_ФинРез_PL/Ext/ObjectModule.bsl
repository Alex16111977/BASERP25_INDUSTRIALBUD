	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиДоходов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
	|	1,
	|	0,
	|	0,
	|	0,
	|	0,
	|	К.СуммаКазнаПриход - К.СуммаКазнаРасход
	|ИЗ втКазна_ПоПодрДДС КАК К
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втPL_ДДС КАК PLДДС ПО PLДДС.ДДС = К.ДДС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// 8) Казна_БезPL — Каса без связи с PL.
	|ВЫБРАТЬ
	|	&Организация,
	|	К.Подразделение,
	|	К.Подразделение.А_НаправлениеДеятельности,
	|	ЗНАЧЕНИЕ(Справочник.А_Статьи_PL.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.А_ГруппаСтатей_PL.ПустаяСсылка),
	|	К.ДДС,
	|	К.Контрагент,
	|	К.Документ,
	|	ЗНАЧЕНИЕ(Перечисление.А_ИсточникPL.Казна_БезPL),
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиДоходов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиРасходов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
	|	1,
	|	0,
	|	0,
	|	0,
	|	0,
	|	К.СуммаКазнаПриход - К.СуммаКазнаРасход
	|ИЗ втКазна_ПоПодрДДС КАК К
	|ГДЕ НЕ К.ДДС В (ВЫБРАТЬ PLД.ДДС ИЗ втPL_ДДС КАК PLД)
	|;
	|
	|// ======================================================================
	|// Финальный SELECT — данные для регистра А_ОтчетPL_Свод (загрузить через Движения.А_ОтчетPL_Свод.Загрузить()).
	|ВЫБРАТЬ
	|	Организация,
	|	Подразделение,
	|	НаправлениеДеятельности,
	|	СтатьяPL,
	|	Группа,
	|	ДДС,
	|	Контрагент,
	|	Документ_Источник,
	|	Source,
	|	СтатьяДоходов,
	|	СтатьяРасходов,
	|	ВалютаОригинала,
	|	Курс,
	|	СуммаПланГрн,
	|	СуммаПланФ1Грн,
	|	СуммаПланФ2Грн,
	|	СуммаЕРПГрн,
	|	СуммаКазнаГрн
	|ИЗ втРезультат";
КонецФункции

#КонецОбласти

#КонецЕсли
