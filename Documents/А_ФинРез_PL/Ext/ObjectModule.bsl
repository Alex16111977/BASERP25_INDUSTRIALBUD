#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Месяц) Тогда
		Месяц = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// === Дублікат-захист: один документ на (Организация, Месяц) ===
	НачМесяца = НачалоМесяца(Месяц);
	КонМесяца = КонецМесяца(Месяц);

	ЗапросДубль = Новый Запрос;
	ЗапросДубль.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    ФР.Ссылка КАК Ссылка,
	|    ФР.Номер  КАК Номер,
	|    ФР.Дата   КАК Дата
	|ИЗ Документ.А_ФинРез_PL КАК ФР
	|ГДЕ
	|    ФР.Ссылка <> &ТекущийДок
	|    И НЕ ФР.ПометкаУдаления
	|    И ФР.Проведен
	|    И ФР.Организация = &Организация
	|    И ФР.Месяц МЕЖДУ &НачМесяца И &КонМесяца";
	ЗапросДубль.УстановитьПараметр("ТекущийДок",  Ссылка);
	ЗапросДубль.УстановитьПараметр("Организация", Организация);
	ЗапросДубль.УстановитьПараметр("НачМесяца",   НачМесяца);
	ЗапросДубль.УстановитьПараметр("КонМесяца",   КонМесяца);
	РезДубль = ЗапросДубль.Выполнить();
	Если НЕ РезДубль.Пустой() Тогда
		ВыбДубль = РезДубль.Выбрать();
		ВыбДубль.Следующий();
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не можна провести: за %1 (Організація %2) вже проведено документ %3 від %4. Перепроведіть існуючий або помітьте на видалення.",
				Формат(НачМесяца, "ДФ='ММММ yyyy'"),
				Организация,
				ВыбДубль.Номер,
				Формат(ВыбДубль.Дата, "ДФ='dd.MM.yyyy'")));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// === Свёртка PnL: 5 CTE + 6 секцій UNION (PL_Excel + 5×PL_ЕРП) ===
	Движения.А_ОтчетPL_Свод.Записывать = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст = СформироватьЗапросСверткиPL();
	Запрос.УстановитьПараметр("НачалоПериода", НачМесяца);
	Запрос.УстановитьПараметр("КонецПериода",  КонМесяца);
	Запрос.УстановитьПараметр("ДДСCoGS",       ПолучитьДДСПриёмникCoGS());
	Запрос.УстановитьПараметр("Организация",   Организация);

	ТЗДвижений = Запрос.Выполнить().Выгрузить();
	Движения.А_ОтчетPL_Свод.Загрузить(ТЗДвижений);

	// === Оновлення регістра розшифровки документів (DISABLED 2026-05-20) ===
	// Регістр РегистрСведений.А_ДокументРасшифровка був запланований у Stage v2 (2026-05-05)
	// але фактично НЕ створений (knowledge_Olap §9 хибно позначений як DONE).
	// Перевірено: файлу немає у конфігурації (Glob InformationRegisters/А_ДокументРасшифровка*),
	// у git історії (git log не знаходить), у БД (mcp list_metadata_objects → 0).
	// Виклик закоментований щоб документ міг проводитись. Основна свертка А_ОтчетPL_Свод
	// працює без цього регістра — це лише drill-down довідник для OLAP.
	//
	// Якщо потрібен drill-down — створити регістр за специфікацією у
	// knowledge_Olap/olap_1c_objects.md §9 (1 вимір Документ composite + 7 ресурсів +
	// ManagerModule з ОбновитьПоДокументам + ПолучитьВидBuhBud), потім розкоментувати.
	//
	// МассивДок = Новый Массив;
	// Знайдено  = Новый Соответствие;
	// Для Каждого Стр Из ТЗДвижений Цикл
	// 	Если Стр.ДокументДвижения = Неопределено Тогда
	// 		Продолжить;
	// 	КонецЕсли;
	// 	Если Стр.ДокументДвижения.Пустая() Тогда
	// 		Продолжить;
	// 	КонецЕсли;
	// 	Если Знайдено.Получить(Стр.ДокументДвижения) <> Неопределено Тогда
	// 		Продолжить;
	// 	КонецЕсли;
	// 	Знайдено.Вставить(Стр.ДокументДвижения, Истина);
	// 	МассивДок.Добавить(Стр.ДокументДвижения);
	// КонецЦикла;
	//
	// РегистрыСведений.А_ДокументРасшифровка.ОбновитьПоДокументам(МассивДок);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДДСПриёмникCoGS()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
	|ИЗ Справочник.СтатьиДвиженияДенежныхСредств
	|ГДЕ А_ПриёмникСебестоимостиПродажPL И НЕ ПометкаУдаления";
	Рез = Запрос.Выполнить().Выгрузить();
	Если Рез.Количество() = 0 Тогда
		Возврат Справочники.СтатьиДвиженияДенежныхСредств.ПустаяСсылка();
	КонецЕсли;
	Возврат Рез[0].Ссылка;
КонецФункции

Функция СформироватьЗапросСверткиPL()
	Возврат
	"ВЫБРАТЬ
	|	ТЧ.Ссылка КАК Документ,
	|	ТЧ.Ссылка.Подразделение КАК Подразделение,
