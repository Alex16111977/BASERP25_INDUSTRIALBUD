Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Валидация: свод по направлению требует заполненного НаправлениеДеятельности.
	Если ВключатьДочерние И НЕ ЗначениеЗаполнено(НаправлениеДеятельности) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Установлен флаг «Включать дочерние», но «НаправлениеДеятельности» не заполнено. "
			+ "Либо снимите флаг, либо укажите направление.";
		Сообщение.Поле = "НаправлениеДеятельности";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Если ОбменДанными.Загрузка Тогда
		// При загрузке через Python-импорт (COM, ОбменДанными.Загрузка = Истина) —
		// Сумма_Расчёт и Расхождение уже посчитаны на стороне загрузчика.
		Возврат;
	КонецЕсли;

	ПересчитатьИтогиПоГруппам();

КонецПроцедуры

// Пересчёт ТЧ ИтогиПоГруппам на основе текущих данных ДанныеОтчета.
// Для каждой группы PL (из А_Статьи_PL.Группа) суммирует Сумма из деталей,
// записывает в Сумма_Расчёт и Расхождение = Сумма_Excel − Сумма_Расчёт.
Процедура ПересчитатьИтогиПоГруппам()

	СуммыПоГруппам = Новый Соответствие;

	Для Каждого СтрокаДеталь Из ДанныеОтчета Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаДеталь.Статья) Тогда
			Продолжить;
		КонецЕсли;
		Группа = СтрокаДеталь.Статья.Группа;
		Если Группа = Неопределено ИЛИ Группа.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		Текущая = СуммыПоГруппам.Получить(Группа);
		Если Текущая = Неопределено Тогда
			Текущая = 0;
		КонецЕсли;
		СуммыПоГруппам.Вставить(Группа, Текущая + СтрокаДеталь.Сумма);
	КонецЦикла;

	Для Каждого СтрокаИтог Из ИтогиПоГруппам Цикл
		Расчёт = СуммыПоГруппам.Получить(СтрокаИтог.Группа);
		Если Расчёт = Неопределено Тогда
			Расчёт = 0;
		КонецЕсли;
		СтрокаИтог.Сумма_Расчёт = Расчёт;
		СтрокаИтог.Расхождение = СтрокаИтог.Сумма_Excel - Расчёт;
	КонецЦикла;

КонецПроцедуры
