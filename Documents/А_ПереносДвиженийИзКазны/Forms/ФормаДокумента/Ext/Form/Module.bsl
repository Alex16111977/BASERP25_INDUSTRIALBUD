&НаСервере
Процедура ЗаполнитьИзКазныНаСервере()
	Объект_Объект = РеквизитФормыВЗначение("Объект");
	Объект_Объект.ЗаполнитьИзКазны();
	ЗначениеВРеквизитФормы(Объект_Объект, "Объект");
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзКазны(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Месяц) Тогда
		ПоказатьПредупреждение(, "Заповніть реквізит ""Місяць""!");
		Возврат;
	КонецЕсли;

	Если Объект.СтрокиДвижений.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьИзКазныЗавершение", ЭтаФорма);
		ПоказатьВопрос(ОписаниеОповещения,
			"Табличну частину ""Строки движений"" буде перезаписано. Продовжити?",
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Иначе
		ВыполнитьЗаполнение();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзКазныЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьЗаполнение();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗаполнение()
	СостояниеИндикатор = Новый ОписаниеПередаваемогоФайла("Завантаження з Казни...", "");
	Состояние("Завантаження з Казни...");
	Попытка
		ЗаполнитьИзКазныНаСервере();
		Состояние("Готово");
	Исключение
		ПоказатьПредупреждение(, "Помилка: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДокумента(Команда)
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Документ ще не записаний. Запишіть його, потім відкривайте рухи.");
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("ДокументВладелец, ПараметрКоманды", Объект.Ссылка, Объект.Ссылка);
	ОткрытьФорму("Отчет.ДвиженияДокумента.Форма", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры
