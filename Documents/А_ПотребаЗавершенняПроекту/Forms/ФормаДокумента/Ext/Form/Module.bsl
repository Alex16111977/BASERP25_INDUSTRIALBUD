КонецПроцедуры

&НаКлиенте
Процедура ПровестиИЗакрыть(Команда)
	ОбщегоНазначенияУТКлиент.ПровестиИЗакрыть(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзExcel(Команда)

	Если Не ЗначениеЗаполнено(Объект.Подразделение) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Спочатку оберіть підрозділ проєкту.'; uk = 'Спочатку оберіть підрозділ проєкту.'"));
		Возврат;
	КонецЕсли;
	ОписаниеПомещения = Новый ОписаниеОповещения("ЗаполнитьИзExcelФайлПомещен", ЭтотОбъект);
	НачатьПомещениеФайла(ОписаниеПомещения, , , Истина, УникальныйИдентификатор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьИзExcelФайлПомещен(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	Прочитано = ПрочитатьФайлНаСервере(Адрес, ИмяФайлаБезПути(ВыбранноеИмяФайла));
	Если ЗначениеЗаполнено(Прочитано.Ошибка) Тогда
		ПоказатьПредупреждение(, Прочитано.Ошибка);
		Возврат;
	КонецЕсли;
	РазделыФайла = Прочитано.Разделы;
	Если РазделыФайла.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'У файлі не знайдено таблиці потреби: потрібна шапка з колонками «Вірна назва згідно СС» або «Назва товару», «К-сть» або «Обсяг згідно СС», «Вартість» або «Ціна».';
			|uk = 'У файлі не знайдено таблиці потреби: потрібна шапка з колонками «Вірна назва згідно СС» або «Назва товару», «К-сть» або «Обсяг згідно СС», «Вартість» або «Ціна».'"));
		Возврат;
	КонецЕсли;
	Если РазделыФайла.Количество() = 1 Тогда
		ПослеВыбораРаздела(Новый Структура("Значение", 0), Неопределено);
		Возврат;
	КонецЕсли;

	СписокРазделов = Новый СписокЗначений;
	Для Индекс = 0 По РазделыФайла.ВГраница() Цикл
		Раздел = РазделыФайла[Индекс];
		СписокРазделов.Добавить(Индекс, СтрШаблон(НСтр("ru = '%1 — %2 рядків, %3 грн'; uk = '%1 — %2 рядків, %3 грн'"),
			Раздел.Имя, Раздел.Строки.Количество(), Формат(Раздел.Сумма, "ЧДЦ=2; ЧРГ=' '")));
	КонецЦикла;
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПослеВыбораРаздела", ЭтотОбъект), СписокРазделов);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРаздела(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Индекс = ВыбранныйЭлемент.Значение;
	Раздел = РазделыФайла[Индекс];
	Если ЗначениеЗаполнено(Раздел.Ошибка) Тогда
		ПоказатьПредупреждение(, Раздел.Ошибка);
		Возврат;
	КонецЕсли;
	Если Раздел.ЦеныБезНДС И Не ЦеныБезНДС Тогда
		ЦеныБезНДС = Истина;
		ПоказатьОповещениеПользователя(НСтр("ru = 'Ціни у файлі без ПДВ'; uk = 'Ціни у файлі без ПДВ'"), ,
			НСтр("ru = 'Заголовок колонки ціни містить «без ПДВ» — при завантаженні ціни буде збільшено на 20 %.';
				|uk = 'Заголовок колонки ціни містить «без ПДВ» — при завантаженні ціни буде збільшено на 20 %.'"));
	КонецЕсли;
	Если Объект.Потреба.Количество() = 0 Тогда
		ЗагрузитьРаздел(Индекс);
		Возврат;
	КонецЕсли;
	ПоказатьВопрос(Новый ОписаниеОповещения("ПослеВопросаЗаменить", ЭтотОбъект, Индекс),
		НСтр("ru = 'Замінити рядки потреби даними з файлу?'; uk = 'Замінити рядки потреби даними з файлу?'"), РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаЗаменить(Ответ, Индекс) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗагрузитьРаздел(Индекс);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьРаздел(Индекс)

	Итог = ЗаполнитьПотребуНаСервере(РазделыФайла[Индекс]);
	Если ЗначениеЗаполнено(Итог.Ошибка) Тогда
		ПоказатьПредупреждение(, Итог.Ошибка);
		Возврат;
	КонецЕсли;
	Модифицированность = Истина;
	ПоказатьОповещениеПользователя(НСтр("ru = 'Потребу завантажено'; uk = 'Потребу завантажено'"), ,
		СтрШаблон(НСтр("ru = 'Рядків: %1, сума: %2 грн. Без загальної назви: %3. З попередженнями: %4.';
			|uk = 'Рядків: %1, сума: %2 грн. Без загальної назви: %3. З попередженнями: %4.'"),
			Итог.Строк, Формат(Итог.Сумма, "ЧДЦ=2; ЧРГ=' '"), Итог.НеНайдено, Итог.Предупреждений));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьФайлНаСервере(Адрес, ИмяФайла)

	Возврат Документы.А_ПотребаЗавершенняПроекту.ПрочитатьФайлПотребы(Адрес, ИмяФайла);

КонецФункции

&НаСервере
Функция ЗаполнитьПотребуНаСервере(Раздел)

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	Итог = Документы.А_ПотребаЗавершенняПроекту.ЗаполнитьПотребу(ДокументОбъект, Раздел, ЦеныБезНДС);
	Если Не ЗначениеЗаполнено(Итог.Ошибка) Тогда
		ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	КонецЕсли;
	Возврат Итог;

КонецФункции

&НаКлиенте
Функция ИмяФайлаБезПути(ПолноеИмя)

	Части = СтрРазделить(СтрЗаменить(ПолноеИмя, "\", "/"), "/", Ложь);
	Возврат ?(Части.Количество() = 0, ПолноеИмя, Части[Части.ВГраница()]);

КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	Для Каждого ИмяПоля Из СтрРазделить("ПотребаОбщееНазвание,ПотребаНазваниеСС", ",") Цикл
		ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;
	ОтборОформления = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОформления.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Потреба.ОбщееНазвание");
	ОтборОформления.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона", WebЦвета.БледноЗолотистый);

	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ПолеОформления = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеОформления.Поле = Новый ПолеКомпоновкиДанных("ПотребаПредупреждение");
	ОтборОформления = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОформления.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Потреба.Предупреждение");
	ОтборОформления.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.ТемноКрасный);

КонецПроцедуры

