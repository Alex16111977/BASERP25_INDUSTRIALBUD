#Область ПрограммныйИнтерфейс

// Подразделения, у которых есть активные структуры себестоимости (проекты «План-факт»).
//
// Возвращаемое значение:
//   Массив из СправочникСсылка.СтруктураПредприятия
//
Функция ПодразделенияАктивныхСС() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтрСС.Подразделение КАК Подразделение
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости КАК СтрСС
	|ГДЕ
	|	НЕ СтрСС.ЭтоГруппа
	|	И СтрСС.Активная
	|	И НЕ СтрСС.ПометкаУдаления
	|	И СтрСС.Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)";
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Подразделение");

КонецФункции

// Читает xlsx-файл потребы директора и раскладывает его на разделы («Проект ...»).
//
// Параметры:
//   ИсточникФайла - Строка - адрес временного хранилища с двоичными данными или путь к файлу на сервере.
//   ИмяФайла      - Строка - исходное имя файла (для расширения и шапки документа).
//
// Возвращаемое значение:
//   Структура:
//     * Ошибка  - Строка - текст ошибки чтения; пусто, если файл прочитан.
//     * Разделы - Массив из Структура - см. НовыйРаздел.
//
Функция ПрочитатьФайлПотребы(ИсточникФайла, ИмяФайла) Экспорт

	Результат = Новый Структура("Ошибка, Разделы", "", Новый Массив);
	ЧерезХранилище = ЭтоАдресВременногоХранилища(ИсточникФайла);
	Расширение = НРег(РасширениеФайла(ИмяФайла));
	Если Расширение = "xls" Тогда
		Результат.Ошибка = НСтр("ru = 'Формат .xls не підтримується. Збережіть файл у форматі .xlsx і повторіть.';
			|uk = 'Формат .xls не підтримується. Збережіть файл у форматі .xlsx і повторіть.'");
		ОсвободитьХранилище(ИсточникФайла, ЧерезХранилище);
		Возврат Результат;
	КонецЕсли;

	ПутьКопии = ПолучитьИмяВременногоФайла("xlsx");
	ТабДок = Неопределено;
	Попытка
		Если ЧерезХранилище Тогда
			ДанныеКниги = ПолучитьИзВременногоХранилища(ИсточникФайла);
			ДанныеКниги.Записать(ПутьКопии);
		Иначе
			КопироватьФайл(ИсточникФайла, ПутьКопии);
		КонецЕсли;
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(ПутьКопии, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	Исключение
		ТабДок = Неопределено;
		Результат.Ошибка = НСтр("ru = 'Не вдалося прочитати файл. Якщо він відкритий в Excel — збережіть і повторіть. ';
			|uk = 'Не вдалося прочитати файл. Якщо він відкритий в Excel — збережіть і повторіть. '")
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	УдалитьФайлБезИсключений(ПутьКопии);
	ОсвободитьХранилище(ИсточникФайла, ЧерезХранилище);
	Если ТабДок = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Лист Из ЛистыТабличногоДокумента(ТабДок) Цикл
		РазобратьЛист(ТабДок, Лист, ИмяФайла, Результат.Разделы);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заполняет табличную часть «Потреба» документа строками раздела файла.
// Загальна назва ищется сначала среди строк СС подразделения документа, затем по справочнику.
//
// Параметры:
//   ДокументОбъект - ДокументОбъект.А_ПотребаЗавершенняПроекту - с заполненным Подразделение.
//   Раздел         - Структура - элемент Разделы из ПрочитатьФайлПотребы.
//   ЦеныБезНДС     - Булево - Истина: цены файла без НДС, при загрузке умножаются на 1,2.
//
// Возвращаемое значение:
//   Структура - Ошибка, Строк, Сумма, НеНайдено, Предупреждений.
//
Функция ЗаполнитьПотребу(ДокументОбъект, Раздел, ЦеныБезНДС = Ложь) Экспорт

	Итог = Новый Структура("Ошибка, Строк, Сумма, НеНайдено, Предупреждений", "", 0, 0, 0, 0);
	Если Не ЗначениеЗаполнено(ДокументОбъект.Подразделение) Тогда
		Итог.Ошибка = НСтр("ru = 'Спочатку оберіть підрозділ проєкту.'; uk = 'Спочатку оберіть підрозділ проєкту.'");
		Возврат Итог;
	КонецЕсли;
	Если ЗначениеЗаполнено(Раздел.Ошибка) Тогда
		Итог.Ошибка = Раздел.Ошибка;
		Возврат Итог;
	КонецЕсли;

	ОНПроекта = ОбщиеНазванияПроекта(ДокументОбъект.Подразделение);
	ОНСправочника = ОбщиеНазванияСправочника();
	Множитель = ?(ЦеныБезНДС, 1.2, 1);

	ДокументОбъект.Потреба.Очистить();
	Для Каждого СтрокаФайла Из Раздел.Строки Цикл
		НоваяСтрока = ДокументОбъект.Потреба.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаФайла, "НомерСтрокиФайла, НазваниеТовара, НазваниеСС, Единица, КоличествоСС, Дома");
		НоваяСтрока.Количество = СтрокаФайла.КолФайла;
		НоваяСтрока.Цена = Окр(СтрокаФайла.Цена * Множитель, 2);
		НоваяСтрока.Сумма = Окр(СтрокаФайла.Сумма * Множитель, 2);

		Замечания = Новый Массив;
		Если ЗначениеЗаполнено(СтрокаФайла.Предупреждение) Тогда
			Замечания.Добавить(СтрокаФайла.Предупреждение);
		КонецЕсли;
		Если СтрНайти(СтрокаФайла.НазваниеСС, "/") > 0 Тогда
			Найдено = НайтиСкладеноеНазвание(СтрокаФайла.НазваниеСС, ОНПроекта);
		Иначе
			Найдено = НайтиОбщееНазвание(СтрокаФайла.НазваниеСС, ОНПроекта, ОНСправочника);
		КонецЕсли;
		НоваяСтрока.ОбщееНазвание = Найдено.Ссылка;
		НоваяСтрока.ЕдиницаСС = Найдено.Единица;
		Если ЗначениеЗаполнено(Найдено.Замечание) Тогда
			Замечания.Добавить(Найдено.Замечание);
		КонецЕсли;
		ЕдиницаФайлаСС = НормализоватьТекст(СтрокаФайла.ЕдиницаСС);
		Если ЗначениеЗаполнено(НоваяСтрока.ЕдиницаСС) И ЗначениеЗаполнено(ЕдиницаФайлаСС)
			И ЕдиницаФайлаСС <> НормализоватьТекст(Строка(НоваяСтрока.ЕдиницаСС)) Тогда
			Замечания.Добавить(СтрШаблон(НСтр("ru = 'Одиниця у файлі «%1» ≠ одиниці СС «%2»'; uk = 'Одиниця у файлі «%1» ≠ одиниці СС «%2»'"),
				СокрЛП(СтрокаФайла.ЕдиницаСС), СокрЛП(Строка(НоваяСтрока.ЕдиницаСС))));
		КонецЕсли;

		НоваяСтрока.Предупреждение = Лев(СтрСоединить(Замечания, "; "), 250);
		Итог.Строк = Итог.Строк + 1;
		Итог.Сумма = Итог.Сумма + НоваяСтрока.Сумма;
		Если Не ЗначениеЗаполнено(НоваяСтрока.ОбщееНазвание) Тогда
			Итог.НеНайдено = Итог.НеНайдено + 1;
		КонецЕсли;
		Если ЗначениеЗаполнено(НоваяСтрока.Предупреждение) Тогда
			Итог.Предупреждений = Итог.Предупреждений + 1;
		КонецЕсли;
	КонецЦикла;

	ДокументОбъект.ИмяФайла = Лев(Раздел.ИмяФайла, 250);
	ДокументОбъект.РазделФайла = Лев(Раздел.Имя, 150);
	ДокументОбъект.СуммаДокумента = ДокументОбъект.Потреба.Итог("Сумма");
	Возврат Итог;

КонецФункции

// Загальні назви из строк Комплектующие активных СС подразделения: СокрЛП-имя → Структура(Ссылка, Единица, Сумма).
// Ключ совпадает с ключом группы отчёта «План-факт» (КлючГруппыПланНаФакт).
//
// Параметры:
//   Подразделение - СправочникСсылка.СтруктураПредприятия
//
// Возвращаемое значение:
//   Соответствие
//
Функция ОбщиеНазванияПроектаПоИмени(Подразделение) Экспорт

	Возврат ОбщиеНазванияПроекта(Подразделение).ПоИмени;

КонецФункции

// Части складеної назви «A / B» (СокрЛП, без пустых).
//
// Параметры:
//   НазваниеСС - Строка
//
// Возвращаемое значение:
//   Массив из Строка
//
Функция ЧастиСкладеногоНазвания(НазваниеСС) Экспорт

	Части = Новый Массив;
	Для Каждого Часть Из СтрРазделить(НазваниеСС, "/", Ложь) Цикл
		Если СокрЛП(Часть) <> "" Тогда
			Части.Добавить(СокрЛП(Часть));
		КонецЕсли;
	КонецЦикла;
	Возврат Части;

КонецФункции

// Нормализация текста для сопоставления: пробелы, апострофы, регистр, латинская i → українська і.
//
// Параметры:
//   Текст - Строка
//
// Возвращаемое значение:
//   Строка
//
Функция НормализоватьТекст(Знач Текст) Экспорт

	Текст = СтрЗаменить(Строка(Текст), Символы.НПП, " ");
	Для Каждого Апостроф Из СтрРазделить("’|ʼ|‘|´|`", "|") Цикл
		Текст = СтрЗаменить(Текст, Апостроф, "'");
	КонецЦикла;
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Текст = НРег(СокрЛП(Текст));
	Возврат СтрЗаменить(Текст, "i", "і");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЧтениеФайла

Функция ЛистыТабличногоДокумента(ТабДок)

	Листы = Новый Массив;
	Для Каждого Область Из ТабДок.Области Цикл
		Если Область.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки Тогда
			Листы.Добавить(Новый Структура("Имя, Верх, Низ", Область.Имя, Область.Верх, Область.Низ));
		КонецЕсли;
	КонецЦикла;
	Если Листы.Количество() = 0 Тогда
		Листы.Добавить(Новый Структура("Имя, Верх, Низ", "", 1, ТабДок.ВысотаТаблицы));
	КонецЕсли;
	Возврат Листы;

КонецФункции

Процедура РазобратьЛист(ТабДок, Лист, ИмяФайла, Разделы)

	Ширина = Мин(30, ТабДок.ШиринаТаблицы);
	Маркеры = Новый Массив;
	Для НомерСтроки = Лист.Верх По Лист.Низ Цикл
		ТекстМаркера = ТекстМаркераРаздела(ТабДок, НомерСтроки, Ширина);
		Если ТекстМаркера <> Неопределено Тогда
			Маркеры.Добавить(Новый Структура("Строка, Имя", НомерСтроки, ТекстМаркера));
		КонецЕсли;
	КонецЦикла;

	Если Маркеры.Количество() = 0 Тогда
		РазобратьРаздел(ТабДок, Лист.Имя, Лист.Имя, Лист.Верх, Мин(Лист.Верх + 19, Лист.Низ), Лист.Низ, Ширина, ИмяФайла, Разделы);
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По Маркеры.ВГраница() Цикл
		Начало = Маркеры[Индекс].Строка + 1;
		Конец = ?(Индекс < Маркеры.ВГраница(), Маркеры[Индекс + 1].Строка - 1, Лист.Низ);
		РазобратьРаздел(ТабДок, Маркеры[Индекс].Имя, Лист.Имя, Начало, Мин(Начало + 2, Конец), Конец, Ширина, ИмяФайла, Разделы);
	КонецЦикла;

КонецПроцедуры

Процедура РазобратьРаздел(ТабДок, ИмяРаздела, ИмяЛиста, Начало, КонецПоискаШапки, Конец, Ширина, ИмяФайла, Разделы)

	Колонки = Неопределено;
	СтрокаШапки = 0;
	Для НомерСтроки = Начало По КонецПоискаШапки Цикл
		Колонки = РаспознатьШапку(ТабДок, НомерСтроки, Ширина);
		Если Колонки <> Неопределено Тогда
			СтрокаШапки = НомерСтроки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Колонки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Раздел = НовыйРаздел(ИмяРаздела, ИмяЛиста, ИмяФайла);
	Раздел.ЦеныБезНДС = Колонки.ЦеныБезНДС;
	ПустыхПодряд = 0;
	Для НомерСтроки = СтрокаШапки + 1 По Конец Цикл
		Если СтрокаПустая(ТабДок, НомерСтроки, Ширина) Тогда
			ПустыхПодряд = ПустыхПодряд + 1;
			Если ПустыхПодряд >= 3 Тогда
				Прервать;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ПустыхПодряд = 0;

		НазваТовара = ТекстЯчейки(ТабДок, НомерСтроки, Колонки.НазваТовару);
		НазваСС = ТекстЯчейки(ТабДок, НомерСтроки, Колонки.НазваСС);
		Стоимость = ЧислоЯчейки(ТабДок, НомерСтроки, Колонки.Стоимость);
		Если ЭтоИтоговаяСтрока(ТабДок, НомерСтроки, Ширина, НазваТовара, НазваСС, Стоимость) Тогда
			Раздел.СуммаИтога = Стоимость;
			Прервать;
		КонецЕсли;

		КолФайла = ЧислоЯчейки(ТабДок, НомерСтроки, Колонки.КолФайла);
		ЦенаФайла = ЧислоЯчейки(ТабДок, НомерСтроки, Колонки.ЦенаФайла);
		ОбъемСС = ЧислоЯчейки(ТабДок, НомерСтроки, Колонки.ОбъемСС);
		Если НормализоватьТекст(НазваТовара) = "" И НормализоватьТекст(НазваСС) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Стоимость = Неопределено И КолФайла = Неопределено И ЦенаФайла = Неопределено И ОбъемСС = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Раздел.Строки.Добавить(СтрокаДанных(ТабДок, НомерСтроки, Колонки, НазваТовара, НазваСС, Стоимость, КолФайла, ЦенаФайла, ОбъемСС));
	КонецЦикла;

	Если Раздел.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаРаздела Из Раздел.Строки Цикл
		Раздел.Сумма = Раздел.Сумма + СтрокаРаздела.Сумма;
	КонецЦикла;
	Если Раздел.СуммаИтога <> Неопределено Тогда
		Допуск = 0.01 * Раздел.Строки.Количество();
		Если Макс(Раздел.Сумма - Окр(Раздел.СуммаИтога, 2), Окр(Раздел.СуммаИтога, 2) - Раздел.Сумма) > Допуск Тогда
			Раздел.Ошибка = СтрШаблон(НСтр("ru = 'Розділ «%1»: сума рядків %2 ≠ підсумку %3. Перевірте діапазон формули підсумку у файлі.';
				|uk = 'Розділ «%1»: сума рядків %2 ≠ підсумку %3. Перевірте діапазон формули підсумку у файлі.'"),
				ИмяРаздела, Формат(Раздел.Сумма, "ЧДЦ=2; ЧРГ=' '"), Формат(Раздел.СуммаИтога, "ЧДЦ=2; ЧРГ=' '"));
		КонецЕсли;
	КонецЕсли;
	Разделы.Добавить(Раздел);

КонецПроцедуры

Функция НовыйРаздел(ИмяРаздела, ИмяЛиста, ИмяФайла)

	Раздел = Новый Структура;
	Раздел.Вставить("Имя", ИмяРаздела);
	Раздел.Вставить("Лист", ИмяЛиста);
	Раздел.Вставить("ИмяФайла", ИмяФайла);
	Раздел.Вставить("Строки", Новый Массив);
	Раздел.Вставить("Сумма", 0);
	Раздел.Вставить("СуммаИтога", Неопределено);
	Раздел.Вставить("ЦеныБезНДС", Ложь);
	Раздел.Вставить("Ошибка", "");
	Возврат Раздел;

КонецФункции

Функция СтрокаДанных(ТабДок, НомерСтроки, Колонки, НазваТовара, НазваСС, Стоимость, КолФайла, ЦенаФайла, ОбъемСС)

	Замечания = Новый Массив;
	Если Стоимость <> Неопределено Тогда
		Сумма = Окр(Стоимость, 2);
	ИначеЕсли КолФайла <> Неопределено И ЦенаФайла <> Неопределено Тогда
		Сумма = Окр(КолФайла * ЦенаФайла, 2);
	Иначе
		Сумма = 0;
	КонецЕсли;
	Если Стоимость <> Неопределено И КолФайла <> Неопределено И ЦенаФайла <> Неопределено
		И Макс(Стоимость - КолФайла * ЦенаФайла, КолФайла * ЦенаФайла - Стоимость) > 0.01 Тогда
		Замечания.Добавить(НСтр("ru = 'Вартість ≠ К-сть × Ціна'; uk = 'Вартість ≠ К-сть × Ціна'"));
	КонецЕсли;

	Если ЦенаФайла <> Неопределено Тогда
		Цена = Окр(ЦенаФайла, 2);
	ИначеЕсли КолФайла <> Неопределено И КолФайла <> 0 Тогда
		Цена = Окр(Сумма / КолФайла, 2);
	Иначе
		Цена = 0;
	КонецЕсли;

	ЕдиницаСС = ТекстЯчейки(ТабДок, НомерСтроки, Колонки.ОдСС);
	ЕдиницаФайла = ТекстЯчейки(ТабДок, НомерСтроки, Колонки.Од);
	Если ОбъемСС <> Неопределено И ОбъемСС > 0 Тогда
		КоличествоСС = Окр(ОбъемСС, 3);
	ИначеЕсли КолФайла <> Неопределено И НормализоватьТекст(ЕдиницаСС) = НормализоватьТекст(ЕдиницаФайла) Тогда
		КоличествоСС = Окр(КолФайла, 3);
	Иначе
		КоличествоСС = 0;
		Замечания.Добавить(НСтр("ru = 'Не визначено кількість в од. СС'; uk = 'Не визначено кількість в од. СС'"));
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("НомерСтрокиФайла", НомерСтрокиФайла(ТабДок, НомерСтроки));
	Результат.Вставить("НазваниеТовара", Лев(СокрЛП(НазваТовара), 250));
	Результат.Вставить("НазваниеСС", Лев(СокрЛП(НазваСС), 150));
	Результат.Вставить("КолФайла", ?(КолФайла = Неопределено, 0, Окр(КолФайла, 3)));
	Результат.Вставить("Единица", Лев(СокрЛП(ЕдиницаФайла), 25));
	Результат.Вставить("ЕдиницаСС", СокрЛП(ЕдиницаСС));
	Результат.Вставить("КоличествоСС", КоличествоСС);
	Результат.Вставить("Цена", Цена);
	Результат.Вставить("Сумма", Сумма);
	Результат.Вставить("Дома", НормализоватьДома(ТекстЯчейки(ТабДок, НомерСтроки, Колонки.Дома)));
	Результат.Вставить("Предупреждение", СтрСоединить(Замечания, "; "));
	Возврат Результат;

КонецФункции

// Номер строки исходного листа Excel (строки листов в табличном документе идут подряд).
Функция НомерСтрокиФайла(ТабДок, НомерСтроки)

	Для Каждого Область Из ТабДок.Области Цикл
		Если Область.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки
			И НомерСтроки >= Область.Верх И НомерСтроки <= Область.Низ Тогда
			Возврат НомерСтроки - Область.Верх + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат НомерСтроки;

КонецФункции

Функция ТекстМаркераРаздела(ТабДок, НомерСтроки, Ширина)

	Найдено = Неопределено;
	Для НомерКолонки = 1 По Ширина Цикл
		Текст = СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
		Если Текст = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Найдено <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Найдено = Текст;
	КонецЦикла;
	Если Найдено <> Неопределено И СтрНачинаетсяС(НормализоватьЗаголовок(Найдено), "проект") Тогда
		Возврат Найдено;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция РаспознатьШапку(ТабДок, НомерСтроки, Ширина)

	Колонки = Новый Структура("НазваТовару, НазваСС, ОдСС, ОбъемСС, Од, КолФайла, Дома, ЦенаФайла, Стоимость, ЦеныБезНДС",
		0, 0, 0, 0, 0, 0, 0, 0, 0, Ложь);
	КолонкиОд = Новый Массив;
	Распознано = 0;
	Для НомерКолонки = 1 По Ширина Цикл
		Заголовок = НормализоватьЗаголовок(ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
		Поле = ПолеЗаголовка(Заголовок);
		Если Поле = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Поле = "Од" Тогда
			КолонкиОд.Добавить(НомерКолонки);
			Продолжить;
		КонецЕсли;
		Если Колонки[Поле] = 0 Тогда
			Колонки[Поле] = НомерКолонки;
			Распознано = Распознано + 1;
		КонецЕсли;
		Если (Поле = "ЦенаФайла" Или Поле = "Стоимость") И СтрНайти(Заголовок, "без пдв") > 0 Тогда
			Колонки.ЦеныБезНДС = Истина;
		КонецЕсли;
	КонецЦикла;
	Если КолонкиОд.Количество() > 0 Тогда
		Колонки.Од = КолонкиОд[0];
		Для Каждого НомерКолонки Из КолонкиОд Цикл
			Если Колонки.КолФайла > 0 И НомерКолонки < Колонки.КолФайла Тогда
				Колонки.Од = НомерКолонки;
			КонецЕсли;
		КонецЦикла;
		Распознано = Распознано + 1;
	КонецЕсли;

	Достаточно = (Колонки.НазваСС > 0 Или Колонки.НазваТовару > 0)
		И (Колонки.ОбъемСС > 0 Или Колонки.КолФайла > 0)
		И (Колонки.Стоимость > 0 Или Колонки.ЦенаФайла > 0);
	Возврат ?(Достаточно И Распознано >= 4, Колонки, Неопределено);

КонецФункции

Функция ПолеЗаголовка(Заголовок)

	Если Заголовок = "" Тогда
		Возврат "";
	КонецЕсли;
	Слова = СтрРазделить(Заголовок, " ", Ложь);
	ПоСС = Слова.Найти("сс") <> Неопределено;
	Если СтрНайти(Заголовок, "вірна назва") > 0 Или СтрНайти(Заголовок, "загальна назва") > 0
		Или СтрНайти(Заголовок, "назва згідно сс") > 0 Или СтрНайти(Заголовок, "назва сс") > 0 Тогда
		Возврат "НазваСС";
	КонецЕсли;
	Если СтрНайти(Заголовок, "назва товару") > 0 Или СтрНайти(Заголовок, "найменування") > 0 Или Заголовок = "товар" Тогда
		Возврат "НазваТовару";
	КонецЕсли;
	Если ПоСС И (СтрНайти(Заголовок, "обєм") > 0 Или СтрНайти(Заголовок, "обсяг") > 0
		Или СтрНайти(Заголовок, "кількість") > 0 Или СтрНайти(Заголовок, "ксть") > 0) Тогда
		Возврат "ОбъемСС";
	КонецЕсли;
	Если ПоСС И (Слова.Найти("од") <> Неопределено Или СтрНачинаетсяС(Заголовок, "од ") Или СтрНайти(Заголовок, "одиниц") > 0) Тогда
		Возврат "ОдСС";
	КонецЕсли;
	Если Не ПоСС И (СтрНайти(Заголовок, "одиниц") > 0 Или СтрНайти(Заголовок, "од вим") > 0) Тогда
		Возврат "Од";
	КонецЕсли;
	Если Не ПоСС И (СтрНайти(Заголовок, "ксть") > 0 Или СтрНайти(Заголовок, "кількість") > 0
		Или СтрНайти(Заголовок, "кть") > 0 Или СтрНайти(Заголовок, "колво") > 0) Тогда
		Возврат "КолФайла";
	КонецЕсли;
	Если СтрНайти(Заголовок, "будин") > 0 Или СтрНайти(Заголовок, "дім") > 0 Тогда
		Возврат "Дома";
	КонецЕсли;
	Если СтрНайти(Заголовок, "ціна") > 0 Тогда
		Возврат "ЦенаФайла";
	КонецЕсли;
	Если СтрНайти(Заголовок, "вартість") > 0 Или СтрНайти(Заголовок, "сума") > 0 Тогда
		Возврат "Стоимость";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ЭтоИтоговаяСтрока(ТабДок, НомерСтроки, Ширина, НазваТовара, НазваСС, Стоимость)

	Если НормализоватьТекст(НазваТовара) = "" И НормализоватьТекст(НазваСС) = "" И Стоимость <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для НомерКолонки = 1 По Ширина Цикл
		Текст = НормализоватьТекст(ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст);
		Если Текст = "" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Слово Из СтрРазделить("разом|итого|всього|усього", "|") Цикл
			Если СтрНайти(Текст, Слово) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция СтрокаПустая(ТабДок, НомерСтроки, Ширина)

	Для НомерКолонки = 1 По Ширина Цикл
		Если СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст) <> "" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
