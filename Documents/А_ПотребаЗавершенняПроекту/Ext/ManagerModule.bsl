Функция ТекстЯчейки(ТабДок, НомерСтроки, НомерКолонки)

	Если НомерКолонки = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки).Текст;

КонецФункции

// Число из ячейки: значение, если ячейка числовая, иначе разбор текста; Неопределено — не число.
Функция ЧислоЯчейки(ТабДок, НомерСтроки, НомерКолонки)

	Если НомерКолонки = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ячейка = ТабДок.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
	Если Ячейка.СодержитЗначение И ТипЗнч(Ячейка.Значение) = Тип("Число") Тогда
		Возврат Ячейка.Значение;
	КонецЕсли;
	Текст = СтрЗаменить(СтрЗаменить(Ячейка.Текст, Символы.НПП, ""), " ", "");
	Текст = СтрЗаменить(Текст, ",", ".");
	Если Текст = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат Неопределено; // в ячейке текст, а не число
	КонецПопытки;

КонецФункции

Функция НормализоватьЗаголовок(Текст)

	Возврат СтрЗаменить(СтрЗаменить(НормализоватьТекст(Текст), "'", ""), "-", "");

КонецФункции

// «6,7» / «6.7» / «5, 6; 7» → «6,7» / «5,6,7».
Функция НормализоватьДома(Текст)

	Результат = СокрЛП(Текст);
	Для Каждого Разделитель Из СтрРазделить(".|;| |" + Символы.НПП, "|") Цикл
		Результат = СтрЗаменить(Результат, Разделитель, ",");
	КонецЦикла;
	Пока СтрНайти(Результат, ",,") > 0 Цикл
		Результат = СтрЗаменить(Результат, ",,", ",");
	КонецЦикла;
	Пока СтрНачинаетсяС(Результат, ",") Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Пока СтрЗаканчиваетсяНа(Результат, ",") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Лев(Результат, 50);

