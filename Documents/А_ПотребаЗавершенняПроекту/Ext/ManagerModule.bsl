#КонецОбласти

#Область СопоставлениеОбщихНазваний

// Загальні назви из строк Комплектующие активных СС подразделения.
// Ключи: СокрЛП-имя и нормализованное имя → Структура(Ссылка, Единица, Сумма).
Функция ОбщиеНазванияПроекта(Подразделение)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Комп.ОбщееНазвание КАК ОбщееНазвание,
	|	Комп.ОбщееНазвание.Наименование КАК Наименование,
	|	Комп.ЕдиницаОбщееНазвание КАК Единица,
	|	СУММА(Комп.Сумма) КАК Сумма
	|ИЗ
	|	Справочник.А_СтруктураСебестоимости.Комплектующие КАК Комп
	|ГДЕ
	|	Комп.Ссылка.Подразделение = &Подразделение
	|	И Комп.Ссылка.Активная
	|	И НЕ Комп.Ссылка.ЭтоГруппа
	|	И НЕ Комп.Ссылка.ПометкаУдаления
	|	И Комп.ОбщееНазвание <> ЗНАЧЕНИЕ(Справочник.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Комп.ОбщееНазвание,
	|	Комп.ОбщееНазвание.Наименование,
	|	Комп.ЕдиницаОбщееНазвание
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сумма УБЫВ";
	Запрос.УстановитьПараметр("Подразделение", Подразделение);

	ПоИмени = Новый Соответствие;
	ПоНорме = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = Новый Структура("Ссылка, Единица, Сумма", Выборка.ОбщееНазвание, Выборка.Единица, Выборка.Сумма);
		Имя = СокрЛП(Выборка.Наименование);
		Если ПоИмени[Имя] = Неопределено Тогда
			ПоИмени.Вставить(Имя, Значение);
		КонецЕсли;
		Норма = НормализоватьТекст(Имя);
		Если ПоНорме[Норма] = Неопределено Тогда
			ПоНорме.Вставить(Норма, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("ПоИмени, ПоНорме", ПоИмени, ПоНорме);

КонецФункции

// Непомеченные загальні назви справочника. При дублях имени — карточка с единицей, затем с номенклатурой, затем с меньшим кодом.
Функция ОбщиеНазванияСправочника()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СпрОН.Ссылка КАК Ссылка,
	|	СпрОН.Наименование КАК Наименование,
	|	СпрОН.Единица КАК Единица,
	|	ВЫБОР
	|		КОГДА СпрОН.Единица <> ЗНАЧЕНИЕ(Справочник.УпаковкиЕдиницыИзмерения.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПорядокЕдиница,
	|	ВЫБОР
	|		КОГДА СпрОН.ОсновнаяНоменклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК ПорядокНоменклатура,
	|	СпрОН.Код КАК Код
	|ИЗ
	|	Справочник.А_ОбщиеНазванияНоменклатуры КАК СпрОН
	|ГДЕ
	|	НЕ СпрОН.ПометкаУдаления
	|	И НЕ СпрОН.ЭтоГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокЕдиница,
	|	ПорядокНоменклатура,
	|	Код";

	ПоИмени = Новый Соответствие;
	ПоНорме = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Значение = Новый Структура("Ссылка, Единица, Сумма", Выборка.Ссылка, Выборка.Единица, 0);
		Имя = СокрЛП(Выборка.Наименование);
		Если ПоИмени[Имя] = Неопределено Тогда
			ПоИмени.Вставить(Имя, Значение);
		КонецЕсли;
		Норма = НормализоватьТекст(Имя);
		Если ПоНорме[Норма] = Неопределено Тогда
			ПоНорме.Вставить(Норма, Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("ПоИмени, ПоНорме", ПоИмени, ПоНорме);

КонецФункции

Функция НайтиОбщееНазвание(НазваниеСС, ОНПроекта, ОНСправочника)

	Результат = Новый Структура("Ссылка, Единица, Замечание",
		Справочники.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка(), Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(), "");
	Имя = СокрЛП(НазваниеСС);
	Если Имя = "" Тогда
		Результат.Замечание = НСтр("ru = 'Немає назви згідно СС — у звіті поза СС'; uk = 'Немає назви згідно СС — у звіті поза СС'");
		Возврат Результат;
	КонецЕсли;
	Норма = НормализоватьТекст(Имя);

	Найдено = ОНПроекта.ПоИмени[Имя];
	Если Найдено = Неопределено Тогда
		Найдено = ОНПроекта.ПоНорме[Норма];
	КонецЕсли;
	Если Найдено <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, Найдено, "Ссылка, Единица");
		Возврат Результат;
	КонецЕсли;

	Найдено = ОНСправочника.ПоИмени[Имя];
	Если Найдено = Неопределено Тогда
		Найдено = ОНСправочника.ПоНорме[Норма];
	КонецЕсли;
	Если Найдено <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, Найдено, "Ссылка, Единица");
		Результат.Замечание = НСтр("ru = 'Є в довіднику, але немає в СС проєкту'; uk = 'Є в довіднику, але немає в СС проєкту'");
		Возврат Результат;
	КонецЕсли;

	Если СтрНачинаетсяС(Норма, "монтаж") Тогда
		Результат.Замечание = НСтр("ru = 'Робота, не матеріал: у плані матеріалів СС бюджету немає (він у роботах СС), закупівлею не списується'; uk = 'Робота, не матеріал: у плані матеріалів СС бюджету немає (він у роботах СС), закупівлею не списується'");
	Иначе
		Результат.Замечание = НСтр("ru = 'Не знайдено в довіднику — у звіті поза СС'; uk = 'Не знайдено в довіднику — у звіті поза СС'");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// «Вікно металопластикове / Двері металопластикові»: строка относится к части с наибольшим планом в СС проекта,
// остальные части отчёт считает покрытыми этой строкой (не «Не докуповуємо»).
Функция НайтиСкладеноеНазвание(НазваниеСС, ОНПроекта)

	Результат = Новый Структура("Ссылка, Единица, Замечание",
		Справочники.А_ОбщиеНазванияНоменклатуры.ПустаяСсылка(), Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка(), "");
	Лучшее = Неопределено;
	ИменаЧастей = Новый Массив;
	Для Каждого Часть Из ЧастиСкладеногоНазвания(НазваниеСС) Цикл
		Найдено = ОНПроекта.ПоИмени[Часть];
		Если Найдено = Неопределено Тогда
			Найдено = ОНПроекта.ПоНорме[НормализоватьТекст(Часть)];
		КонецЕсли;
		Если Найдено = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИменаЧастей.Добавить(Часть);
		Если Лучшее = Неопределено Или Найдено.Сумма > Лучшее.Сумма Тогда
			Лучшее = Найдено;
		КонецЕсли;
	КонецЦикла;
	Если Лучшее = Неопределено Тогда
		Результат.Замечание = НСтр("ru = 'Складена назва — частин немає в СС проєкту, оберіть загальну назву вручну'; uk = 'Складена назва — частин немає в СС проєкту, оберіть загальну назву вручну'");
		Возврат Результат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Результат, Лучшее, "Ссылка, Единица");
	Результат.Замечание = СтрШаблон(НСтр("ru = 'Складена назва: віднесено до «%1», покриває також: %2'; uk = 'Складена назва: віднесено до «%1», покриває також: %2'"),
		СокрЛП(Строка(Лучшее.Ссылка)), СтрСоединить(ИменаЧастей, ", "));
	Возврат Результат;

КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
