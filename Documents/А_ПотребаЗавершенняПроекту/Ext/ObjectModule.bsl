#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Ответственный = Пользователи.ТекущийПользователь();

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Ответственный = Пользователи.ТекущийПользователь();
	ИмяФайла = "";
	РазделФайла = "";

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	СуммаДокумента = Потреба.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(Подразделение)
		И Документы.А_ПотребаЗавершенняПроекту.ПодразделенияАктивныхСС().Найти(Подразделение) = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru = 'Підрозділ не має активної структури собівартості — звіт «Прогноз виконання СС за потребою» його не покаже.';
				|uk = 'Підрозділ не має активної структури собівартості — звіт «Прогноз виконання СС за потребою» його не покаже.'"),
			ЭтотОбъект, "Подразделение", "Объект", Отказ);
	КонецЕсли;

	Для Каждого СтрокаПотребы Из Потреба Цикл
		Префикс = "Потреба[" + Формат(СтрокаПотребы.НомерСтроки - 1, "ЧН=0; ЧГ=0") + "].";
		Если Не ЗначениеЗаполнено(СтрокаПотребы.ОбщееНазвание) И Не ЗначениеЗаполнено(СтрокаПотребы.НазваниеСС) Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Рядок %1: заповніть загальну назву або назву згідно СС.'; uk = 'Рядок %1: заповніть загальну назву або назву згідно СС.'"),
					СтрокаПотребы.НомерСтроки),
				ЭтотОбъект, Префикс + "НазваниеСС", "Объект", Отказ);
		КонецЕсли;
		Если СтрокаПотребы.Сумма < 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Рядок %1: сума не може бути від''ємною.'; uk = 'Рядок %1: сума не може бути від''ємною.'"),
					СтрокаПотребы.НомерСтроки),
				ЭтотОбъект, Префикс + "Сумма", "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
