#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Проверяет обязательные реквизиты шапки (метаданные реквизитов оставлены DontCheck,
// поэтому проверка выполняется здесь — паттерн типовых документов BAS ERP).
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не заполнена организация.", , "Организация", , Отказ);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(А_ДокументОснование) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Не заполнен документ-основание.", , "А_ДокументОснование", , Отказ);
	КонецЕсли;

КонецПроцедуры

// Заполняет служебные поля строк (устойчивость при перепроведении и корректный период
// взаиморасчётов). ОбменДанными.Загрузка — обязательный guard (house style): при загрузке
// обмена строки приходят готовыми, повторное заполнение не требуется.
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	_ПНМП_ЗаполнитьСлужебныеПоляСтрок();

КонецПроцедуры

// Пишет движения в РегистрНакопления.ПрочиеАктивыПассивы (3 статьи обязательств) и
// РегистрНакопления.А_ВзаиморасчетыССотрудниками (только Оплата труда, разрез ФизическоеЛицо).
//
// Принцип «реверс на исходном / копия на целевом»: для пассивной статьи начисление ОЗФУ —
// Расход, поэтому на ИсходномПодразделении пишем Приход (гасим обязательство там, где его
// больше не платят), на ЦелевомПодразделении — Расход (ставим там, где касса юр.лица платит).
// Каждая строка net-zero по организации; Σ КО не меняется, баланс сдвигается между подр.
//
// Источник/ВидИсточника = ПустаяСсылка (как у ОЗФУ для Оплата труда/Налоги/Прочие пассивы).
// Для статьи «Налоги» Аналитика = ТипНалога (Перечисление.ТипыНалогов), для остальных — пусто.
Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	СтОТ      = ПланыВидовХарактеристик.СтатьиАктивовПассивов.НайтиПоНаименованию("Оплата труда");
	СтНалоги  = ПланыВидовХарактеристик.СтатьиАктивовПассивов.НайтиПоНаименованию("Налоги");
	СтПрочПас = ПланыВидовХарактеристик.СтатьиАктивовПассивов.НайтиПоНаименованию("Прочие пассивы");
	Если НЕ ЗначениеЗаполнено(СтОТ) ИЛИ НЕ ЗначениеЗаполнено(СтНалоги) ИЛИ НЕ ЗначениеЗаполнено(СтПрочПас) Тогда
		Отказ = Истина;
		Сообщить("ПНМП: не найдены статьи активов/пассивов (Оплата труда / Налоги / Прочие пассивы).");
		Возврат;
	КонецЕсли;

	Движения.ПрочиеАктивыПассивы.Записывать = Истина;
	Движения.ПрочиеАктивыПассивы.Очистить();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("СтОТ", СтОТ);
	Запрос.УстановитьПараметр("СтНалоги", СтНалоги);
	Запрос.УстановитьПараметр("СтПрочПас", СтПрочПас);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&СтОТ КАК Статья,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка) КАК ТипНалога,
	|	Н.ИсходноеПодразделение КАК Исходное,
	|	Н.ЦелевоеПодразделение КАК Целевое,
	|	СУММА(Н.Сумма) КАК Сумма
	|ИЗ
	|	Документ.А_ПередачаНачисленийМеждуПодразделениями.Начисления КАК Н
	|ГДЕ
	|	Н.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	Н.ИсходноеПодразделение, Н.ЦелевоеПодразделение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&СтНалоги,
	|	Нл.ТипНалога,
	|	Нл.ИсходноеПодразделение,
	|	Нл.ЦелевоеПодразделение,
	|	СУММА(Нл.Сумма)
	|ИЗ
	|	Документ.А_ПередачаНачисленийМеждуПодразделениями.Налоги КАК Нл
	|ГДЕ
	|	Нл.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	Нл.ТипНалога, Нл.ИсходноеПодразделение, Нл.ЦелевоеПодразделение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&СтПрочПас,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка),
	|	У.ИсходноеПодразделение,
	|	У.ЦелевоеПодразделение,
	|	СУММА(У.Сумма)
	|ИЗ
	|	Документ.А_ПередачаНачисленийМеждуПодразделениями.Удержания КАК У
	|ГДЕ
	|	У.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	У.ИсходноеПодразделение, У.ЦелевоеПодразделение";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Сумма = 0 ИЛИ НЕ ЗначениеЗаполнено(Выборка.Исходное) ИЛИ НЕ ЗначениеЗаполнено(Выборка.Целевое) Тогда
			Продолжить;
		КонецЕсли;
		Сум = ?(Выборка.Сумма > 0, Выборка.Сумма, -Выборка.Сумма);
		// Пассивная статья: реверс на исходном (Приход) / копия на целевом (Расход) для положит. суммы
		Если Выборка.Сумма > 0 Тогда
			ВидДвИсх = ВидДвиженияНакопления.Приход;
			ВидДвЦел = ВидДвиженияНакопления.Расход;
		Иначе
			ВидДвИсх = ВидДвиженияНакопления.Расход;
			ВидДвЦел = ВидДвиженияНакопления.Приход;
		КонецЕсли;
		_ПАП_ДобавитьДвижение(Выборка.Статья, Выборка.ТипНалога, Выборка.Исходное, ВидДвИсх, Сум);
		_ПАП_ДобавитьДвижение(Выборка.Статья, Выборка.ТипНалога, Выборка.Целевое, ВидДвЦел, Сум);
	КонецЦикла;

	// Движения А_ВзаиморасчетыССотрудниками (инверсно ПАП(Оплата труда), разрез ФизическоеЛицо)
	РегистрыНакопления.А_ВзаиморасчетыССотрудниками.ЗаполнитьИзПередачиНачислений(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Добавляет одну запись движения ПрочиеАктивыПассивы. Аналитика заполняется только если
// передан непустой ТипНалога (для статьи «Налоги»); иначе остаётся пустой (ОТ / Прочие пассивы).
Процедура _ПАП_ДобавитьДвижение(Статья, ТипНалога, Подразделение, ВидДв, Сумма)

	Запись = Движения.ПрочиеАктивыПассивы.Добавить();
	Запись.Период        = Дата;
	Запись.ВидДвижения   = ВидДв;
	Запись.Организация   = Организация;
	Запись.Подразделение = Подразделение;
	Запись.Статья        = Статья;
	Если ЗначениеЗаполнено(ТипНалога) Тогда
		Запись.Аналитика = ТипНалога;
	КонецЕсли;
	Запись.Источник      = Перечисления.ИсточникиУправленческогоБаланса.ПустаяСсылка();
	Запись.ВидИсточника  = Перечисления.ВидыИсточниковДвижений.ПустаяСсылка();
	Запись.Сумма         = Сумма;

КонецПроцедуры

// Заполняет ИдентификаторСтроки и ПериодВзаиморасчетов во всех трёх табличных частях.
Процедура _ПНМП_ЗаполнитьСлужебныеПоляСтрок()

	ПериодВР = НачалоМесяца(Дата);
	_ПНМП_ЗаполнитьСлужебныеПоляТЧ(Начисления, ПериодВР);
	_ПНМП_ЗаполнитьСлужебныеПоляТЧ(Налоги, ПериодВР);
	_ПНМП_ЗаполнитьСлужебныеПоляТЧ(Удержания, ПериодВР);

КонецПроцедуры

// Заполняет служебные поля одной табличной части: ИдентификаторСтроки (если пусто) — для
// устойчивого сопоставления строк при перепроведении; ПериодВзаиморасчетов (если пусто).
Процедура _ПНМП_ЗаполнитьСлужебныеПоляТЧ(ТабЧасть, ПериодВР)

	Для Каждого СтрокаТЧ Из ТабЧасть Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ИдентификаторСтроки) Тогда
			СтрокаТЧ.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.ПериодВзаиморасчетов) Тогда
			СтрокаТЧ.ПериодВзаиморасчетов = ПериодВР;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
