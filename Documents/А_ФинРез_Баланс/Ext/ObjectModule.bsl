#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем мТЗСвод;

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Месяц) Тогда
		Месяц = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	НачМесяца = НачалоМесяца(Месяц);
	КонМесяца = КонецМесяца(Месяц);

	ЗапросДубль = Новый Запрос;
	ЗапросДубль.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 ФР.Номер КАК Номер, ФР.Дата КАК Дата
	|ИЗ Документ.А_ФинРез_Баланс КАК ФР
	|ГДЕ ФР.Ссылка <> &ТекущийДок И НЕ ФР.ПометкаУдаления И ФР.Проведен
	|	И ФР.Организация = &Организация
	|	И ФР.Месяц МЕЖДУ &НачМесяца И &КонМесяца
	|	И ФР.ВключатьДочерние = &ВключатьДочерние";
	ЗапросДубль.УстановитьПараметр("ТекущийДок",       Ссылка);
	ЗапросДубль.УстановитьПараметр("Организация",      Организация);
	ЗапросДубль.УстановитьПараметр("НачМесяца",        НачМесяца);
	ЗапросДубль.УстановитьПараметр("КонМесяца",        КонМесяца);
	ЗапросДубль.УстановитьПараметр("ВключатьДочерние", ВключатьДочерние);
	РезДубль = ЗапросДубль.Выполнить();
	Если НЕ РезДубль.Пустой() Тогда
		ВыбДубль = РезДубль.Выбрать(); ВыбДубль.Следующий();
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не можна провести: за %1 (Організація %2) вже проведено документ %3 від %4.",
				Формат(НачМесяца, "ДФ='ММММ yyyy'"), Организация, ВыбДубль.Номер,
				Формат(ВыбДубль.Дата, "ДФ='dd.MM.yyyy'")));
		Отказ = Истина; Возврат;
	КонецЕсли;

	СтруктураШапки = Новый Структура;
	СтруктураШапки.Вставить("Ссылка",           Ссылка);
	СтруктураШапки.Вставить("Дата",             Дата);
	СтруктураШапки.Вставить("НачМес",           НачМесяца);
	СтруктураШапки.Вставить("КонМес",           КонецДня(КонМесяца));
	СтруктураШапки.Вставить("Организация",      Организация);
	СтруктураШапки.Вставить("ВключатьДочерние", ВключатьДочерние);
	ПровестиБалансСвод(СтруктураШапки, Отказ);
КонецПроцедуры

#КонецОбласти

#Область Оркестратор

// Модульная свёртка (канон v2): суммы из ОСНОВНОЙ таблицы ПрочиеАктивыПассивы
// per Источник (Перечисление.ИсточникиУправленческогоБаланса). СверкаСПАП
// приводит Σ по (Орг,Подр,Статья) к ПАП.ОстаткиИОбороты до копейки
// (пропорц. обрезка / добивка пустой аналитики, флаг Расхождение).
// Типовые регистры — ТОЛЬКО ЧТЕНИЕ.
Процедура ПровестиБалансСвод(СтруктураШапки, Отказ) Экспорт
	Движения.А_ОтчетБаланс_Свод.Записывать = Истина;
	мТЗСвод = Движения.А_ОтчетБаланс_Свод.Выгрузить();
	мТЗСвод.Очистить();

	Свод_РасчетыСПартнерами(СтруктураШапки, Отказ);
	Свод_СебестоимостьТоваров(СтруктураШапки, Отказ);
	Свод_ДенежныеСредства(СтруктураШапки, Отказ);
	Свод_ПрочиеРасходыДоходы(СтруктураШапки, Отказ);
	Свод_ПрочиеАктивыПассивы_Прямой(СтруктураШапки, Отказ);
	Свод_ОплатаТруда(СтруктураШапки, Отказ);

	//СверкаСПАП(СтруктураШапки);

	// Документ свода в ключ РС: А_ОтчетБаланс_Свод имеет глобальную
	// уникальность по измерениям (Регистратор НЕ в ключе) — без дискриминатора
	// 2-й проведённый А_ФинРез_Баланс конфликтует с 1-м по строкам-плугам
	// (org-уровень, одинаковы каждый месяц). ДокументДвижения (составной
	// DocumentRef, уже в списке Свернуть, ETL Fact_Balance его не читает)
	// заполняем ссылкой документа → строки уникальны между документами.
	мТЗСвод.ЗаполнитьЗначения(СтруктураШапки.Ссылка, "ДокументДвижения");

	// ТипПоказателя — производная от Статья по формуле штатного
	// Отчет.УправленческийБаланс (SKD ОборотныеСредства, batch 2):
	// АктивПассив→Пассив, иначе как есть («Налоги»→Пассив). Заполняем
	// ЦЕНТРАЛИЗОВАННО (как ДокументДвижения §4.1бис) — НЕ трогая канон-
	// Свод_*; одинакова для всех строк статьи → безопасно. Карта
	// Статья→ТипПоказателя одним запросом к СтатьиАктивовПассивов.
	ЗапросТП = Новый Запрос;
	ЗапросТП.Текст =
	"ВЫБРАТЬ
	|	СА.Ссылка КАК Статья,
	|	ВЫБОР КОГДА СА.АктивПассив = ЗНАЧЕНИЕ(Перечисление.ВидыСтатейУправленческогоБаланса.АктивПассив)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыСтатейУправленческогоБаланса.Пассив)
	|			ИНАЧЕ СА.АктивПассив
	|		КОНЕЦ КАК ТипПоказателя
	|ИЗ
	|	ПланВидовХарактеристик.СтатьиАктивовПассивов КАК СА";
	КартаТП = Новый Соответствие;
	ВыбТП = ЗапросТП.Выполнить().Выбрать();
	Пока ВыбТП.Следующий() Цикл
		КартаТП.Вставить(ВыбТП.Статья, ВыбТП.ТипПоказателя);
	КонецЦикла;
	Для Каждого СтрСвод Из мТЗСвод Цикл
		СтрСвод.ТипПоказателя = КартаТП[СтрСвод.Статья];
	КонецЦикла;

	мТЗСвод.Свернуть(
		"Организация,Подразделение,Статья,Номенклатура,Контрагент,Партнер,Склад,"
		+ "ОбъектыЭксплуатации,Договор,ФизическоеЛицо,ДенежныеСредства,Source,"
		+ "Расхождение,Аналитика1,Аналитика2,Аналитика3,ОбъектРасчетов,"
		+ "НематериальныйАктив,ТипНалога,ТипПоказателя,СтатьяДоходыРасходы,ДокументДвижения",
		"СуммаНачальныйОстаток,СуммаПриход,СуммаРасход,СуммаКонечныйОстаток");
	Движения.А_ОтчетБаланс_Свод.Загрузить(мТЗСвод);
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИсточников

// Резолв Ссылок Перечисление.ИсточникиУправленческогоБаланса по Представлению
// (имена enum не угадываем — discovery Rule #-1).
Функция _РефыИсточников(МассивПредставлений)
	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ Ссылка КАК С, ПРЕДСТАВЛЕНИЕ(Ссылка) КАК П
	|ИЗ Перечисление.ИсточникиУправленческогоБаланса";
	Цель = Новый Соответствие;
	Для Каждого П Из МассивПредставлений Цикл
		Цель.Вставить(П, Истина);
	КонецЦикла;
	Рез = Новый Массив;
	Выб = З.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Если Цель[СокрЛП(Выб.П)] = Истина Тогда
			Рез.Добавить(Выб.С);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Универсальное ядро: ОСНОВНАЯ таблица ПАП по набору Источник (или Источник=
// ПустаяСсылка), 4 ресурса = signed Сумма, субконто через ВЫРАЗИТЬ(Аналитика),
// ДокументДвижения=Регистратор, Source=Источник. OD-3 фильтр 3 групп.
// ИсклОТ=Истина — исключить статью «Оплата труда» (её ведёт Свод_ОплатаТруда).
Процедура _СводПоИсточнику(СтруктураШапки, МассивИст, ПустойИсточник, ИсклОТ)
	
КонецПроцедуры

// Расчёты с партнёрами: источник — ВИРТУАЛЬНЫЕ таблицы
// РегистрНакопления.РасчетыСКлиентамиПоСрокам/РасчетыСПоставщикамиПоСрокам.ОстаткиИОбороты
// (НоваяАрхитектураВзаиморасчетов — отчётный регистр *ПоСрокам). Разнесение Статьи
// по РЕСУРСУ как штатная Обработка.ДвиженияАктивовПассивов: ДолгУпр→статья долга,
// ПредоплатаУпр→статья аванса (НЕ по знаку нетто); спец-ветка Партнёр=НашеПредприятие.
// Орг/НаправлениеД из РегистрСведений.АналитикаУчетаПоПартнерам по КлючАналитики;
// Подразделение из ОбъектРасчетов.Подразделение (fallback ОбъектРасчетов.Договор.Подразделение).
// Субконто = ОбъектРасчетов. Аналитика1/2/3 (2026-06-12): ПРЕДСТАВЛЕНИЕ Договор.А_ВидКонтрагента /
// Контрагент / Договор (ранее Контрагент/Договор/ОбъектРасчетов; sum-invariant, плуги "").
// ПО ОСТАТКАМ: только НО/КО; Приход=Расход=0; ДокументДвижения
// пуст. Инвариант: Σ(детали+плуг) по (Орг,Подр,Статья,Source) == ПАП(Источник∈расчётные
// ПоСрокам, OD-3, signed) == Отчет.УправленческийБаланс до копейки.
Функция Свод_РасчетыСПартнерами(СтруктураШапки, Отказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Орг",    СтруктураШапки.Организация);
	Запрос.УстановитьПараметр("НачМес", СтруктураШапки.НачМес);
	Запрос.УстановитьПараметр("КонМес", СтруктураШапки.КонМес);
	Запрос.УстановитьПараметр("Искл",   ИсключенныеСтатьи());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АП.Организация КАК Организация,
	|	ЕСТЬNULL(ВЫБОР КОГДА Р.ОбъектРасчетов.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА Р.ОбъектРасчетов.Договор.Подразделение
	|			ИНАЧЕ Р.ОбъектРасчетов.Подразделение КОНЕЦ,
	|		ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	ВЫБОР КОГДА АП.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|		ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ЗадолженностьСобственныхОрганизаций)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ЗадолженностьКлиентов) КОНЕЦ КАК Статья,
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.РасчетыСКлиентамиПоСрокам) КАК Source,
	|	Р.ОбъектРасчетов КАК ОбъектРасчетов,
	|	АП.Партнер КАК Партнер,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АП.Контрагент КАК Справочник.Контрагенты), ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АП.Договор КАК Справочник.ДоговорыКонтрагентов), ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)) КАК Договор,
	|	СУММА(Р.ДолгУпрНачальныйОстаток) КАК СуммаНачальныйОстаток,
	|	СУММА(Р.ДолгУпрКонечныйОстаток) КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ втРасч
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.ОстаткиИОбороты(&НачМес, &КонМес, , , ) КАК Р
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АП
	|	ПО Р.АналитикаУчетаПоПартнерам = АП.КлючАналитики
	|ГДЕ
	|	АП.Организация = &Орг
	|	И (Р.ДолгУпрНачальныйОстаток <> 0 ИЛИ Р.ДолгУпрКонечныйОстаток <> 0)
	|СГРУППИРОВАТЬ ПО
	|	АП.Организация,
	|	ЕСТЬNULL(ВЫБОР КОГДА Р.ОбъектРасчетов.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА Р.ОбъектРасчетов.Договор.Подразделение
	|			ИНАЧЕ Р.ОбъектРасчетов.Подразделение КОНЕЦ,
	|		ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	ВЫБОР КОГДА АП.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|		ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ЗадолженностьСобственныхОрганизаций)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ЗадолженностьКлиентов) КОНЕЦ,
	|	Р.ОбъектРасчетов,
	|	АП.Партнер,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АП.Контрагент КАК Справочник.Контрагенты), ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АП.Договор КАК Справочник.ДоговорыКонтрагентов), ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АП.Организация,
	|	ЕСТЬNULL(ВЫБОР КОГДА Р.ОбъектРасчетов.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА Р.ОбъектРасчетов.Договор.Подразделение
	|			ИНАЧЕ Р.ОбъектРасчетов.Подразделение КОНЕЦ,
	|		ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	ВЫБОР КОГДА АП.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|		ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ОбязательстваПередСобственнымиОрганизациями)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ПолученныеАвансы) КОНЕЦ,
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.РасчетыСКлиентамиПоСрокам),
	|	Р.ОбъектРасчетов,
	|	АП.Партнер,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АП.Контрагент КАК Справочник.Контрагенты), ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АП.Договор КАК Справочник.ДоговорыКонтрагентов), ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)),
	|	СУММА(-Р.ПредоплатаУпрНачальныйОстаток),
	|	СУММА(-Р.ПредоплатаУпрКонечныйОстаток)
	|ИЗ
	|	РегистрНакопления.РасчетыСКлиентамиПоСрокам.ОстаткиИОбороты(&НачМес, &КонМес, , , ) КАК Р
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АП
	|	ПО Р.АналитикаУчетаПоПартнерам = АП.КлючАналитики
	|ГДЕ
	|	АП.Организация = &Орг
	|	И (Р.ПредоплатаУпрНачальныйОстаток <> 0 ИЛИ Р.ПредоплатаУпрКонечныйОстаток <> 0)
	|СГРУППИРОВАТЬ ПО
	|	АП.Организация,
	|	ЕСТЬNULL(ВЫБОР КОГДА Р.ОбъектРасчетов.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|			ТОГДА Р.ОбъектРасчетов.Договор.Подразделение
	|			ИНАЧЕ Р.ОбъектРасчетов.Подразделение КОНЕЦ,
	|		ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	ВЫБОР КОГДА АП.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|		ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ОбязательстваПередСобственнымиОрганизациями)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ПолученныеАвансы) КОНЕЦ,
	|	Р.ОбъектРасчетов,
	|	АП.Партнер,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АП.Контрагент КАК Справочник.Контрагенты), ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АП.Договор КАК Справочник.ДоговорыКонтрагентов), ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка))
	|
