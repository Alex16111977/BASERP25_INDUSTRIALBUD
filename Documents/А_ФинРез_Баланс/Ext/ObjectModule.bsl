// Этап 3: «Прочие расходы/доходы» — ПРЯМЫЕ движения ПАП по Источник ∈
// {Прочие доходы, Прочие расходы, Партии прочих расходов} (резолв
// _РефыИсточников по Представлению). Зеркало канон-Свод_ПрочиеАктивыПассивы_
// Прямой, но Источник В (&Ист) (а не =ПустаяСсылка), Source=Т.Источник
// (реальный, не константа), БЕЗ исключения «Оплата труда» (ОТ только под
// Источник=ПустаяСсылка). Субконто из ПАП.Аналитика через ВЫРАЗИТЬ
// (ОбъектыЭксплуатации/НематериальныйАктив/ТипНалога) как Прямой. signed
// Приход +Сумма / Расход -Сумма, OD-3, остатки-only (Приход=Расход=0,
// ДокументДвижения пуст — ставит оркестратор). Discovery 2026-05-18: этот
// источник несёт ВЕСЬ незакрытый гэп баланса (Прочие расходы: дек
// 175 165,62 / янв 205 718,88) → после активации Σ(OD-3)=0, Актив=Пассив
// == Отчет.УправленческийБаланс; СверкаСПАП НЕ нужна. Инвариант:
// Σ(детали+плуг) по (Орг,Подр,Статья,Source) == ПАП(Источник∈&Ист, OD-3,
// signed) до копейки.
// v2 (2026-05-26): расшифровка через специализированные регистры ПрочиеРасходы и
// ПрочиеДоходы. Статьи «Расходы/Доходы текущего периода» берутся ТОЛЬКО из них
// (Свод_ПрочиеАктивыПассивы_Прямой их исключает). Правило бухучёта: пишем только
// строки расшифровки где НО≠0 или КО≠0 (т.е. статья висит в балансе на начало или
// конец периода). Плуги компенсируют разницу с ПАП per (Орг,Подр,Статья).
// Эталон апрель 2026/Глобино-2: 1 строка («Затраты на служебные командировки»,
// НО=0, КО=2400). Остальные статьи источника {ПрочиеДоходы/ПрочиеРасходы/Партии}
// (Прочие пассивы, Прибыли и убытки, и др.) — через ВЫРАЗИТЬ(ПАП.Аналитика).
Функция Свод_ПрочиеРасходыДоходы(СтруктураШапки, Отказ) Экспорт
	М = Новый Массив;
	М.Добавить("Прочие доходы");
	М.Добавить("Прочие расходы");
	М.Добавить("Партии прочих расходов");
	Ист = _РефыИсточников(М);
	Если Ист.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Орг",        СтруктураШапки.Организация);
	Запрос.УстановитьПараметр("НачМес",     СтруктураШапки.НачМес);
	Запрос.УстановитьПараметр("КонМес",     СтруктураШапки.КонМес);
	Запрос.УстановитьПараметр("Искл",       ИсключенныеСтатьи());
	Запрос.УстановитьПараметр("Ист",        Ист);
	Запрос.УстановитьПараметр("РасхТекПер", ПланыВидовХарактеристик.СтатьиАктивовПассивов.НайтиПоНаименованию("Расходы текущего периода"));
	Запрос.УстановитьПараметр("ДохТекПер",  ПланыВидовХарактеристик.СтатьиАктивовПассивов.НайтиПоНаименованию("Доходы текущего периода"));
	Запрос.Текст =
	"// Ветвь A: расшифровка статьи «Расходы текущего периода» через РегНакопл.ПрочиеРасходы
	|// Ветвь B: расшифровка статьи «Доходы текущего периода» через РегНакопл.ПрочиеДоходы
	|// Ветвь C: остальные статьи источника {ПрочиеДоходы/ПрочиеРасходы/Партии} через ПАП.Аналитика
	|ВЫБРАТЬ
	|	ПР.Организация КАК Организация,
	|	ЕСТЬNULL(ПР.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	&РасхТекПер КАК Статья,
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка) КАК Source,
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка) КАК ОбъектыЭксплуатации,
	|	ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка) КАК НематериальныйАктив,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка) КАК ТипНалога,
	|	ПР.СтатьяРасходов КАК СтатьяДоходыРасходы,
	|	СУММА(ПР.СуммаНачальныйОстаток) КАК СуммаНачальныйОстаток,
	|	СУММА(ПР.СуммаКонечныйОстаток) КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ втПРД
	|ИЗ
	|	РегистрНакопления.ПрочиеРасходы.ОстаткиИОбороты(&НачМес, &КонМес, Авто, , Организация = &Орг) КАК ПР
	|СГРУППИРОВАТЬ ПО
	|	ПР.Организация,
	|	ЕСТЬNULL(ПР.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	ПР.СтатьяРасходов
	|ИМЕЮЩИЕ
	|	СУММА(ПР.СуммаНачальныйОстаток) <> 0
	|	ИЛИ СУММА(ПР.СуммаКонечныйОстаток) <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПД.Организация,
	|	ЕСТЬNULL(ПД.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	&ДохТекПер,
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка),
	|	ПД.СтатьяДоходов,
	|	СУММА(ПД.СуммаНачальныйОстаток),
	|	СУММА(ПД.СуммаКонечныйОстаток)
	|ИЗ
	|	РегистрНакопления.ПрочиеДоходы.ОстаткиИОбороты(&НачМес, &КонМес, Авто, , Организация = &Орг) КАК ПД
	|СГРУППИРОВАТЬ ПО
	|	ПД.Организация,
	|	ЕСТЬNULL(ПД.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	ПД.СтатьяДоходов
	|ИМЕЮЩИЕ
	|	СУММА(ПД.СуммаНачальныйОстаток) <> 0
	|	ИЛИ СУММА(ПД.СуммаКонечныйОстаток) <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	Т.Статья,
	|	Т.Источник,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.ОбъектыЭксплуатации), ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка)),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.НематериальныеАктивы), ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка)),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Т.Аналитика КАК Перечисление.ТипыНалогов), ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка)),
	|	NULL,
	|	СУММА(ВЫБОР КОГДА Т.Период < &НачМес
	|			ТОГДА ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ
	|			ИНАЧЕ 0 КОНЕЦ),
	|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ)
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы КАК Т
	|ГДЕ
	|	Т.Организация = &Орг
	|	И Т.Период <= &КонМес
	|	И Т.Источник В (&Ист)
	|	И Т.Статья <> &РасхТекПер
	|	И Т.Статья <> &ДохТекПер
	|	И НЕ Т.Статья В ИЕРАРХИИ(&Искл)
	|СГРУППИРОВАТЬ ПО
	|	Т.Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
