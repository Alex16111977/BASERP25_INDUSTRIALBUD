#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Месяц) Тогда
		Месяц = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	НачМесяца = НачалоМесяца(Месяц);
	КонМесяца = КонецМесяца(Месяц);

	// --- Дублікат-захист ---
	ЗапросДубль = Новый Запрос;
	ЗапросДубль.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 ФР.Номер КАК Номер, ФР.Дата КАК Дата
	|ИЗ Документ.А_ФинРез_Баланс КАК ФР
	|ГДЕ ФР.Ссылка <> &ТекущийДок И НЕ ФР.ПометкаУдаления И ФР.Проведен
	|	И ФР.Организация = &Организация
	|	И ФР.Месяц МЕЖДУ &НачМесяца И &КонМесяца
	|	И ФР.ВключатьДочерние = &ВключатьДочерние";
	ЗапросДубль.УстановитьПараметр("ТекущийДок",       Ссылка);
	ЗапросДубль.УстановитьПараметр("Организация",      Организация);
	ЗапросДубль.УстановитьПараметр("НачМесяца",        НачМесяца);
	ЗапросДубль.УстановитьПараметр("КонМесяца",        КонМесяца);
	ЗапросДубль.УстановитьПараметр("ВключатьДочерние", ВключатьДочерние);
	РезДубль = ЗапросДубль.Выполнить();
	Если НЕ РезДубль.Пустой() Тогда
		ВыбДубль = РезДубль.Выбрать(); ВыбДубль.Следующий();
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не можна провести: за %1 (Організація %2) вже проведено документ %3 від %4.",
				Формат(НачМесяца, "ДФ='ММММ yyyy'"), Организация, ВыбДубль.Номер,
				Формат(ВыбДубль.Дата, "ДФ='dd.MM.yyyy'")));
		Отказ = Истина; Возврат;
	КонецЕсли;

	// --- Виключені статті (канон OD-3): 3 групи (закритий період → КонОст=0) ---
	ЗапросИскл = Новый Запрос;
	ЗапросИскл.Текст =
	"ВЫБРАТЬ Ссылка КАК Ссылка ИЗ ПланВидовХарактеристик.СтатьиАктивовПассивов
	|ГДЕ Наименование В (&Имена)";
	ЗапросИскл.УстановитьПараметр("Имена", СтрРазделить(
		"Собственные средства,Доходы текущего периода,Расходы текущего периода", ","));
	ИсключенныеСтатьи = ЗапросИскл.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	// --- Стаття «Оплата труда» (Етап 4: розшифровка по ФизическоеЛицо) ---
	ЗапросОТ = Новый Запрос;
	ЗапросОТ.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка ИЗ ПланВидовХарактеристик.СтатьиАктивовПассивов
	|ГДЕ Наименование = ""Оплата труда""";
	ВыбОТ = ЗапросОТ.Выполнить().Выбрать();
	СтатьяОплатаТруда = ?(ВыбОТ.Следующий(), ВыбОТ.Ссылка,
		ПланыВидовХарактеристик.СтатьиАктивовПассивов.ПустаяСсылка());

	// --- Свертка ПАП (Етапи 1-4, канон v1.4): суми з ПАП, субконто LEFT JOIN
	//     предагрег. джерел; ТИПОВІ регістри лише читаються. «Оплата труда» —
	//     розклад по ФизическоеЛицо пропорційно сальдо ВзаиморасчетыССотрудниками
	//     (Σ по статті == ПАП зберігається: Σ ваг = 1) ---
	Движения.А_ОтчетБаланс_Свод.Записывать = Истина;
	Запрос = Новый Запрос;
	Запрос.Текст = СформироватьЗапросСверткиБаланса();
	Запрос.УстановитьПараметр("НачалоПериода",      НачМесяца);
	Запрос.УстановитьПараметр("КонецПериода",       КонецДня(КонМесяца));
	Запрос.УстановитьПараметр("Организация",        Организация);
	Запрос.УстановитьПараметр("ВключатьДочерние",   ВключатьДочерние);
	Запрос.УстановитьПараметр("ИсключенныеСтатьи",  ИсключенныеСтатьи);
	Запрос.УстановитьПараметр("СтатьяОплатаТруда",  СтатьяОплатаТруда);
	Движения.А_ОтчетБаланс_Свод.Загрузить(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Етапи 1-4 (канон v1.4 OD-2): суми ЗАВЖДИ з ПАП.ОстаткиИОбороты.
// Етап2-3: субконто LEFT JOIN предагрег. джерел по Регистратор (fill-when-unique).
// Етап4 «Оплата труда»: розклад ПАП по ФизическоеЛицо пропорційно |сальдо|
// ВзаиморасчетыССотрудниками (кумулятив до КонецПериода). Σ ваг = 1 →
// Σ по статті == ПАП (пост-інваріант зберігається). Орг без ВЗ → 1 рядок,
// ФизическоеЛицо порожнє, повна сума. ТИПОВІ регістри лише читаються.
Функция СформироватьЗапросСверткиБаланса()
	Возврат
	"ВЫБРАТЬ Р.Регистратор КАК Регистратор, МИНИМУМ(Р.ОбъектРасчетов) КАК ОбъектРасчетов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Р.ОбъектРасчетов) КАК Кол
	|ПОМЕСТИТЬ втРасчКл ИЗ РегистрНакопления.РасчетыСКлиентами КАК Р
	|ГДЕ Р.Период МЕЖДУ &НачалоПериода И &КонецПериода СГРУППИРОВАТЬ ПО Р.Регистратор
	|;
	|ВЫБРАТЬ Р.Регистратор КАК Регистратор, МИНИМУМ(Р.ОбъектРасчетов) КАК ОбъектРасчетов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Р.ОбъектРасчетов) КАК Кол
	|ПОМЕСТИТЬ втРасчПост ИЗ РегистрНакопления.РасчетыСПоставщиками КАК Р
	|ГДЕ Р.Период МЕЖДУ &НачалоПериода И &КонецПериода СГРУППИРОВАТЬ ПО Р.Регистратор
	|;
	|ВЫБРАТЬ Т.Регистратор КАК Регистратор,
	|	МИНИМУМ(Т.АналитикаУчетаНоменклатуры.Номенклатура) КАК Номенклатура,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.АналитикаУчетаНоменклатуры.Номенклатура) КАК КолНом,
	|	МИНИМУМ(ВЫРАЗИТЬ(Т.АналитикаУчетаНоменклатуры.МестоХранения КАК Справочник.Склады)) КАК Склад,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫРАЗИТЬ(Т.АналитикаУчетаНоменклатуры.МестоХранения КАК Справочник.Склады)) КАК КолСкл
	|ПОМЕСТИТЬ втСебест ИЗ РегистрНакопления.СебестоимостьТоваров КАК Т
	|ГДЕ Т.Период МЕЖДУ &НачалоПериода И &КонецПериода СГРУППИРОВАТЬ ПО Т.Регистратор
	|;
	|ВЫБРАТЬ Д.Регистратор КАК Регистратор, МИНИМУМ(Д.БанковскийСчет) КАК ДенСр,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Д.БанковскийСчет) КАК КолДС
	|ПОМЕСТИТЬ втДенБ ИЗ РегистрНакопления.ДенежныеСредстваБезналичные КАК Д
	|ГДЕ Д.Период МЕЖДУ &НачалоПериода И &КонецПериода СГРУППИРОВАТЬ ПО Д.Регистратор
	|;
	|ВЫБРАТЬ Д.Регистратор КАК Регистратор, МИНИМУМ(Д.Касса) КАК ДенСр,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Д.Касса) КАК КолДС
	|ПОМЕСТИТЬ втДенН ИЗ РегистрНакопления.ДенежныеСредстваНаличные КАК Д
	|ГДЕ Д.Период МЕЖДУ &НачалоПериода И &КонецПериода СГРУППИРОВАТЬ ПО Д.Регистратор
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ Б.Регистратор КАК Регистратор, Б.Статья КАК Статья,
	|	Б.Организация КАК Организация, Б.Подразделение КАК Подразделение, Б.Аналитика КАК Аналитика
	|ПОМЕСТИТЬ втРегПАП
	|ИЗ РегистрНакопления.ПрочиеАктивыПассивы.Обороты(
	|		&НачалоПериода, &КонецПериода, Регистратор,
	|		(ВЫБОР КОГДА &ВключатьДочерние ТОГДА Организация В ИЕРАРХИИ (&Организация)
	|			  ИНАЧЕ Организация = &Организация КОНЕЦ)
	|		И НЕ Статья В ИЕРАРХИИ (&ИсключенныеСтатьи)) КАК Б
	|;
	|ВЫБРАТЬ РП.Организация КАК Организация, РП.Подразделение КАК Подразделение,
	|	РП.Статья КАК Статья, РП.Аналитика КАК Аналитика,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(К.ОбъектРасчетов, П.ОбъектРасчетов)) КАК КолОР,
	|	МИНИМУМ(ЕСТЬNULL(К.ОбъектРасчетов, П.ОбъектРасчетов)) КАК ОбъектРасчетов,
	|	МАКСИМУМ(ВЫБОР КОГДА К.Регистратор ЕСТЬ NULL ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК ЕстьКл,
	|	МАКСИМУМ(ВЫБОР КОГДА П.Регистратор ЕСТЬ NULL ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК ЕстьПост,
	|	СУММА(ЕСТЬNULL(С.КолНом,0)) КАК КолНом, МИНИМУМ(С.Номенклатура) КАК Номенклатура,
	|	СУММА(ЕСТЬNULL(С.КолСкл,0)) КАК КолСкл, МИНИМУМ(С.Склад) КАК Склад,
	|	МАКСИМУМ(ВЫБОР КОГДА С.Регистратор ЕСТЬ NULL ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК ЕстьСеб,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЕСТЬNULL(ДБ.ДенСр, ДН.ДенСр)) КАК КолДС,
	|	МИНИМУМ(ЕСТЬNULL(ДБ.ДенСр, ДН.ДенСр)) КАК ДенСр,
	|	МАКСИМУМ(ВЫБОР КОГДА ДБ.Регистратор ЕСТЬ NULL ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК ЕстьДенБ,
	|	МАКСИМУМ(ВЫБОР КОГДА ДН.Регистратор ЕСТЬ NULL ТОГДА 0 ИНАЧЕ 1 КОНЕЦ) КАК ЕстьДенН
	|ПОМЕСТИТЬ втОБ
	|ИЗ втРегПАП КАК РП
	|	ЛЕВОЕ СОЕДИНЕНИЕ втРасчКл КАК К ПО РП.Регистратор = К.Регистратор
	|	ЛЕВОЕ СОЕДИНЕНИЕ втРасчПост КАК П ПО РП.Регистратор = П.Регистратор
	|	ЛЕВОЕ СОЕДИНЕНИЕ втСебест КАК С ПО РП.Регистратор = С.Регистратор
	|	ЛЕВОЕ СОЕДИНЕНИЕ втДенБ КАК ДБ ПО РП.Регистратор = ДБ.Регистратор
	|	ЛЕВОЕ СОЕДИНЕНИЕ втДенН КАК ДН ПО РП.Регистратор = ДН.Регистратор
	|СГРУППИРОВАТЬ ПО РП.Организация, РП.Подразделение, РП.Статья, РП.Аналитика
	|;
	|ВЫБРАТЬ ВЗ.Организация КАК Организация, ВЗ.ФизическоеЛицо КАК ФизическоеЛицо,
	|	СУММА(ВЫБОР КОГДА ВЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА ВЗ.СуммаВзаиморасчетов ИНАЧЕ -ВЗ.СуммаВзаиморасчетов КОНЕЦ) КАК Сальдо
	|ПОМЕСТИТЬ втЗПСальдо
	|ИЗ РегистрНакопления.ВзаиморасчетыССотрудниками КАК ВЗ
	|ГДЕ ВЗ.Период <= &КонецПериода
	|СГРУППИРОВАТЬ ПО ВЗ.Организация, ВЗ.ФизическоеЛицо
	|ИМЕЮЩИЕ СУММА(ВЫБОР КОГДА ВЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА ВЗ.СуммаВзаиморасчетов ИНАЧЕ -ВЗ.СуммаВзаиморасчетов КОНЕЦ) <> 0
	|;
	|ВЫБРАТЬ С.Организация КАК Организация, С.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВЫБОР КОГДА С.Сальдо < 0 ТОГДА -С.Сальдо ИНАЧЕ С.Сальдо КОНЕЦ КАК Вес
	|ПОМЕСТИТЬ втЗПФЛ ИЗ втЗПСальдо КАК С
	|;
	|ВЫБРАТЬ Ф.Организация КАК Организация, СУММА(Ф.Вес) КАК СумВес
	|ПОМЕСТИТЬ втЗПОрг ИЗ втЗПФЛ КАК Ф СГРУППИРОВАТЬ ПО Ф.Организация
	|;
	|// === Частина A: усі статті КРІМ «Оплата труда» (Етапи 1-3) ===
	|ВЫБРАТЬ
	|	Б.Организация КАК Организация, Б.Подразделение КАК Подразделение, Б.Статья КАК Статья,
	|	ВЫБОР КОГДА ЕСТЬNULL(ОБ.КолНом,0)=1 ТОГДА ЕСТЬNULL(ОБ.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|	     ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КОНЕЦ КАК Номенклатура,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Б.Аналитика КАК Справочник.Контрагенты),
	|	         ВЫРАЗИТЬ(Б.Аналитика КАК Справочник.Организации)) КАК Контрагент,
	|	ВЫРАЗИТЬ(Б.Аналитика КАК Справочник.Партнеры) КАК Партнер,
	|	ВЫБОР КОГДА ЕСТЬNULL(ОБ.КолСкл,0)=1 ТОГДА ЕСТЬNULL(ОБ.Склад, ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка))
	|	     ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КОНЕЦ КАК Склад,
	|	ВЫРАЗИТЬ(Б.Аналитика КАК Справочник.ОбъектыЭксплуатации) КАК ОбъектыЭксплуатации,
	|	ВЫРАЗИТЬ(Б.Аналитика КАК Справочник.ФизическиеЛица) КАК ФизическоеЛицо,
	|	ВЫБОР КОГДА ЕСТЬNULL(ОБ.КолДС,0)=1 ТОГДА ОБ.ДенСр ИНАЧЕ НЕОПРЕДЕЛЕНО КОНЕЦ КАК ДенежныеСредства,
	|	ВЫРАЗИТЬ(Б.Аналитика КАК Справочник.НематериальныеАктивы) КАК НематериальныйАктив,
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК Договор,
	|	ВЫБОР КОГДА ЕСТЬNULL(ОБ.КолОР,0)=1 ТОГДА ЕСТЬNULL(ОБ.ОбъектРасчетов, ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка))
	|	     ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка) КОНЕЦ КАК ОбъектРасчетов,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОБ.ЕстьКл,0)=1 ТОГДА ЗНАЧЕНИЕ(Перечисление.А_ИсточникБаланса.РасчетыСКлиентами)
	|		КОГДА ЕСТЬNULL(ОБ.ЕстьПост,0)=1 ТОГДА ЗНАЧЕНИЕ(Перечисление.А_ИсточникБаланса.РасчетыСПоставщиками)
	|		КОГДА ЕСТЬNULL(ОБ.ЕстьСеб,0)=1 ТОГДА ЗНАЧЕНИЕ(Перечисление.А_ИсточникБаланса.СебестоимостьТоваров)
	|		КОГДА ЕСТЬNULL(ОБ.ЕстьДенБ,0)=1 ТОГДА ЗНАЧЕНИЕ(Перечисление.А_ИсточникБаланса.ДенежныеСредстваБезналичные)
	|		КОГДА ЕСТЬNULL(ОБ.ЕстьДенН,0)=1 ТОГДА ЗНАЧЕНИЕ(Перечисление.А_ИсточникБаланса.ДенежныеСредстваНаличные)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.А_ИсточникБаланса.ПрочиеАктивыПассивы)
	|	КОНЕЦ КАК Source,
	|	"""" КАК Аналитика1, """" КАК Аналитика2, ПРЕДСТАВЛЕНИЕ(Б.Аналитика) КАК Аналитика3,
	|	СУММА(Б.СуммаНачальныйОстаток) КАК СуммаНачальныйОстаток,
	|	СУММА(Б.СуммаПриход) КАК СуммаПриход,
	|	СУММА(Б.СуммаРасход) КАК СуммаРасход,
	|	СУММА(Б.СуммаКонечныйОстаток) КАК СуммаКонечныйОстаток
	|ИЗ РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, Авто, ,
	|		(ВЫБОР КОГДА &ВключатьДочерние ТОГДА Организация В ИЕРАРХИИ (&Организация)
	|			  ИНАЧЕ Организация = &Организация КОНЕЦ)
	|		И НЕ Статья В ИЕРАРХИИ (&ИсключенныеСтатьи)
	|		И Статья <> &СтатьяОплатаТруда) КАК Б
	|	ЛЕВОЕ СОЕДИНЕНИЕ втОБ КАК ОБ
	|		ПО Б.Организация = ОБ.Организация И Б.Подразделение = ОБ.Подразделение
	|			И Б.Статья = ОБ.Статья И Б.Аналитика = ОБ.Аналитика
	|СГРУППИРОВАТЬ ПО Б.Организация, Б.Подразделение, Б.Статья, Б.Аналитика,
	|	ОБ.КолОР, ОБ.ОбъектРасчетов, ОБ.ЕстьКл, ОБ.ЕстьПост,
	|	ОБ.КолНом, ОБ.Номенклатура, ОБ.КолСкл, ОБ.Склад, ОБ.ЕстьСеб,
	|	ОБ.КолДС, ОБ.ДенСр, ОБ.ЕстьДенБ, ОБ.ЕстьДенН
	|ИМЕЮЩИЕ НЕ (СУММА(Б.СуммаНачальныйОстаток)=0 И СУММА(Б.СуммаПриход)=0
	|		И СУММА(Б.СуммаРасход)=0 И СУММА(Б.СуммаКонечныйОстаток)=0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// === Частина B1: «Оплата труда», орг З ВЗ — розклад по ФизическоеЛицо ===
	|ВЫБРАТЬ
	|	Б.Организация, Б.Подразделение, Б.Статья,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка),
	|	ЗПФЛ.ФизическоеЛицо,
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.А_ИсточникБаланса.ПрочиеРасходы),
	|	"""", """", ПРЕДСТАВЛЕНИЕ(Б.Аналитика),
	|	СУММА(Б.СуммаНачальныйОстаток * ЗПФЛ.Вес / ЗПОрг.СумВес),
	|	СУММА(Б.СуммаПриход * ЗПФЛ.Вес / ЗПОрг.СумВес),
	|	СУММА(Б.СуммаРасход * ЗПФЛ.Вес / ЗПОрг.СумВес),
	|	СУММА(Б.СуммаКонечныйОстаток * ЗПФЛ.Вес / ЗПОрг.СумВес)
	|ИЗ РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, Авто, ,
	|		(ВЫБОР КОГДА &ВключатьДочерние ТОГДА Организация В ИЕРАРХИИ (&Организация)
	|			  ИНАЧЕ Организация = &Организация КОНЕЦ)
	|		И Статья = &СтатьяОплатаТруда) КАК Б
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗПОрг КАК ЗПОрг ПО Б.Организация = ЗПОрг.Организация
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗПФЛ КАК ЗПФЛ ПО Б.Организация = ЗПФЛ.Организация
	|СГРУППИРОВАТЬ ПО Б.Организация, Б.Подразделение, Б.Статья, Б.Аналитика, ЗПФЛ.ФизическоеЛицо
	|ИМЕЮЩИЕ НЕ (СУММА(Б.СуммаНачальныйОстаток * ЗПФЛ.Вес / ЗПОрг.СумВес)=0
	|		И СУММА(Б.СуммаПриход * ЗПФЛ.Вес / ЗПОрг.СумВес)=0
	|		И СУММА(Б.СуммаРасход * ЗПФЛ.Вес / ЗПОрг.СумВес)=0
	|		И СУММА(Б.СуммаКонечныйОстаток * ЗПФЛ.Вес / ЗПОрг.СумВес)=0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// === Частина B2: «Оплата труда», орг БЕЗ ВЗ — 1 рядок, повна сума ===
	|ВЫБРАТЬ
	|	Б.Организация, Б.Подразделение, Б.Статья,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.А_ИсточникБаланса.ПрочиеРасходы),
	|	"""", """", ПРЕДСТАВЛЕНИЕ(Б.Аналитика),
	|	СУММА(Б.СуммаНачальныйОстаток), СУММА(Б.СуммаПриход),
	|	СУММА(Б.СуммаРасход), СУММА(Б.СуммаКонечныйОстаток)
	|ИЗ РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты(
	|		&НачалоПериода, &КонецПериода, Авто, ,
	|		(ВЫБОР КОГДА &ВключатьДочерние ТОГДА Организация В ИЕРАРХИИ (&Организация)
	|			  ИНАЧЕ Организация = &Организация КОНЕЦ)
	|		И Статья = &СтатьяОплатаТруда) КАК Б
	|	ЛЕВОЕ СОЕДИНЕНИЕ втЗПОрг КАК ЗПОрг ПО Б.Организация = ЗПОрг.Организация
	|ГДЕ ЗПОрг.Организация ЕСТЬ NULL
	|СГРУППИРОВАТЬ ПО Б.Организация, Б.Подразделение, Б.Статья, Б.Аналитика
	|ИМЕЮЩИЕ НЕ (СУММА(Б.СуммаНачальныйОстаток)=0 И СУММА(Б.СуммаПриход)=0
	|		И СУММА(Б.СуммаРасход)=0 И СУММА(Б.СуммаКонечныйОстаток)=0)";
КонецФункции

#КонецОбласти

#КонецЕсли
