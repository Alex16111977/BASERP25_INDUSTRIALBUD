// Себестоимость: источник — ВИРТУАЛЬНАЯ таблица
// РегистрНакопления.СебестоимостьТоваров.ОстаткиИОбороты (как штатный отчёт
// АнализСебестоимостиТоваровРасширенный). Себестоимость по показателю =
// Стоимость+ДопРасходы+Трудозатраты+ПостатейныеПостоянныеСНДС
// +ПостатейныеПеременныеСНДС. Субконто Склад/Номенклатура — ЛЕВОЕ СОЕДИНЕНИЕ
// Справочник.КлючиАналитикиУчетаНоменклатуры (.Номенклатура/.МестоХранения).
// ПРОСТАЯ модель (проводится без дубля ключа регистра): фильтр
// РазделУчета=ТоварыНаСкладах, Подразделение ПУСТО, Статья — малый ВЫБОР по
// ТипСклада/ТипМестаХранения, ОДНА строка на (Орг,Статья,Ном,Склад).
// ПО ОСТАТКАМ: только НачальныйОстаток/КонечныйОстаток; Приход=Расход=0;
// ДокументДвижения ПУСТОЙ. Инвариант (встроенная расшифровка УпрБаланса):
// Σ остатков по статье == Остатки ПАП по статье == Отчет.УправленческийБаланс
// («Товары на оптовых складах», янв/ТОВ КонОст = 83 627 719,44) — без расхождений.
// Аналитика1/2/3 (2026-06-12): ПРЕДСТАВЛЕНИЕ Склад.Подразделение / Склад / Номенклатура
// (ранее Склад/Номенклатура/""; sum-invariant, плуги "").
Функция Свод_СебестоимостьТоваров(СтруктураШапки, Отказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Орг",    СтруктураШапки.Организация);
	Запрос.УстановитьПараметр("НачМес", СтруктураШапки.НачМес);
	Запрос.УстановитьПараметр("КонМес", СтруктураШапки.КонМес);
	Запрос.УстановитьПараметр("Искл",   ИсключенныеСтатьи());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СТ.Организация КАК Организация,
	|	ЕСТЬNULL(Аналитика.МестоХранения.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	ВЫБОР
	|		КОГДА Аналитика.СкладскаяТерритория.ТипСклада = ЗНАЧЕНИЕ(Перечисление.ТипыСкладов.РозничныйМагазин)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ТоварыВРознице)
	|		КОГДА Аналитика.СкладскаяТерритория.ТипСклада = ЗНАЧЕНИЕ(Перечисление.ТипыСкладов.ОптовыйСклад)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ТоварыНаОптовыхСкладах)
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Партнер)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ТоварыКОформлениюОтчетовКомитенту)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ТоварыПереданныеНаКомиссию)
	|	КОНЕЦ КАК Статья,
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.СебестоимостьТоваров) КАК Source,
	|	Аналитика.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(Аналитика.МестоХранения КАК Справочник.Склады) КАК Склад,
	|	СУММА(СТ.СтоимостьНачальныйОстаток + СТ.ДопРасходыНачальныйОстаток + СТ.ТрудозатратыНачальныйОстаток + СТ.ПостатейныеПостоянныеСНДСНачальныйОстаток + СТ.ПостатейныеПеременныеСНДСНачальныйОстаток) КАК СуммаНачальныйОстаток,
	|	СУММА(СТ.СтоимостьКонечныйОстаток + СТ.ДопРасходыКонечныйОстаток + СТ.ТрудозатратыКонечныйОстаток + СТ.ПостатейныеПостоянныеСНДСКонечныйОстаток + СТ.ПостатейныеПеременныеСНДСКонечныйОстаток) КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ втСеб
	|ИЗ
	|	РегистрНакопления.СебестоимостьТоваров.ОстаткиИОбороты(
	|			&НачМес,
	|			&КонМес,
	|			,
	|			,
	|			Организация = &Орг
	|				И (РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах)
	|					ИЛИ РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыПереданныеНаКомиссию))) КАК СТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлючиАналитикиУчетаНоменклатуры КАК Аналитика
	|		ПО СТ.АналитикаУчетаНоменклатуры = Аналитика.Ссылка
	|ГДЕ
	|	(СТ.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыНаСкладах)
	|			ИЛИ СТ.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаСебестоимостиТоваров.ТоварыПереданныеНаКомиссию))
	|СГРУППИРОВАТЬ ПО
	|	СТ.Организация,
	|	ЕСТЬNULL(Аналитика.МестоХранения.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	ВЫБОР
	|		КОГДА Аналитика.СкладскаяТерритория.ТипСклада = ЗНАЧЕНИЕ(Перечисление.ТипыСкладов.РозничныйМагазин)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ТоварыВРознице)
	|		КОГДА Аналитика.СкладскаяТерритория.ТипСклада = ЗНАЧЕНИЕ(Перечисление.ТипыСкладов.ОптовыйСклад)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ТоварыНаОптовыхСкладах)
	|		КОГДА Аналитика.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Партнер)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ТоварыКОформлениюОтчетовКомитенту)
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.СтатьиАктивовПассивов.ТоварыПереданныеНаКомиссию)
	|	КОНЕЦ,
	|	Аналитика.Номенклатура,
	|	ВЫРАЗИТЬ(Аналитика.МестоХранения КАК Справочник.Склады)
	|;
	|ВЫБРАТЬ
	|	втСеб.Организация КАК Организация,
	|	втСеб.Подразделение КАК Подразделение,
	|	втСеб.Статья КАК Статья,
	|	СУММА(втСеб.СуммаНачальныйОстаток) КАК НО,
	|	СУММА(втСеб.СуммаКонечныйОстаток) КАК КО
	|ПОМЕСТИТЬ втСебСт
	|ИЗ
	|	втСеб КАК втСеб
	|СГРУППИРОВАТЬ ПО
	|	втСеб.Организация, втСеб.Подразделение, втСеб.Статья
	|;
	|ВЫБРАТЬ
	|	Т.Организация КАК Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	Т.Статья КАК Статья,
	|	СУММА(ВЫБОР КОГДА Т.Период < &НачМес
	|			ТОГДА ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ
	|			ИНАЧЕ 0 КОНЕЦ) КАК НО,
	|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ) КАК КО
	|ПОМЕСТИТЬ втПАП
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы КАК Т
	|ГДЕ
	|	Т.Организация = &Орг
	|	И Т.Период <= &КонМес
	|	И Т.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.СебестоимостьТоваров)
	|	И НЕ Т.Статья В ИЕРАРХИИ(&Искл)
	|СГРУППИРОВАТЬ ПО
	|	Т.Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	Т.Статья
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	К.Организация КАК Организация,
	|	К.Подразделение КАК Подразделение,
	|	К.Статья КАК Статья
	|ПОМЕСТИТЬ втКлючи
	|ИЗ
	|	(ВЫБРАТЬ
	|		втПАП.Организация КАК Организация,
	|		втПАП.Подразделение КАК Подразделение,
	|		втПАП.Статья КАК Статья
	|	ИЗ
	|		втПАП КАК втПАП
	|	ОБЪЕДИНИТЬ ВСЕ
	|	ВЫБРАТЬ
	|		втСебСт.Организация,
	|		втСебСт.Подразделение,
	|		втСебСт.Статья
	|	ИЗ
	|		втСебСт КАК втСебСт) КАК К
	|;
	|ВЫБРАТЬ
	|	втСеб.Организация КАК Организация,
	|	втСеб.Подразделение КАК Подразделение,
	|	втСеб.Статья КАК Статья,
	|	втСеб.Source КАК Source,
	|	втСеб.Номенклатура КАК Номенклатура,
	|	втСеб.Склад КАК Склад,
	|	ВЫБОР КОГДА втСеб.Склад.Подразделение <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка) ТОГДА ПРЕДСТАВЛЕНИЕ(втСеб.Склад.Подразделение) ИНАЧЕ """" КОНЕЦ КАК Аналитика1,
	|	ВЫБОР КОГДА втСеб.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) ТОГДА ПРЕДСТАВЛЕНИЕ(втСеб.Склад) ИНАЧЕ """" КОНЕЦ КАК Аналитика2,
	|	ВЫБОР КОГДА втСеб.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА ПРЕДСТАВЛЕНИЕ(втСеб.Номенклатура) ИНАЧЕ """" КОНЕЦ КАК Аналитика3,
	|	ЛОЖЬ КАК Расхождение,
	|	втСеб.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	|	0 КАК СуммаПриход,
	|	0 КАК СуммаРасход,
	|	втСеб.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
	|ИЗ
	|	втСеб КАК втСеб
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	К.Организация,
	|	К.Подразделение,
	|	К.Статья,
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.СебестоимостьТоваров),
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка),
	|	"""",
	|	"""",
	|	"""",
	|	ИСТИНА,
	|	ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втСебСт.НО, 0),
	|	0,
	|	0,
	|	ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втСебСт.КО, 0)
	|ИЗ
	|	втКлючи КАК К
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПАП КАК втПАП
	|		ПО К.Организация = втПАП.Организация
	|			И К.Подразделение = втПАП.Подразделение
	|			И К.Статья = втПАП.Статья
	|		ЛЕВОЕ СОЕДИНЕНИЕ втСебСт КАК втСебСт
	|		ПО К.Организация = втСебСт.Организация
	|			И К.Подразделение = втСебСт.Подразделение
	|			И К.Статья = втСебСт.Статья
	|ГДЕ
	|	ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втСебСт.НО, 0) > 0.01
	|	ИЛИ ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втСебСт.НО, 0) < -0.01
	|	ИЛИ ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втСебСт.КО, 0) > 0.01
	|	ИЛИ ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втСебСт.КО, 0) < -0.01";
	Отразить_Свод(Запрос.Выполнить().Выгрузить());
	Возврат Истина;
КонецФункции

Функция Свод_ДенежныеСредства(СтруктураШапки, Отказ) Экспорт
	МассивПредст = Новый Массив;
	МассивПредст.Добавить("Денежные средства (безналичные)");
	МассивПредст.Добавить("Денежные средства (наличные)");
	МассивПредст.Добавить("Денежные средства в пути");
	МассивПредст.Добавить("Денежные средства у подотчетных лиц");
	МассивИст = _РефыИсточников(МассивПредст);

	ПредстБ = Новый Массив; ПредстБ.Добавить("Денежные средства (безналичные)");
	РефыБ = _РефыИсточников(ПредстБ);
	ПредстН = Новый Массив; ПредстН.Добавить("Денежные средства (наличные)");
	РефыН = _РефыИсточников(ПредстН);
	ПредстП = Новый Массив; ПредстП.Добавить("Денежные средства у подотчетных лиц");
	РефыП = _РефыИсточников(ПредстП);
	ПредстВП = Новый Массив; ПредстВП.Добавить("Денежные средства в пути");
	РефыВП = _РефыИсточников(ПредстВП);
	Если РефыБ.Количество() = 0 ИЛИ РефыН.Количество() = 0 ИЛИ РефыП.Количество() = 0 ИЛИ РефыВП.Количество() = 0 Тогда Возврат Истина; КонецЕсли;
	ИстБезнал = РефыБ[0];
	ИстНал    = РефыН[0];
	ИстПодотч = РефыП[0];
	ИстВПути  = РефыВП[0];

	ЗСт = Новый Запрос;
	ЗСт.Текст =
	"ВЫБРАТЬ Ссылка КАК С, Наименование КАК Н
	|ИЗ ПланВидовХарактеристик.СтатьиАктивовПассивов
	|ГДЕ Наименование В (&Имена)";
	ИменаСт = Новый Массив;
	ИменаСт.Добавить("Денежные средства (безналичные)");
	ИменаСт.Добавить("Денежные средства (наличные)");
	ИменаСт.Добавить("Денежные средства (у подотчетных лиц)");
	ИменаСт.Добавить("Денежные средства в пути");
	ЗСт.УстановитьПараметр("Имена", ИменаСт);
	СтБезнал = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ПустаяСсылка();
	СтНал    = СтБезнал;
	СтПодотч = СтБезнал;
	СтВПути  = СтБезнал;
	ВыбСт = ЗСт.Выполнить().Выбрать();
	Пока ВыбСт.Следующий() Цикл
		Если ВыбСт.Н = "Денежные средства (безналичные)" Тогда
			СтБезнал = ВыбСт.С;
		ИначеЕсли ВыбСт.Н = "Денежные средства (наличные)" Тогда
			СтНал = ВыбСт.С;
		ИначеЕсли ВыбСт.Н = "Денежные средства (у подотчетных лиц)" Тогда
			СтПодотч = ВыбСт.С;
		ИначеЕсли ВыбСт.Н = "Денежные средства в пути" Тогда
			СтВПути = ВыбСт.С;
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Орг",       СтруктураШапки.Организация);
	Запрос.УстановитьПараметр("НачМес",    СтруктураШапки.НачМес);
	Запрос.УстановитьПараметр("КонМес",    СтруктураШапки.КонМес);
	Запрос.УстановитьПараметр("Искл",      ИсключенныеСтатьи());
	Запрос.УстановитьПараметр("МассивИст", МассивИст);
	Запрос.УстановитьПараметр("ИстБезнал", ИстБезнал);
	Запрос.УстановитьПараметр("ИстНал",    ИстНал);
	Запрос.УстановитьПараметр("ИстПодотч", ИстПодотч);
	Запрос.УстановитьПараметр("ИстВПути",  ИстВПути);
	Запрос.УстановитьПараметр("СтБезнал",  СтБезнал);
	Запрос.УстановитьПараметр("СтНал",     СтНал);
	Запрос.УстановитьПараметр("СтПодотч",  СтПодотч);
	Запрос.УстановитьПараметр("СтВПути",   СтВПути);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Б.Организация КАК Организация,
	|	ЕСТЬNULL(Б.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	&СтБезнал КАК Статья,
	|	&ИстБезнал КАК Source,
	|	Б.БанковскийСчет КАК ДенежныеСредства,
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ФизическоеЛицо,
	|	СУММА(Б.СуммаУпрНачальныйОстаток) КАК СуммаНачальныйОстаток,
	|	СУММА(Б.СуммаУпрКонечныйОстаток) КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ втДС
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваБезналичные.ОстаткиИОбороты(&НачМес, &КонМес, , , Организация = &Орг) КАК Б
	|СГРУППИРОВАТЬ ПО
	|	Б.Организация,
	|	ЕСТЬNULL(Б.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	Б.БанковскийСчет
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Н.Организация,
	|	ЕСТЬNULL(Н.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	&СтНал,
	|	&ИстНал,
	|	Н.Касса,
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка),
	|	СУММА(Н.СуммаУпрНачальныйОстаток),
	|	СУММА(Н.СуммаУпрКонечныйОстаток)
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваНаличные.ОстаткиИОбороты(&НачМес, &КонМес, , , Организация = &Орг) КАК Н
	|СГРУППИРОВАТЬ ПО
	|	Н.Организация,
	|	ЕСТЬNULL(Н.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	Н.Касса
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	П.Организация,
	|	ЕСТЬNULL(П.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	&СтПодотч,
	|	&ИстПодотч,
	|	НЕОПРЕДЕЛЕНО,
	|	П.ПодотчетноеЛицо,
	|	СУММА(П.СуммаУпрНачальныйОстаток),
	|	СУММА(П.СуммаУпрКонечныйОстаток)
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваУПодотчетныхЛиц.ОстаткиИОбороты(&НачМес, &КонМес, , , Организация = &Орг) КАК П
	|СГРУППИРОВАТЬ ПО
	|	П.Организация,
	|	ЕСТЬNULL(П.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	П.ПодотчетноеЛицо
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВП.Организация,
	|	ЕСТЬNULL(ВП.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	&СтВПути,
	|	&ИстВПути,
	|	ВЫБОР КОГДА ВП.Получатель = НЕОПРЕДЕЛЕНО ТОГДА ВП.Отправитель ИНАЧЕ ВП.Получатель КОНЕЦ,
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка),
	|	СУММА(ВП.СуммаУпрНачальныйОстаток),
	|	СУММА(ВП.СуммаУпрКонечныйОстаток)
	|ИЗ
	|	РегистрНакопления.ДенежныеСредстваВПути.ОстаткиИОбороты(&НачМес, &КонМес, , , Организация = &Орг) КАК ВП
	|СГРУППИРОВАТЬ ПО
	|	ВП.Организация,
