	|	"""",
	|	ИСТИНА,
	|	ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втПрямСт.НО, 0),
	|	0,
	|	0,
	|	ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втПрямСт.КО, 0)
	|ИЗ
	|	втКлючи КАК К
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПАП КАК втПАП
	|		ПО К.Организация = втПАП.Организация
	|			И К.Подразделение = втПАП.Подразделение
	|			И К.Статья = втПАП.Статья
	|			И К.Source = втПАП.Source
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПрямСт КАК втПрямСт
	|		ПО К.Организация = втПрямСт.Организация
	|			И К.Подразделение = втПрямСт.Подразделение
	|			И К.Статья = втПрямСт.Статья
	|			И К.Source = втПрямСт.Source
	|ГДЕ
	|	ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втПрямСт.НО, 0) > 0.01
	|	ИЛИ ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втПрямСт.НО, 0) < -0.01
	|	ИЛИ ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втПрямСт.КО, 0) > 0.01
	|	ИЛИ ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втПрямСт.КО, 0) < -0.01";
	Отразить_Свод(Запрос.Выполнить().Выгрузить());
	Возврат Истина;
КонецФункции

// Этап 5: «Оплата труда» — расшифровка ПО ФизическоеЛицо через кастомный
// регистр РегистрНакопления.А_ВзаиморасчетыССотрудниками (DONE 2026-05-20).
// Решение пользователя 2026-05-20 (отменяет рішення 2026-05-18 «Без аналитики»):
// добавить расшифровку по ФизЛицу + заполнять Аналитика1=ПРЕДСТАВЛЕНИЕ(ФЛ).
//
// Канон-зеркало Свод_ДенежныеСредства (втВТ/втВТСт/втПАП/втКлючи + плуги).
// Источник=ПустаяСсылка (1 значение для ОТ); signed Приход +Сумма / Расход -Сумма, OD-3.
// ПО ОСТАТКАМ: только НО/КО; Приход=Расход=0; ДокументДвижения пуст (ставит оркестратор).
//
// ⚠️ ИНВЕРСИЯ ЗНАКА: А_ВзСС.signed = −ПАП.signed (А_ВзСС хранит ПРЯМОЙ долг работодателя,
// ПАП — пассивную статью). В втВзСС суммы умножаются на −1 чтобы получить ПАП-формат signed.
//
// Источник ФизЛица: РегистрНакопления.А_ВзаиморасчетыССотрудниками (балансовый), 3 регистратора
// DONE (ОЗФУ + СБДС + РКО). Подразделение — из самого А_ВзСС (там же как в ПАП).
//
// Инвариант: Σ(детали+плуг) по (Орг,Подр,Статья,Source) == ПАП(Источник=ПустаяСсылка,
// Статья=ОТ, OD-3, signed) до копейки (proved test_balans_oplatatruda_vzs_pretest.py
// 2026-05-20: 748 строк деталей, |Δ НО|=0,00, |Δ КО|=0,00, 100% ФЛ, 0 дублей, 0 расхождений
// по 50 подразделениям).
Функция Свод_ОплатаТруда(СтруктураШапки, Отказ) Экспорт
	ОТ = СтатьяОплатаТруда();
	Если НЕ ЗначениеЗаполнено(ОТ) Тогда
		Возврат Истина;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Орг",    СтруктураШапки.Организация);
	Запрос.УстановитьПараметр("НачМес", СтруктураШапки.НачМес);
	Запрос.УстановитьПараметр("КонМес", СтруктураШапки.КонМес);
	Запрос.УстановитьПараметр("Искл",   ИсключенныеСтатьи());
	Запрос.УстановитьПараметр("ОТ",     ОТ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВзСС.Организация КАК Организация,
	|	ЕСТЬNULL(ВзСС.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	&ОТ КАК Статья,
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка) КАК Source,
	|	ВзСС.ФизическоеЛицо КАК ФизическоеЛицо,
	|	СУММА(ВЫБОР КОГДА ВзСС.Период < &НачМес
	|			ТОГДА ВЫБОР КОГДА ВзСС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА -ВзСС.СуммаВзаиморасчетов ИНАЧЕ ВзСС.СуммаВзаиморасчетов КОНЕЦ
	|			ИНАЧЕ 0 КОНЕЦ) КАК СуммаНачальныйОстаток,
	|	СУММА(ВЫБОР КОГДА ВзСС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА -ВзСС.СуммаВзаиморасчетов ИНАЧЕ ВзСС.СуммаВзаиморасчетов КОНЕЦ) КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ втВзСС
	|ИЗ
	|	РегистрНакопления.А_ВзаиморасчетыССотрудниками КАК ВзСС
	|ГДЕ
	|	ВзСС.Организация = &Орг
	|	И ВзСС.Период <= &КонМес
	|СГРУППИРОВАТЬ ПО
	|	ВзСС.Организация,
	|	ЕСТЬNULL(ВзСС.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	ВзСС.ФизическоеЛицо
	|;
	|ВЫБРАТЬ
	|	втВзСС.Организация КАК Организация,
	|	втВзСС.Подразделение КАК Подразделение,
	|	втВзСС.Статья КАК Статья,
	|	втВзСС.Source КАК Source,
	|	СУММА(втВзСС.СуммаНачальныйОстаток) КАК НО,
	|	СУММА(втВзСС.СуммаКонечныйОстаток) КАК КО
	|ПОМЕСТИТЬ втВзССт
	|ИЗ
	|	втВзСС КАК втВзСС
	|СГРУППИРОВАТЬ ПО
	|	втВзСС.Организация, втВзСС.Подразделение, втВзСС.Статья, втВзСС.Source
	|;
	|ВЫБРАТЬ
	|	Т.Организация КАК Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	Т.Статья КАК Статья,
	|	Т.Источник КАК Source,
	|	СУММА(ВЫБОР КОГДА Т.Период < &НачМес
	|			ТОГДА ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ
	|			ИНАЧЕ 0 КОНЕЦ) КАК НО,
	|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ) КАК КО
	|ПОМЕСТИТЬ втПАП
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы КАК Т
	|ГДЕ
	|	Т.Организация = &Орг
	|	И Т.Период <= &КонМес
	|	И Т.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка)
	|	И НЕ Т.Статья В ИЕРАРХИИ(&Искл)
	|	И Т.Статья = &ОТ
	|СГРУППИРОВАТЬ ПО
	|	Т.Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	Т.Статья,
	|	Т.Источник
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	К.Организация КАК Организация,
	|	К.Подразделение КАК Подразделение,
	|	К.Статья КАК Статья,
	|	К.Source КАК Source
	|ПОМЕСТИТЬ втКлючи
	|ИЗ
	|	(ВЫБРАТЬ
	|		втПАП.Организация КАК Организация,
	|		втПАП.Подразделение КАК Подразделение,
	|		втПАП.Статья КАК Статья,
	|		втПАП.Source КАК Source
	|	ИЗ
	|		втПАП КАК втПАП
	|	ОБЪЕДИНИТЬ ВСЕ
	|	ВЫБРАТЬ
	|		втВзССт.Организация,
	|		втВзССт.Подразделение,
	|		втВзССт.Статья,
	|		втВзССт.Source
	|	ИЗ
	|		втВзССт КАК втВзССт) КАК К
	|;
	|ВЫБРАТЬ
	|	втВзСС.Организация КАК Организация,
	|	втВзСС.Подразделение КАК Подразделение,
	|	втВзСС.Статья КАК Статья,
	|	втВзСС.Source КАК Source,
	|	втВзСС.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ПРЕДСТАВЛЕНИЕ(втВзСС.ФизическоеЛицо) КАК Аналитика1,
	|	"""" КАК Аналитика2,
	|	"""" КАК Аналитика3,
	|	ЛОЖЬ КАК Расхождение,
	|	втВзСС.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	|	0 КАК СуммаПриход,
	|	0 КАК СуммаРасход,
	|	втВзСС.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
	|ИЗ
	|	втВзСС КАК втВзСС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	К.Организация,
	|	К.Подразделение,
	|	К.Статья,
	|	К.Source,
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка),
	|	"""",
	|	"""",
	|	"""",
	|	ИСТИНА,
	|	ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втВзССт.НО, 0),
	|	0,
	|	0,
	|	ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втВзССт.КО, 0)
	|ИЗ
	|	втКлючи КАК К
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПАП КАК втПАП
	|		ПО К.Организация = втПАП.Организация
	|			И К.Подразделение = втПАП.Подразделение
	|			И К.Статья = втПАП.Статья
	|			И К.Source = втПАП.Source
	|		ЛЕВОЕ СОЕДИНЕНИЕ втВзССт КАК втВзССт
	|		ПО К.Организация = втВзССт.Организация
	|			И К.Подразделение = втВзССт.Подразделение
	|			И К.Статья = втВзССт.Статья
	|			И К.Source = втВзССт.Source
	|ГДЕ
	|	ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втВзССт.НО, 0) > 0.01
	|	ИЛИ ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втВзССт.НО, 0) < -0.01
	|	ИЛИ ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втВзССт.КО, 0) > 0.01
	|	ИЛИ ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втВзССт.КО, 0) < -0.01";
	Отразить_Свод(Запрос.Выполнить().Выгрузить());
	Возврат Истина;
КонецФункции

