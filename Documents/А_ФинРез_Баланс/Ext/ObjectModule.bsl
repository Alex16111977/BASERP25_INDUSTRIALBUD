	|	К.Source,
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка),
	|	NULL,
	|	"""",
	|	"""",
	|	"""",
	|	ИСТИНА,
	|	ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втПРДСт.НО, 0),
	|	0,
	|	0,
	|	ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втПРДСт.КО, 0)
	|ИЗ
	|	втКлючи КАК К
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПАП КАК втПАП
	|		ПО К.Организация = втПАП.Организация
	|			И К.Подразделение = втПАП.Подразделение
	|			И К.Статья = втПАП.Статья
	|			И К.Source = втПАП.Source
	|		ЛЕВОЕ СОЕДИНЕНИЕ втПРДСт КАК втПРДСт
	|		ПО К.Организация = втПРДСт.Организация
	|			И К.Подразделение = втПРДСт.Подразделение
	|			И К.Статья = втПРДСт.Статья
	|			И К.Source = втПРДСт.Source
	|ГДЕ
	|	ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втПРДСт.НО, 0) > 0.01
	|	ИЛИ ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втПРДСт.НО, 0) < -0.01
	|	ИЛИ ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втПРДСт.КО, 0) > 0.01
	|	ИЛИ ЕСТЬNULL(втПАП.КО, 0) - ЕСТЬNULL(втПРДСт.КО, 0) < -0.01";
	Отразить_Свод(Запрос.Выполнить().Выгрузить());
	Возврат Истина;
КонецФункции

// Прямые движения ПАП: Источник = ПустаяСсылка (НЕ расшифровываются подчинённым
// регистром — 0 JOIN). Статья/знак/Аналитика берутся НАПРЯМУЮ из ОСНОВНОЙ
// таблицы РегистрНакопления.ПрочиеАктивыПассивы (зеркало штатной
// Обработка.ДвиженияАктивовПассивов.ДобавитьТекстЗапросаПрочиеАктивыПассивы:
// ВидИсточника=ПустаяСсылка, Статья=Т.Статья, Аналитика=Т.Аналитика,
// знак Приход +Сумма / Расход -Сумма). Субконто из ПАП.Аналитика через
// ВЫРАЗИТЬ(...) по составным типам: Налоги→ТипНалога (Перечисление.ТипыНалогов),
// Основные средства→ОбъектыЭксплуатации/НематериальныйАктив; «Оплата труда»
// исключена (её ведёт Свод_ОплатаТруда #5). ПО ОСТАТКАМ: только НО/КО;
// Приход=Расход=0; ДокументДвижения пуст (его ставит оркестратор). Инвариант:
// Σ(детали+плуг) по (Орг,Подр,Статья,Source) == ПАП(Источник=ПустаяСсылка, OD-3,
// без «Оплата труда», signed) == Отчет.УправленческийБаланс/Карточка до копейки.
//
// Аналитика1 (COALESCE приоритет):
//   1) ТипНалога (если заповнено) → ПРЕДСТАВЛЕНИЕ(ТипНалога)
//   2) ОбъектыЭксплуатации → ПРЕДСТАВЛЕНИЕ(ОбъектыЭксплуатации)
//   3) НематериальныйАктив → ПРЕДСТАВЛЕНИЕ(НематериальныйАктив)
//   4) Статья = "Прибыли и убытки" → ПРЕДСТАВЛЕНИЕ(Подразделение) (rev 2026-05-20)
//   5) Інакше "" (Капитал, Резервы, Прочие пассивы без субконто залишаються пустими)
// sum-invariant НЕ зачіпається — Аналитика1 проекційне рядкове поле без GROUP BY на ньому.
Функция Свод_ПрочиеАктивыПассивы_Прямой(СтруктураШапки, Отказ) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Орг",    СтруктураШапки.Организация);
	Запрос.УстановитьПараметр("НачМес", СтруктураШапки.НачМес);
	Запрос.УстановитьПараметр("КонМес", СтруктураШапки.КонМес);
	Запрос.УстановитьПараметр("Искл",   ИсключенныеСтатьи());
	Запрос.УстановитьПараметр("ОТ",     СтатьяОплатаТруда());
	Запрос.УстановитьПараметр("ПУ",     СтатьяПрибылиИУбытки());
	Запрос.УстановитьПараметр("РасхТекПер", ПланыВидовХарактеристик.СтатьиАктивовПассивов.НайтиПоНаименованию("Расходы текущего периода"));
	Запрос.УстановитьПараметр("ДохТекПер",  ПланыВидовХарактеристик.СтатьиАктивовПассивов.НайтиПоНаименованию("Доходы текущего периода"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Организация КАК Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	Т.Статья КАК Статья,
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка) КАК Source,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.ОбъектыЭксплуатации), ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка)) КАК ОбъектыЭксплуатации,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.НематериальныеАктивы), ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка)) КАК НематериальныйАктив,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Т.Аналитика КАК Перечисление.ТипыНалогов), ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка)) КАК ТипНалога,
	|	СУММА(ВЫБОР КОГДА Т.Период < &НачМес
	|			ТОГДА ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ
	|			ИНАЧЕ 0 КОНЕЦ) КАК СуммаНачальныйОстаток,
	|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ) КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ втПрям
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы КАК Т
	|ГДЕ
	|	Т.Организация = &Орг
	|	И Т.Период <= &КонМес
	|	И Т.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка)
	|	И НЕ Т.Статья В ИЕРАРХИИ(&Искл)
	|	И Т.Статья <> &ОТ
	|	И Т.Статья <> &РасхТекПер
	|	И Т.Статья <> &ДохТекПер
	|СГРУППИРОВАТЬ ПО
	|	Т.Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	Т.Статья,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.ОбъектыЭксплуатации), ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка)),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.НематериальныеАктивы), ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка)),
	|	ЕСТЬNULL(ВЫРАЗИТЬ(Т.Аналитика КАК Перечисление.ТипыНалогов), ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка))
	|;
	|ВЫБРАТЬ
	|	втПрям.Организация КАК Организация,
	|	втПрям.Подразделение КАК Подразделение,
	|	втПрям.Статья КАК Статья,
	|	втПрям.Source КАК Source,
	|	СУММА(втПрям.СуммаНачальныйОстаток) КАК НО,
	|	СУММА(втПрям.СуммаКонечныйОстаток) КАК КО
	|ПОМЕСТИТЬ втПрямСт
	|ИЗ
	|	втПрям КАК втПрям
	|СГРУППИРОВАТЬ ПО
	|	втПрям.Организация, втПрям.Подразделение, втПрям.Статья, втПрям.Source
	|;
	|ВЫБРАТЬ
	|	Т.Организация КАК Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)) КАК Подразделение,
	|	Т.Статья КАК Статья,
	|	Т.Источник КАК Source,
	|	СУММА(ВЫБОР КОГДА Т.Период < &НачМес
	|			ТОГДА ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ
	|			ИНАЧЕ 0 КОНЕЦ) КАК НО,
	|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ) КАК КО
	|ПОМЕСТИТЬ втПАП
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы КАК Т
	|ГДЕ
	|	Т.Организация = &Орг
	|	И Т.Период <= &КонМес
	|	И Т.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка)
	|	И НЕ Т.Статья В ИЕРАРХИИ(&Искл)
	|	И Т.Статья <> &ОТ
	|	И Т.Статья <> &РасхТекПер
	|	И Т.Статья <> &ДохТекПер
	|СГРУППИРОВАТЬ ПО
	|	Т.Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	Т.Статья,
	|	Т.Источник
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	К.Организация КАК Организация,
	|	К.Подразделение КАК Подразделение,
	|	К.Статья КАК Статья,
	|	К.Source КАК Source
	|ПОМЕСТИТЬ втКлючи
	|ИЗ
	|	(ВЫБРАТЬ
	|		втПАП.Организация КАК Организация,
	|		втПАП.Подразделение КАК Подразделение,
	|		втПАП.Статья КАК Статья,
	|		втПАП.Source КАК Source
	|	ИЗ
	|		втПАП КАК втПАП
	|	ОБЪЕДИНИТЬ ВСЕ
	|	ВЫБРАТЬ
	|		втПрямСт.Организация,
	|		втПрямСт.Подразделение,
	|		втПрямСт.Статья,
	|		втПрямСт.Source
	|	ИЗ
	|		втПрямСт КАК втПрямСт) КАК К
	|;
	|ВЫБРАТЬ
	|	втПрям.Организация КАК Организация,
	|	втПрям.Подразделение КАК Подразделение,
	|	втПрям.Статья КАК Статья,
	|	втПрям.Source КАК Source,
	|	втПрям.ОбъектыЭксплуатации КАК ОбъектыЭксплуатации,
	|	втПрям.НематериальныйАктив КАК НематериальныйАктив,
	|	втПрям.ТипНалога КАК ТипНалога,
	|	ВЫБОР КОГДА втПрям.ТипНалога <> ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка) ТОГДА ПРЕДСТАВЛЕНИЕ(втПрям.ТипНалога) КОГДА втПрям.ОбъектыЭксплуатации <> ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка) ТОГДА ПРЕДСТАВЛЕНИЕ(втПрям.ОбъектыЭксплуатации) КОГДА втПрям.НематериальныйАктив <> ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка) ТОГДА ПРЕДСТАВЛЕНИЕ(втПрям.НематериальныйАктив) КОГДА втПрям.Статья = &ПУ ТОГДА ПРЕДСТАВЛЕНИЕ(втПрям.Подразделение) ИНАЧЕ """" КОНЕЦ КАК Аналитика1,
	|	"""" КАК Аналитика2,
	|	"""" КАК Аналитика3,
	|	ЛОЖЬ КАК Расхождение,
	|	втПрям.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	|	0 КАК СуммаПриход,
	|	0 КАК СуммаРасход,
