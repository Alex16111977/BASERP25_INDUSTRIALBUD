	|			И К.Статья = втПАП.Статья
	|			И К.Source = втПАП.Source
	|		ЛЕВОЕ СОЕДИНЕНИЕ втДССт КАК втДССт
	|		ПО К.Организация = втДССт.Организация
	|			И К.Подразделение = втДССт.Подразделение
	|			И К.Статья = втДССт.Статья
	|			И К.Source = втДССт.Source
	|ГДЕ
	|	ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втДССт.НО, 0) > 0.01
	|	ИЛИ ЕСТЬNULL(втПАП.НО, 0) - ЕСТЬNULL(втДССт.НО, 0) < -0.01
