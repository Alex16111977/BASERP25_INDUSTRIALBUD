	|			ИНАЧЕ 0 КОНЕЦ) КАК НО,
	|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ) КАК КО
	|ПОМЕСТИТЬ втПАП
	|ИЗ
	|	РегистрНакопления.ПрочиеАктивыПассивы КАК Т
	|ГДЕ
	|	Т.Организация = &Орг
	|	И Т.Период <= &КонМес
	|	И ((Т.Статья = &РасхТекПер ИЛИ Т.Статья = &ДохТекПер)
	|		ИЛИ (Т.Источник В (&Ист) И Т.Статья <> &РасхТекПер И Т.Статья <> &ДохТекПер))
	|	И НЕ Т.Статья В ИЕРАРХИИ(&Искл)
	|СГРУППИРОВАТЬ ПО
	|	Т.Организация,
	|	ЕСТЬNULL(Т.Подразделение, ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)),
	|	Т.Статья,
	|	ВЫБОР КОГДА Т.Статья = &РасхТекПер ИЛИ Т.Статья = &ДохТекПер
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка)
	|			ИНАЧЕ Т.Источник
	|		КОНЕЦ
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	К.Организация КАК Организация,
	|	К.Подразделение КАК Подразделение,
	|	К.Статья КАК Статья,
	|	К.Source КАК Source
	|ПОМЕСТИТЬ втКлючи
	|ИЗ
	|	(ВЫБРАТЬ
	|		втПАП.Организация КАК Организация,
	|		втПАП.Подразделение КАК Подразделение,
	|		втПАП.Статья КАК Статья,
	|		втПАП.Source КАК Source
	|	ИЗ
	|		втПАП КАК втПАП
	|	ОБЪЕДИНИТЬ ВСЕ
	|	ВЫБРАТЬ
	|		втПРДСт.Организация,
	|		втПРДСт.Подразделение,
	|		втПРДСт.Статья,
	|		втПРДСт.Source
	|	ИЗ
	|		втПРДСт КАК втПРДСт) КАК К
	|;
	|ВЫБРАТЬ
	|	втПРД.Организация КАК Организация,
	|	втПРД.Подразделение КАК Подразделение,
	|	втПРД.Статья КАК Статья,
	|	втПРД.Source КАК Source,
	|	втПРД.ОбъектыЭксплуатации КАК ОбъектыЭксплуатации,
	|	втПРД.НематериальныйАктив КАК НематериальныйАктив,
	|	втПРД.ТипНалога КАК ТипНалога,
	|	втПРД.СтатьяДоходыРасходы КАК СтатьяДоходыРасходы,
	|	ВЫБОР
	|		КОГДА втПРД.СтатьяДоходыРасходы ЕСТЬ НЕ NULL ТОГДА ПРЕДСТАВЛЕНИЕ(втПРД.СтатьяДоходыРасходы)
	|		КОГДА втПРД.ТипНалога <> ЗНАЧЕНИЕ(Перечисление.ТипыНалогов.ПустаяСсылка) ТОГДА ПРЕДСТАВЛЕНИЕ(втПРД.ТипНалога)
	|		КОГДА втПРД.ОбъектыЭксплуатации <> ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка) ТОГДА ПРЕДСТАВЛЕНИЕ(втПРД.ОбъектыЭксплуатации)
	|		КОГДА втПРД.НематериальныйАктив <> ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка) ТОГДА ПРЕДСТАВЛЕНИЕ(втПРД.НематериальныйАктив)
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Аналитика1,
	|	"""" КАК Аналитика2,
	|	"""" КАК Аналитика3,
	|	ЛОЖЬ КАК Расхождение,
	|	втПРД.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	|	0 КАК СуммаПриход,
	|	0 КАК СуммаРасход,
	|	втПРД.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
	|ИЗ
	|	втПРД КАК втПРД
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	К.Организация,
