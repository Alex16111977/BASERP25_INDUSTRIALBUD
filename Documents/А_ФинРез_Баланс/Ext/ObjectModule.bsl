#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Перем мТЗСвод;

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Месяц) Тогда
		Месяц = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	НачМесяца = НачалоМесяца(Месяц);
	КонМесяца = КонецМесяца(Месяц);

	ЗапросДубль = Новый Запрос;
	ЗапросДубль.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 ФР.Номер КАК Номер, ФР.Дата КАК Дата
	|ИЗ Документ.А_ФинРез_Баланс КАК ФР
	|ГДЕ ФР.Ссылка <> &ТекущийДок И НЕ ФР.ПометкаУдаления И ФР.Проведен
	|	И ФР.Организация = &Организация
	|	И ФР.Месяц МЕЖДУ &НачМесяца И &КонМесяца
	|	И ФР.ВключатьДочерние = &ВключатьДочерние";
	ЗапросДубль.УстановитьПараметр("ТекущийДок",       Ссылка);
	ЗапросДубль.УстановитьПараметр("Организация",      Организация);
	ЗапросДубль.УстановитьПараметр("НачМесяца",        НачМесяца);
	ЗапросДубль.УстановитьПараметр("КонМесяца",        КонМесяца);
	ЗапросДубль.УстановитьПараметр("ВключатьДочерние", ВключатьДочерние);
	РезДубль = ЗапросДубль.Выполнить();
	Если НЕ РезДубль.Пустой() Тогда
		ВыбДубль = РезДубль.Выбрать(); ВыбДубль.Следующий();
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не можна провести: за %1 (Організація %2) вже проведено документ %3 від %4.",
				Формат(НачМесяца, "ДФ='ММММ yyyy'"), Организация, ВыбДубль.Номер,
				Формат(ВыбДубль.Дата, "ДФ='dd.MM.yyyy'")));
		Отказ = Истина; Возврат;
	КонецЕсли;

	СтруктураШапки = Новый Структура;
	СтруктураШапки.Вставить("Ссылка",           Ссылка);
	СтруктураШапки.Вставить("Дата",             Дата);
	СтруктураШапки.Вставить("НачМес",           НачМесяца);
	СтруктураШапки.Вставить("КонМес",           КонецДня(КонМесяца));
	СтруктураШапки.Вставить("Организация",      Организация);
	СтруктураШапки.Вставить("ВключатьДочерние", ВключатьДочерние);
	ПровестиБалансСвод(СтруктураШапки, Отказ);
КонецПроцедуры

#КонецОбласти

#Область Оркестратор

// Модульная свёртка (канон v2): суммы из ОСНОВНОЙ таблицы ПрочиеАктивыПассивы
// per Источник (Перечисление.ИсточникиУправленческогоБаланса). СверкаСПАП
// приводит Σ по (Орг,Подр,Статья) к ПАП.ОстаткиИОбороты до копейки
// (пропорц. обрезка / добивка пустой аналитики, флаг Расхождение).
// Типовые регистры — ТОЛЬКО ЧТЕНИЕ.
Процедура ПровестиБалансСвод(СтруктураШапки, Отказ) Экспорт
	Движения.А_ОтчетБаланс_Свод.Записывать = Истина;
	мТЗСвод = Движения.А_ОтчетБаланс_Свод.Выгрузить();
	мТЗСвод.Очистить();

	Свод_РасчетыСПартнерами(СтруктураШапки, Отказ);
	Свод_СебестоимостьТоваров(СтруктураШапки, Отказ);
	Свод_ДенежныеСредства(СтруктураШапки, Отказ);
	Свод_ПрочиеРасходыДоходы(СтруктураШапки, Отказ);
	Свод_ПрочиеАктивыПассивы_Прямой(СтруктураШапки, Отказ);
	Свод_ОплатаТруда(СтруктураШапки, Отказ);

	СверкаСПАП(СтруктураШапки);

	мТЗСвод.Свернуть(
		"Организация,Подразделение,Статья,Номенклатура,Контрагент,Партнер,Склад,"
		+ "ОбъектыЭксплуатации,Договор,ФизическоеЛицо,ДенежныеСредства,Source,"
		+ "Расхождение,Аналитика1,Аналитика2,Аналитика3,ОбъектРасчетов,"
		+ "НематериальныйАктив,ДокументДвижения",
		"СуммаНачальныйОстаток,СуммаПриход,СуммаРасход,СуммаКонечныйОстаток");
	Движения.А_ОтчетБаланс_Свод.Загрузить(мТЗСвод);
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИсточников

// Резолв Ссылок Перечисление.ИсточникиУправленческогоБаланса по Представлению
// (имена enum не угадываем — discovery Rule #-1).
Функция _РефыИсточников(МассивПредставлений)
	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ Ссылка КАК С, ПРЕДСТАВЛЕНИЕ(Ссылка) КАК П
	|ИЗ Перечисление.ИсточникиУправленческогоБаланса";
	Цель = Новый Соответствие;
	Для Каждого П Из МассивПредставлений Цикл
		Цель.Вставить(П, Истина);
	КонецЦикла;
	Рез = Новый Массив;
	Выб = З.Выполнить().Выбрать();
	Пока Выб.Следующий() Цикл
		Если Цель[СокрЛП(Выб.П)] = Истина Тогда
			Рез.Добавить(Выб.С);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Универсальное ядро: ОСНОВНАЯ таблица ПАП по набору Источник (или Источник=
// ПустаяСсылка), 4 ресурса = signed Сумма, субконто через ВЫРАЗИТЬ(Аналитика),
// ДокументДвижения=Регистратор, Source=Источник. OD-3 фильтр 3 групп.
// ИсклОТ=Истина — исключить статью «Оплата труда» (её ведёт Свод_ОплатаТруда).
Процедура _СводПоИсточнику(СтруктураШапки, МассивИст, ПустойИсточник, ИсклОТ)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Орг",    СтруктураШапки.Организация);
	Запрос.УстановитьПараметр("НачМес", СтруктураШапки.НачМес);
	Запрос.УстановитьПараметр("КонМес", СтруктураШапки.КонМес);
	Запрос.УстановитьПараметр("ВклДоч", СтруктураШапки.ВключатьДочерние);
	Запрос.УстановитьПараметр("Искл",   ИсключенныеСтатьи());
	Запрос.УстановитьПараметр("ОТ",     СтатьяОплатаТруда());
	Запрос.УстановитьПараметр("Ист",    МассивИст);

	УсловиеИст = ?(ПустойИсточник,
		"Т.Источник = ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка)",
		"Т.Источник В (&Ист)");
	УсловиеОТ = ?(ИсклОТ, " И Т.Статья <> &ОТ", "");

	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Организация КАК Организация,
	|	Т.Подразделение КАК Подразделение,
	|	Т.Статья КАК Статья,
	|	Т.Регистратор КАК ДокументДвижения,
	|	Т.Источник КАК Source,
	|	ЛОЖЬ КАК Расхождение,
	|	ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.Контрагенты) КАК Контрагент,
	|	ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.Партнеры) КАК Партнер,
	|	ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.Склады) КАК Склад,
	|	ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.ОбъектыЭксплуатации) КАК ОбъектыЭксплуатации,
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК Договор,
	|	ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.ФизическиеЛица) КАК ФизическоеЛицо,
	|	НЕОПРЕДЕЛЕНО КАК ДенежныеСредства,
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка) КАК ОбъектРасчетов,
	|	ВЫРАЗИТЬ(Т.Аналитика КАК Справочник.НематериальныеАктивы) КАК НематериальныйАктив,
	|	"""" КАК Аналитика1, """" КАК Аналитика2,
	|	ПРЕДСТАВЛЕНИЕ(Т.Аналитика) КАК Аналитика3,
	|	СУММА(ВЫБОР КОГДА Т.Период < &НачМес
	|		ТОГДА ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ ИНАЧЕ 0 КОНЕЦ) КАК СуммаНачальныйОстаток,
	|	СУММА(ВЫБОР КОГДА Т.Период >= &НачМес И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА Т.Сумма ИНАЧЕ 0 КОНЕЦ) КАК СуммаПриход,
	|	СУММА(ВЫБОР КОГДА Т.Период >= &НачМес И Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|		ТОГДА Т.Сумма ИНАЧЕ 0 КОНЕЦ) КАК СуммаРасход,
	|	СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ) КАК СуммаКонечныйОстаток
	|ИЗ РегистрНакопления.ПрочиеАктивыПассивы КАК Т
	|ГДЕ (ВЫБОР КОГДА &ВклДоч ТОГДА Т.Организация В ИЕРАРХИИ(&Орг)
	|		ИНАЧЕ Т.Организация = &Орг КОНЕЦ)
	|	И Т.Период <= &КонМес
	|	И " + УсловиеИст + "
	|	И НЕ Т.Статья В ИЕРАРХИИ(&Искл)" + УсловиеОТ + "
	|СГРУППИРОВАТЬ ПО Т.Организация, Т.Подразделение, Т.Статья, Т.Регистратор,
	|	Т.Источник, Т.Аналитика
	|ИМЕЮЩИЕ НЕ (СУММА(ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ) = 0
	|	И СУММА(ВЫБОР КОГДА Т.Период < &НачМес
	|		ТОГДА ВЫБОР КОГДА Т.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Т.Сумма ИНАЧЕ -Т.Сумма КОНЕЦ ИНАЧЕ 0 КОНЕЦ) = 0)";
	Отразить_Свод(Запрос.Выполнить().Выгрузить());
КонецПроцедуры

Функция Свод_РасчетыСПартнерами(СтруктураШапки, Отказ) Экспорт
	М = Новый Массив;
	М.Добавить("Расчеты с клиентами по срокам");
	М.Добавить("Расчеты с поставщиками по срокам");
	_СводПоИсточнику(СтруктураШапки, _РефыИсточников(М), Ложь, Истина);
	Возврат Истина;
КонецФункции

Функция Свод_СебестоимостьТоваров(СтруктураШапки, Отказ) Экспорт
	М = Новый Массив; М.Добавить("Себестоимость товаров");
	_СводПоИсточнику(СтруктураШапки, _РефыИсточников(М), Ложь, Истина);
	Возврат Истина;
КонецФункции

Функция Свод_ДенежныеСредства(СтруктураШапки, Отказ) Экспорт
	М = Новый Массив;
	М.Добавить("Денежные средства (безналичные)");
	М.Добавить("Денежные средства (наличные)");
	М.Добавить("Денежные средства в пути");
	М.Добавить("Денежные средства у подотчетных лиц");
	_СводПоИсточнику(СтруктураШапки, _РефыИсточников(М), Ложь, Истина);
	Возврат Истина;
КонецФункции

Функция Свод_ПрочиеРасходыДоходы(СтруктураШапки, Отказ) Экспорт
	М = Новый Массив;
	М.Добавить("Прочие доходы");
	М.Добавить("Прочие расходы");
	М.Добавить("Партии прочих расходов");
	_СводПоИсточнику(СтруктураШапки, _РефыИсточников(М), Ложь, Истина);
	Возврат Истина;
КонецФункции

Функция Свод_ПрочиеАктивыПассивы_Прямой(СтруктураШапки, Отказ) Экспорт
	_СводПоИсточнику(СтруктураШапки, Новый Массив, Истина, Истина);
	Возврат Истина;
КонецФункции

// Етап 4: «Оплата труда» — суммы из ПАП.ОстаткиИОбороты(Статья=&ОТ) разносятся
// по ФизическоеЛицо ∝ |сальдо| ВзаиморасчетыССотрудниками (Σ ваг=1 → Σ==ПАП).
// Орг без ВЗ — 1 строка, ФизЛицо пусто.
Функция Свод_ОплатаТруда(СтруктураШапки, Отказ) Экспорт
	ОТ = СтатьяОплатаТруда();
	Если НЕ ЗначениеЗаполнено(ОТ) Тогда Возврат Истина; КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Орг",    СтруктураШапки.Организация);
	Запрос.УстановитьПараметр("НачМес", СтруктураШапки.НачМес);
	Запрос.УстановитьПараметр("КонМес", СтруктураШапки.КонМес);
	Запрос.УстановитьПараметр("ВклДоч", СтруктураШапки.ВключатьДочерние);
	Запрос.УстановитьПараметр("ОТ",     ОТ);
	Запрос.Текст =
	"ВЫБРАТЬ ВЗ.Организация КАК Организация, ВЗ.ФизическоеЛицо КАК ФизическоеЛицо,
	|	СУММА(ВЫБОР КОГДА ВЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА ВЗ.СуммаВзаиморасчетов ИНАЧЕ -ВЗ.СуммаВзаиморасчетов КОНЕЦ) КАК Сальдо
	|ПОМЕСТИТЬ втЗПС
	|ИЗ РегистрНакопления.ВзаиморасчетыССотрудниками КАК ВЗ
	|ГДЕ ВЗ.Период <= &КонМес
	|СГРУППИРОВАТЬ ПО ВЗ.Организация, ВЗ.ФизическоеЛицо
	|ИМЕЮЩИЕ СУММА(ВЫБОР КОГДА ВЗ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА ВЗ.СуммаВзаиморасчетов ИНАЧЕ -ВЗ.СуммаВзаиморасчетов КОНЕЦ) <> 0
	|;
	|ВЫБРАТЬ С.Организация КАК Организация, С.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВЫБОР КОГДА С.Сальдо < 0 ТОГДА -С.Сальдо ИНАЧЕ С.Сальдо КОНЕЦ КАК Вес
	|ПОМЕСТИТЬ втЗПФ ИЗ втЗПС КАК С
	|;
	|ВЫБРАТЬ Ф.Организация КАК Организация, СУММА(Ф.Вес) КАК СумВес
	|ПОМЕСТИТЬ втЗПО ИЗ втЗПФ КАК Ф СГРУППИРОВАТЬ ПО Ф.Организация
	|;
	|ВЫБРАТЬ
	|	Б.Организация КАК Организация, Б.Подразделение КАК Подразделение,
	|	Б.Статья КАК Статья,
	|	ЗНАЧЕНИЕ(Документ.А_ФинРез_Баланс.ПустаяСсылка) КАК ДокументДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка) КАК Source,
	|	ЛОЖЬ КАК Расхождение,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка) КАК Партнер,
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка) КАК Склад,
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка) КАК ОбъектыЭксплуатации,
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК Договор,
	|	ЗПФ.ФизическоеЛицо КАК ФизическоеЛицо,
	|	НЕОПРЕДЕЛЕНО КАК ДенежныеСредства,
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка) КАК ОбъектРасчетов,
	|	ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка) КАК НематериальныйАктив,
	|	"""" КАК Аналитика1, """" КАК Аналитика2,
	|	ПРЕДСТАВЛЕНИЕ(Б.Аналитика) КАК Аналитика3,
	|	СУММА(Б.СуммаНачальныйОстаток * ЗПФ.Вес / ЗПО.СумВес) КАК СуммаНачальныйОстаток,
	|	СУММА(Б.СуммаПриход * ЗПФ.Вес / ЗПО.СумВес) КАК СуммаПриход,
	|	СУММА(Б.СуммаРасход * ЗПФ.Вес / ЗПО.СумВес) КАК СуммаРасход,
	|	СУММА(Б.СуммаКонечныйОстаток * ЗПФ.Вес / ЗПО.СумВес) КАК СуммаКонечныйОстаток
	|ИЗ РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты(&НачМес, &КонМес, Авто, ,
	|		(ВЫБОР КОГДА &ВклДоч ТОГДА Организация В ИЕРАРХИИ(&Орг)
	|			ИНАЧЕ Организация = &Орг КОНЕЦ) И Статья = &ОТ) КАК Б
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗПО КАК ЗПО ПО Б.Организация = ЗПО.Организация
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗПФ КАК ЗПФ ПО Б.Организация = ЗПФ.Организация
	|СГРУППИРОВАТЬ ПО Б.Организация, Б.Подразделение, Б.Статья, Б.Аналитика,
	|	ЗПФ.ФизическоеЛицо
	|ИМЕЮЩИЕ НЕ (СУММА(Б.СуммаКонечныйОстаток * ЗПФ.Вес / ЗПО.СумВес) = 0
	|	И СУММА(Б.СуммаНачальныйОстаток * ЗПФ.Вес / ЗПО.СумВес) = 0)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Б.Организация, Б.Подразделение, Б.Статья,
	|	ЗНАЧЕНИЕ(Документ.А_ФинРез_Баланс.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Перечисление.ИсточникиУправленческогоБаланса.ПустаяСсылка),
	|	ЛОЖЬ,
	|	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыЭксплуатации.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка),
	|	НЕОПРЕДЕЛЕНО,
	|	ЗНАЧЕНИЕ(Справочник.ОбъектыРасчетов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.НематериальныеАктивы.ПустаяСсылка),
	|	"""", """", ПРЕДСТАВЛЕНИЕ(Б.Аналитика),
	|	СУММА(Б.СуммаНачальныйОстаток), СУММА(Б.СуммаПриход),
	|	СУММА(Б.СуммаРасход), СУММА(Б.СуммаКонечныйОстаток)
	|ИЗ РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты(&НачМес, &КонМес, Авто, ,
	|		(ВЫБОР КОГДА &ВклДоч ТОГДА Организация В ИЕРАРХИИ(&Орг)
	|			ИНАЧЕ Организация = &Орг КОНЕЦ) И Статья = &ОТ) КАК Б
	|	ЛЕВОЕ СОЕДИНЕНИЕ втЗПО КАК ЗПО ПО Б.Организация = ЗПО.Организация
	|ГДЕ ЗПО.Организация ЕСТЬ NULL
	|СГРУППИРОВАТЬ ПО Б.Организация, Б.Подразделение, Б.Статья, Б.Аналитика
	|ИМЕЮЩИЕ НЕ (СУММА(Б.СуммаКонечныйОстаток) = 0 И СУММА(Б.СуммаНачальныйОстаток) = 0)";
	Отразить_Свод(Запрос.Выполнить().Выгрузить());
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедуры

Процедура Отразить_Свод(Таблица) Экспорт
	Для Каждого СтрТЗ Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(мТЗСвод.Добавить(), СтрТЗ);
	КонецЦикла;
КонецПроцедуры

// В 1С:Предприятие нет встроенной Abs() — только в языке запросов.
Функция _Абс(Ч)
	Возврат ?(Ч < 0, -Ч, Ч);
КонецФункции

Функция ИсключенныеСтатьи() Экспорт
	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ Ссылка КАК Ссылка ИЗ ПланВидовХарактеристик.СтатьиАктивовПассивов
	|ГДЕ Наименование В (&Имена)";
	З.УстановитьПараметр("Имена", СтрРазделить(
		"Собственные средства,Доходы текущего периода,Расходы текущего периода", ","));
	Возврат З.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

Функция СтатьяОплатаТруда() Экспорт
	З = Новый Запрос;
	З.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка КАК Ссылка
	|ИЗ ПланВидовХарактеристик.СтатьиАктивовПассивов ГДЕ Наименование = ""Оплата труда""";
	В = З.Выполнить().Выбрать();
	Возврат ?(В.Следующий(), В.Ссылка,
		ПланыВидовХарактеристик.СтатьиАктивовПассивов.ПустаяСсылка());
КонецФункции

// Инвариант: Σ по (Орг,Подр,Статья) в мТЗСвод == ПАП.ОстаткиИОбороты (тот же
// OD-3 фильтр) до копейки. Свод > ПАП → пропорц. обрезка; ПАП > Свод → строка-
// добивка пустой аналитики; затронутые/добивочные строки → Расхождение=Истина.
Процедура СверкаСПАП(СтруктураШапки)
	ЗЭ = Новый Запрос;
	ЗЭ.УстановитьПараметр("Орг",    СтруктураШапки.Организация);
	ЗЭ.УстановитьПараметр("НачМес", СтруктураШапки.НачМес);
	ЗЭ.УстановитьПараметр("КонМес", СтруктураШапки.КонМес);
	ЗЭ.УстановитьПараметр("ВклДоч", СтруктураШапки.ВключатьДочерние);
	ЗЭ.УстановитьПараметр("Искл",   ИсключенныеСтатьи());
	ЗЭ.Текст =
	"ВЫБРАТЬ Б.Организация КАК Организация, Б.Подразделение КАК Подразделение,
	|	Б.Статья КАК Статья,
	|	СУММА(Б.СуммаНачальныйОстаток) КАК НО, СУММА(Б.СуммаПриход) КАК П,
	|	СУММА(Б.СуммаРасход) КАК Р, СУММА(Б.СуммаКонечныйОстаток) КАК КО
	|ИЗ РегистрНакопления.ПрочиеАктивыПассивы.ОстаткиИОбороты(&НачМес, &КонМес, Авто, ,
	|		(ВЫБОР КОГДА &ВклДоч ТОГДА Организация В ИЕРАРХИИ(&Орг)
	|			ИНАЧЕ Организация = &Орг КОНЕЦ)
	|		И НЕ Статья В ИЕРАРХИИ(&Искл)) КАК Б
	|СГРУППИРОВАТЬ ПО Б.Организация, Б.Подразделение, Б.Статья";
	ВыбЭ = ЗЭ.Выполнить().Выбрать();
	Эталон = Новый Соответствие;
	Пока ВыбЭ.Следующий() Цикл
		К = СтрШаблон("%1|%2|%3", ВыбЭ.Организация.УникальныйИдентификатор(),
			ВыбЭ.Подразделение.УникальныйИдентификатор(),
			ВыбЭ.Статья.УникальныйИдентификатор());
		Эталон.Вставить(К, Новый Структура("НО,П,Р,КО",
			ВыбЭ.НО, ВыбЭ.П, ВыбЭ.Р, ВыбЭ.КО));
	КонецЦикла;

	// Σ свода по ключу (Орг,Подр,Статья)
	СводКлюч = Новый Соответствие;
	Для Каждого Стр Из мТЗСвод Цикл
		К = СтрШаблон("%1|%2|%3", Стр.Организация.УникальныйИдентификатор(),
			Стр.Подразделение.УникальныйИдентификатор(),
			Стр.Статья.УникальныйИдентификатор());
		Тек = СводКлюч[К];
		Если Тек = Неопределено Тогда
			Тек = Новый Структура("НО,П,Р,КО", 0, 0, 0, 0);
		КонецЕсли;
		Тек.НО = Тек.НО + Стр.СуммаНачальныйОстаток;
		Тек.П  = Тек.П  + Стр.СуммаПриход;
		Тек.Р  = Тек.Р  + Стр.СуммаРасход;
		Тек.КО = Тек.КО + Стр.СуммаКонечныйОстаток;
		СводКлюч.Вставить(К, Тек);
	КонецЦикла;

	СтатьяОТ = СтатьяОплатаТруда();
	Поля = Новый Массив;
	Поля.Добавить("НО,СуммаНачальныйОстаток");
	Поля.Добавить("П,СуммаПриход");
	Поля.Добавить("Р,СуммаРасход");
	Поля.Добавить("КО,СуммаКонечныйОстаток");

	Для Каждого ЭлЭ Из Эталон Цикл
		К = ЭлЭ.Ключ; ЭтЗнач = ЭлЭ.Значение;
		СвЗнач = СводКлюч[К];
		Если СвЗнач = Неопределено Тогда
			СвЗнач = Новый Структура("НО,П,Р,КО", 0, 0, 0, 0);
		КонецЕсли;
		Части = СтрРазделить(К, "|");
		СтрокиКлюча = Новый Массив;
		Для Каждого Стр Из мТЗСвод Цикл
			Если СтрШаблон("%1|%2|%3", Стр.Организация.УникальныйИдентификатор(),
				Стр.Подразделение.УникальныйИдентификатор(),
				Стр.Статья.УникальныйИдентификатор()) = К Тогда
				СтрокиКлюча.Добавить(Стр);
			КонецЕсли;
		КонецЦикла;

		Для Каждого ПолеПара Из Поля Цикл
			Ч = СтрРазделить(ПолеПара, ",");
			ИмяЭт = Ч[0]; ИмяРес = Ч[1];
			ЦельСум = ЭтЗнач[ИмяЭт];
			ТекСум  = СвЗнач[ИмяЭт];
			Лимит = ?(СтрокиКлюча.Количество() > 0
				И СтрокиКлюча[0].Статья = СтатьяОТ, 1.0, 0.01);
			Дельта = ЦельСум - ТекСум;
			Если _Абс(Дельта) <= Лимит Тогда
				Продолжить;
			КонецЕсли;
			Если _Абс(ТекСум) > _Абс(ЦельСум) И ТекСум <> 0 Тогда
				// расшифровка превышает — пропорц. обрезка
				Кф = ЦельСум / ТекСум;
				Накопл = 0; МаксСтр = Неопределено; МаксАбс = -1;
				Для Каждого Стр Из СтрокиКлюча Цикл
					Нов = Цел(Стр[ИмяРес] * Кф * 100) / 100;
					Стр[ИмяРес] = Нов; Стр.Расхождение = Истина;
					Накопл = Накопл + Нов;
					Если _Абс(Нов) > МаксАбс Тогда
						МаксАбс = _Абс(Нов); МаксСтр = Стр;
					КонецЕсли;
				КонецЦикла;
				Если МаксСтр <> Неопределено Тогда
					МаксСтр[ИмяРес] = МаксСтр[ИмяРес] + (ЦельСум - Накопл);
				КонецЕсли;
			Иначе
				// ПАП больше — добивка пустой аналитики
				НоваяСтрока = мТЗСвод.Добавить();
				НоваяСтрока.Организация  = СтрокиКлюча[0].Организация;
				НоваяСтрока.Подразделение = СтрокиКлюча[0].Подразделение;
				НоваяСтрока.Статья       = СтрокиКлюча[0].Статья;
				НоваяСтрока.Source = Перечисления.ИсточникиУправленческогоБаланса.ПустаяСсылка();
				НоваяСтрока.ДокументДвижения = Документы.А_ФинРез_Баланс.ПустаяСсылка();
				НоваяСтрока.Расхождение  = Истина;
				НоваяСтрока[ИмяРес]      = Дельта;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
