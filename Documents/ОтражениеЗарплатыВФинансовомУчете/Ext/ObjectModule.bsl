#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	ИнициализироватьДокумент(ДанныеЗаполнения);
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	

	ПараметрыУчетнойПолитики = НастройкиНалоговУчетныхПолитикПовтИсп.ДействующиеПараметрыНалоговУчетныхПолитик("УчетнаяПолитикаБухУчета",
		Организация,
		КонецМесяца(ПериодРегистрации));

	Если ПараметрыУчетнойПолитики <> Неопределено Тогда
		ПроводкиПоРаботникам = ПараметрыУчетнойПолитики.ПроводкиПоРаботникам
	КонецЕсли;
	
	Для Каждого Строка Из УдержаннаяЗарплата Цикл
		Если Строка.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПогашениеЗаймов Или
			Строка.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПроцентыПоЗайму Тогда
			Строка.СтатьяАктивовПассивов = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ЗаймыВыданные;
			Строка.АналитикаАктивовПассивов = Неопределено;
		КонецЕсли;
	КонецЦикла;
	

	
	Для Каждого Строка Из НачисленныйНДФЛ Цикл
		ИнтеграцияБЗК.ЗаполнитьТипНалогаОперацииПоЗарплаты(Строка.ТипНалога, Строка.ВидОперации);
	КонецЦикла;
	
	ПроведениеДокументов.ПередЗаписьюДокумента(ЭтотОбъект, РежимЗаписи, РежимПроведения);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	ДополнительныеСвойства.Вставить("РежимЗаписи", РежимЗаписи);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	МассивНепроверяемыхРеквизитов.Добавить("ПериодРегистрации");
	Если Не ЗначениеЗаполнено(ПериодРегистрации) Тогда
		
		ТекстСообщения = НСтр("ru='Поле ""Месяц"" не заполнено';uk='Поле ""Місяць"" не заповнено'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстСообщения,
			,
			"ПериодРегистрацииСтрокой",
			,
			Отказ);
		
	КонецЕсли;
	
	Если НачисленнаяЗарплатаИВзносы.Количество() = 0 И НачисленныйНДФЛ.Количество() = 0
		И УдержаннаяЗарплата.Количество() = 0 И НачисленныеПроцентыПоЗаймам.Количество() = 0 Тогда
		
		ТекстСообщения = НСтр("ru='Списки документа не содержат ни одной строки';uk='Списки документа не містять жодного рядка'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстСообщения,
			ЭтотОбъект,
			,
			,
			Отказ);
		
	КонецЕсли;
	
	Для Каждого Строка Из НачисленнаяЗарплатаИВзносы Цикл
		Если Не ЗначениеЗаполнено(Строка.Сумма) И Не ЗначениеЗаполнено(Строка.ВзносыВсего) Тогда
			
			ТекстСообщения = НСтр("ru='Не заполнена сумма начисления и взносов в строке %1 списка ""Начисления и взносы""';uk='Не заповнена сума нарахування та внесків в рядку %1 списку ""Нарахування та внески""'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка.НомерСтроки),
				ЭтотОбъект,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("НачисленнаяЗарплатаИВзносы", Строка.НомерСтроки, "Сумма"),
				,
				Отказ);
			
		КонецЕсли;
	КонецЦикла;
	
	МассивНепроверяемыхРеквизитов.Добавить("НачисленнаяЗарплатаИВзносы.СпособОтраженияЗарплатыВБухучете");
	
	СтруктураОтбора = Новый Структура("СпособОтраженияЗарплатыВБухучете", Справочники.СпособыОтраженияЗарплатыВБухУчете.ПустаяСсылка());
	НайденныеСтроки = НачисленнаяЗарплатаИВзносы.НайтиСтроки(СтруктураОтбора);
	
	Для Каждого Строка Из НайденныеСтроки Цикл
        
		Если Строка.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ЕжегодныйОтпускОценочныеОбязательстваИРезервы Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru='Не заполнена колонка ""Способ отражения"" в строке %1 списка ""Начисления и взносы""';uk='Не заповнена колонка ""Спосіб відображення"" в рядку %1 списку ""Нарахування та внески""'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка.НомерСтроки),
			ЭтотОбъект,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("НачисленнаяЗарплатаИВзносы", Строка.НомерСтроки, "СпособОтраженияЗарплатыВБухучете"),
			,
			Отказ);
	КонецЦикла;
	
	МассивНепроверяемыхРеквизитов.Добавить("НачисленныйНДФЛ.ПодразделениеПредприятия");
    
    Если ПолучитьФункциональнуюОпцию("ИспользоватьПодразделения") Тогда
    	СтруктураОтбора = Новый Структура("ВидОперации", Перечисления.ВидыОперацийПоЗарплате.НДФЛДоходыКонтрагентов);
    	НайденныеСтроки = НачисленныйНДФЛ.НайтиСтроки(СтруктураОтбора);
    	
    	Для Каждого Строка Из НайденныеСтроки Цикл
    		
    		Если ЗначениеЗаполнено(Строка.ПодразделениеПредприятия) Тогда
    			Продолжить;
    		КонецЕсли;
    		
    		ТекстСообщения = НСтр("ru='Не заполнена колонка ""Подразделение"" в строке %1 списка ""НДФЛ""';uk='Не заповнена колонка ""Підрозділ"" в рядку %1 списку ""ПДФО""'");
    		
    		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
    			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка.НомерСтроки),
    			ЭтотОбъект,
    			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("НачисленныйНДФЛ", Строка.НомерСтроки, "ПодразделениеПредприятия"),
    			,
    			Отказ);
    	КонецЦикла;
    КонецЕсли;
	
	ПроверитьНаличиеБазыРаспределения(Отказ);
	
	Если Сводно Тогда
		МассивНепроверяемыхРеквизитов.Добавить("НачисленныйНДФЛ.ФизическоеЛицо");
	КонецЕсли;
	
	ПланыВидовХарактеристик.СтатьиДоходов.ПроверитьЗаполнениеАналитик(
		ЭтотОбъект, Новый Структура("УдержаннаяЗарплата"), МассивНепроверяемыхРеквизитов, Отказ);
	
	ПланыВидовХарактеристик.СтатьиДоходов.ПроверитьЗаполнениеАналитик(
		ЭтотОбъект, Новый Структура("НачисленныеПроцентыПоЗаймам"), МассивНепроверяемыхРеквизитов, Отказ);
	
	ИспользоватьПрочиеАктивыПассивы = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПрочихАктивовПассивов");
	Для Каждого Строка Из УдержаннаяЗарплата Цикл
		
		Если Строка.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ВозвратИзлишнеВыплаченныхСуммВследствиеСчетныхОшибок
			И Не ЗначениеЗаполнено(Строка.СтатьяДоходов) Тогда
			
			ТекстСообщения = НСтр("ru='Не заполнена колонка ""Статья доходов"" в строке %1 списка ""Удержания""';uk='Не заповнена колонка ""Стаття доходів"" в рядку %1 списку ""Утримання""'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка.НомерСтроки),
				ЭтотОбъект,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("УдержаннаяЗарплата", Строка.НомерСтроки, "СтатьяДоходов"),
				,
				Отказ);
			
		КонецЕсли;
		
		Если Строка.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПогашениеЗаймов Или
			Строка.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ПроцентыПоЗайму Или
			Строка.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.УдержаниеНеизрасходованныхПодотчетныхСумм Или
			Строка.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.ВозвратИзлишнеВыплаченныхСуммВследствиеСчетныхОшибок Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Строка.СтатьяАктивовПассивов) И ИспользоватьПрочиеАктивыПассивы Тогда
			
			ТекстСообщения = НСтр("ru='Не заполнена колонка ""Статья пассивов"" в строке %1 списка ""Удержания""';uk='Не заповнена колонка ""Стаття пасивів"" в рядку %1 списку ""Утримання""'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка.НомерСтроки),
				ЭтотОбъект,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("УдержаннаяЗарплата", Строка.НомерСтроки, "СтатьяАктивовПассивов"),
				,
				Отказ);
			
		КонецЕсли;
	
	КонецЦикла;
	
	МассивНепроверяемыхРеквизитов.Добавить("УдержаннаяЗарплата.СтатьяАктивовПассивов");
	МассивНепроверяемыхРеквизитов.Добавить("УдержаннаяЗарплата.СтатьяДоходов");
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// Инициализация дополнительных свойств для проведения документа
	ПроведениеДокументов.ОбработкаПроведенияДокумента(ЭтотОбъект, Отказ);

	// Кастомное наполнение А_ВзаиморасчетыССотрудниками (расшифровка ОТ по ФизЛицу+Подр)
	// Σ-инвариант per (Орг,Подр) = Σ ПАП(Статья=ОТ, Источник=Пуст) per Регистратор.
	// См. docs/superpowers/plans/2026-05-20-vzs-ozfu-implementation-plan.md
	РегистрыНакопления.А_ВзаиморасчетыССотрудниками.ЗаполнитьИзОтраженияЗП(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнициализацияИЗаполнение

Процедура ИнициализироватьДокумент(ДанныеЗаполнения = Неопределено)
	
	Организация = ЗначениеНастроекПовтИсп.ПолучитьОрганизациюПоУмолчанию(Организация);
	Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры

Процедура ПроверитьНаличиеБазыРаспределения(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НачисленнаяЗарплата.ПодразделениеПредприятия КАК ПодразделениеПредприятия,
	|	НачисленнаяЗарплата.ФизическоеЛицо КАК ФизическоеЛицо,
	|	НачисленнаяЗарплата.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТДанныеДокумента
	|ИЗ
	|	&НачисленнаяЗарплата КАК НачисленнаяЗарплата
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПодразделениеПредприятия,
	|	ФизическоеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТрудозатратыНезавершенногоПроизводства.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &Сводно
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|		ИНАЧЕ ТрудозатратыНезавершенногоПроизводства.Сотрудник
	|	КОНЕЦ КАК ФизическоеЛицо
	|ПОМЕСТИТЬ ВТБазаРаспределения
	|ИЗ
	|	РегистрНакопления.ТрудозатратыНезавершенногоПроизводства КАК ТрудозатратыНезавершенногоПроизводства
	|ГДЕ
	|	ТрудозатратыНезавершенногоПроизводства.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|	И ТрудозатратыНезавершенногоПроизводства.Подразделение В
	|			(ВЫБРАТЬ
	|				Т.ПодразделениеПредприятия
	|			ИЗ
	|				ВТДанныеДокумента КАК Т)
	|	И ТрудозатратыНезавершенногоПроизводства.Организация = &Организация
	|	И ТрудозатратыНезавершенногоПроизводства.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Выработка.Подразделение,
	|	ВЫБОР
	|		КОГДА &Сводно
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|		ИНАЧЕ ТЧСотрудники.Работник
	|	КОНЕЦ
	|ИЗ
    |	Документ.ВыработкаСотрудников.Работники КАК ТЧСотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ВыработкаСотрудников КАК Выработка
	|		ПО ТЧСотрудники.Ссылка = Выработка.Ссылка
	|ГДЕ
	|	Выработка.Подразделение В
	|			(ВЫБРАТЬ
	|				Т.ПодразделениеПредприятия
	|			ИЗ
	|				ВТДанныеДокумента КАК Т)
	|	И Выработка.Проведен
	|	И Выработка.Организация = &Организация
	|	И Выработка.Дата МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Подразделение,
	|	ФизическоеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДанныеДокумента.НомерСтроки КАК НомерСтроки,
	|	ВТДанныеДокумента.ПодразделениеПредприятия КАК ПодразделениеПредприятия,
	|	ВТДанныеДокумента.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПоЗарплате.НачисленоСдельноДоход) КАК ВидОперации
	|ИЗ
	|	ВТДанныеДокумента КАК ВТДанныеДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТБазаРаспределения КАК ВТБазаРаспределения
	|		ПО ВТДанныеДокумента.ПодразделениеПредприятия = ВТБазаРаспределения.Подразделение
	|			И ВТДанныеДокумента.ФизическоеЛицо = ВТБазаРаспределения.ФизическоеЛицо
	|ГДЕ
	|	ВТБазаРаспределения.ФизическоеЛицо ЕСТЬ NULL 
	|	И ВТДанныеДокумента.ПодразделениеПредприятия <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)";
	
	СтруктураОтбора = Новый Структура("ВидОперации", Перечисления.ВидыОперацийПоЗарплате.НачисленоСдельноДоход);
	
	Если Сводно Тогда
		Запрос.УстановитьПараметр("НачисленнаяЗарплата", НачисленнаяЗарплатаИВзносы.Выгрузить(СтруктураОтбора, "ПодразделениеПредприятия, НомерСтроки"));
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НачисленнаяЗарплата.ФизическоеЛицо КАК ФизическоеЛицо", "ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ФизическоеЛицо");
	Иначе
		Запрос.УстановитьПараметр("НачисленнаяЗарплата", НачисленнаяЗарплатаИВзносыПоФизлицам.Выгрузить(СтруктураОтбора, "ПодразделениеПредприятия, ФизическоеЛицо, НомерСтроки"));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НачалоПериода",       НачалоМесяца(ПериодРегистрации));
	Запрос.УстановитьПараметр("ОкончаниеПериода",    КонецМесяца(ПериодРегистрации));
	Запрос.УстановитьПараметр("Организация",         Организация);
	Запрос.УстановитьПараметр("Сводно",              Сводно);
	Запрос.УстановитьПараметр("Ссылка",              Ссылка);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	СтруктураОтбора = Новый Структура("ПодразделениеПредприятия, ВидОперации");	
	
	ТекстСообщенияСводно = НСтр("ru='В подразделении %1 не регистрировалась выработка сотрудников (строка %2 списка ""Начисленная зарплата и взносы"")';uk='У підрозділі %1 не реєструвався виробіток працівників (рядок %2 списку ""Нарахована зарплата та внески"")'");
	ТекстСообщенияДетально = НСтр("ru='Выработка сотрудника %1 в подразделении %2 не регистрировалась (строка %3 списка ""Начисленная зарплата и взносы"")';uk='Виробіток працівника %1 у підрозділі %2 не реєструвався (рядок %3 списку ""Нарахована зарплата та внески"")'");
	
	Пока Выборка.Следующий() Цикл
		
		Если Сводно Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщенияСводно, Выборка.ПодразделениеПредприятия, Выборка.НомерСтроки),
				ЭтотОбъект,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("НачисленнаяЗарплатаИВзносы", Выборка.НомерСтроки, "ПодразделениеПредприятия"),
				,
				Отказ);
			
		Иначе
			
			ЗаполнитьЗначенияСвойств(СтруктураОтбора, Выборка);
			
			НайденныеСтроки = НачисленнаяЗарплатаИВзносы.НайтиСтроки(СтруктураОтбора);
			
			Для Каждого Строка Из НайденныеСтроки Цикл
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщенияДетально, Выборка.ФизическоеЛицо, Строка.ПодразделениеПредприятия, Строка.НомерСтроки),
					ЭтотОбъект,
					ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("НачисленнаяЗарплатаИВзносы", Строка.НомерСтроки, "ПодразделениеПредприятия"),
					,
					Отказ);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти


#Область ЕРП_ПроцедурыИФункции

// Заполнение документа ОтражениеЗарплатыВФинансовомУчете из данных казны
// Источники: А_РаспределениеКазна, А_РаспределениеНалоги, регистр ВзаиморасчетыССотрудниками
// Целевые ТЧ: НачисленнаяЗарплатаИВзносыПоФизлицам, НачисленныйНДФЛ, НачисленнаяЗарплатаИВзносы
Процедура ЗаполнитьОтражениеЗарплатыВФинансовомУчетеИзБазЗП() Экспорт

	// Проверяем наличие исходных данных
	Если А_РаспределениеНалоги.Количество() = 0 Тогда
		ВызватьИсключение "Таблица А_РаспределениеНалоги пуста!";
	КонецЕсли;

	// Подготовка справочных данных (всередині виконається перезавантаження А_РаспределениеКазна з Казни)
	СправочныеДанные = ПодготовитьСправочныеДанные_ОтражениеЗП();

	// Перевірка після завантаження
	Если А_РаспределениеКазна.Количество() = 0 Тогда
		ВызватьИсключение "Таблица А_РаспределениеКазна пуста після завантаження з Казни (нема даних за період документа)!";
	КонецЕсли;

	// Очищаем целевые таблицы
	НачисленнаяЗарплатаИВзносы.Очистить();
	НачисленнаяЗарплатаИВзносыПоФизлицам.Очистить();
	НачисленныйНДФЛ.Очистить();

	// 1. НАЧИСЛЕНИЯ ИЗ НАЛОГОВ: А_РаспределениеНалоги → НачисленнаяЗарплатаИВзносыПоФизлицам
	ЗаполнитьНачисленияИзНалогов_ОтражениеЗП(СправочныеДанные);

	// 2. НАЧИСЛЕНИЯ ЗП: ВзаиморасчетыССотрудниками → НачисленнаяЗарплатаИВзносыПоФизлицам
	ЗаполнитьНачисленияЗПИзРегистра_ОтражениеЗП(СправочныеДанные);

	// 3. НДФЛ: А_РаспределениеНалоги → НачисленныйНДФЛ
	ЗаполнитьНДФЛИзНалогов_ОтражениеЗП(СправочныеДанные);

	// 4. Формируем сводную таблицу
	СформироватьСводнуюТаблицу_ОтражениеЗП();

КонецПроцедуры

#Область ОтражениеЗП_ЗагрузкаИзКазны

// Повне перезавантаження А_РаспределениеКазна з бази Казна (BuhKazn)
// Фільтр: документи РаспределениеЗаработнойПлаты + РаспределениеФ2, де КассаДатаС/КассаДатаПо
// потрапляють у період ПериодРегистрации документа ERP
Процедура ЗагрузитьА_РаспределениеКазна_ОтражениеЗП()

	// Підключаємося до Казни
	Попытка
		V83 = А_ПодключенияБазСервер.УстановитьСоединение("BuhKazn");
	Исключение
		Сообщить("ЗагрузитьА_РаспределениеКазна: Помилка підключення до Казни: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	НачПериода = НачалоМесяца(ПериодРегистрации);
	КонПериода = КонецМесяца(ПериодРегистрации);

	// Запит до БДДС з фільтром по КассаДатаС/КассаДатаПо документів-реєстраторів
	Попытка
		Запрос = V83.NewObject("Запрос");
		Запрос.Текст =
		"ВЫБРАТЬ
		|	БДДС.Подразделение.Код КАК ПодразделениеКод,
		|	БДДС.СтатьяДвиженияДенежныхСредств.Код КАК СтатьяКод,
		|	БДДС.Направление.Код КАК НаправлениеКод,
		|	БДДС.Сотрудник.ИНН КАК СотрудникИНН,
		|	БДДС.Сотрудник.Наименование КАК СотрудникФИО,
		|	БДДС.Сотрудник.Код КАК СотрудникКод,
		|	СУММА(БДДС.Сумма) КАК Сумма,
		|	БДДС.Регистратор.Организация.ЕГРПОУ КАК ОрганизацияЕГРПОУ,
		|	БДДС.Регистратор.Номер КАК НомерДокумента,
		|	ВЫБОР
		|		КОГДА БДДС.Регистратор ССЫЛКА Документ.РаспределениеЗаработнойПлаты
		|			ТОГДА ""А_РаспределениеЗаработнойПлаты""
		|		ИНАЧЕ ""РаспределениеФ2""
		|	КОНЕЦ КАК ВидДокумента
		|ИЗ
		|	РегистрНакопления.БДДС КАК БДДС
		|ГДЕ
		|	(
		|		(БДДС.Регистратор ССЫЛКА Документ.РаспределениеЗаработнойПлаты
		|			И БДДС.Регистратор.КассаДатаС >= &НачПериода
		|			И БДДС.Регистратор.КассаДатаПо <= &КонПериода
		|			И БДДС.Регистратор.Организация.А_ПереносЕРП)
		|		ИЛИ
		|		(БДДС.Регистратор ССЫЛКА Документ.РаспределениеФ2
		|			И БДДС.Регистратор.КассаДатаС >= &НачПериода
		|			И БДДС.Регистратор.КассаДатаПо <= &КонПериода)
		|	)
		|СГРУППИРОВАТЬ ПО
		|	БДДС.Подразделение.Код,
		|	БДДС.СтатьяДвиженияДенежныхСредств.Код,
		|	БДДС.Направление.Код,
		|	БДДС.Сотрудник.ИНН,
		|	БДДС.Сотрудник.Наименование,
		|	БДДС.Сотрудник.Код,
		|	БДДС.Регистратор.Организация.ЕГРПОУ,
		|	БДДС.Регистратор.Номер,
		|	ВЫБОР
		|		КОГДА БДДС.Регистратор ССЫЛКА Документ.РаспределениеЗаработнойПлаты
		|			ТОГДА ""А_РаспределениеЗаработнойПлаты""
		|		ИНАЧЕ ""РаспределениеФ2""
		|	КОНЕЦ";

		Запрос.УстановитьПараметр("НачПериода", НачПериода);
		Запрос.УстановитьПараметр("КонПериода", КонПериода);

		Результат = Запрос.Выполнить();
		// Серіалізуємо ТЗ для передачі в ERP контекст
		ТЗ = Результат.Выгрузить();
		стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗ);
	Исключение
		Сообщить("ЗагрузитьА_РаспределениеКазна: Помилка запиту до Казни: " + ОписаниеОшибки());
		V83 = Неопределено;
		Возврат;
	КонецПопытки;

	V83 = Неопределено;

	// Десеріалізуємо в ERP контексті
	ТаблицаДанных = ЗначениеИзСтрокиВнутр(стр_ТЗ);

	// Очищуємо А_РаспределениеКазна (вирішує проблему дублікатів)
	А_РаспределениеКазна.Очистить();

	// Заповнюємо А_РаспределениеКазна
	КолДодано = 0;
	Для Каждого СтрокаТЗ Из ТаблицаДанных Цикл

		ПодразделениеКод = СокрЛП("" + СтрокаТЗ.ПодразделениеКод);
		Подразделение = Справочники.СтруктураПредприятия.НайтиПоКоду(ПодразделениеКод);

		СтатьяКод = СокрЛП("" + СтрокаТЗ.СтатьяКод);
		СтатьяДДС = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(СтатьяКод);

		НаправлениеКод = СокрЛП("" + СтрокаТЗ.НаправлениеКод);
		НаправлениеДеятельности = Справочники.НаправленияДеятельности.НайтиПоКоду(НаправлениеКод);

		СотрудникИНН = СокрЛП("" + СтрокаТЗ.СотрудникИНН);
		СотрудникФИО = СокрЛП("" + СтрокаТЗ.СотрудникФИО);
		СотрудникКод = СокрЛП("" + СтрокаТЗ.СотрудникКод);

		// Пошук сотрудника по ІНН (може повернути порожньо — автопривʼязка подбає)
		Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
		Если НЕ ПустаяСтрока(СотрудникИНН) Тогда
			НайденныйСотр = Справочники.Сотрудники.НайтиПоРеквизиту("А_КодПоДРФО", СотрудникИНН);
			Если ЗначениеЗаполнено(НайденныйСотр) Тогда
				Сотрудник = НайденныйСотр;
			КонецЕсли;
		КонецЕсли;

		ОрганизацияЕГРПОУ = СокрЛП("" + СтрокаТЗ.ОрганизацияЕГРПОУ);
		ОрганизацияСпр = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", ОрганизацияЕГРПОУ);
		Если НЕ ЗначениеЗаполнено(ОрганизацияСпр) Тогда
			ОрганизацияСпр = ЭтотОбъект.Организация;
		КонецЕсли;

		НомерДокумента = СокрЛП("" + СтрокаТЗ.НомерДокумента);
		ВидДокумента = СокрЛП("" + СтрокаТЗ.ВидДокумента);
		ДокРаспределениеЗП = А_НайтиПоНомеруРаспределение_ОтражениеЗП(НачПериода, КонПериода, НомерДокумента, ВидДокумента);

		НоваяСтрока = А_РаспределениеКазна.Добавить();
		НоваяСтрока.Организация = ОрганизацияСпр;
		НоваяСтрока.Подразделение = Подразделение;
		НоваяСтрока.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
		НоваяСтрока.НаправленияДеятельности = НаправлениеДеятельности;
		НоваяСтрока.Сотрудник = Сотрудник;
		НоваяСтрока.ФИО = СотрудникФИО;
		НоваяСтрока.ИНН = СотрудникИНН;
		НоваяСтрока.КодСотрудникаКазна = СотрудникКод;
		НоваяСтрока.ДокРаспределениеЗП = ДокРаспределениеЗП;
		НоваяСтрока.Сумма = СтрокаТЗ.Сумма;

		КолДодано = КолДодано + 1;
	КонецЦикла;

КонецПроцедуры

// Пошук документа ERP (А_РаспределениеЗаработнойПлаты або РаспределениеФ2) за номером і періодом
Функция А_НайтиПоНомеруРаспределение_ОтражениеЗП(НачПериода, КонПериода, Номер, ВидДокумента)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачПериода", НачПериода);
	Запрос.УстановитьПараметр("КонПериода", КонПериода);
	Запрос.УстановитьПараметр("Номер", Номер);

	Если ВидДокумента = "А_РаспределениеЗаработнойПлаты" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка
		|ИЗ Документ.А_РаспределениеЗаработнойПлаты КАК Д
		|ГДЕ Д.Дата МЕЖДУ &НачПериода И &КонПериода И Д.Номер = &Номер";
	ИначеЕсли ВидДокумента = "РаспределениеФ2" Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка
		|ИЗ Документ.РаспределениеФ2 КАК Д
		|ГДЕ Д.Дата МЕЖДУ &НачПериода И &КонПериода И Д.Номер = &Номер";
	Иначе
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ОтражениеЗП_ПодготовкаДанных

Функция ПодготовитьСправочныеДанные_ОтражениеЗП()

	Данные = Новый Структура;

	// === Повне перезавантаження А_РаспределениеКазна з Казни ===
	// Очищає дублікати і завантажує свіжі дані з фільтром по КассаДатаС/КассаДатаПо
	ЗагрузитьА_РаспределениеКазна_ОтражениеЗП();

	// === Привʼязка сотрудників для рядків А_РаспределениеКазна з порожнім Сотрудником ===
	// Будуємо кеш ФІО → Сотрудник з наявних даних
	КешПоФИО = Новый Соответствие;
	Для Каждого СтрН Из А_РаспределениеНалоги Цикл
		Если ЗначениеЗаполнено(СтрН.Сотрудник) Тогда
			ФИОСотр = СокрЛП(Строка(СтрН.Сотрудник));
			Если НЕ ПустаяСтрока(ФИОСотр) И КешПоФИО[ФИОСотр] = Неопределено Тогда
				КешПоФИО.Вставить(ФИОСотр, СтрН.Сотрудник);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого СтрК Из А_РаспределениеКазна Цикл
		Если ЗначениеЗаполнено(СтрК.Сотрудник) Тогда
			ФИОСотр = СокрЛП(Строка(СтрК.Сотрудник));
			Если НЕ ПустаяСтрока(ФИОСотр) И КешПоФИО[ФИОСотр] = Неопределено Тогда
				КешПоФИО.Вставить(ФИОСотр, СтрК.Сотрудник);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	// Привʼязуємо порожніх
	КолПривязано = 0;
	КолБезСотрДо = 0;
	Для Каждого СтрСч Из А_РаспределениеКазна Цикл
		Если НЕ ЗначениеЗаполнено(СтрСч.Сотрудник) Тогда КолБезСотрДо = КолБезСотрДо + 1; КонецЕсли;
	КонецЦикла;
	Для Каждого СтрК Из А_РаспределениеКазна Цикл
		Если ЗначениеЗаполнено(СтрК.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		ФИОК = СокрЛП(СтрК.ФИО);
		Если ПустаяСтрока(ФИОК) Тогда
			Продолжить;
		КонецЕсли;
		// 1. Шукаємо в кеші по ФІО
		НайдСотр = КешПоФИО[ФИОК];
		// 2. Шукаємо по ІНН (може зʼявився після обміну)
		Если НЕ ЗначениеЗаполнено(НайдСотр) Тогда
			ІННК = СокрЛП(СтрК.ИНН);
			Если НЕ ПустаяСтрока(ІННК) Тогда
				НайдСотр = Справочники.Сотрудники.НайтиПоРеквизиту("А_КодПоДРФО", ІННК);
			КонецЕсли;
		КонецЕсли;
		// 3. Створюємо або знаходимо ФізОсобу + Сотрудника (по ІНН або КодКазна)
		Если НЕ ЗначениеЗаполнено(НайдСотр) Тогда
			ІННК = СокрЛП(СтрК.ИНН);
			КодК = СокрЛП(СтрК.КодСотрудникаКазна);
			НайдСотр = А_Привилегированный.СоздатьСотрудникаИзКазны(ФИОК, ІННК, КодК);
		КонецЕсли;
		Если ЗначениеЗаполнено(НайдСотр) Тогда
			СтрК.Сотрудник = НайдСотр;
			КешПоФИО.Вставить(ФИОК, НайдСотр);
			КолПривязано = КолПривязано + 1;
		КонецЕсли;
	КонецЦикла;
	Сообщить("Привʼязка: привʼязано=" + КолПривязано + " з " + КолБезСотрДо + " порожніх");

	// Собираем всех сотрудников
	ВсеСотрудники = Новый Массив;
	Для Каждого Строка Из А_РаспределениеКазна Цикл
		Если ЗначениеЗаполнено(Строка.Сотрудник) И ВсеСотрудники.Найти(Строка.Сотрудник) = Неопределено Тогда
			ВсеСотрудники.Добавить(Строка.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из А_РаспределениеНалоги Цикл
		Если ЗначениеЗаполнено(Строка.Сотрудник) И ВсеСотрудники.Найти(Строка.Сотрудник) = Неопределено Тогда
			ВсеСотрудники.Добавить(Строка.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	// Додаємо сотрудників з регістру ВзаиморасчетыССотрудниками (Операція 2)
	ЗапросРег = Новый Запрос;
	ЗапросРег.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Взаиморасчеты.Сотрудник КАК Сотрудник
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыССотрудниками КАК Взаиморасчеты
	|ГДЕ
	|	Взаиморасчеты.Период МЕЖДУ &Н И &К
	|	И Взаиморасчеты.Регистратор ССЫЛКА Документ.НачислениеЗарплаты";
	ЗапросРег.УстановитьПараметр("Н", НачалоМесяца(ПериодРегистрации));
	ЗапросРег.УстановитьПараметр("К", КонецМесяца(ПериодРегистрации));
	ВыборкаРег = ЗапросРег.Выполнить().Выбрать();
	Пока ВыборкаРег.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаРег.Сотрудник) И ВсеСотрудники.Найти(ВыборкаРег.Сотрудник) = Неопределено Тогда
			ВсеСотрудники.Добавить(ВыборкаРег.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	// Получаем физические лица
	Данные.Вставить("ФизЛица", ПолучитьФизическиеЛица_ОтражениеЗП(ВсеСотрудники));

	// Группа учета - Зарплата (661)
	Данные.Вставить("ГруппаУчетаЗарплата", Справочники.ГруппыУчетаНачисленийИУдержаний.Зарплата);

	// Виды операций
	Данные.Вставить("ВидОперацииНачислено", Перечисления.ВидыОперацийПоЗарплате.НачисленоДоход);
	Данные.Вставить("ВидОперацииВоенныйСбор", Перечисления.ВидыОперацийПоЗарплате.ВоенныйСбор);
	Данные.Вставить("ВидОперацииНДФЛ", Перечисления.ВидыОперацийПоЗарплате.НДФЛ);

	// Типы налогов
	Данные.Вставить("ТипНалогаВС", Перечисления.ТипыНалогов.ВоенныйСбор);
	Данные.Вставить("ТипНалогаНДФЛ", Перечисления.ТипыНалогов.НДФЛ);

	// Способ отражения по умолчанию (fallback)
	Данные.Вставить("СпособОтраженияПоУмолчанию",
		Справочники.СпособыОтраженияЗарплатыВБухУчете.НайтиПоНаименованию("Зарплата производственного персонала"));

	// Налог "ЕСВ ФОТ" - базовый для всех вариантов ЕСВ
	Данные.Вставить("НалогЕСВФОТ", Справочники.Налоги.НайтиПоНаименованию("ЕСВ ФОТ"));

	// Распределение по подразделениям из Казны
	Данные.Вставить("РаспределениеПоПодразделениям",
		ПодготовитьРаспределениеПоПодразделениям_ОтражениеЗП());

	// Ключ для базовых начислений (где А_Налог пустой)
	Данные.Вставить("КлючБазовыеНачисления", "БазовыеНачисления");

	// Распределение налогов (НДФЛ/ВС) по сотрудникам
	Данные.Вставить("РаспределениеНалоговПоСотрудникам",
		ПодготовитьРаспределениеНалоговПоСотрудникам_ОтражениеЗП());

	// Период для запроса к регистру
	Данные.Вставить("МесяцНачисления", ПериодРегистрации);
	Данные.Вставить("Организация", Организация);

	Возврат Данные;

КонецФункции

Функция ПолучитьФизическиеЛица_ОтражениеЗП(МассивСотрудников)

	Результат = Новый Соответствие;

	Если МассивСотрудников.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка В(&МассивСотрудников)";

	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Сотрудник, Выборка.ФизическоеЛицо);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Распределение по подразделениям из А_РаспределениеКазна
// Возвращает: Соответствие(Сотрудник → Соответствие(Налог/"БазовыеНачисления" → Структура(Подразделения, Итого)))
Функция ПодготовитьРаспределениеПоПодразделениям_ОтражениеЗП()

	Результат = Новый Соответствие;
	КлючБазовые = "БазовыеНачисления";

	Для Каждого СтрокаКазны Из А_РаспределениеКазна Цикл

		Если Не ЗначениеЗаполнено(СтрокаКазны.СтатьяДвиженияДенежныхСредств) Тогда
			Продолжить;
		КонецЕсли;

		Если СтрокаКазны.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Получаем А_Налог из статьи ДДС
		НалогСтатьи = СтрокаКазны.СтатьяДвиженияДенежныхСредств.А_Налог;

		// Получаем СпособОтражения из статьи ДДС
		СпособОтражения = СтрокаКазны.СтатьяДвиженияДенежныхСредств.А_СпособОтраженияЗарплатыВБухучете;

		// Определяем ключ: если А_Налог пустой - используем специальный ключ
		Если ЗначениеЗаполнено(НалогСтатьи) Тогда
			КлючНалога = НалогСтатьи;
		Иначе
			КлючНалога = КлючБазовые;
		КонецЕсли;

		Сотрудник = СтрокаКазны.Сотрудник;
		Подразделение = СтрокаКазны.Подразделение;

		// Получаем или создаем структуру для сотрудника
		ДанныеСотрудника = Результат[Сотрудник];
		Если ДанныеСотрудника = Неопределено Тогда
			ДанныеСотрудника = Новый Соответствие;
			Результат.Вставить(Сотрудник, ДанныеСотрудника);
		КонецЕсли;

		// Получаем или создаем структуру для налога/ключа
		ДанныеНалога = ДанныеСотрудника[КлючНалога];
		Если ДанныеНалога = Неопределено Тогда
			ДанныеНалога = Новый Структура("Подразделения, Итого", Новый Соответствие, 0);
			ДанныеСотрудника.Вставить(КлючНалога, ДанныеНалога);
		КонецЕсли;

		// Получаем или создаем структуру для подразделения
		ДанныеПодразделения = ДанныеНалога.Подразделения[Подразделение];
		Если ДанныеПодразделения = Неопределено Тогда
			ДанныеПодразделения = Новый Структура("Сумма, СпособОтражения", 0, СпособОтражения);
			ДанныеНалога.Подразделения.Вставить(Подразделение, ДанныеПодразделения);
		КонецЕсли;

		// Добавляем сумму
		ДанныеПодразделения.Сумма = ДанныеПодразделения.Сумма + СтрокаКазны.Сумма;

		// Обновляем СпособОтражения если пустой
		Если Не ЗначениеЗаполнено(ДанныеПодразделения.СпособОтражения) И ЗначениеЗаполнено(СпособОтражения) Тогда
			ДанныеПодразделения.СпособОтражения = СпособОтражения;
		КонецЕсли;

		// Увеличиваем итого
		ДанныеНалога.Итого = ДанныеНалога.Итого + СтрокаКазны.Сумма;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Распределение налогов (НДФЛ/ВС) по сотрудникам из А_РаспределениеКазна где СуммаНалогов > 0
// Возвращает: Соответствие(Сотрудник → Структура(Подразделения, Итого))
Функция ПодготовитьРаспределениеНалоговПоСотрудникам_ОтражениеЗП()

	Результат = Новый Соответствие;

	Для Каждого СтрокаКазны Из А_РаспределениеКазна Цикл

		Если СтрокаКазны.СуммаНалогов = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаКазны.СтатьяДвиженияДенежныхСредств) Тогда
			Продолжить;
		КонецЕсли;

		СпособОтражения = СтрокаКазны.СтатьяДвиженияДенежныхСредств.А_СпособОтраженияЗарплатыВБухучете;

		Сотрудник = СтрокаКазны.Сотрудник;
		Подразделение = СтрокаКазны.Подразделение;
		СуммаНалогов = СтрокаКазны.СуммаНалогов;

		// Получаем или создаем структуру для сотрудника
		ДанныеСотрудника = Результат[Сотрудник];
		Если ДанныеСотрудника = Неопределено Тогда
			ДанныеСотрудника = Новый Структура("Подразделения, Итого", Новый Соответствие, 0);
			Результат.Вставить(Сотрудник, ДанныеСотрудника);
		КонецЕсли;

		// Получаем или создаем структуру для подразделения
		ДанныеПодразделения = ДанныеСотрудника.Подразделения[Подразделение];
		Если ДанныеПодразделения = Неопределено Тогда
			ДанныеПодразделения = Новый Структура("Сумма, СпособОтражения", 0, СпособОтражения);
			ДанныеСотрудника.Подразделения.Вставить(Подразделение, ДанныеПодразделения);
		КонецЕсли;

		ДанныеПодразделения.Сумма = ДанныеПодразделения.Сумма + СуммаНалогов;

		Если Не ЗначениеЗаполнено(ДанныеПодразделения.СпособОтражения) И ЗначениеЗаполнено(СпособОтражения) Тогда
			ДанныеПодразделения.СпособОтражения = СпособОтражения;
		КонецЕсли;

		ДанныеСотрудника.Итого = ДанныеСотрудника.Итого + СуммаНалогов;

	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОтражениеЗП_ПоискРаспределения

// Получение данных распределения с fallback:
//   1. Точный НалогДляПоиска
//   2. ЕСВ ФОТ (базовый) если начинается с "ЕСВ ФОТ"
//   3. БазовыеНачисления (где А_Налог пустой)
Функция ПолучитьДанныеРаспределения_ОтражениеЗП(Сотрудник, НалогДляПоиска, СправочныеДанные)

	РаспределениеПоПодразделениям = СправочныеДанные.РаспределениеПоПодразделениям;
	НалогЕСВФОТ = СправочныеДанные.НалогЕСВФОТ;
	КлючБазовые = СправочныеДанные.КлючБазовыеНачисления;

	ДанныеСотрудника = РаспределениеПоПодразделениям[Сотрудник];

	Если ДанныеСотрудника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// 1. Пробуем найти по точному налогу
	Если ЗначениеЗаполнено(НалогДляПоиска) Тогда
		ДанныеНалога = ДанныеСотрудника[НалогДляПоиска];
		Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
			Возврат ДанныеНалога;
		КонецЕсли;
	КонецЕсли;

	// 2. Fallback: если налог начинается с "ЕСВ ФОТ" - ищем по базовому "ЕСВ ФОТ"
	Если ЗначениеЗаполнено(НалогДляПоиска) Тогда
		НаименованиеНалога = Строка(НалогДляПоиска);
		Если СтрНачинаетсяС(НаименованиеНалога, "ЕСВ ФОТ") И ЗначениеЗаполнено(НалогЕСВФОТ) Тогда
			ДанныеНалога = ДанныеСотрудника[НалогЕСВФОТ];
			Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
				Возврат ДанныеНалога;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// 3. Fallback: берем из базовых начислений (где А_Налог пустой)
	ДанныеНалога = ДанныеСотрудника[КлючБазовые];
	Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
		Возврат ДанныеНалога;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Получение данных распределения ТОЛЬКО из базовых начислений (где А_Налог пустой)
Функция ПолучитьДанныеРаспределенияБазовые_ОтражениеЗП(Сотрудник, СправочныеДанные)

	РаспределениеПоПодразделениям = СправочныеДанные.РаспределениеПоПодразделениям;
	КлючБазовые = СправочныеДанные.КлючБазовыеНачисления;

	ДанныеСотрудника = РаспределениеПоПодразделениям[Сотрудник];

	Если ДанныеСотрудника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ДанныеНалога = ДанныеСотрудника[КлючБазовые];
	Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
		Возврат ДанныеНалога;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Получение данных распределения для НДФЛ/ВС
Функция ПолучитьДанныеРаспределенияНалогов_ОтражениеЗП(Сотрудник, СправочныеДанные)

	РаспределениеНалоговПоСотрудникам = СправочныеДанные.РаспределениеНалоговПоСотрудникам;

	ДанныеСотрудника = РаспределениеНалоговПоСотрудникам[Сотрудник];

	Если ДанныеСотрудника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если ДанныеСотрудника.Итого > 0 Тогда
		Возврат ДанныеСотрудника;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ОтражениеЗП_ОбработкаДанных

// Операция 1: А_РаспределениеНалоги → НачисленнаяЗарплатаИВзносыПоФизлицам
Процедура ЗаполнитьНачисленияИзНалогов_ОтражениеЗП(СправочныеДанные)

	Для Каждого СтрокаНалога Из А_РаспределениеНалоги Цикл

		// Определяем сумму и куда записывать
		ЭтоСуммаФОТ = СтрокаНалога.СуммаФОТ <> 0;
		СуммаДляРаспределения = ?(ЭтоСуммаФОТ, СтрокаНалога.СуммаФОТ, СтрокаНалога.Сумма);

		Если СуммаДляРаспределения = 0 Тогда
			Продолжить;
		КонецЕсли;

		Сотрудник = СтрокаНалога.Сотрудник;

		// Если Сумма > 0 и СуммаФОТ = 0 - это НДФЛ/ВС
		ЭтоНДФЛилиВС = СтрокаНалога.Сумма > 0 И СтрокаНалога.СуммаФОТ = 0;

		Если ЭтоНДФЛилиВС Тогда
			ДанныеНалога = ПолучитьДанныеРаспределенияНалогов_ОтражениеЗП(Сотрудник, СправочныеДанные);
		Иначе
			НалогДляПоиска = СтрокаНалога.НалогСтатьяДвиженияДенежныхСредств;
			ДанныеНалога = ПолучитьДанныеРаспределения_ОтражениеЗП(Сотрудник, НалогДляПоиска, СправочныеДанные);
		КонецЕсли;

		Если ДанныеНалога = Неопределено Тогда
			// Нет данных о распределении - создаем одну строку без подразделения
			НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
			ЗаполнитьСтрокуНачисления_ОтражениеЗП(НоваяСтрока, СтрокаНалога,
				СуммаДляРаспределения, Неопределено, Неопределено, ЭтоСуммаФОТ, СправочныеДанные);
			Продолжить;
		КонецЕсли;

		// Распределяем сумму по подразделениям пропорционально
		РаспределитьСуммуПоПодразделениям_ОтражениеЗП(СтрокаНалога,
			СуммаДляРаспределения, ДанныеНалога, ЭтоСуммаФОТ, СправочныеДанные);

	КонецЦикла;

КонецПроцедуры

// Пропорциональное распределение суммы по подразделениям
Процедура РаспределитьСуммуПоПодразделениям_ОтражениеЗП(СтрокаНалога, СуммаДляРаспределения, ДанныеНалога, ЭтоСуммаФОТ, СправочныеДанные)

	Итого = ДанныеНалога.Итого;
	ОстатокСуммы = СуммаДляРаспределения;
	СчетчикПодразделений = 0;
	КоличествоПодразделений = ДанныеНалога.Подразделения.Количество();

	Для Каждого КлючЗначение Из ДанныеНалога.Подразделения Цикл

		Подразделение = КлючЗначение.Ключ;
		ДанныеПодразделения = КлючЗначение.Значение;
		СуммаПодразделения = ДанныеПодразделения.Сумма;
		СпособОтражения = ДанныеПодразделения.СпособОтражения;

		СчетчикПодразделений = СчетчикПодразделений + 1;

		// Рассчитываем сумму для подразделения
		Если СчетчикПодразделений = КоличествоПодразделений Тогда
			// Последнее подразделение - берем остаток
			СуммаДляПодразделения = ОстатокСуммы;
		Иначе
			// Пропорциональное распределение
			Доля = СуммаПодразделения / Итого;
			СуммаДляПодразделения = Окр(СуммаДляРаспределения * Доля, 2);
			ОстатокСуммы = ОстатокСуммы - СуммаДляПодразделения;
		КонецЕсли;

		Если СуммаДляПодразделения = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Создаем строку
		НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
		ЗаполнитьСтрокуНачисления_ОтражениеЗП(НоваяСтрока, СтрокаНалога,
			СуммаДляПодразделения, Подразделение, СпособОтражения, ЭтоСуммаФОТ, СправочныеДанные);

	КонецЦикла;

КонецПроцедуры

// Заполнение одной строки НачисленнаяЗарплатаИВзносыПоФизлицам (из налогов)
Процедура ЗаполнитьСтрокуНачисления_ОтражениеЗП(НоваяСтрока, СтрокаНалога,
	Сумма, Подразделение, СпособОтражения, ЭтоСуммаФОТ, СправочныеДанные)

	НоваяСтрока.Организация = Организация;
	НоваяСтрока.ВидОперации = СправочныеДанные.ВидОперацииНачислено;
	НоваяСтрока.ГруппаУчетаНачислений = СправочныеДанные.ГруппаУчетаЗарплата;
	НоваяСтрока.ФизическоеЛицо = СправочныеДанные.ФизЛица[СтрокаНалога.Сотрудник];

	// СпособОтражения из Казны (или fallback)
	Если ЗначениеЗаполнено(СпособОтражения) Тогда
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СпособОтражения;
	Иначе
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СправочныеДанные.СпособОтраженияПоУмолчанию;
	КонецЕсли;

	// Подразделение
	Если Подразделение <> Неопределено Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;

	// Сумма или ВзносыВсего
	Если ЭтоСуммаФОТ Тогда
		НоваяСтрока.ВзносыВсего = Сумма;
		НоваяСтрока.Сумма = 0;
		НоваяСтрока.Налог = СтрокаНалога.Налог;
	Иначе
		НоваяСтрока.Сумма = Сумма;
		НоваяСтрока.ВзносыВсего = 0;
	КонецЕсли;

КонецПроцедуры

// Операция 2: ВзаиморасчетыССотрудниками → НачисленнаяЗарплатаИВзносыПоФизлицам
Процедура ЗаполнитьНачисленияЗПИзРегистра_ОтражениеЗП(СправочныеДанные)

	// Получаем данные из регистра
	МесяцНачисления = СправочныеДанные.МесяцНачисления;
	НачалоПериода = НачалоМесяца(МесяцНачисления);
	КонецПериода = КонецМесяца(МесяцНачисления);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВзаиморасчетыССотрудниками.Сотрудник КАК Сотрудник,
	|	СУММА(ВзаиморасчетыССотрудниками.СуммаВзаиморасчетов) КАК СуммаВзаиморасчетов
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыССотрудниками КАК ВзаиморасчетыССотрудниками
	|ГДЕ
	|	ВзаиморасчетыССотрудниками.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ВзаиморасчетыССотрудниками.Регистратор ССЫЛКА Документ.НачислениеЗарплаты
	|СГРУППИРОВАТЬ ПО
	|	ВзаиморасчетыССотрудниками.Сотрудник";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;

	Выборка = Результат.Выбрать();

	Пока Выборка.Следующий() Цикл

		Сотрудник = Выборка.Сотрудник;
		СуммаЗП = Выборка.СуммаВзаиморасчетов;

		Если СуммаЗП = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Получаем распределение ТОЛЬКО из базовых начислений
		ДанныеРаспределения = ПолучитьДанныеРаспределенияБазовые_ОтражениеЗП(Сотрудник, СправочныеДанные);

		Если ДанныеРаспределения = Неопределено Тогда
			НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
			ЗаполнитьСтрокуНачисленияЗП_ОтражениеЗП(НоваяСтрока, Сотрудник,
				СуммаЗП, Неопределено, Неопределено, СправочныеДанные);
			Продолжить;
		КонецЕсли;

		// Распределяем сумму ЗП по подразделениям
		Итого = ДанныеРаспределения.Итого;
		ОстатокСуммы = СуммаЗП;
		СчетчикПодразделений = 0;
		КоличествоПодразделений = ДанныеРаспределения.Подразделения.Количество();

		Для Каждого КлючЗначение Из ДанныеРаспределения.Подразделения Цикл

			Подразделение = КлючЗначение.Ключ;
			ДанныеПодразделения = КлючЗначение.Значение;
			СуммаПодразделения = ДанныеПодразделения.Сумма;
			СпособОтражения = ДанныеПодразделения.СпособОтражения;

			СчетчикПодразделений = СчетчикПодразделений + 1;

			Если СчетчикПодразделений = КоличествоПодразделений Тогда
				СуммаДляПодразделения = ОстатокСуммы;
			Иначе
				Доля = СуммаПодразделения / Итого;
				СуммаДляПодразделения = Окр(СуммаЗП * Доля, 2);
				ОстатокСуммы = ОстатокСуммы - СуммаДляПодразделения;
			КонецЕсли;

			Если СуммаДляПодразделения = 0 Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
			ЗаполнитьСтрокуНачисленияЗП_ОтражениеЗП(НоваяСтрока, Сотрудник,
				СуммаДляПодразделения, Подразделение, СпособОтражения, СправочныеДанные);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Заполнение одной строки НачисленнаяЗарплатаИВзносыПоФизлицам (из регистра ЗП)
Процедура ЗаполнитьСтрокуНачисленияЗП_ОтражениеЗП(НоваяСтрока, Сотрудник,
	Сумма, Подразделение, СпособОтражения, СправочныеДанные)

	НоваяСтрока.Организация = Организация;
	НоваяСтрока.ВидОперации = СправочныеДанные.ВидОперацииНачислено;
	НоваяСтрока.ГруппаУчетаНачислений = СправочныеДанные.ГруппаУчетаЗарплата;
	НоваяСтрока.ФизическоеЛицо = СправочныеДанные.ФизЛица[Сотрудник];

	Если ЗначениеЗаполнено(СпособОтражения) Тогда
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СпособОтражения;
	Иначе
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СправочныеДанные.СпособОтраженияПоУмолчанию;
	КонецЕсли;

	Если Подразделение <> Неопределено Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;

	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.ВзносыВсего = 0;

КонецПроцедуры

// Операция 3: А_РаспределениеНалоги → НачисленныйНДФЛ (строки где Сумма > 0)
Процедура ЗаполнитьНДФЛИзНалогов_ОтражениеЗП(СправочныеДанные)

	Для Каждого СтрокаНалога Из А_РаспределениеНалоги Цикл

		Если СтрокаНалога.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		Сотрудник = СтрокаНалога.Сотрудник;
		СуммаНалога = СтрокаНалога.Сумма;

		// Определяем вид операции и тип налога
		Если СтрокаНалога.ТипНалога = СправочныеДанные.ТипНалогаВС Тогда
			ВидОперации = СправочныеДанные.ВидОперацииВоенныйСбор;
			ТипНалога = СправочныеДанные.ТипНалогаВС;
		Иначе
			ВидОперации = СправочныеДанные.ВидОперацииНДФЛ;
			ТипНалога = СправочныеДанные.ТипНалогаНДФЛ;
		КонецЕсли;

		НалогДляПоиска = СтрокаНалога.НалогСтатьяДвиженияДенежныхСредств;
		ДанныеНалога = ПолучитьДанныеРаспределения_ОтражениеЗП(Сотрудник, НалогДляПоиска, СправочныеДанные);

		Если ДанныеНалога = Неопределено Тогда
			НоваяСтрока = НачисленныйНДФЛ.Добавить();
			ЗаполнитьСтрокуНДФЛ_ОтражениеЗП(НоваяСтрока, СтрокаНалога, СуммаНалога,
				Неопределено, Неопределено, ВидОперации, ТипНалога, СправочныеДанные);
			Продолжить;
		КонецЕсли;

		// Распределяем по подразделениям
		Итого = ДанныеНалога.Итого;
		ОстатокСуммы = СуммаНалога;
		СчетчикПодразделений = 0;
		КоличествоПодразделений = ДанныеНалога.Подразделения.Количество();

		Для Каждого КлючЗначение Из ДанныеНалога.Подразделения Цикл

			Подразделение = КлючЗначение.Ключ;
			ДанныеПодразделения = КлючЗначение.Значение;
			СуммаПодразделения = ДанныеПодразделения.Сумма;
			СпособОтражения = ДанныеПодразделения.СпособОтражения;

			СчетчикПодразделений = СчетчикПодразделений + 1;

			Если СчетчикПодразделений = КоличествоПодразделений Тогда
				СуммаДляПодразделения = ОстатокСуммы;
			Иначе
				Доля = СуммаПодразделения / Итого;
				СуммаДляПодразделения = Окр(СуммаНалога * Доля, 2);
				ОстатокСуммы = ОстатокСуммы - СуммаДляПодразделения;
			КонецЕсли;

			Если СуммаДляПодразделения = 0 Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтрока = НачисленныйНДФЛ.Добавить();
			ЗаполнитьСтрокуНДФЛ_ОтражениеЗП(НоваяСтрока, СтрокаНалога, СуммаДляПодразделения,
				Подразделение, СпособОтражения, ВидОперации, ТипНалога, СправочныеДанные);

		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

// Заполнение одной строки НачисленныйНДФЛ
Процедура ЗаполнитьСтрокуНДФЛ_ОтражениеЗП(НоваяСтрока, СтрокаНалога, Сумма,
	Подразделение, СпособОтражения, ВидОперации, ТипНалога, СправочныеДанные)

	НоваяСтрока.Организация = Организация;
	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.ВидОперации = ВидОперации;
	НоваяСтрока.ТипНалога = ТипНалога;
	НоваяСтрока.КодДохода = СтрокаНалога.КодДохода;
	НоваяСтрока.ГруппаУчетаНачислений = СправочныеДанные.ГруппаУчетаЗарплата;
	НоваяСтрока.ФизическоеЛицо = СправочныеДанные.ФизЛица[СтрокаНалога.Сотрудник];

	Если Подразделение <> Неопределено Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;

	Если ЗначениеЗаполнено(СпособОтражения) Тогда
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СпособОтражения;
	Иначе
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СправочныеДанные.СпособОтраженияПоУмолчанию;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

