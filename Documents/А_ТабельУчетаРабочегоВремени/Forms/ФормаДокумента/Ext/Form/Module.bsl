#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьИЗаголовкиКолонок()

	УстановитьПривилегированныйРежим(Истина);

	// Заполненные реквизиты шапки может менять только администратор.
	Если ЗначениеЗаполнено(Объект.БригадаСпр) Тогда
		Элементы.БригадаСпр.ТолькоПросмотр = Не МожноРедактироватьВсеДанные;
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		Элементы.Подразделение.ТолькоПросмотр = Не МожноРедактироватьВсеДанные;
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.НачДата) Тогда
		Элементы.НачДата.ТолькоПросмотр = Не МожноРедактироватьВсеДанные;
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.КонДата) Тогда
		Элементы.КонДата.ТолькоПросмотр = Не МожноРедактироватьВсеДанные;
	КонецЕсли;

	Элементы.ОтработанноеВремяСтавка.Видимость = МожноРедактироватьВсеДанные;
	Элементы.ОтработанноеВремяФОТ.Видимость = МожноРедактироватьВсеДанные;
	Элементы.ОтработанноеВремяВсегоГрн.Видимость = МожноРедактироватьВсеДанные;

	ВыводитьОборудование = Объект.Подразделение.ИспользоватьОборудование
		ИЛИ Объект.БригадаСпр.ИспользоватьОборудование;

	Если ЗначениеЗаполнено(Объект.НачДата) И ЗначениеЗаполнено(Объект.КонДата) Тогда

		ТекДата = Объект.НачДата;
		Сч = 1;
		Пока ТекДата <= Объект.КонДата Цикл

			Если Сч > 31 Тогда
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Некорректный период табеля, больше месяца'"));
				УстановитьПривилегированныйРежим(Ложь);
				Возврат;
			КонецЕсли;

			Элементы["ОтработанноеВремяПервыйЧасов" + Сч].Заголовок = Сч;
			Элементы["ОтработанноеВремя1ВторойЧасов" + Сч].Заголовок = Сч;
			Элементы["ОтработанноеВремяПервыйЧасов" + Сч].Ширина = 4;

			// Прошедшие дни может редактировать только администратор.
			Если ТекДата + 60 * 60 * 24 < НачалоДня(ТекущаяДатаСеанса()) Тогда
				Элементы["ОтработанноеВремяПервыйЧасов" + Сч].ТолькоПросмотр = Не МожноРедактироватьВсеДанные;
				Элементы["ОтработанноеВремя1ВторойЧасов" + Сч].ТолькоПросмотр = Не МожноРедактироватьВсеДанные;
			КонецЕсли;

			ЭлементГруппа = Элементы.Найти("ОтработанноеВремяГруппа" + Сч);
			Если ЭлементГруппа <> Неопределено Тогда
				ЭлементГруппа.Заголовок = Сч;
			КонецЕсли;

			ЭлементОборудование = Элементы.Найти("ОтработанноеВремяЧетвертыйВидВремени" + Сч);
			Если ЭлементОборудование <> Неопределено Тогда
				ЭлементОборудование.Видимость = ВыводитьОборудование;
				Если ВыводитьОборудование Тогда
					ЭлементОборудование.Заголовок = НСтр("ru = 'Обор'");
					ЭлементОборудование.МаксимальнаяШирина = 5;
					Элементы["ОтработанноеВремяПервыйЧасов" + Сч].МаксимальнаяШирина = 5;
				КонецЕсли;
			КонецЕсли;

			ТекДата = ТекДата + 60 * 60 * 24;
			Сч = Сч + 1;

		КонецЦикла;

		// Дни за пределами периода скрываются.
		Пока Сч <= 31 Цикл
			ЭлементГруппа = Элементы.Найти("ОтработанноеВремяГруппа" + Сч);
			Если ЭлементГруппа <> Неопределено Тогда
				ЭлементГруппа.Видимость = Ложь;
			КонецЕсли;
			Элементы["ОтработанноеВремяПервыйЧасов" + Сч].Видимость = Ложь;
			Элементы["ОтработанноеВремя1ВторойЧасов" + Сч].Видимость = Ложь;
			Сч = Сч + 1;
		КонецЦикла;

	Иначе
		Элементы.ОтработанноеВремя.Видимость = Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

