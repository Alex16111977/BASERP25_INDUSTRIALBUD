#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Нарахування відсотків за кредитами власника (Воронцов → проєкти): розрахунок за місяць і генерація
// «Приобретение товаров и услуг» на суми відсотків (стаття «Послуги банків»), як ОУМП генерує платіжки.
// Запити і формула — у загальному модулі А_НачислениеПроцентовПоКредитамСервер.
// Дизайн: docs/superpowers/specs/2026-10-16-nachislenie-procentov-kredit-design.md.

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(МесяцНачисления) Тогда
		МесяцНачисления = НачалоМесяца(ДобавитьМесяц(ТекущаяДатаСеанса(), -1));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СпособЗаполнения) Тогда
		СпособЗаполнения = Перечисления.А_СпособыРасчетаПроцентов.ПоВыплате;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Пользователи.ТекущийПользователь();
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	МесяцНачисления = НачалоМесяца(МесяцНачисления);

	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	Если ЕстьДублиДоговоров() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			"Договір відсотків повторюється в таблиці «Нарахування» — залиште один рядок.", , , , Отказ);
	КонецЕсли;

	Для Каждого СтрокаНачисления Из Начисления Цикл
		Конфликт = А_НачислениеПроцентовПоКредитамСервер.ЕстьДругоеНачисление(Организация, МесяцНачисления,
			СтрокаНачисления.Договор, Ссылка);
		Если ЗначениеЗаполнено(Конфликт) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(
				"Договір «%1» уже нараховано за %2 документом «%3».", СтрокаНачисления.Договор,
				Формат(МесяцНачисления, "ДФ='MMMM yyyy'; Л=uk_UA"), Конфликт), , , , Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Перезаповнює «Нарахування» і «Розшифровку» за місяцем, організацією і способом шапки.
// Рядки зі способом «Вручну» зберігають суму, спосіб і документ нарахування; код рядка і документ нарахування
// існуючих договорів зберігаються, нові рядки отримують наступний код.
//
// Возвращаемое значение:
//  ТаблицаЗначений - непереоформлені виплати «%%» (Документ, Дата, Подразделение, Сумма, Комментарий) для форми.
//
Функция ЗаполнитьНачисления() Экспорт

	МесяцНачисления = НачалоМесяца(МесяцНачисления);
	Данные = А_НачислениеПроцентовПоКредитамСервер.ДанныеЗаполнения(Организация, МесяцНачисления, СпособЗаполнения);

	Вручную = Перечисления.А_СпособыРасчетаПроцентов.Вручную;
	Старые = Начисления.Выгрузить();
	МаксКод = 0;
	Для Каждого Старая Из Старые Цикл
		МаксКод = Макс(МаксКод, Старая.КодСтроки);
	КонецЦикла;

	Начисления.Очистить();
	Для Каждого Новая Из Данные.Начисления Цикл
		СтрокаНачисления = Начисления.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаНачисления, Новая);
		Старая = Старые.Найти(Новая.Договор, "Договор");
		Если Старая = Неопределено Тогда
			МаксКод = МаксКод + 1;
			СтрокаНачисления.КодСтроки = МаксКод;
			Продолжить;
		КонецЕсли;
		СтрокаНачисления.КодСтроки = Старая.КодСтроки;
		СтрокаНачисления.ДокументНачисления = Старая.ДокументНачисления;
		СтрокаНачисления.Комментарий = Старая.Комментарий;
		Если Старая.СпособРасчета = Вручную Тогда
			СтрокаНачисления.СпособРасчета = Вручную;
			СтрокаНачисления.СуммаКНачислению = Старая.СуммаКНачислению;
		КонецЕсли;
	КонецЦикла;

	// Ручний рядок договору, якого цього разу немає в даних (немає ні тіла, ні виплат), не губимо.
	Для Каждого Старая Из Старые Цикл
		Если Старая.СпособРасчета = Вручную И Начисления.Найти(Старая.Договор, "Договор") = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Начисления.Добавить(), Старая);
		КонецЕсли;
	КонецЦикла;

	Расшифровка.Загрузить(Данные.Расшифровка);

	Возврат Данные.Предупреждения;

КонецФункции

// Договір відсотків зустрічається в «Нарахуваннях» більше одного разу.
//
// Возвращаемое значение:
//  Булево - Истина, якщо є дубль.
//
Функция ЕстьДублиДоговоров() Экспорт

	Договоры = Новый Соответствие;
	Для Каждого СтрокаНачисления Из Начисления Цикл
		Если Договоры[СтрокаНачисления.Договор] <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Договоры.Вставить(СтрокаНачисления.Договор, Истина);
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Створює або перезаповнює і проводить «Приобретение товаров и услуг» на кожен рядок із сумою до нарахування.
// Існуюче ПТУ рядка (за документом і договором) використовується повторно — номер не змінюється.
// ПТУ документа, для яких рядка більше немає або сума нульова, знімаються з проведення і помічаються на вилучення.
// Наприкінці документ записується з посиланнями на створені ПТУ.
//
Процедура СоздатьНачисленияНаСервере() Экспорт

	Номенклатура = А_НачислениеПроцентовПоКредитамСервер.НоменклатураПроцентов();
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		ВызватьИсключение СтрШаблон("Немає послуги «%1» — створіть її в довіднику «Номенклатура».",
			А_НачислениеПроцентовПоКредитамСервер.НаименованиеНоменклатурыПроцентов());
	КонецЕсли;

	Если ЭтоНовый() Тогда
		Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	// Без посилання пошук ПТУ за А_НачислениеПроцентовПоКредитам зачепив би всі ПТУ без зв'язку.
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		ВызватьИсключение "Документ нарахування не записано — «Приобретения» не створено.";
	КонецЕсли;

	НачатьТранзакцию();
	Попытка

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	П.Ссылка КАК Ссылка,
		|	П.Договор КАК Договор,
		|	П.Проведен КАК Проведен,
		|	П.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК П
		|ГДЕ
		|	П.А_НачислениеПроцентовПоКредитам = &Документ";
		Запрос.УстановитьПараметр("Документ", Ссылка);
		Существующие = Запрос.Выполнить().Выгрузить();

		Использованные = Новый Соответствие;
		Для Каждого СтрокаНачисления Из Начисления Цикл

			СтрокаНачисления.ДокументНачисления = Документы.ПриобретениеТоваровУслуг.ПустаяСсылка();
			Если СтрокаНачисления.СуммаКНачислению = 0 Тогда
				Продолжить;
			КонецЕсли;

			Найдено = Существующие.Найти(СтрокаНачисления.Договор, "Договор");
			Если Найдено = Неопределено Тогда
				ДокОбъект = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
				ЭтоОбновление = Ложь;
			Иначе
				ДокОбъект = Найдено.Ссылка.ПолучитьОбъект();
				Если Найдено.Проведен Тогда
					ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				Если Найдено.ПометкаУдаления Тогда
					ДокОбъект.УстановитьПометкуУдаления(Ложь);
				КонецЕсли;
				ДокОбъект.Товары.Очистить();
				ЭтоОбновление = Истина;
			КонецЕсли;

			Параметры = А_НачислениеПроцентовПоКредитамСервер.ПараметрыПриобретения(ЭтотОбъект, СтрокаНачисления);
			ЗаполнитьЗначенияСвойств(ДокОбъект, Параметры.Шапка);
			СтрокаТовара = ДокОбъект.Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТовара, Параметры.Товар);
			СтрокаТовара.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);

			СтрокаНачисления.ДокументНачисления = ДокОбъект.Ссылка;
			Использованные.Вставить(ДокОбъект.Ссылка, Истина);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон("%1 приобретение № %2 на суму %3 грн (%4).",
				?(ЭтоОбновление, "Оновлено", "Створено"), ДокОбъект.Номер, Формат(СтрокаНачисления.СуммаКНачислению, "ЧДЦ=2"),
				СтрокаНачисления.Договор));

		КонецЦикла;

		Для Каждого Существующий Из Существующие Цикл
			Если Использованные[Существующий.Ссылка] <> Неопределено ИЛИ Существующий.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			ДокОбъект = Существующий.Ссылка.ПолучитьОбъект();
			Если Существующий.Проведен Тогда
				ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;
			ДокОбъект.УстановитьПометкуУдаления(Истина);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(
				"Приобретение № %1 (%2) більше не потрібне — помічено на вилучення.", ДокОбъект.Номер, Существующий.Договор));
		КонецЦикла;

		Записать(РежимЗаписиДокумента.Запись);
		ЗафиксироватьТранзакцию();

	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
