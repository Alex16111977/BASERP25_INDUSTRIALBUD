 
// ==============================================================================
// Стандартные обработчики событий
// ==============================================================================

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;


КонецПроцедуры

#Область ЕРП_ПроцедурыИФункции

// Заполнение документа А_ОтражениеЗПпоКазне из данных казны
// Джерело: база Казна (BuhKazn), регістр БДДС, документи
//          РаспределениеЗаработнойПлаты + РаспределениеФ2
// Цільова ТЧ: РаспределениеКазна
Процедура ЗаполнитьОтражениеЗарплатыВФинансовомУчетеИзБазЗП() Экспорт

	ЗагрузитьРаспределениеКазна_ОтражениеЗП();

	Если РаспределениеКазна.Количество() = 0 Тогда
		Сообщить("УВАГА: РаспределениеКазна пуста після завантаження з Казни.");
		Возврат;
	КонецЕсли;

	ПривязатьСотрудников_ОтражениеЗП();

КонецПроцедуры

#Область ОтражениеЗП_ЗагрузкаИзКазны

// Повне перезавантаження РаспределениеКазна з бази Казна (BuhKazn)
// Фільтр: документи РаспределениеЗаработнойПлаты + РаспределениеФ2, де КассаДатаС/КассаДатаПо
// потрапляють у період Дата документа ERP (місяць)
//
// Архітектурна основа (підтверджено правилами обміну _Rarzrabotki/ConvertERP/):
//   РаспределениеЗаработнойПлаты (Казна) → А_РаспределениеЗаработнойПлаты (ERP)
//   РаспределениеФ2               (Казна) → РаспределениеФ2               (ERP)
//   Конвертация Даних зберігає UUID 1:1 → пошук документа ERP напряму за UUID реєстратора Казни.
Процедура ЗагрузитьРаспределениеКазна_ОтражениеЗП()

	// Підключаємося до Казни
	СтрокаПодключения = "Srvr=""SQLSERVER"";Ref=""BuhKazn"";Usr=""cfo"";Pwd=""2442""";
	Попытка
		V8 = Новый COMОбъект("V83.COMConnector");
		V83 = V8.Connect(СокрЛП(СтрокаПодключения));
	Исключение
		Сообщить("ЗагрузитьРаспределениеКазна: Помилка підключення до Казни: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	НачПериода = НачалоМесяца(Дата);
	КонПериода = КонецМесяца(Дата);

	// Збираємо рядки (ERP-side структури) — без серіалізації через ЗначениеВСтрокуВнутр,
	// щоб можна було дістати UUID реєстратора, поки COM-зʼєднання ще живе.
	ДанныеРядков = Новый Массив;

	Попытка
		Запрос = V83.NewObject("Запрос");
		// КЛЮЧОВЕ: регістр БДДС Казни МАЄ ГОТОВІ реквізити СуммаНачисления/СуммаФОТ/СуммаНалогов.
		// Документ Казни Документ.РаспределениеЗаработнойПлаты при проведенні записує ці значення
		// напряму (перевірено _Rarzrabotki/Kazna/Documents/РаспределениеЗаработнойПлаты/Ext/ObjectModule.bsl
		// і test_kazna_bdds_fields.py). Тому просто агрегуємо їх без PIVOT-класифікації.
		Запрос.Текст =
		"ВЫБРАТЬ
		|	БДДС.Подразделение.Код КАК ПодразделениеКод,
		|	БДДС.Направление.Код КАК НаправлениеКод,
		|	БДДС.Сотрудник.ИНН КАК СотрудникИНН,
		|	БДДС.Сотрудник.Наименование КАК СотрудникФИО,
		|	БДДС.Сотрудник.Код КАК СотрудникКод,
		|	БДДС.Регистратор.Организация.ЕГРПОУ КАК ОрганизацияЕГРПОУ,
		|	БДДС.Регистратор КАК Регистратор,
		|	БДДС.СтатьяДвиженияДенежныхСредств.Код КАК СтатьяКод,
		|	ВЫБОР
		|		КОГДА БДДС.Регистратор ССЫЛКА Документ.РаспределениеЗаработнойПлаты
		|			ТОГДА ""А_РаспределениеЗаработнойПлаты""
		|		ИНАЧЕ ""РаспределениеФ2""
		|	КОНЕЦ КАК ВидДокумента,
		|	СУММА(БДДС.Сумма) КАК Сумма,
		|	СУММА(БДДС.СуммаНачисления) КАК СуммаНачисления,
		|	СУММА(БДДС.СуммаФОТ) КАК СуммаФОТ,
		|	СУММА(БДДС.СуммаНалогов) КАК СуммаНалогов
		|ИЗ
		|	РегистрНакопления.БДДС КАК БДДС
		|ГДЕ
		|	(
		|		(БДДС.Регистратор ССЫЛКА Документ.РаспределениеЗаработнойПлаты
		|			И БДДС.Регистратор.КассаДатаС >= &НачПериода
		|			И БДДС.Регистратор.КассаДатаПо <= &КонПериода
		|			И БДДС.Регистратор.Организация.А_ПереносЕРП)
		|		ИЛИ
		|		(БДДС.Регистратор ССЫЛКА Документ.РаспределениеФ2
		|			И БДДС.Регистратор.КассаДатаС >= &НачПериода
		|			И БДДС.Регистратор.КассаДатаПо <= &КонПериода)
		|	)
		|СГРУППИРОВАТЬ ПО
		|	БДДС.Подразделение.Код,
		|	БДДС.Направление.Код,
		|	БДДС.Сотрудник.ИНН,
		|	БДДС.Сотрудник.Наименование,
		|	БДДС.Сотрудник.Код,
		|	БДДС.Регистратор.Организация.ЕГРПОУ,
		|	БДДС.Регистратор,
		|	БДДС.СтатьяДвиженияДенежныхСредств.Код,
		|	ВЫБОР
		|		КОГДА БДДС.Регистратор ССЫЛКА Документ.РаспределениеЗаработнойПлаты
		|			ТОГДА ""А_РаспределениеЗаработнойПлаты""
		|		ИНАЧЕ ""РаспределениеФ2""
		|	КОНЕЦ";

		Запрос.УстановитьПараметр("НачПериода", НачПериода);
		Запрос.УстановитьПараметр("КонПериода", КонПериода);

		Результат = Запрос.Выполнить();
		ТЗ = Результат.Выгрузить();

		// Прямий обхід COM-таблиці (без серіалізації) — дістаємо UUID реєстратора.
		// ПАТЕРН: V83.string(...) — єдиний спосіб отримати UUID як рядок з COM-референса
		// (перевірено робочими обробками типу Обработка_ПлатежВЕРП: ключове — англ. lowercase).
		КолРядков = ТЗ.Количество();
		КолУспіх = 0;
		КолПомилок = 0;
		ПершаПомилка = "";
		Для і = 0 По КолРядков - 1 Цикл
			СтрТЗ = ТЗ.Получить(і);

			УИДСтр = "";
			Попытка
				УИДСтр = V83.string(СтрТЗ.Регистратор.УникальныйИдентификатор());
				КолУспіх = КолУспіх + 1;
			Исключение
				КолПомилок = КолПомилок + 1;
				Если ПустаяСтрока(ПершаПомилка) Тогда
					ПершаПомилка = ОписаниеОшибки();
				КонецЕсли;
				УИДСтр = "";
			КонецПопытки;

			СтруктураРяда = Новый Структура;
			СтруктураРяда.Вставить("ПодразделениеКод",    СокрЛП("" + СтрТЗ.ПодразделениеКод));
			СтруктураРяда.Вставить("СтатьяКод",           СокрЛП("" + СтрТЗ.СтатьяКод));
			СтруктураРяда.Вставить("НаправлениеКод",      СокрЛП("" + СтрТЗ.НаправлениеКод));
			СтруктураРяда.Вставить("СотрудникИНН",        СокрЛП("" + СтрТЗ.СотрудникИНН));
			СтруктураРяда.Вставить("СотрудникФИО",        СокрЛП("" + СтрТЗ.СотрудникФИО));
			СтруктураРяда.Вставить("СотрудникКод",        СокрЛП("" + СтрТЗ.СотрудникКод));
			СтруктураРяда.Вставить("Сумма",               Число(СтрТЗ.Сумма));
			СтруктураРяда.Вставить("СуммаНачисления",     Число(СтрТЗ.СуммаНачисления));
			СтруктураРяда.Вставить("СуммаФОТ",            Число(СтрТЗ.СуммаФОТ));
			СтруктураРяда.Вставить("СуммаНалогов",        Число(СтрТЗ.СуммаНалогов));
			СтруктураРяда.Вставить("ОрганизацияЕГРПОУ",   СокрЛП("" + СтрТЗ.ОрганизацияЕГРПОУ));
			СтруктураРяда.Вставить("ВидДокумента",        СокрЛП("" + СтрТЗ.ВидДокумента));
			СтруктураРяда.Вставить("УИДРегистратора",     УИДСтр);

			ДанныеРядков.Добавить(СтруктураРяда);
		КонецЦикла;

		Сообщить("Завантажено з Казни: " + КолРядков + " рядків. UUID витягнуто: " + КолУспіх + ", помилок: " + КолПомилок);
		Если КолПомилок > 0 Тогда
			Сообщить("Перша помилка XMLСтрока: " + ПершаПомилка);
		КонецЕсли;

		// DEBUG: запис діагностики у файл (для Python-тестів, де Сообщить не перехоплюється)
		Попытка
			Файл = Новый ЗаписьТекста("C:\Configuration_downloads\BASERP25\_Rarzrabotki\Python\test\debug_a_otrazhenie.txt", "UTF-8");
			Файл.ЗаписатьСтроку("---ЗагрузитьРаспределениеКазна Diagnostic---");
			Файл.ЗаписатьСтроку("Период: " + Строка(НачПериода) + " .. " + Строка(КонПериода));
			Файл.ЗаписатьСтроку("Рядків з БДДС: " + КолРядков);
			Файл.ЗаписатьСтроку("UUID витягнуто: " + КолУспіх);
			Файл.ЗаписатьСтроку("Помилок XMLСтрока: " + КолПомилок);
			Файл.ЗаписатьСтроку("Перша помилка: " + ПершаПомилка);
			Если КолУспіх > 0 И ДанныеРядков.Количество() > 0 Тогда
				ПершийРядок = ДанныеРядков[0];
				Файл.ЗаписатьСтроку("Приклад UUID[0]: " + ПершийРядок.УИДРегистратора);
				Файл.ЗаписатьСтроку("Приклад ВидДокумента[0]: " + ПершийРядок.ВидДокумента);
			КонецЕсли;
			Файл.Закрыть();
		Исключение
		КонецПопытки;
	Исключение
		Сообщить("ЗагрузитьРаспределениеКазна: Помилка запиту до Казни: " + ОписаниеОшибки());
		V83 = Неопределено;
		V8 = Неопределено;
		Возврат;
	КонецПопытки;

	V83 = Неопределено;
	V8 = Неопределено;

	// Очищуємо РаспределениеКазна (вирішує проблему дублікатів)
	РаспределениеКазна.Очистить();

	КолБезДокументаВERP = 0;

	Для Каждого Ряд Из ДанныеРядков Цикл

		// === Прямий пошук документа ERP за UUID (Конвертация Даних зберігає UUID 1:1) ===
		ДокРаспределениеЗП = А_НайтиДокументПоУИД_ОтражениеЗП(Ряд.УИДРегистратора, Ряд.ВидДокумента);

		Если ДокРаспределениеЗП = Неопределено Тогда
			КолБезДокументаВERP = КолБезДокументаВERP + 1;
		КонецЕсли;

		ПодразделениеКазны         = Справочники.СтруктураПредприятия.НайтиПоКоду(Ряд.ПодразделениеКод);
		СтатьяДДС                  = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду(Ряд.СтатьяКод);
		НаправлениеДеятельности    = Справочники.НаправленияДеятельности.НайтиПоКоду(Ряд.НаправлениеКод);

		// КРИТИЧНО: підрозділ "Главный офис" (00-000043) — це ЗАГЛУШКА у Казні.
		// Реальний підрозділ визначається через А_НаправлениеДеятельности через
		// А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны.
		// Це робиться ОДИН РАЗ при заповненні ТЧ — всі подальші читачі ТЧ
		// (Op 1, Op 2, Op 3, СоздатьДокументНачисления тощо) автоматично
		// отримують вже реальний підрозділ.
		Подразделение = ПодразделениеКазны;
		Если ЗначениеЗаполнено(ПодразделениеКазны) Тогда
			Подразделение = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(
				НаправлениеДеятельности, ПодразделениеКазны);
			Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
				Подразделение = ПодразделениеКазны; // fallback
			КонецЕсли;
		КонецЕсли;

		// Пошук сотрудника по ІНН (порожньо — прив'яжемо в ПривязатьСотрудников_ОтражениеЗП)
		Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
		Если НЕ ПустаяСтрока(Ряд.СотрудникИНН) Тогда
			НайденныйСотр = Справочники.Сотрудники.НайтиПоРеквизиту("А_КодПоДРФО", Ряд.СотрудникИНН);
			Если ЗначениеЗаполнено(НайденныйСотр) Тогда
				Сотрудник = НайденныйСотр;
			КонецЕсли;
		КонецЕсли;

		// ФормаPL: Форма1 (А_РаспределениеЗаработнойПлаты — банк/офіційна) /
		//          Форма2 (РаспределениеФ2 — каса/ЦПХ, управлінська).
		ЭтоФорма2 = (Ряд.ВидДокумента = "РаспределениеФ2");

		Если ЭтоФорма2 Тогда
			// Форма2 завжди на управлінській організації (виплата через касу)
			ОрганизацияСпр = А_Привилегированный.А_ПолучитьОрганизациюУпр();
		Иначе
			ОрганизацияСпр = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", Ряд.ОрганизацияЕГРПОУ);
			Если НЕ ЗначениеЗаполнено(ОрганизацияСпр) Тогда
				ОрганизацияСпр = ЭтотОбъект.Организация;
			КонецЕсли;
		КонецЕсли;

		НоваяСтрока = РаспределениеКазна.Добавить();
		НоваяСтрока.Организация                  = ОрганизацияСпр;
		НоваяСтрока.Подразделение                = Подразделение;
		НоваяСтрока.СтатьяДвиженияДенежныхСредств = СтатьяДДС;
		НоваяСтрока.НаправленияДеятельности      = НаправлениеДеятельности;
		НоваяСтрока.Сотрудник                    = Сотрудник;
		НоваяСтрока.ФИО                          = Ряд.СотрудникФИО;
		НоваяСтрока.ИНН                          = Ряд.СотрудникИНН;
		НоваяСтрока.КодСотрудникаКазна           = Ряд.СотрудникКод;
		Если ДокРаспределениеЗП <> Неопределено Тогда
			НоваяСтрока.ДокРаспределениеЗП = ДокРаспределениеЗП;
		КонецЕсли;
		НоваяСтрока.Сумма                        = Ряд.Сумма;
		НоваяСтрока.СуммаНачисления              = Ряд.СуммаНачисления;
		НоваяСтрока.СуммаФОТ                     = Ряд.СуммаФОТ;
		НоваяСтрока.СуммаНалогов                 = Ряд.СуммаНалогов;
		НоваяСтрока.ФормаPL                      = ?(ЭтоФорма2, Перечисления.А_ФормыPL.Форма2, Перечисления.А_ФормыPL.Форма1);
	КонецЦикла;

	Если КолБезДокументаВERP > 0 Тогда
		Сообщить("Увага: " + КолБезДокументаВERP + " рядків без ДокРаспределениеЗП (документа в ERP не знайдено за UUID)");
	КонецЕсли;

КонецПроцедуры

// Пошук документа ERP за UUID реєстратора з Казни.
// Правила обміну Казна↔ERP (у _Rarzrabotki/ConvertERP/) переносять документи із
// збереженням UUID 1:1, тому прямий перехід по UUID — найнадійніший спосіб знайти відповідник.
// Перевірка існування робиться через ПолучитьОбъект() — захист від битих посилань.
Функция А_НайтиДокументПоУИД_ОтражениеЗП(УИДСтрока, ВидДокумента)

	Если ПустаяСтрока(УИДСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		УИД = Новый УникальныйИдентификатор(УИДСтрока);

		Если ВидДокумента = "А_РаспределениеЗаработнойПлаты" Тогда
			ДокСсылка = Документы.А_РаспределениеЗаработнойПлаты.ПолучитьСсылку(УИД);
		ИначеЕсли ВидДокумента = "РаспределениеФ2" Тогда
			ДокСсылка = Документы.РаспределениеФ2.ПолучитьСсылку(УИД);
		Иначе
			Возврат Неопределено;
		КонецЕсли;

		// Перевірка: документ фізично існує в ERP (не бите посилання)
		Если ДокСсылка.ПолучитьОбъект() <> Неопределено Тогда
			Возврат ДокСсылка;
		КонецЕсли;
	Исключение
		// Невалідний UUID або виключна ситуація при завантаженні об'єкта
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ОтражениеЗП_ПривязкаСотрудников

// Привʼязка сотрудників у рядках РаспределениеКазна з порожнім полем Сотрудник.
// 1. Кеш ФІО → Сотрудник з уже заповнених рядків
// 2. Пошук по ІНН через А_КодПоДРФО
// 3. Автостворення через А_Привилегированный.СоздатьСотрудникаИзКазны
Процедура ПривязатьСотрудников_ОтражениеЗП()

	КешПоФИО = Новый Соответствие;
	Для Каждого СтрК Из РаспределениеКазна Цикл
		Если ЗначениеЗаполнено(СтрК.Сотрудник) Тогда
			ФИОСотр = СокрЛП(Строка(СтрК.Сотрудник));
			Если НЕ ПустаяСтрока(ФИОСотр) И КешПоФИО[ФИОСотр] = Неопределено Тогда
				КешПоФИО.Вставить(ФИОСотр, СтрК.Сотрудник);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	КолПривязано = 0;
	КолБезСотрДо = 0;
	Для Каждого СтрСч Из РаспределениеКазна Цикл
		Если НЕ ЗначениеЗаполнено(СтрСч.Сотрудник) Тогда
			КолБезСотрДо = КолБезСотрДо + 1;
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрК Из РаспределениеКазна Цикл
		Если ЗначениеЗаполнено(СтрК.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		ФИОК = СокрЛП(СтрК.ФИО);
		Если ПустаяСтрока(ФИОК) Тогда
			Продолжить;
		КонецЕсли;
		// 1. Шукаємо в кеші по ФІО
		НайдСотр = КешПоФИО[ФИОК];
		// 2. Шукаємо по ІНН (міг зʼявитися після обміну)
		Если НЕ ЗначениеЗаполнено(НайдСотр) Тогда
			ІННК = СокрЛП(СтрК.ИНН);
			Если НЕ ПустаяСтрока(ІННК) Тогда
				НайдСотр = Справочники.Сотрудники.НайтиПоРеквизиту("А_КодПоДРФО", ІННК);
			КонецЕсли;
		КонецЕсли;
		// 3. Створюємо або знаходимо ФізОсобу + Сотрудника
		Если НЕ ЗначениеЗаполнено(НайдСотр) Тогда
			ІННК = СокрЛП(СтрК.ИНН);
			КодК = СокрЛП(СтрК.КодСотрудникаКазна);
			НайдСотр = А_Привилегированный.СоздатьСотрудникаИзКазны(ФИОК, ІННК, КодК);
		КонецЕсли;
		Если ЗначениеЗаполнено(НайдСотр) Тогда
			СтрК.Сотрудник = НайдСотр;
			КешПоФИО.Вставить(ФИОК, НайдСотр);
			КолПривязано = КолПривязано + 1;
		КонецЕсли;
	КонецЦикла;

	Сообщить("Привʼязка сотрудників: " + КолПривязано + " з " + КолБезСотрДо + " порожніх");

КонецПроцедуры

#КонецОбласти

#КонецОбласти   

#Область ЕРП_ЗагрузкаИзЗУП

// Заповнення ТЧ НалогиБухгалтерия + УдержанияБухгалтерия даними з бази ZUP_1 (BAS ЗУП 2.1).
//
// Джерела (ZUP_1):
//   1. РегистрНакопления.ВзаиморасчетыПоНДФЛ (НДФЛ + Военный сбор) — основа для НалогиБухгалтерия
//   2. РегистрРасчета.ВзносыВФонды (ЕСВ) — основа для НалогиБухгалтерия
//   3. РегистрРасчета.УдержанияРаботниковОрганизаций + Документ.ИсполнительныйЛист (виконавчий лист з Получателем) — основа для УдержанияБухгалтерия
//
// Цільові ТЧ у цьому документі:
//   НалогиБухгалтерия         — НДФЛ/ВС/ЕСВ
//   УдержанияБухгалтерия      — аліменти/виконавчі листи (шаблон проводок Дт 661 / Кт 6853)
//
// Патерн проводок для удержаний (перевірено на стандартному 000Ц-000002):
//   ВидОперации             = Перечисления.ВидыОперацийПоЗарплате.АлиментыПрочиеИсполнительныеЛисты
//   СтатьяАктивовПассивов   = "Прочие пассивы"
//   СчетУчета               = 6853
//   Субконто1               = Контрагент (Получатель виконавчого листа)
//   ГруппаУчетаНачислений   = "Зарплата"
//   Поле Контрагент ТЧ НЕ заповнюємо (у стандарті воно теж порожнє).
Процедура ЗагрузитьНалогиИУдержанияИзЗарплатыБух() Экспорт

	// 1. Перевірка заповнення документа
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		ВызватьИсключение "У документі не заповнено Дата!";
	КонецЕсли;

	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода  = КонецМесяца(Дата);

	// 2. Масив ЄДРПОУ організацій ERP з флагом А_ВБалансе = Истина
	ЗапросОрганизаций = Новый Запрос;
	ЗапросОрганизаций.Текст =
	"ВЫБРАТЬ
	|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.А_ВБалансе = ИСТИНА
	|	И Организации.КодПоЕДРПОУ <> """"";
	масКодПоЕДРПОУ = Новый Массив;
	ВыборкаОрг = ЗапросОрганизаций.Выполнить().Выбрать();
	Пока ВыборкаОрг.Следующий() Цикл
		масКодПоЕДРПОУ.Добавить(ВыборкаОрг.КодПоЕДРПОУ);
	КонецЦикла;
	Если масКодПоЕДРПОУ.Количество() = 0 Тогда
		ВызватьИсключение "Немає організацій з флагом А_ВБалансе — нічого завантажувати.";
	КонецЕсли;

	// 3. Підключення до ZUP_1
	СтрокаПодключенияЗУП = "Srvr=""SQLSERVER"";Ref=""zup_1"";Usr=""cfo"";Pwd=""2442""";
	Попытка
		V8 = Новый COMОбъект("V83.COMConnector");
		V83 = V8.Connect(СокрЛП(СтрокаПодключенияЗУП));
	Исключение
		ВызватьИсключение "Помилка підключення до ZUP_1: " + ОписаниеОшибки();
	КонецПопытки;

	// Переносимо масив ЄДРПОУ у контекст V83
	масКодПоЕДРПОУ_V83 = V83.NewObject("Массив");
	Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
		масКодПоЕДРПОУ_V83.Добавить(КодЕДРПОУ);
	КонецЦикла;

	// 4. ЗАПИТ 1 — Налоги (НДФЛ + ВС + ЕСВ). Текст 1:1 з існуючої обробки
	ТекстЗапросаНалогов =
	"ВЫБРАТЬ
	|	ВзаиморасчетыПоНДФЛ.Сотрудник.Физлицо.КодПоДРФО КАК СотрудникИНН,
	|	ВзаиморасчетыПоНДФЛ.Сотрудник.Физлицо.Наименование КАК СотрудникНаименование,
	|	СУММА(ВзаиморасчетыПоНДФЛ.НалогПриход) КАК СуммаНалога,
	|	СУММА(ВзаиморасчетыПоНДФЛ.ДоходПриход) КАК СуммаДохода,
	|	ВложенныйЗапрос.КодПоЕДРПОУ КАК КодПоЕДРПОУ,
	|	ВзаиморасчетыПоНДФЛ.ДоходНДФЛ.Код КАК КодДохода,
	|	0 КАК СуммаФОТ,
	|	0 КАК СуммаБазы,
	|	""ВоенныйСбор"" КАК КодНалогаСтатьяДенег,
	|	""ВоенныйСбор"" КАК КодНалога
	|ИЗ
	|	РегистрНакопления.ВзаиморасчетыПоНДФЛ.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ВзаиморасчетыПоНДФЛ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КодыОрганизацииСрезПоследних.Организация КАК Организация,
	|			КодыОрганизацииСрезПоследних.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|		ИЗ
	|			РегистрСведений.КодыОрганизации.СрезПоследних КАК КодыОрганизацииСрезПоследних) КАК ВложенныйЗапрос
	|		ПО ВзаиморасчетыПоНДФЛ.Организация = ВложенныйЗапрос.Организация
	|ГДЕ
	|	ВзаиморасчетыПоНДФЛ.НалогПриход <> 0
	|	И ВложенныйЗапрос.КодПоЕДРПОУ В(&масКодПоЕДРПОУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВзаиморасчетыПоНДФЛ.Сотрудник.Физлицо.КодПоДРФО,
	|	ВзаиморасчетыПоНДФЛ.Сотрудник.Физлицо.Наименование,
	|	ВложенныйЗапрос.КодПоЕДРПОУ,
	|	ВзаиморасчетыПоНДФЛ.ДоходНДФЛ.Код
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВзносыВФонды.Сотрудник.Физлицо.КодПоДРФО,
	|	ВзносыВФонды.Сотрудник.Физлицо.Наименование,
	|	0,
	|	0,
	|	ВложенныйЗапрос.КодПоЕДРПОУ,
	|	NULL,
	|	СУММА(ВзносыВФонды.Результат),
	|	СУММА(ВзносыВФонды.База),
	|	""ЕСВФОТРаботники"",
	|	ВзносыВФонды.Налог.Код
	|ИЗ
	|	РегистрРасчета.ВзносыВФонды КАК ВзносыВФонды
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КодыОрганизацииСрезПоследних.Организация КАК Организация,
	|			КодыОрганизацииСрезПоследних.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|		ИЗ
	|			РегистрСведений.КодыОрганизации.СрезПоследних КАК КодыОрганизацииСрезПоследних) КАК ВложенныйЗапрос
	|		ПО ВзносыВФонды.Организация = ВложенныйЗапрос.Организация
	|ГДЕ
	|	ВложенныйЗапрос.КодПоЕДРПОУ В(&масКодПоЕДРПОУ)
	|	И ВзносыВФонды.Результат <> 0
	|	И ВзносыВФонды.ПериодРегистрации МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.КодПоЕДРПОУ,
	|	ВзносыВФонды.Сотрудник.Физлицо.КодПоДРФО,
	|	ВзносыВФонды.Сотрудник.Физлицо.Наименование,
	|	ВзносыВФонды.Налог.Код";

	// 5. ЗАПИТ 2 — Удержания (виконавчі листи з Получателем)
	ТекстЗапросаУдержаний =
	"ВЫБРАТЬ
	|	У.Сотрудник.Физлицо.КодПоДРФО КАК СотрудникИНН,
	|	У.Сотрудник.Наименование КАК СотрудникНаименование,
	|	У.ВидРасчета.Наименование КАК ВидУдержания,
	|	У.ВидРасчета.Код КАК КодВида,
	|	СУММА(У.Результат) КАК Сумма,
	|	У.ДокументОснование.Номер КАК НомерИЛ,
	|	У.ДокументОснование.Получатель.Наименование КАК ИмяПолучателя,
	|	У.ДокументОснование.Получатель.КодПоЕДРПОУ КАК ЕДРПОУПолучателя,
	|	У.ДокументОснование.Получатель.ИНН КАК ИННПолучателя,
	|	КодыОрг.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	РегистрРасчета.УдержанияРаботниковОрганизаций КАК У
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодыОрганизации.СрезПоследних КАК КодыОрг
	|		ПО У.Организация = КодыОрг.Организация
	|ГДЕ
	|	У.ПериодРегистрации МЕЖДУ &НачалоПериода И &КонецПериода
	|	И У.Результат <> 0
	|	И (У.ДокументОснование <> ЗНАЧЕНИЕ(Документ.ИсполнительныйЛист.ПустаяСсылка)
	|		ИЛИ У.ВидРасчета.Код = ""00009"")
	|	И КодыОрг.КодПоЕДРПОУ В (&масКодПоЕДРПОУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	У.Сотрудник.Физлицо.КодПоДРФО,
	|	У.Сотрудник.Наименование,
	|	У.ВидРасчета.Наименование,
	|	У.ВидРасчета.Код,
	|	У.ДокументОснование.Номер,
	|	У.ДокументОснование.Получатель.Наименование,
	|	У.ДокументОснование.Получатель.КодПоЕДРПОУ,
	|	У.ДокументОснование.Получатель.ИНН,
	|	КодыОрг.КодПоЕДРПОУ";

	// 5b. ЗАПИТ 3 — Начисления з zup_1 (для ТЧ НачисленияБух), деталізація Сотрудник × ВидРасчёта.
	// Усі поля — примітиви (рядки + число), тому ЗначениеВСтрокуВнутр безпечна.
   ТекстЗапросаНачислений =
	"ВЫБРАТЬ
	|	Нач.Сотрудник.Физлицо.КодПоДРФО КАК СотрудникИНН,
	|	Нач.Сотрудник.Физлицо.Наименование КАК СотрудникНаименование,
	|	Нач.ВидРасчета.Наименование КАК ВидРасчета,
	|	Нач.ВидРасчета.Код КАК КодВидРасчета,
	|	СУММА(Нач.Результат) КАК Сумма,
	|	ВложенныйЗапрос.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисленияРаботниковОрганизаций КАК Нач
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КодыОрганизацииСрезПоследних.Организация КАК Организация,
	|			КодыОрганизацииСрезПоследних.КодПоЕДРПОУ КАК КодПоЕДРПОУ
	|		ИЗ
	|			РегистрСведений.КодыОрганизации.СрезПоследних КАК КодыОрганизацииСрезПоследних) КАК ВложенныйЗапрос
	|		ПО Нач.Организация = ВложенныйЗапрос.Организация
	|ГДЕ
	|	Нач.ПериодРегистрации МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Нач.ВидРасчета.ПоказателиВидовОплатыТруда <> ЗНАЧЕНИЕ(Справочник.СтатьиНалоговыхДеклараций.ОтчетПоТруду_Соцстрах)
	|	И Нач.Результат <> 0
	|	И ВложенныйЗапрос.КодПоЕДРПОУ В(&масКодПоЕДРПОУ)
	|
	|СГРУППИРОВАТЬ ПО
	|	Нач.Сотрудник.Физлицо.КодПоДРФО,
	|	Нач.Сотрудник.Физлицо.Наименование,
	|	Нач.ВидРасчета.Наименование,
	|	Нач.ВидРасчета.Код,
	|	ВложенныйЗапрос.КодПоЕДРПОУ";

	Попытка
		// Виконуємо обидва запити у контексті ZUP_1
		ЗапросНал = V83.NewObject("Запрос");
		ЗапросНал.Текст = ТекстЗапросаНалогов;
		ЗапросНал.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросНал.УстановитьПараметр("КонецПериода",  КонецПериода);
		ЗапросНал.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);
		ТЗНалогов = ЗапросНал.Выполнить().Выгрузить();
		стр_ТЗНал = V83.ЗначениеВСтрокуВнутр(ТЗНалогов);

		ЗапросУд = V83.NewObject("Запрос");
		ЗапросУд.Текст = ТекстЗапросаУдержаний;
		ЗапросУд.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросУд.УстановитьПараметр("КонецПериода",  КонецПериода);
		ЗапросУд.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);
		ТЗУдержаний = ЗапросУд.Выполнить().Выгрузить();
		стр_ТЗУд = V83.ЗначениеВСтрокуВнутр(ТЗУдержаний);

		ЗапросНач = V83.NewObject("Запрос");
		ЗапросНач.Текст = ТекстЗапросаНачислений;
		ЗапросНач.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросНач.УстановитьПараметр("КонецПериода",  КонецПериода);
		ЗапросНач.УстановитьПараметр("масКодПоЕДРПОУ", масКодПоЕДРПОУ_V83);
		ТЗНачислений = ЗапросНач.Выполнить().Выгрузить();
		стр_ТЗНач = V83.ЗначениеВСтрокуВнутр(ТЗНачислений);
	Исключение
		V83 = Неопределено;
		V8  = Неопределено;
		ВызватьИсключение "Помилка запиту до ZUP_1: " + ОписаниеОшибки();
	КонецПопытки;

	// 6. Закриття COM
	V83 = Неопределено;
	V8  = Неопределено;

	// 7. Десеріалізація у ERP-контексті
	ТаблицаНалогов    = ЗначениеИзСтрокиВнутр(стр_ТЗНал);
	ТаблицаУдержаний  = ЗначениеИзСтрокиВнутр(стр_ТЗУд);
	ТаблицаНачислений = ЗначениеИзСтрокиВнутр(стр_ТЗНач);

	// 8. Очищення цільових ТЧ
	НалогиБухгалтерия.Очистить();
	УдержанияБухгалтерия.Очистить();
	НачисленияБух.Очистить();

	// 9. Заповнення НалогиБухгалтерия
	ЗаписатьНалогиВТЧ_Бух(ТаблицаНалогов);

	// 10. Заповнення УдержанияБухгалтерия
	ЗаписатьУдержанияВТЧ_Бух(ТаблицаУдержаний);

	// 11. Заповнення НачисленияБух
	ЗаписатьНачисленияБух_Бух(ТаблицаНачислений);

КонецПроцедуры

// Заповнення ТЧ НалогиБухгалтерия з таблиці, повернутої запитом по ZUP_1.
// Логіка 1:1 з існуючої обробки "Загрузить зарплату из казны налоги из базы zup_1".
Процедура ЗаписатьНалогиВТЧ_Бух(ТаблицаНалогов)

	КолПомилокМатч = 0;
	Для Каждого СтрокаТЗ Из ТаблицаНалогов Цикл

		ИННСотрудника = СокрЛП("" + СтрокаТЗ.СотрудникИНН);
		Если ПустаяСтрока(ИННСотрудника) Тогда
			КолПомилокМатч = КолПомилокМатч + 1;
			Сообщить("Налоги: порожній ІНН (" + СтрокаТЗ.СотрудникНаименование + ")");
			Продолжить;
		КонецЕсли;

		СотрудникERP = Справочники.Сотрудники.НайтиПоРеквизиту("А_КодПоДРФО", ИННСотрудника);
		Если НЕ ЗначениеЗаполнено(СотрудникERP) Тогда
			КолПомилокМатч = КолПомилокМатч + 1;
			Сообщить("Налоги: не знайдено співробітника з ІНН " + ИННСотрудника + " (" + СтрокаТЗ.СотрудникНаименование + ")");
			Продолжить;
		КонецЕсли;

		КодЄДРПОУ = СокрЛП("" + СтрокаТЗ.КодПоЕДРПОУ);
		ОрганизацияERP = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", КодЄДРПОУ);
		Если НЕ ЗначениеЗаполнено(ОрганизацияERP) Тогда
			ОрганизацияERP = ЭтотОбъект.Организация;
		КонецЕсли;

		КодДоходаЗУП = СокрЛП("" + СтрокаТЗ.КодДохода);
		ВидДоходаНДФЛERP = Справочники.ВидыДоходовНДФЛ.НайтиПоКоду(КодДоходаЗУП);

		НоваяСтрока = НалогиБухгалтерия.Добавить();
		НоваяСтрока.Организация   = ОрганизацияERP;
		НоваяСтрока.Сотрудник     = СотрудникERP;
		// Сумма — заповнюємо завжди:
		//   для рядків НДФЛ/ВС (ВзаиморасчетыПоНДФЛ) → СуммаНалога
		//   для рядків ЄСВ     (ВзносыВФонды)        → СуммаФОТ
		Если СтрокаТЗ.СуммаНалога <> 0 Тогда
			НоваяСтрока.Сумма = СтрокаТЗ.СуммаНалога;
		Иначе
			НоваяСтрока.Сумма = СтрокаТЗ.СуммаФОТ;
		КонецЕсли;
		НоваяСтрока.СуммаНДФЛ     = СтрокаТЗ.СуммаНалога;  // НДФЛ/ВС утриманий (з ВзаиморасчетыПоНДФЛ)
		НоваяСтрока.СуммаФОТ      = СтрокаТЗ.СуммаФОТ;      // ЄСВ нарахований (з ВзносыВФонды)
		НоваяСтрока.СуммаДохода   = СтрокаТЗ.СуммаДохода;   // База доходу (з ВзаиморасчетыПоНДФЛ.Доход)
		НоваяСтрока.База          = СтрокаТЗ.СуммаБазы;     // База ЄСВ (з ВзносыВФонды.База)
		НоваяСтрока.КодДоходаСтрока = КодДоходаЗУП;
		НоваяСтрока.КодДохода     = ВидДоходаНДФЛERP;
		НоваяСтрока.КодНалогаСтрока = СокрЛП("" + СтрокаТЗ.КодНалога);
		НоваяСтрока.Налог         = Справочники.Налоги.НайтиПоКоду(СокрЛП("" + СтрокаТЗ.КодНалога));
		НоваяСтрока.НалогСтатьяДвиженияДенежныхСредств =
			Справочники.Налоги.НайтиПоКоду(СокрЛП("" + СтрокаТЗ.КодНалогаСтатьяДенег));

		// ТипНалога: суцільно цифри → НДФЛ, інакше → ВоенныйСбор
		Если СтрДлина(КодДоходаЗУП) > 0 Тогда
			КодЦифровий = Истина;
			Для Счет = 1 По СтрДлина(КодДоходаЗУП) Цикл
				Симв = Сред(КодДоходаЗУП, Счет, 1);
				Если НЕ (Симв >= "0" И Симв <= "9") Тогда
					КодЦифровий = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если КодЦифровий Тогда
				НоваяСтрока.ТипНалога = Перечисления.ТипыНалогов.НДФЛ;
			Иначе
				НоваяСтрока.ТипНалога = Перечисления.ТипыНалогов.ВоенныйСбор;
			КонецЕсли;
		ИначеЕсли СтрокаТЗ.СуммаНалога <> 0 Тогда
			НоваяСтрока.ТипНалога = Перечисления.ТипыНалогов.НДФЛ;
		КонецЕсли;

	КонецЦикла;

	Если КолПомилокМатч > 0 Тогда
		Сообщить("Налоги: помилок матчингу сотрудника: " + КолПомилокМатч);
	КонецЕсли;

КонецПроцедуры

// Заповнення ТЧ УдержанияБухгалтерия за шаблоном стандартного ОтражениеЗарплатыВФинансовомУчете (000Ц-000002).
Процедура ЗаписатьУдержанияВТЧ_Бух(ТаблицаУдержаний)

	Если ТаблицаУдержаний.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	// Кешування фіксованих посилань (поза циклом)
	ПрочиеПассивы = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ПрочиеПассивы;
	СчетУчета6853 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("6853");
	// Подотчётные удержания («Утримання підзвітних ГК», Код 00009 — возврат подотчётных при увольнении):
	// ВидОперации УдержаниеНеизрасходованныхПодотчетныхСумм триггерит типовое проведение в регистр
	// ДенежныеСредстваУПодотчетныхЛиц + регл-счёт 3721. Статью НЕ ставим (ПАП идёт через «Движения баланса»).
	СчетУчета3721 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("3721");
	ГруппаУчетаЗарплата = Справочники.ГруппыУчетаНачисленийИУдержаний.Зарплата;
	ВидОперацииАлименты = Перечисления.ВидыОперацийПоЗарплате.АлиментыПрочиеИсполнительныеЛисты;

	КолПомилокСотрудник = 0;
	КолПомилокКонтрагент = 0;

	Для Каждого Ряд Из ТаблицаУдержаний Цикл

		ИННСотрудника = СокрЛП("" + Ряд.СотрудникИНН);
		СотрудникERP = Справочники.Сотрудники.НайтиПоРеквизиту("А_КодПоДРФО", ИННСотрудника);
		Если НЕ ЗначениеЗаполнено(СотрудникERP) Тогда
			КолПомилокСотрудник = КолПомилокСотрудник + 1;
			Сообщить("Удержания: не знайдено співробітника з ІНН " + ИННСотрудника + " (" + Ряд.СотрудникНаименование + ")");
			Продолжить;
		КонецЕсли;

		КодЄДРПОУ = СокрЛП("" + Ряд.КодПоЕДРПОУ);
		ОрганизацияERP = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", КодЄДРПОУ);
		Если НЕ ЗначениеЗаполнено(ОрганизацияERP) Тогда
			ОрганизацияERP = ЭтотОбъект.Организация;
		КонецЕсли;

		ЭтоПодотчетне = (СокрЛП("" + Ряд.КодВида) = "00009");

		КонтрагентERP = Неопределено;
		Если НЕ ЭтоПодотчетне Тогда
			КонтрагентERP = НайтиКонтрагентаПоУд_Бух(
				СокрЛП("" + Ряд.ЕДРПОУПолучателя),
				СокрЛП("" + Ряд.ИННПолучателя),
				СокрЛП("" + Ряд.ИмяПолучателя));
			Если НЕ ЗначениеЗаполнено(КонтрагентERP) Тогда
				КолПомилокКонтрагент = КолПомилокКонтрагент + 1;
				Сообщить("Удержания: не знайдено контрагента '" + Ряд.ИмяПолучателя
					+ "' (ЄДРПОУ=" + Ряд.ЕДРПОУПолучателя + ", ІНН=" + Ряд.ИННПолучателя + ")");
			КонецЕсли;
		КонецЕсли;

		НоваяСтрока = УдержанияБухгалтерия.Добавить();
		НоваяСтрока.Организация             = ОрганизацияERP;
		НоваяСтрока.ФизическоеЛицо          = СотрудникERP.ФизическоеЛицо;
		НоваяСтрока.Сумма                   = Ряд.Сумма;
		НоваяСтрока.ГруппаУчетаНачислений   = ГруппаУчетаЗарплата;
		Если ЭтоПодотчетне Тогда
			// ВидОперации УдержаниеНеизрасходованныхПодотчетныхСумм → типовое проведение пишет регистр
			// ДенежныеСредстваУПодотчетныхЛиц + регл-счёт 3721. СтатьяАктивовПассивов НЕ ставим —
			// ПАП «Денежные средства (у подотчетных лиц)» идёт через «Движения баланса» от регистра (иначе задвоение).
			НоваяСтрока.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.УдержаниеНеизрасходованныхПодотчетныхСумм;
			НоваяСтрока.СчетУчета   = СчетУчета3721;
			НоваяСтрока.Субконто1   = СотрудникERP.ФизическоеЛицо; // regl-субконто 3721
		Иначе
			НоваяСтрока.ВидОперации             = ВидОперацииАлименты;
			НоваяСтрока.СтатьяАктивовПассивов   = ПрочиеПассивы;
			НоваяСтрока.СчетУчета               = СчетУчета6853;
			Если ЗначениеЗаполнено(КонтрагентERP) Тогда
				НоваяСтрока.Субконто1 = КонтрагентERP;
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

	Если КолПомилокСотрудник > 0 Тогда
		Сообщить("Удержания: помилок матчингу сотрудника: " + КолПомилокСотрудник);
	КонецЕсли;
	Если КолПомилокКонтрагент > 0 Тогда
		Сообщить("Удержания: не знайдено контрагентів: " + КолПомилокКонтрагент);
	КонецЕсли;

КонецПроцедуры

// Пошук Контрагента-Получателя виконавчого листа в ERP.
// Порядок пошуку:
//   1. По КодПоЕДРПОУ (основний варіант для юридичних осіб — ВДВС тощо)
//   2. Якщо ЄДРПОУ пусте → по КодПоЕДРПОУ = ІНН (для ФОП / приватних виконавців,
//      де в довіднику часто зберігають ІНН у полі КодПоЕДРПОУ)
//   3. Fallback — по Наименованию (точне співставлення)
Функция НайтиКонтрагентаПоУд_Бух(ЄДРПОУ, ІНН, Ім_я)

	// 1. По КодПоЕДРПОУ
	Если НЕ ПустаяСтрока(ЄДРПОУ) Тогда
		К = Справочники.Контрагенты.НайтиПоРеквизиту("КодПоЕДРПОУ", ЄДРПОУ);
		Если ЗначениеЗаполнено(К) Тогда
			Возврат К;
		КонецЕсли;
	КонецЕсли;

	// 2. По КодПоЕДРПОУ, але з ІНН (для ФОП)
	Если НЕ ПустаяСтрока(ІНН) Тогда
		К = Справочники.Контрагенты.НайтиПоРеквизиту("КодПоЕДРПОУ", ІНН);
		Если ЗначениеЗаполнено(К) Тогда
			Возврат К;
		КонецЕсли;
	КонецЕсли;

	// 3. Fallback — точне співставлення за Наименованием
	Если НЕ ПустаяСтрока(Ім_я) Тогда
		К = Справочники.Контрагенты.НайтиПоНаименованию(Ім_я, Истина);
		Если ЗначениеЗаполнено(К) Тогда
			Возврат К;
		КонецЕсли;
	КонецЕсли;

	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

// Заповнення ТЧ НачисленияБух з таблиці, повернутої запитом по zup_1.
// Деталізація: рядок на (Сотрудник × ВидРасчёта). Бух-реквізити — константа ERP:
//   СчетКт      = 661 (Розрахунки за договорами ЦПХ — реальний рахунок ЗП для «ІНДАСТРІАЛБУД»)
//   СубконтоКт1 = ФизЛицо (субконто «Работники организаций» = Справочник.ФизическиеЛица)
//   СубконтоКт2/3 — порожні (у рахунку 661 одне субконто).
Процедура ЗаписатьНачисленияБух_Бух(ТаблицаНачислений)

	// 1. Бух-константи (поза циклом)
	СчетКт661 = ПланыСчетов.Хозрасчетный.НайтиПоКоду("661");
	Если НЕ ЗначениеЗаполнено(СчетКт661) Тогда
		ВызватьИсключение "Не знайдено рахунок 661 у плані рахунків Хозрасчетный!";
	КонецЕсли;

	// 2. Кеш ФизЛиц по КодПоДРФО (без НайтиПоРеквизиту у циклі — швидкість)
	КешФизЛиц = Новый Соответствие;
	ЗапросФЛ = Новый Запрос;
	ЗапросФЛ.Текст =
	"ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка КАК Ссылка,
	|	ФизическиеЛица.КодПоДРФО КАК КодПоДРФО
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.КодПоДРФО <> """"";
	ВыборкаФЛ = ЗапросФЛ.Выполнить().Выбрать();
	Пока ВыборкаФЛ.Следующий() Цикл
		КешФизЛиц.Вставить(СокрЛП(ВыборкаФЛ.КодПоДРФО), ВыборкаФЛ.Ссылка);
	КонецЦикла;

	// 3. Кеш Організацій по ЕДРПОУ
	КешОрг = Новый Соответствие;

	КолПомилок   = 0;
	КолЗагружено = 0;

	Для Каждого СтрокаТЗ Из ТаблицаНачислений Цикл

		ИНН = СокрЛП("" + СтрокаТЗ.СотрудникИНН);
		Если ПустаяСтрока(ИНН) Тогда
			КолПомилок = КолПомилок + 1;
			Сообщить("Начисления бух: порожній ІНН (" + СтрокаТЗ.СотрудникНаименование + ")");
			Продолжить;
		КонецЕсли;

		ФизЛицоERP = КешФизЛиц[ИНН];
		Если ФизЛицоERP = Неопределено Тогда
			КолПомилок = КолПомилок + 1;
			Сообщить("Начисления бух: не знайдено ФизЛицо з ІНН " + ИНН
				+ " (" + СтрокаТЗ.СотрудникНаименование + ")");
			Продолжить;
		КонецЕсли;

		// Організація по ЕДРПОУ (через кеш)
		КодЕДРПОУ = СокрЛП("" + СтрокаТЗ.КодПоЕДРПОУ);
		ОрганизацияERP = КешОрг[КодЕДРПОУ];
		Если ОрганизацияERP = Неопределено Тогда
			ОрганизацияERP = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", КодЕДРПОУ);
			КешОрг.Вставить(КодЕДРПОУ, ОрганизацияERP);
		КонецЕсли;

		НоваяСтрока = НачисленияБух.Добавить();
		НоваяСтрока.Организация   = ОрганизацияERP;
		НоваяСтрока.ФизЛицо       = ФизЛицоERP;
		НоваяСтрока.ФИО           = СтрокаТЗ.СотрудникНаименование;
		НоваяСтрока.Сумма         = СтрокаТЗ.Сумма;
		НоваяСтрока.ВидРасчета    = СтрокаТЗ.ВидРасчета;
		НоваяСтрока.КодВидРасчета = СтрокаТЗ.КодВидРасчета;
		НоваяСтрока.СчетКт        = СчетКт661;
		НоваяСтрока.СубконтоКт1   = ФизЛицоERP;

		КолЗагружено = КолЗагружено + 1;
	КонецЦикла;

	Если КолПомилок > 0 Тогда
		Сообщить("Начисления бух: помилок матчингу: " + КолПомилок + " (завантажено: " + КолЗагружено + ")");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ЕРП_ЗагрузкаИзЗУП2

// Заповнення ТЧ НачисленияУпр + УдержанияУпр даними з бази ZUP_2 (управлінська ЗП).
//
// Джерело (zup_2):
//   Документ.НачислениеЗарплатыРаботникам.Начисления (ТЧ) — для НачисленияУпр
//   Документ.НачислениеЗарплатыРаботникам.Удержания  (ТЧ) — для УдержанияУпр
//
// Фільтр: всі ПРОВЕДЕНІ документи з Датою у місяці `Дата` цього документа.
//
// Матчинг ФизЛиц: по КодПоДРФО через локальний кеш Справочник.ФизическиеЛица.
//
// Патерн — 1:1 з Documents/НачислениеЗарплаты/Ext/ObjectModule.bsl (Фаза 1),
// бо ми читаємо зі zup_2 ПРИМІТИВНІ поля (Наименование, КодПоДРФО, Результат),
// тож прямий обхід COM-результату без серіалізації.
Процедура ЗаполнитьНачисленияУпризЗуп2() Экспорт

	// 1. Перевірка реквізитів
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		ВызватьИсключение "У документі не заповнено Дата!";
	КонецЕсли;

	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода  = КонецМесяца(Дата);

	// 2. Кеш ФізОсіб: КодПоДРФО → ФізЛицо (один запит локально в ERP)
	СоответствиеФизЛиц = Новый Соответствие;
	ЗапросФЛ = Новый Запрос;
	ЗапросФЛ.Текст =
	"ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка КАК Ссылка,
	|	ФизическиеЛица.КодПоДРФО КАК КодПоДРФО
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.КодПоДРФО <> """"";
	ВыборкаФЛ = ЗапросФЛ.Выполнить().Выбрать();
	Пока ВыборкаФЛ.Следующий() Цикл
		КодДРФО = СокрЛП(ВыборкаФЛ.КодПоДРФО);
		Если НЕ ПустаяСтрока(КодДРФО) Тогда
			СоответствиеФизЛиц.Вставить(КодДРФО, ВыборкаФЛ.Ссылка);
		КонецЕсли;
	КонецЦикла;

	// 3. Очищення цільових ТЧ
	НачисленияУпр.Очистить();
	УдержанияУпр.Очистить();

	// 4. Підключення до zup_2 (ZUP 2.1 управлінська)
	Попытка
		Connector = Новый COMОбъект("V83.COMConnector");
		V83 = Connector.Connect("Srvr=""SQLSERVER"";Ref=""zup_2"";Usr=""cfo"";Pwd=""2442"";");
	Исключение
		ВызватьИсключение "Помилка підключення до zup_2: " + ОписаниеОшибки();
	КонецПопытки;

	КолНач = 0;
	КолНачБезФизЛица = 0;
	КолУд  = 0;
	КолУдБезФизЛица = 0;
	ПустаяФизОсоба = Справочники.ФизическиеЛица.ПустаяСсылка();

	Попытка

		// 5. Запит Начислений
		ЗапросНач = V83.NewObject("Запрос");
		ЗапросНач.Текст =
		"ВЫБРАТЬ
		|	Начисления.Физлицо.КодПоДРФО КАК КодПоДРФО,
		|	Начисления.Физлицо.Наименование КАК ФизЛицоНаименование,
		|	Начисления.ВидРасчета.Наименование КАК ВидРасчета,
		|	Начисления.ВидРасчета.Код КАК КодВидРасчета,
		|	Начисления.Результат КАК Сумма
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам.Начисления КАК Начисления
		|ГДЕ
		|	Начисления.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Начисления.Ссылка.Проведен = ИСТИНА
		|	И Начисления.Результат <> 0";
		ЗапросНач.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросНач.УстановитьПараметр("КонецПериода",  КонецПериода);

		ВыборкаНач = ЗапросНач.Выполнить().Выбрать();
		Пока ВыборкаНач.Следующий() Цикл
			КодДРФО = СокрЛП("" + ВыборкаНач.КодПоДРФО);
			ФизЛицо = СоответствиеФизЛиц[КодДРФО];
			Если ФизЛицо = Неопределено Тогда
				ФизЛицо = ПустаяФизОсоба;
				КолНачБезФизЛица = КолНачБезФизЛица + 1;
			КонецЕсли;

			НоваяСтрока = НачисленияУпр.Добавить();
			НоваяСтрока.ФизЛицо       = ФизЛицо;
			НоваяСтрока.ФИО           = СокрЛП("" + ВыборкаНач.ФизЛицоНаименование);
			НоваяСтрока.Сумма         = ВыборкаНач.Сумма;
			НоваяСтрока.ВидРасчета    = СокрЛП("" + ВыборкаНач.ВидРасчета);
			НоваяСтрока.КодВидРасчета = СокрЛП("" + ВыборкаНач.КодВидРасчета);
			КолНач = КолНач + 1;
		КонецЦикла;

		// 6. Запит Удержаний (БЕЗ ВидРасчета з кодом "00001" — "Утримано по бухгалтерії")
		ЗапросУд = V83.NewObject("Запрос");
		ЗапросУд.Текст =
		"ВЫБРАТЬ
		|	Удержания.Физлицо.КодПоДРФО КАК КодПоДРФО,
		|	Удержания.Физлицо.Наименование КАК ФизЛицоНаименование,
		|	Удержания.ВидРасчета.Наименование КАК ВидРасчета,
		|	Удержания.ВидРасчета.Код КАК КодВидРасчета,
		|	Удержания.Результат КАК Сумма
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам.Удержания КАК Удержания
		|ГДЕ
		|	Удержания.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Удержания.Ссылка.Проведен = ИСТИНА
		|	И Удержания.Результат <> 0
		|	И Удержания.ВидРасчета.Код <> &КодВидУтрБух";
		ЗапросУд.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросУд.УстановитьПараметр("КонецПериода",  КонецПериода);
		ЗапросУд.УстановитьПараметр("КодВидУтрБух", "00001");

		ВыборкаУд = ЗапросУд.Выполнить().Выбрать();
		Пока ВыборкаУд.Следующий() Цикл
			КодДРФО = СокрЛП("" + ВыборкаУд.КодПоДРФО);
			ФизЛицо = СоответствиеФизЛиц[КодДРФО];
			Если ФизЛицо = Неопределено Тогда
				ФизЛицо = ПустаяФизОсоба;
				КолУдБезФизЛица = КолУдБезФизЛица + 1;
			КонецЕсли;

			НоваяСтрока = УдержанияУпр.Добавить();
			НоваяСтрока.ФизЛицо       = ФизЛицо;
			НоваяСтрока.ФИО           = СокрЛП("" + ВыборкаУд.ФизЛицоНаименование);
			НоваяСтрока.Сумма         = ВыборкаУд.Сумма;
			НоваяСтрока.ВидРасчета    = СокрЛП("" + ВыборкаУд.ВидРасчета);
			НоваяСтрока.КодВидРасчета = СокрЛП("" + ВыборкаУд.КодВидРасчета);
			КолУд = КолУд + 1;
		КонецЦикла;

	Исключение
		V83 = Неопределено;
		Connector = Неопределено;
		ВызватьИсключение "Помилка запиту до zup_2: " + ОписаниеОшибки();
	КонецПопытки;

	// 7. Закриття COM
	V83 = Неопределено;
	Connector = Неопределено;

	// 8. Діагностика тільки при проблемах
	Если КолНачБезФизЛица > 0 Тогда
		Сообщить("НачисленияУпр: " + КолНачБезФизЛица + " рядків без ФізОсоби (заповнено лише ФИО)");
	КонецЕсли;
	Если КолУдБезФизЛица > 0 Тогда
		Сообщить("УдержанияУпр: " + КолУдБезФизЛица + " рядків без ФізОсоби (заповнено лише ФИО)");
	КонецЕсли;

	// 9. Додати премії/доплати з РаспределениеФ2 (Форма2, А_Начисление=Істина) — їх немає у zup_2
	_ОтрЗП_ДобавитьНачисленияИзРаспределенияФ2();

КонецПроцедуры

// Додає у ТЧ НачисленияУпр рядки-нарахування з документів РаспределениеФ2,
// у яких А_Начисление = Істина (премії/доплати, що виплачуються через касу — Форма2).
// Цих премій немає у zup_2, тому без цього кроку управлінський NET був меншим
// за реальні касові виплати Казни (див. knowledge_А_ОтражениеЗПпоКазне/17_formapl_split.md).
//
// ВАЖЛИВО:
//   - НЕ чистить НачисленияУпр (очищення одне — на початку ЗаполнитьНачисленияУпризЗуп2);
//     Ф2-рядки ДОДАЮТЬСЯ до zup_2-рядків.
//   - ФізОсоба береться напряму з Сотрудник.ФизическоеЛицо (без матчингу по ДРФО).
//   - А_ВидРасчета — реквізит ШАПКИ (один на документ); КодВидРасчета з хвостовим пробілом → СокрЛП.
//   - Запит локальний (ERP), агрегує по всіх Ф2 за період → один рядок на (ФізОсоба × ВидРозрахунку).
//
Процедура _ОтрЗП_ДобавитьНачисленияИзРаспределенияФ2()

	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода  = КонецМесяца(Дата);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ф2.А_ВидРасчета.Наименование КАК ВидРасчета,
	|	Ф2.А_ВидРасчета.Код          КАК КодВидРасчета,
	|	Стр.Сотрудник.ФизическоеЛицо КАК ФизЛицо,
	|	Стр.Сотрудник.Наименование   КАК ФИО,
	|	СУММА(Стр.СуммаНачисления)    КАК Сумма
	|ИЗ
	|	Документ.РаспределениеФ2 КАК Ф2
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РаспределениеФ2.Сотрудники КАК Стр
	|		ПО Стр.Ссылка = Ф2.Ссылка
	|ГДЕ
	|	Ф2.А_Начисление = ИСТИНА
	|	И Ф2.Проведен = ИСТИНА
	|	И Ф2.КассаДатаС >= &НачалоПериода
	|	И Ф2.КассаДатаПо <= &КонецПериода
	|	И Стр.СуммаНачисления <> 0
	|СГРУППИРОВАТЬ ПО
	|	Ф2.А_ВидРасчета.Наименование,
	|	Ф2.А_ВидРасчета.Код,
	|	Стр.Сотрудник.ФизическоеЛицо,
	|	Стр.Сотрудник.Наименование";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);

	КолФ2 = 0;
	КолФ2БезФизЛица = 0;
	СуммаФ2 = 0;

	ВыборкаФ2 = Запрос.Выполнить().Выбрать();
	Пока ВыборкаФ2.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаФ2.ФизЛицо) Тогда
			КолФ2БезФизЛица = КолФ2БезФизЛица + 1;
			Продолжить;
		КонецЕсли;

		НоваяСтрока = НачисленияУпр.Добавить();
		НоваяСтрока.ФизЛицо       = ВыборкаФ2.ФизЛицо;
		НоваяСтрока.ФИО           = СокрЛП("" + ВыборкаФ2.ФИО);
		НоваяСтрока.Сумма         = ВыборкаФ2.Сумма;
		НоваяСтрока.ВидРасчета    = СокрЛП("" + ВыборкаФ2.ВидРасчета);
		НоваяСтрока.КодВидРасчета = СокрЛП("" + ВыборкаФ2.КодВидРасчета);
		КолФ2 = КолФ2 + 1;
		СуммаФ2 = СуммаФ2 + ВыборкаФ2.Сумма;
	КонецЦикла;

	Если КолФ2 > 0 Тогда
		Сообщить("НачисленияУпр: додано " + КолФ2 + " рядків з РаспределениеФ2 (Форма2/премії), сума "
			+ Формат(СуммаФ2, "ЧДЦ=2; ЧРГ=' '"));
	КонецЕсли;
	Если КолФ2БезФизЛица > 0 Тогда
		Сообщить("РаспределениеФ2: " + КолФ2БезФизЛица + " рядків пропущено (порожня ФізОсоба у Сотрудника)");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область ЕРП_Отражения_ДокументОтражениеЗарплатыВФинансовомУчете

// Заповнює ТЧ НачисленнаяЗарплатаИВзносыПоФизлицам та НачисленныйНДФЛ
// даними з уже завантажених ТЧ:
//   РаспределениеКазна    — пропорції розподілу по підрозділах
//   НалогиБухгалтерия      — ФОТ (СуммаФОТ) + НДФЛ/ВС (Сумма > 0)
//   НачисленияУпр          — нарахування (gross) з zup_2
//   УдержанияУпр           — утримання з zup_2 (БЕЗ ВидРасчета "Утримано по бухгалтерії")
//
// Патерн — порт стандартного Documents/ОтражениеЗарплатыВФинансовомУчете,
// процедура ЗаполнитьОтражениеЗарплатыВФинансовомУчетеИзБазЗП (3 операції):
//   Op 1: НалогиБухгалтерия.СуммаФОТ → НачисленнаяЗарплатаИВзносыПоФизлицам (ВзносыВсего)
//   Op 2: NET = SUM(НачисленияУпр.Сумма) - SUM(УдержанияУпр.Сумма, крім "Утримано по бух")
//         групується по ФизЛицу, розподіляється по підрозділах з РаспределениеКазна
//   Op 3: НалогиБухгалтерия.Сумма (НДФЛ/ВС) → НачисленныйНДФЛ
Процедура ЗаполнитьДляОтражения_ДокументОтражениеЗарплатыВФинансовомУчете() Экспорт

	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		ВызватьИсключение "У документі не заповнено Дата!";
	КонецЕсли;

	// Підготовка справочних даних
	Справочные = _ОтрЗП_ПодготовитьСправочныеДанные();

	// Очищення цільових ТЧ
	НачисленнаяЗарплатаИВзносыПоФизлицам.Очистить();
	НачисленныйНДФЛ.Очистить();

	// Op 1: НалогиБухгалтерия → НачисленнаяЗарплатаИВзносыПоФизлицам (ФОТ/взноси)
	_ОтрЗП_ЗаполнитьНачисленияИзНалогов(Справочные);

	// Op 2: NET з НачисленияУпр-УдержанияУпр → НачисленнаяЗарплатаИВзносыПоФизлицам
	_ОтрЗП_ЗаполнитьНачисленияЗП(Справочные);

	// Op 3: НалогиБухгалтерия → НачисленныйНДФЛ (рядки з Сумма > 0)
	_ОтрЗП_ЗаполнитьНДФЛИзНалогов(Справочные);

	// Розмітка ФормаPL: Форма1 (бух/офіційна) + Форма2 (управ/ЦПХ-залишок). Загальна сума НЕ змінюється.
	_ОтрЗП_РазметитьФормаPL();

	// Вирівняти gross-up «Удержание» Ф1 під НачисленныйНДФЛ per (ФЛ, Подр) — щоб
	// (Начислено − НачисленныйНДФЛ) = «Зарплата управл» до копійки (Приход регістру = перенос ПередачаНач).
	_ОтрЗП_ВыровнятьУдержаниеСНДФЛ(Справочные);

	// Op 4: больничные «за счёт фондов» (ФСС/декрет) — генеруємо з НачисленияБухЗасчетФондов.
	// Раніше ФСС-рядок додавали в дочку вручну → родитель≠дочка і ламався баланс. Аддитивно: NET/Ф1-Ф2 не чіпаємо.
	_ОтрЗП_ЗаполнитьБольничныеИзФондов(Справочные);

	// Гарантуємо ОрганизацияБухгалтерия для ВСІХ Форма1-рядків (ЄСВ Op1, не-NET Op2b теж).
	_ОтрЗП_ПроставитьОргБухВсемФорма1();

	// Авторитетне рознесення ОргБух Форма1 по НачисленияБух — перекриває розкидані Казна-присвоєння
	// (Op2a/Op1/шаг7) для multi-org ФЛ. РаспределениеКазна не містить частину юрлиць (напр. ДЖИ ТРИ
	// КОНСТРАКШН) → Приход колапсує на одне юрлице → перекіс ±. Джерело істини — НачисленияБух (zup_1,
	// усі юрлиця). Див. notebook/knowledge_А_ОтражениеЗПпоКазне/PROMPT_FIX_ОргБухФорма1ИзНачисленияБух.md.
	_ОтрЗП_ВыровнятьОргБухФорма1ПоНачисленияБух();

КонецПроцедуры

// Op 4: генерує рядки больничных «за счёт фондов» (ФСС/декрет) у НачисленнаяЗарплатаИВзносыПоФизлицам
// з закладки-джерела НачисленияБухЗасчетФондов. Раніше ФСС-рядок додавали в дочку вручну/типовим
// заповненням (у родителі його не було → дочка ≠ родитель, баланс ламався при ручному видаленні плуга).
// Тепер код генерує детерміновано.
//
// Подразделение: сама закладка «за счёт фондов» підрозділу НЕ несе → беремо «по даних больничного»
// з уже сформованих рядків НЗ. Пріоритет: плуг (Сумма<0 — туди сів больничний у мінус) → підрозділ
// ЄСВ (ВзносыВсего<>0, Ф1) → підрозділ макс. начислення → ЦО.
// Способ/Группа/ВидОперации — як у вже коректно проведених ФСС-рядків. ФормаPL=Форма1. Налог=пусто
// (інакше рядок не потрапить у рух А_ВзСС). НДФЛ віднімається існуючим механізмом (НачисленныйНДФЛ).
Процедура _ОтрЗП_ЗаполнитьБольничныеИзФондов(Справочные)

	// 1. Σ «за счёт фондов» по ФизЛицу
	ФондыПоФЛ = Новый Соответствие;
	Для Каждого Стр Из НачисленияБухЗасчетФондов Цикл
		Если НЕ ЗначениеЗаполнено(Стр.ФизЛицо) ИЛИ Стр.Сумма = 0 Тогда Продолжить; КонецЕсли;
		Тек = ФондыПоФЛ[Стр.ФизЛицо];
		ФондыПоФЛ.Вставить(Стр.ФизЛицо, ?(Тек = Неопределено, 0, Тек) + Стр.Сумма);
	КонецЦикла;
	Если ФондыПоФЛ.Количество() = 0 Тогда Возврат; КонецЕсли;

	ВидОпФСС  = Перечисления.ВидыОперацийПоЗарплате.РасходыПоСтрахованиюФСС;
	СпособФСС = Справочники.СпособыОтраженияЗарплатыВБухУчете.НайтиПоНаименованию("Больничные за счет ФСС");
	ГруппаФСС = Справочники.ГруппыУчетаНачисленийИУдержаний.НайтиПоНаименованию("За счет социального страхования (663)");
	СпособЗП  = Справочные.СпособОтраженияПоУмолчанию; // для первых-5-дней (за рахунок роботодавця, не ФСС)
	Ф1 = Перечисления.А_ФормыPL.Форма1;
	Если НЕ ЗначениеЗаполнено(СпособФСС) ИЛИ НЕ ЗначениеЗаполнено(ГруппаФСС) Тогда
		Сообщить("_ОтрЗП_ЗаполнитьБольничныеИзФондов: не знайдено Способ/Группа ФСС — больничные НЕ згенеровано.");
		Возврат;
	КонецЕсли;

	// 2. GROSSбух (Σ НачисленияБух) і НДФЛ (Σ НачисленныйНДФЛ) по больничным ФЛ — для випадку
	//    «чисто больничный» (GROSSбух < НДФЛ), де стара логіка пропускала первые-5-дней (Ф1Сумма<0).
	GROSSбухПоФЛ = Новый Соответствие;
	Для Каждого Стр Из НачисленияБух Цикл
		Если ФондыПоФЛ[Стр.ФизЛицо] = Неопределено Тогда Продолжить; КонецЕсли;
		Тек = GROSSбухПоФЛ[Стр.ФизЛицо];
		GROSSбухПоФЛ.Вставить(Стр.ФизЛицо, ?(Тек = Неопределено, 0, Тек) + Стр.Сумма);
	КонецЦикла;
	НДФЛПоФЛ = Новый Соответствие;
	Для Каждого Стр Из НачисленныйНДФЛ Цикл
		Если ФондыПоФЛ[Стр.ФизическоеЛицо] = Неопределено Тогда Продолжить; КонецЕсли;
		Тек = НДФЛПоФЛ[Стр.ФизическоеЛицо];
		НДФЛПоФЛ.Вставить(Стр.ФизическоеЛицо, ?(Тек = Неопределено, 0, Тек) + Стр.Сумма);
	КонецЦикла;

	// 3. Підрозділ больничного, ОргБух та рядок удержания-надбавки по ФЛ — з уже сформованих рядків НЗ
	ПодрПлугПоФЛ = Новый Соответствие;
	ПодрЕСВПоФЛ  = Новый Соответствие;
	ПодрМаксПоФЛ = Новый Соответствие;
	МаксНачПоФЛ  = Новый Соответствие;
	ОргБухПоФЛ   = Новый Соответствие;
	УдержРядокПоФЛ = Новый Соответствие;
	Для Каждого Стр Из НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		ФЛ = Стр.ФизическоеЛицо;
		Если НЕ ЗначениеЗаполнено(ФЛ) ИЛИ ФондыПоФЛ[ФЛ] = Неопределено Тогда Продолжить; КонецЕсли;
		Если Стр.Сумма < 0 Тогда
			ПодрПлугПоФЛ.Вставить(ФЛ, Стр.ПодразделениеПредприятия);
		КонецЕсли;
		Если Стр.ВзносыВсего <> 0 И Стр.ФормаPL = Ф1 И ПодрЕСВПоФЛ[ФЛ] = Неопределено Тогда
			ПодрЕСВПоФЛ.Вставить(ФЛ, Стр.ПодразделениеПредприятия);
		КонецЕсли;
		Если Стр.Сумма > ?(МаксНачПоФЛ[ФЛ] = Неопределено, 0, МаксНачПоФЛ[ФЛ]) Тогда
			МаксНачПоФЛ.Вставить(ФЛ, Стр.Сумма);
			ПодрМаксПоФЛ.Вставить(ФЛ, Стр.ПодразделениеПредприятия);
		КонецЕсли;
		Если Стр.ФормаPL = Ф1 И ЗначениеЗаполнено(Стр.ОрганизацияБухгалтерия) И ОргБухПоФЛ[ФЛ] = Неопределено Тогда
			ОргБухПоФЛ.Вставить(ФЛ, Стр.ОрганизацияБухгалтерия);
		КонецЕсли;
		Если УдержРядокПоФЛ[ФЛ] = Неопределено
			И ЗначениеЗаполнено(Стр.СпособОтраженияЗарплатыВБухучете)
			И Стр.СпособОтраженияЗарплатыВБухучете.А_ЭтоУдержание
			И НЕ ЗначениеЗаполнено(Стр.Налог) Тогда
			УдержРядокПоФЛ.Вставить(ФЛ, Стр);
		КонецЕсли;
	КонецЦикла;

	// 4. Клампований больничний (GROSSбух <= НДФЛ): «Зарплата»Ф1 = max(0, GROSSбух−НДФЛ) клампиться
	//    до 0 → НДФЛ больничного нічим не поглинається, а осиротевший gross-up «Удержание»(+НДФЛ)
	//    гасить НачисленныйНДФЛ(−НДФЛ) у А_ВзСС → больничний лишається GROSS (фантом = НДФЛ).
	//    Обмежуємо «Удержание» до Макс(0, GROSSбух) (Способ ЗП, не удержання): зайвина більше не
	//    з'їдає НачисленныйНДФЛ → А_ВзСС сам нетить больничний GROSS до take-home.
	//    ГБ=0 (чистий ФСС-больничний без 661, як Григоренко) → «Удержание»=0 → больничний = NET.
	//    ФЛ з окладом (GROSSбух>=НДФЛ) — НЕ чіпаємо (там «Зарплата» вже поглинула НДФЛ).
	Для Каждого КЗ Из ФондыПоФЛ Цикл
		ФЛ = КЗ.Ключ;
		ГБ = ?(GROSSбухПоФЛ[ФЛ] = Неопределено, 0, GROSSбухПоФЛ[ФЛ]);
		НД = ?(НДФЛПоФЛ[ФЛ] = Неопределено, 0, НДФЛПоФЛ[ФЛ]);
		Если ГБ < НД И УдержРядокПоФЛ[ФЛ] <> Неопределено Тогда
			Р = УдержРядокПоФЛ[ФЛ];
			Р.Сумма = Макс(0, ГБ);
			Р.СпособОтраженияЗарплатыВБухучете = СпособЗП;
		КонецЕсли;
	КонецЦикла;

	// 5. По одному рядку больничного «за счёт фондов» на ФЛ
	Для Каждого КЗ Из ФондыПоФЛ Цикл
		ФЛ = КЗ.Ключ;
		Сумма = КЗ.Значение;
		Если Сумма = 0 Тогда Продолжить; КонецЕсли;

		Подр = ПодрПлугПоФЛ[ФЛ];
		Если Подр = Неопределено Тогда Подр = ПодрЕСВПоФЛ[ФЛ]; КонецЕсли;
		Если Подр = Неопределено Тогда Подр = ПодрМаксПоФЛ[ФЛ]; КонецЕсли;
		Если Подр = Неопределено Тогда Подр = Справочные.ПодразделениеЦО; КонецЕсли;

		НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
		НоваяСтрока.Организация = Организация;
		НоваяСтрока.ФизическоеЛицо = ФЛ;
		Если ЗначениеЗаполнено(Подр) Тогда
			НоваяСтрока.ПодразделениеПредприятия = Подр;
		КонецЕсли;
		НоваяСтрока.ВидОперации = ВидОпФСС;
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СпособФСС;
		НоваяСтрока.ГруппаУчетаНачислений = ГруппаФСС;
		НоваяСтрока.ФормаPL = Ф1;
		НоваяСтрока.Сумма = Сумма;
		НоваяСтрока.ВзносыВсего = 0;
		Если ЗначениеЗаполнено(ОргБухПоФЛ[ФЛ]) Тогда
			НоваяСтрока.ОрганизацияБухгалтерия = ОргБухПоФЛ[ФЛ];
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Розмітка рядків відображення реквізитом ФормаPL (Форма1=бух/офіційна, Форма2=управ/ЦПХ).
// ПРИНЦИП: загальна сума НЕ змінюється — кожен рядок ділиться на Ф1+Ф2 за коефіцієнтом частки ФЛ.
// Податки (ЄСВ ВзносыВсего + весь НачисленныйНДФЛ) — повністю Форма1.
// ⚠️ БАЗИС Ф1 = GROSS (Σ НачисленияБух), а НЕ NET! Колонка Сумма семантично GROSS; при проведенні
// ОЗФУ рух А_ВзСС («Оплата праці») САМ віднімає НДФЛ/утримання → take-home. Якщо класти NET (bukh),
// НДФЛ віднімається ВДРУГЕ (баг: Постернак 27913.53 → 19575.72). Тому Ф1 = офіційний GROSS,
// тоді А_ВзСС(Ф1) = GROSS − НДФЛ = take-home = РаспределениеКазна.Зарплата.
//   gross ФЛ = Σ НачисленияБух (z zup_1)
//   total ФЛ = Σ НачисленнаяЗарплатаИВзносыПоФизлицам.Сумма (поточне відображення)
//   коеф = min(1, max(0, gross/total)); Ф1 = Окр(Сумма×коеф,2); Ф2 = Сумма−Ф1.
Процедура _ОтрЗП_РазметитьФормаPL()

	Ф1 = Перечисления.А_ФормыPL.Форма1;
	Ф2 = Перечисления.А_ФормыPL.Форма2;

	// НачисленныйНДФЛ — повністю Форма1 (офіційні податки)
	Для Каждого Стр Из НачисленныйНДФЛ Цикл
		Стр.ФормаPL = Ф1;
	КонецЦикла;

	// Базис Ф1 per ФЛ = GROSS офіційного нарахування (Σ НачисленияБух z zup_1).
	// БЕЗ віднімання НДФЛ/утримань — їх віднімає рух А_ВзСС при проведенні ОЗФУ.
	Бух = Новый Соответствие;
	Для Каждого Стр Из НачисленияБух Цикл
		Если ЗначениеЗаполнено(Стр.ФизЛицо) Тогда
			Бух[Стр.ФизЛицо] = ?(Бух[Стр.ФизЛицо] = Неопределено, 0, Бух[Стр.ФизЛицо]) + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;

	// total NET per ФЛ (поточне відображення, до розмітки)
	ТоталNET = Новый Соответствие;
	Для Каждого Стр Из НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		Если Стр.Сумма <> 0 И ЗначениеЗаполнено(Стр.ФизическоеЛицо) Тогда
			ТоталNET[Стр.ФизическоеЛицо] = ?(ТоталNET[Стр.ФизическоеЛицо] = Неопределено, 0, ТоталNET[Стр.ФизическоеЛицо]) + Стр.Сумма;
		КонецЕсли;
	КонецЦикла;

	// розмітка + дроблення NET-рядків (цикл по вихідній кількості; нові Ф2-рядки додаються в кінець)
	КолВихідних = НачисленнаяЗарплатаИВзносыПоФизлицам.Количество();
	Для і = 0 По КолВихідних - 1 Цикл
		Стр = НачисленнаяЗарплатаИВзносыПоФизлицам[і];

		// NET-ФЛ (з НачисленияУпр≠0) вже розмічені новим алгоритмом у Op2a — НЕ дробимо коефіцієнтом.
		Если ЗначениеЗаполнено(Стр.ФормаPL) Тогда
			Продолжить;
		КонецЕсли;

		// Утримання (податки) — ЗАВЖДИ Форма1, для всіх ФЛ (не лише NET): податки офіційні за визначенням.
		Если ЗначениеЗаполнено(Стр.СпособОтраженияЗарплатыВБухучете)
			И Стр.СпособОтраженияЗарплатыВБухучете.А_ЭтоУдержание Тогда
			Стр.ФормаPL = Ф1;
			Продолжить;
		КонецЕсли;

		Если Стр.ВзносыВсего <> 0 Тогда
			Стр.ФормаPL = Ф1;   // ЄСВ — офіційний
			Продолжить;
		КонецЕсли;
		Если Стр.Сумма = 0 Тогда
			Стр.ФормаPL = Ф1;
			Продолжить;
		КонецЕсли;

		ТФЛ = ТоталNET[Стр.ФизическоеЛицо];
		БФЛ = Бух[Стр.ФизическоеЛицо];
		Если БФЛ = Неопределено Тогда БФЛ = 0; КонецЕсли;
		Если БФЛ < 0 Тогда БФЛ = 0; КонецЕсли;
		Коеф = ?(ТФЛ = Неопределено ИЛИ ТФЛ = 0, 0, БФЛ / ТФЛ);

		Если Коеф <= 0 Тогда
			Стр.ФормаPL = Ф2;
			Продолжить;
		КонецЕсли;
		Если Коеф >= 1 Тогда
			Стр.ФормаPL = Ф1;
			Продолжить;
		КонецЕсли;

		Ф1Сум = Окр(Стр.Сумма * Коеф, 2);
		Ф2Сум = Стр.Сумма - Ф1Сум;
		Если Ф1Сум = 0 Тогда
			Стр.ФормаPL = Ф2;
			Продолжить;
		КонецЕсли;
		Если Ф2Сум = 0 Тогда
			Стр.ФормаPL = Ф1;
			Продолжить;
		КонецЕсли;

		Стр.Сумма  = Ф1Сум;
		Стр.ФормаPL = Ф1;
		Нов = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
		ЗаполнитьЗначенияСвойств(Нов, Стр);
		Нов.Сумма  = Ф2Сум;
		Нов.ФормаPL = Ф2;
	КонецЦикла;

КонецПроцедуры

// Будує мапи для зіставлення Форма1-рядків НачисленнаяЗарплата з ОрганизацияБухгалтерия
// з ДокРаспределениеЗП.Организация (першоджерело; Казна.Организация буває помилкова).
// Повертає Структуру("Точно, ПоПС, ПоФЛ"):
//   Точно — ключ ФЛ|Подр|Способ|Сума → Орг (унікально для multi-org через суму)
//   ПоПС  — ключ ФЛ|Подр|Способ → Орг або "?" (неоднозначно)
//   ПоФЛ  — ключ ФЛ → Орг або "?" (для single-org ФЛ)
Функция _ОтрЗП_ПостроитьОргБухКазныФорма1()
	Ф1 = Перечисления.А_ФормыPL.Форма1;
	ТипРаспредЗП = Тип("ДокументСсылка.А_РаспределениеЗаработнойПлаты");
	Точно = Новый Соответствие;
	ПоПС   = Новый Соответствие;
	ПоФЛ   = Новый Соответствие;
	ПСписок = Новый Соответствие; // ключ ФЛ|Подр|Способ → Массив структур(Орг, Вес) — для розбиття агрегатів Op2b
	Для Каждого Стр Из РаспределениеКазна Цикл
		Если Стр.ФормаPL <> Ф1 Тогда Продолжить; КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Стр.Сотрудник) Тогда Продолжить; КонецЕсли;
		ФЛ = Стр.Сотрудник.ФизическоеЛицо;
		Если НЕ ЗначениеЗаполнено(ФЛ) Тогда Продолжить; КонецЕсли;
		Если ТипЗнч(Стр.ДокРаспределениеЗП) <> ТипРаспредЗП Тогда Продолжить; КонецЕсли;
		Орг = Стр.ДокРаспределениеЗП.Организация;
		Если НЕ ЗначениеЗаполнено(Орг) Тогда Продолжить; КонецЕсли;
		Способ = Стр.СтатьяДвиженияДенежныхСредств.А_СпособОтраженияЗарплатыВБухучете;
		Сум = Стр.СуммаНачисления + Стр.СуммаНалогов + Стр.СуммаФОТ;
		КлючПС = XMLСтрока(ФЛ) + "|" + XMLСтрока(Стр.Подразделение) + "|" + XMLСтрока(Способ);

		КлючТ = КлючПС + "|" + Формат(Окр(Сум, 2), "ЧДЦ=2; ЧГ=0; ЧРД=.");
		Если Точно[КлючТ] = Неопределено Тогда Точно.Вставить(КлючТ, Орг); КонецЕсли;
		_ОтрЗП_НакопитьКлючОрг(ПоПС, КлючПС, Орг);
		_ОтрЗП_НакопитьКлючОрг(ПоФЛ, XMLСтрока(ФЛ), Орг);
		_ОтрЗП_НакопитьСписокОрг(ПСписок, КлючПС, Орг, Сум);
	КонецЦикла;
	Возврат Новый Структура("Точно, ПоПС, ПоФЛ, ПСписок", Точно, ПоПС, ПоФЛ, ПСписок);
КонецФункции

// Накопичує ключ→Орг; якщо вже є ІНША Орг — ставить "?" (неоднозначно).
Процедура _ОтрЗП_НакопитьКлючОрг(Мапа, Ключ, Орг)
	Тек = Мапа[Ключ];
	Если Тек = Неопределено Тогда
		Мапа.Вставить(Ключ, Орг);
	ИначеЕсли Тек <> "?" И Тек <> Орг Тогда
		Мапа.Вставить(Ключ, "?");
	КонецЕсли;
КонецПроцедуры

// Накопичує ключ → Массив(Орг, Вес) для пропорційного розбиття агрегованих рядків.
Процедура _ОтрЗП_НакопитьСписокОрг(Мапа, Ключ, Орг, Вес)
	Список = Мапа[Ключ];
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Мапа.Вставить(Ключ, Список);
	КонецЕсли;
	Для Каждого Э Из Список Цикл
		Если Э.Орг = Орг Тогда
			Э.Вес = Э.Вес + Вес;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Список.Добавить(Новый Структура("Орг, Вес", Орг, Вес));
КонецПроцедуры

// Розбиває Ф1-рядок на кілька по організаціях пропорційно вагам Казни (сума і взноси зберігаються).
Процедура _ОтрЗП_РазбитьСтрокуПоОрг(Стр, Список)
	ИтогоВес = 0;
	Для Каждого Э Из Список Цикл ИтогоВес = ИтогоВес + Э.Вес; КонецЦикла;
	Если ИтогоВес = 0 Тогда Стр.ОрганизацияБухгалтерия = Список[0].Орг; Возврат; КонецЕсли;
	БазаСум = Стр.Сумма;
	БазаВзн = Стр.ВзносыВсего;
	ОстСум = БазаСум;
	ОстВзн = БазаВзн;
	Кол = Список.Количество();
	Для і = 0 По Кол - 1 Цикл
		Э = Список[і];
		Если і = Кол - 1 Тогда
			ДоляСум = ОстСум; ДоляВзн = ОстВзн;
		Иначе
			ДоляСум = Окр(БазаСум * Э.Вес / ИтогоВес, 2); ОстСум = ОстСум - ДоляСум;
			ДоляВзн = Окр(БазаВзн * Э.Вес / ИтогоВес, 2); ОстВзн = ОстВзн - ДоляВзн;
		КонецЕсли;
		Если і = 0 Тогда
			Стр.Сумма = ДоляСум; Стр.ВзносыВсего = ДоляВзн;
			Стр.ОрганизацияБухгалтерия = Э.Орг;
		Иначе
			Нов = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
			ЗаполнитьЗначенияСвойств(Нов, Стр);
			Нов.Сумма = ДоляСум; Нов.ВзносыВсего = ДоляВзн;
			Нов.ОрганизацияБухгалтерия = Э.Орг;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Проставляє ОрганизацияБухгалтерия УСІМ Форма1-рядкам, у яких воно ще порожнє (ЄСВ Op1, не-NET Op2b).
// Джерело — ДокРаспределениеЗП.Организация: (ФЛ,Подр,Способ,Сума) → (ФЛ,Подр,Способ) → (ФЛ);
// для агрегованих multi-org рядків (Op2b) — розбиття пропорційно вагам Казни.
// NET-ФЛ (Op2a) вже заповнені при створенні — НЕ чіпаються.
Процедура _ОтрЗП_ПроставитьОргБухВсемФорма1()
	Ф1 = Перечисления.А_ФормыPL.Форма1;
	Мапы = _ОтрЗП_ПостроитьОргБухКазныФорма1();
	Неоднозначные = Новый Массив;
	КолБезОрг = 0;
	КолВихідних = НачисленнаяЗарплатаИВзносыПоФизлицам.Количество();
	Для і = 0 По КолВихідних - 1 Цикл
		Стр = НачисленнаяЗарплатаИВзносыПоФизлицам[і];
		Если Стр.ФормаPL <> Ф1 ИЛИ ЗначениеЗаполнено(Стр.ОрганизацияБухгалтерия) Тогда Продолжить; КонецЕсли;
		КлючФЛ = XMLСтрока(Стр.ФизическоеЛицо);
		КлючПС = КлючФЛ + "|" + XMLСтрока(Стр.ПодразделениеПредприятия) + "|" + XMLСтрока(Стр.СпособОтраженияЗарплатыВБухучете);
		Сум = Стр.Сумма + Стр.ВзносыВсего;
		Орг = Мапы.Точно[КлючПС + "|" + Формат(Окр(Сум, 2), "ЧДЦ=2; ЧГ=0; ЧРД=.")];
		Если Орг = Неопределено Тогда
			Орг = Мапы.ПоПС[КлючПС];
		КонецЕсли;
		Если Орг = Неопределено ИЛИ Орг = "?" Тогда
			Орг = Мапы.ПоФЛ[КлючФЛ];
		КонецЕсли;
		Если Орг <> Неопределено И Орг <> "?" Тогда
			Стр.ОрганизацияБухгалтерия = Орг;
		Иначе
			Неоднозначные.Добавить(і);
		КонецЕсли;
	КонецЦикла;

	// Розбиття агрегованих multi-org рядків (Op2b) по організаціях пропорційно Казні.
	Для Каждого і Из Неоднозначные Цикл
		Стр = НачисленнаяЗарплатаИВзносыПоФизлицам[і];
		КлючПС = XMLСтрока(Стр.ФизическоеЛицо) + "|" + XMLСтрока(Стр.ПодразделениеПредприятия)
			+ "|" + XMLСтрока(Стр.СпособОтраженияЗарплатыВБухучете);
		Список = Мапы.ПСписок[КлючПС];
		Если Список = Неопределено ИЛИ Список.Количество() = 0 Тогда
			КолБезОрг = КолБезОрг + 1;
		ИначеЕсли Список.Количество() = 1 Тогда
			Стр.ОрганизацияБухгалтерия = Список[0].Орг;
		Иначе
			_ОтрЗП_РазбитьСтрокуПоОрг(Стр, Список);
		КонецЕсли;
	КонецЦикла;

	Если КолБезОрг > 0 Тогда
		Сообщить("ОрганизацияБухгалтерия: " + КолБезОрг
			+ " Форма1-рядків без організації (немає ДокРаспределениеЗП у відповідних рядках Казни).");
	КонецЕсли;
КонецПроцедуры

// Авторитетне рознесення ОрганизацияБухгалтерия Форма1-рядків по юрлицях із НачисленияБух
// (bukh-істина, per-org GROSS, містить ВСІ юрлиця). Перекриває розкидані Казна-присвоєння
// (Op2a _ОтрЗП_РаспределитьПоВесам / Op1 ЕСВ / шаг7 _ОтрЗП_ПроставитьОргБухВсемФорма1), бо
// РаспределениеКазна не містить частину юрлиць (напр. ДЖИ ТРИ КОНСТРАКШН) → Приход колапсує
// на одне юрлице → перекіс ± у А_ВзаиморасчетыССотрудниками.
// GUARD: ФЛ, у якого поточний per-org розподіл Форма1 вже = GROSS-частці (до копійки), НЕ чіпаємо
// (балансні ФЛ без регресу, у т.ч. кореляція орг↔підрозділ збережена).
// Розщеплення — _ОтрЗП_РазбитьСтрокуПоОрг (Сумма+ВзносыВсего по вагах). Σ по ФЛ незмінна.
Процедура _ОтрЗП_ВыровнятьОргБухФорма1ПоНачисленияБух()
	Ф1 = Перечисления.А_ФормыPL.Форма1;

	// 1. Ваги GROSS per ФЛ із НачисленияБух
	ВесаПоФЛ = Новый Соответствие;
	Для Каждого СтрНБ Из НачисленияБух Цикл
		Если НЕ ЗначениеЗаполнено(СтрНБ.ФизЛицо) ИЛИ НЕ ЗначениеЗаполнено(СтрНБ.Организация) Тогда
			Продолжить;
		КонецЕсли;
		_ОтрЗП_НакопитьСписокОрг(ВесаПоФЛ, XMLСтрока(СтрНБ.ФизЛицо), СтрНБ.Организация, СтрНБ.Сумма);
	КонецЦикла;

	// 2. Поточний per-org розподіл Форма1 (Сумма+ВзносыВсего) + індекси рядків, per ФЛ (тільки multi-org)
	ТекущиеПоФЛ = Новый Соответствие;
	ИндексыПоФЛ = Новый Соответствие;
	Кол = НачисленнаяЗарплатаИВзносыПоФизлицам.Количество();
	Для і = 0 По Кол - 1 Цикл
		Стр = НачисленнаяЗарплатаИВзносыПоФизлицам[і];
		Если Стр.ФормаPL <> Ф1 Тогда Продолжить; КонецЕсли;
		КлючФЛ = XMLСтрока(Стр.ФизическоеЛицо);
		Список = ВесаПоФЛ[КлючФЛ];
		Если Список = Неопределено ИЛИ Список.Количество() <= 1 Тогда Продолжить; КонецЕсли;

		Тек = ТекущиеПоФЛ[КлючФЛ];
		Если Тек = Неопределено Тогда
			Тек = Новый Соответствие;
			ТекущиеПоФЛ.Вставить(КлючФЛ, Тек);
		КонецЕсли;
		ТекОрг = ?(Тек[Стр.ОрганизацияБухгалтерия] = Неопределено, 0, Тек[Стр.ОрганизацияБухгалтерия]);
		Тек.Вставить(Стр.ОрганизацияБухгалтерия, ТекОрг + Стр.Сумма + Стр.ВзносыВсего);

		Инд = ИндексыПоФЛ[КлючФЛ];
		Если Инд = Неопределено Тогда
			Инд = Новый Массив;
			ИндексыПоФЛ.Вставить(КлючФЛ, Инд);
		КонецЕсли;
		Инд.Добавить(і);
	КонецЦикла;

	// 3. По кожному multi-org ФЛ: guard (skip балансних) + ре-сплит зламаних
	КолВыровнено = 0;
	Для Каждого КЗ Из ИндексыПоФЛ Цикл
		Список = ВесаПоФЛ[КЗ.Ключ];
		Тек    = ТекущиеПоФЛ[КЗ.Ключ];

		ИтогФЛ = 0;
		Для Каждого ОЗ Из Тек Цикл ИтогФЛ = ИтогФЛ + ОЗ.Значение; КонецЦикла;
		ИтогоВес = 0;
		Для Каждого Э Из Список Цикл ИтогоВес = ИтогоВес + Э.Вес; КонецЦикла;
		Если ИтогоВес = 0 Тогда Продолжить; КонецЕсли;

		// GUARD: поточне = GROSS-частці (до копійки)?
		Совпадает = Истина;
		Для Каждого Э Из Список Цикл
			Целевая = Окр(ИтогФЛ * Э.Вес / ИтогоВес, 2);
			Текущая = ?(Тек[Э.Орг] = Неопределено, 0, Тек[Э.Орг]);
			Если ?(Целевая >= Текущая, Целевая - Текущая, Текущая - Целевая) > 0.10 Тогда
				Совпадает = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Совпадает Тогда Продолжить; КонецЕсли;

		// Ре-сплит кожного Форма1-рядка ФЛ по вагах НачисленияБух (індекси зібрані до додавання рядків)
		Для Каждого і Из КЗ.Значение Цикл
			_ОтрЗП_РазбитьСтрокуПоОрг(НачисленнаяЗарплатаИВзносыПоФизлицам[і], Список);
		КонецЦикла;
		КолВыровнено = КолВыровнено + 1;
	КонецЦикла;

	Если КолВыровнено > 0 Тогда
		Сообщить("ОргБух Форма1: вирівняно по НачисленияБух для " + КолВыровнено + " multi-org ФЛ.");
	КонецЕсли;
КонецПроцедуры

// Будує структуру СправочныеДанные:
//   ФизЛица                   — Соответствие(Сотрудник → ФизическоеЛицо)
//   СотрудникПоФизЛицу         — Соответствие(ФизическоеЛицо → Сотрудник) (з РаспределениеКазна)
//   РаспредПоПодразделениям    — Соответствие(Сотрудник → Соответствие(Налог/КлючБазовые → Структура(Подразделения, Итого)))
//   РаспредНалоговПоСотрудникам — Соответствие(Сотрудник → Структура(Подразделения, Итого)) — для Op 3
//   NETПоФизЛицу               — Соответствие(ФизическоеЛицо → Число) — NET зарплата для Op 2
//   + константи: ВидОперации, ТипыНалогов, ГруппаУчетаЗарплата, СпособОтраженияПоУмолчанию, НалогЕСВФОТ, КлючБазовые, ПодразделениеЦО
Функция _ОтрЗП_ПодготовитьСправочныеДанные()

	Данные = Новый Структура;

	// Збираємо всіх Сотрудників з РаспределениеКазна + НалогиБухгалтерия
	ВсеСотрудники = Новый Массив;
	Для Каждого Стр Из РаспределениеКазна Цикл
		Если ЗначениеЗаполнено(Стр.Сотрудник) И ВсеСотрудники.Найти(Стр.Сотрудник) = Неопределено Тогда
			ВсеСотрудники.Добавить(Стр.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из НалогиБухгалтерия Цикл
		Если ЗначениеЗаполнено(Стр.Сотрудник) И ВсеСотрудники.Найти(Стр.Сотрудник) = Неопределено Тогда
			ВсеСотрудники.Добавить(Стр.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	// ФизЛица: Сотрудник → ФізОсоба
	ФизЛица = _ОтрЗП_ПолучитьФизЛицаМап(ВсеСотрудники);
	Данные.Вставить("ФизЛица", ФизЛица);

	// Зворотна мапа: ФізОсоба → Сотрудник (для Op 2)
	СотрудникПоФизЛицу = Новый Соответствие;
	Для Каждого КЗ Из ФизЛица Цикл
		Если ЗначениеЗаполнено(КЗ.Значение) И СотрудникПоФизЛицу[КЗ.Значение] = Неопределено Тогда
			СотрудникПоФизЛицу.Вставить(КЗ.Значение, КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Данные.Вставить("СотрудникПоФизЛицу", СотрудникПоФизЛицу);

	// Розподіл по підрозділах (для Op 1 + Op 2)
	Данные.Вставить("РаспредПоПодразделениям", _ОтрЗП_ПодготовитьРаспредПоПодразделениям());

	// Розподіл Налогов по Сотрудникам (для Op 3 fallback)
	Данные.Вставить("РаспредНалоговПоСотрудникам", _ОтрЗП_ПодготовитьРаспредНалоговПоСотрудникам());

	// NET ЗП по ФізОсобі (для Op 2)
	Данные.Вставить("NETПоФизЛицу", _ОтрЗП_ОбчислитиNETПоФизЛицу());

	// Сума НДФЛ+ВС по ФізЛица (валоризація gross = net + НДФЛ+ВС).
	// Бухгалтерський сенс: ми компенсуємо сотруднику утриманий податок,
	// додаючи його до "чистої" суми виплати у Казні, щоб отримати валову нараховану зарплату.
	Данные.Вставить("СуммаНДФЛПоФизЛицу", _ОтрЗП_ОбчислитиСуммаНДФЛПоФизЛицу());

	// Константи
	Данные.Вставить("ГруппаУчетаЗарплата", Справочники.ГруппыУчетаНачисленийИУдержаний.Зарплата);
	Данные.Вставить("ВидОперацииНачислено", Перечисления.ВидыОперацийПоЗарплате.НачисленоДоход);
	Данные.Вставить("ВидОперацииВоенныйСбор", Перечисления.ВидыОперацийПоЗарплате.ВоенныйСбор);
	Данные.Вставить("ВидОперацииНДФЛ", Перечисления.ВидыОперацийПоЗарплате.НДФЛ);
	Данные.Вставить("ТипНалогаВС", Перечисления.ТипыНалогов.ВоенныйСбор);
	Данные.Вставить("ТипНалогаНДФЛ", Перечисления.ТипыНалогов.НДФЛ);
	Данные.Вставить("СпособОтраженияПоУмолчанию",
		Справочники.СпособыОтраженияЗарплатыВБухУчете.НайтиПоНаименованию("Зарплата производственного персонала"));
	Данные.Вставить("НалогЕСВФОТ", Справочники.Налоги.НайтиПоНаименованию("ЕСВ ФОТ"));
	Данные.Вставить("КлючБазовые", "БазовыеНачисления");

	// Підрозділ "ЦО" — fallback для Op 2 коли ФізЛицо нема в РаспределениеКазна
	ПодрЦО = Справочники.СтруктураПредприятия.НайтиПоНаименованию("ЦО");
	Если НЕ ЗначениеЗаполнено(ПодрЦО) Тогда
		ПодрЦО = Справочники.СтруктураПредприятия.НайтиПоКоду("ЦО");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПодрЦО) Тогда
		Сообщить("Увага: не знайдено підрозділ 'ЦО' у СтруктураПредприятия — fallback рядки залишаться без підрозділу");
		ПодрЦО = Справочники.СтруктураПредприятия.ПустаяСсылка();
	КонецЕсли;
	Данные.Вставить("ПодразделениеЦО", ПодрЦО);

	// === Частина A: дані для нового алгоритму розмітки ФормаPL (ФЛ з НачисленияУпр≠0) ===
	Данные.Вставить("GROSSбухПоФизЛицу", _ОтрЗП_ОбчислитиGROSSбухПоФизЛицу());
	Данные.Вставить("РаспредКазнаПоФормам", _ОтрЗП_ПостроитьРаспредКазнаПоФормам());
	Данные.Вставить("СпособУдержания",
		Справочники.СпособыОтраженияЗарплатыВБухУчете.НайтиПоНаименованию("Удержание с админ зарплату"));

	Возврат Данные;

КонецФункции

Функция _ОтрЗП_ПолучитьФизЛицаМап(МассивСотрудников)

	Результат = Новый Соответствие;
	Если МассивСотрудников.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Ссылка В(&МассивСотрудников)";
	Запрос.УстановитьПараметр("МассивСотрудников", МассивСотрудников);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Сотрудник, Выборка.ФизическоеЛицо);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Розподіл по підрозділах з РаспределениеКазна:
// Соответствие(Сотрудник → Соответствие(Налог/"БазовыеНачисления" → Структура(Подразделения, Итого)))
Функция _ОтрЗП_ПодготовитьРаспредПоПодразделениям()

	Результат = Новый Соответствие;
	КлючБазовые = "БазовыеНачисления";

	Для Каждого СтрокаКазны Из РаспределениеКазна Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКазны.СтатьяДвиженияДенежныхСредств) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаКазны.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		НалогСтатьи = СтрокаКазны.СтатьяДвиженияДенежныхСредств.А_Налог;
		СпособОтражения = СтрокаКазны.СтатьяДвиженияДенежныхСредств.А_СпособОтраженияЗарплатыВБухучете;
		КлючНалога = ?(ЗначениеЗаполнено(НалогСтатьи), НалогСтатьи, КлючБазовые);

		Сотрудник = СтрокаКазны.Сотрудник;
		Подразделение = СтрокаКазны.Подразделение;

		ДанныеСотрудника = Результат[Сотрудник];
		Если ДанныеСотрудника = Неопределено Тогда
			ДанныеСотрудника = Новый Соответствие;
			Результат.Вставить(Сотрудник, ДанныеСотрудника);
		КонецЕсли;

		ДанныеНалога = ДанныеСотрудника[КлючНалога];
		Если ДанныеНалога = Неопределено Тогда
			ДанныеНалога = Новый Структура("Подразделения, Итого", Новый Соответствие, 0);
			ДанныеСотрудника.Вставить(КлючНалога, ДанныеНалога);
		КонецЕсли;

		ДанныеПодр = ДанныеНалога.Подразделения[Подразделение];
		Если ДанныеПодр = Неопределено Тогда
			ДанныеПодр = Новый Структура("Сумма, СпособОтражения", 0, СпособОтражения);
			ДанныеНалога.Подразделения.Вставить(Подразделение, ДанныеПодр);
		КонецЕсли;

		ДанныеПодр.Сумма = ДанныеПодр.Сумма + СтрокаКазны.Сумма;
		Если НЕ ЗначениеЗаполнено(ДанныеПодр.СпособОтражения) И ЗначениеЗаполнено(СпособОтражения) Тогда
			ДанныеПодр.СпособОтражения = СпособОтражения;
		КонецЕсли;
		ДанныеНалога.Итого = ДанныеНалога.Итого + СтрокаКазны.Сумма;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Розподіл Налогов (СуммаНалогов > 0) по Сотрудникам
Функция _ОтрЗП_ПодготовитьРаспредНалоговПоСотрудникам()

	Результат = Новый Соответствие;
	Для Каждого СтрокаКазны Из РаспределениеКазна Цикл
		Если СтрокаКазны.СуммаНалогов = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаКазны.СтатьяДвиженияДенежныхСредств) Тогда
			Продолжить;
		КонецЕсли;

		СпособОтражения = СтрокаКазны.СтатьяДвиженияДенежныхСредств.А_СпособОтраженияЗарплатыВБухучете;
		Сотрудник = СтрокаКазны.Сотрудник;
		Подразделение = СтрокаКазны.Подразделение;
		СумНал = СтрокаКазны.СуммаНалогов;

		ДанныеСотрудника = Результат[Сотрудник];
		Если ДанныеСотрудника = Неопределено Тогда
			ДанныеСотрудника = Новый Структура("Подразделения, Итого", Новый Соответствие, 0);
			Результат.Вставить(Сотрудник, ДанныеСотрудника);
		КонецЕсли;

		ДанныеПодр = ДанныеСотрудника.Подразделения[Подразделение];
		Если ДанныеПодр = Неопределено Тогда
			ДанныеПодр = Новый Структура("Сумма, СпособОтражения", 0, СпособОтражения);
			ДанныеСотрудника.Подразделения.Вставить(Подразделение, ДанныеПодр);
		КонецЕсли;

		ДанныеПодр.Сумма = ДанныеПодр.Сумма + СумНал;
		Если НЕ ЗначениеЗаполнено(ДанныеПодр.СпособОтражения) И ЗначениеЗаполнено(СпособОтражения) Тогда
			ДанныеПодр.СпособОтражения = СпособОтражения;
		КонецЕсли;
		ДанныеСотрудника.Итого = ДанныеСотрудника.Итого + СумНал;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// NET = SUM(НачисленияУпр.Сумма по ФізЛицу) - SUM(УдержанияУпр.Сумма по ФізЛицу, БЕЗ ВидРасчета "Утримано по бухгалтерії")
// Сума начислень по ФізОсобі (ТІЛЬКИ з НачисленияУпр, БЕЗ віднімання УдержанияУпр).
// Бухгалтерський сенс: це "чисте" нарахування зарплати з управлінки,
// яке далі валоризується (+ СуммаНДФЛ з НалогиБухгалтерия) для отримання gross.
// Штрафи (УдержанияУпр) окремо йдуть у НачислениеЗарплаты.Начисления з видом "Штраф (упр)".
Функция _ОтрЗП_ОбчислитиNETПоФизЛицу()

	Результат = Новый Соответствие;

	Для Каждого Стр Из НачисленияУпр Цикл
		Ключ = Стр.ФизЛицо;
		Если НЕ ЗначениеЗаполнено(Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Сум = Результат[Ключ];
		Если Сум = Неопределено Тогда
			Сум = 0;
		КонецЕсли;
		Результат[Ключ] = Сум + Стр.Сумма;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сума СуммаНДФЛ (НДФЛ+ВС) по ФізЛица — з НалогиБухгалтерия.
// Використовується для валоризації: валова зарплата = NET + цей НДФЛ+ВС.
Функция _ОтрЗП_ОбчислитиСуммаНДФЛПоФизЛицу()

	Результат = Новый Соответствие;

	Для Каждого Стр Из НалогиБухгалтерия Цикл
		// Беремо ТІЛЬКИ рядки з НДФЛ/ВС (не ЄСВ).
		ЦеНДФЛабоВС = (Стр.ТипНалога = Перечисления.ТипыНалогов.НДФЛ
			ИЛИ Стр.ТипНалога = Перечисления.ТипыНалогов.ВоенныйСбор);
		Если НЕ ЦеНДФЛабоВС Тогда
			Продолжить;
		КонецЕсли;

		// Беремо СуммаНДФЛ з fallback на Сумма (для старих записів)
		СуммаНДФЛ = Стр.СуммаНДФЛ;
		Если СуммаНДФЛ = 0 Тогда
			СуммаНДФЛ = Стр.Сумма;
		КонецЕсли;
		Если СуммаНДФЛ = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Стр.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		ФизЛицо = Неопределено;
		Попытка
			ФизЛицо = Стр.Сотрудник.ФизическоеЛицо;
		Исключение
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
			Продолжить;
		КонецЕсли;

		Поточна = Результат[ФизЛицо];
		Если Поточна = Неопределено Тогда
			Поточна = 0;
		КонецЕсли;
		Результат[ФизЛицо] = Поточна + СуммаНДФЛ;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// === Частина A: новий алгоритм розмітки ФормаPL для ФЛ з НачисленияУпр≠0 ===
// (див. PROMPT_ФормаPL_split_и_ОрганизацияБух.md)

// GROSS офіційного нарахування per ФЛ (Σ НачисленияБух.Сумма) — база для Ф1.
Функция _ОтрЗП_ОбчислитиGROSSбухПоФизЛицу()
	Результат = Новый Соответствие;
	Для Каждого Стр Из НачисленияБух Цикл
		Если НЕ ЗначениеЗаполнено(Стр.ФизЛицо) Тогда Продолжить; КонецЕсли;
		Тек = Результат[Стр.ФизЛицо];
		Результат[Стр.ФизЛицо] = ?(Тек = Неопределено, 0, Тек) + Стр.Сумма;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Розподіл РаспределениеКазна по формах per ФЛ — для нового алгоритму Ф1/Ф2.
// Повертає Соответствие: ФизЛицо → Структура("Ф1Нач, Ф2Прем, Ф2Непрем, Удерж"),
// де кожне — Массив структур("Подразделение, Организация, Способ, Вес").
//   Ф1Нач    — Форма1, нарахування (А_ЭтоУдержание=Ложь, СуммаНачисления<>0)
//   Ф2Прем   — Форма2, премія (ДокРаспределениеЗП = РаспределениеФ2 з А_Начисление=Истина)
//   Ф2Непрем — Форма2, регулярна (не премія)
//   Удерж    — Форма1, утримання (А_ЭтоУдержание=Истина), Вес = СуммаНалогов
Функция _ОтрЗП_ПостроитьРаспредКазнаПоФормам()
	Ф1 = Перечисления.А_ФормыPL.Форма1;
	ТипФ2Док = Тип("ДокументСсылка.РаспределениеФ2");
	ТипРаспредЗП = Тип("ДокументСсылка.А_РаспределениеЗаработнойПлаты");
	Результат = Новый Соответствие;

	Для Каждого СтрК Из РаспределениеКазна Цикл
		ФизЛицо = СтрК.Сотрудник.ФизическоеЛицо;
		Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда Продолжить; КонецЕсли;

		Способ = СтрК.СтатьяДвиженияДенежныхСредств.А_СпособОтраженияЗарплатыВБухучете;
		ЭтоУдерж = ?(ЗначениеЗаполнено(Способ), Способ.А_ЭтоУдержание, Ложь);
		ЭтоФорма1 = (СтрК.ФормаPL = Ф1);

		ЭтоПремия = Ложь;
		Если ТипЗнч(СтрК.ДокРаспределениеЗП) = ТипФ2Док И ЗначениеЗаполнено(СтрК.ДокРаспределениеЗП) Тогда
			ЭтоПремия = СтрК.ДокРаспределениеЗП.А_Начисление;
		КонецЕсли;

		// ОргБух — з документа-підстави (РаспределениеЗаработнойПлаты), а НЕ з Казни (там буває помилкова).
		// Для Форма1 документ А_РаспределениеЗаработнойПлаты існує завжди.
		ОргБухСтр = СтрК.Организация;
		Если ТипЗнч(СтрК.ДокРаспределениеЗП) = ТипРаспредЗП Тогда
			ОргБухСтр = СтрК.ДокРаспределениеЗП.Организация;
		КонецЕсли;

		Данные = Результат[ФизЛицо];
		Если Данные = Неопределено Тогда
			Данные = Новый Структура("Ф1Нач, Ф2Прем, Ф2Непрем, Удерж",
				Новый Массив, Новый Массив, Новый Массив, Новый Массив);
			Результат.Вставить(ФизЛицо, Данные);
		КонецЕсли;

		Если ЭтоФорма1 И ЭтоУдерж И СтрК.СуммаНалогов <> 0 Тогда
			Данные.Удерж.Добавить(Новый Структура("Подразделение, Организация, Способ, Вес",
				СтрК.Подразделение, ОргБухСтр, Способ, СтрК.СуммаНалогов));
		ИначеЕсли ЭтоФорма1 И НЕ ЭтоУдерж И СтрК.СуммаНачисления <> 0 Тогда
			Данные.Ф1Нач.Добавить(Новый Структура("Подразделение, Организация, Способ, Вес",
				СтрК.Подразделение, ОргБухСтр, Способ, СтрК.СуммаНачисления));
		ИначеЕсли НЕ ЭтоФорма1 И СтрК.СуммаНачисления <> 0 Тогда
			Цель = ?(ЭтоПремия, Данные.Ф2Прем, Данные.Ф2Непрем);
			Цель.Добавить(Новый Структура("Подразделение, Организация, Способ, Вес",
				СтрК.Подразделение, ОргБухСтр, Способ, СтрК.СуммаНачисления));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Додає рядок НачисленнаяЗарплатаИВзносыПоФизлицам з явними ФормаPL / ОрганизацияБухгалтерия.
Процедура _ОтрЗП_ДобавитьНЗ(ФизЛицо, Сумма, Подразделение, ОргБух, Способ, ФормаPL, Справочные)
	Если Сумма = 0 Тогда Возврат; КонецЕсли;
	НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
	НоваяСтрока.Организация = Организация;
	НоваяСтрока.ФизическоеЛицо = ФизЛицо;
	НоваяСтрока.ВидОперации = Справочные.ВидОперацииНачислено;
	НоваяСтрока.ГруппаУчетаНачислений = Справочные.ГруппаУчетаЗарплата;
	НоваяСтрока.СпособОтраженияЗарплатыВБухучете =
		?(ЗначениеЗаполнено(Способ), Способ, Справочные.СпособОтраженияПоУмолчанию);
	Если ЗначениеЗаполнено(Подразделение) Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;
	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.ВзносыВсего = 0;
	НоваяСтрока.ФормаPL = ФормаPL;
	Если ЗначениеЗаполнено(ОргБух) Тогда
		НоваяСтрока.ОрганизацияБухгалтерия = ОргБух;
	КонецЕсли;
КонецПроцедуры

// Розподіляє Сумму по Списку (Массив структур Подразделение/Организация/Способ/Вес)
// методом «залишок на останньому», створює рядки НЗ із заданою ФормаPL.
// СтавитьОргБух=Истина → ОрганизацияБухгалтерия з елемента; інакше пусто.
Процедура _ОтрЗП_РаспределитьПоВесам(ФизЛицо, Сумма, Список, ФормаPL, СтавитьОргБух, Справочные)
	Если Сумма = 0 ИЛИ Список.Количество() = 0 Тогда Возврат; КонецЕсли;
	Итого = 0;
	Для Каждого Эл Из Список Цикл Итого = Итого + Эл.Вес; КонецЦикла;
	Если Итого = 0 Тогда Возврат; КонецЕсли;

	ПустаяОрг = Справочники.Организации.ПустаяСсылка();
	Остаток = Сумма;
	Счетчик = 0;
	Кол = Список.Количество();
	Для Каждого Эл Из Список Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик = Кол Тогда
			Частина = Остаток;
		Иначе
			Частина = Окр(Сумма * Эл.Вес / Итого, 2);
			Остаток = Остаток - Частина;
		КонецЕсли;
		ОргБух = ?(СтавитьОргБух, Эл.Организация, ПустаяОрг);
		_ОтрЗП_ДобавитьНЗ(ФизЛицо, Частина, Эл.Подразделение, ОргБух, Эл.Способ, ФормаPL, Справочные);
	КонецЦикла;
КонецПроцедуры

// Накопичує Ф2-суму по підрозділу (премія + залишок одного підрозділу → один рядок).
Процедура _ОтрЗП_НакопитьФ2(Мапа, Подразделение, Способ, Сумма)
	Тек = Мапа[Подразделение];
	Если Тек = Неопределено Тогда
		Тек = Новый Структура("Сумма, Способ", 0, Способ);
		Мапа.Вставить(Подразделение, Тек);
	КонецЕсли;
	Тек.Сумма = Тек.Сумма + Сумма;
	Если НЕ ЗначениеЗаполнено(Тек.Способ) И ЗначениеЗаполнено(Способ) Тогда
		Тек.Способ = Способ;
	КонецЕсли;
КонецПроцедуры

// Новий алгоритм Ф1/Ф2 для одного ФЛ з НачисленияУпр≠0 (Частина A промту):
//   Ф1 = max(0, min(NET, GROSSбух − НДФЛ));  Ф2 = NET − Ф1
//   «Зарплата управл» Ф1 — по коеф Форма1-нарахувань Казни (ОргБух з Казни)
//   «Зарплата управл» Ф2 — премії як є + залишок по коеф не-премій (ОргБух пусто)
//   «Удержание» Ф1 — НДФЛ по підрозділах утримання Казни (ОргБух з Казни)
// Інваріант: Σ(Ф1+Ф2 «Зарплата управл») = NET (= НачисленияУпр).
Процедура _ОтрЗП_СоздатьСтрокиNETФЛ_Новый(ФизЛицо, NET, НДФЛДляФЛ, Справочные)
	Ф1 = Перечисления.А_ФормыPL.Форма1;
	Ф2 = Перечисления.А_ФормыPL.Форма2;
	ПустаяОрг = Справочники.Организации.ПустаяСсылка();
	Данные = Справочные.РаспредКазнаПоФормам[ФизЛицо];

	GROSSбух = Справочные.GROSSбухПоФизЛицу[ФизЛицо];
	Если GROSSбух = Неопределено Тогда GROSSбух = 0; КонецЕсли;

	Ф1Сумма = GROSSбух - НДФЛДляФЛ;
	Если Ф1Сумма < 0 Тогда Ф1Сумма = 0; КонецЕсли;
	Если Ф1Сумма > NET Тогда Ф1Сумма = NET; КонецЕсли;
	Ф2Сумма = NET - Ф1Сумма;

	// --- Ф1 «Зарплата управл» (офіційна take-home), по коеф Форма1-нарахувань Казни ---
	Если Ф1Сумма > 0 Тогда
		Список = ?(Данные = Неопределено, Неопределено, Данные.Ф1Нач);
		Если Список = Неопределено ИЛИ Список.Количество() = 0 Тогда
			_ОтрЗП_ДобавитьНЗ(ФизЛицо, Ф1Сумма, Справочные.ПодразделениеЦО, Организация, Неопределено, Ф1, Справочные);
		Иначе
			_ОтрЗП_РаспределитьПоВесам(ФизЛицо, Ф1Сумма, Список, Ф1, Истина, Справочные);
		КонецЕсли;
	КонецЕсли;

	// --- Ф2 «Зарплата управл»: премії як є + залишок по не-преміях (ОргБух пусто) ---
	// Накопичуємо по підрозділах, щоб премія+залишок одного підрозділу були ОДНИМ рядком.
	Если Ф2Сумма <> 0 Тогда
		Прем   = ?(Данные = Неопределено, Новый Массив, Данные.Ф2Прем);
		Непрем = ?(Данные = Неопределено, Новый Массив, Данные.Ф2Непрем);
		Ф2ПоПодр = Новый Соответствие; // Подразделение → Структура("Сумма, Способ")

		СумПремий = 0;
		Для Каждого Эл Из Прем Цикл
			СумПремий = СумПремий + Эл.Вес;
			_ОтрЗП_НакопитьФ2(Ф2ПоПодр, Эл.Подразделение, Эл.Способ, Эл.Вес);
		КонецЦикла;

		Остаток = Ф2Сумма - СумПремий;
		Если Остаток <> 0 И Непрем.Количество() > 0 Тогда
			ИтогоНеп = 0;
			Для Каждого Эл Из Непрем Цикл ИтогоНеп = ИтогоНеп + Эл.Вес; КонецЦикла;
			Если ИтогоНеп <> 0 Тогда
				ОстЗалишок = Остаток;
				Сч = 0;
				Для Каждого Эл Из Непрем Цикл
					Сч = Сч + 1;
					Если Сч = Непрем.Количество() Тогда
						Частина = ОстЗалишок;
					Иначе
						Частина = Окр(Остаток * Эл.Вес / ИтогоНеп, 2);
						ОстЗалишок = ОстЗалишок - Частина;
					КонецЕсли;
					_ОтрЗП_НакопитьФ2(Ф2ПоПодр, Эл.Подразделение, Эл.Способ, Частина);
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли Остаток <> 0 И Прем.Количество() > 0 Тогда
			_ОтрЗП_НакопитьФ2(Ф2ПоПодр, Прем[0].Подразделение, Прем[0].Способ, Остаток);
		ИначеЕсли Остаток <> 0 Тогда
			_ОтрЗП_НакопитьФ2(Ф2ПоПодр, Справочные.ПодразделениеЦО, Неопределено, Остаток);
		КонецЕсли;

		Для Каждого КЗ Из Ф2ПоПодр Цикл
			_ОтрЗП_ДобавитьНЗ(ФизЛицо, КЗ.Значение.Сумма, КЗ.Ключ, ПустаяОрг, КЗ.Значение.Способ, Ф2, Справочные);
		КонецЦикла;
	КонецЕсли;

	// --- «Удержание» Ф1 (НДФЛ+ВС), по підрозділах утримання Казни ---
	Если НДФЛДляФЛ <> 0 Тогда
		Список = ?(Данные = Неопределено, Неопределено, Данные.Удерж);
		Если Список = Неопределено ИЛИ Список.Количество() = 0 Тогда
			_ОтрЗП_ДобавитьНЗ(ФизЛицо, НДФЛДляФЛ, Справочные.ПодразделениеЦО, Организация, Справочные.СпособУдержания, Ф1, Справочные);
		Иначе
			_ОтрЗП_РаспределитьПоВесам(ФизЛицо, НДФЛДляФЛ, Список, Ф1, Истина, Справочные);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Op 1: НалогиБухгалтерия → НачисленнаяЗарплатаИВзносыПоФизлицам (ФОТ/взноси)
// КРИТИЧНО: оброблюємо ТІЛЬКИ рядки з СуммаФОТ > 0 (реальні ФОТ/ЄСВ).
// Рядки НДФЛ/ВС (де СуммаНДФЛ > 0) обробляються в Op 3.
Процедура _ОтрЗП_ЗаполнитьНачисленияИзНалогов(Справочные)

	Для Каждого СтрокаНалога Из НалогиБухгалтерия Цикл

		// Беремо тільки реальні ФОТ-рядки. Не-ФОТ (НДФЛ/ВС) — пропускаємо.
		Если СтрокаНалога.СуммаФОТ = 0 Тогда
			Продолжить;
		КонецЕсли;

		ЭтоФОТ = Истина;
		СуммаДляРаспределения = СтрокаНалога.СуммаФОТ;

		Сотрудник = СтрокаНалога.Сотрудник;

		НалогДляПоиска = СтрокаНалога.НалогСтатьяДвиженияДенежныхСредств;
		ДанныеНалога = _ОтрЗП_ПолучитьДанныеРаспределения(Сотрудник, НалогДляПоиска, Справочные);

		// FALLBACK 1: якщо не знайдено розподіл за конкретним податком —
		// беремо БАЗОВИЙ розподіл сотрудника (підрозділ його основної зарплати).
		// Це гарантує що ФОТ-рядки йдуть на той самий підрозділ що й основне начислення.
		Если ДанныеНалога = Неопределено Тогда
			ДанныеСотр = Справочные.РаспредПоПодразделениям[Сотрудник];
			Если ДанныеСотр <> Неопределено Тогда
				ДанныеНалога = ДанныеСотр[Справочные.КлючБазовые];
				Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого = 0 Тогда
					ДанныеНалога = Неопределено;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// FALLBACK 2: якщо навіть базовий розподіл не знайдено — рядок з підрозділом ЦО.
		Если ДанныеНалога = Неопределено Тогда
			НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
			_ОтрЗП_ЗаполнитьСтрокуНачисления(НоваяСтрока, СтрокаНалога,
				СуммаДляРаспределения, Справочные.ПодразделениеЦО, Неопределено, ЭтоФОТ, Справочные);
			Продолжить;
		КонецЕсли;

		_ОтрЗП_РаспределитьПоПодразделениям(СтрокаНалога, СуммаДляРаспределения, ДанныеНалога, ЭтоФОТ, Справочные);

	КонецЦикла;

КонецПроцедуры

// Пропорційний розподіл ФОТ-суми по підрозділах
Процедура _ОтрЗП_РаспределитьПоПодразделениям(СтрокаНалога, СуммаДляРаспределения, ДанныеНалога, ЭтоФОТ, Справочные)

	Итого = ДанныеНалога.Итого;
	Остаток = СуммаДляРаспределения;
	Счетчик = 0;
	КоличествоПодр = ДанныеНалога.Подразделения.Количество();

	Для Каждого КЗ Из ДанныеНалога.Подразделения Цикл
		Подразделение = КЗ.Ключ;
		ДанныеПодр = КЗ.Значение;
		Счетчик = Счетчик + 1;

		Если Счетчик = КоличествоПодр Тогда
			СуммаДляПодр = Остаток;
		Иначе
			Доля = ДанныеПодр.Сумма / Итого;
			СуммаДляПодр = Окр(СуммаДляРаспределения * Доля, 2);
			Остаток = Остаток - СуммаДляПодр;
		КонецЕсли;

		Если СуммаДляПодр = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
		_ОтрЗП_ЗаполнитьСтрокуНачисления(НоваяСтрока, СтрокаНалога,
			СуммаДляПодр, Подразделение, ДанныеПодр.СпособОтражения, ЭтоФОТ, Справочные);
	КонецЦикла;

КонецПроцедуры

Процедура _ОтрЗП_ЗаполнитьСтрокуНачисления(НоваяСтрока, СтрокаНалога, Сумма, Подразделение, СпособОтражения, ЭтоФОТ, Справочные)

	НоваяСтрока.Организация = Организация;
	НоваяСтрока.ВидОперации = Справочные.ВидОперацииНачислено;
	НоваяСтрока.ГруппаУчетаНачислений = Справочные.ГруппаУчетаЗарплата;
	НоваяСтрока.ФизическоеЛицо = Справочные.ФизЛица[СтрокаНалога.Сотрудник];

	Если ЗначениеЗаполнено(СпособОтражения) Тогда
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СпособОтражения;
	Иначе
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = Справочные.СпособОтраженияПоУмолчанию;
	КонецЕсли;

	Если Подразделение <> Неопределено Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;

	Если ЭтоФОТ Тогда
		НоваяСтрока.ВзносыВсего = Сумма;
		НоваяСтрока.Сумма = 0;
		НоваяСтрока.Налог = СтрокаНалога.Налог;
	Иначе
		НоваяСтрока.Сумма = Сумма;
		НоваяСтрока.ВзносыВсего = 0;
	КонецЕсли;

КонецПроцедуры

// Op 2: Заповнення начислень у НачисленнаяЗарплатаИВзносыПоФизлицам.
//
// ДЖЕРЕЛА (у пріоритеті):
//   2a) Для ФізОсіб, які Є в НачисленияУпр → беремо їхню суму з НачисленияУпр (ZUP_2, управлінські дані)
//       + ВАЛОРИЗАЦІЯ: додаємо СуммаНДФЛ з НалогиБухгалтерия (НДФЛ+ВС з ZUP_1)
//       = валова нарахована зарплата (gross)
//   2b) Для ФізОсіб, яких НЕМАЄ в НачисленияУпр, але Є в РаспределениеКазна (тобто в Казні)
//       → беремо суму з РаспределениеКазна.СуммаНачисления + ВАЛОРИЗАЦІЯ НДФЛ
//       Це fallback для людей, які отримують зарплату через Казну без запису в ZUP_2.
//
// РОЗПОДІЛ ПО ПІДРОЗДІЛАХ:
//   Пропорції беруться з РаспределениеКазна (БазовыеНачисления).
//   Якщо у сотрудника нема розподілу в Казні → підрозділ "ЦО" (fallback).
//
// УдержанияУпр (штрафи) НЕ віднімаються — вони йдуть окремо у Документ.НачислениеЗарплаты.Начисления
// як рядки на вид розрахунку "Штраф (упр)" з мінусом.
Процедура _ОтрЗП_ЗаполнитьНачисленияЗП(Справочные)

	NETПоФизЛицу = Справочные.NETПоФизЛицу;
	СотрудникПоФизЛицу = Справочные.СотрудникПоФизЛицу;
	РаспредПоПодразделениям = Справочные.РаспредПоПодразделениям;
	КлючБазовые = Справочные.КлючБазовые;
	СуммаНДФЛПоФизЛицу = Справочные.СуммаНДФЛПоФизЛицу;

	КолБезРаспределения = 0;
	ОброблениФизЛица = Новый Соответствие;

	// === Op 2a: NETПоФизЛицу (з НачисленияУпр - УдержанияУпр) ===
	// НДФЛ/ВС НЕ валоризуємо в NET — йде ОКРЕМИМ рядком на Способ з РаспределениеКазна (СуммаНалогов).
	Для Каждого КЗ Из NETПоФизЛицу Цикл
		ФизЛицо = КЗ.Ключ;
		NET = КЗ.Значение;

		// Отримуємо суму НДФЛ+ВС для цього ФЛ (БЕЗ додавання до NET!)
		НДФЛДляФЛ = СуммаНДФЛПоФизЛицу[ФизЛицо];
		Если НДФЛДляФЛ = Неопределено Тогда
			НДФЛДляФЛ = 0;
		КонецЕсли;
		// NET залишається чистим — НДФЛ піде окремо

		Если NET = 0 И НДФЛДляФЛ = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Позначаємо обробленим — щоб Op 2b не дублював
		ОброблениФизЛица.Вставить(ФизЛицо, Истина);

		// Новий алгоритм Ф1/Ф2 (Частина A промту): офіційна Ф1 (take-home) + управлінська Ф2.
		// Утримання (НДФЛ+ВС) — завжди Ф1; ОргБух заповнюється для Ф1-рядків з РаспределениеКазна.
		_ОтрЗП_СоздатьСтрокиNETФЛ_Новый(ФизЛицо, NET, НДФЛДляФЛ, Справочные);
	КонецЦикла;

	// === Op 2b: СуммаНачисления з РаспределениеКазна для НЕ-оброблених ФізОсіб ===
	// Збираємо мапу Сотрудник → СуммаНачисления (агреговано з РаспределениеКазна)
	СумНачПоСотруднику = Новый Соответствие;
	Для Каждого СтрокаКазны Из РаспределениеКазна Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКазны.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаКазны.СуммаНачисления = 0 Тогда
			Продолжить;
		КонецЕсли;
		Поточна = СумНачПоСотруднику[СтрокаКазны.Сотрудник];
		Если Поточна = Неопределено Тогда
			Поточна = 0;
		КонецЕсли;
		СумНачПоСотруднику[СтрокаКазны.Сотрудник] = Поточна + СтрокаКазны.СуммаНачисления;
	КонецЦикла;

	КолДобавленоKasni = 0;
	Для Каждого КЗ Из СумНачПоСотруднику Цикл
		Сотрудник = КЗ.Ключ;
		СумНачисления = КЗ.Значение;
		Если СумНачисления = 0 Тогда
			Продолжить;
		КонецЕсли;

		// Отримуємо ФізОсобу для цього Сотрудника (через кеш ФизЛица)
		ФизЛицо = Справочные.ФизЛица[Сотрудник];
		Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
			// Fallback: використати Сотрудник.ФизическоеЛицо напряму
			Попытка
				ФизЛицо = Сотрудник.ФизическоеЛицо;
			Исключение
				Продолжить;
			КонецПопытки;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
			Продолжить;
		КонецЕсли;

		// Пропускаємо якщо цю ФізОсобу вже обробив Op 2a
		Если ОброблениФизЛица[ФизЛицо] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		НДФЛДляФЛ = СуммаНДФЛПоФизЛицу[ФизЛицо];
		Если НДФЛДляФЛ = Неопределено Тогда
			НДФЛДляФЛ = 0;
		КонецЕсли;

		// ЄДИНИЙ сплітер (як Op2a): NET = Σ РаспределениеКазна.СуммаНачисления (усі форми).
		// Ф1 take-home = clamp(GROSSбух − НДФЛ, 0, NET) = Казна_Ф1; Ф2 = Казна_Ф2;
		// «Удержание» Ф1 = НДФЛ; спліт по підрозділах за вагами РаспределениеКазна (ФормаPL).
		// Було: агрегат + коефіцієнт-розмітка _ОтрЗП_РазметитьФормаPL, що схлопувала Ф1+Ф2
		//       і давала перекіс (Батрак Ф1=17717.12 замість 15400). Тепер сплит = Казна.ФормаPL.
		_ОтрЗП_СоздатьСтрокиNETФЛ_Новый(ФизЛицо, СумНачисления, НДФЛДляФЛ, Справочные);

		КолДобавленоKasni = КолДобавленоKasni + 1;
		ОброблениФизЛица.Вставить(ФизЛицо, Истина);
	КонецЦикла;

	Если КолБезРаспределения > 0 Тогда
		Сообщить("Op 2a: " + КолБезРаспределения + " ФізОсіб без розподілу в РаспределениеКазна — закинуто на підрозділ ЦО");
	КонецЕсли;
	Если КолДобавленоKasni > 0 Тогда
		Сообщить("Op 2b (fallback z Kazni): додано " + КолДобавленоKasni + " ФізОсіб з СуммаНачисления РаспределениеКазна");
	КонецЕсли;

КонецПроцедуры

// Пропорційний розподіл NET-суми по підрозділах (використовується в Op 2a і Op 2b)
Процедура _ОтрЗП_РаспределитьNETПоПодр(ФизЛицо, NET, ДанныеРаспр, Справочные)

	Итого = ДанныеРаспр.Итого;
	Остаток = NET;
	Счетчик = 0;
	КолПодр = ДанныеРаспр.Подразделения.Количество();

	Для Каждого КЗПодр Из ДанныеРаспр.Подразделения Цикл
		Подразделение = КЗПодр.Ключ;
		ДанныеПодр = КЗПодр.Значение;
		Счетчик = Счетчик + 1;

		Если Счетчик = КолПодр Тогда
			СуммаДляПодр = Остаток;
		Иначе
			Доля = ДанныеПодр.Сумма / Итого;
			СуммаДляПодр = Окр(NET * Доля, 2);
			Остаток = Остаток - СуммаДляПодр;
		КонецЕсли;

		Если СуммаДляПодр = 0 Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
		_ОтрЗП_ЗаполнитьСтрокуНачисленияЗП_ПоФизЛицу(НоваяСтрока, ФизЛицо, СуммаДляПодр, Подразделение, ДанныеПодр.СпособОтражения, Справочные);
	КонецЦикла;

КонецПроцедуры

Процедура _ОтрЗП_ЗаполнитьСтрокуНачисленияЗП_ПоФизЛицу(НоваяСтрока, ФизЛицо, Сумма, Подразделение, СпособОтражения, Справочные)

	НоваяСтрока.Организация = Организация;
	НоваяСтрока.ФизическоеЛицо = ФизЛицо;
	НоваяСтрока.ВидОперации = Справочные.ВидОперацииНачислено;
	НоваяСтрока.ГруппаУчетаНачислений = Справочные.ГруппаУчетаЗарплата;

	Если ЗначениеЗаполнено(СпособОтражения) Тогда
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СпособОтражения;
	Иначе
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = Справочные.СпособОтраженияПоУмолчанию;
	КонецЕсли;

	Если Подразделение <> Неопределено И ЗначениеЗаполнено(Подразделение) Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;

	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.ВзносыВсего = 0;

КонецПроцедуры

// Op 3: НалогиБухгалтерия (СуммаНДФЛ > 0) → НачисленныйНДФЛ
// КРИТИЧНО: фільтруємо по СуммаНДФЛ, а НЕ по Сумма —
// інакше рядки ЄСВ ФОТ (де Сумма = СуммаФОТ через fallback) помилково
// попадають у НачисленныйНДФЛ з типом "НДФЛ".
Процедура _ОтрЗП_ЗаполнитьНДФЛИзНалогов(Справочные)

	Для Каждого СтрокаНалога Из НалогиБухгалтерия Цикл

		// Беремо ТІЛЬКИ рядки з НДФЛ/ВС. Рядки ЄСВ пропускаємо (вони обробляються
		// в _ОтрЗП_ЗаполнитьНачисленияИзНалогов як ФОТ).
		Если СтрокаНалога.СуммаНДФЛ = 0 Тогда
			Продолжить;
		КонецЕсли;

		Сотрудник = СтрокаНалога.Сотрудник;
		СуммаНалога = СтрокаНалога.СуммаНДФЛ;

		// ВидОперации та ТипНалога залежно від типу
		Если СтрокаНалога.ТипНалога = Справочные.ТипНалогаВС Тогда
			ВидОперации = Справочные.ВидОперацииВоенныйСбор;
			ТипНалога = Справочные.ТипНалогаВС;
		Иначе
			ВидОперации = Справочные.ВидОперацииНДФЛ;
			ТипНалога = Справочные.ТипНалогаНДФЛ;
		КонецЕсли;

		НалогДляПоиска = СтрокаНалога.НалогСтатьяДвиженияДенежныхСредств;
		ДанныеНалога = _ОтрЗП_ПолучитьДанныеРаспределения(Сотрудник, НалогДляПоиска, Справочные);

		Если ДанныеНалога = Неопределено Тогда
			НоваяСтрока = НачисленныйНДФЛ.Добавить();
			_ОтрЗП_ЗаполнитьСтрокуНДФЛ(НоваяСтрока, СтрокаНалога, СуммаНалога, Неопределено, Неопределено, ВидОперации, ТипНалога, Справочные);
			Продолжить;
		КонецЕсли;

		Итого = ДанныеНалога.Итого;
		Остаток = СуммаНалога;
		Счетчик = 0;
		КолПодр = ДанныеНалога.Подразделения.Количество();

		Для Каждого КЗ Из ДанныеНалога.Подразделения Цикл
			Подразделение = КЗ.Ключ;
			ДанныеПодр = КЗ.Значение;
			Счетчик = Счетчик + 1;

			Если Счетчик = КолПодр Тогда
				СуммаДляПодр = Остаток;
			Иначе
				Доля = ДанныеПодр.Сумма / Итого;
				СуммаДляПодр = Окр(СуммаНалога * Доля, 2);
				Остаток = Остаток - СуммаДляПодр;
			КонецЕсли;

			Если СуммаДляПодр = 0 Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтрока = НачисленныйНДФЛ.Добавить();
			_ОтрЗП_ЗаполнитьСтрокуНДФЛ(НоваяСтрока, СтрокаНалога, СуммаДляПодр,
				Подразделение, ДанныеПодр.СпособОтражения, ВидОперации, ТипНалога, Справочные);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура _ОтрЗП_ЗаполнитьСтрокуНДФЛ(НоваяСтрока, СтрокаНалога, Сумма, Подразделение, СпособОтражения, ВидОперации, ТипНалога, Справочные)

	НоваяСтрока.Организация = Организация;
	// per-org ОргБух з НалогиБухгалтерия.Организация (точна організація податку, не пропорція)
	НоваяСтрока.ОрганизацияБухгалтерия = ?(ЗначениеЗаполнено(СтрокаНалога.Организация), СтрокаНалога.Организация, Организация);
	НоваяСтрока.Сумма = Сумма;
	НоваяСтрока.ВидОперации = ВидОперации;
	НоваяСтрока.ТипНалога = ТипНалога;
	НоваяСтрока.КодДохода = СтрокаНалога.КодДохода;
	НоваяСтрока.ГруппаУчетаНачислений = Справочные.ГруппаУчетаЗарплата;
	НоваяСтрока.ФизическоеЛицо = Справочные.ФизЛица[СтрокаНалога.Сотрудник];

	Если Подразделение <> Неопределено Тогда
		НоваяСтрока.ПодразделениеПредприятия = Подразделение;
	КонецЕсли;

	Если ЗначениеЗаполнено(СпособОтражения) Тогда
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = СпособОтражения;
	Иначе
		НоваяСтрока.СпособОтраженияЗарплатыВБухучете = Справочные.СпособОтраженияПоУмолчанию;
	КонецЕсли;

КонецПроцедуры

// Вирівнює gross-up рядки «Удержание с админ зарплату» (Форма1) до НачисленныйНДФЛ
// per (ФізЛицо, Подразделение). Один і той самий офіційний НДФЛ розбивається по підрозділах
// у двох місцях: Op2 «Удержание» (по вагах Казни-утримань, рівномірно) і Op3 НачисленныйНДФЛ
// (податок-за-податком, НДФЛ і ВС окремо) → копійчаний розрив у регістрі Приход
// (Начислено − НачисленныйНДФЛ ≠ «Зарплата управл» = значення переносу ПередачаНачислений).
// Перебудовуємо «Удержание» рядки рівно під НачисленныйНДФЛ. Σ per ФЛ зберігається
// (НДФЛДляФЛ = Σ НачисленныйНДФЛ). Викликається ПІСЛЯ _ОтрЗП_РазметитьФормаPL (коли ФормаPL
// проставлено обом ТЧ) і ДО _ОтрЗП_ПроставитьОргБухВсемФорма1 (він заповнить порожній ОргБух).
Процедура _ОтрЗП_ВыровнятьУдержаниеСНДФЛ(Справочные)

	Ф1 = Перечисления.А_ФормыPL.Форма1;

	// 1) НачисленныйНДФЛ Ф1 per (ФЛ, Подр, ОргБух) — зберігаємо посилання + per-org ОргБух
	НДФЛКлюч = Новый Соответствие;
	Для Каждого Стр Из НачисленныйНДФЛ Цикл
		Если Стр.ФормаPL <> Ф1 Тогда Продолжить; КонецЕсли;
		К = XMLСтрока(Стр.ФизическоеЛицо) + "|" + XMLСтрока(Стр.ПодразделениеПредприятия) + "|" + XMLСтрока(Стр.ОрганизацияБухгалтерия);
		Зап = НДФЛКлюч[К];
		Если Зап = Неопределено Тогда
			Зап = Новый Структура("ФЛ, Подр, ОргБух, Сумма", Стр.ФизическоеЛицо, Стр.ПодразделениеПредприятия, Стр.ОрганизацияБухгалтерия, 0);
			НДФЛКлюч.Вставить(К, Зап);
		КонецЕсли;
		Зап.Сумма = Зап.Сумма + Стр.Сумма;
	КонецЦикла;

	// 2) Старі gross-up «Удержание» Ф1 (А_ЭтоУдержание, ВзносыВсего=0): шаблон per ФЛ + індекси на видалення.
	//    ОргБух більше НЕ беремо зі старих рядків — джерело тепер НачисленныйНДФЛ.ОрганизацияБухгалтерия (per-org).
	Шаблон  = Новый Соответствие;   // ФЛ → Структура(Способ, ВидОперации, ГруппаУчета)
	НаУдаление = Новый Массив;
	Для і = 0 По НачисленнаяЗарплатаИВзносыПоФизлицам.Количество() - 1 Цикл
		Стр = НачисленнаяЗарплатаИВзносыПоФизлицам[і];
		Если Стр.ФормаPL <> Ф1 Тогда Продолжить; КонецЕсли;
		Способ = Стр.СпособОтраженияЗарплатыВБухучете;
		Если НЕ (ЗначениеЗаполнено(Способ) И Способ.А_ЭтоУдержание) Тогда Продолжить; КонецЕсли;
		Если Стр.ВзносыВсего <> 0 Тогда Продолжить; КонецЕсли;
		Если Шаблон[Стр.ФизическоеЛицо] = Неопределено Тогда
			Т = Новый Структура("Способ, ВидОперации, ГруппаУчета",
				Стр.СпособОтраженияЗарплатыВБухучете, Стр.ВидОперации, Стр.ГруппаУчетаНачислений);
			Шаблон.Вставить(Стр.ФизическоеЛицо, Т);
		КонецЕсли;
		НаУдаление.Добавить(і);
	КонецЦикла;

	// 3) Видалити старі «Удержание» рядки (з кінця — індекси не зсуваються)
	і = НаУдаление.Количество() - 1;
	Пока і >= 0 Цикл
		НачисленнаяЗарплатаИВзносыПоФизлицам.Удалить(НаУдаление[і]);
		і = і - 1;
	КонецЦикла;

	// 4) Додати рядки «Удержание» = НачисленныйНДФЛ per (ФЛ, Подр, ОргБух)
	Для Каждого КЗ Из НДФЛКлюч Цикл
		З = КЗ.Значение;
		Если З.Сумма = 0 Тогда Продолжить; КонецЕсли;
		Т = Шаблон[З.ФЛ];
		Если Т = Неопределено Тогда Продолжить; КонецЕсли; // у ФЛ не було gross-up «Удержание» — пропускаємо
		НовСтр = НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
		НовСтр.Организация                      = Организация;
		НовСтр.ФизическоеЛицо                   = З.ФЛ;
		НовСтр.ПодразделениеПредприятия         = З.Подр;
		НовСтр.ВидОперации                      = Т.ВидОперации;
		НовСтр.ГруппаУчетаНачислений            = Т.ГруппаУчета;
		НовСтр.СпособОтраженияЗарплатыВБухучете = Т.Способ;
		НовСтр.Сумма                            = З.Сумма;
		НовСтр.ВзносыВсего                      = 0;
		НовСтр.ФормаPL                          = Ф1;
		Если ЗначениеЗаполнено(З.ОргБух) Тогда
			НовСтр.ОрганизацияБухгалтерия = З.ОргБух;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Пошук розподілу з fallback: точний налог → ЕСВ ФОТ → БазовыеНачисления
Функция _ОтрЗП_ПолучитьДанныеРаспределения(Сотрудник, НалогДляПоиска, Справочные)

	РаспредПоПодр = Справочные.РаспредПоПодразделениям;
	НалогЕСВФОТ = Справочные.НалогЕСВФОТ;
	КлючБазовые = Справочные.КлючБазовые;

	ДанныеСотрудника = РаспредПоПодр[Сотрудник];
	Если ДанныеСотрудника = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	// 1. Точний налог
	Если ЗначениеЗаполнено(НалогДляПоиска) Тогда
		ДанныеНалога = ДанныеСотрудника[НалогДляПоиска];
		Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
			Возврат ДанныеНалога;
		КонецЕсли;
	КонецЕсли;

	// 2. ЕСВ ФОТ fallback
	Если ЗначениеЗаполнено(НалогДляПоиска) Тогда
		НайменНалога = Строка(НалогДляПоиска);
		Если СтрНачинаетсяС(НайменНалога, "ЕСВ ФОТ") И ЗначениеЗаполнено(НалогЕСВФОТ) Тогда
			ДанныеНалога = ДанныеСотрудника[НалогЕСВФОТ];
			Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
				Возврат ДанныеНалога;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// 3. БазовыеНачисления fallback
	ДанныеНалога = ДанныеСотрудника[КлючБазовые];
	Если ДанныеНалога <> Неопределено И ДанныеНалога.Итого > 0 Тогда
		Возврат ДанныеНалога;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
   

#Область ЕРП_СоздатьДокументНачисления

// Find-Or-Create підлеглого Документ.НачислениеЗарплаты на підставі А_ОтражениеЗПпоКазне.
// Патерн: Cleanup → Guard → Get-or-Create → Fill → Write.Проведение.
//
// Джерела даних (уже заповнені в поточному документі попередніми кроками):
//   НачисленияУпр                       → ТЧ Начисления (усі на "Оплата по окладу")
//   УдержанияУпр                        → ТЧ Удержания (вид "Штраф" код "УШ")
//   УдержанияБухгалтерия                → ТЧ Удержания (ВидУдержания = "Алименты бух" код "УША")
//   НачисленныйНДФЛ                     → ТЧ НДФЛ
//   НачисленнаяЗарплатаИВзносыПоФизлицам → ТЧ ВзносыФОТ (ВидЕСВ = ОсновнаяЗарплата)
//   + ФизическиеЛица                    — унікальні
//
// Образец: документ НачислениеЗарплаты 000Ц-000002 від 28.02.2026 (ТОВ "ІНДАСТРІАЛБУД").
Процедура СоздатьДокументНачисления() Экспорт

	// Guard: батько має бути проведений
	Если НЕ Проведен Тогда
		Сообщить("А_ОтражениеЗПпоКазне не проведений — НачислениеЗарплаты не створюється.");
		Возврат;
	КонецЕсли;

	// === Кешування фіксованих посилань ===
	// Начисление "Оклад (Зарплата)" (код "ОКЛН " дублюється з "Штраф (упр)" у базі — шукаємо за найменуванням).
	ВидНачисленияОсновний = ПланыВидовРасчета.Начисления.НайтиПоНаименованию("Оклад (Зарплата)");
	Если НЕ ЗначениеЗаполнено(ВидНачисленияОсновний) Тогда
		Сообщить("КРИТИЧНО: не знайдено Начисление 'Оклад (Зарплата)' у ПланыВидовРасчета.Начисления — НачислениеЗарплаты не створюється.");
		Возврат;
	КонецЕсли;
	// Начисление "Штраф (упр)" (для УдержанияУпр — мінусове нарахування).
	ВидНачисленияШтраф = ПланыВидовРасчета.Начисления.НайтиПоНаименованию("Штраф (упр)");
	Если НЕ ЗначениеЗаполнено(ВидНачисленияШтраф) Тогда
		Сообщить("УВАГА: не знайдено Начисление 'Штраф (упр)' — штрафи з УдержанияУпр будуть пропущені.");
	КонецЕсли;
	// Удержание "Алименты бух" (для УдержанияБухгалтерия), код "УША".
	ВидУдержанияАлименты = ПланыВидовРасчета.Удержания.НайтиПоНаименованию("Алименты бух");
	Если НЕ ЗначениеЗаполнено(ВидУдержанияАлименты) Тогда
		ВидУдержанияАлименты = ПланыВидовРасчета.Удержания.НайтиПоКоду("УША");
	КонецЕсли;

	// === Кеш для НДФЛ і ВзносыФОТ (за зразком 000Ц-000002 від 31.12.2025 кастомний) ===
	// НДФЛ довідники
	ВидСтавкиНДФЛОсновная      = Перечисления.ВидыСтавокНДФЛ.Основная;
	ВидСтавкиНДФЛУвеличенная   = Перечисления.ВидыСтавокНДФЛ.Увеличенная;
	ВидСтавкиНДФЛВоенныйСбор   = Перечисления.ВидыСтавокНДФЛ.ВоенныйСбор;
	КодДоходаЗарплата          = Справочники.ВидыДоходовНДФЛ.НайтиПоКоду("101");
	КодДоходаВЗ                = Справочники.ВидыДоходовНДФЛ.НайтиПоКоду("ВЗ");
	// ВзносыФОТ довідники
	ВидЕСВОсновной             = Перечисления.ВидыЕСВ.ОсновнаяЗарплата;
	КатЕСВРаботник             = Справочники.КатегорииЗастрахованныхЛицЕСВ.НайтиПоНаименованию("Наемный работник на общих основаниях");
	СтатьяНД22                 = Справочники.СтатьиНалоговыхДеклараций.НайтиПоНаименованию("Начисление ЕСВ работодателями (22 %)");
	НалогЕСВФОТРаботники       = Справочники.Налоги.НайтиПоНаименованию("ЕСВ ФОТ (работники)");
	// Константи розрахунку
	СтавкаНДФЛОсновная         = 0.18;  // 18%
	СтавкаНДФЛВС               = 0.05;  // 5%
	СтавкаЄСВ                  = 0.22;  // 22%
	МинЗПдляЕСВ                = 8000;  // Мінімальна зарплата для розрахунку ЄСВ
	ПределЕСВ                  = 160000; // Максимальна база ЄСВ

	НачПер = НачалоМесяца(Дата);
	КонПер = КонецМесяца(Дата);

	// === Find-Or-Create ===
	ЗапросНЗ = Новый Запрос;
	ЗапросНЗ.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 НЗ.Ссылка КАК Ссылка
	|ИЗ Документ.НачислениеЗарплаты КАК НЗ
	|ГДЕ НЗ.А_ДокОтражениеЗПпоКазне = &Осн И НЕ НЗ.ПометкаУдаления";
	ЗапросНЗ.УстановитьПараметр("Осн", Ссылка);
	РезНЗ = ЗапросНЗ.Выполнить();

	Если НЕ РезНЗ.Пустой() Тогда
		Выб = РезНЗ.Выбрать();
		Выб.Следующий();
		НЗ = Выб.Ссылка.ПолучитьОбъект();
		НЗ.УстановитьПометкуУдаления(Ложь);
		Если НЗ.Проведен Тогда
			Попытка
				НЗ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение
				Сообщить("Не вдалося розпровести НачислениеЗарплаты: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		НЗ.Начисления.Очистить();
		НЗ.Удержания.Очистить();
		НЗ.НДФЛ.Очистить();
		НЗ.ВзносыФОТ.Очистить();
		НЗ.ФизическиеЛица.Очистить();
	Иначе
		НЗ = Документы.НачислениеЗарплаты.СоздатьДокумент();
	КонецЕсли;

	// === Заповнити шапку ===
	НЗ.Дата                    = Дата;
	НЗ.Организация             = Организация;
	НЗ.МесяцНачисления         = НачПер;
	НЗ.ПорядокВыплаты          = Перечисления.ХарактерВыплатыЗарплаты.Зарплата;
	НЗ.ПланируемаяДатаВыплаты  = КонПер;
	НЗ.А_ДокОтражениеЗПпоКазне = Ссылка;

	// Кеш Сотрудник по ФізЛицу (для швидкого lookup)
	КешСотрПоФизЛицу = _НЗ_ПобудуватиКешСотрудникПоФизЛицу();

	// === ТЧ Начисления: "Оклад (Зарплата)" ===
	// АЛГОРИТМ:
	//   1) Для ФізОсіб з НачисленияУпр → сума = НачисленияУпр.Сумма (БЕЗ валоризації, як є!)
	//   2) Для ФізОсіб з РаспределениеКазна яких НЕМАЄ в НачисленияУпр →
	//      сума = РаспределениеКазна.СуммаНачисления (fallback для людей з Казни без ZUP_2)
	//   3) Штрафи з УдержанияУпр → "Штраф (упр)" з мінусом
	// КОЖНИЙ рядок розподіляється пропорційно по ПодразделенияОрганизаций з РаспределениеКазна.
	УникальныеФЛ = Новый Соответствие;
	ОброблениФЛ_Начисления = Новый Соответствие;  // ФізЛица, які вже додано у Начисления

	// Мапа для пропорційного розподілу по ПодразделенияОрганизаций
	МапПодразОргПоСотруднику = _НЗ_ПобудуватиМапПодразОргПоСотруднику();

	// Лічильник ИдентификаторСтрокиВидаРасчета — у структурі для pass-by-ref
	СтрЛічильник = Новый Структура("Значение", 0);

	// === Крок 1: НачисленияУпр → Начисления (без валоризації) ===
	Для Каждого СтрНач Из НачисленияУпр Цикл
		Если НЕ ЗначениеЗаполнено(СтрНач.ФизЛицо) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНач.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		Сотр = КешСотрПоФизЛицу[СтрНач.ФизЛицо];
		Если НЕ ЗначениеЗаполнено(Сотр) Тогда
			Сообщить("Начисления: не знайдено Сотрудника для " + Строка(СтрНач.ФизЛицо) + " (" + СтрНач.ФИО + ")");
			Продолжить;
		КонецЕсли;

		_НЗ_ДодатиРядкиНачисленияПоПодразделениях(НЗ, Сотр, ВидНачисленияОсновний,
			СтрНач.Сумма, МапПодразОргПоСотруднику[Сотр], НачПер, КонПер, СтрЛічильник);
		УникальныеФЛ.Вставить(СтрНач.ФизЛицо, Истина);
		ОброблениФЛ_Начисления.Вставить(СтрНач.ФизЛицо, Истина);
	КонецЦикла;

	// === Крок 2: РаспределениеКазна → Начисления (fallback) для ФізОсіб без НачисленияУпр ===
	// Агрегуємо СуммаНачисления з РаспределениеКазна по ФізЛица
	СумаНачПоФЛ_Казна = Новый Соответствие;
	Для Каждого СтрКазна Из РаспределениеКазна Цикл
		Если НЕ ЗначениеЗаполнено(СтрКазна.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрКазна.СуммаНачисления = 0 Тогда
			Продолжить;
		КонецЕсли;
		ФЛКазна = Неопределено;
		Попытка
			ФЛКазна = СтрКазна.Сотрудник.ФизическоеЛицо;
		Исключение
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ФЛКазна) Тогда
			Продолжить;
		КонецЕсли;
		Поточна = СумаНачПоФЛ_Казна[ФЛКазна];
		Если Поточна = Неопределено Тогда
			Поточна = 0;
		КонецЕсли;
		СумаНачПоФЛ_Казна[ФЛКазна] = Поточна + СтрКазна.СуммаНачисления;
	КонецЦикла;

	Для Каждого КЗ Из СумаНачПоФЛ_Казна Цикл
		ФЛКазна = КЗ.Ключ;
		СумаКазна = КЗ.Значение;

		// Пропускаємо якщо вже оброблено у Кроці 1
		Если ОброблениФЛ_Начисления[ФЛКазна] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СумаКазна = 0 Тогда
			Продолжить;
		КонецЕсли;

		Сотр = КешСотрПоФизЛицу[ФЛКазна];
		Если НЕ ЗначениеЗаполнено(Сотр) Тогда
			Продолжить;
		КонецЕсли;

		_НЗ_ДодатиРядкиНачисленияПоПодразделениях(НЗ, Сотр, ВидНачисленияОсновний,
			СумаКазна, МапПодразОргПоСотруднику[Сотр], НачПер, КонПер, СтрЛічильник);
		УникальныеФЛ.Вставить(ФЛКазна, Истина);
		ОброблениФЛ_Начисления.Вставить(ФЛКазна, Истина);
	КонецЦикла;

	// === Штрафи з УдержанияУпр → ТЧ Начисления на вид "Штраф (упр)" зі знаком МІНУС ===
	Если ЗначениеЗаполнено(ВидНачисленияШтраф) Тогда
		Для Каждого СтрУд Из УдержанияУпр Цикл
			Если НЕ ЗначениеЗаполнено(СтрУд.ФизЛицо) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрУд.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;

			Сотр = КешСотрПоФизЛицу[СтрУд.ФизЛицо];
			Если НЕ ЗначениеЗаполнено(Сотр) Тогда
				Сообщить("Начисления (штраф): не знайдено Сотрудника для " + Строка(СтрУд.ФизЛицо));
				Продолжить;
			КонецЕсли;

			_НЗ_ДодатиРядкиНачисленияПоПодразделениях(НЗ, Сотр, ВидНачисленияШтраф,
				-СтрУд.Сумма, МапПодразОргПоСотруднику[Сотр], НачПер, КонПер, СтрЛічильник);
			УникальныеФЛ.Вставить(СтрУд.ФизЛицо, Истина);
		КонецЦикла;
	КонецЕсли;

	// === ФільтрФЛ: множина ФізОсіб, які МАЮТЬ рядок у Начисления ===
	// Всі наступні цикли (Удержания, НДФЛ, ВзносыФОТ) мають фільтруватися по цій множині —
	// інакше регістр ВзаиморасчетыССотрудниками падає з "Сотрудник пустой".
	ФЛВНачисленияхСет = Новый Соответствие;
	Для Каждого СтрН Из НЗ.Начисления Цикл
		Если ЗначениеЗаполнено(СтрН.Сотрудник) Тогда
			ФЛ = СтрН.Сотрудник.ФизическоеЛицо;
			Если ЗначениеЗаполнено(ФЛ) Тогда
				ФЛВНачисленияхСет.Вставить(ФЛ, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// === ТЧ Удержания: тільки УдержанияБухгалтерия → "Алименты бух" ===
	// Штрафи вже додано в Начисления як "Штраф (упр)" з мінусом.
	ЛічильникИдУд = 2000000;

	// Алименти з УдержанияБухгалтерия → "Алименты бух"
	Для Каждого СтрУдБ Из УдержанияБухгалтерия Цикл
		Если НЕ ЗначениеЗаполнено(СтрУдБ.ФизическоеЛицо) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрУдБ.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		// Фільтр: тільки ФізОсоби які є у Начисления
		Если ФЛВНачисленияхСет[СтрУдБ.ФизическоеЛицо] = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЛічильникИдУд = ЛічильникИдУд + 1;
		НР = НЗ.Удержания.Добавить();
		НР.ФизическоеЛицо                 = СтрУдБ.ФизическоеЛицо;
		НР.Удержание                      = ВидУдержанияАлименты;
		НР.Результат                      = СтрУдБ.Сумма;
		НР.ДатаНачала                     = НачПер;
		НР.ДатаОкончания                  = КонПер;
		НР.ИдентификаторСтрокиВидаРасчета = ЛічильникИдУд;
		// Субконто1 містить Контрагента (Получатель виконавчого листа)
		Если ЗначениеЗаполнено(СтрУдБ.Субконто1) И ТипЗнч(СтрУдБ.Субконто1) = Тип("СправочникСсылка.Контрагенты") Тогда
			НР.Получатель = СтрУдБ.Субконто1;
		КонецЕсли;
		УникальныеФЛ.Вставить(СтрУдБ.ФизическоеЛицо, Истина);
	КонецЦикла;

	// === ТЧ НДФЛ і ВзносыФОТ: заповнюємо з НалогиБухгалтерия (реальні дані з ZUP_1) ===
	// НалогиБухгалтерия містить:
	//   Сотрудник, Сумма (податок), СуммаФОТ (база ФОТ), Налог (Справочник.Налоги),
	//   КодДохода, ТипНалога (НДФЛ/ВоенныйСбор), НалогСтатьяДвиженияДенежныхСредств
	//
	// Логіка:
	//   ТипНалога = НДФЛ          → НДФЛ з ВидСтавки=Основная (КодДохода=101)
	//   ТипНалога = ВоенныйСбор   → НДФЛ з ВидСтавки=ВоенныйСбор (КодДохода=ВЗ)
	//   СуммаФОТ > 0              → ВзносыФОТ (ЄСВ на сума ФОТ)
	//
	// Фільтр: тільки для ФізОсіб, які присутні у ТЧ Начисления (інакше регістр
	// ВзаиморасчетыССотрудниками падає з "Сотрудник пустой").

	// Зібрати СуммаНарахованого по ФізЛицу (для Доход у НДФЛ)
	СуммаНачПоФЛ = Новый Соответствие;
	Для Каждого СтрНач Из НЗ.Начисления Цикл
		Если НЕ ЗначениеЗаполнено(СтрНач.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНач.Начисление <> ВидНачисленияОсновний Тогда
			Продолжить;
		КонецЕсли;
		ФЛ = СтрНач.Сотрудник.ФизическоеЛицо;
		Поточна = СуммаНачПоФЛ[ФЛ];
		Если Поточна = Неопределено Тогда
			Поточна = 0;
		КонецЕсли;
		СуммаНачПоФЛ.Вставить(ФЛ, Поточна + СтрНач.Результат);
	КонецЦикла;

	ЛічильникИдНДФЛ = 0;
	Для Каждого СтрНБ Из НалогиБухгалтерия Цикл
		Если НЕ ЗначениеЗаполнено(СтрНБ.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		ФЛСотр = СтрНБ.Сотрудник.ФизическоеЛицо;
		// Пропускаємо якщо у цього ФізЛица немає рядка в Начисления
		Если ФЛВНачисленияхСет[ФЛСотр] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДоходПоФЛ = СуммаНачПоФЛ[ФЛСотр];
		Если ДоходПоФЛ = Неопределено Тогда
			ДоходПоФЛ = 0;
		КонецЕсли;

		// --- НДФЛ (НДФЛ або Військовий збір) — з поля СуммаНДФЛ ---
		// Маппінг згідно схеми бухгалтера:
		//   НДФЛ.Доход     = НалогиБухгалтерия.СуммаДохода  (з ZUP_1.ВзаиморасчетыПоНДФЛ.Доход)
		//   НДФЛ.Налог     = НалогиБухгалтерия.СуммаНДФЛ    (з ZUP_1.ВзаиморасчетыПоНДФЛ.НалогПриход)
		Если СтрНБ.СуммаНДФЛ > 0 Тогда
			ЛічильникИдНДФЛ = ЛічильникИдНДФЛ + 1;

			НР = НЗ.НДФЛ.Добавить();
			НР.ФизическоеЛицо          = ФЛСотр;
			НР.НалоговыйПериод         = НачПер;
			НР.Налог                   = СтрНБ.СуммаНДФЛ;
			НР.Доход                   = СтрНБ.СуммаДохода;
			НР.ДоходПолный             = СтрНБ.СуммаДохода;
			НР.ИдентификаторСтрокиНДФЛ = ЛічильникИдНДФЛ;
			Если ЗначениеЗаполнено(СтрНБ.КодДохода) Тогда
				НР.КодДохода = СтрНБ.КодДохода;
			КонецЕсли;
			// ВидСтавки за ТипНалога
			Если СтрНБ.ТипНалога = Перечисления.ТипыНалогов.ВоенныйСбор Тогда
				НР.ВидСтавки         = ВидСтавкиНДФЛВоенныйСбор;
				НР.УвеличеннаяСтавка = ВидСтавкиНДФЛВоенныйСбор;
				Если НЕ ЗначениеЗаполнено(НР.КодДохода) И ЗначениеЗаполнено(КодДоходаВЗ) Тогда
					НР.КодДохода = КодДоходаВЗ;
				КонецЕсли;
			Иначе
				НР.ВидСтавки         = ВидСтавкиНДФЛОсновная;
				НР.УвеличеннаяСтавка = ВидСтавкиНДФЛУвеличенная;
				Если НЕ ЗначениеЗаполнено(НР.КодДохода) И ЗначениеЗаполнено(КодДоходаЗарплата) Тогда
					НР.КодДохода = КодДоходаЗарплата;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;

		// --- ВзносыФОТ (ЄСВ на СуммуФОТ) ---
		// Маппінг згідно схеми бухгалтера:
		//   ВзносыФОТ.База      = НалогиБухгалтерия.База     (з ZUP_1.ВзносыВФонды.База)
		//   ВзносыФОТ.Результат = НалогиБухгалтерия.СуммаФОТ (з ZUP_1.ВзносыВФонды.Результат)
		Если СтрНБ.СуммаФОТ > 0 Тогда
			БазаЕСВ = СтрНБ.База;
			БазаВзн = Макс(БазаЕСВ, МинЗПдляЕСВ);
			БазаДонач = Макс(0, МинЗПдляЕСВ - БазаЕСВ);

			НР = НЗ.ВзносыФОТ.Добавить();
			НР.ФизическоеЛицо            = ФЛСотр;
			НР.ДатаПолученияДохода       = Дата;
			НР.ДатаНачала                = НачПер;
			НР.ДатаОкончания             = КонПер;
			НР.ВидЕСВ                    = ВидЕСВОсновной;
			НР.КатегорияЕСВ              = КатЕСВРаботник;
			НР.СтатьяНалоговойДекларации = СтатьяНД22;
			Если ЗначениеЗаполнено(СтрНБ.Налог) Тогда
				НР.Налог = СтрНБ.Налог;
			ИначеЕсли ЗначениеЗаполнено(НалогЕСВФОТРаботники) Тогда
				НР.Налог = НалогЕСВФОТРаботники;
			КонецЕсли;
			НР.База                   = БазаЕСВ;
			НР.БазаВзноса             = БазаВзн;
			НР.БазаДоначисление       = БазаДонач;
			НР.Результат              = СтрНБ.СуммаФОТ;
			НР.РезультатДоначисление  = Окр(БазаДонач * СтавкаЄСВ, 2);
			НР.Ставка                 = СтавкаЄСВ;
			НР.СтавкаПолная           = 1;
			НР.МинимальнаяБаза        = МинЗПдляЕСВ;
			НР.Предел                 = ПределЕСВ;
			НР.КоэффициентСтавки      = 1;
		КонецЕсли;
	КонецЦикла;

	// === ТЧ ФизическиеЛица: унікальні ===
	Для Каждого КЗ Из УникальныеФЛ Цикл
		НР = НЗ.ФизическиеЛица.Добавить();
		НР.ФизическоеЛицо = КЗ.Ключ;
	КонецЦикла;
	
	Если НЕ ПроводитьНалогиВДокументыНачислениеЗарплаты Тогда
		
		НЗ.НДФЛ.Очистить();
		НЗ.ВзносыФОТ.Очистить();
		
	КонецЕсли;
	
	Если НЕ ПроводитьДоПодразделенийНачислениеЗарплаты Тогда
		
		ТЗ_Начисления =НЗ.Начисления.Выгрузить();
		ТЗ_Начисления.Свернуть("Сотрудник,Начисление,ДатаНачала,ДатаОкончания,ПериодДействия,ПериодРегистрацииВремени,ИдентификаторСтрокиВидаРасчета","Результат");
		НЗ.Начисления.Загрузить(ТЗ_Начисления);
		
	КонецЕсли;

	// === Запис з проведенням ===
	Попытка
		НЗ.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("НачислениеЗарплаты створено/оновлено: " + Строка(НЗ.Ссылка)
			+ " (Нач=" + НЗ.Начисления.Количество()
			+ ", Уд=" + НЗ.Удержания.Количество()
			+ ", НДФЛ=" + НЗ.НДФЛ.Количество()
			+ ", ВзносыФОТ=" + НЗ.ВзносыФОТ.Количество() + ")");

		// Очистити записи РегистрСведений.ПерерасчетЗарплаты для цієї організації + місяця.
		// Документ створюється кодом — ручні правки не передбачені, тому записи "потрібен перерахунок"
		// (від ПриемНаРаботу, КадровыйПеревод тощо) непотрібні — їх чистимо щоб не з'являлось
		// попередження "Требуется доначисление" у формі НЗ.
		_НЗ_ОчиститиПерерасчетЗарплаты(Организация, НачПер, КонПер);
	Исключение
		Сообщить("Помилка запису НачислениеЗарплаты: " + ОписаниеОшибки());
		// Спроба записати без проведення — щоб користувач побачив заповнені ТЧ
		Попытка
			НЗ.Записать(РежимЗаписиДокумента.Запись);
			Сообщить("НачислениеЗарплаты збережено БЕЗ проведення: " + Строка(НЗ.Ссылка));
		Исключение
			Сообщить("Не вдалося зберегти НачислениеЗарплаты взагалі: " + ОписаниеОшибки());
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// Очищає записи РегистрСведений.ПерерасчетЗарплаты за період (НачПер..КонПер) для організації.
// Документ НачислениеЗарплаты створюється кодом — додаткові перерахунки не потрібні.
//
// Алгоритм: запит до регістру щоб дістати ВСІ комбінації вимірювань, потім для кожної комбінації
// створюємо порожній набір записів з відбором по ВСІХ вимірюваннях і записуємо — це видаляє запис.
Процедура _НЗ_ОчиститиПерерасчетЗарплаты(Орг, ДатаС, ДатаПо)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПЗ.Организация       КАК Организация,
	|	ПЗ.Сотрудник         КАК Сотрудник,
	|	ПЗ.ФизическоеЛицо    КАК ФизическоеЛицо,
	|	ПЗ.ПериодДействия    КАК ПериодДействия,
	|	ПЗ.ДокументОснование КАК ДокументОснование,
	|	ПЗ.ДокументНачисления КАК ДокументНачисления
	|ИЗ
	|	РегистрСведений.ПерерасчетЗарплаты КАК ПЗ
	|ГДЕ
	|	ПЗ.Организация = &Орг
	|	И ПЗ.ПериодДействия МЕЖДУ &ДатаС И &ДатаПо";
	Запрос.УстановитьПараметр("Орг",   Орг);
	Запрос.УстановитьПараметр("ДатаС", ДатаС);
	Запрос.УстановитьПараметр("ДатаПо", ДатаПо);

	КолВидалено = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НабЗап = РегистрыСведений.ПерерасчетЗарплаты.СоздатьНаборЗаписей();
		НабЗап.Отбор.Организация.Установить(Выборка.Организация);
		НабЗап.Отбор.Сотрудник.Установить(Выборка.Сотрудник);
		НабЗап.Отбор.ФизическоеЛицо.Установить(Выборка.ФизическоеЛицо);
		НабЗап.Отбор.ПериодДействия.Установить(Выборка.ПериодДействия);
		НабЗап.Отбор.ДокументОснование.Установить(Выборка.ДокументОснование);
		НабЗап.Отбор.ДокументНачисления.Установить(Выборка.ДокументНачисления);
		НабЗап.Записать(); // порожній набір з відбором — видалення
		КолВидалено = КолВидалено + 1;
	КонецЦикла;

	Если КолВидалено > 0 Тогда
		Сообщить("ПерерасчетЗарплаты: видалено " + КолВидалено + " записів за період "
			+ Формат(ДатаС, "ДЛФ=DD") + " - " + Формат(ДатаПо, "ДЛФ=DD"));
	КонецЕсли;

КонецПроцедуры

// Будує кеш ФізЛицо → Сотрудник для швидкого lookup
// Джерело: Справочник.Сотрудники через масив ФізОсіб з усіх ТЧ документа
Функция _НЗ_ПобудуватиКешСотрудникПоФизЛицу()

	Результат = Новый Соответствие;
	МасФЛ = Новый Массив;

	// Збираємо унікальні ФізОсоби з УСІХ джерел (щоб НДФЛ/ВзносыФОТ теж мали Сотрудника)
	Для Каждого Стр Из НачисленияУпр Цикл
		Если ЗначениеЗаполнено(Стр.ФизЛицо) И МасФЛ.Найти(Стр.ФизЛицо) = Неопределено Тогда
			МасФЛ.Добавить(Стр.ФизЛицо);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из УдержанияУпр Цикл
		Если ЗначениеЗаполнено(Стр.ФизЛицо) И МасФЛ.Найти(Стр.ФизЛицо) = Неопределено Тогда
			МасФЛ.Добавить(Стр.ФизЛицо);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из УдержанияБухгалтерия Цикл
		Если ЗначениеЗаполнено(Стр.ФизическоеЛицо) И МасФЛ.Найти(Стр.ФизическоеЛицо) = Неопределено Тогда
			МасФЛ.Добавить(Стр.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из НачисленныйНДФЛ Цикл
		Если ЗначениеЗаполнено(Стр.ФизическоеЛицо) И МасФЛ.Найти(Стр.ФизическоеЛицо) = Неопределено Тогда
			МасФЛ.Добавить(Стр.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		Если ЗначениеЗаполнено(Стр.ФизическоеЛицо) И МасФЛ.Найти(Стр.ФизическоеЛицо) = Неопределено Тогда
			МасФЛ.Добавить(Стр.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;

	Если МасФЛ.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Ссылка КАК Сотрудник,
	|	С.ФизическоеЛицо КАК ФизЛицо
	|ИЗ Справочник.Сотрудники КАК С
	|ГДЕ С.ФизическоеЛицо В (&МасФЛ)
	|	И С.ГоловнаяОрганизация = &Орг
	|	И НЕ С.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО С.ПометкаУдаления, С.Код";
	Запрос.УстановитьПараметр("МасФЛ", МасФЛ);
	Запрос.УстановитьПараметр("Орг", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Якщо є декілька Сотрудників на одну ФізОсобу — беремо перший
		Если Результат[Выборка.ФизЛицо] = Неопределено Тогда
			Результат.Вставить(Выборка.ФизЛицо, Выборка.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Сума СуммаНДФЛ (НДФЛ+ВС) по ФізЛица — з НалогиБухгалтерия.
// Використовується для валоризації: валова зарплата у Начисления = НачисленияУпр/Казна + СуммаНДФЛ.
// Бухгалтерський сенс: ми компенсуємо сотруднику утриманий НДФЛ/ВС, щоб у "Начислено"
// була валова сума до утримань (стандарт бухобліку).
Функция _НЗ_ОбчислитиСуммаНДФЛПоФизЛицу()

	Результат = Новый Соответствие;

	Для Каждого Стр Из НалогиБухгалтерия Цикл
		// Беремо ТІЛЬКИ рядки з НДФЛ/ВС (не ЄСВ!).
		// Фільтруємо по ТипНалога — якщо НДФЛ або ВоенныйСбор, то це "утримання з сотрудника".
		ЦеНДФЛабоВС = (Стр.ТипНалога = Перечисления.ТипыНалогов.НДФЛ
			ИЛИ Стр.ТипНалога = Перечисления.ТипыНалогов.ВоенныйСбор);
		Если НЕ ЦеНДФЛабоВС Тогда
			Продолжить;
		КонецЕсли;

		// Беремо СуммаНДФЛ, з fallback на поле Сумма (для старих записів без СуммаНДФЛ).
		СуммаНДФЛ = Стр.СуммаНДФЛ;
		Если СуммаНДФЛ = 0 Тогда
			СуммаНДФЛ = Стр.Сумма;
		КонецЕсли;
		Если СуммаНДФЛ = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Стр.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		ФизЛицо = Неопределено;
		Попытка
			ФизЛицо = Стр.Сотрудник.ФизическоеЛицо;
		Исключение
		КонецПопытки;
		Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
			Продолжить;
		КонецЕсли;

		Поточна = Результат[ФизЛицо];
		Если Поточна = Неопределено Тогда
			Поточна = 0;
		КонецЕсли;
		Результат[ФизЛицо] = Поточна + СуммаНДФЛ;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Будує мапу для пропорційного розподілу начислень по підрозділах сотрудника.
// Джерело: РаспределениеКазна (поле Подразделение = СтруктураПредприятия).
//
// ВАЖЛИВО: у ТЧ РаспределениеКазна вже зберігається РЕАЛЬНИЙ підрозділ
// (логіка А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны застосована
// один раз при заповненні в ЗагрузитьРаспределениеКазна_ОтражениеЗП).
// Тому тут просто конвертуємо СтруктураПредприятия → ПодразделенияОрганизаций.
//
// Повертає: Соответствие
//   Ключ:     СправочникСсылка.Сотрудники
//   Значение: Структура("Подразделения, Итого")
//             Подразделения = Соответствие(ПодразделенияОрганизаций → СумаЧастка)
//             Итого = сума всіх часток
Функция _НЗ_ПобудуватиМапПодразОргПоСотруднику()

	Результат  = Новый Соответствие;
	КешПодрОрг = Новый Соответствие; // СтруктПідр → ПодразделенияОрганизаций

	Для Каждого СтрКазна Из РаспределениеКазна Цикл
		Если НЕ ЗначениеЗаполнено(СтрКазна.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрКазна.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтруктПідр = СтрКазна.Подразделение;

		ПодрОрг = КешПодрОрг[СтруктПідр];
		Если ПодрОрг = Неопределено Тогда
			Если ЗначениеЗаполнено(СтруктПідр) Тогда
				ПодрОрг = А_Привилегированный.ОбеспечитьПодразделенияОрганизацийПоПодразделению(СтруктПідр);
			Иначе
				ПодрОрг = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
			КонецЕсли;
			КешПодрОрг.Вставить(СтруктПідр, ПодрОрг);
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ПодрОрг) Тогда
			Продолжить; // підрозділ нерозпізнаний → fallback спрацює при додаванні рядків
		КонецЕсли;

		ДанСотр = Результат[СтрКазна.Сотрудник];
		Если ДанСотр = Неопределено Тогда
			ДанСотр = Новый Структура("Подразделения, Итого", Новый Соответствие, 0);
			Результат.Вставить(СтрКазна.Сотрудник, ДанСотр);
		КонецЕсли;

		Поточна = ДанСотр.Подразделения[ПодрОрг];
		Если Поточна = Неопределено Тогда
			Поточна = 0;
		КонецЕсли;
		ДанСотр.Подразделения.Вставить(ПодрОрг, Поточна + СтрКазна.Сумма);
		ДанСотр.Итого = ДанСотр.Итого + СтрКазна.Сумма;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Додає 1..N рядків у НЗ.Начисления з пропорційним розподілом ЗагальнаСума
// по ПодразделенияОрганизаций на основі мапи ДанПоСотр.
// Якщо мапа порожня → fallback: 1 рядок без підрозділу.
// Якщо 1 підрозділ → 1 рядок з повною сумою.
// Якщо N підрозділів → N рядків пропорційно (Окр), останній компенсує копійки.
//
// Параметри:
//   НЗ                - ДокументОбъект.НачислениеЗарплаты
//   Сотр              - СправочникСсылка.Сотрудники
//   ВидРасч           - ПланВидовРасчетаСсылка.Начисления (Основний / Штраф)
//   ЗагальнаСума      - Число (може бути від'ємне для штрафу)
//   ДанПоСотр         - Неопределено АБО Структура("Подразделения, Итого")
//   НачПер, КонПер    - Дата
//   СтрЛічильник      - Структура("Значение") — мутується in-place (обхід відсутності pass-by-ref у BSL)
Процедура _НЗ_ДодатиРядкиНачисленияПоПодразделениях(НЗ, Сотр, ВидРасч, ЗагальнаСума,
	ДанПоСотр, НачПер, КонПер, СтрЛічильник)

	Если ЗагальнаСума = 0 Тогда
		Возврат;
	КонецЕсли;

	НемаРозподілу = (ДанПоСотр = Неопределено)
		ИЛИ (ДанПоСотр.Подразделения.Количество() = 0)
		ИЛИ (ДанПоСотр.Итого = 0);

	// === Fallback: 1 рядок без підрозділу ===
	Если НемаРозподілу Тогда
		СтрЛічильник.Значение = СтрЛічильник.Значение + 1;
		НР = НЗ.Начисления.Добавить();
		НР.Сотрудник                      = Сотр;
		НР.Начисление                     = ВидРасч;
		НР.Результат                      = ЗагальнаСума;
		НР.ДатаНачала                     = НачПер;
		НР.ДатаОкончания                  = КонПер;
		НР.ПериодДействия                 = НачПер;
		НР.ПериодРегистрацииВремени       = НачПер;
		НР.ИдентификаторСтрокиВидаРасчета = СтрЛічильник.Значение;
		Возврат;
	КонецЕсли;

	// === Пропорційний розподіл по підрозділах ===
	Итого   = ДанПоСотр.Итого;
	Остаток = ЗагальнаСума;
	КолПодр = ДанПоСотр.Подразделения.Количество();
	Счетчик = 0;

	Для Каждого КЗ Из ДанПоСотр.Подразделения Цикл
		ПодрОрг = КЗ.Ключ;
		ПідрСум = КЗ.Значение;
		Счетчик = Счетчик + 1;

		Если Счетчик = КолПодр Тогда
			СумДляПодр = Остаток; // останній компенсує копійки
		Иначе
			Доля       = ПідрСум / Итого;
			СумДляПодр = Окр(ЗагальнаСума * Доля, 2);
			Остаток    = Остаток - СумДляПодр;
		КонецЕсли;

		Если СумДляПодр = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрЛічильник.Значение = СтрЛічильник.Значение + 1;
		НР = НЗ.Начисления.Добавить();
		НР.Сотрудник                      = Сотр;
		НР.Подразделение                  = ПодрОрг;
		НР.Начисление                     = ВидРасч;
		НР.Результат                      = СумДляПодр;
		НР.ДатаНачала                     = НачПер;
		НР.ДатаОкончания                  = КонПер;
		НР.ПериодДействия                 = НачПер;
		НР.ПериодРегистрацииВремени       = НачПер;
		НР.ИдентификаторСтрокиВидаРасчета = СтрЛічильник.Значение;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти    


#Область ЕРП_ДокументОтражениеЗарплатыВФинансовомУчете

// Find-Or-Create підлеглого Документ.ОтражениеЗарплатыВФинансовомУчете на підставі А_ОтражениеЗПпоКазне.
// Патерн: Guard → Get-or-Create → Fill → Write.Проведение (аналогічно СоздатьДокументНачисления).
//
// Джерела даних (уже заповнені в поточному документі попередніми кроками):
//   НачисленнаяЗарплатаИВзносыПоФизлицам → ТЧ НачисленнаяЗарплатаИВзносыПоФизлицам (1-в-1)
//                                         + свертка → ТЧ НачисленнаяЗарплатаИВзносы
//   НачисленныйНДФЛ                     → ТЧ НачисленныйНДФЛ (1-в-1, СпособОтражения = пусто)
//   УдержанияБухгалтерия                 → ТЧ УдержаннаяЗарплата (совпадающие поля)
//   РаспределениеКазна                   → ТЧ А_РаспределениеКазна (1-в-1)
//   + ФизическиеЛица                     — унікальні з усіх трьох ТЧ дочки
//
// Образец: документ ОтражениеЗарплатыВФинансовомУчете 000Ц-000002 від 31.12.2025 (ручний ввід).
Процедура СоздатьДокументОтражениеЗарплатыВФинансовомУчете() Экспорт

	// Guard: батько має бути проведений
	Если НЕ Проведен Тогда
		Сообщить("А_ОтражениеЗПпоКазне не проведений — ОтражениеЗарплатыВФинансовомУчете не створюється.");
		Возврат;
	КонецЕсли;

	// === Find-Or-Create ===
	ЗапросОЗ = Новый Запрос;
	ЗапросОЗ.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 ОЗ.Ссылка КАК Ссылка
	|ИЗ Документ.ОтражениеЗарплатыВФинансовомУчете КАК ОЗ
	|ГДЕ ОЗ.А_ДокОтражениеЗПпоКазне = &Осн И НЕ ОЗ.ПометкаУдаления";
	ЗапросОЗ.УстановитьПараметр("Осн", Ссылка);
	РезОЗ = ЗапросОЗ.Выполнить();

	Если НЕ РезОЗ.Пустой() Тогда
		Выб = РезОЗ.Выбрать();
		Выб.Следующий();
		ОЗ = Выб.Ссылка.ПолучитьОбъект();
		ОЗ.УстановитьПометкуУдаления(Ложь);
		Если ОЗ.Проведен Тогда
			Попытка
				ОЗ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение
				Сообщить("Не вдалося розпровести ОтражениеЗарплатыВФинансовомУчете: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		ОЗ.НачисленнаяЗарплатаИВзносы.Очистить();
		ОЗ.НачисленнаяЗарплатаИВзносыПоФизлицам.Очистить();
		ОЗ.НачисленныйНДФЛ.Очистить();
		ОЗ.УдержаннаяЗарплата.Очистить();
		ОЗ.ФизическиеЛица.Очистить();
	Иначе
		ОЗ = Документы.ОтражениеЗарплатыВФинансовомУчете.СоздатьДокумент();
	КонецЕсли;

	// === Шапка ===
	ОЗ.Дата                    = Дата;
	ОЗ.Организация             = Организация;
	ОЗ.ПериодРегистрации       = НачалоМесяца(Дата);
	ОЗ.Сводно                  = Ложь;
	ОЗ.ПроводкиПоРаботникам    = Истина;
	ОЗ.А_ДокОтражениеЗПпоКазне = Ссылка;

	// === ТЧ НачисленнаяЗарплатаИВзносыПоФизлицам — копія 1-в-1 ===
	Для Каждого СтрБ Из НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		Если СтрБ.Сумма = 0 И СтрБ.ВзносыВсего = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтр = ОЗ.НачисленнаяЗарплатаИВзносыПоФизлицам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, СтрБ);
		НоваяСтр.Организация = Организация; // ЗАВЖДИ з шапки батька
	КонецЦикла;

	// === ТЧ НачисленнаяЗарплатаИВзносы — СВЕРТКА ===
	// Групуємо по ключу (Организация, ПодразделениеПредприятия, ВидОперации,
	// СпособОтраженияЗарплатыВБухучете, ГруппаУчетаНачислений, Налог), сумуємо Сумма + ВзносыВсего.
	ТЗСвертка = Новый ТаблицаЗначений;
	ТЗСвертка.Колонки.Добавить("Организация");
	ТЗСвертка.Колонки.Добавить("ПодразделениеПредприятия");
	ТЗСвертка.Колонки.Добавить("ВидОперации");
	ТЗСвертка.Колонки.Добавить("СпособОтраженияЗарплатыВБухучете");
	ТЗСвертка.Колонки.Добавить("ГруппаУчетаНачислений");
	ТЗСвертка.Колонки.Добавить("Налог");
	ТЗСвертка.Колонки.Добавить("ФормаPL");
	ТЗСвертка.Колонки.Добавить("Сумма");
	ТЗСвертка.Колонки.Добавить("ВзносыВсего");
	ТЗСвертка.Колонки.Добавить("ОрганизацияБухгалтерия");

	Для Каждого СтрПоФЛ Из ОЗ.НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		НоваСвер = ТЗСвертка.Добавить();
		НоваСвер.Организация                      = Организация;
		НоваСвер.ПодразделениеПредприятия         = СтрПоФЛ.ПодразделениеПредприятия;
		НоваСвер.ВидОперации                      = СтрПоФЛ.ВидОперации;
		НоваСвер.СпособОтраженияЗарплатыВБухучете = СтрПоФЛ.СпособОтраженияЗарплатыВБухучете;
		НоваСвер.ГруппаУчетаНачислений            = СтрПоФЛ.ГруппаУчетаНачислений;
		НоваСвер.Налог                            = СтрПоФЛ.Налог;
		НоваСвер.ФормаPL                          = СтрПоФЛ.ФормаPL;
		НоваСвер.Сумма                            = СтрПоФЛ.Сумма;
		НоваСвер.ВзносыВсего                      = СтрПоФЛ.ВзносыВсего;
		НоваСвер.ОрганизацияБухгалтерия           = СтрПоФЛ.ОрганизацияБухгалтерия;
	КонецЦикла;
	ТЗСвертка.Свернуть(
		"Организация, ПодразделениеПредприятия, ВидОперации, СпособОтраженияЗарплатыВБухучете, ГруппаУчетаНачислений, Налог, ФормаPL, ОрганизацияБухгалтерия",
		"Сумма, ВзносыВсего");

	Для Каждого СтрС Из ТЗСвертка Цикл
		Если СтрС.Сумма = 0 И СтрС.ВзносыВсего = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСвр = ОЗ.НачисленнаяЗарплатаИВзносы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСвр, СтрС);
	КонецЦикла;

	// Карта ОргБух per (ФЛ,Подр) із Ф1 «Зарплата управл» — для НДФЛ/Удержань, де у джерелі ОргБух немає.
	КартаОргБух = _ОЗП_ПостроитьКартуОргБух(ОЗ);

	// === ТЧ НачисленныйНДФЛ — копія 1-в-1 ===
	// УВАГА: СпособОтраженияЗарплатыВБухучете ЗАЛИШАЄМО ПУСТИМ (як у еталоні 000Ц-000002).
	Для Каждого СтрБ Из НачисленныйНДФЛ Цикл
		Если СтрБ.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтр = ОЗ.НачисленныйНДФЛ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, СтрБ);
		НоваяСтр.Организация = Организация;
		НоваяСтр.СпособОтраженияЗарплатыВБухучете = Справочники.СпособыОтраженияЗарплатыВБухучете.ПустаяСсылка();
		// Пріоритет — per-org ОргБух з рядка-джерела (Правка 1); карта «Зарплата управл» лише як fallback.
		НоваяСтр.ОрганизацияБухгалтерия = ?(ЗначениеЗаполнено(СтрБ.ОрганизацияБухгалтерия), СтрБ.ОрганизацияБухгалтерия,
			_ОЗП_ОргБухИзКарты(КартаОргБух, СтрБ.ФизическоеЛицо, СтрБ.ПодразделениеПредприятия));
	КонецЦикла;

	// === ТЧ УдержаннаяЗарплата ← УдержанияБухгалтерия ===
	// Совпадающі поля копіюються через ЗаполнитьЗначенияСвойств.
	// Поля Контрагент/ЦельВыдачи/СтатьяДоходов/АналитикаДоходов відсутні у джерелі —
	// лишаються пустими (як у еталоні).
	//
	// ПодразделениеПредприятия у джерелі УдержанияБухгалтерия часто ПУСТЕ.
	// Правило: беремо з А_ОтражениеЗПпоКазне.НачисленнаяЗарплатаИВзносыПоФизлицам
	// ПО НАЙБІЛЬШОМУ начисленню (Сумма) для того самого ФізЛицу.
	// Удержания НЕ розбиваємо по підрозділах — одне утримання = один рядок з одним підрозділом.
	ТЗПодрПоФЛ = Новый ТаблицаЗначений;
	ТЗПодрПоФЛ.Колонки.Добавить("ФизическоеЛицо");
	ТЗПодрПоФЛ.Колонки.Добавить("Подразделение");
	ТЗПодрПоФЛ.Колонки.Добавить("Сумма");
	Для Каждого СтрНач Из НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		Если НЕ ЗначениеЗаполнено(СтрНач.ФизическоеЛицо) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрНач.ПодразделениеПредприятия) Тогда
			Продолжить;
		КонецЕсли;
		НовСтрПодр = ТЗПодрПоФЛ.Добавить();
		НовСтрПодр.ФизическоеЛицо = СтрНач.ФизическоеЛицо;
		НовСтрПодр.Подразделение  = СтрНач.ПодразделениеПредприятия;
		НовСтрПодр.Сумма          = СтрНач.Сумма;
	КонецЦикла;
	ТЗПодрПоФЛ.Свернуть("ФизическоеЛицо, Подразделение", "Сумма");
	ТЗПодрПоФЛ.Сортировать("Сумма УБЫВ");
	МапПодразПоФЛ = Новый Соответствие;
	Для Каждого СтрМ Из ТЗПодрПоФЛ Цикл
		Если МапПодразПоФЛ[СтрМ.ФизическоеЛицо] = Неопределено Тогда
			МапПодразПоФЛ.Вставить(СтрМ.ФизическоеЛицо, СтрМ.Подразделение);
		КонецЕсли;
	КонецЦикла;

	// Предопределённий елемент "Прочие пассивы" (НЕ група!)
	ПрочиеПассивыЭлемент = ПланыВидовХарактеристик.СтатьиАктивовПассивов.ПрочиеПассивы;

	Для Каждого СтрБ Из УдержанияБухгалтерия Цикл
		Если СтрБ.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтр = ОЗ.УдержаннаяЗарплата.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтр, СтрБ);
		НоваяСтр.Организация = Организация;
		НоваяСтр.ФормаPL = Перечисления.А_ФормыPL.Форма1; // утримання — бухгалтерські (офіційні)
		// Якщо Подразделение не заповнене у джерелі — беремо з кеша по ФЛ (max начислення).
		Если НЕ ЗначениеЗаполнено(НоваяСтр.ПодразделениеПредприятия) Тогда
			ПодрЗНач = МапПодразПоФЛ[СтрБ.ФизическоеЛицо];
			Если ПодрЗНач <> Неопределено Тогда
				НоваяСтр.ПодразделениеПредприятия = ПодрЗНач;
			КонецЕсли;
		КонецЕсли;
		НоваяСтр.ОрганизацияБухгалтерия = _ОЗП_ОргБухИзКарты(КартаОргБух, НоваяСтр.ФизическоеЛицо, НоваяСтр.ПодразделениеПредприятия);
		// У батьку СтатьяАктивовПассивов = ГРУПА "Прочие пассивы" (баг заповнення).
		// Підміняємо на ПРЕДОПРЕДЕЛЁННЫЙ елемент "ПрочиеПассивы", інакше ERP бачить групу.
		Если ЗначениеЗаполнено(НоваяСтр.СтатьяАктивовПассивов)
			И НоваяСтр.СтатьяАктивовПассивов.ЭтоГруппа Тогда
			НоваяСтр.СтатьяАктивовПассивов = ПрочиеПассивыЭлемент;
		КонецЕсли;
	КонецЦикла;

	// === ТЧ ФизическиеЛица — унікальні з усіх трьох ТЧ дочки ===
	НаборФЛ = Новый Соответствие;
	Для Каждого Стр Из ОЗ.НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		Если ЗначениеЗаполнено(Стр.ФизическоеЛицо) Тогда
			НаборФЛ.Вставить(Стр.ФизическоеЛицо, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ОЗ.НачисленныйНДФЛ Цикл
		Если ЗначениеЗаполнено(Стр.ФизическоеЛицо) Тогда
			НаборФЛ.Вставить(Стр.ФизическоеЛицо, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стр Из ОЗ.УдержаннаяЗарплата Цикл
		Если ЗначениеЗаполнено(Стр.ФизическоеЛицо) Тогда
			НаборФЛ.Вставить(Стр.ФизическоеЛицо, Истина);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлЗн Из НаборФЛ Цикл
		ОЗ.ФизическиеЛица.Добавить().ФизическоеЛицо = КлЗн.Ключ;
	КонецЦикла;

	// === ТЧ А_РаспределениеКазна та А_РаспределениеНалоги — НЕ заповнюємо ===
	// За рішенням (квітень 2026): ці службові таблиці не потрібні у дочці,
	// достатньо зв'язку через А_ДокОтражениеЗПпоКазне на родителя.

	// === Запис з проведенням + fallback ===
	Попытка
		ОЗ.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("ОтражениеЗарплатыВФинансовомУчете створено/оновлено: " + Строка(ОЗ.Ссылка)
			+ " (Нач=" + ОЗ.НачисленнаяЗарплатаИВзносы.Количество()
			+ ", НачПоФЛ=" + ОЗ.НачисленнаяЗарплатаИВзносыПоФизлицам.Количество()
			+ ", НДФЛ=" + ОЗ.НачисленныйНДФЛ.Количество()
			+ ", Удерж=" + ОЗ.УдержаннаяЗарплата.Количество()
			+ ", ФЛ=" + ОЗ.ФизическиеЛица.Количество() + ")");
	Исключение
		Сообщить("Помилка проведення ОтражениеЗарплатыВФинансовомУчете: " + ОписаниеОшибки()
			+ " — спроба записати без проведення.");
		Попытка
			ОЗ.Записать(РежимЗаписиДокумента.Запись);
			Сообщить("ОтражениеЗарплатыВФинансовомУчете збережено БЕЗ проведення: " + Строка(ОЗ.Ссылка));
		Исключение
			Сообщить("Не вдалося зберегти ОтражениеЗарплатыВФинансовомУчете взагалі: " + ОписаниеОшибки());
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

// Будує карту ОрганизацияБухгалтерия per (ФЛ, Подр) і per (ФЛ) із Ф1-рядків «Зарплата управл»
// (не утримання, ВзносыВсего=0, ОргБух заповнено) дочірнього ОЗФУ. Для мульти-орг (ФЛ,Подр) —
// домінантний ОргБух (макс Σ Сумма). Джерело для НачисленныйНДФЛ/УдержаннаяЗарплата, де ОргБух немає.
Функция _ОЗП_ПостроитьКартуОргБух(ОЗ)

	Ф1 = Перечисления.А_ФормыPL.Форма1;
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ФЛ");
	ТЗ.Колонки.Добавить("Подр");
	ТЗ.Колонки.Добавить("ОргБух");
	ТЗ.Колонки.Добавить("Сумма");
	Для Каждого Стр Из ОЗ.НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		Если Стр.ФормаPL <> Ф1 ИЛИ НЕ ЗначениеЗаполнено(Стр.ОрганизацияБухгалтерия) Тогда Продолжить; КонецЕсли;
		Способ = Стр.СпособОтраженияЗарплатыВБухучете;
		Если ЗначениеЗаполнено(Способ) И Способ.А_ЭтоУдержание Тогда Продолжить; КонецЕсли;
		Если Стр.ВзносыВсего <> 0 ИЛИ НЕ ЗначениеЗаполнено(Стр.ФизическоеЛицо) Тогда Продолжить; КонецЕсли;
		Н = ТЗ.Добавить();
		Н.ФЛ     = Стр.ФизическоеЛицо;
		Н.Подр   = Стр.ПодразделениеПредприятия;
		Н.ОргБух = Стр.ОрганизацияБухгалтерия;
		Н.Сумма  = Стр.Сумма;
	КонецЦикла;
	ТЗ.Свернуть("ФЛ, Подр, ОргБух", "Сумма");
	ТЗ.Сортировать("Сумма УБЫВ");

	ПоПодр = Новый Соответствие;
	ПоФЛ   = Новый Соответствие;
	Для Каждого Стр Из ТЗ Цикл
		КлючПодр = XMLСтрока(Стр.ФЛ) + "|" + XMLСтрока(Стр.Подр);
		Если ПоПодр[КлючПодр] = Неопределено Тогда
			ПоПодр.Вставить(КлючПодр, Стр.ОргБух);
		КонецЕсли;
		КлючФЛ = XMLСтрока(Стр.ФЛ);
		Если ПоФЛ[КлючФЛ] = Неопределено Тогда
			ПоФЛ.Вставить(КлючФЛ, Стр.ОргБух);
		КонецЕсли;
	КонецЦикла;

	Возврат Новый Структура("ПоПодр, ПоФЛ", ПоПодр, ПоФЛ);

КонецФункции

// Повертає ОргБух із карти: точно per (ФЛ,Подр), fallback per (ФЛ), інакше порожня організація.
Функция _ОЗП_ОргБухИзКарты(Карта, ФЛ, Подр)

	Если НЕ ЗначениеЗаполнено(ФЛ) Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	ОБ = Карта.ПоПодр[XMLСтрока(ФЛ) + "|" + XMLСтрока(Подр)];
	Если ОБ = Неопределено Тогда
		ОБ = Карта.ПоФЛ[XMLСтрока(ФЛ)];
	КонецЕсли;
	Возврат ?(ОБ = Неопределено, Справочники.Организации.ПустаяСсылка(), ОБ);

КонецФункции


#КонецОбласти


#Область ЕРП_СоздатьВедомостиВКассу

// Главная экспортная процедура: создать/обновить ВедомостиНаВыплатуЗарплатыВКассу
// по уникальным РаспределениеФ2 из ТЧ.РаспределениеКазна.
//
// АРХИТЕКТУРА (2026-05-28, переписано): этот документ — ЕДИНСТВЕННЫЙ источник данных
// для ВКассу. РаспределениеФ2 в ERP — пустая оболочка после обмена (UUID 1:1 с Казной,
// но без СтатьиДДС, которая физически живёт только в БДДС Казны → попадает в нашу ТЧ
// РаспределениеКазна при COM-загрузке). Подразделение в ТЧ РаспределениеКазна тоже
// уже исправлено через А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны
// в момент загрузки (см. ЗагрузитьРаспределениеКазна_ОтражениеЗП), поэтому здесь
// функция БОЛЬШЕ НЕ вызывается — только ОбеспечитьПодразделенияОрганизацийПоПодразделению
// для конвертации СтрПредпр → ПодрОрг.
//
// Связь дочка→родитель: ВКассу.А_РаспределениеФ2 + ВКассу.А_ОтражениеЗПпоКазне.
// Обратная связь: Ф2.А_ВедомостьВКассу.
Процедура СоздатьВедомостиВКассуПоОтражениюЗП() Экспорт

	Если НЕ Проведен Тогда
		Сообщить("А_ОтражениеЗПпоКазне не проведено — кнопка не сработает.");
		Возврат;
	КонецЕсли;

	// Группировка ТЧ.РаспределениеКазна по Ф2 (только тип РаспределениеФ2)
	ГруппыПоФ2 = Новый Соответствие;  // Ф2Ссылка → Массив строк ТЧ
	ПропускТипов = 0;
	Для Каждого СтрРК Из РаспределениеКазна Цикл
		Если НЕ ЗначениеЗаполнено(СтрРК.ДокРаспределениеЗП) Тогда Продолжить; КонецЕсли;
		Если ТипЗнч(СтрРК.ДокРаспределениеЗП) <> Тип("ДокументСсылка.РаспределениеФ2") Тогда
			ПропускТипов = ПропускТипов + 1;
			Продолжить;
		КонецЕсли;
		Ф2Ссылка = СтрРК.ДокРаспределениеЗП;
		Если ГруппыПоФ2.Получить(Ф2Ссылка) = Неопределено Тогда
			ГруппыПоФ2.Вставить(Ф2Ссылка, Новый Массив);
		КонецЕсли;
		ГруппыПоФ2[Ф2Ссылка].Добавить(СтрРК);
	КонецЦикла;

	КолОбработано    = 0;
	КолОшибок        = 0;
	КолПропущеноБлок = 0;
	Для Каждого КЗ Из ГруппыПоФ2 Цикл
		Ф2Ссылка = КЗ.Ключ;
		СтрокиРК = КЗ.Значение;

		Если Ф2Ссылка.ПолучитьОбъект() = Неопределено Тогда
			Сообщить("Ф2 " + Строка(Ф2Ссылка) + " не найден — пропуск.");
			КолОшибок = КолОшибок + 1;
			Продолжить;
		КонецЕсли;
		Если НЕ Ф2Ссылка.Проведен Тогда
			Сообщить("Ф2 " + Строка(Ф2Ссылка) + " не проведён — пропуск.");
			КолОшибок = КолОшибок + 1;
			Продолжить;
		КонецЕсли;

		Попытка
			Код = _ОЗП_СоздатьВКассуИзФ2(Ф2Ссылка, СтрокиРК);
			Если      Код = "Пропущено" Тогда КолПропущеноБлок = КолПропущеноБлок + 1;
			ИначеЕсли Код = "Ошибка"    Тогда КолОшибок         = КолОшибок + 1;
			Иначе                              КолОбработано    = КолОбработано + 1;
			КонецЕсли;
		Исключение
			Сообщить("Ошибка создания ВКассу для " + Строка(Ф2Ссылка) + ": " + ОписаниеОшибки());
			КолОшибок = КолОшибок + 1;
		КонецПопытки;
	КонецЦикла;

	ИтогТекст = "ОтражениеЗПпоКазне → ВКассу: создано/обновлено " + КолОбработано
		+ ", ошибок " + КолОшибок;
	Если КолПропущеноБлок > 0 Тогда
		ИтогТекст = ИтогТекст + ", пропущено заблокированных (А_Необновлять) " + КолПропущеноБлок;
	КонецЕсли;
	Если ПропускТипов > 0 Тогда
		ИтогТекст = ИтогТекст + ", пропущено А_РаспределениеЗаработнойПлаты строк " + ПропускТипов;
	КонецЕсли;
	Сообщить(ИтогТекст);

КонецПроцедуры

// Создаёт/обновляет ОДНУ ВКассу по одной Ф2 на основе строк РаспределениеКазна.
// Возвращает строковый код: "Создано" / "Обновлено" / "Пропущено" / "Ошибка".
// "Пропущено" — ВКассу есть и помечена А_Необновлять=Истина (уже занята проведённым РКО).
// СтрокиРК — Массив строк ТЧ.РаспределениеКазна, относящихся к этой Ф2.
Функция _ОЗП_СоздатьВКассуИзФ2(Ф2Ссылка, СтрокиРК)

	КодРезультата = "";

	// Find-or-Create по обратной ссылке Ф2→ВКассу
	ЗапросСущ = Новый Запрос;
	ЗапросСущ.УстановитьПараметр("Основание", Ф2Ссылка);
	ЗапросСущ.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Д.Ссылка КАК Ссылка,
	|	Д.Проведен КАК Проведен,
	|	Д.ПометкаУдаления КАК ПометкаУдаления,
	|	Д.А_Необновлять КАК А_Необновлять
	|ИЗ Документ.ВедомостьНаВыплатуЗарплатыВКассу КАК Д
	|ГДЕ Д.А_РаспределениеФ2 = &Основание";
	Результат = ЗапросСущ.Выполнить();

	Если НЕ Результат.Пустой() Тогда
		Выб = Результат.Выбрать(); Выб.Следующий();

		// Гард: ВКассу уже занята проведённым РКО — её нельзя перезаписывать.
		Если Выб.А_Необновлять Тогда
			Сообщить("Ф2 " + Строка(Ф2Ссылка) + " → ВКассу " + Строка(Выб.Ссылка)
				+ " пропущена (А_Необновлять=Истина, занята РКО)");
			Возврат "Пропущено";
		КонецЕсли;

		ВыкВКассу = Выб.Ссылка.ПолучитьОбъект();
		Если Выб.ПометкаУдаления Тогда
			ВыкВКассу.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
		Если Выб.Проведен Тогда
			Попытка
				ВыкВКассу.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			Исключение
				Сообщить("Не удалось распровести существующую ВКассу " + Строка(Выб.Ссылка) + ": " + ОписаниеОшибки());
				Возврат "Ошибка";
			КонецПопытки;
		КонецЕсли;
		ВыкВКассу.Зарплата.Очистить();
		ВыкВКассу.А_РасшифровкаВыплатыЗарплатаПоФизлицам.Очистить();
		ВыкВКассу.Состав.Очистить();
		КодРезультата = "Обновлено";
	Иначе
		ВыкВКассу = Документы.ВедомостьНаВыплатуЗарплатыВКассу.СоздатьДокумент();
		КодРезультата = "Создано";
	КонецЕсли;

	// Шапка — Касса.Владелец как Организация (по образцу типовой 000Ц-000001)
	КассаЗП = _ОЗП_ОпределитьКассу(Ф2Ссылка.Организация);
	Если НЕ ЗначениеЗаполнено(КассаЗП) Тогда
		Сообщить("ВНИМАНИЕ: касса для ВКассу не определена (Ф2 " + Строка(Ф2Ссылка) + ")");
	КонецЕсли;
	ОрганизацияВКассу = ?(ЗначениеЗаполнено(КассаЗП) И ЗначениеЗаполнено(КассаЗП.Владелец),
		КассаЗП.Владелец, Ф2Ссылка.Организация);

	ВыкВКассу.Дата                     = Ф2Ссылка.Дата;
	ВыкВКассу.ПериодРегистрации        = НачалоМесяца(Ф2Ссылка.КассаДатаС);
	ВыкВКассу.Организация              = ОрганизацияВКассу;
	ВыкВКассу.Подразделение            = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
	ВыкВКассу.Касса                    = КассаЗП;
	ВыкВКассу.СпособВыплаты            = Справочники.СпособыВыплатыЗарплаты.Зарплата;
	ВыкВКассу.ПроцентВыплаты           = 100;
	ВыкВКассу.ПорядокЗаполненияНалогов = Перечисления.ПорядокЗаполненияНалогов.БезНалогов;
	ВыкВКассу.А_РаспределениеФ2        = Ф2Ссылка;
	ВыкВКассу.А_ОтражениеЗПпоКазне     = Ссылка; 
	ВыкВКассу.Округление     = Справочники.СпособыОкругленияПриРасчетеЗарплаты.НайтиПоНаименованию("Без округления");

	ВыкВКассу.Ответственный            = Ответственный;
	ВыкВКассу.Комментарий              = "Сформировано из А_ОтражениеЗПпоКазне №" + Номер
		+ " от " + Формат(Дата, "ДЛФ=DD") + " (Ф2 №" + Ф2Ссылка.Номер
		+ ", Направление: " + Строка(Ф2Ссылка.Направление) + ")";

	// Кеш Сотрудник → ФизЛицо
	МасСотр = Новый Массив;
	Для Каждого СтрРК Из СтрокиРК Цикл
		Если ЗначениеЗаполнено(СтрРК.Сотрудник) И МасСотр.Найти(СтрРК.Сотрудник) = Неопределено Тогда
			МасСотр.Добавить(СтрРК.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	КешФЛ = _ОЗП_ПостроитьКешСотрудникФЛ(МасСотр);

	// Кеш СтрПредпр → ПодрОрг.
	// СтрПредпр в СтрРК.Подразделение УЖЕ исправлено через
	// А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны
	// в момент COM-загрузки. Здесь только конвертируем СтрПредпр → ПодрОрг.
	МасПодр = Новый Массив;
	Для Каждого СтрРК Из СтрокиРК Цикл
		Если ЗначениеЗаполнено(СтрРК.Подразделение) И МасПодр.Найти(СтрРК.Подразделение) = Неопределено Тогда
			МасПодр.Добавить(СтрРК.Подразделение);
		КонецЕсли;
	КонецЦикла;
	КешПодрОрг = Новый Соответствие;
	Для Каждого СтрПредпр Из МасПодр Цикл
		Попытка
			ПодрОрг = А_Привилегированный.ОбеспечитьПодразделенияОрганизацийПоПодразделению(СтрПредпр);
		Исключение
			ПодрОрг = Справочники.ПодразделенияОрганизаций.ПустаяСсылка();
		КонецПопытки;
		КешПодрОрг.Вставить(СтрПредпр, ПодрОрг);
	КонецЦикла;

	ГруппаЗарплата = Справочники.ГруппыУчетаНачисленийИУдержаний.НайтиПоНаименованию("Зарплата (661)", Истина);
	Если НЕ ЗначениеЗаполнено(ГруппаЗарплата) Тогда
		ГруппаЗарплата = Справочники.ГруппыУчетаНачисленийИУдержаний.НайтиПоКоду("661");
	КонецЕсли;

	// ТЧ Состав СНАЧАЛА — карта ФЛ→UID для ИдентификаторСтроки
	// (типовая ВедомостьПередЗаписью удаляет строки Зарплата без матча в Составе).
	КартаФЛкUID = Новый Соответствие;
	Для Каждого СтрРК Из СтрокиРК Цикл
		Если НЕ ЗначениеЗаполнено(СтрРК.Сотрудник) Тогда Продолжить; КонецЕсли;
		Если СтрРК.Сумма = 0 Тогда Продолжить; КонецЕсли;
		ФЛ = КешФЛ[СтрРК.Сотрудник];
		Если НЕ ЗначениеЗаполнено(ФЛ) Тогда Продолжить; КонецЕсли;
		Если КартаФЛкUID.Получить(ФЛ) = Неопределено Тогда
			НовойUID = Новый УникальныйИдентификатор();
			КартаФЛкUID.Вставить(ФЛ, НовойUID);
			НовСтрСостав = ВыкВКассу.Состав.Добавить();
			НовСтрСостав.ФизическоеЛицо      = ФЛ;
			НовСтрСостав.ИдентификаторСтроки = НовойUID;
		КонецЕсли;
	КонецЦикла;

	// ТЧ Зарплата + ТЧ А_Расшифровка (зеркало по ИдентификаторСтроки).
	// Источник истины — СтрРК (РаспределениеКазна). Подразделение, СтатьяДДС, Направление —
	// прямо из строки РК; никаких словарей, никаких вызовов внешних процедур.
	ПериодВзаим = НачалоМесяца(Ф2Ссылка.КассаДатаС);
	КолПропусковФЛ = 0;
	Для Каждого СтрРК Из СтрокиРК Цикл
		Если НЕ ЗначениеЗаполнено(СтрРК.Сотрудник) Тогда Продолжить; КонецЕсли;
		Если СтрРК.Сумма = 0 Тогда Продолжить; КонецЕсли;
		ФЛ = КешФЛ[СтрРК.Сотрудник];
		Если НЕ ЗначениеЗаполнено(ФЛ) Тогда
			КолПропусковФЛ = КолПропусковФЛ + 1;
			Продолжить;
		КонецЕсли;
		UIDСостава = КартаФЛкUID.Получить(ФЛ);
		Если UIDСостава = Неопределено Тогда Продолжить; КонецЕсли;

		ПодрОргСтроки = ?(ЗначениеЗаполнено(СтрРК.Подразделение),
			КешПодрОрг[СтрРК.Подразделение],
			Справочники.ПодразделенияОрганизаций.ПустаяСсылка());
		ПодрОргДляЗаписи = ?(ЗначениеЗаполнено(ПодрОргСтроки), ПодрОргСтроки,
			Справочники.ПодразделенияОрганизаций.ПустаяСсылка());

		НовЗ = ВыкВКассу.Зарплата.Добавить();
		НовЗ.Сотрудник              = СтрРК.Сотрудник;
		НовЗ.ФизическоеЛицо         = ФЛ;
		НовЗ.Подразделение          = ПодрОргДляЗаписи;
		НовЗ.ПериодВзаиморасчетов   = ПериодВзаим;
		НовЗ.КВыплате               = СтрРК.Сумма;
		НовЗ.ГруппаУчетаНачислений  = ГруппаЗарплата;
		НовЗ.ИдентификаторСтроки    = UIDСостава;

		НовР = ВыкВКассу.А_РасшифровкаВыплатыЗарплатаПоФизлицам.Добавить();
		НовР.ИдентификаторСтроки           = UIDСостава;
		НовР.Сотрудник                     = СтрРК.Сотрудник;
		НовР.ФизическоеЛицо                = ФЛ;
		НовР.Подразделение                 = ПодрОргДляЗаписи;
		НовР.ПериодВзаиморасчетов          = ПериодВзаим;
		НовР.КВыплате                      = СтрРК.Сумма;
		НовР.ГруппаУчетаНачислений         = ГруппаЗарплата;
		НовР.НаправлениеДеятельности       = СтрРК.НаправленияДеятельности;
		НовР.СтатьяДвиженияДенежныхСредств = СтрРК.СтатьяДвиженияДенежныхСредств;
	КонецЦикла;
	Если КолПропусковФЛ > 0 Тогда
		Сообщить("Ф2 " + Строка(Ф2Ссылка) + ": пропущено " + КолПропусковФЛ + " строк без ФизЛица.");
	КонецЕсли;

	ВыкВКассу.СуммаПоДокументу = ВыкВКассу.Зарплата.Итог("КВыплате");

	Попытка
		ВыкВКассу.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщить("Ошибка проведения ВКассу для Ф2 " + Строка(Ф2Ссылка) + ": " + ОписаниеОшибки());
		Возврат "Ошибка";
	КонецПопытки;

	// Обратная ссылка Ф2.А_ВедомостьВКассу
	Если Ф2Ссылка.А_ВедомостьВКассу <> ВыкВКассу.Ссылка Тогда
		Ф2Объект = Ф2Ссылка.ПолучитьОбъект();
		Ф2Объект.А_ВедомостьВКассу = ВыкВКассу.Ссылка;
		Ф2Объект.ОбменДанными.Загрузка = Истина;
		Ф2Объект.Записать();
	КонецЕсли;

	Сообщить("Ф2 " + Строка(Ф2Ссылка) + " → ВКассу " + Строка(ВыкВКассу.Ссылка)
		+ " | Зарплата=" + ВыкВКассу.Зарплата.Количество()
		+ " | Расшифровка=" + ВыкВКассу.А_РасшифровкаВыплатыЗарплатаПоФизлицам.Количество()
		+ " | Состав=" + ВыкВКассу.Состав.Количество()
		+ " | Σ=" + Формат(ВыкВКассу.СуммаПоДокументу, "ЧДЦ=2")
		+ " | Проведена=" + Строка(ВыкВКассу.Проведен));

	Возврат КодРезультата;

КонецФункции

// Утилита: построение кеша Сотрудник → ФизическоеЛицо (один запрос).
Функция _ОЗП_ПостроитьКешСотрудникФЛ(МасСотрудников)
	Результат = Новый Соответствие;
	Если МасСотрудников.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	С.Ссылка КАК Сотрудник,
	|	С.ФизическоеЛицо КАК ФизическоеЛицо
	|ИЗ Справочник.Сотрудники КАК С
	|ГДЕ С.Ссылка В (&МасСотрудников)";
	Запрос.УстановитьПараметр("МасСотрудников", МасСотрудников);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.ФизическоеЛицо) Тогда
			Результат.Вставить(Выборка.Сотрудник, Выборка.ФизическоеЛицо);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Утилита: определение кассы для шапки ВКассу.
// Порядок поиска: Орг.А_ОсновнаяКасса → первая активная касса Организации
// → НайтиПоНаименованию("Касса ЗП") → ПустаяСсылка.
Функция _ОЗП_ОпределитьКассу(ОрганизацияСсылка)

	КассаЗП = Справочники.Кассы.НайтиПоНаименованию("Касса ЗП", Истина);
	Если ЗначениеЗаполнено(КассаЗП) Тогда
		Возврат КассаЗП;
	КонецЕсли;
	Возврат Справочники.Кассы.ПустаяСсылка();
КонецФункции

#КонецОбласти

#Область ЕРП_СоздатьПередачуНачисленийМеждуПодразделениями

// Создаёт/обновляет Документ.А_ПередачаНачисленийМеждуПодразделениями по этому А_ОтражениеЗПпоКазне.
// ЕДИНЫЙ ИСТОЧНИК (Частина C промту): суми/ОргБух/підрозділи беруться ПРЯМО з нашого документа —
//   Начисления ← «Зарплата управл» Ф1 (А_ЭтоУдержание=Ложь, ВзносыВсего=0) — це вже take-home NET
//   Налоги     ← НачисленныйНДФЛ (Ф1, НДФЛ/ВС) + ЕСВ (НачисленнаяЗарплата.ВзносыВсего Ф1)
//   Удержания  ← УдержанияБухгалтерия
// Цільовий підрозділ = ОргБух.А_ПодразделениеЗарплатаБух. Рядок переноситься ЛИШЕ якщо ОргБух
// заповнено, є цільовий підрозділ і він ≠ вихідного. Find-Or-Create по А_ДокументОснование, ідемпотентно.
Процедура СоздатьПередачуНачисленийМеждуПодразделениями() Экспорт

	Если НЕ Проведен Тогда
		Сообщить("А_ОтражениеЗПпоКазне не проведено — передача не создаётся.");
		Возврат;
	КонецЕсли;

	СотрудникПоФЛ = _ПНМП_ПостроитьСотрудникПоФЛ();
	ОргБухПоФЛ    = _ПНМП_ПостроитьОргБухПоФЛ();
	ПодрУдержПоФЛ = _ПНМП_ПостроитьПодрУдержанийПоФЛ();

	Док = _ПНМП_НайтиИлиСоздать(Ссылка);
	Док.Дата           = Дата;
	Док.Организация    = Организация;
	Док.Ответственный  = Ответственный;
	Док.А_ДокументОснование = Ссылка;
	Док.Комментарий    = "Сформировано из А_ОтражениеЗПпоКазне №" + Номер
		+ " от " + Формат(Дата, "ДЛФ=DD");

	_ПНМП_ЗаполнитьНачисления(Док, СотрудникПоФЛ);
	_ПНМП_ЗаполнитьНалоги(Док, СотрудникПоФЛ, ОргБухПоФЛ);
	_ПНМП_ЗаполнитьУдержания(Док, СотрудникПоФЛ, ОргБухПоФЛ, ПодрУдержПоФЛ);
	_ПНМП_ЗаполнитьНачисленияФорма2(Док, СотрудникПоФЛ);   // управленческая ЗП → корень дерева

	Попытка
		Док.Записать(РежимЗаписиДокумента.Проведение);
		Сообщить("Передача создана/обновлена: " + Строка(Док.Ссылка)
			+ " | Начисления " + Док.Начисления.Количество()
			+ ", Налоги " + Док.Налоги.Количество()
			+ ", Удержания " + Док.Удержания.Количество() + " строк");
	Исключение
		Сообщить("Ошибка проведения передачи начислений: " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

// Find-Or-Create документа передачи по А_ДокументОснование. При наличии — распроводит,
// чистит ТЧ и возвращает объект; иначе создаёт новый.
Функция _ПНМП_НайтиИлиСоздать(Родитель)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Осн", Родитель);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 Д.Ссылка КАК Ссылка, Д.Проведен КАК Проведен, Д.ПометкаУдаления КАК ПометкаУдаления
	|ИЗ Документ.А_ПередачаНачисленийМеждуПодразделениями КАК Д
	|ГДЕ Д.А_ДокументОснование = &Осн";
	Рез = Запрос.Выполнить();
	Если НЕ Рез.Пустой() Тогда
		Выб = Рез.Выбрать(); Выб.Следующий();
		Об = Выб.Ссылка.ПолучитьОбъект();
		Если Выб.ПометкаУдаления Тогда
			Об.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
		Если Выб.Проведен Тогда
			Об.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		КонецЕсли;
		Об.Начисления.Очистить();
		Об.Налоги.Очистить();
		Об.Удержания.Очистить();
		Возврат Об;
	КонецЕсли;
	Возврат Документы.А_ПередачаНачисленийМеждуПодразделениями.СоздатьДокумент();
КонецФункции

// ФизЛицо → Сотрудник (з РаспределениеКазна; перший знайдений) — для заповнення ПНМП.Сотрудник.
Функция _ПНМП_ПостроитьСотрудникПоФЛ()
	Рез = Новый Соответствие;
	Для Каждого СтрК Из РаспределениеКазна Цикл
		Если НЕ ЗначениеЗаполнено(СтрК.Сотрудник) Тогда Продолжить; КонецЕсли;
		ФЛ = СтрК.Сотрудник.ФизическоеЛицо;
		Если ЗначениеЗаполнено(ФЛ) И Рез[ФЛ] = Неопределено Тогда
			Рез.Вставить(ФЛ, СтрК.Сотрудник);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// ФизЛицо → ОрганизацияБухгалтерия (з Ф1-нарахувань НачисленнаяЗарплата; перша непуста) —
// для рядків Налоги/Удержания, де власного поля ОргБух немає.
Функция _ПНМП_ПостроитьОргБухПоФЛ()
	Ф1 = Перечисления.А_ФормыPL.Форма1;
	Рез = Новый Соответствие;
	Для Каждого Стр Из НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		Если Стр.ФормаPL <> Ф1 ИЛИ НЕ ЗначениеЗаполнено(Стр.ОрганизацияБухгалтерия) Тогда Продолжить; КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ФизическоеЛицо) И Рез[Стр.ФизическоеЛицо] = Неопределено Тогда
			Рез.Вставить(Стр.ФизическоеЛицо, Стр.ОрганизацияБухгалтерия);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// ФизЛицо → ИСХОДНОЕ подразделение удержаний з дочірнього ПРОВЕДЕНОГО ОЗФУ (УдержаннаяЗарплата,
// підрозділ по max-Σ). У УдержанияБухгалтерия (вхід zup_1) підрозділ пустий; ОЗФУ його проставляє
// (МапПодразПоФЛ) і постить ПАП «Прочие пассивы» там → беремо те саме для net-zero переносу (Fix 2).
Функция _ПНМП_ПостроитьПодрУдержанийПоФЛ()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Осн", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	У.ФизическоеЛицо КАК ФЛ,
	|	У.ПодразделениеПредприятия КАК Подр,
	|	СУММА(У.Сумма) КАК Сумма
	|ИЗ Документ.ОтражениеЗарплатыВФинансовомУчете.УдержаннаяЗарплата КАК У
	|ГДЕ У.Ссылка.А_ДокОтражениеЗПпоКазне = &Осн
	|	И У.Ссылка.Проведен
	|	И У.ПодразделениеПредприятия <> ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО У.ФизическоеЛицо, У.ПодразделениеПредприятия
	|УПОРЯДОЧИТЬ ПО Сумма УБЫВ";
	Рез = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Рез[Выборка.ФЛ] = Неопределено Тогда
			Рез.Вставить(Выборка.ФЛ, Выборка.Подр);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Додає рядок до ТЧ ПНМП. Перенос ЛИШЕ якщо ОргБух заповнено, є цільовий підрозділ і він ≠ вихідного.
Процедура _ПНМП_ДобавитьСтроку(ТЧ, ФЛ, Сотрудник, ОргБух, ИсхПодр, Сумма, ДопПоля)
	Если Сумма = 0 ИЛИ НЕ ЗначениеЗаполнено(ФЛ) ИЛИ НЕ ЗначениеЗаполнено(ОргБух) ИЛИ НЕ ЗначениеЗаполнено(ИсхПодр) Тогда
		Возврат;
	КонецЕсли;
	ЦелПодр = ОргБух.А_ПодразделениеЗарплатаБух;
	Если НЕ ЗначениеЗаполнено(ЦелПодр) ИЛИ ЦелПодр = ИсхПодр Тогда
		Возврат;
	КонецЕсли;
	Стр = ТЧ.Добавить();
	Стр.ФизическоеЛицо        = ФЛ;
	Стр.Сотрудник             = Сотрудник;
	Стр.ОрганизацияБухгалтерия = ОргБух;
	Стр.ИсходноеПодразделение = ИсхПодр;
	Стр.ЦелевоеПодразделение  = ЦелПодр;
	Стр.ФормаPL               = Перечисления.А_ФормыPL.Форма1;
	Стр.Сумма                 = Сумма;
	Стр.ПериодВзаиморасчетов  = НачалоМесяца(Дата);
	Стр.ДокОснованиеСтроки    = Ссылка;
	Стр.ИдентификаторСтроки   = Строка(Новый УникальныйИдентификатор());
	Для Каждого КЗ Из ДопПоля Цикл
		Стр[КЗ.Ключ] = КЗ.Значение;
	КонецЦикла;
КонецПроцедуры

// Корінь дерева СтруктураПредприятия: підйом по .Родитель до верхнього рівня.
Функция _ПНМП_КореньСтрП(СтрП)
	Тек = СтрП;
	Пока ЗначениеЗаполнено(Тек) И ЗначениеЗаполнено(Тек.Родитель) Цикл
		Тек = Тек.Родитель;
	КонецЦикла;
	Возврат Тек;
КонецФункции

// Фоллбек: корінь (Родитель порожній) за точним найменуванням.
Функция _ПНМП_КореньПоИмени(Имя)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1 СП.Ссылка КАК Ссылка
	|ИЗ Справочник.СтруктураПредприятия КАК СП
	|ГДЕ СП.Наименование = &Имя
	|	И СП.Родитель = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)";
	Рез = Запрос.Выполнить();
	Если Рез.Пустой() Тогда
		Возврат Справочники.СтруктураПредприятия.ПустаяСсылка();
	КонецЕсли;
	Выборка = Рез.Выбрать(); Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

// ТЧ Начисления (Форма2) ← «Зарплата управл» Ф2 (take-home NET управлінської частини) напряму з
// НачисленнаяЗарплатаИВзносыПоФизлицам. Ціль = корінь дерева підрозділу нарахування (управлінська
// ЗП «спливає» на верхній рівень). ФормаPL = Форма2. Податків/утримань Ф2 не має — лише начислення.
Процедура _ПНМП_ЗаполнитьНачисленияФорма2(Док, СотрудникПоФЛ)
	Ф2 = Перечисления.А_ФормыPL.Форма2;
	Для Каждого Стр Из НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		Если Стр.ФормаPL <> Ф2 ИЛИ Стр.Сумма = 0 ИЛИ Стр.ВзносыВсего <> 0 Тогда Продолжить; КонецЕсли;
		Способ = Стр.СпособОтраженияЗарплатыВБухучете;
		Если ЗначениеЗаполнено(Способ) И Способ.А_ЭтоУдержание Тогда Продолжить; КонецЕсли;
		ОргБух = ?(ЗначениеЗаполнено(Стр.ОрганизацияБухгалтерия), Стр.ОрганизацияБухгалтерия, Организация);
		_ПНМП_ДобавитьСтрокуКорень(Док.Начисления, Стр.ФизическоеЛицо,
			СотрудникПоФЛ[Стр.ФизическоеЛицо], ОргБух, Стр.ПодразделениеПредприятия, Стр.Сумма);
	КонецЦикла;
КонецПроцедуры

// Додає рядок Начисления з ЦІЛЬОВИМ = корінь дерева підрозділу нарахування. ФормаPL = Форма2.
// Перенос пропускається, якщо корінь не знайдено або корінь = вихідному (no-op).
Процедура _ПНМП_ДобавитьСтрокуКорень(ТЧ, ФЛ, Сотрудник, ОргБух, ИсхПодр, Сумма)
	Если Сумма = 0 ИЛИ НЕ ЗначениеЗаполнено(ФЛ) ИЛИ НЕ ЗначениеЗаполнено(ИсхПодр) Тогда
		Возврат;
	КонецЕсли;
	ЦелПодр = _ПНМП_КореньСтрП(ИсхПодр);
	Если НЕ ЗначениеЗаполнено(ЦелПодр) Тогда
		ЦелПодр = _ПНМП_КореньПоИмени("Строительство");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЦелПодр) ИЛИ ЦелПодр = ИсхПодр Тогда
		Возврат;
	КонецЕсли;
	Стр = ТЧ.Добавить();
	Стр.ФизическоеЛицо         = ФЛ;
	Стр.Сотрудник              = Сотрудник;
	Стр.ОрганизацияБухгалтерия = ОргБух;
	Стр.ИсходноеПодразделение  = ИсхПодр;
	Стр.ЦелевоеПодразделение   = ЦелПодр;
	Стр.ФормаPL                = Перечисления.А_ФормыPL.Форма2;
	Стр.Сумма                  = Сумма;
	Стр.ПериодВзаиморасчетов   = НачалоМесяца(Дата);
	Стр.ДокОснованиеСтроки     = Ссылка;
	Стр.ИдентификаторСтроки    = Строка(Новый УникальныйИдентификатор());
КонецПроцедуры

// ТЧ Начисления (Форма1) ← ЗНАКОВЫЕ движения РегистрНакопления.А_ВзаиморасчетыССотрудниками «Оплата труда»
// дочернего ПРОВЕДЁННОГО ОЗФУ per (ФЛ, Подразделение, ОргБух), ФормаPL=Форма1.
// Fix B (зеркало ОЗФУ): передача = точный реверс движений ОЗФУ. Источник уже учитывает НДФЛ, удержания
// (алименты) и gross-up — их вычитает штатный механизм ОЗФУ. Поэтому конечный остаток А_ВзСС на исходном
// подразделении = 0 у каждого ФЛ. (Раньше брали «Зарплата управл» Ф1 из родительской ТЧ напрямую —
// она для не-NET-ФЛ gross-of-НДФЛ и расходилась с ОЗФУ по НДФЛ/удержаниям/ОргБух.)
Процедура _ПНМП_ЗаполнитьНачисления(Док, СотрудникПоФЛ)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Осн", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВзС.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВзС.Подразделение КАК Подразделение,
	|	ВзС.ОрганизацияБухгалтерия КАК ОрганизацияБухгалтерия,
	|	СУММА(ВЫБОР КОГДА ВзС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА ВзС.СуммаВзаиморасчетов ИНАЧЕ -ВзС.СуммаВзаиморасчетов КОНЕЦ) КАК Сумма
	|ИЗ
	|	РегистрНакопления.А_ВзаиморасчетыССотрудниками КАК ВзС
	|ГДЕ
	|	ВЫРАЗИТЬ(ВзС.Регистратор КАК Документ.ОтражениеЗарплатыВФинансовомУчете).А_ДокОтражениеЗПпоКазне = &Осн
	|	И ВзС.ФормаPL = ЗНАЧЕНИЕ(Перечисление.А_ФормыPL.Форма1)
	|СГРУППИРОВАТЬ ПО
	|	ВзС.ФизическоеЛицо, ВзС.Подразделение, ВзС.ОрганизацияБухгалтерия
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР КОГДА ВзС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА ВзС.СуммаВзаиморасчетов ИНАЧЕ -ВзС.СуммаВзаиморасчетов КОНЕЦ) <> 0";
	ПустоеДоп = Новый Структура;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		_ПНМП_ДобавитьСтроку(Док.Начисления, Выборка.ФизическоеЛицо, СотрудникПоФЛ[Выборка.ФизическоеЛицо],
			Выборка.ОрганизацияБухгалтерия, Выборка.Подразделение, Выборка.Сумма, ПустоеДоп);
	КонецЦикла;
КонецПроцедуры

// ТЧ Налоги ← НачисленныйНДФЛ (Ф1, НДФЛ/ВС) + ЕСВ (НачисленнаяЗарплата.ВзносыВсего Ф1).
// ОргБух — per-org із самого рядка-джерела (Правка 1/ПроставитьОргБухВсемФорма1); мапа ОргБухПоФЛ — fallback.
Процедура _ПНМП_ЗаполнитьНалоги(Док, СотрудникПоФЛ, ОргБухПоФЛ)
	Ф1 = Перечисления.А_ФормыPL.Форма1;
	// НДФЛ / ВС — ОргБух per-org із самого рядка НачисленныйНДФЛ (Правка 1), fallback на мапу
	Для Каждого Стр Из НачисленныйНДФЛ Цикл
		Если Стр.ФормаPL <> Ф1 ИЛИ Стр.Сумма = 0 Тогда Продолжить; КонецЕсли;
		ОргБухСтр = ?(ЗначениеЗаполнено(Стр.ОрганизацияБухгалтерия), Стр.ОрганизацияБухгалтерия, ОргБухПоФЛ[Стр.ФизическоеЛицо]);
		Доп = Новый Структура("ТипНалога, КодДохода", Стр.ТипНалога, Стр.КодДохода);
		_ПНМП_ДобавитьСтроку(Док.Налоги, Стр.ФизическоеЛицо, СотрудникПоФЛ[Стр.ФизическоеЛицо],
			ОргБухСтр, Стр.ПодразделениеПредприятия, Стр.Сумма, Доп);
	КонецЦикла;
	// ЕСВ (ВзносыВсего) — ОргБух per-org із рядка НачисленнаяЗарплата (ПроставитьОргБухВсемФорма1), fallback на мапу
	Для Каждого Стр Из НачисленнаяЗарплатаИВзносыПоФизлицам Цикл
		Если Стр.ФормаPL <> Ф1 ИЛИ Стр.ВзносыВсего = 0 Тогда Продолжить; КонецЕсли;
		ОргБухСтр = ?(ЗначениеЗаполнено(Стр.ОрганизацияБухгалтерия), Стр.ОрганизацияБухгалтерия, ОргБухПоФЛ[Стр.ФизическоеЛицо]);
		Доп = Новый Структура("ТипНалога", Перечисления.ТипыНалогов.НачисленныйЕСВ);
		_ПНМП_ДобавитьСтроку(Док.Налоги, Стр.ФизическоеЛицо, СотрудникПоФЛ[Стр.ФизическоеЛицо],
			ОргБухСтр, Стр.ПодразделениеПредприятия, Стр.ВзносыВсего, Доп);
	КонецЦикла;
КонецПроцедуры

// ТЧ Удержания ← УдержанияБухгалтерия (інші утримання, крім НДФЛ/ВС/ЄСВ).
Процедура _ПНМП_ЗаполнитьУдержания(Док, СотрудникПоФЛ, ОргБухПоФЛ, ПодрУдержПоФЛ)
	Для Каждого Стр Из УдержанияБухгалтерия Цикл
		Если Стр.Сумма = 0 Тогда Продолжить; КонецЕсли;
		// Підзвітні (УдержаниеНеизрасходованныхПодотчетныхСумм) НЕ переносимо: ОЗФУ вже погасив борг
		// на вихідному підрозділі через РегистрНакопления.ДенежныеСредстваУПодотчетныхЛиц.
		Если Стр.ВидОперации = Перечисления.ВидыОперацийПоЗарплате.УдержаниеНеизрасходованныхПодотчетныхСумм Тогда
			Продолжить;
		КонецЕсли;
		// УдержанияБухгалтерия (вхід zup_1) НЕ має підрозділу → беремо те саме, що ОЗФУ проставив
		// у УдержаннаяЗарплата (Fix 2: дочірній ОЗФУ — net-zero проти ПАП «Прочие пассивы»).
		ИсхПодр = ?(ЗначениеЗаполнено(Стр.ПодразделениеПредприятия), Стр.ПодразделениеПредприятия,
			ПодрУдержПоФЛ[Стр.ФизическоеЛицо]);
		// Статья/аналитика ПАП — зі строки-джерела (підзвітні → «Денежные средства (у подотчетных лиц)»,
		// аліменти → «Прочие пассивы»); ПередачаНач проводить за ними.
		Доп = Новый Структура("СтатьяАктивовПассивов, АналитикаАктивовПассивов",
			Стр.СтатьяАктивовПассивов, Стр.АналитикаАктивовПассивов);
		_ПНМП_ДобавитьСтроку(Док.Удержания, Стр.ФизическоеЛицо, СотрудникПоФЛ[Стр.ФизическоеЛицо],
			ОргБухПоФЛ[Стр.ФизическоеЛицо], ИсхПодр, Стр.Сумма, Доп);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область ЕРП_СоздатьДвиженияДДС

// Заполняет ТЧ А_ДвижениеДДС документов-распределений (А_РаспределениеЗаработнойПлаты / РаспределениеФ2)
// из РаспределениеКазна и проводит их → движения РегистрНакопления.А_ДвиженияДенегДоходыРасходы.
// Группировка по (ДокРаспределениеЗП, Подразделение, Статья). Идемпотентно.
// Полное зеркало БДДС Казны: перепроводятся ВСЕ документы-распределения, включая
// заблокированные Ф2 (А_Необновлять=Истина) — решение пользователя 2026-06-03.
Процедура СоздатьДвиженияДДСПоОтражениюЗП() Экспорт

	Если НЕ Проведен Тогда
		Сообщить("А_ОтражениеЗПпоКазне не проведено — движения ДДС не создаются.");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Осн", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РК.ДокРаспределениеЗП КАК Док,
	|	РК.Подразделение КАК Подразделение,
	|	РК.СтатьяДвиженияДенежныхСредств КАК Статья,
	|	СУММА(РК.Сумма) КАК Сумма,
	|	РК.Сотрудник КАК Сотрудник
	|ИЗ
	|	Документ.А_ОтражениеЗПпоКазне.РаспределениеКазна КАК РК
	|ГДЕ
	|	РК.Ссылка = &Осн
	|	И РК.ДокРаспределениеЗП <> НЕОПРЕДЕЛЕНО
	|	И РК.Сумма <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	РК.ДокРаспределениеЗП,
	|	РК.Подразделение,
	|	РК.СтатьяДвиженияДенежныхСредств,
	|	РК.Сотрудник";
	Выборка = Запрос.Выполнить().Выбрать();

	// Группируем строки по документу-распределению
	ПоДокументу = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Док) Тогда
			Продолжить;
		КонецЕсли;
		Список = ПоДокументу[Выборка.Док];
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоДокументу.Вставить(Выборка.Док, Список);
		КонецЕсли;
		Список.Добавить(Новый Структура("Сотрудник,Подразделение, Статья, Сумма",
			Выборка.Сотрудник,Выборка.Подразделение, Выборка.Статья, Выборка.Сумма));
	КонецЦикла;

	КолОбработано = 0;
	КолОшибок     = 0;
	Для Каждого КЗ Из ПоДокументу Цикл
		ДокСсылка = КЗ.Ключ;
		ДокОбъект = ДокСсылка.ПолучитьОбъект();
		Если ДокОбъект.Проведен Тогда
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			ДокОбъект = ДокСсылка.ПолучитьОбъект();
		КонецЕсли;
		ДокОбъект.А_ДвижениеДДС.Очистить();
		Для Каждого СтрД Из КЗ.Значение Цикл
			Если СтрД.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ДокОбъект.А_ДвижениеДДС.Добавить();
			НоваяСтрока.Подразделение                 = СтрД.Подразделение;
			НоваяСтрока.СтатьяДвиженияДенежныхСредств = СтрД.Статья;  
			НоваяСтрока.Сотрудник                     = СтрД.Сотрудник;
			НоваяСтрока.Сумма                         = СтрД.Сумма;
		КонецЦикла;
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Если ДокОбъект.Проведен Тогда
				КолОбработано = КолОбработано + 1;
			Иначе
				КолОшибок = КолОшибок + 1;
				Сообщить("НЕ проведён (запись понижена до Запись): " + Строка(ДокСсылка));
			КонецЕсли;
		Исключение
			КолОшибок = КолОшибок + 1;
			Сообщить("Ошибка проведения " + Строка(ДокСсылка) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Сообщить("Движения ДДС: проведено документов-распределений " + КолОбработано
		+ ", ошибок " + КолОшибок);

КонецПроцедуры

#КонецОбласти
