&НаСервере
Процедура ЗаполнитьВсеНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");

	Попытка
		// 1. Заповнення всіх ТЧ із джерел даних
		ДокументОбъект.ЗаполнитьНачисленияУпризЗуп2();
		ДокументОбъект.ЗагрузитьНалогиИУдержанияИзЗарплатыБух();
		ДокументОбъект.ЗаполнитьОтражениеЗарплатыВФинансовомУчетеИзБазЗП();
		ДокументОбъект.ЗаполнитьДляОтражения_ДокументОтражениеЗарплатыВФинансовомУчете();

		// 2. КРИТИЧНО: записати і провести батьківський документ ПЕРЕД створенням підлеглого НачислениеЗарплаты.
		// Інакше СоздатьДокументНачисления() видасть "А_ОтражениеЗПпоКазне не проведений — НачислениеЗарплаты не створюється"
		// (це Guard на початку процедури — підлеглий має створюватись тільки на основі проведеного батька).
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

		// 3. Створити/оновити підлеглий Документ.НачислениеЗарплаты
		ДокументОбъект.СоздатьДокументНачисления();  
		ДокументОбъект.СоздатьДокументОтражениеЗарплатыВФинансовомУчете();

	Исключение
		Сообщить("Ошибка заполнения из всех: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");

КонецПроцедуры

