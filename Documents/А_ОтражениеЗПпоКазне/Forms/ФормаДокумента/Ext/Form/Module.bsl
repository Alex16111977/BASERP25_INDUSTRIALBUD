&НаСервере
Процедура СоздатьВедомостиВКассуНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");

	Попытка
		ДокументОбъект.СоздатьВедомостиВКассуПоОтражениюЗП();
