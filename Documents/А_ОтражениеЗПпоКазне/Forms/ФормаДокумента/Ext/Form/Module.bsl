		Сообщить("Ошибка заполнения из ЗП: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	Модифицированность = Истина;

КонецПроцедуры

