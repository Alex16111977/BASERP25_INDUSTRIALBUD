#Область ЕРП_ПроцедурыИФункции

// Заполняет начисления из баз ЗУП (zup_2 — управленческая, zup_1 — регламентная)
// и переносит в основные ТЧ документа.
// Фаза 1: zup_2 → А_Начисления + А_Удержания
// Фаза 2: zup_1 → А_НачисленияБух
// Фаза 3: Перенос в Начисления, Удержания, ФизическиеЛица
Процедура ЗаполнитьНачисленияИзБазЗП() Экспорт

	// =========================================================================
	// ПОДГОТОВКА: Кеш ФизЛиц по КодПоДРФО (один запрос — быстро!)
	// =========================================================================
	СоответствиеФизЛиц = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизическиеЛица.Ссылка КАК Ссылка,
	|	ФизическиеЛица.КодПоДРФО КАК КодПоДРФО
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.КодПоДРФО <> """"";

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	Пока Выборка.Следующий() Цикл
		КодДРФО = СокрЛП(Выборка.КодПоДРФО);
		Если ЗначениеЗаполнено(КодДРФО) Тогда
			СоответствиеФизЛиц.Вставить(КодДРФО, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	НачалоПериода = НачалоМесяца(Дата);
	КонецПериода = КонецМесяца(Дата);

	// =========================================================================
	// ФАЗА 1: Загрузка из zup_2 (управленческая ЗП)
	// =========================================================================
	А_Начисления.Очистить();
	А_Удержания.Очистить();

	Попытка

		СоединениеЗУП2 = А_ПодключенияБазСервер.УстановитьСоединение("zup_2");

		// Запрос начислений из ВСЕХ документов НачислениеЗарплатыРаботникам за месяц
		ТекстЗапросаНачисления =
		"ВЫБРАТЬ
		|	Начисления.Физлицо.КодПоДРФО КАК КодПоДРФО,
		|	Начисления.ВидРасчета.Наименование КАК ВидРасчета,
		|	Начисления.ВидРасчета.Код КАК КодВидРасчета,
		|	Начисления.Результат КАК Сумма
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам.Начисления КАК Начисления
		|ГДЕ
		|	Начисления.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Начисления.Ссылка.Проведен = ИСТИНА
		|	И Начисления.Результат <> 0";

		ЗапросНач = СоединениеЗУП2.NewObject("Запрос");
		ЗапросНач.Текст = ТекстЗапросаНачисления;
		ЗапросНач.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросНач.УстановитьПараметр("КонецПериода", КонецПериода);

		РезНач = ЗапросНач.Выполнить();
		ВыборкаНач = РезНач.Выбрать();

		// Итерируем COM-результат НАПРЯМУЮ (без сериализации — в zup_2 ссылочные типы!)
		Пока ВыборкаНач.Следующий() Цикл
			КодДРФО = СокрЛП(ВыборкаНач.КодПоДРФО);
			ФизЛицо = СоответствиеФизЛиц[КодДРФО];

			Если ФизЛицо = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтрока = А_Начисления.Добавить();
			НоваяСтрока.ФизЛицо = ФизЛицо;
			НоваяСтрока.Сумма = ВыборкаНач.Сумма;
			НоваяСтрока.ВидРасчета = СокрЛП(ВыборкаНач.ВидРасчета);
			НоваяСтрока.КодВидРасчета = СокрЛП(ВыборкаНач.КодВидРасчета);
		КонецЦикла;

		// Запрос удержаний из ВСЕХ документов за месяц
		ТекстЗапросаУдержания =
		"ВЫБРАТЬ
		|	Удержания.Физлицо.КодПоДРФО КАК КодПоДРФО,
		|	Удержания.ВидРасчета.Наименование КАК ВидРасчета,
		|	Удержания.ВидРасчета.Код КАК КодВидРасчета,
		|	Удержания.Результат КАК Сумма
		|ИЗ
		|	Документ.НачислениеЗарплатыРаботникам.Удержания КАК Удержания
		|ГДЕ
		|	Удержания.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
		|	И Удержания.Ссылка.Проведен = ИСТИНА
		|	И Удержания.Результат <> 0";

		ЗапросУд = СоединениеЗУП2.NewObject("Запрос");
		ЗапросУд.Текст = ТекстЗапросаУдержания;
		ЗапросУд.УстановитьПараметр("НачалоПериода", НачалоПериода);
		ЗапросУд.УстановитьПараметр("КонецПериода", КонецПериода);

		РезУд = ЗапросУд.Выполнить();
		ВыборкаУд = РезУд.Выбрать();

		Пока ВыборкаУд.Следующий() Цикл
			КодДРФО = СокрЛП(ВыборкаУд.КодПоДРФО);
			ФизЛицо = СоответствиеФизЛиц[КодДРФО];

			Если ФизЛицо = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтрока = А_Удержания.Добавить();
			НоваяСтрока.ФизЛицо = ФизЛицо;
			НоваяСтрока.Сумма = ВыборкаУд.Сумма;
			НоваяСтрока.ВидРасчета = СокрЛП(ВыборкаУд.ВидРасчета);
			НоваяСтрока.КодВидРасчета = СокрЛП(ВыборкаУд.КодВидРасчета);
		КонецЦикла;

		СоединениеЗУП2 = Неопределено;
		Connector = Неопределено;

		// Фаза 1 завершена

	Исключение
		СоединениеЗУП2 = Неопределено;
		Connector = Неопределено;
		// Ошибка zup_2 — продолжаем с zup_1
	КонецПопытки;

	// =========================================================================
	// ФАЗА 2: Загрузка из zup_1 (регламентная ЗП) → А_НачисленияБух
	// =========================================================================
	А_НачисленияБух.Очистить();

	Попытка

		// Получаем организации в балансе
		ЗапросОрг = Новый Запрос;
		ЗапросОрг.Текст =
		"ВЫБРАТЬ
		|	Организации.КодПоЕДРПОУ КАК КодПоЕДРПОУ
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.А_ВБалансе = ИСТИНА
		|	И Организации.КодПоЕДРПОУ <> """"";

		масКодПоЕДРПОУ = Новый Массив;
		ВыборкаОрг = ЗапросОрг.Выполнить().Выбрать();
		Пока ВыборкаОрг.Следующий() Цикл
			масКодПоЕДРПОУ.Добавить(ВыборкаОрг.КодПоЕДРПОУ);
		КонецЦикла;

		Если масКодПоЕДРПОУ.Количество() = 0 Тогда
			// Нет организаций в балансе
		Иначе

			V83 = А_ПодключенияБазСервер.УстановитьСоединение("zup_1");

			// Передаём массив кодов ЕДРПОУ в контекст ЗУП
			масКодов_V83 = V83.NewObject("Массив");
			Для Каждого КодЕДРПОУ Из масКодПоЕДРПОУ Цикл
				масКодов_V83.Добавить(КодЕДРПОУ);
			КонецЦикла;

			// Запрос к РегистрРасчета с JOIN на КодыОрганизации
			// ВАЖНО: Используем МЕЖДУ для периода (НАЧАЛОПЕРИОДА через COM ненадёжно)
			ТекстЗапросаБух =
			"ВЫБРАТЬ
			|	Начисления.Сотрудник.Физлицо.КодПоДРФО КАК СотрудникИНН,
			|	СУММА(Начисления.Результат) КАК СуммаНачислено,
			|	Начисления.Сотрудник.Физлицо.Наименование КАК СотрудникНаименование,
			|	ВложенныйЗапрос.КодПоЕДРПОУ КАК КодОрганизации
			|ИЗ
			|	РегистрРасчета.ОсновныеНачисленияРаботниковОрганизаций КАК Начисления
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			КодыОрганизацииСрезПоследних.Организация КАК Организация,
			|			КодыОрганизацииСрезПоследних.КодПоЕДРПОУ КАК КодПоЕДРПОУ
			|		ИЗ
			|			РегистрСведений.КодыОрганизации.СрезПоследних КАК КодыОрганизацииСрезПоследних) КАК ВложенныйЗапрос
			|		ПО Начисления.Организация = ВложенныйЗапрос.Организация
			|ГДЕ
			|	Начисления.ПериодРегистрации МЕЖДУ &НачалоПериода И &КонецПериода
			|	И Начисления.ВидРасчета.Код <> ""00021""
			|	И Начисления.Результат <> 0
			|	И ВложенныйЗапрос.КодПоЕДРПОУ В(&масКодПоЕДРПОУ)
			|СГРУППИРОВАТЬ ПО
			|	Начисления.Сотрудник.Физлицо.КодПоДРФО,
			|	Начисления.Сотрудник.Физлицо.Наименование,
			|	ВложенныйЗапрос.КодПоЕДРПОУ";

			ЗапросБух = V83.NewObject("Запрос");
			ЗапросБух.Текст = ТекстЗапросаБух;
			ЗапросБух.УстановитьПараметр("НачалоПериода", НачалоПериода);
			ЗапросБух.УстановитьПараметр("КонецПериода", КонецПериода);
			ЗапросБух.УстановитьПараметр("масКодПоЕДРПОУ", масКодов_V83);

			РезультатБух = ЗапросБух.Выполнить();
			// Сериализация ОК для zup_1 (примитивные типы в результате группировки)
			ТЗДанные = РезультатБух.Выгрузить();
			стр_ТЗ = V83.ЗначениеВСтрокуВнутр(ТЗДанные);

			V83 = Неопределено;
			Connector1 = Неопределено;

			// Десериализация в контексте ERP
			ТаблицаБух = ЗначениеИзСтрокиВнутр(стр_ТЗ);

			// Кеш организаций по КодПоЕДРПОУ
			СоответствиеОрг = Новый Соответствие;

			Для Каждого СтрокаТЗ Из ТаблицаБух Цикл

				ИННСотрудника = СокрЛП(СтрокаТЗ.СотрудникИНН);

				Если ПустаяСтрока(ИННСотрудника) Тогда
					Продолжить;
				КонецЕсли;

				ФизЛицо = СоответствиеФизЛиц[ИННСотрудника];

				Если ФизЛицо = Неопределено Тогда
					Продолжить;
				КонецЕсли;

				// Поиск организации по ЕДРПОУ (с кешем)
				КодОрг = СокрЛП(СтрокаТЗ.КодОрганизации);
				ОргСсылка = СоответствиеОрг[КодОрг];
				Если ОргСсылка = Неопределено Тогда
					ОргСсылка = Справочники.Организации.НайтиПоРеквизиту("КодПоЕДРПОУ", КодОрг);
					СоответствиеОрг.Вставить(КодОрг, ОргСсылка);
				КонецЕсли;

				НоваяСтрока = А_НачисленияБух.Добавить();
				НоваяСтрока.ФизЛицо = ФизЛицо;
				НоваяСтрока.Сумма = СтрокаТЗ.СуммаНачислено;
				НоваяСтрока.ВидРасчета = "Оклад по днях";
				НоваяСтрока.КодВидРасчета = "00001";
				НоваяСтрока.Организация = ОргСсылка;

			КонецЦикла;

			// Фаза 2 завершена

		КонецЕсли;

	Исключение
		V83 = Неопределено;
		Connector1 = Неопределено;
		// Ошибка zup_1 — продолжаем с фазой 3
	КонецПопытки;

	// =========================================================================
	// ФАЗА 3: Перенос в основные ТЧ (Начисления, Удержания, ФизическиеЛица)
	// =========================================================================

	// ВАЖНО: Устанавливаем флаг ДО преобразования — чтобы ПередЗаписью не перезаписал
	А_Обработан = Истина;

	// Установка шапки
	Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	МесяцНачисления = НачалоМесяца(Дата);
	Попытка
		ПорядокВыплаты = Перечисления.ХарактерВыплатыЗарплаты.Зарплата;
	Исключение
		// В ExternalConnection перечисления могут быть недоступны
	КонецПопытки;

	// Очистка основных ТЧ
	Начисления.Очистить();
	Удержания.Очистить();
	ФизическиеЛица.Очистить();

	ТЗ_ФизическиеЛица = ФизическиеЛица.Выгрузить();
	ДатаНачала = НачалоМесяца(Дата);
	ДатаОкончания = КонецМесяца(Дата);

	КолНачислений = 0;
	КолНачисленийБух = 0;
	КолУдержаний = 0;

	// --- ЭТАП 1: Кеш валидных Сотрудников (ФизЛицо → Сотрудник) ---
	// Запрос гарантирует что ссылки валидные (из таблицы БД, не битые)
	СоответствиеСотрудников = Новый Соответствие;
	ЗапросСотр = Новый Запрос;
	ЗапросСотр.Текст =
	"ВЫБРАТЬ
	|	Сотрудники.ФизическоеЛицо КАК ФизЛицо,
	|	Сотрудники.Ссылка КАК Сотрудник
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления";

	ВыборкаСотр = ЗапросСотр.Выполнить().Выбрать();
	Пока ВыборкаСотр.Следующий() Цикл
		СоответствиеСотрудников.Вставить(ВыборкаСотр.ФизЛицо, ВыборкаСотр.Сотрудник);
	КонецЦикла;

	// Набор ФизЛиц из А_Начисления (для исключения дублей в gap-fill)
	ФизЛицаИзАНачисления = Новый Соответствие;
	Для Каждого СтрокаИсточник Из А_Начисления Цикл
		ФизЛицаИзАНачисления.Вставить(СтрокаИсточник.ФизЛицо, Истина);
	КонецЦикла;

	// --- ЭТАП 2: А_Начисления → Начисления ---
	Для Каждого СтрокаИсточник Из А_Начисления Цикл

		Сотрудник = СоответствиеСотрудников[СтрокаИсточник.ФизЛицо];
		Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
			// Нет валидного сотрудника — создаём
			Сотрудник = А_Привилегированный.СоздатьСотрудникаИзФизическогоЛица(СтрокаИсточник.ФизЛицо);
			Если ЗначениеЗаполнено(Сотрудник) И Сотрудник.ПолучитьОбъект() <> Неопределено Тогда
				СоответствиеСотрудников.Вставить(СтрокаИсточник.ФизЛицо, Сотрудник);
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Начисление = А_Привилегированный.А_НайтиВидРасчетаПоКоду(СтрокаИсточник.КодВидРасчета, Истина);
		Если НЕ ЗначениеЗаполнено(Начисление) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаНачисления = Начисления.Добавить();
		СтрокаНачисления.Сотрудник = Сотрудник;
		СтрокаНачисления.Результат = СтрокаИсточник.Сумма;
		СтрокаНачисления.Начисление = Начисление;
		СтрокаНачисления.ДатаНачала = ДатаНачала;
		СтрокаНачисления.ДатаОкончания = ДатаОкончания;

		КолНачислений = КолНачислений + 1;

		СтрокаФизЛица = ТЗ_ФизическиеЛица.Добавить();
		СтрокаФизЛица.ФизическоеЛицо = СтрокаИсточник.ФизЛицо;
	КонецЦикла;

	// --- ЭТАП 3: А_НачисленияБух → Начисления (ТОЛЬКО ФизЛица которых НЕТ в А_Начисления) ---
	СуммыИзБух = Новый Соответствие;

	Для Каждого СтрокаБух Из А_НачисленияБух Цикл
		Если ФизЛицаИзАНачисления[СтрокаБух.ФизЛицо] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДанныеФизЛица = СуммыИзБух[СтрокаБух.ФизЛицо];
		Если ДанныеФизЛица = Неопределено Тогда
			ДанныеФизЛица = Новый Структура("Сумма, КодВидРасчета, ВидРасчета");
			ДанныеФизЛица.Сумма = СтрокаБух.Сумма;
			ДанныеФизЛица.КодВидРасчета = СтрокаБух.КодВидРасчета;
			ДанныеФизЛица.ВидРасчета = СтрокаБух.ВидРасчета;
			СуммыИзБух.Вставить(СтрокаБух.ФизЛицо, ДанныеФизЛица);
		Иначе
			ДанныеФизЛица.Сумма = ДанныеФизЛица.Сумма + СтрокаБух.Сумма;
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючЗначение Из СуммыИзБух Цикл
		ФизЛицоБух = КлючЗначение.Ключ;
		ДанныеФизЛица = КлючЗначение.Значение;

		Сотрудник = СоответствиеСотрудников[ФизЛицоБух];
		Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
			Сотрудник = А_Привилегированный.СоздатьСотрудникаИзФизическогоЛица(ФизЛицоБух);
			Если ЗначениеЗаполнено(Сотрудник) И Сотрудник.ПолучитьОбъект() <> Неопределено Тогда
				СоответствиеСотрудников.Вставить(ФизЛицоБух, Сотрудник);
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Начисление = А_Привилегированный.А_НайтиВидРасчетаПоКоду(ДанныеФизЛица.КодВидРасчета, Истина);
		Если НЕ ЗначениеЗаполнено(Начисление) Тогда
			Продолжить;
		КонецЕсли;

		СтрокаНачисления = Начисления.Добавить();
		СтрокаНачисления.Сотрудник = Сотрудник;
		СтрокаНачисления.Результат = ДанныеФизЛица.Сумма;
		СтрокаНачисления.Начисление = Начисление;
		СтрокаНачисления.ДатаНачала = ДатаНачала;
		СтрокаНачисления.ДатаОкончания = ДатаОкончания;

		КолНачисленийБух = КолНачисленийБух + 1;

		СтрокаФизЛица = ТЗ_ФизическиеЛица.Добавить();
		СтрокаФизЛица.ФизическоеЛицо = ФизЛицоБух;
	КонецЦикла;

	// --- ЭТАП 4: А_Удержания → Удержания ---
	// Собираем ФизЛиц из Начислений (для проверки наличия)
	ФизЛицаВНачислениях = Новый Соответствие;
	Для Каждого СтрокаН Из Начисления Цикл
		Если ЗначениеЗаполнено(СтрокаН.Сотрудник) Тогда
			ФизЛицаВНачислениях.Вставить(СтрокаН.Сотрудник.ФизическоеЛицо, СтрокаН.Сотрудник);
		КонецЕсли;
	КонецЦикла;

	Для Каждого СтрокаИсточник Из А_Удержания Цикл

		Удержание = А_Привилегированный.А_НайтиВидРасчетаПоКоду(СтрокаИсточник.КодВидРасчета, Ложь);
		Если НЕ ЗначениеЗаполнено(Удержание) Тогда
			Продолжить;
		КонецЕсли;

		// Если ФизЛицо нет в Начислениях — добавляем строку с Результат=0
		// (иначе проведение упадёт: "Сотрудник не может быть пустым" в ВзаиморасчетыССотрудниками)
		Если ФизЛицаВНачислениях[СтрокаИсточник.ФизЛицо] = Неопределено Тогда
			Сотрудник = СоответствиеСотрудников[СтрокаИсточник.ФизЛицо];
			Если НЕ ЗначениеЗаполнено(Сотрудник) Тогда
				Сотрудник = А_Привилегированный.СоздатьСотрудникаИзФизическогоЛица(СтрокаИсточник.ФизЛицо);
			КонецЕсли;
			Если ЗначениеЗаполнено(Сотрудник) Тогда
				НачислениеПоУмолчанию = А_Привилегированный.А_НайтиВидРасчетаПоКоду("00001", Истина);
				СтрокаДоп = Начисления.Добавить();
				СтрокаДоп.Сотрудник = Сотрудник;
				СтрокаДоп.Результат = 0;
				СтрокаДоп.Начисление = НачислениеПоУмолчанию;
				СтрокаДоп.ДатаНачала = ДатаНачала;
				СтрокаДоп.ДатаОкончания = ДатаОкончания;
				ФизЛицаВНачислениях.Вставить(СтрокаИсточник.ФизЛицо, Сотрудник);
			КонецЕсли;
		КонецЕсли;

