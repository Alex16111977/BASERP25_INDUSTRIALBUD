Процедура ОбновитьПриходДенегОтФинАгентаПослеОбмена() Экспорт

	Если А_Обработан Тогда

		Возврат;

	КонецЕсли;


	ПодразделениеШапка = А_Привилегированный.А_ПолучитьПодразделениеПоНаправлениюИПодразделениюКазны(А_НаправлениеДеятельности,А_Подразделение);
	СтатьяДвиженияДенежныхСредств = Справочники.СтатьиДвиженияДенежныхСредств.НайтиПоКоду("УТ-001082");   //Поступление от Фин агента
   	СтатьяЗатратКомиссия = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоКоду("100000032");// РКО_Плата за розрахунково-касове обслуговування й інші послуги банків
    НоменклатураЗатрат = Справочники.Номенклатура.НайтиПоКоду("00-00000326");  //Юридичні послуги
    Подразделение = ПодразделениеШапка;
	
	РасшифровкаПлатежа.Очистить();


    А_НеСовпадаетПодразделение = Ложь;
	СуммаДокумента = А_РасшифровкаФинАгент.Итог("Сумма")+А_РасшифровкаФинАгент.Итог("СуммаКомиссииФА");
	СуммаКомиссииФА = А_РасшифровкаФинАгент.Итог("СуммаКомиссииФА");
	Для каждого СтрокаТЗ Из А_РасшифровкаФинАгент Цикл
		А_ПроцентФинАгентаПлатежка = СтрокаТЗ.ДокументПередачи.А_ПроцентФинАгента;
		СуммаФинАгентСтрока =  СтрокаТЗ.Сумма+ СтрокаТЗ.СуммаКомиссииФА;
		СуммаКомиссииСтрока =  СтрокаТЗ.СуммаКомиссииФА;
		Для каждого СтрокаПлатежки Из СтрокаТЗ.ДокументПередачи.РасшифровкаПлатежа Цикл

			Если СуммаФинАгентСтрока=0 Тогда
				Прервать;
			КонецЕсли;

			Контрагент = СтрокаТЗ.ДокументПередачи.Контрагент;

			СуммаКСписанию = Мин(СуммаФинАгентСтрока,СтрокаПлатежки.Сумма);
			СуммаФинАгентСтрока = СуммаФинАгентСтрока - СуммаКСписанию;

			СуммаКомиссии = Окр(А_ПроцентФинАгентаПлатежка*СуммаКСписанию/100,2);

			СуммаКСписаниюКомиссии = Мин(СуммаКомиссииСтрока,СуммаКомиссии);
			СуммаКомиссииСтрока = СуммаКомиссииСтрока - СуммаКСписаниюКомиссии;

			СтрокаРасшифровкаПлатежа = РасшифровкаПлатежа.Добавить();
			СтрокаРасшифровкаПлатежа.Контрагент = Контрагент;
			СтрокаРасшифровкаПлатежа.Сумма = СуммаКСписанию;
			СтрокаРасшифровкаПлатежа.СуммаКомиссии = СуммаКСписаниюКомиссии;
			СтрокаРасшифровкаПлатежа.ДокСписаниеБезналичныхДенежныхСредств = СтрокаТЗ.ДокументПередачи;
			СтрокаРасшифровкаПлатежа.А_ПроцентФинАгента = СтрокаТЗ.ДокументПередачи.А_ПроцентФинАгента;
			СтрокаРасшифровкаПлатежа.ОбъектРасчетов = СтрокаПлатежки.ОбъектРасчетов;
            СтрокаРасшифровкаПлатежа.Подразделение  = СтрокаТЗ.ДокументПередачи.Подразделение;
			Если СтрокаРасшифровкаПлатежа.Подразделение <> Подразделение Тогда
			
				А_НеСовпадаетПодразделение = Истина;
			
			КонецЕсли;
		КонецЦикла;

		Если СуммаФинАгентСтрока>0 И РасшифровкаПлатежа.Количество()>0 Тогда

			СтрокаРасшифровкаПлатежа.Сумма = СтрокаРасшифровкаПлатежа.Сумма + СуммаФинАгентСтрока;
			СтрокаРасшифровкаПлатежа.СуммаКомиссии = СтрокаРасшифровкаПлатежа.СуммаКомиссии + СуммаКомиссииСтрока;
		КонецЕсли;


	КонецЦикла;




	А_Обработан = Истина;

КонецПроцедуры
//***ERP

// ==============================================================================
// Вспомогательные процедуры для СоздатьПриходДенегПоФинАгенту
