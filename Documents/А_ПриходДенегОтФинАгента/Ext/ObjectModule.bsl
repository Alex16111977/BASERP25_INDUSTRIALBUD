Процедура ЗаполнитьПКО(ДокОбъект, ДатаДокумента, Организация, Касса, Валюта,
		СтрКонтрагент, СтрПартнер, СтрСумма, СтатьяДДС, ПодразделениеДок,
		НаправлениеДеятельности, ДокОснование, СтрНомерСтроки,
		СтрПроцентФинАгента, СтрСуммаКомиссии, СтрОбъектРасчетов)

	ДокОбъект.Дата                           = ДатаДокумента+1;
	ДокОбъект.Организация                    = Организация;
	ДокОбъект.ХозяйственнаяОперация          = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствОтПоставщика;
	ДокОбъект.А_ОбработанКазна               = Истина;
	ДокОбъект.Касса                           = Касса;
	ДокОбъект.Контрагент                      = СтрКонтрагент;
	ДокОбъект.Партнер                         = СтрПартнер;
	ДокОбъект.Валюта                          = Валюта;
	ДокОбъект.СуммаДокумента                  = СтрСумма;
	ДокОбъект.СтатьяДвиженияДенежныхСредств   = СтатьяДДС;
	ДокОбъект.Подразделение                   = ПодразделениеДок;
	ДокОбъект.НаправлениеДеятельности         = НаправлениеДеятельности;
	// Связки
	ДокОбъект.А_ПриходДенегОтФинАгента       = ДокОснование;
	ДокОбъект.А_КодСтрокиПриходДенегОтФинАгента = СтрНомерСтроки;
	// Кастомные поля
	ДокОбъект.А_НаправлениеДеятельности       = НаправлениеДеятельности;
	ДокОбъект.А_Подразделение                 = ПодразделениеДок;
	ДокОбъект.А_ПроцентФинАгента              = СтрПроцентФинАгента;
	ДокОбъект.А_СуммаКомиссии                 = СтрСуммаКомиссии;

	// ТЧ РасшифровкаПлатежа
	ДокОбъект.РасшифровкаПлатежа.Очистить();
	СтрокаРП = ДокОбъект.РасшифровкаПлатежа.Добавить();
	СтрокаРП.Партнер                          = СтрПартнер;
	СтрокаРП.Сумма                            = СтрСумма;
	СтрокаРП.СуммаВзаиморасчетов              = СтрСумма;
	СтрокаРП.ВалютаВзаиморасчетов             = Валюта;
	СтрокаРП.СтатьяДвиженияДенежныхСредств    = СтатьяДДС;
	СтрокаРП.Подразделение                    = ПодразделениеДок;
	СтрокаРП.НаправлениеДеятельности          = НаправлениеДеятельности;
	Если ЗначениеЗаполнено(СтрОбъектРасчетов) Тогда
		СтрокаРП.ОбъектРасчетов               = СтрОбъектРасчетов;  
		ДокОбъект.Договор                     = СтрОбъектРасчетов.Договор;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьРКО(ДокОбъект, ДатаДокумента, Организация, Касса, Валюта,
		СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, СтатьяДДС, ПодразделениеДок,
		НаправлениеДеятельности, ДокОснование, СсылкаПКО, СтрОбъектРасчетов)

	ДокОбъект.Дата                           = ДатаДокумента+2;
	ДокОбъект.Организация                    = Организация;
	ДокОбъект.ХозяйственнаяОперация          = Перечисления.ХозяйственныеОперации.ОплатаПоставщику;
	ДокОбъект.А_ОбработанКазна               = Истина;
	ДокОбъект.Касса                           = Касса;
	ДокОбъект.Контрагент                      = СтрКонтрагент;
	ДокОбъект.Партнер                         = СтрПартнер;
	ДокОбъект.Валюта                          = Валюта;
	ДокОбъект.СуммаДокумента                  = СтрСуммаКомиссии;
	ДокОбъект.СтатьяДвиженияДенежныхСредств   = СтатьяДДС;
	ДокОбъект.Подразделение                   = ПодразделениеДок;
	ДокОбъект.НаправлениеДеятельности         = НаправлениеДеятельности;
	// Связки
	ДокОбъект.А_ПриходДенегОтФинАгента       = ДокОснование;
	ДокОбъект.А_ПриходныйКассовыйОрдерОтФинАгента = СсылкаПКО;

	// ТЧ РасшифровкаПлатежа
	ДокОбъект.РасшифровкаПлатежа.Очистить();
	СтрокаРП = ДокОбъект.РасшифровкаПлатежа.Добавить();
	СтрокаРП.Сумма                           = СтрСуммаКомиссии;
	СтрокаРП.СуммаВзаиморасчетов              = СтрСуммаКомиссии;
	СтрокаРП.ВалютаВзаиморасчетов             = Валюта;
	СтрокаРП.СтатьяДвиженияДенежныхСредств    = СтатьяДДС;
	СтрокаРП.Подразделение                    = ПодразделениеДок;
	СтрокаРП.НаправлениеДеятельности          = НаправлениеДеятельности;
	СтрокаРП.Партнер                          = СтрПартнер;
	Если ЗначениеЗаполнено(СтрОбъектРасчетов) Тогда
		СтрокаРП.ОбъектРасчетов              = СтрОбъектРасчетов; 
		ДокОбъект.Договор                    = СтрОбъектРасчетов.Договор;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьПриобретение(ДокОбъект, ДатаДокумента, Организация, Валюта,
		СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, ПодразделениеДок,
		НаправлениеДеятельности, ДокОснование, СсылкаПКО, СтрДоговор,
		НоменклатураЗатратДок, СтатьяЗатратДок, СтрОбъектРасчетов)

	ДокОбъект.Дата                          = ДатаДокумента+3;
	ДокОбъект.Организация                   = Организация;
	ДокОбъект.Контрагент                    = СтрКонтрагент;
	ДокОбъект.Партнер                       = СтрПартнер;
	ДокОбъект.ХозяйственнаяОперация         = Перечисления.ХозяйственныеОперации.ЗакупкаУПоставщика;
	ДокОбъект.А_ВведенВЕРП                  = Истина;
	ДокОбъект.Валюта                        = Валюта;
	ДокОбъект.ВалютаВзаиморасчетов           = Валюта;
	ДокОбъект.СуммаДокумента                = СтрСуммаКомиссии;
	ДокОбъект.Курс                          = 1;
	ДокОбъект.Кратность                     = 1;
	ДокОбъект.ЦенаВключаетНДС               = Истина;
	ДокОбъект.СуммаВзаиморасчетов            = СтрСуммаКомиссии;
	ДокОбъект.Подразделение                  = СтрДоговор.Подразделение;
	ДокОбъект.НаправлениеДеятельности        = НаправлениеДеятельности;
	ДокОбъект.ФормаОплаты                    = Перечисления.ФормыОплаты.Наличная;   
	ДокОбъект.А_Обработан = Истина;
	ДокОбъект.ВариантПриемкиТоваров = Перечисления.ВариантыПриемкиТоваров.РазделенаТолькоПоНакладным;
	ДокОбъект.СпособДоставки = Перечисления.СпособыДоставки.СиламиПоставщикаДоНашегоСклада;

		ДокОбъект.Договор                   = СтрДоговор; 
		
	// Связки
	ДокОбъект.А_ПриходДенегОтФинАгента     = ДокОснование;
	ДокОбъект.А_ПриходныйКассовыйОрдерКомиссия = СсылкаПКО;
	// Если ОбъектРасчетов.Объект = ЗаказПоставщику
	Если ЗначениеЗаполнено(СтрОбъектРасчетов)
		И ТипЗнч(СтрОбъектРасчетов.Объект) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ДокОбъект.ПоступлениеПоЗаказам       = Истина;
		ДокОбъект.ЗаказПоставщику             = СтрОбъектРасчетов.Объект;
	КонецЕсли;

	// ТЧ Товары
	ДокОбъект.Товары.Очистить();
	НоваяСтрТовары = ДокОбъект.Товары.Добавить();
	НоваяСтрТовары.Номенклатура              = НоменклатураЗатратДок;
	НоваяСтрТовары.СтатьяРасходов            = СтатьяЗатратДок;
	НоваяСтрТовары.Количество                = 1;
	НоваяСтрТовары.КоличествоУпаковок        = 1;
	НоваяСтрТовары.Цена                      = СтрСуммаКомиссии;
	НоваяСтрТовары.Сумма                     = СтрСуммаКомиссии;
	НоваяСтрТовары.СуммаСНДС                 = СтрСуммаКомиссии;
	НоваяСтрТовары.СуммаВзаиморасчетов       = СтрСуммаКомиссии;
	НоваяСтрТовары.СтавкаНДС                 = Справочники.СтавкиНДС.НайтиПоНаименованию("Без НДС");
	НоваяСтрТовары.СуммаНДС                  = 0;
	НоваяСтрТовары.СписатьНаРасходы           = Истина;
	НоваяСтрТовары.КодСтроки                 = 1;
	НоваяСтрТовары.ИдентификаторСтроки        = Строка(Новый УникальныйИдентификатор);
	НоваяСтрТовары.Подразделение          = ДокОбъект.Подразделение;
	Если ЗначениеЗаполнено(СтрОбъектРасчетов) Тогда
		НоваяСтрТовары.ОбъектРасчетов         = СтрОбъектРасчетов;
		Если ТипЗнч(СтрОбъектРасчетов.Объект) = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
			НоваяСтрТовары.ЗаказПоставщику    = СтрОбъектРасчетов.Объект;
		КонецЕсли;
	КонецЕсли;

	// ТЧ РасшифровкаПлатежа
	ДокОбъект.РасшифровкаПлатежа.Очистить();
    ДокОбъект.ВидыЗапасов.Очистить();
	ДокОбъект.ЭтапыГрафикаОплаты.Очистить();


КонецПроцедуры

Функция ОчиститьДочерниеДокументыФинАгент(ДокОснование, ИмяТипаДок)

	ЗапросОчистки = Новый Запрос;
	ЗапросОчистки.Текст =
	"ВЫБРАТЬ
	|	Док.Ссылка КАК Ссылка,
	|	Док.Проведен КАК Проведен,
	|	Док.Номер КАК Номер
	|ИЗ
	|	Документ." + ИмяТипаДок + " КАК Док
	|ГДЕ
	|	Док.А_ПриходДенегОтФинАгента = &Основание
	|	И НЕ Док.ПометкаУдаления";
	ЗапросОчистки.УстановитьПараметр("Основание", ДокОснование);

	Кол = 0;
	РезОчистки = ЗапросОчистки.Выполнить();
	Если НЕ РезОчистки.Пустой() Тогда
		ВыбОчистки = РезОчистки.Выбрать();
		Пока ВыбОчистки.Следующий() Цикл
			Попытка
				ДокОбъектОчистки = ВыбОчистки.Ссылка.ПолучитьОбъект();
				Если ВыбОчистки.Проведен Тогда
					ДокОбъектОчистки.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				КонецЕсли;
				ДокОбъектОчистки.УстановитьПометкуУдаления(Истина);
				Кол = Кол + 1;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка очистки " + ИмяТипаДок + " " + ВыбОчистки.Номер
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Возврат Кол;

КонецФункции

// ==============================================================================
// ОСНОВНАЯ ПРОЦЕДУРА: создание веера дочерних документов
// ==============================================================================

Процедура СоздатьПриходДенегПоФинАгенту() Экспорт

	ДокОснование = Ссылка;

	// ========== ФАЗА 1: ОЧИСТКА (пометка на удаление + отмена проведения) ==========
	КолОчисткаПриобр = ОчиститьДочерниеДокументыФинАгент(ДокОснование, "ПриобретениеТоваровУслуг");
	КолОчисткаРКО    = ОчиститьДочерниеДокументыФинАгент(ДокОснование, "РасходныйКассовыйОрдер");
	КолОчисткаПКО    = ОчиститьДочерниеДокументыФинАгент(ДокОснование, "ПриходныйКассовыйОрдер");

	// ========== ПРОВЕРКА: источник проведён? ==========
	Если НЕ Проведен Тогда
		Возврат;
	КонецЕсли;

	// ========== ЧТЕНИЕ ШАПКИ (прямо из атрибутов объекта) ==========
	ДатаДокумента           = НачалоДня(Дата);
	ОрганизацияДок          = Организация;
	КассаДок                = Касса;
	СтатьяДДС               = СтатьяДвиженияДенежныхСредств;
	НоменклатураЗатратДок    = НоменклатураЗатрат;
	СтатьяЗатратДок          = СтатьяЗатратКомиссия;
	ПодразделениеДок         = Подразделение;
	НаправлениеДеятельностиДок = А_НаправлениеДеятельности;

	ВалютаДок = Касса.ВалютаДенежныхСредств;
	Если НЕ ЗначениеЗаполнено(ВалютаДок) Тогда
		ВалютаДок = Справочники.Валюты.НайтиПоКоду("980");
	КонецЕсли;

	// ========== ЦИКЛ ПО СТРОКАМ РАСШИФРОВКИ ==========
	КолСозданоПКО      = 0;
	КолОбновленоПКО    = 0;
	КолСозданоРКО      = 0;
	КолОбновленоРКО    = 0;
	КолСозданоПриобр   = 0;
	КолОбновленоПриобр = 0;

	Для Каждого СтрРП Из РасшифровкаПлатежа Цикл

		Если СтрРП.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;

		СтрКонтрагент       = СтрРП.Контрагент;
		СтрОбъектРасчетов   = СтрРП.ОбъектРасчетов;
		СтрСумма            = СтрРП.Сумма;
		СтрСуммаКомиссии    = СтрРП.СуммаКомиссии;
		СтрНомерСтроки      = СтрРП.НомерСтроки;
		СтрПроцентФинАгента = СтрРП.А_ПроцентФинАгента;

		// Партнёр
		СтрПартнер = Неопределено;
		Попытка
			СтрПартнер = ДенежныеСредстваСервер.ПолучитьПартнераПоКонтрагенту(СтрКонтрагент);
		Исключение
			ЗапросПартнер = Новый Запрос;
			ЗапросПартнер.Текст = "ВЫБРАТЬ Партнер ИЗ Справочник.Контрагенты ГДЕ Ссылка = &К";
			ЗапросПартнер.УстановитьПараметр("К", СтрКонтрагент);
			РезП = ЗапросПартнер.Выполнить();
			Если НЕ РезП.Пустой() Тогда
				ВыбП = РезП.Выбрать();
				ВыбП.Следующий();
				СтрПартнер = ВыбП.Партнер;
			КонецЕсли;
		КонецПопытки;

			
		СтрДоговор=СтрОбъектРасчетов.Договор;
		
		// ===== ПКО: ПОИСК → обновить / создать =====
		СсылкаПКО = Неопределено;

		ЗапросПКО = Новый Запрос;
		ЗапросПКО.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриходныйКассовыйОрдер КАК Док
		|ГДЕ
		|	Док.А_ПриходДенегОтФинАгента = &Основание
		|	И Док.А_КодСтрокиПриходДенегОтФинАгента = &НомерСтроки";
		ЗапросПКО.УстановитьПараметр("Основание", ДокОснование);
		ЗапросПКО.УстановитьПараметр("НомерСтроки", СтрНомерСтроки);

		РезПКО = ЗапросПКО.Выполнить();

		Если НЕ РезПКО.Пустой() Тогда
			ВыбПКО = РезПКО.Выбрать();
			ВыбПКО.Следующий();
			Попытка
				ДокОбъектПКО = ВыбПКО.Ссылка.ПолучитьОбъект();
				ДокОбъектПКО.УстановитьПометкуУдаления(Ложь);
				ЗаполнитьПКО(ДокОбъектПКО, ДатаДокумента, ОрганизацияДок, КассаДок, ВалютаДок,
					СтрКонтрагент, СтрПартнер, СтрСумма, СтатьяДДС, ПодразделениеДок,
					НаправлениеДеятельностиДок, ДокОснование, СтрНомерСтроки,
					СтрПроцентФинАгента, СтрСуммаКомиссии, СтрОбъектРасчетов);
				ДокОбъектПКО.Записать(РежимЗаписиДокумента.Проведение);
				СсылкаПКО = ДокОбъектПКО.Ссылка;
				КолОбновленоПКО = КолОбновленоПКО + 1;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ОШИБКА обновления ПКО строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
				Продолжить;
			КонецПопытки;
		Иначе
			Попытка
				НовыйПКО = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
				ЗаполнитьПКО(НовыйПКО, ДатаДокумента, ОрганизацияДок, КассаДок, ВалютаДок,
					СтрКонтрагент, СтрПартнер, СтрСумма, СтатьяДДС, ПодразделениеДок,
					НаправлениеДеятельностиДок, ДокОснование, СтрНомерСтроки,
					СтрПроцентФинАгента, СтрСуммаКомиссии, СтрОбъектРасчетов);
				НовыйПКО.Записать(РежимЗаписиДокумента.Проведение);
				СсылкаПКО = НовыйПКО.Ссылка;
				КолСозданоПКО = КолСозданоПКО + 1;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ОШИБКА создания ПКО строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
				Продолжить;
			КонецПопытки;
		КонецЕсли;

		// РКО и Приобретение только если есть комиссия
		Если СтрСуммаКомиссии <= 0 Тогда
			Продолжить;
		КонецЕсли;

		// ===== РКО: ПОИСК → обновить / создать =====
		ЗапросРКО = Новый Запрос;
		ЗапросРКО.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РасходныйКассовыйОрдер КАК Док
		|ГДЕ
		|	Док.А_ПриходДенегОтФинАгента = &Основание
		|	И Док.А_ПриходныйКассовыйОрдерОтФинАгента = &СсылкаПКО";
		ЗапросРКО.УстановитьПараметр("Основание", ДокОснование);
		ЗапросРКО.УстановитьПараметр("СсылкаПКО", СсылкаПКО);

		РезРКО = ЗапросРКО.Выполнить();

		Если НЕ РезРКО.Пустой() Тогда
			ВыбРКО = РезРКО.Выбрать();
			ВыбРКО.Следующий();
			Попытка
				ДокОбъектРКО = ВыбРКО.Ссылка.ПолучитьОбъект();
				ДокОбъектРКО.УстановитьПометкуУдаления(Ложь);
				ЗаполнитьРКО(ДокОбъектРКО, ДатаДокумента, ОрганизацияДок, КассаДок, ВалютаДок,
					СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, СтатьяДДС, ПодразделениеДок,
					НаправлениеДеятельностиДок, ДокОснование, СсылкаПКО, СтрОбъектРасчетов);
				ДокОбъектРКО.Записать(РежимЗаписиДокумента.Проведение);
				КолОбновленоРКО = КолОбновленоРКО + 1;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ОШИБКА обновления РКО строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		Иначе
			Попытка
				НовыйРКО = Документы.РасходныйКассовыйОрдер.СоздатьДокумент();
				ЗаполнитьРКО(НовыйРКО, ДатаДокумента, ОрганизацияДок, КассаДок, ВалютаДок,
					СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, СтатьяДДС, ПодразделениеДок,
					НаправлениеДеятельностиДок, ДокОснование, СсылкаПКО, СтрОбъектРасчетов);
				НовыйРКО.Записать(РежимЗаписиДокумента.Проведение);
				КолСозданоРКО = КолСозданоРКО + 1;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ОШИБКА создания РКО строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

		// ===== Приобретение: ПОИСК → обновить / создать =====
		ЗапросПриобр = Новый Запрос;
		ЗапросПриобр.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг КАК Док
		|ГДЕ
		|	Док.А_ПриходДенегОтФинАгента = &Основание
		|	И Док.А_ПриходныйКассовыйОрдерКомиссия = &СсылкаПКО";
		ЗапросПриобр.УстановитьПараметр("Основание", ДокОснование);
		ЗапросПриобр.УстановитьПараметр("СсылкаПКО", СсылкаПКО);

		РезПриобр = ЗапросПриобр.Выполнить();

		Если НЕ РезПриобр.Пустой() Тогда
			ВыбПриобр = РезПриобр.Выбрать();
			ВыбПриобр.Следующий();
			Попытка
				ДокОбъектПриобр = ВыбПриобр.Ссылка.ПолучитьОбъект();
				ДокОбъектПриобр.УстановитьПометкуУдаления(Ложь);
				ЗаполнитьПриобретение(ДокОбъектПриобр, ДатаДокумента, ОрганизацияДок, ВалютаДок,
					СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, ПодразделениеДок,
					НаправлениеДеятельностиДок, ДокОснование, СсылкаПКО, СтрДоговор,
					НоменклатураЗатратДок, СтатьяЗатратДок, СтрОбъектРасчетов);
					ДокОбъектПриобр.Записать(РежимЗаписиДокумента.Проведение);
				КолОбновленоПриобр = КолОбновленоПриобр + 1;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ОШИБКА обновления Приобретения строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		Иначе
			Попытка
				НовоеПриобр = Документы.ПриобретениеТоваровУслуг.СоздатьДокумент();
				ЗаполнитьПриобретение(НовоеПриобр, ДатаДокумента, ОрганизацияДок, ВалютаДок,
					СтрКонтрагент, СтрПартнер, СтрСуммаКомиссии, ПодразделениеДок,
					НаправлениеДеятельностиДок, ДокОснование, СсылкаПКО, СтрДоговор,
					НоменклатураЗатратДок, СтатьяЗатратДок, СтрОбъектРасчетов);
				НовоеПриобр.Записать(РежимЗаписиДокумента.Проведение);
				КолСозданоПриобр = КолСозданоПриобр + 1;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ОШИБКА создания Приобретения строка " + Строка(СтрНомерСтроки)
					+ ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

	// ========== ИТОГОВОЕ СООБЩЕНИЕ ==========
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("СоздатьПриходДенегПоФинАгенту: ПКО=" + Строка(КолСозданоПКО) + "/" + Строка(КолОбновленоПКО)
		+ ", РКО=" + Строка(КолСозданоРКО) + "/" + Строка(КолОбновленоРКО)
		+ ", Приобр=" + Строка(КолСозданоПриобр) + "/" + Строка(КолОбновленоПриобр));

КонецПроцедуры

// ==============================================================================
// Проведение по регистру А_ДенежныеСредстваФинАгенты
// ==============================================================================

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.А_ДенежныеСредстваФинАгенты.Записывать = Истина;
	Движения.А_ДенежныеСредстваФинАгенты.Очистить();
	
	Для Каждого СтрокаРП Из РасшифровкаПлатежа Цикл
		
		Если СтрокаРП.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Движение = Движения.А_ДенежныеСредстваФинАгенты.Добавить();
		Движение.ВидДвижения            = ВидДвиженияНакопления.Расход;
		Движение.Период                 = Дата;
		Движение.ФинАгент               = ФинАгент;
		Движение.ДокументПередачи       = СтрокаРП.ДокСписаниеБезналичныхДенежныхСредств;
		Движение.НаправлениеДеятельности = СтрокаРП.Подразделение.А_НаправлениеДеятельности;
		Движение.Подразделение           = СтрокаРП.Подразделение;
		Движение.Контрагент             = СтрокаРП.Контрагент;
		Движение.ДоговорКонтрагента     = СтрокаРП.ОбъектРасчетов.Договор;
		Движение.ОбъектРасчетов         = СтрокаРП.ОбъектРасчетов;
		Движение.Сумма                  = СтрокаРП.Сумма - СтрокаРП.СуммаКомиссии;
		Движение.СуммаКомиссии          = СтрокаРП.СуммаКомиссии;
		Движение.СуммаСКомиссией        = СтрокаРП.Сумма ;
		
		
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	Движения.А_ДенежныеСредстваФинАгенты.Записывать = Истина;
	Движения.А_ДенежныеСредстваФинАгенты.Очистить();

КонецПроцедуры

// ==============================================================================
// Стандартные обработчики событий
// ==============================================================================

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
		//***ERP
	ОбновитьПриходДенегОтФинАгентаПослеОбмена();
	//***ERP


	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	СоздатьПриходДенегПоФинАгенту();

КонецПроцедуры
