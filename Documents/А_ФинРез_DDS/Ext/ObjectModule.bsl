#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Месяц) Тогда
		Месяц = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	// === Дублікат-захист по (Организация, Месяц) ===
	НачМесяца = НачалоМесяца(Месяц);
	КонМесяца = КонецМесяца(Месяц);

	ЗапросДубль = Новый Запрос;
	ЗапросДубль.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|    Dok.Ссылка КАК Ссылка,
	|    Dok.Номер  КАК Номер,
	|    Dok.Дата   КАК Дата
	|ИЗ Документ.А_ФинРез_DDS КАК Dok
	|ГДЕ
	|    Dok.Ссылка <> &ТекущийДок
	|    И НЕ Dok.ПометкаУдаления
	|    И Dok.Проведен
	|    И Dok.Организация = &Организация
	|    И Dok.Месяц МЕЖДУ &НачМесяца И &КонМесяца";
	ЗапросДубль.УстановитьПараметр("ТекущийДок",  Ссылка);
	ЗапросДубль.УстановитьПараметр("Организация", Организация);
	ЗапросДубль.УстановитьПараметр("НачМесяца",   НачМесяца);
	ЗапросДубль.УстановитьПараметр("КонМесяца",   КонМесяца);
	РезДубль = ЗапросДубль.Выполнить();
	Если НЕ РезДубль.Пустой() Тогда
		ВыбДубль = РезДубль.Выбрать();
		ВыбДубль.Следующий();
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не можна провести: за %1 (Організація %2) вже проведено документ %3 від %4. Перепроведіть існуючий або помітьте на видалення.",
				Формат(НачМесяца, "ДФ='ММММ yyyy'"),
				Организация,
				ВыбДубль.Номер,
				Формат(ВыбДубль.Дата, "ДФ='dd.MM.yyyy'")));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	// === Свёртка ДДС — UNION 3 регістрів з Source-маркером ===
	Движения.А_ОтчетDDS_Свод.Записывать = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст = СформироватьЗапросСверткиDDS();
	Запрос.УстановитьПараметр("НачалоПериода", НачМесяца);
	Запрос.УстановитьПараметр("КонецПериода",  КонМесяца);
	Запрос.УстановитьПараметр("Организация",   Организация);

	Движения.А_ОтчетDDS_Свод.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Повертає верифікований SQL UNION 3 регістрів ДС з Source-маркером.
// Перевірений Python COM (Task 11): за лютий 2026 повертає ~4812 рядків
// з 3 distinct Source значеннями (ERP_Безнал/ERP_Нал/Казна).
//
// Параметри: &НачалоПериода, &КонецПериода, &Организация
//
// СТРУКТУРА ВИХОДУ (відповідає РегистрСведений.А_ОтчетDDS_Свод):
//   Виміри:    Организация, Подразделение, НаправлениеДеятельности,
//              БанковскийСчетКасса, СтатьяДДС, Контрагент, Договор, Документ_Источник
//   Ресурси:   СуммаГрн, СуммаВалОригинала, Source, CFS_Section,
//              ВидДвижения, ВалютаОригинала, Курс
//
// Тест: _Rarzrabotki/Python/test/test_finrez_dds_query_2026-05-01.py
// Результати лютий 2026 (Rule #-1 — verified before BSL):
//   ERP_Безнал: 1829 рядків, Σ 5,015,250,939.96 ₴
//   ERP_Нал:     351 рядків, Σ    31,833,351.75 ₴
//   Казна:      2632 рядків, Σ 5,270,079,061.07 ₴
//   ВидДвижения: Поступление=2899, Списание=1913
//   CFS_Section: 0 non-null (А_РазделCFS не заповнений в довіднику — очікувано)
Функция СформироватьЗапросСверткиDDS()
	Возврат
	"// Branch 1: ERP_Безнал — РегНакоп.ДенежныеСредстваБезналичные (raw table)
	|// Grouped by Регистратор + all dims + attribute СтатьяДвиженияДенежныхСредств.
	|// ВидДвижения derived from sign of СУММА(Сумма).
	|ВЫБРАТЬ
	|	Б.Регистратор.Дата                               КАК Период,
	|	Б.Организация                                    КАК Организация,
	|	Б.Подразделение                                  КАК Подразделение,
	|	Б.Подразделение.А_НаправлениеДеятельности         КАК НаправлениеДеятельности,
	|	Б.БанковскийСчет                                 КАК БанковскийСчетКасса,
	|	Б.СтатьяДвиженияДенежныхСредств                  КАК СтатьяДДС,
	|	Б.СтатьяДвиженияДенежныхСредств.А_РазделCFS      КАК CFS_Section,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)    КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК Договор,
	|	Б.Регистратор                                    КАК Документ_Источник,
	|	ВЫБОР КОГДА СУММА(Б.Сумма) >= 0
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Поступление)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Списание)
	|	КОНЕЦ                                            КАК ВидДвижения,
	|	Б.БанковскийСчет.ВалютаДенежныхСредств           КАК ВалютаОригинала,
	|	1                                                КАК Курс,
	|	ВЫБОР КОГДА СУММА(Б.Сумма) < 0 ТОГДА -СУММА(Б.Сумма) ИНАЧЕ СУММА(Б.Сумма) КОНЕЦ КАК СуммаГрн,
	|	ВЫБОР КОГДА СУММА(Б.Сумма) < 0 ТОГДА -СУММА(Б.Сумма) ИНАЧЕ СУММА(Б.Сумма) КОНЕЦ КАК СуммаВалОригинала,
	|	ЗНАЧЕНИЕ(Перечисление.А_ИсточникDDS.ERP_Безнал)  КАК Source
	|ПОМЕСТИТЬ втDDS
	|ИЗ РегистрНакопления.ДенежныеСредстваБезналичные КАК Б
	|ГДЕ Б.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Б.Активность И Б.Сумма <> 0
	|СГРУППИРОВАТЬ ПО
	|	Б.Регистратор, Б.Регистратор.Дата,
	|	Б.Организация, Б.Подразделение,
	|	Б.Подразделение.А_НаправлениеДеятельности,
	|	Б.БанковскийСчет,
	|	Б.СтатьяДвиженияДенежныхСредств,
	|	Б.СтатьяДвиженияДенежныхСредств.А_РазделCFS,
	|	Б.БанковскийСчет.ВалютаДенежныхСредств
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Branch 2: ERP_Нал — РегНакоп.ДенежныеСредстваНаличные (raw table)
	|ВЫБРАТЬ
	|	Н.Регистратор.Дата,
	|	Н.Организация,
	|	Н.Подразделение,
	|	Н.Подразделение.А_НаправлениеДеятельности,
	|	Н.Касса,
	|	Н.СтатьяДвиженияДенежныхСредств,
	|	Н.СтатьяДвиженияДенежныхСредств.А_РазделCFS,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	Н.Регистратор,
	|	ВЫБОР КОГДА СУММА(Н.Сумма) >= 0
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Поступление)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Списание)
	|	КОНЕЦ,
	|	Н.Касса.ВалютаДенежныхСредств,
	|	1,
	|	ВЫБОР КОГДА СУММА(Н.Сумма) < 0 ТОГДА -СУММА(Н.Сумма) ИНАЧЕ СУММА(Н.Сумма) КОНЕЦ,
	|	ВЫБОР КОГДА СУММА(Н.Сумма) < 0 ТОГДА -СУММА(Н.Сумма) ИНАЧЕ СУММА(Н.Сумма) КОНЕЦ,
	|	ЗНАЧЕНИЕ(Перечисление.А_ИсточникDDS.ERP_Нал)
	|ИЗ РегистрНакопления.ДенежныеСредстваНаличные КАК Н
	|ГДЕ Н.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Н.Активность И Н.Сумма <> 0
	|СГРУППИРОВАТЬ ПО
	|	Н.Регистратор, Н.Регистратор.Дата,
	|	Н.Организация, Н.Подразделение,
	|	Н.Подразделение.А_НаправлениеДеятельности,
	|	Н.Касса,
	|	Н.СтатьяДвиженияДенежныхСредств,
	|	Н.СтатьяДвиженияДенежныхСредств.А_РазделCFS,
	|	Н.Касса.ВалютаДенежныхСредств
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Branch 3: Казна — РегНакоп.А_ДвиженияДенегИзКазны (raw table)
	|// НаправлениеДеятельностиКазна is a dimension — available directly.
	|// NO ВидДвижения field — Сумма is signed (positive=Поступление, negative=Списание).
	|// ДокументДвиженияКазны is a реквизит — available in raw table.
	|ВЫБРАТЬ
	|	К.Регистратор.Дата,
	|	К.Организация,
	|	К.Подразделение,
	|	К.НаправлениеДеятельностиКазна,
	|	К.БанковскийСчетКасса,
	|	К.СтатьяДвиженияДенежныхСредств,
	|	К.СтатьяДвиженияДенежныхСредств.А_РазделCFS,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	К.ДокументДвиженияКазны,
	|	ВЫБОР КОГДА СУММА(К.Сумма) >= 0
	|		ТОГДА ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Поступление)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ТипыДвиженияДенежныхСредств.Списание)
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
	|	1,
	|	ВЫБОР КОГДА СУММА(К.Сумма) < 0 ТОГДА -СУММА(К.Сумма) ИНАЧЕ СУММА(К.Сумма) КОНЕЦ,
	|	ВЫБОР КОГДА СУММА(К.Сумма) < 0 ТОГДА -СУММА(К.Сумма) ИНАЧЕ СУММА(К.Сумма) КОНЕЦ,
	|	ЗНАЧЕНИЕ(Перечисление.А_ИсточникDDS.Казна)
	|ИЗ РегистрНакопления.А_ДвиженияДенегИзКазны КАК К
	|ГДЕ К.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И К.Активность И К.Сумма <> 0
	|СГРУППИРОВАТЬ ПО
	|	К.Регистратор, К.Регистратор.Дата,
	|	К.Организация, К.Подразделение,
	|	К.НаправлениеДеятельностиКазна,
	|	К.БанковскийСчетКасса,
	|	К.СтатьяДвиженияДенежныхСредств,
	|	К.СтатьяДвиженияДенежныхСредств.А_РазделCFS,
	|	К.ДокументДвиженияКазны
	|;
	|
	|// Финальний SELECT — дані для РегистрСведений.А_ОтчетDDS_Свод.
	|// Колонки відповідають виміривам + ресурсам регістра (Загрузить() мапи по іменах).
	|// GROUP BY + СУММА на ресурсах: один і той самий Документ_Источник може з'явитись
	|// у двох гілках UNION ALL (наприклад РКО одночасно в ERP_Нал і в Казна).
	|// Без GROUP BY — дублікат ключа регістра → помилка при Записати().
	|ВЫБРАТЬ
	|	МИНИМУМ(Д.Период) КАК Период,
	|	Д.Организация,
	|	Д.Подразделение,
	|	Д.НаправлениеДеятельности,
	|	Д.БанковскийСчетКасса,
	|	Д.СтатьяДДС,
	|	МИНИМУМ(Д.CFS_Section) КАК CFS_Section,
	|	Д.Контрагент,
	|	Д.Договор,
	|	Д.Документ_Источник,
	|	МИНИМУМ(Д.ВидДвижения) КАК ВидДвижения,
	|	МИНИМУМ(Д.ВалютаОригинала) КАК ВалютаОригинала,
	|	МИНИМУМ(Д.Курс) КАК Курс,
	|	СУММА(Д.СуммаГрн) КАК СуммаГрн,
	|	СУММА(Д.СуммаВалОригинала) КАК СуммаВалОригинала,
	|	МИНИМУМ(Д.Source) КАК Source
	|ИЗ втDDS КАК Д
	|СГРУППИРОВАТЬ ПО
	|	Д.Организация,
	|	Д.Подразделение,
	|	Д.НаправлениеДеятельности,
	|	Д.БанковскийСчетКасса,
	|	Д.СтатьяДДС,
	|	Д.Контрагент,
	|	Д.Договор,
	|	Д.Документ_Источник";
КонецФункции

#КонецОбласти

#КонецЕсли
