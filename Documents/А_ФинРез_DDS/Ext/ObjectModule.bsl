#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = А_Привилегированный.А_ПолучитьОрганизациюУпр();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Месяц) Тогда
		Месяц = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	НачМесяца = НачалоМесяца(Месяц);
	КонМесяца = КонецМесяца(Месяц);

	ЗапросДубль = Новый Запрос;
	ЗапросДубль.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Dok.Ссылка КАК Ссылка,
	|	Dok.Номер  КАК Номер,
	|	Dok.Дата   КАК Дата
	|ИЗ Документ.А_ФинРез_DDS КАК Dok
	|ГДЕ
	|	Dok.Ссылка <> &ТекущийДок
	|	И НЕ Dok.ПометкаУдаления
	|	И Dok.Проведен
	|	И Dok.Организация = &Организация
	|	И Dok.Месяц МЕЖДУ &НачМесяца И &КонМесяца";
	ЗапросДубль.УстановитьПараметр("ТекущийДок",  Ссылка);
	ЗапросДубль.УстановитьПараметр("Организация", Организация);
	ЗапросДубль.УстановитьПараметр("НачМесяца",   НачМесяца);
	ЗапросДубль.УстановитьПараметр("КонМесяца",   КонМесяца);
	РезДубль = ЗапросДубль.Выполнить();
	Если НЕ РезДубль.Пустой() Тогда
		ВыбДубль = РезДубль.Выбрать();
		ВыбДубль.Следующий();
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон("Не можна провести: за %1 (Організація %2) вже проведено документ %3 від %4. Перепроведіть існуючий або помітьте на видалення.",
				Формат(НачМесяца, "ДФ='ММММ yyyy'"),
				Организация,
				ВыбДубль.Номер,
				Формат(ВыбДубль.Дата, "ДФ='dd.MM.yyyy'")));
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Движения.А_ОтчетDDS_Свод.Записывать = Истина;

	Запрос = Новый Запрос;
	Запрос.Текст = СформироватьЗапросСверткиDDS();
	Запрос.УстановитьПараметр("НачалоПериода",     НачМесяца);
	Запрос.УстановитьПараметр("КонецПериода",      КонМесяца);
	Запрос.УстановитьПараметр("Организация",       Организация);
	Запрос.УстановитьПараметр("ИсточникЕРП",       Перечисления.А_ИсточникDDS.ЕРП);
	Запрос.УстановитьПараметр("ИсточникКазна",     Перечисления.А_ИсточникDDS.Казна);
	Запрос.УстановитьПараметр("ИсточникПлан",      Перечисления.А_ИсточникDDS.План);
	Запрос.УстановитьПараметр("ИсточникПланОбъект",Перечисления.А_ИсточникDDS.ПланОбъекта);
	Запрос.УстановитьПараметр("ВидПерМесяц",       Перечисления.А_ВидыПериодовБюджетирования.Месяц);
	Запрос.УстановитьПараметр("ВидПерОбъект",      Перечисления.А_ВидыПериодовБюджетирования.Объект);
	Запрос.УстановитьПараметр("ТипПрих",           Перечисления.ТипыЗначенийПоказателейБюджетногоОтчета.Приход);
	Запрос.УстановитьПараметр("ТипПоступление",    Перечисления.ТипыДвиженияДенежныхСредств.Поступление);
	Запрос.УстановитьПараметр("ТипСписание",       Перечисления.ТипыДвиженияДенежныхСредств.Списание);
	Запрос.УстановитьПараметр("ТипДСБезнал",       Перечисления.ТипыДенежныхСредств.Безналичные);
	Запрос.УстановитьПараметр("ТипДСНал",          Перечисления.ТипыДенежныхСредств.Наличные);
	Запрос.УстановитьПараметр("ХозОпЗаглушка",     Перечисления.ХозяйственныеОперации.АвансовыйОтчет);

	ТЗДвижений = Запрос.Выполнить().Выгрузить();
	Движения.А_ОтчетDDS_Свод.Загрузить(ТЗДвижений);

	// === Оновлення регістра розшифровки документів (паттерн з А_ФинРез_PL) ===
	// Збираємо унікальні `ДокументДвижения` з ТЗДвижений і оновлюємо
	// `РегистрСведений.А_ДокументРасшифровка` для drill-down у Power BI.
	// Без цього кроку Sum_Plan / Sum_Kazna для документів типу А_БюджетМесяц,
	// А_ПереносДвиженийИзКазны не показували Document_Presentation у dim Документы.
	МассивДок = Новый Массив;
	Знайдено  = Новый Соответствие;
	Для Каждого Стр Из ТЗДвижений Цикл
		Если Стр.ДокументДвижения = Неопределено Тогда Продолжить; КонецЕсли;
		Если Стр.ДокументДвижения.Пустая() Тогда Продолжить; КонецЕсли;
		Если Знайдено.Получить(Стр.ДокументДвижения) <> Неопределено Тогда Продолжить; КонецЕсли;
		Знайдено.Вставить(Стр.ДокументДвижения, Истина);
		МассивДок.Добавить(Стр.ДокументДвижения);
	КонецЦикла;

	РегистрыСведений.А_ДокументРасшифровка.ОбновитьПоДокументам(МассивДок);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Свёртка ДДС за місяць — 4 гілки UNION ALL → дедупл. GROUP BY 14 dim → Загрузить регістра.
//
// Заповнення Контрагент/Договор/Партнер: LEFT JOIN з ВТ_Контр (агрегатовано GROUP BY Регистратор
// з МАКСИМУМ() полів з РегНакоп.ДвиженияДенежныеСредстваКонтрагент). Це дає 1:1 для документа.
// Для Branch 2 (Казна) JOIN не по Регистратор (там завжди А_ПереносДвиженийИзКазны), а по
// ДокументДвиженияКазны (парний ERP-документ).
//
// ФизЛицо: тільки для АвансовогоОтчета через ВЫРАЗИТЬ(Регистратор КАК Документ.АвансовыйОтчет).ПодотчетноеЛицо.
// Аналитика: Контрагент.Наименование (приоритет) → ФизЛицо.Наименование → "" (как у А_ФинРез_PL).
// Комментарий: реквизит регістру (НЕ вимір) → МАКСИМУМ(Регистратор.Комментарий) у фінальному GROUP BY.
//
// CRITICAL fix 2026-05-09: Branch 3 (План) фільтрує `Пл.Месяц МЕЖДУ &НачПер И &КонПер` (вимір регістра),
// без `&НачПер/&КонПер` у параметрах `.Обороты()`. Раніше використовувався `Период` у `.Обороты()` +
// `Регистратор.Дата` у WHERE — це втрачало сторно записи від коригуючих бюджет-документів
// (`А_БюджетМесяц` з ВидВерсии=Корректировка): рух має Період=ДокументОснование.Дата (старий місяць)
// та Регистратор.Дата=новий місяць. Фільтр по Месяцу (вимір) забезпечує коректний розподіл сторно
// у OLAP-документ того місяця, до якого ВОНО відноситься (Sum=0 після перепроведення).
Функция СформироватьЗапросСверткиDDS()
	Возврат
	"// ВТ_Контр: Контрагент/Договор/Партнер агрегатовано по Регистратору
	|// (МАКСИМУМ — на випадок кількох рядків регістру з різним Контрагентом для одного документа).
	|// ВЫБОР КОГДА...ССЫЛКА — composite в джерелі, у цільовому регістрі — конкретний тип.
	|ВЫБРАТЬ
	|	К.Регистратор                                 КАК Регистратор,
	|	МАКСИМУМ(ВЫБОР КОГДА К.Контрагент ССЫЛКА Справочник.Контрагенты
	|		ТОГДА К.Контрагент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ)                                        КАК Контрагент,
	|	МАКСИМУМ(ВЫБОР КОГДА К.Договор ССЫЛКА Справочник.ДоговорыКонтрагентов
	|		ТОГДА К.Договор
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	КОНЕЦ)                                        КАК Договор
	|ПОМЕСТИТЬ ВТ_Контр
	|ИЗ РегистрНакопления.ДвиженияДенежныеСредстваКонтрагент КАК К
	|ГДЕ К.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И К.Активность
	|	И К.Организация = &Организация
	|СГРУППИРОВАТЬ ПО К.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////
	|// Branch 1A: ЕРП Безналичные
	|ВЫБРАТЬ
	|	&ИсточникЕРП                                           КАК Источник,
	|	ВЫБОР КОГДА Бн.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА &ТипПоступление
	|		ИНАЧЕ &ТипСписание
	|	КОНЕЦ                                                  КАК ВидДвижения,
	|	&ТипДСБезнал                                           КАК ТипДенежныхСредств,
	|	Бн.ХозяйственнаяОперация                               КАК ХозяйственнаяОперация,
	|	Бн.Организация                                         КАК Организация,
	|	Бн.Подразделение                                       КАК Подразделение,
	|	Бн.БанковскийСчет                                      КАК ДенежныеСредства,
	|	Бн.СтатьяДвиженияДенежныхСредств                       КАК СтатьяДвиженияДенежныхСредств,
	|	ЕСТЬNULL(Контр.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))                КАК Контрагент,
	|	ЕСТЬNULL(Контр.Договор,    ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка))      КАК Договор,
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)       КАК ФизическоеЛицо,
	|	Бн.БанковскийСчет.ВалютаДенежныхСредств                КАК Валюта,
	|	Бн.Регистратор                                         КАК ДокументДвижения,
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА ЕСТЬNULL(Контр.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Контр.Контрагент.Наименование
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Строка(150))                                  КАК Аналитика,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(Бн.Регистратор.Комментарий, """") КАК Строка(1000))  КАК Комментарий,
	|	ВЫБОР КОГДА Бн.СтатьяДвиженияДенежныхСредств.А_ТипПоказателя = &ТипПрих
	|		ТОГДА ВЫБОР КОГДА Бн.Сумма < 0 ТОГДА -Бн.Сумма ИНАЧЕ Бн.Сумма КОНЕЦ
	|		ИНАЧЕ -(ВЫБОР КОГДА Бн.Сумма < 0 ТОГДА -Бн.Сумма ИНАЧЕ Бн.Сумма КОНЕЦ)
	|	КОНЕЦ                                                  КАК Сумма,
	|	ВЫБОР КОГДА Бн.СтатьяДвиженияДенежныхСредств.А_ТипПоказателя = &ТипПрих
	|		ТОГДА ВЫБОР КОГДА Бн.Сумма < 0 ТОГДА -Бн.Сумма ИНАЧЕ Бн.Сумма КОНЕЦ
	|		ИНАЧЕ -(ВЫБОР КОГДА Бн.Сумма < 0 ТОГДА -Бн.Сумма ИНАЧЕ Бн.Сумма КОНЕЦ)
	|	КОНЕЦ                                                  КАК СуммаВВалюте,
	|	0                                                      КАК СуммаКазна,
	|	0                                                      КАК СуммаПлан,
	|	0                                                      КАК СуммаПланОбъект
	|ПОМЕСТИТЬ втВсе
	|ИЗ РегистрНакопления.ДенежныеСредстваБезналичные КАК Бн
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контр КАК Контр
	|		ПО Контр.Регистратор = Бн.Регистратор
	|ГДЕ Бн.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Бн.Активность
	|	И Бн.Организация = &Организация
	|	И Бн.Сумма <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Branch 1B: ЕРП Наличные
	|ВЫБРАТЬ
	|	&ИсточникЕРП,
	|	ВЫБОР КОГДА Нл.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		ТОГДА &ТипПоступление ИНАЧЕ &ТипСписание КОНЕЦ,
	|	&ТипДСНал,
	|	Нл.ХозяйственнаяОперация,
	|	Нл.Организация,
	|	Нл.Подразделение,
	|	Нл.Касса,
	|	Нл.СтатьяДвиженияДенежныхСредств,
	|	ЕСТЬNULL(Контр2.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)),
	|	ЕСТЬNULL(Контр2.Договор,    ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)),
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка),
	|	Нл.Касса.ВалютаДенежныхСредств,
	|	Нл.Регистратор,
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА ЕСТЬNULL(Контр2.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Контр2.Контрагент.Наименование
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Строка(150)),
	|	ВЫРАЗИТЬ(ЕСТЬNULL(Нл.Регистратор.Комментарий, """") КАК Строка(1000)),
	|	ВЫБОР КОГДА Нл.СтатьяДвиженияДенежныхСредств.А_ТипПоказателя = &ТипПрих
	|		ТОГДА ВЫБОР КОГДА Нл.Сумма < 0 ТОГДА -Нл.Сумма ИНАЧЕ Нл.Сумма КОНЕЦ
	|		ИНАЧЕ -(ВЫБОР КОГДА Нл.Сумма < 0 ТОГДА -Нл.Сумма ИНАЧЕ Нл.Сумма КОНЕЦ)
	|	КОНЕЦ,
	|	ВЫБОР КОГДА Нл.СтатьяДвиженияДенежныхСредств.А_ТипПоказателя = &ТипПрих
	|		ТОГДА ВЫБОР КОГДА Нл.Сумма < 0 ТОГДА -Нл.Сумма ИНАЧЕ Нл.Сумма КОНЕЦ
	|		ИНАЧЕ -(ВЫБОР КОГДА Нл.Сумма < 0 ТОГДА -Нл.Сумма ИНАЧЕ Нл.Сумма КОНЕЦ)
	|	КОНЕЦ,
	|	0, 0, 0
	|ИЗ РегистрНакопления.ДенежныеСредстваНаличные КАК Нл
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контр КАК Контр2
	|		ПО Контр2.Регистратор = Нл.Регистратор
	|ГДЕ Нл.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Нл.Активность
	|	И Нл.Организация = &Организация
	|	И Нл.Сумма <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Branch 2: Казна — JOIN з ВТ_Контр по ДокументДвиженияКазны (парний ERP-документ)
	|ВЫБРАТЬ
	|	&ИсточникКазна,
	|	ВЫБОР КОГДА Кз.Сумма >= 0 ТОГДА &ТипПоступление ИНАЧЕ &ТипСписание КОНЕЦ,
	|	Кз.ТипДенежныхСредств,
	|	&ХозОпЗаглушка,
	|	Кз.Организация,
	|	Кз.Подразделение,
	|	Кз.БанковскийСчетКасса,
	|	Кз.СтатьяДвиженияДенежныхСредств,
	|	ЕСТЬNULL(Контр3.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)),
	|	ЕСТЬNULL(Контр3.Договор,    ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)),
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
	|	Кз.ДокументДвиженияКазны,
	|	ВЫРАЗИТЬ(ВЫБОР
	|		КОГДА ЕСТЬNULL(Контр3.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Контр3.Контрагент.Наименование
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Строка(150)),
	|	ВЫРАЗИТЬ(ЕСТЬNULL(Кз.Регистратор.Комментарий, """") КАК Строка(1000)),
	|	0, 0,
	|	ВЫБОР КОГДА Кз.СтатьяДвиженияДенежныхСредств.А_ТипПоказателя = &ТипПрих
	|		ТОГДА ВЫБОР КОГДА Кз.Сумма < 0 ТОГДА -Кз.Сумма ИНАЧЕ Кз.Сумма КОНЕЦ
	|		ИНАЧЕ -(ВЫБОР КОГДА Кз.Сумма < 0 ТОГДА -Кз.Сумма ИНАЧЕ Кз.Сумма КОНЕЦ)
	|	КОНЕЦ,
	|	0, 0
	|ИЗ РегистрНакопления.А_ДвиженияДенегИзКазны КАК Кз
	|	ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Контр КАК Контр3
	|		ПО Контр3.Регистратор = Кз.ДокументДвиженияКазны
	|ГДЕ Кз.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И Кз.Активность
	|	И Кз.Организация = &Организация
	|	И Кз.Сумма <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Branch 3: План (Месяц + Объект через ВидПериода) — без Контрагента
	|ВЫБРАТЬ
	|	ВЫБОР КОГДА Пл.ВидПериода = &ВидПерОбъект
	|		ТОГДА &ИсточникПланОбъект
	|		ИНАЧЕ &ИсточникПлан
	|	КОНЕЦ,
	|	ВЫБОР КОГДА Пл.СтатьяДвиженияДенежныхСредств.А_ТипПоказателя = &ТипПрих
	|		ТОГДА &ТипПоступление
	|		ИНАЧЕ &ТипСписание
	|	КОНЕЦ,
	|	Пл.ВидОплаты,
	|	&ХозОпЗаглушка,
	|	&Организация,
	|	Пл.Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.БанковскиеСчетаОрганизаций.ПустаяСсылка),
	|	Пл.СтатьяДвиженияДенежныхСредств,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка),
	|	// ДокументДвижения: для сторно-рядка (Регистратор=КорДок, Месяц=старий) — підставляємо
	|	// ДокументОснование (оригінал що сторнується), щоб уникнути колізії ключів між OLAP-документами:
	|	// сторно-Окт (от Кор-доку) і нові-Май (від того ж Кор-доку) інакше створили б рядки з однаковим
	|	// ДокументДвижения=Кор у двох різних OLAP-документах.
	|	ВЫБОР КОГДА НАЧАЛОПЕРИОДА(Пл.Регистратор.Дата, МЕСЯЦ) <> Пл.Месяц
	|			И ВЫРАЗИТЬ(Пл.Регистратор КАК Документ.А_БюджетМесяц).ДокументОснование <> ЗНАЧЕНИЕ(Документ.А_БюджетМесяц.ПустаяСсылка)
	|		ТОГДА ВЫРАЗИТЬ(Пл.Регистратор КАК Документ.А_БюджетМесяц).ДокументОснование
	|		ИНАЧЕ Пл.Регистратор
	|	КОНЕЦ,
	|	ВЫРАЗИТЬ("""" КАК Строка(150)),
	|	ВЫРАЗИТЬ(ЕСТЬNULL(Пл.Регистратор.Комментарий, """") КАК Строка(1000)),
	|	0,
	|	0,
	|	0,
	|	ВЫБОР КОГДА Пл.ВидПериода = &ВидПерМесяц
	|		ТОГДА ВЫБОР КОГДА Пл.СтатьяДвиженияДенежныхСредств.А_ТипПоказателя = &ТипПрих
	|				ТОГДА Пл.СуммаОборот ИНАЧЕ -Пл.СуммаОборот КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	ВЫБОР КОГДА Пл.ВидПериода = &ВидПерОбъект
	|		ТОГДА ВЫБОР КОГДА Пл.СтатьяДвиженияДенежныхСредств.А_ТипПоказателя = &ТипПрих
	|				ТОГДА Пл.СуммаОборот ИНАЧЕ -Пл.СуммаОборот КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ
	|ИЗ РегистрНакопления.А_БюджетыНаМесяц.Обороты(
	|		, , Регистратор,
	|		ВидПериода В (&ВидПерМесяц, &ВидПерОбъект)) КАК Пл
	|ГДЕ Пл.СуммаОборот <> 0
	|	И Пл.Месяц МЕЖДУ &НачалоПериода И &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////
	|// Дедуплікація через ПОМЕСТИТЬ: GROUP BY 14 dim + СУММА() ресурсів + МАКСИМУМ() реквізиту Комментарий.
	|// Без цієї проміжної ВТ платформа лишала 2+ рядки з одним і тим самим 14-key (одна з причин — рядки
	|// з однаковими Подр+Стат+...+Док але різним Напр у А_БюджетыНаМесяц, яке не входить у вихід Branch 3).
	|ВЫБРАТЬ
	|	Свод.ВидДвижения                          КАК ВидДвижения,
	|	Свод.ТипДенежныхСредств                   КАК ТипДенежныхСредств,
	|	Свод.Источник                             КАК Источник,
	|	Свод.ХозяйственнаяОперация                КАК ХозяйственнаяОперация,
	|	Свод.Организация                          КАК Организация,
	|	Свод.Подразделение                        КАК Подразделение,
	|	Свод.ДенежныеСредства                     КАК ДенежныеСредства,
	|	Свод.СтатьяДвиженияДенежныхСредств        КАК СтатьяДвиженияДенежныхСредств,
	|	Свод.Контрагент                           КАК Контрагент,
	|	Свод.Договор                              КАК Договор,
	|	Свод.ФизическоеЛицо                       КАК ФизическоеЛицо,
	|	Свод.Валюта                               КАК Валюта,
	|	Свод.ДокументДвижения                     КАК ДокументДвижения,
	|	Свод.Аналитика                            КАК Аналитика,
	|	МАКСИМУМ(Свод.Комментарий)                КАК Комментарий,
	|	СУММА(Свод.Сумма)                         КАК Сумма,
	|	СУММА(Свод.СуммаВВалюте)                  КАК СуммаВВалюте,
	|	СУММА(Свод.СуммаКазна)                    КАК СуммаКазна,
	|	СУММА(Свод.СуммаПлан)                     КАК СуммаПлан,
	|	СУММА(Свод.СуммаПланОбъект)               КАК СуммаПланОбъект
	|ПОМЕСТИТЬ втАгр
	|ИЗ втВсе КАК Свод
	|СГРУППИРОВАТЬ ПО
	|	Свод.ВидДвижения,
	|	Свод.ТипДенежныхСредств,
	|	Свод.Источник,
	|	Свод.ХозяйственнаяОперация,
	|	Свод.Организация,
	|	Свод.Подразделение,
	|	Свод.ДенежныеСредства,
	|	Свод.СтатьяДвиженияДенежныхСредств,
	|	Свод.Контрагент,
	|	Свод.Договор,
	|	Свод.ФизическоеЛицо,
	|	Свод.Валюта,
	|	Свод.ДокументДвижения,
	|	Свод.Аналитика
	|;
	|
	|// Фінальний SELECT — заповнення ПУСТОЇ ХозяйственнаяОперация (бо реквізит NotEmpty в регістрі).
	|// Branch 3 (План) виставляє ХозОп = &ХозОпЗаглушка, але якщо в інших гілках ХозОп прийде пустим
	|// (наприклад Ввод начальных остатков у касі) — підставляємо &ХозОпЗаглушка.
	|ВЫБРАТЬ
	|	А.ВидДвижения                                       КАК ВидДвижения,
	|	А.ТипДенежныхСредств                                КАК ТипДенежныхСредств,
	|	А.Источник                                          КАК Источник,
	|	ВЫБОР КОГДА А.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПустаяСсылка)
	|		ТОГДА &ХозОпЗаглушка
	|		ИНАЧЕ А.ХозяйственнаяОперация
	|	КОНЕЦ                                               КАК ХозяйственнаяОперация,
	|	А.Организация                                       КАК Организация,
	|	А.Подразделение                                     КАК Подразделение,
	|	А.ДенежныеСредства                                  КАК ДенежныеСредства,
	|	А.СтатьяДвиженияДенежныхСредств                     КАК СтатьяДвиженияДенежныхСредств,
	|	А.Контрагент                                        КАК Контрагент,
	|	А.Договор                                           КАК Договор,
	|	А.ФизическоеЛицо                                    КАК ФизическоеЛицо,
	|	А.Валюта                                            КАК Валюта,
	|	А.ДокументДвижения                                  КАК ДокументДвижения,
	|	А.Аналитика                                         КАК Аналитика,
	|	А.Комментарий                                       КАК Комментарий,
	|	А.Сумма                                             КАК Сумма,
	|	А.СуммаВВалюте                                      КАК СуммаВВалюте,
	|	А.СуммаКазна                                        КАК СуммаКазна,
	|	А.СуммаПлан                                         КАК СуммаПлан,
	|	А.СуммаПланОбъект                                   КАК СуммаПланОбъект
	|ИЗ втАгр КАК А
	|";
КонецФункции

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Месяц = НачалоМесяца(Дата);	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
